<div style="margin-bottom: 30px;">
  <h1 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; margin-bottom: 10px;">
    Trial Balance
  </h1>
  <p style="color: #7f8c8d; font-size: 1.1rem; margin: 0;">
    Period: <strong><%= @date_from %></strong> to <strong><%= @date_to %></strong>
  </p>
</div>

<table style="width:100%; border-collapse: collapse; font-family: Arial, sans-serif;" border="1" cellpadding="8">
  <thead style="background-color: #f8f9fa;">
    <tr>
      <th align="left" style="padding: 10px; border-bottom: 2px solid #dee2e6;">Account</th>
      <th align="left" style="padding: 10px; border-bottom: 2px solid #dee2e6;">Name</th>
      <th align="right" style="padding: 10px; border-bottom: 2px solid #dee2e6;">Debit</th>
      <th align="right" style="padding: 10px; border-bottom: 2px solid #dee2e6;">Credit</th>
      <th align="right" style="padding: 10px; border-bottom: 2px solid #dee2e6;">Balance</th>
    </tr>
  </thead>
  <tbody>
    <% @trial_rows.each_with_index do |r, index| %>
      <tr style="background-color: <%= index.even? ? '#ffffff' : '#f8f9fa' %>;">
        <td style="padding: 8px; font-weight: bold;"><%= r[:account_code] %></td>
        <td style="padding: 8px;"><%= r[:account_name] %></td>
        <td align="right" style="padding: 8px; <%= r[:total_debit] > 0 ? 'color: #0d6efd;' : '' %>">
          <%= number_to_currency(
                r[:total_debit],
                unit: "$",
                precision: 2,
                delimiter: ",",
                format: "%u%n"
              ) %>
        </td>
        <td align="right" style="padding: 8px; <%= r[:total_credit] > 0 ? 'color: #0d6efd;' : '' %>">
          <%= number_to_currency(
                r[:total_credit],
                unit: "$",
                precision: 2,
                delimiter: ",",
                format: "%u%n"
              ) %>
        </td>
        <td align="right" style="padding: 8px; font-weight: bold; <%= r[:balance] >= 0 ? 'color: #198754;' : 'color: #dc3545;' %>">
          <%= number_to_currency(
                r[:balance],
                unit: "$",
                precision: 2,
                delimiter: ",",
                format: "%u%n"
              ) %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot style="background-color: #e9ecef; border-top: 2px solid #dee2e6;">
    <tr>
      <td colspan="2" style="padding: 10px; font-weight: bold;">Totals</td>
      <td align="right" style="padding: 10px; font-weight: bold;">
        <%= number_to_currency(
              @grand_totals[:debit],
              unit: "$",
              precision: 2,
              delimiter: ",",
              format: "%u%n"
            ) %>
      </td>
      <td align="right" style="padding: 10px; font-weight: bold;">
        <%= number_to_currency(
              @grand_totals[:credit],
              unit: "$",
              precision: 2,
              delimiter: ",",
              format: "%u%n"
            ) %>
      </td>
      <td align="right" style="padding: 10px; font-weight: bold; <%= @grand_totals[:balanced?] ? 'color: #198754;' : 'color: #dc3545;' %>">
        <%= @grand_totals[:balanced?] ? 'BALANCED' : 'NOT BALANCED' %>
      </td>
    </tr>
  </tfoot>
</table>

<% if @grand_totals[:balanced?] %>
  <div style="margin-top: 20px; padding: 15px; background-color: #d1e7dd; border: 1px solid #badbcc; border-radius: 5px; color: #0f5132;">
    <strong>Trial Balance is balanced!</strong> Total Debits 
    (<%= number_to_currency(
          @grand_totals[:debit],
          unit: "$",
          precision: 2,
          delimiter: ",",
          format: "%u%n"
        ) %>) = Total Credits 
    (<%= number_to_currency(
          @grand_totals[:credit],
          unit: "$",
          precision: 2,
          delimiter: ",",
          format: "%u%n"
        ) %>)
  </div>
<% else %>
  <div style="margin-top: 20px; padding: 15px; background-color: #f8d7da; border: 1px solid #f5c2c7; border-radius: 5px; color: #842029;">
    <strong>Trial Balance is not balanced!</strong> Difference: 
    <%= number_to_currency(
          @grand_totals[:debit] - @grand_totals[:credit],
          unit: "$",
          precision: 2,
          delimiter: ",",
          format: "%u%n"
        ) %>
  </div>
<% end %>

<div style="margin-top: 40px; padding-top: 15px; border-top: 1px solid #dee2e6; color: #6c757d; font-size: 0.9rem;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <div>Generated by ActivePlus Accounting System</div>
    <div><%= Time.current.strftime("%d %B %Y at %I:%M %p") %></div>
  </div>
</div>