}

/* All other theme styles remain exactly as you had them */
/* ... (include all your theme styles here - they remain unchanged) ... */

/* =========================
   AGENCY BADGE STYLES
========================= */
.agency-badge {
  font-size: 0.7rem !important;
  padding: 4px 8px !important;
  background-color: #6c757d !important;
  color: white !important;
  border-radius: 4px;
}

/* =========================
   CARD BODY IMPROVEMENTS
========================= */
.card-body {
  position: relative;
  z-index: 1;
}

/* =========================
   HOVER EFFECTS
========================= */
.vehicle-card .btn-outline-primary:hover,
.vehicle-card .btn-outline-warning:hover {
  transform: translateY(-2px);
  transition: transform 0.2s ease;
}
</style>