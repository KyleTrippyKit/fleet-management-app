<%# app/views/vehicles/index.html.erb – PTSC FLEET MANAGEMENT (COMPACT CARDS) %>

<%
  # TT Flag colors
  tt_red = "#c8102e"
  tt_white = "#ffffff"
  tt_black = "#000000"
  ptsc_yellow = "#ffb81c"
  ptsc_blue = "#0033a0"
  
  # Get all agencies for filter buttons - EXCLUDE VMCOTT COMPLETELY
  @agencies = Agency.where.not(code: 'VMCOTT').order(:name) if defined?(Agency)
  
  # Agency-specific colors - VMCOTT removed from filter bar
  agency_colors = {
    "PTSC" => { bg: "#0033a0", text: "#FFFFFF", icon: "fa-bus" },
    "TTPS" => { bg: "#C8102E", text: "#FFFFFF", icon: "fa-shield-alt" },
    "TTDF" => { bg: "#006747", text: "#D4AF37", icon: "fa-shield" },
    "FIRE" => { bg: "#e65100", text: "#FFFFFF", icon: "fa-fire" },
    "HEALTH" => { bg: "#004d40", text: "#FFFFFF", icon: "fa-heart" },
    "EDUCATION" => { bg: "#4a148c", text: "#FFFFFF", icon: "fa-book" }
  }
%>

<!-- Font Awesome 6 (Free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="ptsc-fleet-dashboard container-fluid py-4 px-4">
  
  <!-- HEADER - PTSC STYLE WITH FLAG -->
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4 pb-2 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-3 mb-2">
        <!-- TT Flag Stripe Accent -->
        <div class="tt-flag-stripe">
          <div class="stripe-red"></div>
          <div class="stripe-white"></div>
          <div class="stripe-black"></div>
        </div>
        <!-- PTSC Logo Circle with BUS ICON -->
        <div class="ptsc-tt-logo-wrapper">
          <div class="ptsc-tt-logo">
            <i class="fas fa-bus fa-2x"></i>
          </div>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h1 class="display-6 fw-bold mb-0 ptsc-tt-title">Fleet Management</h1>
            <span class="tt-flag-badge">Trinidad & Tobago</span>
          </div>
          <div class="d-flex align-items-center gap-3 mt-1">
            <span class="text-muted"><i class="fas fa-warehouse me-1"></i> Vehicle Registry</span>
            <span class="vr"></span>
            <span class="text-muted">
              <i class="far fa-clock me-1"></i><%= Time.current.strftime("%H:%M") %>
            </span>
            <span class="vr"></span>
            <span class="text-ptsc-blue fw-medium">
              <i class="fas fa-bus-simple me-1"></i> <%= @vehicles_count %> units
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="mt-3 mt-lg-0">
      <div class="d-flex gap-2">
        <%= link_to new_vehicle_path, class: "ptsc-primary-btn" do %>
          <i class="fas fa-plus-circle me-2"></i> Add Vehicle
        <% end %>
      </div>
    </div>
  </div>

  <!-- AGENCY FILTER BUTTONS - VMCOTT COMPLETELY REMOVED -->
  <div class="agency-filter-section mb-4">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="fw-medium me-2" style="color: <%= ptsc_blue %>;">Filter by Agency:</span>
      
      <!-- All Agencies button (always visible) -->
      <%= link_to vehicles_path, 
          class: "btn agency-filter-btn #{'active-filter' if params[:agency_id].blank?}", 
          style: "background: #{params[:agency_id].blank? ? '#6c757d' : '#f8f9fa'}; color: #{params[:agency_id].blank? ? 'white' : '#6c757d'}; border: 1px solid #6c757d; border-radius: 100px; padding: 0.5rem 1.2rem; font-weight: 500; text-decoration: none; transition: all 0.2s ease;" do %>
        <i class="fas fa-globe me-1"></i> All Agencies
      <% end %>
      
      <!-- Agency-specific buttons - VMCOTT automatically excluded because @agencies doesn't include it -->
      <% @agencies&.each do |agency| %>
        <% color = agency_colors[agency.code] || { bg: "#6c757d", text: "#FFFFFF", icon: "fa-building" } %>
        <% is_active = params[:agency_id].to_s == agency.id.to_s %>
        
        <%= link_to vehicles_path(agency_id: agency.id), 
            class: "btn agency-filter-btn #{'active-filter' if is_active}", 
            style: "background: #{is_active ? color[:bg] : '#f8f9fa'}; color: #{is_active ? 'white' : color[:bg]}; border: 1px solid #{color[:bg]}; border-radius: 100px; padding: 0.5rem 1.2rem; font-weight: 500; text-decoration: none; transition: all 0.2s ease;",
            title: "Filter by #{agency.name} vehicles" do %>
          <i class="fas <%= color[:icon] %> me-1"></i> <%= agency.code %>
          <% if is_active && @vehicles_count.present? %>
            <span class="badge ms-1" style="background: rgba(255,255,255,0.2); color: white;">(<%= @vehicles_count %>)</span>
          <% end %>
        <% end %>
      <% end %>
      
      <!-- Clear filter button (shows when filter is active) -->
      <% if params[:agency_id].present? %>
        <%= link_to vehicles_path, class: "btn btn-outline-secondary rounded-pill", style: "border-radius: 100px; padding: 0.5rem 1.2rem;" do %>
          <i class="fas fa-times me-1"></i> Clear
        <% end %>
      <% end %>
    </div>
    
    <!-- Current filter indicator -->
    <% if params[:agency_id].present? %>
      <% selected_agency = Agency.find_by(id: params[:agency_id]) %>
      <% if selected_agency %>
        <div class="mt-2 small text-muted">
          <i class="fas fa-filter me-1"></i> 
          Currently showing: <strong><%= selected_agency.name %> vehicles</strong>
        </div>
      <% end %>
    <% else %>
      <div class="mt-2 small text-muted">
        <i class="fas fa-globe me-1"></i> 
        Currently showing: <strong>All vehicles from all agencies</strong>
      </div>
    <% end %>
  </div>

  <!-- KPI GRID - TT FLAG COLORS WITH ICON BOXES -->
  <div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Total Fleet</span>
              <div class="display-5 fw-bold"><%= @vehicles_count %></div>
            </div>
            <div class="ptsc-icon-circle bg-ptsc-blue-light">
              <i class="fas fa-bus fa-xl text-ptsc-blue"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-muted small">
            <i class="fas fa-filter me-1"></i> Filtered vehicles
          </div>
          <div class="mt-2 text-end">
            <span class="tt-flag-indicator">
              <span class="tt-dot-red"></span>
              <span class="tt-dot-white"></span>
              <span class="tt-dot-black"></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Active</span>
              <div class="display-5 fw-bold text-success"><%= @kpi_active %></div>
            </div>
            <div class="ptsc-icon-circle bg-success bg-opacity-10">
              <i class="fas fa-check-circle fa-xl text-success"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-success small">
            <i class="fas fa-circle-check me-1"></i> In service
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Maintenance</span>
              <div class="display-5 fw-bold" style="color: <%= ptsc_yellow %>;"><%= @kpi_maintenance %></div>
            </div>
            <div class="ptsc-icon-circle bg-warning bg-opacity-10">
              <i class="fas fa-screwdriver-wrench fa-xl text-warning"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-warning small">
            <i class="fas fa-wrench me-1"></i> Under repair
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Out of Service</span>
              <div class="display-5 fw-bold text-danger"><%= @kpi_out %></div>
            </div>
            <div class="ptsc-icon-circle bg-danger bg-opacity-10">
              <i class="fas fa-exclamation-triangle fa-xl text-danger"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-danger small">
            <i class="fas fa-triangle-exclamation me-1"></i> Needs attention
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILTER SECTION - CLEAN WHITE -->
  <div class="ptsc-filter-card card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="ptsc-icon-circle-sm bg-ptsc-blue-light">
          <i class="fas fa-filter fa-lg text-ptsc-blue"></i>
        </div>
        <h5 class="fw-bold mb-0">Search & Filter</h5>
        <span class="tt-flag-mini ms-2">
          <span class="flag-red"></span>
          <span class="flag-white"></span>
          <span class="flag-black"></span>
        </span>
      </div>
      
      <%= form_with url: vehicles_path, method: :get, local: true, class: "row g-3", data: { turbo_frame: "_top" } do |f| %>
        <!-- Preserve agency filter when searching -->
        <% if params[:agency_id].present? %>
          <%= hidden_field_tag :agency_id, params[:agency_id] %>
        <% end %>
        
        <div class="col-md-6">
          <div class="ptsc-search-group">
            <span class="ptsc-search-icon">
              <i class="fas fa-search" style="color: <%= ptsc_blue %>;"></i>
            </span>
            <%= f.text_field :search, 
                  value: params[:search],
                  placeholder: "Search make, model, license plate...",
                  class: "ptsc-search-input form-control" %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="ptsc-select-wrapper">
            <%= f.select :status, 
                  options_for_select([
                    ["All Statuses", ""],
                    ["Active", "active"],
                    ["Maintenance", "maintenance"],
                    ["Out of Service", "out"],
                    ["Inactive", "inactive"]
                  ], params[:status]),
                  {},
                  class: "ptsc-select form-select" %>
            <i class="fas fa-chevron-down select-arrow"></i>
          </div>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <%= f.submit "Apply", class: "ptsc-apply-btn w-100" %>
          <% if params[:search] || params[:status] || params[:agency_id] %>
            <%= link_to vehicles_path, class: "ptsc-clear-btn w-100" do %>
              Clear
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- VIEW TOGGLE - TT STYLE -->
  <div class="d-flex justify-content-end mb-4">
    <div class="ptsc-view-toggle btn-group rounded-pill shadow-sm" role="group">
      <button type="button" class="ptsc-view-btn active" id="cardViewBtn">
        <i class="fas fa-grid-2 me-2"></i> Card View
      </button>
      <button type="button" class="ptsc-view-btn" id="tableViewBtn">
        <i class="fas fa-list me-2"></i> Table View
      </button>
    </div>
  </div>

  <!-- CARD VIEW - COMPACT CARDS (NO MILEAGE) -->
  <div id="cardView" class="fleet-cards">
    <div class="row g-4">
      <% @vehicles.each do |vehicle| %>
        <!-- Skip VMCOTT vehicles completely -->
        <% next if vehicle.agency&.code == 'VMCOTT' %>
        
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="ptsc-vehicle-card card border-0 shadow-sm rounded-4 h-100">
            <!-- Card Header with TT Flag Indicator -->
            <div class="ptsc-card-header">
              <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                  <span class="tt-mini-stripe">
                    <span class="strip-red"></span>
                    <span class="strip-white"></span>
                    <span class="strip-black"></span>
                  </span>
                  <span class="fw-bold ptsc-reg-number">
                    <%= vehicle.registration_number || vehicle.license_plate || "PTSC-#{vehicle.id}" %>
                  </span>
                </div>
                <div>
                  <% status = vehicle.status.to_s.downcase %>
                  <% case status %>
                  <% when "active" %>
                    <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                  <% when "maintenance" %>
                    <span class="badge" style="background: <%= ptsc_yellow %>; color: #000; border-radius: 100px; padding: 0.5rem 1rem;">Maintenance</span>
                  <% when "out", "inactive" %>
                    <span class="badge bg-danger rounded-pill px-3 py-2">Out of Service</span>
                  <% else %>
                    <span class="badge bg-secondary rounded-pill px-3 py-2"><%= status.titleize %></span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Card Body - COMPACT -->
            <div class="card-body p-3">
              <!-- Vehicle Image - Slightly smaller with agency placeholders -->
              <div class="ptsc-vehicle-image-wrapper mb-3" style="height: 140px;">
                <% if vehicle.primary_photo.attached? %>
                  <!-- Primary photo -->
                  <%= image_tag vehicle.primary_photo, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% elsif vehicle.gallery_photos.attached? && vehicle.gallery_photos.any? %>
                  <!-- Gallery photo -->
                  <%= image_tag vehicle.gallery_photos.first, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% elsif vehicle.picture.present? && vehicle.picture.is_a?(String) %>
                  <!-- Legacy picture field -->
                  <%= image_tag vehicle.picture, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% else %>
                  <!-- Agency-specific placeholder with fallback to Font Awesome icon -->
                  <div class="position-relative w-100 h-100 d-flex align-items-center justify-content-center" style="background: #f8f9fa;">
                    <% case vehicle.agency&.code %>
                    <% when 'PTSC' %>
                      <% begin %>
                        <%= image_tag "placeholders/ptsc_bus.jpg", class: "ptsc-vehicle-image", alt: "PTSC Trinidad Bus", onerror: "this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-bus fa-3x\' style=\'color: #0033a0; opacity: 0.3;\'></i><span class=\'text-muted small mt-2\'>PTSC Bus</span>';" %>
                      <% rescue %>
                        <div class="text-center">
                          <i class="fas fa-bus fa-3x" style="color: #0033a0; opacity: 0.3;"></i>
                          <span class="text-muted small d-block mt-2">PTSC Bus</span>
                        </div>
                      <% end %>
                      <span class="ptsc-image-flag">🚌</span>
                    <% when 'TTPS' %>
                      <% begin %>
                        <%= image_tag "placeholders/ttps_police_vehicle.jpg", class: "ptsc-vehicle-image", alt: "TTPS Police Vehicle", onerror: "this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-shield-alt fa-3x\' style=\'color: #C8102E; opacity: 0.3;\'></i><span class=\'text-muted small mt-2\'>Police Vehicle</span>';" %>
                      <% rescue %>
                        <div class="text-center">
                          <i class="fas fa-shield-alt fa-3x" style="color: #C8102E; opacity: 0.3;"></i>
                          <span class="text-muted small d-block mt-2">Police Vehicle</span>
                        </div>
                      <% end %>
                      <span class="ptsc-image-flag">🚓</span>
                    <% when 'TTDF' %>
                      <% begin %>
                        <%= image_tag "placeholders/ttdf_military_vehicle.jpg", class: "ptsc-vehicle-image", alt: "TTDF Military Vehicle", onerror: "this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-shield fa-3x\' style=\'color: #006747; opacity: 0.3;\'></i><span class=\'text-muted small mt-2\'>Military Vehicle</span>';" %>
                      <% rescue %>
                        <div class="text-center">
                          <i class="fas fa-shield fa-3x" style="color: #006747; opacity: 0.3;"></i>
                          <span class="text-muted small d-block mt-2">Military Vehicle</span>
                        </div>
                      <% end %>
                      <span class="ptsc-image-flag">🚙</span>
                    <% else %>
                      <!-- Fallback to make-based placeholder or icon -->
                      <% begin %>
                        <% image_name = case vehicle.make.to_s.downcase
                             when 'ford' then 'Ford.webp'
                             when 'higer' then 'Higer.jpg'
                             when 'isuzu' then 'Isuzu.jpg'
                             when 'nissan' then 'Nissan.webp'
                             when 'suzuki' then 'Suzuki.jpg'
                             when 'toyota'
                               vehicle.model.to_s.downcase == 'hilux' ? 'Toyota.jpeg' : 'toyota.jpg'
                             else
                               'default.png'
                           end %>
                        <%= image_tag "placeholders/#{image_name}", class: "ptsc-vehicle-image", alt: "#{vehicle.make} placeholder", onerror: "this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-car fa-3x\' style=\'color: #6c757d; opacity: 0.3;\'></i><span class=\'text-muted small mt-2\'>Vehicle</span>';" %>
                      <% rescue %>
                        <div class="text-center">
                          <i class="fas fa-car fa-3x" style="color: #6c757d; opacity: 0.3;"></i>
                          <span class="text-muted small d-block mt-2">Vehicle</span>
                        </div>
                      <% end %>
                      <span class="ptsc-image-flag">🇹🇹</span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <h5 class="ptsc-vehicle-title fw-bold mb-0" style="font-size: 1.1rem;">
                <%= vehicle.make %> <%= vehicle.model %>
              </h5>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="text-muted small">
                  <%= vehicle.year_of_manufacture %> • <%= vehicle.vehicle_type || "Bus" %>
                </div>
                <!-- Agency badge - Clickable to filter by this agency -->
                <%= link_to vehicles_path(agency_id: vehicle.agency_id), 
                    class: "tt-agency-badge text-decoration-none", 
                    style: "background: #{agency_colors[vehicle.agency&.code]&.dig(:bg) || '#6c757d'}20; color: #{agency_colors[vehicle.agency&.code]&.dig(:bg) || '#6c757d'}; padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.8rem; font-weight: 600;",
                    title: "Filter by #{vehicle.agency&.code} vehicles" do %>
                  <%= vehicle.agency&.code || "N/A" %>
                <% end %>
              </div>

              <!-- ONLY LAST SERVICE - NO MILEAGE -->
              <div class="ptsc-vehicle-specs mt-2">
                <% last_maintenance = vehicle.maintenances.order(date: :desc).first if vehicle.respond_to?(:maintenances) %>
                <div class="spec-item">
                  <div class="spec-icon">
                    <i class="fas fa-calendar" style="color: <%= ptsc_blue %>;"></i>
                  </div>
                  <div class="spec-content">
                    <span class="spec-label">Last Service</span>
                    <span class="spec-value"><%= last_maintenance&.date&.strftime("%b %d, %Y") || "No record" %></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer - Compact -->
            <div class="ptsc-card-footer p-3">
              <div class="d-flex gap-2">
                <%= link_to vehicle_path(vehicle),
                      class: "ptsc-view-link w-100 py-2" do %>
                  <i class="fas fa-eye me-2"></i> View
                <% end %>
                <%= link_to edit_vehicle_path(vehicle), 
                      class: "ptsc-edit-link w-100 py-2" do %>
                  <i class="fas fa-edit me-2"></i> Edit
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @vehicles.empty? %>
      <div class="ptsc-empty-state text-center py-5">
        <div class="ptsc-empty-icon mb-3">
          <i class="fas fa-bus fa-4x" style="color: <%= ptsc_blue %>; opacity: 0.2;"></i>
        </div>
        <h5 class="fw-bold mb-2" style="color: <%= ptsc_blue %>;">No vehicles found</h5>
        <p class="text-muted mb-4">Try adjusting your filters or add a new vehicle to the fleet</p>
        <%= link_to new_vehicle_path, class: "ptsc-primary-btn px-5 py-3" do %>
          <i class="fas fa-plus-circle me-2"></i> Add New Vehicle
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- TABLE VIEW (Hidden by default) - MILEAGE KEPT HERE -->
  <div id="tableView" class="d-none">
    <div class="ptsc-table-card card border-0 shadow-sm rounded-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="ptsc-table table align-middle mb-0">
            <thead>
              <tr>
                <th style="width: 80px;"><i class="fas fa-image me-1" style="color: <%= ptsc_blue %>;"></i> Image</th>
                <th><i class="fas fa-id-card me-1" style="color: <%= ptsc_blue %>;"></i> Registration</th>
                <th><i class="fas fa-bus me-1" style="color: <%= ptsc_blue %>;"></i> Vehicle</th>
                <th><i class="fas fa-flag me-1" style="color: <%= ptsc_blue %>;"></i> Status</th>
                <th><i class="fas fa-calendar me-1" style="color: <%= ptsc_blue %>;"></i> Last Service</th>
                <th><i class="fas fa-tachometer-alt me-1" style="color: <%= ptsc_blue %>;"></i> Mileage</th>
                <th><i class="fas fa-building me-1" style="color: <%= ptsc_blue %>;"></i> Agency</th>
                <th class="text-end"><i class="fas fa-tools me-1" style="color: <%= ptsc_blue %>;"></i> Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @vehicles.each do |vehicle| %>
                <!-- Skip VMCOTT vehicles completely -->
                <% next if vehicle.agency&.code == 'VMCOTT' %>
                
                <tr>
                  <!-- Vehicle Image Column -->
                  <td>
                    <div class="ptsc-table-thumbnail">
                      <% if vehicle.primary_photo.attached? %>
                        <%= image_tag vehicle.primary_photo, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% elsif vehicle.gallery_photos.attached? && vehicle.gallery_photos.any? %>
                        <%= image_tag vehicle.gallery_photos.first, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% elsif vehicle.picture.present? && vehicle.picture.is_a?(String) %>
                        <%= image_tag vehicle.picture, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% else %>
                        <div class="ptsc-table-placeholder">
                          <% case vehicle.agency&.code %>
                          <% when 'PTSC' %>
                            <i class="fas fa-bus" style="color: #0033a0;"></i>
                          <% when 'TTPS' %>
                            <i class="fas fa-shield-alt" style="color: #C8102E;"></i>
                          <% when 'TTDF' %>
                            <i class="fas fa-shield" style="color: #006747;"></i>
                          <% else %>
                            <i class="fas fa-car" style="color: #6c757d;"></i>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  
                  <!-- Registration Number -->
                  <td class="fw-bold" style="color: <%= ptsc_blue %>;">
                    <%= vehicle.registration_number || "—" %>
                    <br>
                    <small class="text-muted"><%= vehicle.license_plate || "—" %></small>
                  </td>
                  
                  <!-- Vehicle Details -->
                  <td>
                    <div class="fw-semibold">
                      <%= vehicle.make %> <%= vehicle.model %>
                    </div>
                    <small class="text-muted">
                      <%= vehicle.year_of_manufacture %> • <%= vehicle.vehicle_type || "Bus" %>
                    </small>
                  </td>
                  
                  <!-- Status -->
                  <td>
                    <% status = vehicle.status.to_s.downcase %>
                    <% case status %>
                    <% when "active" %>
                      <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                    <% when "maintenance" %>
                      <span class="badge rounded-pill px-3 py-2" style="background: <%= ptsc_yellow %>; color: #000;">Maintenance</span>
                    <% when "out", "inactive" %>
                      <span class="badge bg-danger rounded-pill px-3 py-2">Out of Service</span>
                    <% else %>
                      <span class="badge bg-secondary rounded-pill px-3 py-2"><%= status.titleize %></span>
                    <% end %>
                  </td>
                  
                  <!-- Last Service -->
                  <td>
                    <% last_maintenance = vehicle.maintenances.order(date: :desc).first if vehicle.respond_to?(:maintenances) %>
                    <%= last_maintenance&.date&.strftime("%b %d, %Y") || "—" %>
                  </td>
                  
                  <!-- MILEAGE -->
                  <td>
                    <%= vehicle.mileage.present? ? "#{number_with_delimiter(vehicle.mileage.to_i)} km" : "—" %>
                  </td>
                  
                  <!-- Agency - Clickable to filter -->
                  <td>
                    <%= link_to vehicles_path(agency_id: vehicle.agency_id), 
                        class: "tt-agency-badge text-decoration-none",
                        style: "background: #{agency_colors[vehicle.agency&.code]&.dig(:bg) || '#6c757d'}20; color: #{agency_colors[vehicle.agency&.code]&.dig(:bg) || '#6c757d'}; padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.8rem; font-weight: 600;",
                        title: "Filter by #{vehicle.agency&.code} vehicles" do %>
                      <%= vehicle.agency&.code || "—" %>
                    <% end %>
                  </td>
                  
                  <!-- Actions -->
                  <td class="text-end">
                    <div class="d-flex gap-2 justify-content-end">
                      <%= link_to vehicle_path(vehicle),
                            class: "ptsc-table-action",
                            title: "View Details" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      <%= link_to edit_vehicle_path(vehicle),
                            class: "ptsc-table-action",
                            title: "Edit Vehicle" do %>
                        <i class="fas fa-edit"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination - TT STYLE -->
  <% if @vehicles.any? %>
    <div class="mt-5 d-flex justify-content-center">
      <div class="ptsc-pagination">
        <%= paginate @vehicles %>
      </div>
    </div>
  <% end %>
  
  <!-- PTSC Fleet Footer -->
  <div class="ptsc-fleet-footer mt-5">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span class="tt-flag-stripe-small">
          <span class="stripe-red"></span>
          <span class="stripe-white"></span>
          <span class="stripe-black"></span>
        </span>
        <span class="small text-muted">
          <i class="fas fa-bus-simple me-1" style="color: <%= ptsc_blue %>;"></i> 
          Vehicle Registry • <%= Date.today.strftime("%B %d, %Y") %>
        </span>
      </div>
      <span class="tt-footer-emblem">
        <i class="fas fa-bus me-1"></i> 🇹🇹
      </span>
    </div>
  </div>
</div>

<!-- JavaScript for View Toggle and Filter Interactions -->
<script>
document.addEventListener('turbo:load', function() {
  // View Toggle
  const cardViewBtn = document.getElementById('cardViewBtn');
  const tableViewBtn = document.getElementById('tableViewBtn');
  const cardView = document.getElementById('cardView');
  const tableView = document.getElementById('tableView');

  if (cardViewBtn && tableViewBtn) {
    cardViewBtn.addEventListener('click', function() {
      cardView.classList.remove('d-none');
      tableView.classList.add('d-none');
      cardViewBtn.classList.add('active');
      tableViewBtn.classList.remove('active');
      localStorage.setItem('ptscFleetView', 'card');
    });

    tableViewBtn.addEventListener('click', function() {
      cardView.classList.add('d-none');
      tableView.classList.remove('d-none');
      tableViewBtn.classList.add('active');
      cardViewBtn.classList.remove('active');
      localStorage.setItem('ptscFleetView', 'table');
    });

    const savedView = localStorage.getItem('ptscFleetView');
    if (savedView === 'table') {
      tableViewBtn.click();
    } else {
      cardViewBtn.click();
    }
  }

  // Agency filter button hover effects
  const filterBtns = document.querySelectorAll('.agency-filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('mouseenter', function() {
      if (!this.classList.contains('active-filter')) {
        this.style.transform = 'translateY(-2px)';
        this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
      }
    });
    btn.addEventListener('mouseleave', function() {
      this.style.transform = 'translateY(0)';
      this.style.boxShadow = 'none';
    });
  });
});
</script>

