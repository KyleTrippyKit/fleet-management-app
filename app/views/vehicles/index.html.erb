<div class="container py-5">

  <h1 class="mb-4 text-primary fw-bold display-5">Fleet Vehicles</h1>

  <!-- Navigation Pills -->
  <ul class="nav nav-pills mb-4 shadow-sm">
    <% {
      "Vehicle List" => vehicles_path,
      "Usage Analytics" => vehicle_usages_path,
      "Maintenance Gantt Chart" => gantt_path,
      "Maintenance" => maintenance_dashboard_vehicles_path,
      "Drivers" => drivers_path,
      "Pick Your Theme" => themes_vehicles_path
    }.each do |label, path| %>
      <li class="nav-item">
        <%= link_to label, path,
              class: "nav-link #{'active' if current_page?(path)} rounded-pill px-3 py-2 shadow-sm" %>
      </li>
    <% end %>
  </ul>

  <!-- Filters -->
  <%= form_with url: vehicles_path, method: :get, local: true,
        html: { id: "vehicles_filter_form" },
        class: "row g-3 align-items-end mb-5" do |f| %>

    <div class="col-md-5">
      <%= f.text_field :query,
            value: @query,
            placeholder: "Search by make, model, or plate...",
            class: "form-control shadow-sm rounded" %>
    </div>

    <div class="col-md-3">
      <%= f.select :owner,
            options_for_select(["All", "PTSC", "Police", "Fire Service"], @owner_filter || "All"),
            {},
            class: "form-select shadow-sm rounded",
            id: "owner_filter" %>
    </div>

    <div class="col-md-4 d-flex justify-content-md-end gap-2">
      <%= f.submit "Search", class: "btn btn-primary fw-bold shadow-sm" %>
      <%= link_to "Add Vehicle", new_vehicle_path, class: "btn btn-success fw-bold shadow-sm" %>
    </div>
  <% end %>

  <!-- VEHICLE CARDS -->
  <% if @vehicles.any? %>
    <div class="row g-4">
      <% @vehicles.each do |vehicle| %>

        <% last_maintenance = vehicle.maintenances.max_by(&:date) if vehicle.maintenances.any? %>
        <% maintenance_due =
             last_maintenance.nil? ||
             (last_maintenance.next_due_date && last_maintenance.next_due_date < Date.today) %>

        <% ribbon_color =
             case vehicle.service_owner
             when 'PTSC' then maintenance_due ? '#004aad' : '#0d6efd'
             when 'Police' then maintenance_due ? '#002244' : '#003366'
             when 'Fire Service' then maintenance_due ? '#b02a37' : '#dc3545'
             else maintenance_due ? '#6c757d' : '#198754'
             end %>

        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
          <div class="vehicle-card card shadow-sm border-0 rounded overflow-hidden">

            <!-- Image Container -->
            <div class="image-container compact-image">
              <!-- Status Ribbon on top -->
              <div class="status-ribbon" style="background-color: <%= ribbon_color %>;">
                <%= maintenance_due ? "Maintenance Due" : "Active" %>
              </div>

              <!-- Vehicle Image -->
              <%= link_to vehicle_path(vehicle) do %>
                <%= image_tag vehicle_image(vehicle, variant: :thumb),
                      class: "vehicle-image",
                      loading: "lazy",
                      style: "width: 100%; height: 180px; object-fit: contain;",
                      onload: "this.style.opacity='1';",
                      onerror: "this.style.display='none';" %>
              <% end %>
            </div>

            <!-- Card Body -->
            <div class="card-body">
              <h5 class="fw-bold mb-2">
                <%= vehicle.make %> <%= vehicle.model %>
                <% if vehicle.license_plate.present? %>
                  <span class="badge bg-dark ms-1"><%= vehicle.license_plate %></span>
                <% end %>
              </h5>

              <p class="mb-2">
                <span class="badge service-badge
                  <%= vehicle.service_owner == 'Police' ? 'bg-police' :
                      vehicle.service_owner == 'Fire Service' ? 'bg-fire' : 'bg-primary' %>">
                  <%= vehicle.service_owner %>
                </span>
              </p>

              <p class="text-muted small mb-3">
                Last Maintenance:
                <%= last_maintenance&.date || "None" %>
              </p>

              <div class="d-flex justify-content-between">
                <%= link_to "Show", vehicle_path(vehicle), class: "btn btn-sm btn-outline-primary w-45 fw-bold" %>
                <%= link_to "Edit", edit_vehicle_path(vehicle), class: "btn btn-sm btn-outline-warning w-45 fw-bold" %>
              </div>
            </div>

          </div>
        </div>

      <% end %>
    </div>

    <div class="mt-4 d-flex justify-content-center">
      <%= paginate @vehicles %>
    </div>

  <% else %>
    <div class="alert alert-info shadow-sm">
      No vehicles found.
      <%= link_to "Add your first vehicle", new_vehicle_path, class: "fw-bold" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", () => {
    const ownerSelect = document.getElementById("owner_filter");
    if (ownerSelect) {
      ownerSelect.addEventListener("change", () =>
        document.getElementById("vehicles_filter_form").requestSubmit()
      );
    }
  });
</script>

<style>
/* =========================
   FULL PAGE BACKGROUND
========================= */
body {
  min-height: 100vh;
  background-color: #c8e6f4;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255,255,255,0.05) 0,
    rgba(255,255,255,0.05) 1px,
    transparent 1px,
    transparent 20px
  );
}

/* =========================
   CONTAINER BACKGROUND
========================= */
.container {
  background: linear-gradient(135deg, #e3f2fd 0%, #d0ebf7 100%);
  border-radius: 12px;
}

/* =========================
   VEHICLE CARD LAYOUT
========================= */
.vehicle-card {
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.vehicle-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

/* =========================
   IMAGE CONTAINER
========================= */
.image-container {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}
.compact-image { height: 180px; }

.vehicle-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: opacity 0.3s ease;
}

/* =========================
   STATUS RIBBON
========================= */
.status-ribbon {
  position: absolute;
  top: 10px;
  left: -36px;
  padding: 6px 56px;
  font-size: 0.75rem;
  font-weight: 700;
  color: #fff;
  transform: rotate(-45deg);
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  z-index: 2;
}

/* =========================
   SERVICE OWNER BADGES
========================= */
.service-badge {
  font-size: 0.9rem;
  padding: 0.45rem 0.75rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  border-radius: 0.6rem;
}

.bg-police { background-color: #003366 !important; color: #fff !important; }
.bg-fire { background-color: #dc3545 !important; color: #fff !important; }
.bg-primary { background-color: #0d6efd !important; color: #fff !important; }

/* =========================
   BUTTON HELPERS
========================= */
.w-45 { width: 45%; }

/* =========================
   PAGINATION
========================= */
.pagination .page-link { border-radius: 6px; margin: 0 3px; }
.pagination .active .page-link { background-color: #0d6efd; border-color: #0d6efd; }

/* =========================
   NAV PILL COLORS
========================= */
.nav-pills .nav-link:not(.active) {
  color: #0d6efd;
  background-color: rgba(13, 110, 253, 0.1);
}
.nav-pills .nav-link.active {
  color: #fff;
  background-color: #0d6efd;
}
</style>
