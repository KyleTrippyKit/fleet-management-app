<%# app/views/vehicles/index.html.erb – PTSC FLEET MANAGEMENT (COMPACT CARDS) %>

<%
  # TT Flag colors
  tt_red = "#c8102e"
  tt_white = "#ffffff"
  tt_black = "#000000"
  ptsc_yellow = "#ffb81c"
  ptsc_blue = "#0033a0"
%>

<!-- Font Awesome 6 (Free) - Explicitly added to ensure icons load -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="ptsc-fleet-dashboard container-fluid py-4 px-4">
  
  <!-- HEADER - PTSC STYLE WITH FLAG -->
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4">
    <div>
      <div class="d-flex align-items-center gap-3 mb-2">
        <!-- TT Flag Stripe Accent -->
        <div class="tt-flag-stripe">
          <div class="stripe-red"></div>
          <div class="stripe-white"></div>
          <div class="stripe-black"></div>
        </div>
        <!-- PTSC Logo Circle with BUS ICON -->
        <div class="ptsc-tt-logo-wrapper">
          <div class="ptsc-tt-logo">
            <i class="fas fa-bus fa-2x"></i>
          </div>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h1 class="display-6 fw-bold mb-0 ptsc-tt-title">Fleet Management</h1>
            <span class="tt-flag-badge">Trinidad & Tobago</span>
          </div>
          <div class="d-flex align-items-center gap-3 mt-1">
            <span class="text-muted"><i class="fas fa-warehouse me-1"></i> Vehicle Registry</span>
            <span class="vr"></span>
            <span class="text-muted">
              <i class="far fa-clock me-1"></i><%= Time.current.strftime("%H:%M") %>
            </span>
            <span class="vr"></span>
            <span class="text-ptsc-blue fw-medium">
              <i class="fas fa-bus-simple me-1"></i> <%= @vehicles_count %> units
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="mt-3 mt-lg-0">
      <div class="d-flex gap-2">
        <%= link_to new_vehicle_path, class: "ptsc-primary-btn" do %>
          <i class="fas fa-plus-circle me-2"></i> Add Vehicle
        <% end %>
      </div>
    </div>
  </div>

  <!-- KPI GRID - TT FLAG COLORS WITH ICON BOXES -->
  <div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Total Fleet</span>
              <div class="display-5 fw-bold"><%= @vehicles_count %></div>
            </div>
            <div class="ptsc-icon-circle bg-ptsc-blue-light">
              <i class="fas fa-bus fa-xl text-ptsc-blue"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-muted small">
            <i class="fas fa-filter me-1"></i> Filtered vehicles
          </div>
          <div class="mt-2 text-end">
            <span class="tt-flag-indicator">
              <span class="tt-dot-red"></span>
              <span class="tt-dot-white"></span>
              <span class="tt-dot-black"></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Active</span>
              <div class="display-5 fw-bold text-success"><%= @kpi_active %></div>
            </div>
            <div class="ptsc-icon-circle bg-success bg-opacity-10">
              <i class="fas fa-check-circle fa-xl text-success"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-success small">
            <i class="fas fa-circle-check me-1"></i> In service
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Maintenance</span>
              <div class="display-5 fw-bold" style="color: <%= ptsc_yellow %>;"><%= @kpi_maintenance %></div>
            </div>
            <div class="ptsc-icon-circle bg-warning bg-opacity-10">
              <i class="fas fa-screwdriver-wrench fa-xl text-warning"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-warning small">
            <i class="fas fa-wrench me-1"></i> Under repair
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="ptsc-kpi-card card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="text-muted text-uppercase small fw-semibold">Out of Service</span>
              <div class="display-5 fw-bold text-danger"><%= @kpi_out %></div>
            </div>
            <div class="ptsc-icon-circle bg-danger bg-opacity-10">
              <i class="fas fa-exclamation-triangle fa-xl text-danger"></i>
            </div>
          </div>
          <div class="d-flex align-items-center text-danger small">
            <i class="fas fa-triangle-exclamation me-1"></i> Needs attention
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILTER SECTION - CLEAN WHITE -->
  <div class="ptsc-filter-card card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="ptsc-icon-circle-sm bg-ptsc-blue-light">
          <i class="fas fa-filter fa-lg text-ptsc-blue"></i>
        </div>
        <h5 class="fw-bold mb-0">Filter & Search</h5>
        <span class="tt-flag-mini ms-2">
          <span class="flag-red"></span>
          <span class="flag-white"></span>
          <span class="flag-black"></span>
        </span>
      </div>
      
      <%= form_with url: vehicles_path, method: :get, local: true, class: "row g-3", data: { turbo_frame: "_top" } do |f| %>
        <div class="col-md-6">
          <div class="ptsc-search-group">
            <span class="ptsc-search-icon">
              <i class="fas fa-search" style="color: <%= ptsc_blue %>;"></i>
            </span>
            <%= f.text_field :search, 
                  value: params[:search],
                  placeholder: "Search make, model, license plate...",
                  class: "ptsc-search-input form-control",
                  data: { action: "input->search#submit" } %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="ptsc-select-wrapper">
            <%= f.select :status, 
                  options_for_select([
                    ["All Statuses", ""],
                    ["Active", "active"],
                    ["Maintenance", "maintenance"],
                    ["Out of Service", "out"],
                    ["Inactive", "inactive"]
                  ], params[:status]),
                  {},
                  class: "ptsc-select form-select",
                  data: { action: "change->search#submit" } %>
            <i class="fas fa-chevron-down select-arrow"></i>
          </div>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <%= f.submit "Apply", class: "ptsc-apply-btn w-100" %>
          <% if params[:search] || params[:status] || params[:agency_id] %>
            <%= link_to "Clear", vehicles_path, class: "ptsc-clear-btn w-100" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- VIEW TOGGLE - TT STYLE -->
  <div class="d-flex justify-content-end mb-4">
    <div class="ptsc-view-toggle btn-group rounded-pill shadow-sm" role="group">
      <button type="button" class="ptsc-view-btn active" id="cardViewBtn">
        <i class="fas fa-grid-2 me-2"></i> Card View
      </button>
      <button type="button" class="ptsc-view-btn" id="tableViewBtn">
        <i class="fas fa-list me-2"></i> Table View
      </button>
    </div>
  </div>

  <!-- CARD VIEW - COMPACT CARDS (NO MILEAGE) -->
  <div id="cardView" class="fleet-cards">
    <div class="row g-4">
      <% @vehicles.each do |vehicle| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="ptsc-vehicle-card card border-0 shadow-sm rounded-4 h-100">
            <!-- Card Header with TT Flag Indicator -->
            <div class="ptsc-card-header">
              <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                  <span class="tt-mini-stripe">
                    <span class="strip-red"></span>
                    <span class="strip-white"></span>
                    <span class="strip-black"></span>
                  </span>
                  <span class="fw-bold ptsc-reg-number">
                    <%= vehicle.registration_number || vehicle.license_plate || "PTSC-#{vehicle.id}" %>
                  </span>
                </div>
                <div>
                  <% status = vehicle.status.to_s.downcase %>
                  <% case status %>
                  <% when "active" %>
                    <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                  <% when "maintenance" %>
                    <span class="badge" style="background: <%= ptsc_yellow %>; color: #000; border-radius: 100px; padding: 0.5rem 1rem;">Maintenance</span>
                  <% when "out", "inactive" %>
                    <span class="badge bg-danger rounded-pill px-3 py-2">Out of Service</span>
                  <% else %>
                    <span class="badge bg-secondary rounded-pill px-3 py-2"><%= status.titleize %></span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Card Body - COMPACT -->
            <div class="card-body p-3">
              <!-- Vehicle Image - Slightly smaller -->
              <div class="ptsc-vehicle-image-wrapper mb-3" style="height: 140px;">
                <%# Check multiple image sources in order of priority %>
                <% if vehicle.respond_to?(:primary_photo) && vehicle.primary_photo.attached? %>
                  <%= image_tag vehicle.primary_photo, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% elsif vehicle.respond_to?(:gallery_photos) && vehicle.gallery_photos.attached? && vehicle.gallery_photos.first.present? %>
                  <%= image_tag vehicle.gallery_photos.first, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% elsif vehicle.respond_to?(:picture) && vehicle.picture.is_a?(String) && vehicle.picture.present? %>
                  <%= image_tag vehicle.picture, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% elsif vehicle.respond_to?(:display_image) && vehicle.display_image.present? %>
                  <%= image_tag vehicle.display_image, class: "ptsc-vehicle-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                <% else %>
                  <div class="ptsc-vehicle-placeholder">
                    <i class="fas fa-bus fa-3x" style="color: <%= ptsc_blue %>; opacity: 0.3;"></i>
                    <span class="text-muted small mt-2">No image</span>
                  </div>
                <% end %>
                
                <!-- TT Flag Watermark -->
                <span class="ptsc-image-flag">🇹🇹</span>
              </div>

              <h5 class="ptsc-vehicle-title fw-bold mb-0" style="font-size: 1.1rem;">
                <%= vehicle.make %> <%= vehicle.model %>
              </h5>
              <div class="text-muted small mb-2">
                <%= vehicle.year_of_manufacture %> • <%= vehicle.vehicle_type || "Bus" %>
              </div>

              <!-- ONLY LAST SERVICE - NO MILEAGE -->
              <div class="ptsc-vehicle-specs mt-2">
                <% last_maintenance = vehicle.maintenances.order(date: :desc).first if vehicle.respond_to?(:maintenances) %>
                <div class="spec-item">
                  <div class="spec-icon">
                    <i class="fas fa-calendar" style="color: <%= ptsc_blue %>;"></i>
                  </div>
                  <div class="spec-content">
                    <span class="spec-label">Last Service</span>
                    <span class="spec-value"><%= last_maintenance&.date&.strftime("%b %d, %Y") || "No record" %></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer - Compact -->
            <div class="ptsc-card-footer p-3">
              <div class="d-flex gap-2">
                <%= link_to vehicle_path(vehicle),
                      class: "ptsc-view-link w-100 py-2" do %>
                  <i class="fas fa-eye me-2"></i> View
                <% end %>
                <%= link_to edit_vehicle_path(vehicle), 
                      class: "ptsc-edit-link w-100 py-2" do %>
                  <i class="fas fa-edit me-2"></i> Edit
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @vehicles.empty? %>
      <div class="ptsc-empty-state text-center py-5">
        <div class="ptsc-empty-icon mb-3">
          <i class="fas fa-bus fa-4x" style="color: <%= ptsc_blue %>; opacity: 0.2;"></i>
        </div>
        <h5 class="fw-bold mb-2" style="color: <%= ptsc_blue %>;">No vehicles found</h5>
        <p class="text-muted mb-4">Try adjusting your filters or add a new vehicle to the fleet</p>
        <%= link_to new_vehicle_path, class: "ptsc-primary-btn px-5 py-3" do %>
          <i class="fas fa-plus-circle me-2"></i> Add New Vehicle
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- TABLE VIEW (Hidden by default) - MILEAGE KEPT HERE -->
  <div id="tableView" class="d-none">
    <div class="ptsc-table-card card border-0 shadow-sm rounded-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="ptsc-table table align-middle mb-0">
            <thead>
              <tr>
                <th style="width: 80px;"><i class="fas fa-image me-1" style="color: <%= ptsc_blue %>;"></i> Image</th>
                <th><i class="fas fa-id-card me-1" style="color: <%= ptsc_blue %>;"></i> Registration</th>
                <th><i class="fas fa-bus me-1" style="color: <%= ptsc_blue %>;"></i> Vehicle</th>
                <th><i class="fas fa-flag me-1" style="color: <%= ptsc_blue %>;"></i> Status</th>
                <th><i class="fas fa-calendar me-1" style="color: <%= ptsc_blue %>;"></i> Last Service</th>
                <th><i class="fas fa-tachometer-alt me-1" style="color: <%= ptsc_blue %>;"></i> Mileage</th>
                <th class="text-end"><i class="fas fa-tools me-1" style="color: <%= ptsc_blue %>;"></i> Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @vehicles.each do |vehicle| %>
                <tr>
                  <!-- Vehicle Image Column - UNIVERSAL HANDLING -->
                  <td>
                    <div class="ptsc-table-thumbnail">
                      <% if vehicle.respond_to?(:primary_photo) && vehicle.primary_photo.attached? %>
                        <%= image_tag vehicle.primary_photo, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% elsif vehicle.respond_to?(:gallery_photos) && vehicle.gallery_photos.attached? && vehicle.gallery_photos.first.present? %>
                        <%= image_tag vehicle.gallery_photos.first, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% elsif vehicle.respond_to?(:picture) && vehicle.picture.is_a?(String) && vehicle.picture.present? %>
                        <%= image_tag vehicle.picture, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% elsif vehicle.respond_to?(:display_image) && vehicle.display_image.present? %>
                        <%= image_tag vehicle.display_image, class: "ptsc-table-image", alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% else %>
                        <div class="ptsc-table-placeholder">
                          <i class="fas fa-bus" style="color: <%= ptsc_blue %>;"></i>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  
                  <!-- Registration Number -->
                  <td class="fw-bold" style="color: <%= ptsc_blue %>;">
                    <%= vehicle.registration_number || "—" %>
                    <br>
                    <small class="text-muted"><%= vehicle.license_plate || "—" %></small>
                  </td>
                  
                  <!-- Vehicle Details -->
                  <td>
                    <div class="fw-semibold">
                      <%= vehicle.make %> <%= vehicle.model %>
                    </div>
                    <small class="text-muted">
                      <%= vehicle.year_of_manufacture %> • <%= vehicle.vehicle_type || "Bus" %>
                    </small>
                  </td>
                  
                  <!-- Status -->
                  <td>
                    <% status = vehicle.status.to_s.downcase %>
                    <% case status %>
                    <% when "active" %>
                      <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                    <% when "maintenance" %>
                      <span class="badge rounded-pill px-3 py-2" style="background: <%= ptsc_yellow %>; color: #000;">Maintenance</span>
                    <% when "out", "inactive" %>
                      <span class="badge bg-danger rounded-pill px-3 py-2">Out of Service</span>
                    <% else %>
                      <span class="badge bg-secondary rounded-pill px-3 py-2"><%= status.titleize %></span>
                    <% end %>
                  </td>
                  
                  <!-- Last Service -->
                  <td>
                    <% last_maintenance = vehicle.maintenances.order(date: :desc).first if vehicle.respond_to?(:maintenances) %>
                    <%= last_maintenance&.date&.strftime("%b %d, %Y") || "—" %>
                  </td>
                  
                  <!-- MILEAGE - KEPT IN TABLE VIEW -->
                  <td>
                    <%= vehicle.mileage.present? ? "#{number_with_delimiter(vehicle.mileage.to_i)} km" : "—" %>
                  </td>
                  
                  <!-- Actions -->
                  <td class="text-end">
                    <div class="d-flex gap-2 justify-content-end">
                      <%= link_to vehicle_path(vehicle),
                            class: "ptsc-table-action",
                            title: "View Details" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      <%= link_to edit_vehicle_path(vehicle),
                            class: "ptsc-table-action",
                            title: "Edit Vehicle" do %>
                        <i class="fas fa-edit"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination - TT STYLE -->
  <% if @vehicles.any? %>
    <div class="mt-5 d-flex justify-content-center">
      <div class="ptsc-pagination">
        <%= paginate @vehicles %>
      </div>
    </div>
  <% end %>
  
  <!-- PTSC Fleet Footer -->
  <div class="ptsc-fleet-footer mt-5">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span class="tt-flag-stripe-small">
          <span class="stripe-red"></span>
          <span class="stripe-white"></span>
          <span class="stripe-black"></span>
        </span>
        <span class="small text-muted">
          <i class="fas fa-bus-simple me-1" style="color: <%= ptsc_blue %>;"></i> 
          Vehicle Registry • <%= Date.today.strftime("%B %d, %Y") %>
        </span>
      </div>
      <span class="tt-footer-emblem">
        <i class="fas fa-bus me-1"></i> 🇹🇹
      </span>
    </div>
  </div>
</div>

<!-- JavaScript for View Toggle -->
<script>
document.addEventListener('turbo:load', function() {
  const cardViewBtn = document.getElementById('cardViewBtn');
  const tableViewBtn = document.getElementById('tableViewBtn');
  const cardView = document.getElementById('cardView');
  const tableView = document.getElementById('tableView');

  if (!cardViewBtn || !tableViewBtn) return;

  // Card View
  cardViewBtn.addEventListener('click', function() {
    cardView.classList.remove('d-none');
    tableView.classList.add('d-none');
    cardViewBtn.classList.add('active');
    tableViewBtn.classList.remove('active');
  });

  // Table View
  tableViewBtn.addEventListener('click', function() {
    cardView.classList.add('d-none');
    tableView.classList.remove('d-none');
    tableViewBtn.classList.add('active');
    cardViewBtn.classList.remove('active');
  });

  // Remember user preference
  const savedView = localStorage.getItem('ptscFleetView');
  if (savedView === 'table') {
    tableViewBtn.click();
  } else {
    cardViewBtn.click();
  }

  // Save preference
  cardViewBtn.addEventListener('click', () => localStorage.setItem('ptscFleetView', 'card'));
  tableViewBtn.addEventListener('click', () => localStorage.setItem('ptscFleetView', 'table'));
});

// Auto-submit for filter
document.addEventListener('turbo:load', function() {
  const searchInput = document.querySelector('input[name="search"]');
  const statusSelect = document.querySelector('select[name="status"]');
  
  if (searchInput) {
    let searchTimeout;
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(function() {
        const form = searchInput.closest('form');
        if (form) form.submit();
      }, 500);
    });
  }
  
  if (statusSelect) {
    statusSelect.addEventListener('change', function() {
      const form = statusSelect.closest('form');
      if (form) form.submit();
    });
  }
});
</script>

<style>
/* ============================================================
   PTSC FLEET MANAGEMENT - TRINIDAD & TOBAGO THEME
   Compact cards - no mileage
   ============================================================ */

.ptsc-fleet-dashboard {
  background: linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);
  min-height: 100vh;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* TT Flag Stripe */
.tt-flag-stripe {
  display: flex;
  flex-direction: column;
  width: 8px;
  height: 56px;
  border-radius: 4px;
  overflow: hidden;
}

.stripe-red, .flag-red, .strip-red {
  background-color: #c8102e;
}

.stripe-white, .flag-white, .strip-white {
  background-color: #ffffff;
  border-top: 1px solid #e0e0e0;
  border-bottom: 1px solid #e0e0e0;
}

.stripe-black, .flag-black, .strip-black {
  background-color: #000000;
}

/* TT Mini Stripe for cards */
.tt-mini-stripe {
  display: flex;
  flex-direction: column;
  width: 4px;
  height: 32px;
  border-radius: 2px;
  overflow: hidden;
}

.strip-red, .strip-white, .strip-black {
  flex: 1;
  width: 100%;
}

/* PTSC Logo */
.ptsc-tt-logo-wrapper {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  background: linear-gradient(135deg, #ffb81c 0%, #ffd700 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 16px rgba(255, 184, 28, 0.15);
}

.ptsc-tt-logo {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #0033a0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffb81c;
}

.ptsc-tt-title {
  color: #0033a0;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.tt-flag-badge {
  background: linear-gradient(90deg, #c8102e 0%, #000000 50%, #c8102e 100%);
  color: white;
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.text-ptsc-blue {
  color: #0033a0 !important;
}

/* TT Flag Indicators */
.tt-flag-indicator {
  display: inline-flex;
  gap: 3px;
  align-items: center;
}

