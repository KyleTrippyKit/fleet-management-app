<%# app/views/vehicles/new.html.erb %>

<% agency_code = (current_user&.agency&.code || "default").to_s.downcase %>

<% bg_image =
     case agency_code
     when "ptsc"   then asset_path("backgrounds/ptsc_bus.jpg")
     when "ttps"   then asset_path("backgrounds/ttps_police.jpg")
     when "ttdf"   then asset_path("backgrounds/ttdf_fire.jpg")
     when "vmcott" then asset_path("backgrounds/vmcott_garage.jpg")
     else nil
     end %>

<div class="vehicle-new-page <%= agency_code %>"
     style="<%= bg_image.present? ? "background-image: url('#{bg_image}');" : "" %>">

  <div class="vehicle-new-overlay">
    <div class="container py-4">

      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h1 class="mb-0 text-white fw-bold d-flex align-items-center gap-2">
            <span class="vehicle-new-icon">
              <i class="bi bi-plus-lg"></i>
            </span>
            Add New Vehicle
          </h1>
          <div class="text-white-50 mt-1">
            <span class="badge bg-dark bg-opacity-50 me-2 text-uppercase"><%= agency_code %></span>
            Create a new fleet record
          </div>
        </div>

        <%= link_to vehicles_path, class: "btn btn-outline-light fw-bold" do %>
          <i class="bi bi-arrow-left me-2"></i> Back to Vehicles
        <% end %>
      </div>

      <div class="vehicle-form-shell">
        <div class="card border-0 shadow-lg vehicle-form-card">
          <div class="card-body p-3 p-md-4 p-lg-5">
            <%= render "form", vehicle: @vehicle %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%# Bootstrap Icons (keep ONLY if you are not loading icons globally) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
  /* =========================================================
     VEHICLE NEW PAGE — FULL BACKGROUND + CENTERED GLASS CARD
     ========================================================= */

  .vehicle-new-page {
    min-height: calc(100vh - 80px);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  /* Fallback gradient if no image */
  .vehicle-new-page:not([style*="background-image"]) {
    background-image: radial-gradient(1200px 600px at 20% 10%, rgba(13,110,253,.55), transparent 60%),
                      radial-gradient(1200px 600px at 80% 20%, rgba(25,135,84,.35), transparent 55%),
                      linear-gradient(135deg, #0b1b3a, #0d6efd);
  }

  .vehicle-new-overlay {
    min-height: inherit;
    background: linear-gradient(to bottom,
      rgba(0,0,0,0.58),
      rgba(0,0,0,0.35) 35%,
      rgba(0,0,0,0.25) 70%,
      rgba(0,0,0,0.35)
    );
    padding-bottom: 48px;
  }

  .vehicle-new-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
  }

  /* Centered shell so card is not full width (THIS is the big visual fix) */
  .vehicle-form-shell {
    display: flex;
    justify-content: center;
    margin-top: 12px;
  }

  .vehicle-form-card {
    width: 100%;
    max-width: 1100px; /* stops it from stretching across the entire screen */
    border-radius: 18px;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(10px);
  }

  /* Give the page some breathing room on smaller screens */
  @media (max-width: 768px) {
    .vehicle-new-page { background-attachment: scroll; }
    .vehicle-form-card { max-width: 100%; border-radius: 14px; }
  }
</style>
