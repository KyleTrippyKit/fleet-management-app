<%# app/views/vehicles/_form.html.erb %>

<%= form_with(
      model: vehicle,
      local: true,
      html: {
        multipart: true,
        class: "needs-validation",
        novalidate: true
      }
    ) do |form| %>

  <% if vehicle.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(vehicle.errors.count, "error") %> prevented this vehicle from saving:</h5>
      <ul class="mb-0">
        <% vehicle.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">

    <!-- LEFT COLUMN -->
    <div class="col-md-6">

      <%# Agency selection only for VMCOTT %>
      <% if current_user.agency.code == "VMCOTT" %>
        <div class="mb-3">
          <%= form.label :agency_id, "Agency", class: "form-label fw-semibold" %>
          <%= form.collection_select :agency_id, Agency.all.order(:name), :id, :name,
                { include_blank: "Select Agency" },
                { class: "form-select", required: true } %>
          <small class="text-muted">Select which agency this vehicle belongs to</small>
        </div>
      <% else %>
        <div class="mb-3">
          <label class="form-label fw-semibold">Agency</label>
          <input type="text" class="form-control" value="<%= current_user.agency.name %>" readonly>
          <small class="text-muted">Your agency: <%= current_user.agency.code %></small>
          <%= form.hidden_field :agency_id, value: current_user.agency.id %>
        </div>
      <% end %>

      <!-- MAKE & MODEL with direct JavaScript search (no Stimulus) -->
      <div class="mb-3 position-relative" id="vehicle-catalog-container">
        <%= form.label :make_model_ui, "Make & Model", class: "form-label fw-semibold" %>

        <div class="input-group">
          <%= form.text_field :make_model_ui,
                value: [vehicle.make, vehicle.model].compact.join(" "),
                class: "form-control",
                placeholder: "Start typing e.g. Toyota Hilux",
                autocomplete: "off",
                id: "catalog-search-input" %>
          <span class="input-group-text bg-light" id="catalog-status">
            <span class="spinner-border spinner-border-sm d-none" id="catalog-spinner" role="status"></span>
          </span>
        </div>

        <!-- Search Results Dropdown -->
        <div id="catalog-results"
             class="list-group position-absolute w-100 shadow"
             style="display:none; z-index:2000; max-height:260px; overflow:auto; background: white; border: 1px solid #ced4da;">
        </div>

        <!-- Hidden fields for make/model/type -->
        <%= form.hidden_field :make,  value: vehicle.make,  id: "selected-make" %>
        <%= form.hidden_field :model, value: vehicle.model, id: "selected-model" %>
        <%= form.hidden_field :vehicle_type, value: vehicle.vehicle_type, id: "selected-type" %>

        <small class="text-muted d-block mt-1">
          <i class="bi bi-info-circle me-1"></i>Type 2+ letters to search catalog. Click a suggestion to auto-fill.
        </small>
      </div>

      <div class="mb-3">
        <%= form.label :vehicle_type, class: "form-label fw-semibold" %>
        <%= form.select :vehicle_type,
              (@vehicle_types || []).map { |t| [t, t] },
              { include_blank: "Select vehicle type" },
              class: "form-select", id: "vehicle-type-select" %>
      </div>

      <div class="mb-3">
        <%= form.label :color, class: "form-label fw-semibold" %>
        <%= form.text_field :color, class: "form-control", maxlength: 30 %>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :year_of_manufacture, class: "form-label fw-semibold" %>
          <%= form.number_field :year_of_manufacture, 
                class: "form-control", 
                min: 1970, 
                max: Time.current.year,
                step: 1,
                placeholder: "e.g. 2022" %>
          <small class="text-muted">Year must be between 1980 and <%= Time.current.year %></small>
        </div>
        <div class="col-md-6">
          <%= form.label :mileage, class: "form-label fw-semibold" %>
          <%= form.number_field :mileage, 
                class: "form-control", 
                placeholder: "e.g. 125000",
                min: 0,
                max: 9999999,
                step: 1 %>
          <small class="text-muted">Maximum 9,999,999 km</small>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <%= form.label :chassis_number, class: "form-label fw-semibold" %>
          <%= form.text_field :chassis_number, 
                class: "form-control", 
                required: true,
                maxlength: 30,
                placeholder: "e.g. CH-TY-001" %>
          <div class="invalid-feedback">Chassis number is required.</div>
          <small class="text-muted">Maximum 30 characters</small>
        </div>

        <div class="col-md-6">
          <%= form.label :serial_number, class: "form-label fw-semibold" %>
          <%= form.text_field :serial_number, 
                class: "form-control", 
                required: true,
                maxlength: 30,
                placeholder: "e.g. SN-TY-001" %>
          <div class="invalid-feedback">Serial number is required.</div>
          <small class="text-muted">Maximum 30 characters</small>
        </div>
      </div>

      <div class="mt-3">
        <%= form.label :engine_number, class: "form-label fw-semibold" %>
        <%= form.text_field :engine_number, 
              class: "form-control",
              maxlength: 30,
              placeholder: "e.g. ENG-TY-001" %>
        <small class="text-muted">Maximum 30 characters</small>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-md-6">

      <!-- LICENSE PLATE ONLY -->
      <div class="mb-3">
        <%= form.label :license_plate, "License Plate", class: "form-label fw-semibold" %>
        <%= form.text_field :license_plate,
              class: "form-control",
              placeholder: "e.g. PDL-1234, HBA-55, TCD-9",
              maxlength: 10,
              pattern: "[A-Za-z0-9-]+",
              title: "License plate format: letters, numbers, and hyphens only" %>

        <small class="text-muted d-block mt-1">
          Trinidad examples: <strong>PDL-1234</strong>, <strong>HBA-55</strong>, <strong>TCD-9</strong>, <strong>CD-12</strong>
          <br>Maximum 10 characters
        </small>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Service Owner</label>
        <input type="text"
               class="form-control"
               value="<%= (vehicle.service_owner.presence || current_user.agency.code) %>"
               readonly>
        <small class="text-muted">Auto-assigned based on logged-in agency.</small>
        <%= form.hidden_field :service_owner,
              value: (vehicle.service_owner.presence || current_user.agency.code) %>
      </div>

      <!-- PHOTOS -->
      <div class="mb-3">
        <%= form.label :primary_photo, "Main Vehicle Photo", class: "form-label fw-semibold" %>
        <%= form.file_field :primary_photo, class: "form-control", accept: "image/*" %>
        <small class="text-muted">Accepted formats: JPG, PNG, GIF (max 10MB)</small>
      </div>

      <div class="mb-3">
        <%= form.label :gallery_photos, "Additional Photos", class: "form-label fw-semibold" %>
        <%= form.file_field :gallery_photos, multiple: true, class: "form-control", accept: "image/*" %>
        <small class="text-muted">You can select multiple photos</small>
      </div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= form.submit "Save Vehicle", class: "btn btn-primary fw-bold px-4" %>
    <%= link_to "Cancel", vehicles_path, class: "btn btn-outline-secondary fw-bold px-4" %>
  </div>

<% end %>

<!-- Direct JavaScript implementation (no Stimulus dependency) -->
<script>
  (function() {
    'use strict';
    
    // Form validation
    document.addEventListener("turbo:load", function() {
      // Year validation
      const yearField = document.querySelector('input[name="vehicle[year_of_manufacture]"]');
      if (yearField) {
        yearField.addEventListener('change', function() {
          const year = parseInt(this.value);
          const currentYear = new Date().getFullYear();
          if (year < 1980) {
            this.setCustomValidity('Year must be 1980 or later');
          } else if (year > currentYear) {
            this.setCustomValidity(`Year cannot be later than ${currentYear}`);
          } else {
            this.setCustomValidity('');
          }
        });
      }

      // License plate format
      const plateField = document.querySelector('input[name="vehicle[license_plate]"]');
      if (plateField) {
        plateField.addEventListener('input', function() {
          this.value = this.value.toUpperCase();
        });
      }
    });

    // ============================================
    // VEHICLE CATALOG SEARCH (Direct JavaScript)
    // ============================================
    const searchInput = document.getElementById('catalog-search-input');
    const resultsDiv = document.getElementById('catalog-results');
    const makeField = document.getElementById('selected-make');
    const modelField = document.getElementById('selected-model');
    const typeField = document.getElementById('selected-type');
    const typeSelect = document.getElementById('vehicle-type-select');
    const spinner = document.getElementById('catalog-spinner');
    
    if (searchInput && resultsDiv) {
      let searchTimeout;
      
      // Function to fetch and display results
      function searchCatalog() {
        const query = searchInput.value.trim();
        
        if (query.length < 2) {
          resultsDiv.style.display = 'none';
          return;
        }
        
        // Show spinner
        if (spinner) spinner.classList.remove('d-none');
        
        // Clear previous timeout
        clearTimeout(searchTimeout);
        
        // Set new timeout
        searchTimeout = setTimeout(() => {
          fetch(`/vehicles/catalog_search?q=${encodeURIComponent(query)}`, {
            headers: {
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('[name="csrf-token"]')?.content
            },
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            // Hide spinner
            if (spinner) spinner.classList.add('d-none');
            
            if (data && data.length > 0) {
              resultsDiv.innerHTML = '';
              data.forEach(item => {
                const resultItem = document.createElement('button');
                resultItem.type = 'button';
                resultItem.className = 'list-group-item list-group-item-action';
                resultItem.setAttribute('data-make', item.make);
                resultItem.setAttribute('data-model', item.model);
                resultItem.setAttribute('data-type', item.vehicle_type || '');
                resultItem.innerHTML = `
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong>${item.label}</strong>
                      ${item.vehicle_type ? `<br><small class="text-muted">${item.vehicle_type}</small>` : ''}
                    </div>
                    <span class="badge bg-primary">Select</span>
                  </div>
                `;
                
                resultItem.addEventListener('click', function() {
                  selectCatalogItem(this);
                });
                
                resultsDiv.appendChild(resultItem);
              });
              resultsDiv.style.display = 'block';
            } else {
              resultsDiv.innerHTML = '<div class="list-group-item text-center text-muted">No matches found</div>';
              resultsDiv.style.display = 'block';
            }
          })
          .catch(error => {
            console.error('Search error:', error);
            if (spinner) spinner.classList.add('d-none');
            resultsDiv.innerHTML = '<div class="list-group-item text-center text-danger">Error searching catalog</div>';
            resultsDiv.style.display = 'block';
          });
        }, 300);
      }
      
      // Function to select an item
      function selectCatalogItem(button) {
        const make = button.getAttribute('data-make');
        const model = button.getAttribute('data-model');
        const type = button.getAttribute('data-type');
        
        // Update hidden fields
        if (makeField) makeField.value = make;
        if (modelField) modelField.value = model;
        if (typeField) typeField.value = type;
        
        // Update the select dropdown if type exists
        if (typeSelect && type) {
          const option = Array.from(typeSelect.options).find(opt => opt.value === type);
          if (option) {
            typeSelect.value = type;
          }
        }
        
        // Update search input
        searchInput.value = `${make} ${model}`.trim();
        
        // Hide results
        resultsDiv.style.display = 'none';
      }
      
      // Add input event listener
      searchInput.addEventListener('input', searchCatalog);
      
      // Close results when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
          resultsDiv.style.display = 'none';
        }
      });
      
      console.log('✅ Vehicle catalog search initialized (direct JS)');
    }
  })();
</script>

<style>
  /* Additional styles for catalog dropdown */
  #catalog-results .list-group-item {
    cursor: pointer;
    border-left: none;
    border-right: none;
    padding: 8px 12px;
    transition: background-color 0.2s;
  }
  
  #catalog-results .list-group-item:first-child {
    border-top: none;
  }
  
  #catalog-results .list-group-item:last-child {
    border-bottom: none;
  }
  
  #catalog-results .list-group-item:hover {
    background-color: #f8f9fa;
  }
  
  #catalog-results .list-group-item.active {
    background-color: #0d6efd;
    color: white;
  }
  
  /* Ensure dropdown appears above other elements */
  #vehicle-catalog-container {
    z-index: 100;
  }
</style>