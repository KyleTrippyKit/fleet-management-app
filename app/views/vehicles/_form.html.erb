<!-- app/views/vehicles/_form.html.erb -->

<%= form_with(model: vehicle, local: true, html: { multipart: true, class: "needs-validation" }) do |form| %>

  <% if vehicle.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(vehicle.errors.count, "error") %> prevented this vehicle from saving:</h5>
      <ul class="mb-0">
        <% vehicle.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">

    <!-- LEFT COLUMN -->
    <div class="col-md-6">

      <%# Agency selection only for VMCOTT %>
      <% if current_user.agency.code == "VMCOTT" %>
        <div class="mb-3">
          <%= form.label :agency_id, "Agency", class: "form-label fw-semibold" %>
          <%= form.collection_select :agency_id, Agency.all.order(:name), :id, :name,
                { include_blank: "Select Agency" },
                { class: "form-select", required: true } %>
          <small class="text-muted">Select which agency this vehicle belongs to</small>
        </div>
      <% else %>
        <div class="mb-3">
          <label class="form-label fw-semibold">Agency</label>
          <input type="text" class="form-control" value="<%= current_user.agency.name %>" readonly>
          <small class="text-muted">Your agency: <%= current_user.agency.code %></small>
          <%= form.hidden_field :agency_id, value: current_user.agency.id %>
        </div>
      <% end %>

      <%# MAKE + MODEL AUTOCOMPLETE (Stimulus) %>
      <div class="mb-3 position-relative"
           data-controller="vehicle-catalog"
           data-vehicle-catalog-url-value="/vehicles/catalog_search">

        <%= form.label :make_model_ui, "Make & Model", class: "form-label fw-semibold" %>

        <%= form.text_field :make_model_ui,
              value: [vehicle.make, vehicle.model].compact.join(" "),
              class: "form-control",
              placeholder: "Start typing e.g. Toyota Hilux, Nissan Navara, Higer KLQ",
              autocomplete: "off",
              data: {
                "vehicle-catalog-target": "query",
                action: "input->vehicle-catalog#search keydown->vehicle-catalog#keydown blur->vehicle-catalog#blur"
              } %>

        <div data-vehicle-catalog-target="results"
             class="list-group position-absolute w-100 shadow"
             style="display:none; z-index:2000; max-height:260px; overflow:auto;">
        </div>

        <small data-vehicle-catalog-target="status" class="text-muted d-block mt-1"></small>

        <%= form.hidden_field :make,  value: vehicle.make,  data: { "vehicle-catalog-target": "make" } %>
        <%= form.hidden_field :model, value: vehicle.model, data: { "vehicle-catalog-target": "model" } %>

        <small class="text-muted d-block mt-1">
          Type 2+ letters. Use ↑/↓ then Enter, or click a suggestion.
          If typing manually, separate make and model with a space (e.g. <strong>Toyota Hilux</strong>).
        </small>
      </div>

      <%# Vehicle Type dropdown %>
      <div class="mb-3">
        <%= form.label :vehicle_type, class: "form-label fw-semibold" %>
        <%= form.select :vehicle_type,
              (@vehicle_types || []).map { |t| [t, t] },
              { include_blank: "Select vehicle type" },
              class: "form-select",
              data: { "vehicle-catalog-target": "type" } %>
        <small class="text-muted">Optional (auto-filled from catalog if available).</small>
      </div>

      <div class="mb-3">
        <%= form.label :color, class: "form-label fw-semibold" %>
        <%= form.text_field :color, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :year_of_manufacture, class: "form-label fw-semibold" %>
        <%= form.number_field :year_of_manufacture, class: "form-control", min: 1900, max: Time.current.year %>
      </div>

      <div class="mb-3">
        <%= form.label :chassis_number, class: "form-label fw-semibold" %>
        <%= form.text_field :chassis_number, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :serial_number, class: "form-label fw-semibold" %>
        <%= form.text_field :serial_number, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :engine_number, class: "form-label fw-semibold" %>
        <%= form.text_field :engine_number, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :fuel_type, class: "form-label fw-semibold" %>
        <%= form.select :fuel_type,
              VehiclesController::FUEL_TYPES.map { |t| [t, t] },
              { include_blank: "Select fuel type" },
              class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= form.label :transmission, class: "form-label fw-semibold" %>
        <%= form.select :transmission,
              VehiclesController::TRANSMISSIONS.map { |t| [t, t] },
              { include_blank: "Select transmission" },
              class: "form-select" %>
      </div>

      <%# Drive Type dropdown (stored in body_style column) %>
      <div class="mb-3">
        <%= form.label :body_style, "Drive Type", class: "form-label fw-semibold" %>
        <%= form.select :body_style,
              VehiclesController::DRIVE_TYPES.map { |t| [t, t] },
              { include_blank: "Select drive type" },
              class: "form-select" %>
        <small class="text-muted">Choose how the vehicle drives (FWD/RWD/4WD/AWD).</small>
      </div>

      <div class="mb-3">
        <%= form.label :modifications, class: "form-label fw-semibold" %>
        <%= form.text_area :modifications, class: "form-control", rows: 3 %>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-md-6">

      <%# Combined License + Registration UI field %>
      <div class="mb-3">
        <%= form.label :license_registration_ui, "License Plate / Registration (Optional)", class: "form-label fw-semibold" %>
        <%= form.text_field :license_registration_ui,
              value: [vehicle.license_plate, vehicle.registration_number].compact.join(" / "),
              class: "form-control",
              placeholder: "e.g. PDL-1234 / REG-88991 (REG optional)" %>

        <%= form.hidden_field :license_plate, value: vehicle.license_plate %>
        <%= form.hidden_field :registration_number, value: vehicle.registration_number %>

        <small class="text-muted d-block mt-1">
          Trinidad examples: <strong>PDL-1234</strong>, <strong>HBA-55</strong>, <strong>TCD-9</strong>, <strong>CD-12</strong>.
          You can enter just the plate, or plate + registration separated by <strong>/</strong>.
        </small>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Service Owner</label>
        <input type="text" class="form-control" value="<%= (vehicle.service_owner.presence || current_user.agency.code) %>" readonly>
        <small class="text-muted">Auto-assigned based on logged-in agency.</small>
        <%= form.hidden_field :service_owner, value: (vehicle.service_owner.presence || current_user.agency.code) %>
      </div>

      <div class="mb-3">
        <%= form.label :mileage, class: "form-label fw-semibold" %>
        <%= form.number_field :mileage, class: "form-control", placeholder: "e.g. 125000" %>
      </div>

      <!-- Primary Photo Upload -->
      <div class="mb-4">
        <div class="mb-3">
          <%= form.label :primary_photo, "Main Vehicle Photo", class: "form-label fw-semibold" %>
          <%= form.file_field :primary_photo, class: "form-control", accept: "image/*" %>
          <div class="form-text">
            Upload a clear photo of the vehicle. Will be used instead of placeholder.
          </div>
        </div>

        <% if vehicle.persisted? && vehicle.primary_photo.attached? %>
          <div class="current-photo mb-3">
            <p class="text-muted mb-2">Current photo:</p>
            <div class="d-flex align-items-center gap-3">
              <%= image_tag vehicle.primary_photo.variant(resize_to_limit: [200, 150]),
                    class: "img-thumbnail" %>
              <div class="form-check">
                <%= form.check_box :remove_primary_photo, class: "form-check-input" %>
                <%= form.label :remove_primary_photo, "Remove this photo", class: "form-check-label" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Gallery Photos Upload -->
      <div class="mb-3">
        <%= form.label :gallery_photos, "Additional Photos", class: "form-label fw-semibold" %>
        <%= form.file_field :gallery_photos, multiple: true, class: "form-control", accept: "image/*" %>
        <div class="form-text">
          Upload additional photos (interior, engine, documents, etc.)
        </div>

        <% if vehicle.persisted? && vehicle.gallery_photos.attached? %>
          <div class="mt-3">
            <p class="text-muted mb-2">Current gallery photos:</p>
            <div class="d-flex flex-wrap gap-3">
              <% vehicle.gallery_photos.each do |photo| %>
                <div class="position-relative">
                  <%= image_tag photo.variant(resize_to_limit: [100, 75]),
                        class: "img-thumbnail" %>
                  <div class="form-check mt-1">
                    <%= check_box_tag "remove_gallery_photo_ids[]",
                          photo.id,
                          false,
                          class: "form-check-input" %>
                    <%= label_tag "remove_gallery_photo_ids_#{photo.id}",
                          "Remove",
                          class: "form-check-label" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= form.submit "Save Vehicle", class: "btn btn-primary fw-bold px-4" %>
    <%= link_to "Cancel", vehicles_path, class: "btn btn-outline-secondary fw-bold px-4" %>
  </div>

<% end %>
