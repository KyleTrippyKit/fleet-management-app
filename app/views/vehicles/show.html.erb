<div class="container py-4">
  <!-- Vehicle Header Card with Photo -->
  <div class="card mb-4 shadow-sm">
    <div class="row g-0">
      <div class="col-md-4">
        <div class="position-relative h-100">
          <!-- Vehicle Photo -->
          <%= vehicle_image(@vehicle, variant: :medium, 
                class: "img-fluid rounded-start h-100 w-100", 
                style: "object-fit: contain; background-color: #f8f9fa;",
                alt: "#{@vehicle.make} #{@vehicle.model}") %>
          
          <!-- Photo status indicator -->
          <div class="position-absolute bottom-0 start-0 m-2">
            <% if has_uploaded_photo?(@vehicle) %>
              <span class="badge bg-success">
                <i class="bi bi-check-circle"></i> Custom Photo
              </span>
            <% else %>
              <span class="badge bg-secondary">
                <i class="bi bi-image"></i> Placeholder
              </span>
            <% end %>
          </div>
          
          <!-- Quick Action Buttons -->
          <div class="position-absolute bottom-0 end-0 m-2">
            <div class="d-flex flex-column gap-2">
              <!-- Report Issue Button -->
              <%= link_to report_issue_vehicle_path(@vehicle), 
                    class: "btn btn-warning btn-sm shadow-sm",
                    title: "Report maintenance issue" do %>
                <i class="bi bi-exclamation-triangle"></i> Report Issue
              <% end %>
              
              <!-- Quick Status Update (Optional) -->
              <% if @vehicle.has_active_maintenance? %>
                <%= link_to "View Maintenance", 
                      maintenances_path(vehicle_id: @vehicle.id), 
                      class: "btn btn-info btn-sm shadow-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-8">
        <div class="card-body h-100 d-flex flex-column">
          <h5 class="card-title">
            <%= @vehicle.make %> <%= @vehicle.model %>
            <% if @vehicle.license_plate.present? %>
              <span class="badge bg-dark ms-2"><%= @vehicle.license_plate %></span>
            <% end %>
          </h5>
          
          <p class="card-text">
            <strong>Service Owner:</strong> 
            <span class="badge <%= service_owner_badge_class(@vehicle.service_owner) %>">
              <%= @vehicle.service_owner %>
            </span>
          </p>
          
          <p class="card-text">
            <small class="text-body-secondary">
              Last Maintenance: 
              <% last_maintenance = @vehicle.maintenances.order(date: :desc).first %>
              <%= last_maintenance&.date || "No maintenance yet" %>
            </small>
          </p>
          
          <!-- Vehicle Status -->
          <div class="mt-2 mb-3">
            <strong>Status:</strong> 
            <span class="badge <%= @vehicle.status_badge_class %>">
              <%= @vehicle.status_display %>
            </span>
            
            <!-- Maintenance alert if needed -->
            <% if @vehicle.has_overdue_maintenance? %>
              <span class="badge bg-danger ms-2">
                <i class="bi bi-exclamation-circle"></i> Overdue
              </span>
            <% elsif @vehicle.has_active_maintenance? %>
              <span class="badge bg-warning ms-2">
                <i class="bi bi-tools"></i> In Maintenance
              </span>
            <% end %>
          </div>
          
          <!-- Current Driver Info -->
          <% if @vehicle.driver %>
            <div class="mt-auto pt-3 border-top">
              <p class="card-text mb-1">
                <strong>Current Driver:</strong> 
                <%= link_to @vehicle.driver.name, driver_path(@vehicle.driver), class: "text-decoration-none" %>
              </p>
              <% if @vehicle.driver.contact_number.present? %>
                <p class="card-text mb-0">
                  <small class="text-body-secondary">
                    <i class="bi bi-telephone"></i> <%= @vehicle.driver.contact_number %>
                  </small>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Vehicle Info Card -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Type:</strong> <%= @vehicle.vehicle_type %></p>
          <p><strong>Color:</strong> <%= @vehicle.color %></p>
          <p><strong>Mileage:</strong> <%= @vehicle.mileage || "Unknown" %> km</p>
          <p><strong>Driver:</strong> 
            <% if @vehicle.driver %>
              <%= link_to @vehicle.current_driver_name, driver_path(@vehicle.driver) %>
            <% else %>
              Unassigned
            <% end %>
          </p>
        </div>
        <div class="col-md-6">
          <% if @next_service_mileage && @mileage_left %>
            <p><strong>Next Service Mileage:</strong> <%= @next_service_mileage %> km</p>
            <p><strong>Mileage until next service:</strong>
              <% if @mileage_left > 2000 %>
                <span class="badge bg-success"><%= @mileage_left %> km</span>
              <% elsif @mileage_left > 0 %>
                <span class="badge bg-warning"><%= @mileage_left %> km</span>
              <% else %>
                <span class="badge bg-danger">Overdue!</span>
              <% end %>
            </p>
          <% else %>
            <p><strong>Next Service Mileage:</strong> Unknown</p>
          <% end %>
        </div>
      </div>

      <%= link_to "View Full Vehicle Details", full_details_vehicle_path(@vehicle), class: "btn btn-primary mt-3" %>
    </div>
  </div>

  <!-- Gallery Photos Section -->
  <% if has_gallery_photos?(@vehicle) %>
    <div class="card mb-4 shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Additional Photos</h5>
        <small class="text-muted">Click to enlarge</small>
      </div>
      <div class="card-body">
        <div class="row">
          <% gallery_photos(@vehicle).each do |photo| %>
            <div class="col-md-3 col-sm-4 col-6 mb-3">
              <%= image_tag photo.variant(resize_to_limit: [200, 150]), 
                    class: "img-thumbnail w-100", 
                    style: "height: 150px; object-fit: cover; cursor: pointer;",
                    alt: "Gallery photo",
                    data: { bs_toggle: "modal", bs_target: "#photoModal-#{photo.id}" } %>
            </div>
            
            <!-- Modal for each photo -->
            <div class="modal fade" id="photoModal-<%= photo.id %>" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">Vehicle Photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body text-center">
                    <%= image_tag photo.variant(resize_to_limit: [800, 600]), 
                          class: "img-fluid", 
                          alt: "Gallery photo" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <hr>

  <!-- Document Uploads & Lists -->
  <%= render "documents_section", vehicle: @vehicle %>

  <!-- Maintenance Section -->
  <%= render "maintenances_section", vehicle: @vehicle %>

  <!-- Photo Gallery Section -->
  <%= render "photo_gallery" %>

  <hr>

  <!-- Bottom Navigation -->
  <div class="d-flex justify-content-between">
    <div>
      <%= link_to "Back to Vehicles", vehicles_path, class: "btn btn-outline-secondary" %>
    </div>
    <div>
      <%= link_to "Edit Vehicle", edit_vehicle_path(@vehicle), class: "btn btn-warning ms-2" %>
      <%= link_to "Upload Photos", edit_vehicle_path(@vehicle, anchor: 'photo-upload-section'), class: "btn btn-info ms-2" %>
      <%= link_to "Report New Issue", report_issue_vehicle_path(@vehicle), class: "btn btn-danger ms-2" %>
    </div>
  </div>
</div>