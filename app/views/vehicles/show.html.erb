<!-- app/views/vehicles/show.html.erb -->
<div class="container-fluid py-4 px-4">
  <!-- Add this div to subscribe to vehicle status updates -->
  <div data-subscribe-to-vehicle="true" 
       data-vehicle-id="<%= @vehicle.id %>"
       style="display: none;"></div>

  <!-- Vehicle Header -->
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <%= link_to vehicles_path do %>
              <i class="bi bi-truck me-1"></i> Fleet
            <% end %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <%= @vehicle.make %> <%= @vehicle.model %>
          </li>
        </ol>
      </nav>
      <h1 class="mb-2">
        <%= @vehicle.make %> <%= @vehicle.model %>
        <% if @vehicle.year_of_manufacture.present? %>
          <span class="text-muted">(<%= @vehicle.year_of_manufacture %>)</span>
        <% end %>
      </h1>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-dark px-3 py-2 fs-6">
          <i class="bi bi-123 me-1"></i><%= @vehicle.license_plate %>
        </span>
        <span class="badge <%= service_owner_badge_class(@vehicle.service_owner) %> px-3 py-2 fs-6">
          <i class="bi bi-building me-1"></i><%= @vehicle.service_owner %>
        </span>
        <!-- Vehicle Status Badge -->
        <span class="badge <%= @vehicle.status_badge_class %> px-3 py-2 fs-6"
              data-vehicle-status-id="<%= @vehicle.id %>"
              id="vehicle-status-badge-<%= @vehicle.id %>">
          <i class="bi <%= @vehicle.status == 'active' ? 'bi-check-circle' : 'bi-exclamation-triangle' %> me-1"></i>
          <%= @vehicle.status_display %>
        </span>
        
        <!-- INSPECTION STATUS BADGE - ADD THIS -->
        <% if @vehicle.latest_inspection.present? %>
          <span class="badge <%= inspection_status_color(@vehicle.latest_inspection.status) %> px-3 py-2 fs-6"
                id="vehicle-inspection-status-<%= @vehicle.id %>"
                title="Latest Inspection: <%= inspection_status_display(@vehicle.latest_inspection.status) %>">
            <i class="bi <%= inspection_status_icon(@vehicle.latest_inspection.status) %> me-1"></i>
            <%= inspection_status_display(@vehicle.latest_inspection.status) %>
          </span>
        <% else %>
          <span class="badge bg-secondary px-3 py-2 fs-6">
            <i class="bi bi-question-circle me-1"></i>
            No Inspection
          </span>
        <% end %>
      </div>
    </div>
    
    <div class="d-flex gap-2">
      <!-- Full Details Button -->
      <button type="button" class="btn btn-outline-primary px-4 py-2 d-flex align-items-center gap-2"
              data-bs-toggle="modal" data-bs-target="#fullDetailsModal">
        <i class="bi bi-file-text"></i> Full Details
      </button>
      
      <!-- Actions Dropdown -->
      <div class="dropdown">
        <button class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2" 
                type="button" data-bs-toggle="dropdown">
          <i class="bi bi-gear"></i> Actions
          <i class="bi bi-chevron-down ms-1"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
          <li>
            <%= link_to edit_vehicle_path(@vehicle), class: "dropdown-item py-2" do %>
              <i class="bi bi-pencil me-2"></i> Edit Vehicle
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "dropdown-item py-2", 
                  data: { bs_toggle: "modal", bs_target: "#qrModal" } do %>
              <i class="bi bi-qr-code me-2"></i> View QR Code
            <% end %>
          </li>
          <li>
            <%= link_to trips_vehicle_path(@vehicle), class: "dropdown-item py-2" do %>
              <i class="bi bi-signpost me-2"></i> Trip History
            <% end %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= link_to report_issue_vehicle_path(@vehicle), class: "dropdown-item py-2 text-danger" do %>
              <i class="bi bi-exclamation-triangle me-2"></i> Report Issue
            <% end %>
          </li>
          <li>
            <button type="button" class="dropdown-item py-2 text-danger" 
                    data-bs-toggle="modal" 
                    data-bs-target="#deleteVehicleModal">
              <i class="bi bi-trash me-2"></i> Delete Vehicle
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- INSPECTION STATUS ALERT - ADD THIS -->
  <% if @vehicle.latest_inspection.present? %>
    <div class="alert alert-<%= inspection_status_color(@vehicle.latest_inspection.status) %> mb-4 d-flex align-items-center">
      <i class="bi <%= inspection_status_icon(@vehicle.latest_inspection.status) %> fs-3 me-3"></i>
      <div>
        <strong>Inspection Status:</strong> <%= inspection_status_display(@vehicle.latest_inspection.status) %>
        <% if @vehicle.latest_inspection.status == 'approved_for_repair' %>
          <span class="badge bg-success ms-2">✓ Ready for Mechanic</span>
        <% elsif @vehicle.latest_inspection.status == 'ready_for_pickup' %>
          <span class="badge bg-info ms-2">🚗 Ready for Pickup</span>
        <% end %>
        <br>
        <small class="text-muted">
          Last updated: <%= time_ago_in_words(@vehicle.latest_inspection.updated_at) %> ago
          • <%= link_to "View Inspection", vmcott_inspector_inspection_path(@vehicle.latest_inspection), class: "alert-link" %>
        </small>
      </div>
    </div>
  <% end %>

  <!-- Main Content Tabs -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card shadow-sm mb-4">
        <div class="card-body p-0">
          <ul class="nav nav-tabs nav-fill border-bottom" id="vehicleTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active py-3" id="overview-tab" data-bs-toggle="tab" 
                      data-bs-target="#overview" type="button">
                <i class="bi bi-info-circle me-2"></i>Overview
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link py-3" id="maintenance-tab" data-bs-toggle="tab" 
                      data-bs-target="#maintenance" type="button">
                <i class="bi bi-tools me-2"></i>Maintenance
                <% if @vehicle.overdue_maintenances.any? %>
                  <span class="badge bg-danger ms-1"><%= @vehicle.overdue_maintenances.count %></span>
                <% end %>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link py-3" id="trips-tab" data-bs-toggle="tab" 
                      data-bs-target="#trips" type="button">
                <i class="bi bi-signpost me-2"></i>Trips
                <% todays_trips = @vehicle.trips.where("DATE(start_time) = ?", Date.today) %>
                <% if todays_trips.any? %>
                  <span class="badge bg-primary ms-1"><%= todays_trips.count %></span>
                <% end %>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link py-3" id="documents-tab" data-bs-toggle="tab" 
                      data-bs-target="#documents" type="button">
                <i class="bi bi-folder me-2"></i>Documents
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link py-3" id="gallery-tab" data-bs-toggle="tab" 
                      data-bs-target="#gallery" type="button">
                <i class="bi bi-images me-2"></i>Gallery
                <% if @vehicle.gallery_photos.attached? %>
                  <span class="badge bg-info ms-1"><%= @vehicle.gallery_photos.count %></span>
                <% end %>
              </button>
            </li>
          </ul>
          
          <div class="tab-content p-4" id="vehicleTabContent">
            <!-- OVERVIEW TAB -->
            <div class="tab-pane fade show active" id="overview" role="tabpanel">
              <div class="row">
                <!-- Vehicle Image -->
                <div class="col-md-5 mb-4">
                  <div class="card border-0 shadow-sm">
                    <%= vehicle_image(@vehicle, variant: :medium, 
                          class: "img-fluid rounded-top",
                          style: "height: 300px; object-fit: cover;") %>
                    <div class="card-body text-center">
                      <div class="d-flex justify-content-center gap-2">
                        <%= link_to "Upload Photos", edit_vehicle_path(@vehicle), 
                              class: "btn btn-sm btn-outline-primary" %>
                        <%= link_to "Add Photo", "#", 
                              class: "btn btn-sm btn-outline-success",
                              data: { bs_toggle: "modal", bs_target: "#photoUploadModal" } %>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Vehicle Details -->
                <div class="col-md-7">
                  <div class="row g-3">
                    <!-- Basic Info -->
                    <div class="col-12">
                      <h4 class="mb-3">Vehicle Information</h4>
                      <div class="row g-3">
                        <div class="col-md-6">
                          <div class="card h-100 border">
                            <div class="card-body">
                              <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-car-front me-1"></i>Vehicle Type
                              </h6>
                              <p class="card-text fs-5 fw-medium"><%= @vehicle.vehicle_type %></p>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="card h-100 border">
                            <div class="card-body">
                              <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-palette me-1"></i>Color
                              </h6>
                              <p class="card-text fs-5 fw-medium"><%= @vehicle.color %></p>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="card h-100 border">
                            <div class="card-body">
                              <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-fuel-pump me-1"></i>Fuel Type
                              </h6>
                              <p class="card-text fs-5 fw-medium"><%= @vehicle.fuel_type %></p>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="card h-100 border">
                            <div class="card-body">
                              <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-gear me-1"></i>Transmission
                              </h6>
                              <p class="card-text fs-5 fw-medium"><%= @vehicle.transmission %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Identification -->
                    <div class="col-12">
                      <h4 class="mb-3">Identification</h4>
                      <div class="table-responsive">
                        <table class="table table-bordered">
                          <tr>
                            <th width="40%">VIN/Registration</th>
                            <td><%= @vehicle.registration_number %></td>
                          </tr>
                          <tr>
                            <th>Chassis Number</th>
                            <td><%= @vehicle.chassis_number %></td>
                          </tr>
                          <tr>
                            <th>Engine Number</th>
                            <td><%= @vehicle.engine_number %></td>
                          </tr>
                          <tr>
                            <th>Serial Number</th>
                            <td><%= @vehicle.serial_number %></td>
                          </tr>
                        </table>
                      </div>
                    </div>
                    
                    <!-- Driver Assignment -->
                    <% if @vehicle.driver %>
                      <div class="col-12">
                        <h4 class="mb-3">Current Driver</h4>
                        <div class="card border-success">
                          <div class="card-body">
                            <div class="d-flex align-items-center">
                              <div class="flex-shrink-0">
                                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                  <i class="bi bi-person fs-2 text-success"></i>
                                </div>
                              </div>
                              <div class="flex-grow-1 ms-3">
                                <h5 class="mb-1"><%= @vehicle.driver.name %></h5>
                                <p class="mb-1 text-muted">
                                  <i class="bi bi-telephone me-1"></i><%= @vehicle.driver.contact_number %>
                                </p>
                                <p class="mb-0 text-muted">
                                  <i class="bi bi-telephone me-1"></i><%= @vehicle.driver.phone || @vehicle.driver.contact_number %>
                                </p>
                              </div>
                              <%= link_to driver_path(@vehicle.driver), 
                                    class: "btn btn-outline-success" do %>
                                <i class="bi bi-person-lines-fill me-1"></i> View Profile
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- MAINTENANCE TAB -->
            <div class="tab-pane fade" id="maintenance" role="tabpanel">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Maintenance History</h4>
                <%= link_to "Schedule Maintenance", new_vehicle_maintenance_path(@vehicle), 
                      class: "btn btn-primary" %>
              </div>
              
              <% if @vehicle.maintenances.any? %>
                <div class="row">
                  <!-- Maintenance Stats -->
                  <div class="col-md-4 mb-4">
                    <div class="card border-0 bg-primary bg-opacity-10">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                          <div>
                            <h6 class="text-muted mb-1">Total Services</h6>
                            <h2 class="mb-0"><%= @vehicle.maintenances.count %></h2>
                          </div>
                          <i class="bi bi-tools fs-1 text-primary"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-4 mb-4">
                    <div class="card border-0 bg-warning bg-opacity-10">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                          <div>
                            <h6 class="text-muted mb-1">Pending</h6>
                            <h2 class="mb-0"><%= @vehicle.maintenances.pending.count %></h2>
                          </div>
                          <i class="bi bi-clock-history fs-1 text-warning"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-4 mb-4">
                    <div class="card border-0 bg-danger bg-opacity-10">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                          <div>
                            <h6 class="text-muted mb-1">Overdue</h6>
                            <h2 class="mb-0"><%= @vehicle.overdue_maintenances.count %></h2>
                          </div>
                          <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Maintenance Timeline -->
                <h5 class="mb-3">Recent Services</h5>
                <div class="timeline">
                  <% @vehicle.maintenances.order(date: :desc).limit(10).each do |maintenance| %>
                    <div class="timeline-item <%= maintenance.completed? ? 'completed' : 'pending' %>">
                      <div class="timeline-marker"></div>
                      <div class="timeline-content">
                        <div class="d-flex justify-content-between">
                          <h6 class="mb-1"><%= maintenance.service_type %></h6>
                          <span class="badge <%= maintenance.completed? ? 'bg-success' : 'bg-warning' %>">
                            <%= maintenance.status %>
                          </span>
                        </div>
                        <p class="text-muted small mb-1">
                          <i class="bi bi-calendar me-1"></i><%= format_date(maintenance.date) %>
                          <% if maintenance.cost.present? %>
                            • <i class="bi bi-currency-dollar me-1"></i><%= number_to_currency(maintenance.cost) %>
                          <% end %>
                        </p>
                        <% if maintenance.notes.present? %>
                          <p class="mb-0"><%= maintenance.notes.truncate(100) %></p>
                        <% end %>
                        <%= link_to "View Details", maintenance_path(maintenance), 
                              class: "btn btn-sm btn-outline-primary mt-2" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <i class="bi bi-tools text-muted" style="font-size: 3rem;"></i>
                  <h4 class="text-muted mt-3">No maintenance records</h4>
                  <p class="text-muted">Schedule the first service for this vehicle</p>
                  <%= link_to "Schedule Maintenance", new_vehicle_maintenance_path(@vehicle), 
                        class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>
            
            <!-- TRIPS TAB - FIXED with coming soon link -->
            <div class="tab-pane fade" id="trips" role="tabpanel">
              <div class="trips-section">
                <% trips = @vehicle.trips.order(start_time: :desc).limit(5) %>
                
                <% if trips.any? %>
                  <div class="table-responsive">
                    <table class="table table-sm">
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>Driver</th>
                          <th>Distance</th>
                          <th>Duration</th>
                          <th>Status</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% trips.each do |trip| %>
                          <tr>
                            <td><%= trip.start_time&.strftime("%b %d, %Y") %></td>
                            <td><%= trip.driver&.name || "Unassigned" %></td>
                            <td><%= number_with_precision(trip.distance_km, precision: 1) %> km</td>
                            <td><%= trip.formatted_duration %></td>
                            <td>
                              <span class="badge bg-<%= trip.status_class %>">
                                <%= trip.status %>
                              </span>
                            </td>
                            <td>
                              <%= link_to "View", coming_soon_path(feature: "Trip Details"), 
                                    class: "btn btn-xs btn-outline-primary" %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                  
                  <div class="text-center mt-3">
                    <small class="text-muted">
                      Showing latest 5 trips • 
                      <%= link_to "View all #{@vehicle.trips.count} trips", coming_soon_path(feature: "All Trips") %>
                    </small>
                  </div>
                <% else %>
                  <div class="text-center py-4">
                    <i class="bi bi-signpost text-muted" style="font-size: 2rem;"></i>
                    <p class="text-muted mt-2">No trips recorded for this vehicle</p>
                    <%= link_to "Record First Trip", coming_soon_path(feature: "New Trip"), 
                          class: "btn btn-primary btn-sm" %>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- DOCUMENTS TAB -->
            <div class="tab-pane fade" id="documents" role="tabpanel">
              <% if @vehicle.vehicle_documents.any? %>
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Document Type</th>
                        <th>File</th>
                        <th>Expires On</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @vehicle.vehicle_documents.each do |doc| %>
                        <tr>
                          <td><%= doc.doc_type %></td>
                          <td>
                            <% if doc.file.attached? %>
                              <%= link_to doc.file.filename, rails_blob_path(doc.file, disposition: 'attachment') %>
                            <% else %>
                              <span class="text-muted">No file attached</span>
                            <% end %>
                          </td>
                          <td>
                            <% if doc.expires_on %>
                              <% if doc.expires_on < Date.today %>
                                <span class="badge bg-danger">Expired <%= doc.expires_on.strftime("%b %d, %Y") %></span>
                              <% elsif doc.expires_on < Date.today + 30.days %>
                                <span class="badge bg-warning">Expires <%= doc.expires_on.strftime("%b %d, %Y") %></span>
                              <% else %>
                                <span class="badge bg-success"><%= doc.expires_on.strftime("%b %d, %Y") %></span>
                              <% end %>
                            <% else %>
                              <span class="text-muted">No expiry</span>
                            <% end %>
                          </td>
                          <td>
                            <% if doc.file.attached? %>
                              <%= link_to "Download", rails_blob_path(doc.file, disposition: 'attachment'), 
                                    class: "btn btn-sm btn-outline-primary" %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <i class="bi bi-folder text-muted" style="font-size: 3rem;"></i>
                  <h4 class="text-muted mt-3">No documents uploaded</h4>
                  <p class="text-muted">Upload vehicle documents like insurance, registration, etc.</p>
                  <%= link_to "Upload Documents", edit_vehicle_path(@vehicle), 
                        class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>
            
            <!-- GALLERY TAB -->
            <div class="tab-pane fade" id="gallery" role="tabpanel">
              <% if @vehicle.gallery_photos.attached? %>
                <div class="row">
                  <% @vehicle.gallery_photos.each do |photo| %>
                    <div class="col-md-4 mb-3">
                      <div class="card">
                        <%= image_tag photo.variant(resize_to_limit: [300, 200]), 
                              class: "card-img-top", 
                              style: "height: 200px; object-fit: cover;" %>
                        <div class="card-body text-center">
                          <%= link_to "Delete", delete_photo_vehicle_path(@vehicle, photo_id: photo.id),
                                method: :get,
                                data: { confirm: "Delete this photo?" },
                                class: "btn btn-sm btn-danger" %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <i class="bi bi-images text-muted" style="font-size: 3rem;"></i>
                  <h4 class="text-muted mt-3">No gallery photos</h4>
                  <p class="text-muted">Upload photos of the vehicle from different angles</p>
                  <%= link_to "Upload Photos", edit_vehicle_path(@vehicle), 
                        class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Sidebar -->
    <div class="col-lg-4">
      <!-- Vehicle Status Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Vehicle Status</h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <!-- Latest Inspection Summary - ADD THIS -->
            <% if @vehicle.latest_inspection.present? %>
              <div class="col-12">
                <div class="border rounded p-3 mb-3">
                  <h6 class="text-muted mb-2">Latest Inspection</h6>
                  <div class="d-flex align-items-start">
                    <div class="bg-<%= inspection_status_color(@vehicle.latest_inspection.status) %> bg-opacity-10 rounded-circle p-2 me-3">
                      <i class="bi <%= inspection_status_icon(@vehicle.latest_inspection.status) %> text-<%= inspection_status_color(@vehicle.latest_inspection.status) %>"></i>
                    </div>
                    <div>
                      <div class="fw-medium"><%= inspection_status_display(@vehicle.latest_inspection.status) %></div>
                      <div class="small text-muted">
                        <i class="bi bi-calendar me-1"></i><%= @vehicle.latest_inspection.updated_at.strftime("%b %d, %Y") %>
                      </div>
                      <% if @vehicle.latest_inspection.status == 'approved_for_repair' %>
                        <span class="badge bg-success mt-1">Ready for Mechanic</span>
                      <% elsif @vehicle.latest_inspection.status == 'ready_for_pickup' %>
                        <span class="badge bg-info mt-1">Ready for Pickup</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="mt-2">
                    <%= link_to "View Inspection", vmcott_inspector_inspection_path(@vehicle.latest_inspection), 
                          class: "btn btn-sm btn-outline-primary w-100" %>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Mileage -->
            <div class="col-12">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Current Mileage</span>
                <span class="fw-bold"><%= number_with_delimiter(@vehicle.mileage) %> km</span>
              </div>
              <% if @next_service_mileage && @mileage_left %>
                <div class="progress mb-3" style="height: 8px;">
                  <% progress = [(@vehicle.mileage.to_f / @next_service_mileage.to_f * 100).to_i, 100].min %>
                  <div class="progress-bar <%= @mileage_left > 1000 ? 'bg-success' : 'bg-warning' %>" 
                       style="width: <%= progress %>%"></div>
                </div>
                <div class="d-flex justify-content-between small">
                  <span>Next Service: <%= @next_service_mileage %> km</span>
                  <span class="<%= @mileage_left > 0 ? 'text-success' : 'text-danger' %>">
                    <%= @mileage_left.abs %> km <%= @mileage_left > 0 ? 'left' : 'overdue' %>
                  </span>
                </div>
              <% end %>
            </div>
            
            <!-- Fuel Level -->
            <% if @vehicle.fuel_level.present? %>
              <div class="col-12">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Fuel Level</span>
                  <span class="fw-bold <%= @vehicle.fuel_level < 20 ? 'text-danger' : 'text-success' %>">
                    <%= @vehicle.fuel_level %>%
                  </span>
                </div>
                <div class="progress mb-3" style="height: 8px;">
                  <div class="progress-bar <%= @vehicle.fuel_level < 20 ? 'bg-danger' : 'bg-success' %>" 
                       style="width: <%= @vehicle.fuel_level %>%"></div>
                </div>
                <% if @vehicle.fuel_level < 20 %>
                  <div class="alert alert-warning small mb-0 py-2">
                    <i class="bi bi-exclamation-triangle me-1"></i> Low fuel - needs refueling
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <!-- Last Service -->
            <% last_service = @vehicle.maintenances.completed.order(date: :desc).first %>
            <% if last_service %>
              <div class="col-12">
                <div class="border rounded p-3">
                  <h6 class="text-muted mb-2">Last Service</h6>
                  <div class="d-flex align-items-start">
                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                      <i class="bi bi-check-circle text-success"></i>
                    </div>
                    <div>
                      <div class="fw-medium"><%= last_service.service_type %></div>
                      <div class="small text-muted">
                        <i class="bi bi-calendar me-1"></i><%= last_service.date.strftime("%b %d, %Y") %>
                      </div>
                      <% if last_service.cost.present? %>
                        <div class="small text-muted">
                          <i class="bi bi-currency-dollar me-1"></i><%= number_to_currency(last_service.cost) %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
            
            <!-- Next Due -->
            <% next_due = @vehicle.maintenances.pending.order(date: :asc).first %>
            <% if next_due %>
              <div class="col-12">
                <div class="border rounded p-3 <%= next_due.overdue? ? 'border-danger' : 'border-warning' %>">
                  <h6 class="text-muted mb-2">Next Due Service</h6>
                  <div class="d-flex align-items-start">
                    <div class="<%= next_due.overdue? ? 'bg-danger bg-opacity-10' : 'bg-warning bg-opacity-10' %> 
                                rounded-circle p-2 me-3">
                      <i class="bi <%= next_due.overdue? ? 'bi-exclamation-triangle text-danger' : 'bi-clock text-warning' %>"></i>
                    </div>
                    <div>
                      <div class="fw-medium <%= next_due.overdue? ? 'text-danger' : '' %>">
                        <%= next_due.service_type %>
                      </div>
                      <div class="small <%= next_due.overdue? ? 'text-danger' : 'text-muted' %>">
                        <i class="bi bi-calendar me-1"></i>
                        <%= next_due.date.strftime("%b %d, %Y") %>
                        <% if next_due.overdue? %>
                          <span class="badge bg-danger ms-2">OVERDUE</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Quick Actions -->
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <%= link_to report_issue_vehicle_path(@vehicle), 
                  class: "btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center gap-2" do %>
              <i class="bi bi-exclamation-triangle"></i>
              Report Issue
            <% end %>
            
            <% if @vehicle.driver %>
              <button type="button" class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-2"
                      data-bs-toggle="modal" data-bs-target="#assignDriverModal">
                <i class="bi bi-person-dash"></i>
                Change Driver
              </button>
            <% else %>
              <button type="button" class="btn btn-outline-success btn-lg d-flex align-items-center justify-content-center gap-2"
                      data-bs-toggle="modal" data-bs-target="#assignDriverModal">
                <i class="bi bi-person-plus"></i>
                Assign Driver
              </button>
            <% end %>
            
            <%= link_to trips_vehicle_path(@vehicle),
                  class: "btn btn-outline-primary btn-lg d-flex align-items-center justify-content-center gap-2" do %>
              <i class="bi bi-signpost"></i>
              Trip History
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Full Details Modal -->
<div class="modal fade" id="fullDetailsModal" tabindex="-1" aria-labelledby="fullDetailsModalLabel">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="fullDetailsModalLabel">
          <i class="bi bi-car-front me-2"></i>Full Vehicle Details
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <!-- Vehicle Header in Modal -->
          <div class="row mb-4">
            <div class="col-md-3">
              <%= vehicle_image(@vehicle, variant: :medium, 
                    class: "img-fluid rounded shadow", 
                    style: "height: 200px; object-fit: cover;") %>
            </div>
            <div class="col-md-9">
              <h4 class="mb-2"><%= @vehicle.make %> <%= @vehicle.model %></h4>
              <p class="text-muted mb-3">
                <%= @vehicle.year_of_manufacture %> • 
                <%= @vehicle.vehicle_type %> • 
                <%= @vehicle.color %>
              </p>
              <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-dark px-3 py-2">
                  <i class="bi bi-123 me-1"></i><%= @vehicle.license_plate %>
                </span>
                <span class="badge <%= service_owner_badge_class(@vehicle.service_owner) %> px-3 py-2">
                  <%= @vehicle.service_owner %>
                </span>
                <span class="badge <%= @vehicle.status_badge_class %> px-3 py-2">
                  <%= @vehicle.status_display %>
                </span>
                <!-- Add inspection status in modal -->
                <% if @vehicle.latest_inspection.present? %>
                  <span class="badge <%= inspection_status_color(@vehicle.latest_inspection.status) %> px-3 py-2">
                    <i class="bi <%= inspection_status_icon(@vehicle.latest_inspection.status) %> me-1"></i>
                    <%= inspection_status_display(@vehicle.latest_inspection.status) %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Detailed Information Tabs -->
          <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#technical-tab">
                <i class="bi bi-gear me-1"></i>Technical
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#specifications-tab">
                <i class="bi bi-speedometer2 me-1"></i>Specifications
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ownership-tab">
                <i class="bi bi-building me-1"></i>Ownership
              </button>
            </li>
          </ul>

          <div class="tab-content">
            <!-- Technical Tab -->
            <div class="tab-pane fade show active" id="technical-tab">
              <div class="row">
                <div class="col-md-6">
                  <table class="table table-sm">
                    <tr><th>Engine Number</th><td><%= @vehicle.engine_number %></td></tr>
                    <tr><th>Chassis Number</th><td><%= @vehicle.chassis_number %></td></tr>
                    <tr><th>Serial Number</th><td><%= @vehicle.serial_number %></td></tr>
                    <tr><th>VIN</th><td><%= @vehicle.registration_number %></td></tr>
                  </table>
                </div>
                <div class="col-md-6">
                  <table class="table table-sm">
                    <tr><th>Fuel Type</th><td><%= @vehicle.fuel_type %></td></tr>
                    <tr><th>Transmission</th><td><%= @vehicle.transmission %></td></tr>
                    <tr><th>Body Style</th><td><%= @vehicle.body_style %></td></tr>
                    <tr><th>Modifications</th><td><%= @vehicle.modifications %></td></tr>
                  </table>
                </div>
              </div>
            </div>

            <!-- Specifications Tab -->
            <div class="tab-pane fade" id="specifications-tab">
              <div class="row">
                <div class="col-md-4">
                  <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                      <i class="bi bi-speedometer2 fs-1 text-primary mb-2"></i>
                      <h5>Mileage</h5>
                      <h2><%= number_with_delimiter(@vehicle.mileage) %></h2>
                      <small class="text-muted">kilometers</small>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                      <i class="bi bi-calendar-check fs-1 text-success mb-2"></i>
                      <h5>Year</h5>
                      <h2><%= @vehicle.year_of_manufacture %></h2>
                      <small class="text-muted">manufactured</small>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                      <i class="bi bi-palette fs-1 text-warning mb-2"></i>
                      <h5>Color</h5>
                      <h2><%= @vehicle.color %></h2>
                      <small class="text-muted">exterior</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Ownership Tab -->
            <div class="tab-pane fade" id="ownership-tab">
              <div class="row">
                <div class="col-md-12">
                  <div class="card">
                    <div class="card-header">Service Information</div>
                    <div class="card-body">
                      <p><strong>Service Owner:</strong> <%= @vehicle.service_owner %></p>
                      <p><strong>License Plate:</strong> <%= @vehicle.license_plate %></p>
                      <p><strong>Registration Number:</strong> <%= @vehicle.registration_number %></p>
                      <% if @vehicle.driver %>
                        <p><strong>Current Driver:</strong> <%= @vehicle.driver.name %></p>
                        <p><strong>Driver Contact:</strong> <%= @vehicle.driver.contact_number %></p>
                      <% else %>
                        <p><strong>Current Driver:</strong> <span class="text-muted">Unassigned</span></p>
                      <% end %>
                      <!-- Add inspection info in ownership tab -->
                      <% if @vehicle.latest_inspection.present? %>
                        <p><strong>Latest Inspection:</strong> 
                          <span class="badge <%= inspection_status_color(@vehicle.latest_inspection.status) %>">
                            <%= inspection_status_display(@vehicle.latest_inspection.status) %>
                          </span>
                        </p>
                        <p><strong>Inspection Date:</strong> <%= @vehicle.latest_inspection.updated_at.strftime("%B %d, %Y") %></p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <%= link_to "Edit Details", edit_vehicle_path(@vehicle), class: "btn btn-primary" %>
        <button type="button" class="btn btn-outline-success" onclick="printDetails()">
          <i class="bi bi-printer me-1"></i> Print
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Assign Driver Modal -->
<div class="modal fade" id="assignDriverModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <!-- Modal Header -->
      <div class="modal-header bg-success text-white">
        <div class="d-flex align-items-center">
          <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
            <i class="bi bi-person-plus fs-5"></i>
          </div>
          <div>
            <h5 class="modal-title mb-0"><%= @vehicle.driver ? 'Change Driver' : 'Assign Driver' %></h5>
            <p class="mb-0 small opacity-75">Select a driver for this vehicle</p>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      
      <!-- Modal Body -->
      <div class="modal-body p-4">
        <!-- Vehicle Info Card -->
        <div class="card border-success border-opacity-25 mb-4">
          <div class="card-body p-3">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <%= vehicle_image(@vehicle, variant: :thumb, 
                      class: "rounded", 
                      style: "width: 60px; height: 60px; object-fit: cover;") %>
              </div>
              <div class="flex-grow-1 ms-3">
                <h6 class="mb-1"><%= @vehicle.make %> <%= @vehicle.model %></h6>
                <p class="text-muted small mb-0">
                  <i class="bi bi-123 me-1"></i><%= @vehicle.license_plate %>
                  <% if @vehicle.year_of_manufacture.present? %>
                    • <i class="bi bi-calendar me-1"></i><%= @vehicle.year_of_manufacture %>
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Driver Selection Form -->
        <%= form_with model: @vehicle, 
              url: vehicle_path(@vehicle), 
              method: :patch, 
              class: "driver-assignment-form" do |f| %>
          
          <div class="mb-4">
            <label class="form-label fw-semibold">
              <i class="bi bi-person-badge me-1"></i>Select Driver
            </label>
            
            <!-- Driver Select -->
            <%= f.select :driver_id, 
                  options_from_collection_for_select(Driver.all.order(:name), :id, :name, @vehicle.driver_id),
                  { include_blank: "Select a driver..." },
                  { class: "form-select", required: true } %>
            
            <div class="form-text mt-2">
              <%= Driver.all.count %> drivers available in the system
            </div>
          </div>
          
          <!-- Additional Info -->
          <div class="alert alert-info border-0 bg-info bg-opacity-10">
            <div class="d-flex">
              <i class="bi bi-info-circle me-2 fs-5"></i>
              <div>
                <p class="small mb-0">
                  <% if @vehicle.driver %>
                    Current driver will be replaced with the selected driver.
                  <% else %>
                    The selected driver will be assigned to this vehicle.
                  <% end %>
                </p>
              </div>
            </div>
          </div>
          
          <!-- Action Buttons -->
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
              <i class="bi bi-x-circle me-1"></i> Cancel
            </button>
            <%= f.button type: "submit", 
                  class: "btn btn-success d-flex align-items-center",
                  data: { controller: "form-submit", action: "click->form-submit#submit" } do %>
              <i class="bi bi-check-circle me-2"></i>
              <span><%= @vehicle.driver ? 'Change Driver' : 'Assign Driver' %></span>
              <span class="spinner-border spinner-border-sm ms-2 d-none" 
                    data-form-submit-target="spinner"></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Vehicle QR Code</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <% if @vehicle.qr_code_url %>
          <img src="<%= @vehicle.qr_code_url %>" alt="QR Code" class="img-fluid mb-3" style="max-width: 250px;">
        <% else %>
          <div class="alert alert-info">QR code not generated yet</div>
        <% end %>
        <p class="text-muted small mb-0">Scan to quickly access this vehicle's details</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Download QR</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Vehicle Confirmation Modal - FIXED VERSION -->
<div class="modal fade" id="deleteVehicleModal" tabindex="-1" aria-labelledby="deleteVehicleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <!-- Modal Header - Danger style -->
      <div class="modal-header bg-danger text-white">
        <div class="d-flex align-items-center">
          <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
            <i class="bi bi-exclamation-triangle fs-5"></i>
          </div>
          <div>
            <h5 class="modal-title mb-0" id="deleteVehicleModalLabel">Delete Vehicle</h5>
            <p class="mb-0 small opacity-75">This action cannot be undone</p>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <!-- Modal Body -->
      <div class="modal-body p-4">
        <!-- Vehicle Info Card -->
        <div class="card border-danger border-opacity-25 mb-4">
          <div class="card-body p-3">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <%= vehicle_image(@vehicle, variant: :thumb, 
                      class: "rounded", 
                      style: "width: 60px; height: 60px; object-fit: cover;") %>
              </div>
              <div class="flex-grow-1 ms-3">
                <h6 class="mb-1"><%= @vehicle.make %> <%= @vehicle.model %></h6>
                <p class="text-muted small mb-0">
                  <i class="bi bi-123 me-1"></i><%= @vehicle.license_plate %>
                  <% if @vehicle.year_of_manufacture.present? %>
                    • <i class="bi bi-calendar me-1"></i><%= @vehicle.year_of_manufacture %>
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Warning Messages -->
        <div class="alert alert-danger border-0 d-flex align-items-start mb-3">
          <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
          <div>
            <strong>Warning:</strong> This will permanently delete:
            <ul class="mb-0 mt-2">
              <li>The vehicle record</li>
              <li>All maintenance history (<%= @vehicle.maintenances.count %> records)</li>
              <li>All trip history (<%= @vehicle.trips.count %> records)</li>
              <li>All associated documents and photos</li>
            </ul>
          </div>
        </div>
        
        <!-- Additional Info -->
        <div class="bg-light p-3 rounded small text-muted">
          <i class="bi bi-info-circle me-1"></i>
          If you need to temporarily remove this vehicle from service, consider changing its status to "Inactive" instead.
        </div>
      </div>
      
      <!-- Modal Footer - FIXED VERSION with working delete button -->
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i> Cancel
        </button>
        
        <!-- For Rails 7+ with Turbo -->
        <%= button_to vehicle_path(@vehicle), 
              method: :delete,
              form: { 
                data: { 
                  turbo_confirm: "Are you absolutely sure you want to delete this vehicle? This action cannot be undone." 
                } 
              },
              class: "btn btn-danger d-flex align-items-center",
              data: { bs_dismiss: "modal" } do %>
          <i class="bi bi-trash me-2"></i>
          <span>Permanently Delete Vehicle</span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Photo Upload Modal -->
<div class="modal fade" id="photoUploadModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with model: @vehicle, url: vehicle_path(@vehicle), 
          method: :patch, local: true do |f| %>
        <div class="modal-header">
          <h5 class="modal-title">Upload Vehicle Photos</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Primary Photo</label>
            <%= f.file_field :primary_photo, class: "form-control" %>
