        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Upload Photos</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Custom Styles -->
<style>
.timeline {
  position: relative;
  padding-left: 2rem;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 11px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #dee2e6;
}

.timeline-item {
  position: relative;
  margin-bottom: 1.5rem;
}

.timeline-marker {
  position: absolute;
  left: -2rem;
  top: 0.5rem;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 0 0 0 3px #dee2e6;
  z-index: 1;
}

.timeline-item.completed .timeline-marker {
  background: #198754;
  box-shadow: 0 0 0 3px #198754;
}

.timeline-item.pending .timeline-marker {
  background: #ffc107;
  box-shadow: 0 0 0 3px #ffc107;
}

.timeline-content {
  background: #fff;
  padding: 1rem;
  border-radius: 0.5rem;
  border: 1px solid #e9ecef;
  transition: all 0.2s;
}

.timeline-content:hover {
  border-color: #0d6efd;
  box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
}

.nav-tabs .nav-link {
  border: none;
  color: #6c757d;
  font-weight: 500;
}

.nav-tabs .nav-link.active {
  color: #0d6efd;
  border-bottom: 3px solid #0d6efd;
}

.card.border .card-body {
  padding: 1rem;
}

.progress {
  border-radius: 1rem;
  overflow: hidden;
}

/* Modal custom styles */
#assignDriverModal .modal-content,
#deleteVehicleModal .modal-content {
  border-radius: 0.75rem;
  overflow: hidden;
}

#assignDriverModal .modal-header,
#deleteVehicleModal .modal-header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

@media print {
  body * {
    visibility: hidden;
  }
  #fullDetailsModal, #fullDetailsModal * {
    visibility: visible;
  }
  #fullDetailsModal {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }
  .modal-footer, .nav-tabs {
    display: none !important;
  }
}
</style>

<script>
function printDetails() {
  var printContent = document.getElementById('fullDetailsModal').innerHTML;
  var originalContent = document.body.innerHTML;
  
  document.body.innerHTML = printContent;
  window.print();
  document.body.innerHTML = originalContent;
  location.reload();
}
</script>