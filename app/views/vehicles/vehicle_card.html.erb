<%# app/views/vehicles/_vehicle_card.html.erb %>
<% 
  # Create permission service instance
  permission = PermissionService.new(current_user, vehicle)
  
  # Determine badge styling
  badge_class, badge_text = case vehicle.respond_to?(:badge_type) ? vehicle.badge_type.to_s.downcase : ''
    when 'police' then ['badge-police', 'POLICE']
    when 'ptsc'   then ['badge-ptsc', 'PTSC']
    when 'fire'   then ['badge-fire', 'FIRE']
    else ['badge-default', vehicle.service_owner.presence&.upcase || 'VEHICLE']
  end
  
  # Determine utilization class
  def utilization_class(vehicle)
    return 'bg-secondary' unless vehicle.respond_to?(:utilization_percent)
    
    util = vehicle.utilization_percent.to_f
    case
    when util >= 70 then 'bg-success'
    when util >= 30 then 'bg-warning'
    else 'bg-danger'
    end
  end
  
  # Helper for vehicle image
  def vehicle_image(vehicle, variant: :card)
    if vehicle.primary_photo.attached?
      # Use appropriate variant based on context
      case variant
      when :card
        variant = { resize: "300x200" }
      when :thumb
        variant = { resize: "100x100" }
      else
        variant = { resize: "300x200" }
      end
      url_for(vehicle.primary_photo.variant(variant))
    else
      # Fallback image based on service owner
      case vehicle.service_owner.to_s.downcase
      when 'police'
        "https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&h=200&q=80"
      when 'ptsc'
        "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&h=200&q=80"
      when 'fire service', 'fire'
        "https://images.unsplash.com/photo-1551524165-6b6e5a6166f3?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&h=200&q=80"
      when 'ambulance', 'medical'
        "https://images.unsplash.com/photo-1582719508461-905c673771fd?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&h=200&q=80"
      else
        "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&h=200&q=80"
      end
    end
  end
%>

<div class="vehicle-card bg-white rounded-xl shadow-md overflow-hidden relative hover-lift transition-all duration-300 border border-gray-200">
  <!-- VEHICLE BADGE (TOP LEFT) -->
  <div class="absolute top-2 left-2 z-20">
    <span class="<%= badge_class %> px-2 py-1 rounded-lg text-xs font-bold shadow-sm">
      <%= badge_text %>
    </span>
  </div>

  <!-- UTILIZATION RIBBON (TOP LEFT, BELOW BADGE) -->
  <% if vehicle.respond_to?(:utilization_percent) %>
    <div class="absolute top-10 left-2 z-10">
      <span class="utilization-ribbon <%= utilization_class(vehicle) %> text-white px-2 py-1 rounded text-xs font-medium">
        <%= vehicle.utilization_percent.to_i %>% utilized
      </span>
    </div>
  <% end %>

  <!-- ALERT CHIP (TOP RIGHT, OPTIONAL) -->
  <% if vehicle.respond_to?(:overdue?) && vehicle.overdue? %>
    <div class="absolute top-2 right-2 z-10">
      <span class="alert-chip bg-danger text-white px-2 py-1 rounded text-xs font-bold">
        <i class="bi bi-exclamation-triangle me-1"></i>OVERDUE
      </span>
    </div>
  <% elsif vehicle.respond_to?(:needs_maintenance?) && vehicle.needs_maintenance? %>
    <div class="absolute top-2 right-2 z-10">
      <span class="alert-chip bg-warning text-dark px-2 py-1 rounded text-xs font-bold">
        <i class="bi bi-tools me-1"></i>MAINTENANCE
      </span>
    </div>
  <% end %>

  <!-- VEHICLE IMAGE -->
  <div class="vehicle-image-container position-relative" style="height: 180px;">
    <img
      src="<%= vehicle_image(vehicle, variant: :card) %>"
      alt="<%= vehicle.name %>"
      class="w-100 h-100 object-fit-cover"
      loading="lazy"
    >
    <!-- HOVER OVERLAY WITH ACTIONS -->
    <div class="hover-overlay position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center opacity-0 transition-opacity">
      <div class="btn-group btn-group-sm">
        <%# Quick actions on hover %>
        <%= link_to vehicle_path(vehicle), class: "btn btn-light rounded-start", title: "View Details" do %>
          <i class="bi bi-eye"></i>
        <% end %>
        
        <% if permission.can?(:edit_vehicle) %>
          <%= link_to edit_vehicle_path(vehicle), class: "btn btn-light", title: "Edit Vehicle" do %>
            <i class="bi bi-pencil"></i>
          <% end %>
        <% end %>
        
        <% if permission.can?(:report_issue) %>
          <%= link_to report_issue_vehicle_path(vehicle), class: "btn btn-light", title: "Report Issue" do %>
            <i class="bi bi-exclamation-triangle"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- INFO SECTION -->
  <div class="p-3">
    <!-- VEHICLE NAME & REGISTRATION -->
    <div class="d-flex justify-content-between align-items-start mb-2">
      <div>
        <h6 class="fw-bold text-dark mb-0">
          <%= link_to vehicle.display_name, vehicle_path(vehicle), class: "text-decoration-none text-dark hover-text-primary" %>
        </h6>
        <small class="text-muted d-block">
          <%= vehicle.registration_number.presence || "No Plate" %>
          <% if vehicle.agency && current_user.vmcott? %>
            <span class="ms-1 badge bg-secondary bg-opacity-25 text-dark"><%= vehicle.agency.code %></span>
          <% end %>
        </small>
      </div>
      
      <!-- STATUS INDICATOR -->
      <% if vehicle.respond_to?(:status) && vehicle.status.present? %>
        <span class="badge <%= vehicle.status.downcase == 'active' ? 'bg-success' : 'bg-secondary' %>">
          <%= vehicle.status.titleize %>
        </span>
      <% end %>
    </div>

    <!-- DETAILS ROW -->
    <div class="text-muted small d-flex justify-content-between mb-2">
      <div>
        <i class="bi bi-gear me-1"></i>
        <%= vehicle.make.presence || "Unknown" %> <%= vehicle.model.presence || "" %>
      </div>
      <div>
        <i class="bi bi-person-circle me-1"></i>
        <%= vehicle.driver&.name.presence || "No Driver" %>
      </div>
    </div>

    <!-- STATS ROW -->
    <div class="d-flex justify-content-between align-items-center small mb-3">
      <div class="text-center">
        <div class="fw-bold text-dark"><%= vehicle.trips_count.to_i %></div>
        <div class="text-muted">Trips</div>
      </div>
      <% if vehicle.respond_to?(:mileage) %>
      <div class="text-center">
        <div class="fw-bold text-dark"><%= number_with_delimiter(vehicle.mileage.to_i) %></div>
        <div class="text-muted">Miles</div>
      </div>
      <% end %>
      <div class="text-center">
        <div class="fw-bold text-dark"><%= vehicle.service_owner %></div>
        <div class="text-muted">Owner</div>
      </div>
    </div>

    <!-- ACTION BUTTONS (ALWAYS VISIBLE) -->
    <div class="d-flex justify-content-between gap-1">
      <!-- VIEW BUTTON -->
      <%= link_to vehicle_path(vehicle), class: "btn btn-sm btn-outline-primary flex-grow-1" do %>
        <i class="bi bi-eye me-1"></i>View
      <% end %>
      
      <!-- EDIT BUTTON (Conditional) -->
      <% if permission.can?(:edit_vehicle) %>
        <%= link_to edit_vehicle_path(vehicle), class: "btn btn-sm btn-outline-secondary" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
      <% end %>
      
      <!-- DELETE BUTTON (Conditional) -->
      <% if permission.can?(:delete_vehicle) %>
        <%= button_to vehicle_path(vehicle), 
            method: :get, 
            class: "btn btn-sm btn-outline-danger",
            form: { 
              "data-turbo" => "false",
              "data-confirm" => "Are you sure you want to delete this vehicle?",
              class: "d-inline"
            },
            title: "Delete Vehicle" do %>
          <i class="bi bi-trash"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<style>
/* Custom CSS for the vehicle card */
.vehicle-card {
  transition: all 0.3s ease;
  border: 1px solid #e9ecef;
}

.vehicle-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
  border-color: #dee2e6;
}

.vehicle-card:hover .hover-overlay {
  opacity: 1;
}

.hover-overlay {
  transition: opacity 0.3s ease;
}

.object-fit-cover {
  object-fit: cover;
}

.hover-text-primary:hover {
  color: #0d6efd !important;
}

/* Badge styles */
.badge-police {
  background: linear-gradient(135deg, #1e3a8a, #3b82f6);
  color: white;
}

.badge-ptsc {
  background: linear-gradient(135deg, #1a73e8, #0d47a1);
  color: white;
}

.badge-fire {
  background: linear-gradient(135deg, #dc2626, #f97316);
  color: white;
}

.badge-default {
  background: linear-gradient(135deg, #6b7280, #9ca3af);
  color: white;
}

/* Utilization ribbon */
.utilization-ribbon {
  font-size: 0.7rem;
  letter-spacing: 0.5px;
}

/* Responsive adjustments */
@media (max-width: 576px) {
  .vehicle-card {
    margin-bottom: 1rem;
  }
  
  .vehicle-image-container {
    height: 150px !important;
  }
  
  .hover-overlay .btn-group {
    transform: scale(0.9);
  }
}
</style>