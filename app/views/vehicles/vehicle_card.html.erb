<div class="vehicle-card bg-white rounded-xl shadow-md overflow-hidden relative">

  <!-- VEHICLE BADGE (TOP LEFT) -->
  <div class="absolute top-2 left-2 z-20">
    <% badge_class, badge_text = case vehicle.respond_to?(:badge_type) ? vehicle.badge_type.to_s.downcase : ''
      when 'police' then ['badge-police', 'POLICE']
      when 'ptsc'   then ['badge-ptsc', 'PTSC']
      when 'fire'   then ['badge-fire', 'FIRE']
      else ['badge-default', 'UNKNOWN'] # default if badge_type is missing or unknown
    end %>
    <span class="<%= badge_class %> px-2 py-1 rounded-lg text-sm font-bold">
      <%= badge_text %>
    </span>
  </div>

  <!-- UTILIZATION RIBBON (TOP LEFT, BELOW BADGE) -->
  <div class="absolute top-12 left-2 z-10">
    <span class="utilization-ribbon <%= utilization_class(vehicle) %>">
      <%= vehicle.utilization_percent %>% utilized
    </span>
  </div>

  <!-- ALERT CHIP (TOP RIGHT, OPTIONAL) -->
  <% if vehicle.respond_to?(:overdue?) && vehicle.overdue? %>
    <div class="absolute top-2 right-2 z-10">
      <span class="alert-chip">
        OVERDUE
      </span>
    </div>
  <% end %>

  <!-- VEHICLE IMAGE -->
  <img
    src="<%= vehicle_image(vehicle, variant: image_variant_for_context(:card)) %>"
    alt="<%= vehicle.name %>"
    class="vehicle-image"
  >

  <!-- INFO SECTION -->
  <div class="p-3">
    <div class="fw-semibold text-dark">
      <%= vehicle.name %>
    </div>

    <div class="text-muted small d-flex justify-content-between mt-1">
      <span><%= vehicle.service_owner %></span>
      <span><%= vehicle.trips_count %> trips</span>
    </div>
  </div>
</div>
