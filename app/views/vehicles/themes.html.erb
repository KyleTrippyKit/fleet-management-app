    3: { 
      name: "Trinidad Gradient", 
      description: "Patriotic theme using Trinidad & Tobago national colors in the background design. Shows national pride while maintaining professionalism.",
      icon: "🇹🇹"
    },
    4: { 
      name: "Clean Admin", 
      description: "Traditional admin panel with clear hierarchy and sidebar navigation. Familiar interface for experienced fleet managers.",
      icon: "⚙️"
    },
    5: { 
      name: "Map-Centric", 
      description: "Optimized for real-time tracking with map visualization as the focus. Subtle map patterns in the background enhance the tracking experience.",
      icon: "🗺️"
    },
    6: { 
      name: "Emergency Response", 
      description: "High-visibility emergency vehicle theme with reflective stripes and alert colors. Perfect for quick identification and response scenarios.",
      icon: "🚨"
    },
    7: { 
      name: "Coastal/Tropical", 
      description: "Beach-inspired theme with ocean blues, sand beige, and palm greens. Brings a Caribbean vibe to fleet management.",
      icon: "🏖️"
