      description: "Clean corporate design with blue and gray tones. Professional interface suitable for business environments.",
      icon: "🏢"
    }
  };
  
  let currentTheme = null;
  
  function selectTheme(themeNumber) {
    // Remove active class from all
    document.querySelectorAll('.theme-card').forEach(card => {
      card.classList.remove('active');
    });
    
    // Add active to selected
    const selectedCard = document.querySelector(`.theme-${themeNumber}`);
    if (selectedCard) {
      selectedCard.classList.add('active');
    }
    
    // Update selected theme display
    const themeInfo = themes[themeNumber];
    document.getElementById('themeName').textContent = themeInfo.name;
    document.getElementById('themeDescription').textContent = themeInfo.description;
    document.getElementById('selectedTheme').style.display = 'block';
    
    currentTheme = themeNumber;
    
    // Save to localStorage immediately
    localStorage.setItem('selectedTheme', themeNumber);
    localStorage.setItem('themeTestMode', 'true');
    
    // Scroll to selected theme info
    document.getElementById('selectedTheme').scrollIntoView({ 
      behavior: 'smooth',
      block: 'start'
    });
  }
  
  function copyThemeCode() {
    if (!currentTheme) {
      alert("Please select a theme first!");
      return;
    }
    
    const themeCSS = generateThemeCSS(currentTheme);
    navigator.clipboard.writeText(themeCSS).then(() => {
      // Show success message
      const originalText = event.target.innerHTML;
      event.target.innerHTML = '<i class="fas fa-check"></i> Copied!';
      event.target.style.background = 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
      
      setTimeout(() => {
        event.target.innerHTML = originalText;
        event.target.style.background = 'linear-gradient(135deg, #0055A4 0%, #0066CC 100%)';
      }, 2000);
    }).catch(err => {
      console.error('Failed to copy: ', err);
      alert("Failed to copy to clipboard. Please try again.");
    });
  }
  
  function showImplementationSteps() {
    const stepsDiv = document.getElementById('implementationSteps');
    stepsDiv.style.display = stepsDiv.style.display === 'none' ? 'block' : 'none';
  }
  
  function testThemeInApp() {
    if (!currentTheme) {
      alert("Please select a theme first!");
      return;
    }
    
    // Store selected theme in localStorage
    localStorage.setItem('selectedTheme', currentTheme);
    localStorage.setItem('themeTestMode', 'true');
    
    // Show success message
    const themeInfo = themes[currentTheme];
    alert(`✅ Theme "${themeInfo.name}" selected!\n\nYou will now be redirected to the dashboard with this theme applied.`);
    
    // Redirect to vehicles page with theme parameter
    window.location.href = `<%= vehicles_path %>?theme=${currentTheme}`;
  }
  
  function generateThemeCSS(themeNumber) {
    const themeCSS = {
      1: `/* Theme 1: Modern Light */
/* app/assets/stylesheets/themes/theme_light.scss */

:root {
