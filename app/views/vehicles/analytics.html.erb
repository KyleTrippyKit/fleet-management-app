<!-- app/views/vehicles/analytics.html.erb -->
<div class="container-fluid py-4 px-4">
  <!-- Debug Info Section -->
  <% if Rails.env.development? %>
  <div class="alert alert-info alert-dismissible fade show" role="alert">
    <h5>📊 Analytics Data Status:</h5>
    <ul>
      <li>✅ <strong>Total Vehicles:</strong> <%= @total_vehicles %></li>
      <li>✅ <strong>Data Period:</strong> 
        <% if @current_params[:from].present? && @current_params[:to].present? %>
          <%= @current_params[:from] %> to <%= @current_params[:to] %> 
          (<%= ((@current_params[:to].to_date - @current_params[:from].to_date) + 1).to_i %> days)
        <% else %>
          Not specified
        <% end %>
      </li>
      <li>✅ <strong>Trips Found:</strong> <%= @stats[:total_trips] %> trips across all vehicles</li>
      <li>✅ <strong>Utilization Distribution:</strong> High: <%= @stats[:high_utilization] %>, Medium: <%= @stats[:medium_utilization] %>, Low: <%= @stats[:low_utilization] %></li>
      <li>✅ <strong>Sample Vehicle:</strong> <%= @paginated_vehicles.first[:name] if @paginated_vehicles.any? %> - <%= @paginated_vehicles.first[:trip_count] if @paginated_vehicles.any? %> trips, <%= @paginated_vehicles.first[:utilization] if @paginated_vehicles.any? %>% utilization</li>
    </ul>
    <div class="mt-2">
      <small class="text-muted">
        <i class="bi bi-lightbulb"></i> 
        <strong>Note:</strong> Low utilization (1.8%) means vehicles are underutilized. Consider adding more trips or adjusting expectations.
      </small>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% end %>

  <!-- Data Quality Alert -->
  <% if @stats[:total_trips] > 0 && @stats[:avg_utilization] < 10 %>
  <div class="alert alert-warning mb-4">
    <div class="d-flex align-items-center">
      <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
      <div>
        <h6 class="mb-1">Low Fleet Utilization Detected</h6>
        <p class="mb-0">
          Your fleet is operating at <strong><%= @stats[:avg_utilization] %>%</strong> utilization. 
          Healthy fleet utilization typically ranges from 30-70%. 
          <% if @stats[:total_trips] > 0 %>
            You have <%= @stats[:total_trips] %> trips recorded, but vehicles are idle most of the time.
          <% end %>
        </p>
      </div>
    </div>
  </div>
  <% end %>

  <!-- Analytics Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-2">
        <i class="bi bi-graph-up me-2 text-primary"></i>Fleet Analytics Dashboard
      </h1>
      <p class="text-muted mb-0">Monitor performance, utilization, and maintenance metrics across your fleet</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to export_csv_vehicles_path(from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
            class: "btn btn-outline-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-file-earmark-arrow-down"></i> Export
      <% end %>
      <%= link_to vehicles_path, 
            class: "btn btn-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-arrow-left me-2"></i>Back to Fleet
      <% end %>
    </div>
  </div>

  <!-- Date Range & Filters Card -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: analytics_vehicles_path, method: :get, local: true, 
            class: "row g-3 align-items-end" do |f| %>
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">FROM DATE</label>
          <%= f.date_field :from, value: @current_params.try(:[], :from), 
                class: "form-control", max: Date.today %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">TO DATE</label>
          <%= f.date_field :to, value: @current_params.try(:[], :to), 
                class: "form-control", max: Date.today %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">SERVICE OWNER</label>
          <%= f.select :owner, 
                options_for_select(["All Owners", "PTSC", "Police", "Fire Service"], 
                                   @current_params.try(:[], :owner) || "All Owners"),
                {}, class: "form-select" %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">VIEW TYPE</label>
          <div class="btn-group w-100" role="group">
            <%= link_to analytics_vehicles_path(view: 'grid', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-grid"></i> Grid
            <% end %>
            <%= link_to analytics_vehicles_path(view: 'table', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'table' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-list"></i> Table
            <% end %>
            <%= link_to analytics_vehicles_path(view: 'chart', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'chart' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-bar-chart"></i> Charts
            <% end %>
          </div>
        </div>
        
        <div class="col-12">
          <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-funnel me-1"></i> Apply Filters
            </button>
            <%= link_to "Reset", analytics_vehicles_path, 
                  class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Summary Stats - IMPROVED WITH BETTER VISIBILITY -->
  <div class="row mb-4 g-3">
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="me-3 bg-primary bg-opacity-10 p-3 rounded">
              <i class="bi bi-signpost fs-2 text-primary"></i>
            </div>
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">TOTAL DISTANCE</h6>
              <h3 class="mb-1 text-dark"><%= number_with_delimiter(@stats[:total_distance].round) %> km</h3>
              <p class="text-muted mb-0 small">
                <i class="bi bi-arrow-up text-success"></i> 
                Avg: <%= (@total_vehicles > 0 ? (@stats[:total_distance] / @total_vehicles).round(1) : 0) %> km/vehicle
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="me-3 bg-success bg-opacity-10 p-3 rounded">
              <i class="bi bi-clock fs-2 text-success"></i>
            </div>
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">TOTAL HOURS</h6>
              <h3 class="mb-1 text-dark"><%= @stats[:total_hours].round %> hrs</h3>
              <p class="text-muted mb-0 small">
                <i class="bi bi-calendar"></i>
                <% if @current_params[:from].present? && @current_params[:to].present? %>
                  <%= ((@current_params[:to].to_date - @current_params[:from].to_date) + 1).to_i %> days
                <% else %>
                  Select range
                <% end %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="me-3 bg-warning bg-opacity-10 p-3 rounded">
              <i class="bi bi-arrow-repeat fs-2 text-warning"></i>
            </div>
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">TOTAL TRIPS</h6>
              <h3 class="mb-1 text-dark"><%= @stats[:total_trips] %></h3>
              <p class="text-muted mb-0 small">
                <i class="bi bi-graph-up text-info"></i> 
                Avg: <%= (@total_vehicles > 0 ? (@stats[:total_trips].to_f / @total_vehicles).round(1) : 0) %> trips/vehicle
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="me-3 bg-info bg-opacity-10 p-3 rounded">
              <i class="bi bi-speedometer2 fs-2 text-info"></i>
            </div>
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">AVG UTILIZATION</h6>
              <h3 class="mb-1 text-dark"><%= @stats[:avg_utilization].to_f.nan? ? 0 : @stats[:avg_utilization] %>%</h3>
              <div class="d-flex gap-1 mt-1">
                <span class="badge bg-success"><%= @stats[:high_utilization] %> High</span>
                <span class="badge bg-warning"><%= @stats[:medium_utilization] %> Medium</span>
                <span class="badge bg-danger"><%= @stats[:low_utilization] %> Low</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fleet Utilization Notice -->
  <% if @stats[:low_utilization] == @total_vehicles && @total_vehicles > 0 %>
  <div class="alert alert-warning mb-4">
    <h6><i class="bi bi-info-circle me-2"></i> Fleet Underutilization Notice</h6>
    <p class="mb-0">
      All vehicles in your fleet have low utilization (< 30%). 
      <% if @stats[:avg_utilization] < 5 %>
        The average utilization is only <strong><%= @stats[:avg_utilization] %>%</strong>, indicating significant underutilization.
      <% else %>
        The average utilization is <strong><%= @stats[:avg_utilization] %>%</strong>.
      <% end %>
      Consider:
      <ul class="mb-0 mt-2">
        <li>Reviewing trip scheduling</li>
        <li>Optimizing vehicle assignments</li>
        <li>Adjusting fleet size if consistently underutilized</li>
      </ul>
    </p>
  </div>
  <% end %>

  <!-- Utilization Distribution -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-light">
          <h5 class="mb-0">Vehicle Utilization Distribution</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <div class="text-center mb-4">
                <div class="position-relative d-inline-block">
                  <svg width="120" height="120" viewBox="0 0 36 36" class="circular-chart">
                    <path class="circle-bg"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <%# FIXED: Add guard clauses for division by zero and NaN %>
                    <% low_percent = @total_vehicles > 0 ? (@stats[:low_utilization].to_f / @total_vehicles * 100).round : 0 %>
                    <% med_percent = @total_vehicles > 0 ? (@stats[:medium_utilization].to_f / @total_vehicles * 100).round : 0 %>
                    <% high_percent = @total_vehicles > 0 ? (@stats[:high_utilization].to_f / @total_vehicles * 100).round : 0 %>
                    
                    <path class="circle danger"
                      stroke-dasharray="<%= low_percent %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle warning"
                      stroke-dasharray="<%= med_percent %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                      style="transform: rotate(<%= low_percent * 3.6 %>deg); transform-origin: 18px 18px;"
                    />
                    <path class="circle success"
                      stroke-dasharray="<%= high_percent %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                      style="transform: rotate(<%= (low_percent + med_percent) * 3.6 %>deg); transform-origin: 18px 18px;"
                    />
                    <text x="18" y="20.5" class="percentage"><%= @stats[:avg_utilization].to_f.nan? ? 0 : @stats[:avg_utilization] %>%</text>
                    <text x="18" y="24.5" class="label">Avg</text>
                  </svg>
                </div>
              </div>
            </div>
            <div class="col-md-8">
              <div class="utilization-bars">
                <% [[@stats[:high_utilization], 'High (>70%)', 'success'],
                    [@stats[:medium_utilization], 'Medium (30-70%)', 'warning'],
                    [@stats[:low_utilization], 'Low (<30%)', 'danger']].each do |count, label, color| %>
                  <div class="utilization-bar mb-3">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted"><%= label %></span>
                      <span class="fw-bold"><%= count %> vehicles</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                      <%# FIXED: Add guard clause for division by zero %>
                      <% width_percent = @total_vehicles > 0 ? (count.to_f / @total_vehicles * 100).round : 0 %>
                      <div class="progress-bar bg-<%= color %>" 
                           style="width: <%= width_percent %>%"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-light">
          <h5 class="mb-0">Service Owner Distribution</h5>
        </div>
        <div class="card-body">
          <div class="owner-distribution">
            <% if @owner_distribution.any? %>
              <% @owner_distribution.each do |owner, count| %>
                <div class="owner-item mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="fw-medium"><%= owner %></span>
                    <span class="text-muted"><%= count %> vehicles</span>
                  </div>
                  <div class="progress" style="height: 8px;">
                    <%# FIXED: Add guard clause for division by zero %>
                    <% owner_width = @total_vehicles > 0 ? (count.to_f / @total_vehicles * 100).round : 0 %>
                    <div class="progress-bar bg-<%= owner_badge_color(owner) %>" 
                         style="width: <%= owner_width %>%"></div>
                  </div>
                  <div class="text-end small text-muted mt-1">
                    <%= @total_vehicles > 0 ? (count.to_f / @total_vehicles * 100).round(1) : 0 %>%
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No service owner distribution data available
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Data View (Grid/Table/Chart) -->
  <div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Vehicle Performance Data</h5>
      <div class="d-flex gap-2">
        <span class="text-muted small">
          Showing <%= @paginated_vehicles.length %> of <%= @total_vehicles %> vehicles
        </span>
        <div class="dropdown">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" 
                  data-bs-toggle="dropdown">
            Sort by: <%= @current_params[:sort_by].try(:titleize) || 'Utilization' %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <% ['utilization', 'distance', 'hours', 'trips', 'name', 'owner'].each do |sort_by| %>
              <li>
                <%= link_to analytics_vehicles_path(@current_params.merge(sort_by: sort_by)), 
                      class: "dropdown-item #{@current_params[:sort_by] == sort_by ? 'active' : ''}" do %>
                  <i class="bi bi-arrow-<%= @current_params[:sort_order] == 'asc' ? 'up' : 'down' %> 
                         <%= @current_params[:sort_by] == sort_by ? '' : 'invisible' %> me-2"></i>
                  <%= sort_by.titleize %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="card-body">
      <% if @view == 'grid' %>
        <!-- Grid View -->
        <% if @paginated_vehicles.any? %>
          <div class="row g-3">
            <% @paginated_vehicles.each do |vehicle_data| %>
              <div class="col-md-6 col-xl-4">
                <div class="card h-100 border">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                      <div>
                        <h6 class="fw-bold mb-1"><%= vehicle_data[:name] %></h6>
                        <div class="d-flex align-items-center gap-2">
                          <% if vehicle_data[:registration_number].present? %>
                            <span class="badge bg-dark text-white border">
                              <i class="bi bi-car-front me-1"></i> <%= vehicle_data[:registration_number] %>
                            </span>
                          <% end %>
                          <span class="badge bg-<%= owner_badge_color(vehicle_data[:service_owner]) %>">
                            <%= vehicle_data[:service_owner] %>
                          </span>
                          <span class="text-muted small">
                            <%= vehicle_data[:trip_count] %> trips
                          </span>
                        </div>
                      </div>
                      <span class="badge bg-<%= utilization_badge_color(vehicle_data[:utilization]) %> 
                            px-3 py-2 fs-6">
                        <%= vehicle_data[:utilization].to_f.nan? ? 0 : vehicle_data[:utilization] %>%
                      </span>
                    </div>
                    
                    <div class="row g-2 mb-3">
                      <div class="col-6">
                        <div class="text-center p-2 bg-light rounded">
                          <div class="text-muted small">Distance</div>
                          <div class="fw-bold"><%= vehicle_data[:distance_km].round(1) %> km</div>
                        </div>
                      </div>
                      <div class="col-6">
                        <div class="text-center p-2 bg-light rounded">
                          <div class="text-muted small">Hours</div>
                          <div class="fw-bold"><%= vehicle_data[:hours_plied].round(1) %></div>
                        </div>
                      </div>
                    </div>
                    
                    <div class="mb-3">
                      <div class="d-flex justify-content-between mb-1 small">
                        <span>Utilization</span>
                        <span><%= vehicle_data[:utilization].to_f.nan? ? 0 : vehicle_data[:utilization] %>%</span>
                      </div>
                      <div class="progress" style="height: 6px;">
                        <% util_width = vehicle_data[:utilization].to_f.nan? ? 0 : [vehicle_data[:utilization].to_f, 100].min %>
                        <div class="progress-bar bg-<%= utilization_badge_color(vehicle_data[:utilization]) %>" 
                             style="width: <%= util_width %>%"></div>
                      </div>
                    </div>
                    
                    <div class="text-center">
                      <%= link_to "View Details", vehicle_path(vehicle_data[:id]), 
                            class: "btn btn-sm btn-outline-primary w-100" %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No vehicle data available for the selected filters
          </div>
        <% end %>
        
      <% elsif @view == 'table' %>
        <!-- Table View -->
        <% if @paginated_vehicles.any? %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Vehicle</th>
                  <th>Owner</th>
                  <th>Distance (km)</th>
                  <th>Hours</th>
                  <th>Trips</th>
                  <th>Utilization</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @paginated_vehicles.each do |vehicle_data| %>
                  <tr>
                    <td>
                      <div class="fw-bold"><%= vehicle_data[:name] %></div>
                      <div class="small">
                        <% if vehicle_data[:registration_number].present? %>
                          <span class="text-dark fw-medium d-flex align-items-center">
                            <i class="bi bi-card-text me-1 text-muted"></i>
                            <span class="plate-text"><%= vehicle_data[:registration_number] %></span>
                          </span>
                        <% end %>
                        <% if vehicle_data[:service_owner].present? %>
                          <span class="text-muted mt-1 d-block small"><%= vehicle_data[:service_owner] %></span>
                        <% end %>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-<%= owner_badge_color(vehicle_data[:service_owner]) %>">
                        <%= vehicle_data[:service_owner] %>
                      </span>
                    </td>
                    <td class="fw-medium"><%= vehicle_data[:distance_km].round(1) %></td>
                    <td class="fw-medium"><%= vehicle_data[:hours_plied].round(1) %></td>
                    <td><%= vehicle_data[:trip_count] %></td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <span class="fw-medium"><%= vehicle_data[:utilization].to_f.nan? ? 0 : vehicle_data[:utilization] %>%</span>
                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                          <% util_width = vehicle_data[:utilization].to_f.nan? ? 0 : [vehicle_data[:utilization].to_f, 100].min %>
                          <div class="progress-bar bg-<%= utilization_badge_color(vehicle_data[:utilization]) %>" 
                               style="width: <%= util_width %>%"></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <%= link_to "View", vehicle_path(vehicle_data[:id]), 
                            class: "btn btn-sm btn-outline-primary" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No vehicle data available for the selected filters
          </div>
        <% end %>
        
      <% else %>
        <!-- Chart View - OPTIMIZED FOR MANY VEHICLES WITH LICENSE PLATE INTEGRATION -->
        <div id="analytics-charts">
          <% if @paginated_vehicles.any? %>
            <!-- Chart Controls for Large Datasets -->
            <% if @total_vehicles > 10 %>
            <div class="alert alert-info mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <i class="bi bi-info-circle me-2"></i>
                  Showing top 10 vehicles by distance. Use filters to see specific vehicles.
                </div>
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-primary active" data-chart-limit="10">Top 10</button>
                  <button class="btn btn-outline-primary" data-chart-limit="20">Top 20</button>
                  <button class="btn btn-outline-primary" data-chart-limit="all">All</button>
                </div>
              </div>
            </div>
            <% end %>
            
            <div class="chart-container" style="position: relative; height:400px; width:100%">
              <canvas id="distanceChart"></canvas>
            </div>
            <div class="chart-container mt-5" style="position: relative; height:400px; width:100%">
              <canvas id="utilizationChart"></canvas>
            </div>
            
            <script>
              // Wait for DOM and Chart.js to be fully loaded
              document.addEventListener('DOMContentLoaded', function() {
                console.log('DOM loaded, initializing optimized charts...');
                
                // Check if Chart is available
                if (typeof Chart === 'undefined') {
                  console.error('Chart.js is not loaded!');
                  document.getElementById('analytics-charts').innerHTML = 
                    '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>Chart.js failed to load. Please check your JavaScript imports.</div>';
                  return;
                }
                
                // Get all vehicle data
                const allVehicles = <%= raw @paginated_vehicles.to_json %>;
                console.log('Total vehicles for charts:', allVehicles.length);
                
                // Function to get limited data based on selection
                function getChartData(limit = 10) {
                  let vehicles = [...allVehicles];
                  
                  // Sort by distance for distance chart
                  vehicles.sort((a, b) => b.distance_km - a.distance_km);
                  
                  // Apply limit
                  if (limit !== 'all' && limit < vehicles.length) {
                    vehicles = vehicles.slice(0, limit);
                  }
                  
                  // Clean vehicle data and format display name with license plate
                  return vehicles.map(v => ({
                    ...v,
                    distance_km: isNaN(v.distance_km) ? 0 : v.distance_km,
                    utilization: isNaN(v.utilization) ? 0 : v.utilization,
                    hours_plied: isNaN(v.hours_plied) ? 0 : v.hours_plied,
                    name: v.name || 'Unnamed Vehicle',
                    registration_number: v.registration_number || 'N/A',
                    // NEW: Create display name with both name and license plate
                    displayName: formatDisplayName(v.name, v.registration_number, v.service_owner),
                    // Short version for chart labels
                    shortName: formatShortName(v.name, v.registration_number)
                  }));
                }
                
                // NEW: Format display name with license plate
                function formatDisplayName(name, plate, owner) {
                  let display = name || 'Unnamed Vehicle';
                  if (plate && plate !== 'N/A') {
                    display += ` (${plate})`;
                  }
                  if (owner && owner !== 'Unknown') {
                    display += ` - ${owner}`;
                  }
                  return display;
                }
                
                // NEW: Format short name for chart labels
                function formatShortName(name, plate) {
                  const namePart = name || 'Vehicle';
                  const platePart = plate && plate !== 'N/A' ? `(${plate})` : '';
                  
                  // Combine both, but limit length
                  const combined = `${namePart} ${platePart}`.trim();
                  
                  if (combined.length > 20) {
                    return combined.substring(0, 17) + '...';
                  }
                  return combined;
                }
                
                // Function to create or update charts
                function createCharts(limit = 10) {
                  try {
                    const vehicles = getChartData(limit);
                    console.log(`Creating charts with ${vehicles.length} vehicles`);
                    
                    // Destroy existing charts if they exist
                    const distanceCanvas = document.getElementById('distanceChart');
                    const utilizationCanvas = document.getElementById('utilizationChart');
                    
                    if (window.distanceChart instanceof Chart) {
                      window.distanceChart.destroy();
                    }
                    if (window.utilizationChart instanceof Chart) {
                      window.utilizationChart.destroy();
                    }
                    
                    // Distance Chart
                    if (distanceCanvas) {
                      const distanceCtx = distanceCanvas.getContext('2d');
                      
                      window.distanceChart = new Chart(distanceCtx, {
                        type: 'bar',
                        data: {
                          labels: vehicles.map(v => v.shortName),
                          datasets: [{
                            label: 'Distance (km)',
                            data: vehicles.map(v => v.distance_km),
                            backgroundColor: vehicles.map((v, i) => 
                              `hsl(${(i * 360 / Math.max(vehicles.length, 1)) % 360}, 70%, 60%)`
                            ),
                            borderColor: vehicles.map((v, i) => 
                              `hsl(${(i * 360 / Math.max(vehicles.length, 1)) % 360}, 70%, 40%)`
                            ),
                            borderWidth: 1
                          }]
                        },
                        options: {
                          responsive: true,
                          maintainAspectRatio: false,
                          plugins: {
                            legend: { 
                              display: false
                            },
                            title: { 
                              display: true, 
                              text: vehicles.length === allVehicles.length ? 
                                'Distance Traveled by All Vehicles (km)' :
                                `Top ${vehicles.length} Vehicles by Distance (km)`,
                              font: { size: 16 }
                            },
                            tooltip: {
                              callbacks: {
                                // UPDATED: Enhanced tooltip with license plate
                                title: function(context) {
                                  const vehicle = vehicles[context[0].dataIndex];
                                  return vehicle.displayName;
                                },
                                label: function(context) {
                                  const vehicle = vehicles[context.dataIndex];
                                  return [
                                    `Distance: ${vehicle.distance_km.toFixed(1)} km`,
                                    `Trips: ${vehicle.trip_count}`,
                                    `Utilization: ${vehicle.utilization.toFixed(1)}%`,
                                    `Owner: ${vehicle.service_owner}`
                                  ];
                                },
                                afterLabel: function(context) {
                                  const vehicle = vehicles[context.dataIndex];
                                  // Add license plate as separate line if not in title
                                  return `License Plate: ${vehicle.registration_number}`;
                                }
                              }
                            }
                          },
                          scales: {
                            y: {
                              beginAtZero: true,
                              title: {
                                display: true,
                                text: 'Kilometers'
                              }
                            },
                            x: {
                              ticks: {
                                maxRotation: vehicles.length > 15 ? 90 : 45,
                                minRotation: vehicles.length > 15 ? 90 : 45,
                                font: {
                                  size: vehicles.length > 20 ? 10 : 12
                                }
                              }
                            }
                          }
                        }
                      });
                    }
                    
                    // Utilization Chart
                    if (utilizationCanvas) {
                      const utilCtx = utilizationCanvas.getContext('2d');
                      
                      // Sort by utilization for this chart
                      const sortedByUtilization = [...vehicles].sort((a, b) => b.utilization - a.utilization);
                      
                      window.utilizationChart = new Chart(utilCtx, {
                        type: vehicles.length > 30 ? 'bar' : 'line',
                        data: {
                          labels: sortedByUtilization.map(v => v.shortName),
                          datasets: [{
                            label: 'Utilization %',
                            data: sortedByUtilization.map(v => v.utilization),
                            backgroundColor: vehicles.length > 30 ? 
                              sortedByUtilization.map((v, i) => 
                                `hsl(${(i * 360 / Math.max(sortedByUtilization.length, 1)) % 360}, 70%, 60%)`
                              ) :
                              'rgba(255, 99, 132, 0.2)',
                            borderColor: vehicles.length > 30 ?
                              sortedByUtilization.map((v, i) => 
                                `hsl(${(i * 360 / Math.max(sortedByUtilization.length, 1)) % 360}, 70%, 40%)`
                              ) :
                              'rgba(255, 99, 132, 1)',
                            borderWidth: 2,
                            fill: vehicles.length <= 30,
                            tension: vehicles.length <= 30 ? 0.4 : 0
                          }]
                        },
                        options: {
                          responsive: true,
                          maintainAspectRatio: false,
                          plugins: {
                            legend: { 
                              display: false
                            },
                            title: { 
                              display: true, 
                              text: vehicles.length === allVehicles.length ? 
                                'Utilization Rate for All Vehicles (%)' :
                                `Top ${vehicles.length} Vehicles by Utilization (%)`,
                              font: { size: 16 }
                            },
                            tooltip: {
                              callbacks: {
                                // UPDATED: Enhanced tooltip with license plate
                                title: function(context) {
                                  const vehicle = sortedByUtilization[context[0].dataIndex];
                                  return vehicle.displayName;
                                },
                                label: function(context) {
                                  const vehicle = sortedByUtilization[context.dataIndex];
                                  return [
                                    `Utilization: ${vehicle.utilization.toFixed(1)}%`,
                                    `Distance: ${vehicle.distance_km.toFixed(1)} km`,
                                    `Trips: ${vehicle.trip_count}`
                                  ];
                                },
                                afterLabel: function(context) {
                                  const vehicle = sortedByUtilization[context.dataIndex];
                                  return `License Plate: ${vehicle.registration_number}`;
                                }
                              }
                            }
                          },
                          scales: {
                            y: {
                              beginAtZero: true,
                              max: 100,
                              title: {
                                display: true,
                                text: 'Utilization %'
                              }
                            },
                            x: {
                              ticks: {
                                maxRotation: vehicles.length > 15 ? 90 : 45,
                                minRotation: vehicles.length > 15 ? 90 : 45,
                                font: {
                                  size: vehicles.length > 20 ? 10 : 12
                                }
                              }
                            }
                          }
                        }
                      });
                    }
                    
                    console.log('Charts created successfully');
                    
                  } catch (error) {
                    console.error('Error creating charts:', error);
                    document.getElementById('analytics-charts').innerHTML = 
                      '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error creating charts: ' + error.message + '</div>';
                  }
                }
                
                // Initial chart creation
                createCharts(10);
                
                // Add event listeners for chart limit buttons
                document.querySelectorAll('[data-chart-limit]').forEach(button => {
                  button.addEventListener('click', function() {
                    // Update active button
                    document.querySelectorAll('[data-chart-limit]').forEach(btn => {
                      btn.classList.remove('active');
                    });
                    this.classList.add('active');
                    
                    // Recreate charts with new limit
                    const limit = this.dataset.chartLimit === 'all' ? 'all' : parseInt(this.dataset.chartLimit);
                    createCharts(limit);
                  });
                });
                
              });
              
              // Also trigger on turbo:load for Turbo Drive compatibility
              document.addEventListener('turbo:load', function() {
                if (typeof Chart !== 'undefined' && document.getElementById('distanceChart')) {
                  console.log('Turbo loaded, reinitializing charts...');
                  const event = new Event('DOMContentLoaded');
                  document.dispatchEvent(event);
                }
              });
            </script>
          <% else %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              No chart data available for the selected filters
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="card-footer">
        <nav aria-label="Analytics pagination">
          <ul class="pagination justify-content-center mb-0">
            <% if @page > 1 %>
              <li class="page-item">
                <%= link_to analytics_vehicles_path(@current_params.merge(page: @page - 1)), 
                      class: "page-link" do %>
                  <i class="bi bi-chevron-left"></i> Previous
                <% end %>
              </li>
            <% end %>
            
            <% (1..@total_pages).each do |page_num| %>
              <% if page_num == @page %>
                <li class="page-item active">
                  <span class="page-link"><%= page_num %></span>
                </li>
              <% elsif (page_num - @page).abs <= 2 %>
                <li class="page-item">
                  <%= link_to page_num, analytics_vehicles_path(@current_params.merge(page: page_num)), 
                        class: "page-link" %>
                </li>
              <% end %>
            <% end %>
            
            <% if @page < @total_pages %>
              <li class="page-item">
                <%= link_to analytics_vehicles_path(@current_params.merge(page: @page + 1)), 
                      class: "page-link" do %>
                  Next <i class="bi bi-chevron-right"></i>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    <% end %>
  </div>
</div>

<style>
/* Summary Stats Cards */
.card {
  border-radius: 0.75rem;
  overflow: hidden;
  transition: transform 0.2s;
}

.card:hover {
  transform: translateY(-2px);
}

.card-header {
  border-bottom: 1px solid rgba(0,0,0,.125);
}

/* Utilization Chart */
.circular-chart {
  display: block;
  margin: 10px auto;
  max-width: 80%;
  max-height: 250px;
}

.circle-bg {
  fill: none;
  stroke: #eee;
  stroke-width: 3.8;
}

.circle {
  fill: none;
  stroke-width: 2.8;
  stroke-linecap: round;
  animation: progress 1s ease-out forwards;
}

.circle.danger {
  stroke: #dc3545;
}

.circle.warning {
  stroke: #ffc107;
}

.circle.success {
  stroke: #198754;
}

@keyframes progress {
  0% {
    stroke-dasharray: 0 100;
  }
}

.percentage {
  fill: #666;
  font-size: 0.5em;
  text-anchor: middle;
}

.label {
  fill: #999;
  font-size: 0.3em;
  text-anchor: middle;
}

/* Progress Bars */
.utilization-bars .progress-bar {
  border-radius: 4px;
}

.owner-distribution .progress-bar {
  border-radius: 4px;
}

/* Table Styling */
.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
  background-color: #f8f9fa;
}

.table tbody tr:hover {
  background-color: #f8f9fa;
}

/* Pagination */
.pagination .page-item.active .page-link {
  background-color: #0d6efd;
  border-color: #0d6efd;
}

/* Form Elements */
.btn-group .btn {
  border-radius: 0.375rem !important;
}

.form-control, .form-select {
  border-radius: 0.5rem;
}

/* Chart Container */
.chart-container {
  background: white;
  border-radius: 0.5rem;
  padding: 1rem;
  border: 1px solid #dee2e6;
}

/* License Plate Styling - NEUTRAL COLORS */
.badge.bg-dark {
  background-color: #343a40 !important;
  border-color: #495057 !important;
  color: white !important;
  font-weight: 500;
}

.plate-text {
  color: #212529;
  font-family: 'Courier New', monospace;
  letter-spacing: 0.5px;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .chart-container {
    height: 300px !important;
  }
  
  .summary-stats h3 {
    font-size: 1.5rem;
  }
}

/* Ensure Bootstrap Icons load */
@import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css");
</style>

<!-- Load Chart.js from CDN as fallback -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>