<!-- app/views/vehicles/analytics.html.erb -->
<div class="container-fluid py-4 px-4">
  <!-- Analytics Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-2">
        <i class="bi bi-graph-up me-2 text-primary"></i>Fleet Analytics Dashboard
      </h1>
      <p class="text-muted mb-0">Monitor performance, utilization, and maintenance metrics across your fleet</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to export_csv_vehicles_path(from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
            class: "btn btn-outline-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-file-earmark-arrow-down"></i> Export
      <% end %>
      <%= link_to vehicles_path, 
            class: "btn btn-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-arrow-left me-2"></i>Back to Fleet
      <% end %>
    </div>
  </div>

  <!-- Date Range & Filters Card -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: analytics_vehicles_path, method: :get, local: true, 
            class: "row g-3 align-items-end" do |f| %>
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">FROM DATE</label>
          <%= f.date_field :from, value: @current_params.try(:[], :from), 
                class: "form-control", max: Date.today %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">TO DATE</label>
          <%= f.date_field :to, value: @current_params.try(:[], :to), 
                class: "form-control", max: Date.today %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">SERVICE OWNER</label>
          <%= f.select :owner, 
                options_for_select(["All Owners", "PTSC", "Police", "Fire Service"], 
                                   @current_params.try(:[], :owner) || "All Owners"),
                {}, class: "form-select" %>
        </div>
        
        <div class="col-md-3">
          <label class="form-label small fw-bold text-muted">VIEW TYPE</label>
          <div class="btn-group w-100" role="group">
            <%= link_to analytics_vehicles_path(view: 'grid', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-grid"></i> Grid
            <% end %>
            <%= link_to analytics_vehicles_path(view: 'table', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'table' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-list"></i> Table
            <% end %>
            <%= link_to analytics_vehicles_path(view: 'chart', from: @current_params.try(:[], :from), to: @current_params.try(:[], :to), owner: @current_params.try(:[], :owner)), 
                  class: "btn #{@view == 'chart' ? 'btn-primary' : 'btn-outline-primary'}" do %>
              <i class="bi bi-bar-chart"></i> Charts
            <% end %>
          </div>
        </div>
        
        <div class="col-12">
          <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-funnel me-1"></i> Apply Filters
            </button>
            <%= link_to "Reset", analytics_vehicles_path, 
                  class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row mb-4 g-3">
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 bg-gradient-primary text-white shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-white-50 mb-1">TOTAL DISTANCE</h6>
              <h2 class="mb-0"><%= number_with_delimiter(@stats[:total_distance].round) %> km</h2>
            </div>
            <i class="bi bi-signpost fs-1 opacity-50"></i>
          </div>
          <div class="mt-2 small">
            <i class="bi bi-arrow-up"></i> Average: <%= (@stats[:total_distance] / [@total_vehicles, 1].max).round(1) %> km/vehicle
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 bg-gradient-success text-white shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-white-50 mb-1">TOTAL HOURS</h6>
              <h2 class="mb-0"><%= @stats[:total_hours].round %></h2>
            </div>
            <i class="bi bi-clock fs-1 opacity-50"></i>
          </div>
          <div class="mt-2 small">
            <i class="bi bi-calendar"></i> 
            <% if @current_params[:from] && @current_params[:to] %>
              <%= ((@current_params[:to].to_date - @current_params[:from].to_date) + 1).to_i %> days period
            <% else %>
              Select date range
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 bg-gradient-warning text-white shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-white-50 mb-1">TRIPS COUNT</h6>
              <h2 class="mb-0"><%= @stats[:total_trips] %></h2>
            </div>
            <i class="bi bi-arrow-repeat fs-1 opacity-50"></i>
          </div>
          <div class="mt-2 small">
            <i class="bi bi-graph-up"></i> <%= (@stats[:total_trips].to_f / [@total_vehicles, 1].max).round(1) %> trips/vehicle
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-6">
      <div class="card border-0 bg-gradient-info text-white shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-white-50 mb-1">AVG UTILIZATION</h6>
              <h2 class="mb-0"><%= @stats[:avg_utilization] %>%</h2>
            </div>
            <i class="bi bi-speedometer2 fs-1 opacity-50"></i>
          </div>
          <div class="mt-2">
            <span class="badge bg-success"><%= @stats[:high_utilization] %> High</span>
            <span class="badge bg-warning ms-1"><%= @stats[:medium_utilization] %> Medium</span>
            <span class="badge bg-danger ms-1"><%= @stats[:low_utilization] %> Low</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Utilization Distribution -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-light">
          <h5 class="mb-0">Vehicle Utilization Distribution</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <div class="text-center mb-4">
                <div class="position-relative d-inline-block">
                  <svg width="120" height="120" viewBox="0 0 36 36" class="circular-chart">
                    <path class="circle-bg"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle danger"
                      stroke-dasharray="<%= (@stats[:low_utilization].to_f / @total_vehicles * 100).round %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    <path class="circle warning"
                      stroke-dasharray="<%= (@stats[:medium_utilization].to_f / @total_vehicles * 100).round %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                      style="transform: rotate(<%= (@stats[:low_utilization].to_f / @total_vehicles * 360).round %>deg); transform-origin: 18px 18px;"
                    />
                    <path class="circle success"
                      stroke-dasharray="<%= (@stats[:high_utilization].to_f / @total_vehicles * 100).round %>, 100"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                      style="transform: rotate(<%= ((@stats[:low_utilization] + @stats[:medium_utilization]).to_f / @total_vehicles * 360).round %>deg); transform-origin: 18px 18px;"
                    />
                    <text x="18" y="20.5" class="percentage"><%= @stats[:avg_utilization] %>%</text>
                    <text x="18" y="24.5" class="label">Avg</text>
                  </svg>
                </div>
              </div>
            </div>
            <div class="col-md-8">
              <div class="utilization-bars">
                <% [[@stats[:high_utilization], 'High (>70%)', 'success'],
                    [@stats[:medium_utilization], 'Medium (30-70%)', 'warning'],
                    [@stats[:low_utilization], 'Low (<30%)', 'danger']].each do |count, label, color| %>
                  <div class="utilization-bar mb-3">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted"><%= label %></span>
                      <span class="fw-bold"><%= count %> vehicles</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                      <div class="progress-bar bg-<%= color %>" 
                           style="width: <%= (count.to_f / @total_vehicles * 100).round %>%"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-light">
          <h5 class="mb-0">Service Owner Distribution</h5>
        </div>
        <div class="card-body">
          <div class="owner-distribution">
            <% @owner_distribution.each do |owner, count| %>
              <div class="owner-item mb-3">
                <div class="d-flex justify-content-between mb-1">
                  <span class="fw-medium"><%= owner %></span>
                  <span class="text-muted"><%= count %> vehicles</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar bg-<%= owner_badge_color(owner) %>" 
                       style="width: <%= (count.to_f / @total_vehicles * 100).round %>%"></div>
                </div>
                <div class="text-end small text-muted mt-1">
                  <%= (count.to_f / @total_vehicles * 100).round(1) %>%
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Data View (Grid/Table/Chart) -->
  <div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Vehicle Performance Data</h5>
      <div class="d-flex gap-2">
        <span class="text-muted small">
          Showing <%= @paginated_vehicles.length %> of <%= @total_vehicles %> vehicles
        </span>
        <div class="dropdown">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" 
                  data-bs-toggle="dropdown">
            Sort by: <%= @current_params[:sort_by].try(:titleize) || 'Utilization' %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <% ['utilization', 'distance', 'hours', 'trips', 'name', 'owner'].each do |sort_by| %>
              <li>
                <%= link_to analytics_vehicles_path(@current_params.merge(sort_by: sort_by)), 
                      class: "dropdown-item #{@current_params[:sort_by] == sort_by ? 'active' : ''}" do %>
                  <i class="bi bi-arrow-<%= @current_params[:sort_order] == 'asc' ? 'up' : 'down' %> 
                         <%= @current_params[:sort_by] == sort_by ? '' : 'invisible' %> me-2"></i>
                  <%= sort_by.titleize %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="card-body">
      <% if @view == 'grid' %>
        <!-- Grid View -->
        <div class="row g-3">
          <% @paginated_vehicles.each do |vehicle_data| %>
            <div class="col-md-6 col-xl-4">
              <div class="card h-100 border">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                      <h6 class="fw-bold mb-1"><%= vehicle_data[:name] %></h6>
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-<%= owner_badge_color(vehicle_data[:service_owner]) %>">
                          <%= vehicle_data[:service_owner] %>
                        </span>
                        <span class="text-muted small">
                          <%= vehicle_data[:trip_count] %> trips
                        </span>
                      </div>
                    </div>
                    <span class="badge bg-<%= utilization_badge_color(vehicle_data[:utilization]) %> 
                          px-3 py-2 fs-6">
                      <%= vehicle_data[:utilization] %>%
                    </span>
                  </div>
                  
                  <div class="row g-2 mb-3">
                    <div class="col-6">
                      <div class="text-center p-2 bg-light rounded">
                        <div class="text-muted small">Distance</div>
                        <div class="fw-bold"><%= vehicle_data[:distance_km].round(1) %> km</div>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="text-center p-2 bg-light rounded">
                        <div class="text-muted small">Hours</div>
                        <div class="fw-bold"><%= vehicle_data[:hours_plied].round(1) %></div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1 small">
                      <span>Utilization</span>
                      <span><%= vehicle_data[:utilization] %>%</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                      <div class="progress-bar bg-<%= utilization_badge_color(vehicle_data[:utilization]) %>" 
                           style="width: <%= vehicle_data[:utilization] %>%"></div>
                    </div>
                  </div>
                  
                  <div class="text-center">
                    <%= link_to "View Details", vehicle_path(vehicle_data[:id]), 
                          class: "btn btn-sm btn-outline-primary w-100" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
      <% elsif @view == 'table' %>
        <!-- Table View -->
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Vehicle</th>
                <th>Owner</th>
                <th>Distance (km)</th>
                <th>Hours</th>
                <th>Trips</th>
                <th>Utilization</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @paginated_vehicles.each do |vehicle_data| %>
                <tr>
                  <td>
                    <div class="fw-bold"><%= vehicle_data[:name] %></div>
                    <div class="small text-muted"><%= vehicle_data[:registration_number] %></div>
                  </td>
                  <td>
                    <span class="badge bg-<%= owner_badge_color(vehicle_data[:service_owner]) %>">
                      <%= vehicle_data[:service_owner] %>
                    </span>
                  </td>
                  <td class="fw-medium"><%= vehicle_data[:distance_km].round(1) %></td>
                  <td class="fw-medium"><%= vehicle_data[:hours_plied].round(1) %></td>
                  <td><%= vehicle_data[:trip_count] %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-medium"><%= vehicle_data[:utilization] %>%</span>
                      <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                        <div class="progress-bar bg-<%= utilization_badge_color(vehicle_data[:utilization]) %>" 
                             style="width: <%= vehicle_data[:utilization] %>%"></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <%= link_to "View", vehicle_path(vehicle_data[:id]), 
                          class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
      <% else %>
        <!-- Chart View -->
        <div id="analytics-charts">
          <canvas id="distanceChart" class="mb-4" height="100"></canvas>
          <canvas id="utilizationChart" height="100"></canvas>
        </div>
        
        <script>
          document.addEventListener("DOMContentLoaded", function() {
            const vehicles = <%= raw @paginated_vehicles.to_json %>;
            
            // Distance Chart
            const distanceCtx = document.getElementById('distanceChart').getContext('2d');
            if (distanceCtx) {
              new Chart(distanceCtx, {
                type: 'bar',
                data: {
                  labels: vehicles.map(v => v.name),
                  datasets: [{
                    label: 'Distance (km)',
                    data: vehicles.map(v => v.distance_km),
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                  }]
                },
                options: {
                  responsive: true,
                  plugins: {
                    legend: { display: false },
                    title: { 
                      display: true, 
                      text: 'Distance Traveled by Vehicle (km)',
                      font: { size: 16 }
                    }
                  },
                  scales: {
                    y: {
                      beginAtZero: true,
                      title: {
                        display: true,
                        text: 'Kilometers'
                      }
                    }
                  }
                }
              });
            }
            
            // Utilization Chart
            const utilCtx = document.getElementById('utilizationChart').getContext('2d');
            if (utilCtx) {
              new Chart(utilCtx, {
                type: 'line',
                data: {
                  labels: vehicles.map(v => v.name),
                  datasets: [{
                    label: 'Utilization %',
                    data: vehicles.map(v => v.utilization),
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                  }]
                },
                options: {
                  responsive: true,
                  plugins: {
                    legend: { display: false },
                    title: { 
                      display: true, 
                      text: 'Vehicle Utilization Rate (%)',
                      font: { size: 16 }
                    }
                },
                scales: {
                  y: {
                    beginAtZero: true,
                    max: 100,
                    title: {
                      display: true,
                      text: 'Utilization %'
                    }
                  }
                }
              }
            });
          }
        });
        </script>
      <% end %>
    </div>
    
    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="card-footer">
        <nav aria-label="Analytics pagination">
          <ul class="pagination justify-content-center mb-0">
            <% if @page > 1 %>
              <li class="page-item">
                <%= link_to analytics_vehicles_path(@current_params.merge(page: @page - 1)), 
                      class: "page-link" do %>
                  <i class="bi bi-chevron-left"></i> Previous
                <% end %>
              </li>
            <% end %>
            
            <% (1..@total_pages).each do |page_num| %>
              <% if page_num == @page %>
                <li class="page-item active">
                  <span class="page-link"><%= page_num %></span>
                </li>
              <% elsif (page_num - @page).abs <= 2 %>
                <li class="page-item">
                  <%= link_to page_num, analytics_vehicles_path(@current_params.merge(page: page_num)), 
                        class: "page-link" %>
                </li>
              <% end %>
            <% end %>
            
            <% if @page < @total_pages %>
              <li class="page-item">
                <%= link_to analytics_vehicles_path(@current_params.merge(page: @page + 1)), 
                      class: "page-link" do %>
                  Next <i class="bi bi-chevron-right"></i>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    <% end %>
  </div>
</div>

<style>
.bg-gradient-primary {
  background: linear-gradient(135deg, #0d6efd, #004aad) !important;
}

.bg-gradient-success {
  background: linear-gradient(135deg, #198754, #0d633c) !important;
}

.bg-gradient-warning {
  background: linear-gradient(135deg, #ffc107, #e0a800) !important;
}

.bg-gradient-info {
  background: linear-gradient(135deg, #0dcaf0, #0aa2c0) !important;
}

.circular-chart {
  display: block;
  margin: 10px auto;
  max-width: 80%;
  max-height: 250px;
}

.circle-bg {
  fill: none;
  stroke: #eee;
  stroke-width: 3.8;
}

.circle {
  fill: none;
  stroke-width: 2.8;
  stroke-linecap: round;
  animation: progress 1s ease-out forwards;
}

.circle.danger {
  stroke: #dc3545;
}

.circle.warning {
  stroke: #ffc107;
}

.circle.success {
  stroke: #198754;
}

@keyframes progress {
  0% {
    stroke-dasharray: 0 100;
  }
}

.percentage {
  fill: #666;
  font-size: 0.5em;
  text-anchor: middle;
}

.label {
  fill: #999;
  font-size: 0.3em;
  text-anchor: middle;
}

.utilization-bars .progress-bar {
  border-radius: 4px;
}

.owner-distribution .progress-bar {
  border-radius: 4px;
}

.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
  background-color: #f8f9fa;
}

.table tbody tr:hover {
  background-color: #f8f9fa;
}

.pagination .page-item.active .page-link {
  background-color: #0d6efd;
  border-color: #0d6efd;
}

.btn-group .btn {
  border-radius: 0.375rem !important;
}

.form-control, .form-select {
  border-radius: 0.5rem;
}

.card {
  border-radius: 0.75rem;
  overflow: hidden;
}

.card-header {
  border-bottom: 1px solid rgba(0,0,0,.125);
}
</style>