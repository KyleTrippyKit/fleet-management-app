<%# app/views/quotations/_enhanced_quotation_builder.html.erb %>
<div class="quotation-builder">
  <h4 class="mb-4">
    <i class="bi bi-wrench"></i> Select Job Templates
    <small class="text-muted fs-6">(Inventory status shown in real-time)</small>
  </h4>
  
  <% if @job_templates.present? %>
    <div class="alert alert-info d-flex align-items-center">
      <i class="bi bi-info-circle fs-4 me-2"></i>
      <div>
        <strong>Inventory Integration Active:</strong> Job templates show real-time inventory status. 
        <span class="badge bg-success">Green</span> = All parts in stock, 
        <span class="badge bg-warning">Yellow</span> = Low stock, 
        <span class="badge bg-danger">Red</span> = Critical parts missing.
      </div>
    </div>
    
    <!-- Inventory Status Summary -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card border-success">
          <div class="card-body text-center">
            <h5 class="card-title">
              <i class="bi bi-check-circle text-success"></i>
              Ready to Quote
            </h5>
            <p class="display-6 text-success">
              <%= @job_templates.count { |t| t.inventory_status[:all_available] } %>
            </p>
            <p class="card-text small">Templates with full inventory</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card border-warning">
          <div class="card-body text-center">
            <h5 class="card-title">
              <i class="bi bi-exclamation-triangle text-warning"></i>
              Low Stock
            </h5>
            <p class="display-6 text-warning">
              <%= @job_templates.count { |t| !t.inventory_status[:all_available] } %>
            </p>
            <p class="card-text small">Need inventory check</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card border-info">
          <div class="card-body text-center">
            <h5 class="card-title">
              <i class="bi bi-clipboard-check text-info"></i>
              Total Templates
            </h5>
            <p class="display-6 text-info">
              <%= @job_templates.count %>
            </p>
            <p class="card-text small">Available for selection</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Job Templates List -->
    <div class="job-templates-list">
      <% @job_templates.each do |template| %>
        <% status = template.inventory_status %>
        <div class="card mb-3 border-<%= status[:status_color] %> shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div class="flex-grow-1">
                <div class="d-flex align-items-center mb-2">
                  <h5 class="card-title mb-0 me-2">
                    <i class="bi bi-gear"></i> <%= template.name %>
                  </h5>
                  <span class="badge bg-<%= status[:status_color] %>">
                    <i class="bi bi-<%= status[:all_available] ? 'check-circle' : 'exclamation-triangle' %>"></i>
                    <%= status[:all_available] ? 'Ready' : 'Check Stock' %>
                  </span>
                </div>
                
                <p class="card-text text-muted mb-2">
                  <i class="bi bi-card-text"></i> <%= template.description.truncate(100) %>
                </p>
                
                <div class="d-flex flex-wrap gap-2">
                  <span class="badge bg-info">
                    <i class="bi bi-clock"></i> <%= template.standard_hours || 0 %> hrs
                  </span>
                  <span class="badge bg-secondary">
                    <i class="bi bi-cash"></i> TTD <%= number_to_currency(template.total_cost, unit: '') %>
                  </span>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-box"></i> <%= template.job_template_parts.count %> parts
                  </span>
                  <% if template.category.present? %>
                    <span class="badge bg-light text-dark border">
                      <i class="bi bi-tag"></i> <%= template.category %>
                    </span>
                  <% end %>
                </div>
              </div>
              
              <div class="ms-3 text-end">
                <% if status[:all_available] %>
                  <button type="button" 
                          class="btn btn-success btn-sm add-template-btn" 
                          data-template-id="<%= template.id %>"
                          data-template-name="<%= template.name %>"
                          data-template-hours="<%= template.standard_hours || 0 %>"
                          data-template-rate="<%= template.labor_rate_per_hour || 0 %>"
                          data-bs-toggle="tooltip" 
                          title="Add to quotation">
                    <i class="bi bi-plus-circle"></i> Add
                  </button>
                <% else %>
                  <div class="btn-group" role="group">
                    <button type="button" 
                            class="btn btn-warning btn-sm add-anyway-btn"
                            data-template-id="<%= template.id %>"
                            data-template-name="<%= template.name %>"
                            data-template-hours="<%= template.standard_hours || 0 %>"
                            data-template-rate="<%= template.labor_rate_per_hour || 0 %>"
                            data-bs-toggle="tooltip" 
                            title="Add despite low stock">
                      <i class="bi bi-plus-circle"></i> Add Anyway
                    </button>
                    <button type="button" 
                            class="btn btn-outline-warning btn-sm"
                            data-bs-toggle="collapse" 
                            data-bs-target="#inventoryDetails<%= template.id %>"
                            data-bs-toggle="tooltip" 
                            title="View inventory details">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                <% end %>
                
                <!-- Quick actions for VMCOTT users -->
                <% if current_user.agency&.code == 'VMCOTT' && !status[:all_available] %>
                  <div class="mt-2">
                    <%= link_to vmcott_inventory_create_purchase_request_path(template.id), 
                          class: "btn btn-outline-primary btn-sm",
                          data: { turbo_method: :post },
                          title: "Create purchase requests for missing parts" do %>
                      <i class="bi bi-cart-plus"></i> Order Parts
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Inventory Details (Collapsible) -->
            <% unless status[:all_available] %>
              <div class="collapse mt-3" id="inventoryDetails<%= template.id %>">
                <div class="alert alert-<%= status[:status_color] %>">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h6 class="alert-heading mb-2">
                        <i class="bi bi-exclamation-triangle"></i> 
                        Inventory Status: <%= status[:unavailable_count] %> Parts Need Attention
                      </h6>
                      <p class="mb-2 small">
                        <i class="bi bi-info-circle"></i> 
                        <%= status[:message] %>. These parts must be ordered before work can begin.
                      </p>
                    </div>
                    <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#inventoryDetails<%= template.id %>"></button>
                  </div>
                  
                  <!-- Parts Table -->
                  <div class="table-responsive mt-2">
                    <table class="table table-sm table-bordered">
                      <thead class="table-light">
                        <tr>
                          <th>Part</th>
                          <th>Part #</th>
                          <th>Needed</th>
                          <th>Available</th>
                          <th>Shortfall</th>
                          <th>Status</th>
                          <th>Unit Price</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% status[:unavailable_parts].each do |item| %>
                          <tr class="<%= item[:available] == 0 ? 'table-danger' : 'table-warning' %>">
                            <td>
                              <strong><%= item[:part_name] %></strong>
                              <% if item[:available] == 0 %>
                                <span class="badge bg-danger ms-1">OUT</span>
                              <% end %>
                            </td>
                            <td><code><%= item[:part_number] %></code></td>
                            <td class="text-center"><%= item[:needed] %></td>
                            <td class="text-center <%= item[:available] == 0 ? 'text-danger fw-bold' : '' %>">
                              <%= item[:available] %>
                            </td>
                            <td class="text-center text-danger fw-bold">
                              <%= item[:shortfall] %>
                            </td>
                            <td class="text-center">
                              <span class="badge bg-<%= item[:stock_status_color] %>">
                                <%= item[:stock_status].humanize %>
                              </span>
                            </td>
                            <td class="text-end">
                              TTD <%= number_to_currency(item[:unit_price] || 0, unit: '') %>
                            </td>
                            <td class="text-center">
                              <div class="btn-group btn-group-sm" role="group">
                                <%= link_to "View Part", part_path(item[:part_id]), 
                                      class: "btn btn-outline-secondary",
                                      target: "_blank" %>
                                <% if current_user.agency&.code == 'VMCOTT' %>
                                  <%= link_to "Order #{item[:shortfall]}", 
                                        vmcott_inventory_create_purchase_request_path(item[:part_id], quantity: item[:shortfall]), 
                                        class: "btn btn-outline-primary",
                                        data: { turbo_method: :post } %>
                                <% end %>
                              </div>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                  
                  <!-- Bulk Actions -->
                  <div class="mt-3 d-flex justify-content-between align-items-center">
                    <div>
                      <small class="text-muted">
                        <i class="bi bi-lightbulb"></i>
                        Need all parts? Create purchase requests for all missing items.
                      </small>
                    </div>
                    <div>
                      <% if current_user.agency&.code == 'VMCOTT' %>
                        <%= link_to "Order All Missing Parts", 
                              "#", 
                              class: "btn btn-primary btn-sm bulk-order-btn",
                              data: { 
                                template_id: template.id,
                                template_name: template.name,
                                bs_toggle: "modal", 
                                bs_target: "#bulkOrderModal#{template.id}" 
                              } %>
                      <% end %>
                      
                      <%= link_to "Continue Anyway", 
                            "#", 
                            class: "btn btn-warning btn-sm ms-2",
                            data: { 
                              template_id: template.id,
                              template_name: template.name,
                              template_hours: template.standard_hours || 0,
                              template_rate: template.labor_rate_per_hour || 0,
                              bs_toggle: "modal", 
                              bs_target: "#forceAddModal#{template.id}" 
                            } %>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Bulk Order Modal -->
              <div class="modal fade" id="bulkOrderModal<%= template.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Order Missing Parts for <%= template.name %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <p>Create purchase requests for all missing parts in this template:</p>
                      
                      <ul class="list-group mb-3">
                        <% status[:unavailable_parts].each do |item| %>
                          <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                              <strong><%= item[:part_name] %></strong>
                              <div class="small text-muted">Part #: <%= item[:part_number] %></div>
                            </div>
                            <span class="badge bg-primary rounded-pill">
                              <%= item[:shortfall] %> units
                            </span>
                          </li>
                        <% end %>
                      </ul>
                      
                      <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Purchase requests will be created and sent to the procurement team for approval.
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <%= link_to "Confirm & Create Orders", 
                            create_bulk_purchase_requests_path(template_id: template.id),
                            class: "btn btn-primary",
                            data: { turbo_method: :post } %>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Force Add Modal -->
              <div class="modal fade" id="forceAddModal<%= template.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title text-warning">
                        <i class="bi bi-exclamation-triangle"></i> Add Template with Low Stock
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Inventory Warning:</strong> This template has 
                        <span class="badge bg-warning"><%= status[:unavailable_count] %> missing parts</span>.
                      </div>
                      
                      <p>Adding "<strong><%= template.name %></strong>" may cause delays as parts need to be ordered.</p>
                      
                      <div class="card border-warning mb-3">
                        <div class="card-body">
                          <h6 class="card-subtitle mb-2 text-muted">Missing Parts Summary:</h6>
                          <ul class="mb-0">
                            <% status[:unavailable_parts].first(3).each do |item| %>
                              <li><%= item[:part_name] %>: Need <%= item[:needed] %>, Have <%= item[:available] %></li>
                            <% end %>
                            <% if status[:unavailable_parts].count > 3 %>
                              <li>... and <%= status[:unavailable_parts].count - 3 %> more</li>
                            <% end %>
                          </ul>
                        </div>
                      </div>
                      
                      <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="acknowledgeWarning<%= template.id %>">
                        <label class="form-check-label" for="acknowledgeWarning<%= template.id %>">
                          I acknowledge that parts need to be ordered and this may delay the work
                        </label>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="button" 
                              class="btn btn-warning confirm-force-add-btn"
                              data-template-id="<%= template.id %>"
                              data-template-name="<%= template.name %>"
                              data-template-hours="<%= template.standard_hours || 0 %>"
                              data-template-rate="<%= template.labor_rate_per_hour || 0 %>"
                              disabled>
                        <i class="bi bi-check-circle"></i> Add with Warning
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> 
      No job templates available. 
      <%= link_to "Create job templates", new_job_template_path, class: "alert-link" %> 
      to get started.
    </div>
  <% end %>
</div>

<!-- Selected Jobs Panel -->
<div class="card mt-4 shadow" id="selected-jobs-card" style="display: none;">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">
      <i class="bi bi-list-check"></i> Selected Jobs
      <span class="badge bg-white text-primary ms-2" id="selected-jobs-count">0</span>
    </h5>
  </div>
  <div class="card-body">
    <div id="selected-jobs-list" class="mb-3"></div>
    
    <div class="d-flex justify-content-between align-items-center">
      <div class="text-muted small" id="selected-jobs-summary">
        <i class="bi bi-info-circle"></i> Add job templates above
      </div>
      
      <div>
        <button type="button" class="btn btn-secondary" id="clear-jobs-btn">
          <i class="bi bi-x-circle"></i> Clear All
        </button>
        <button type="button" class="btn btn-success ms-2" id="submit-jobs-btn">
          <i class="bi bi-check-circle"></i> Confirm Selection
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Hidden form for job assignments -->
<%= form_with url: update_jobs_quotation_path(@quotation), method: :patch, id: 'job-assignments-form' do |f| %>
  <%= f.hidden_field :job_assignments, id: 'job-assignments-data' %>
  <%= f.hidden_field :item_assignments, id: 'item-assignments-data' %>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl)
    });
    
    // Job management
    const addedJobs = [];
    const selectedJobsCard = document.getElementById('selected-jobs-card');
    const selectedJobsList = document.getElementById('selected-jobs-list');
    const selectedJobsCount = document.getElementById('selected-jobs-count');
    const selectedJobsSummary = document.getElementById('selected-jobs-summary');
    const jobAssignmentsData = document.getElementById('job-assignments-data');
    
    // Update selected jobs display
    function updateSelectedJobsDisplay() {
      const count = addedJobs.length;
      
      // Update count badge
      selectedJobsCount.textContent = count;
      
      if (count === 0) {
        selectedJobsCard.style.display = 'none';
        selectedJobsSummary.innerHTML = '<i class="bi bi-info-circle"></i> Add job templates above';
        return;
      }
      
      // Show card
      selectedJobsCard.style.display = 'block';
      
      // Calculate totals
      let totalHours = 0;
      let totalLaborCost = 0;
      
      addedJobs.forEach(job => {
        totalHours += job.hours;
        totalLaborCost += job.hours * job.rate;
      });
      
      // Update summary
      selectedJobsSummary.innerHTML = `
        <i class="bi bi-clock"></i> ${totalHours.toFixed(1)} total hours | 
        <i class="bi bi-cash"></i> TTD ${totalLaborCost.toFixed(2)} labor cost
      `;
      
      // Build jobs list
      let html = '<div class="list-group">';
      addedJobs.forEach((job, index) => {
        const laborCost = job.hours * job.rate;
        html += `
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong>${job.name}</strong>
              <div class="small text-muted">
                ${job.hours} hours @ TTD ${job.rate.toFixed(2)}/hr = TTD ${laborCost.toFixed(2)}
              </div>
              ${job.lowStockWarning ? '<span class="badge bg-warning small mt-1">Low Stock Warning</span>' : ''}
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger remove-job-btn" 
                    data-index="${index}" title="Remove job">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        `;
      });
      html += '</div>';
      
      selectedJobsList.innerHTML = html;
      
      // Add event listeners to remove buttons
      document.querySelectorAll('.remove-job-btn').forEach(button => {
        button.addEventListener('click', function() {
          const index = parseInt(this.dataset.index);
          const removedJob = addedJobs.splice(index, 1)[0];
          
          // Re-enable the add button for this template
          const addBtn = document.querySelector(`.add-template-btn[data-template-id="${removedJob.template_id}"]`);
          if (addBtn) {
            addBtn.disabled = false;
            addBtn.innerHTML = '<i class="bi bi-plus-circle"></i> Add';
            addBtn.classList.remove('btn-success');
            addBtn.classList.add('btn-outline-primary');
          }
          
          updateSelectedJobsDisplay();
          updateJobAssignmentsField();
        });
      });
    }
    
    // Update hidden field
    function updateJobAssignmentsField() {
      jobAssignmentsData.value = JSON.stringify(addedJobs);
    }
    
    // Add template button handler
    document.querySelectorAll('.add-template-btn').forEach(button => {
      button.addEventListener('click', function() {
        addTemplateToQuotation(this.dataset, false);
      });
    });
    
    // Add anyway button handler
    document.querySelectorAll('.add-anyway-btn').forEach(button => {
      button.addEventListener('click', function() {
        // Show the force add modal
        const modal = new bootstrap.Modal(document.getElementById(`forceAddModal${this.dataset.templateId}`));
        modal.show();
      });
    });
    
    // Confirm force add button handler
    document.querySelectorAll('.confirm-force-add-btn').forEach(button => {
      button.addEventListener('click', function() {
        const templateId = this.dataset.templateId;
        const modal = bootstrap.Modal.getInstance(this.closest('.modal'));
        
        // Close modal
        modal.hide();
        
        // Add template
        addTemplateToQuotation(this.dataset, true);
      });
    });
    
    // Enable/disable confirm button based on checkbox
    document.querySelectorAll('[id^="acknowledgeWarning"]').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const templateId = this.id.replace('acknowledgeWarning', '');
        const confirmBtn = document.querySelector(`.confirm-force-add-btn[data-template-id="${templateId}"]`);
        
        if (confirmBtn) {
          confirmBtn.disabled = !this.checked;
        }
      });
    });
    
    // Function to add template to quotation
    function addTemplateToQuotation(templateData, isLowStock = false) {
      const templateId = templateData.templateId;
      const templateName = templateData.templateName;
      const templateHours = parseFloat(templateData.templateHours);
      const templateRate = parseFloat(templateData.templateRate);
      
      // Check if already added
      if (addedJobs.some(job => job.template_id === templateId)) {
        showToast(`"${templateName}" is already added to the quotation.`, 'warning');
        return;
      }
      
      // Add to jobs array
      addedJobs.push({
        template_id: templateId,
        name: templateName,
        hours: templateHours,
        rate: templateRate,
        description: `Job template: ${templateName}`,
        lowStockWarning: isLowStock
      });
      
      // Update UI
      updateSelectedJobsDisplay();
      updateJobAssignmentsField();
      
      // Update button state
      const addBtn = document.querySelector(`.add-template-btn[data-template-id="${templateId}"]`);
      if (addBtn) {
        addBtn.disabled = true;
        addBtn.innerHTML = '<i class="bi bi-check-circle"></i> Added';
        addBtn.classList.remove('btn-success', 'btn-outline-primary');
        addBtn.classList.add('btn-outline-success');
      }
      
      // Show success message
      const message = isLowStock 
        ? `"${templateName}" added with low stock warning. Please ensure parts are ordered.`
        : `"${templateName}" added to quotation.`;
      
      showToast(message, isLowStock ? 'warning' : 'success');
    }
    
    // Submit jobs button
    document.getElementById('submit-jobs-btn')?.addEventListener('click', function() {
      if (addedJobs.length === 0) {
        showToast('Please add at least one job template to the quotation.', 'danger');
        return;
      }
      
      // Check for low stock warnings
      const lowStockJobs = addedJobs.filter(job => job.lowStockWarning);
      if (lowStockJobs.length > 0) {
        if (!confirm(`${lowStockJobs.length} jobs have low stock warnings. Are you sure you want to continue?`)) {
          return;
        }
      }
      
      document.getElementById('job-assignments-form').submit();
    });
    
    // Clear jobs button
    document.getElementById('clear-jobs-btn')?.addEventListener('click', function() {
      if (addedJobs.length === 0) {
        showToast('No jobs to clear.', 'info');
        return;
      }
      
      if (confirm(`Clear all ${addedJobs.length} selected jobs?`)) {
        addedJobs.length = 0;
        updateSelectedJobsDisplay();
        updateJobAssignmentsField();
        
        // Reset all add buttons
        document.querySelectorAll('.add-template-btn').forEach(button => {
          button.disabled = false;
          button.innerHTML = '<i class="bi bi-plus-circle"></i> Add';
          button.classList.remove('btn-outline-success');
          button.classList.add('btn-outline-primary');
        });
        
        showToast('All jobs cleared.', 'success');
      }
    });
    
    // Toast notification function
    function showToast(message, type = 'info') {
      // Create toast element
      const toastId = 'toast-' + Date.now();
      const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert">
          <div class="d-flex">
            <div class="toast-body">
              ${message}
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
          </div>
        </div>
      `;
      
      // Add to container
      const toastContainer = document.getElementById('toast-container') || createToastContainer();
      toastContainer.insertAdjacentHTML('beforeend', toastHtml);
      
      // Show toast
      const toastElement = document.getElementById(toastId);
      const toast = new bootstrap.Toast(toastElement, { delay: 3000 });
      toast.show();
      
      // Remove after hide
      toastElement.addEventListener('hidden.bs.toast', function () {
        this.remove();
      });
    }
    
    function createToastContainer() {
      const container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
      container.style.zIndex = '1060';
      document.body.appendChild(container);
      return container;
    }
    
    // Initial update
    updateSelectedJobsDisplay();
  });
</script>

