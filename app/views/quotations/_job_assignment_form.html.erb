<%# app/views/quotations/_job_assignment_form.html.erb %>
<div class="job-assignment-container">
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Job Assignment for Quotation</h5>
    </div>
    <div class="card-body">
      <!-- Job Templates Selection -->
      <div class="mb-4">
        <h6>Select Job Templates</h6>
        <div class="row">
          <% @job_templates.each do |template| %>
            <div class="col-md-4 mb-3">
              <div class="card job-template-card" data-template-id="<%= template.id %>">
                <div class="card-body">
                  <div class="form-check">
                    <%= check_box_tag "selected_jobs[]", template.id, false, 
                          class: 'form-check-input job-template-checkbox',
                          id: "job_template_#{template.id}",
                          data: {
                            name: template.name,
                            hours: template.standard_hours,
                            rate: template.labor_rate_per_hour,
                            description: template.description
                          } %>
                    <%= label_tag "job_template_#{template.id}", template.name, class: 'form-check-label' %>
                  </div>
                  <small class="text-muted">
                    <%= template.description.truncate(50) %><br>
                    <%= template.standard_hours %> hrs @ $<%= template.labor_rate_per_hour %>/hr
                  </small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Assigned Jobs Table -->
      <div class="mb-4">
        <h6>Assigned Jobs</h6>
        <table class="table table-bordered" id="assigned-jobs-table">
          <thead>
            <tr>
              <th>Job Name</th>
              <th>Hours</th>
              <th>Rate/Hour</th>
              <th>Labor Cost</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="assigned-jobs-body">
            <!-- Will be populated by JavaScript -->
          </tbody>
          <tfoot>
            <tr>
              <th colspan="3" class="text-end">Total Labor Cost:</th>
              <th id="total-labor-cost">$0.00</th>
              <th></th>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Line Items Assignment -->
      <div class="mb-4">
        <h6>Assign RFQ Items to Jobs</h6>
        <% if @rfq&.rfq_line_items&.any? %>
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Specifications</th>
                <th>Assign to Job</th>
              </tr>
            </thead>
            <tbody>
              <% @rfq.rfq_line_items.each do |item| %>
                <tr>
                  <td><%= item.description %></td>
                  <td><%= item.quantity %></td>
                  <td><small class="text-muted"><%= item.specifications %></small></td>
                  <td>
                    <select class="form-select form-select-sm item-job-select" 
                            data-item-id="<%= item.id %>">
                      <option value="">-- Not Assigned --</option>
                      <option value="standalone">Standalone Item</option>
                      <!-- Jobs will be added by JavaScript -->
                    </select>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted">No RFQ items to assign.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= hidden_field_tag :assigned_jobs_json, '', id: 'assigned-jobs-json' %>
<%= hidden_field_tag :item_assignments_json, '', id: 'item-assignments-json' %>