<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-md-12">

      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
          <h4 class="mb-0">
            <i class="bi bi-wrench"></i> Assign Jobs to Quotation
          </h4>
          <span class="badge bg-light text-dark">
            Quote: <%= @quotation.quote_number %>
          </span>
        </div>

        <div class="card-body">

          <!-- INFO -->
          <div class="alert alert-info">
            <strong>Optional step.</strong>
            Assign job templates that match the vehicle.
            You may continue without selecting any jobs.
          </div>

          <!-- VEHICLE -->
          <div class="mb-3 text-muted">
            <strong>Vehicle:</strong>
            <%= @vehicle&.year_of_manufacture %>
            <%= @vehicle&.make %>
            <%= @vehicle&.model %>
          </div>

          <!-- JOB TEMPLATES -->
          <div class="row">

            <% if @job_templates.any? %>
              <% @job_templates.each do |template| %>
                <% inventory = template.inventory_status %>
                <% can_use = inventory[:can_fulfill] %>

                <div class="col-md-6 mb-4">
                  <div class="card h-100 <%= can_use ? '' : 'border-danger opacity-75' %>">

                    <div class="card-body">

                      <!-- HEADER -->
                      <div class="form-check mb-2">
                        <%= check_box_tag(
                              'job_assignments[]',
                              template.id,
                              false,
                              class: 'form-check-input',
                              disabled: !can_use
                            ) %>
                        <%= label_tag nil, template.name, class: 'fw-bold' %>
                      </div>

                      <p class="text-muted mb-2">
                        <%= template.description.presence || 'No description' %>
                      </p>

                      <div class="small mb-3">
                        ⏱ <%= template.standard_hours %> hrs |
                        💲 <%= number_to_currency(template.labor_rate_per_hour) %>/hr
                      </div>

                      <!-- PARTS MODAL TRIGGER -->
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#partsModal_<%= template.id %>">
                        View Included Parts
                      </button>

                      <!-- OUT OF STOCK -->
                      <% unless can_use %>
                        <div class="alert alert-warning mt-3 small">
                          <strong>Out of stock.</strong>
                          Required parts are missing.
                        </div>

                        <%= link_to(
                              'Create Purchase Request',
                              create_purchase_request_quotation_path(@quotation),
                              method: :post,
                              class: 'btn btn-sm btn-outline-danger'
                            ) %>
                      <% end %>

                    </div>
                  </div>
                </div>

                <!-- PARTS MODAL -->
                <div class="modal fade"
                     id="partsModal_<%= template.id %>"
                     tabindex="-1"
                     aria-hidden="true">
                  <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">

                      <div class="modal-header">
                        <h5 class="modal-title">
                          Included Parts – <%= template.name %>
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>
                      </div>

                      <div class="modal-body">

                        <% if inventory[:parts].any? %>
                          <table class="table table-sm">
                            <thead>
                              <tr>
                                <th>Part</th>
                                <th>Required</th>
                                <th>Available</th>
                                <th>Status</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% inventory[:parts].each do |p| %>
                                <tr>
                                  <td><%= p[:name] %></td>
                                  <td><%= p[:required] %></td>
                                  <td><%= p[:available] %></td>
                                  <td>
                                    <% if p[:available] >= p[:required] %>
                                      <span class="badge bg-success">
                                        In Stock
                                      </span>
                                    <% else %>
                                      <span class="badge bg-danger">
                                        Short <%= p[:required] - p[:available] %>
                                      </span>
                                    <% end %>
                                  </td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        <% else %>
                          <p class="text-muted">
                            This job template does not require any parts.
                          </p>
                        <% end %>

                      </div>

                      <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                          Close
                        </button>
                      </div>

                    </div>
                  </div>
                </div>

              <% end %>
            <% else %>
              <div class="col-12">
                <div class="alert alert-warning">
                  No job templates match this vehicle.
                  You may continue without assigning jobs.
                </div>
              </div>
            <% end %>

          </div>
        </div>

        <!-- FOOTER -->
        <div class="card-footer d-flex justify-content-between">
          <%= link_to 'Cancel',
                vmcott_rfq_inbox_path,
                class: 'btn btn-secondary' %>

          <%= form_with(
                url: update_jobs_quotation_path(@quotation),
                method: :patch
              ) do %>
            <%= submit_tag(
                  'Continue to Pricing',
                  class: 'btn btn-primary btn-lg'
                ) %>
          <% end %>
        </div>

      </div>

    </div>
  </div>
</div>
