<!-- JavaScript for Trinidad Government Quotation Form with Inventory Parts Integration -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log("Quotation form JavaScript loaded - WITH INVENTORY PARTS");
  
  const vatRate = 0.125; // 12.5% VAT for Trinidad and Tobago
  const currencySymbol = '$'; // TTD
  
  // Format currency with Trinidad formatting
  function formatCurrency(amount) {
    return currencySymbol + amount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
  }
  
  // Store selected jobs
  const selectedJobs = new Map();
  let jobCounter = 0;
  
  // Store selected parts
  const selectedParts = new Map();
  let partCounter = 0;
  
  // Store custom items
  const customItems = new Map();
  let customItemCounter = 0;
  
  // Check if quotation is sent
  const quotationSent = <%= @quotation.sent?.to_json || false %>;
  
  // Initialize with existing jobs from the form
  const existingJobRows = document.querySelectorAll('.job-row');
  existingJobRows.forEach((row, index) => {
    const jobIndex = index;
    const nameInput = row.querySelector('input[name*="name"]');
    const descInput = row.querySelector('textarea[name*="description"]');
    const hoursInput = row.querySelector('input[name*="estimated_hours"]');
    const rateInput = row.querySelector('input[name*="labor_rate_per_hour"]');
    const templateId = row.getAttribute('data-template-id');
    
    if (nameInput && nameInput.value) {
      selectedJobs.set(jobIndex, {
        name: nameInput.value,
        description: descInput?.value || '',
        hours: parseFloat(hoursInput?.value || 1),
        rate: parseFloat(rateInput?.value || 100),
        templateId: templateId,
        row: row
      });
      jobCounter = Math.max(jobCounter, jobIndex + 1);
    }
  });
  
  // Update selected jobs display
  function updateSelectedJobsDisplay() {
    const selectedJobsList = document.getElementById('selected-jobs-list');
    const noJobsMessage = document.getElementById('no-jobs-message');
    const selectedJobsCount = document.getElementById('selected-jobs-count');
    
    if (!selectedJobsList) {
      console.error("Selected jobs list not found!");
      return;
    }
    
    // Clear the list
    selectedJobsList.innerHTML = '';
    
    if (selectedJobs.size === 0) {
      if (noJobsMessage) {
        noJobsMessage.style.display = 'block';
      } else {
        selectedJobsList.innerHTML = '<p class="text-muted text-center mb-0"><i class="fas fa-info-circle"></i> No jobs selected yet. Select jobs from the left panel.</p>';
      }
      if (selectedJobsCount) selectedJobsCount.textContent = '0';
      return;
    }
    
    
    if (noJobsMessage) {
      noJobsMessage.style.display = 'none';
    }
    
    if (selectedJobsCount) selectedJobsCount.textContent = selectedJobs.size;
    
    // Add each selected job
    selectedJobs.forEach((job, index) => {
      const jobItem = document.createElement('div');
      jobItem.className = 'job-item mb-2 p-2 border rounded';
      jobItem.setAttribute('data-job-index', index);
      
      // Calculate total for this job
      const jobTotal = (job.hours * job.rate).toFixed(2);
      
      jobItem.innerHTML = `
        <div class="job-header d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <strong>${job.name}</strong>
            ${job.templateId ? '<span class="badge bg-info ms-2">Template</span>' : ''}
          </div>
          ${!quotationSent ? `
          <button type="button" class="btn btn-sm btn-danger remove-selected-job-btn" data-index="${index}" title="Remove job" style="min-width: 28px; padding: 4px 8px; cursor: pointer; z-index: 100; position: relative;">
            <span style="font-size: 12px; pointer-events: none;">✕</span>
          </button>
          ` : ''}
        </div>
        <div class="job-details">
          <small class="text-muted d-block">${job.description || 'No description'}</small>
          <div class="mt-1 d-flex justify-content-between">
            <div>
              <small><i class="fas fa-clock"></i> ${job.hours} hrs</small> | 
              <small><i class="fas fa-dollar-sign"></i> ${job.rate}/hr</small>
            </div>
            <div>
              <small><strong>Total: ${formatCurrency(job.hours * job.rate)}</strong></small>
            </div>
