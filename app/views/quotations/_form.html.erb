<%# app/views/quotations/_form.html.erb - VMCOTT WITH TRINIDAD GOVERNMENT STYLING (WITH JOB TEMPLATE INTEGRATION) %>
<%= form_with model: @quotation, local: true, class: 'tt-vmcott-quotation-form' do |f| %>
  <% if @quotation.errors.any? %>
    <div class="alert alert-danger gov-alert-danger">
      <h4><i class="fas fa-exclamation-triangle"></i> <%= pluralize(@quotation.errors.count, "error") %> prohibited this quotation from being saved:</h4>
      <ul class="mb-0">
        <% @quotation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Header Section - Trinidad Government & VMCOTT -->
  <div class="form-header mb-4" style="background: linear-gradient(135deg, #DA291C 0%, #B31B2E 100%); border: 2px solid #990000;">
    <div class="row align-items-center">
      <div class="col-md-2 text-center">
        <div class="trinidad-logo">
          <div class="logo-circle" style="background: white; color: #DA291C; border: 3px solid #FFCC00;">
            <i class="fas fa-tools fa-2x"></i>
          </div>
          <small style="color: white; font-weight: 500;">Republic of Trinidad and Tobago</small>
          <div class="ministry-badge">
            <span style="color: #FFCC00; font-weight: bold;">VMCOTT</span>
          </div>
        </div>
      </div>
      <div class="col-md-8 text-center">
        <div class="national-emblem">
          <h1 class="form-title" style="color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
            <i class="fas fa-file-invoice-dollar"></i> OFFICIAL QUOTATION
          </h1>
          <h3 class="form-subtitle" style="color: #FFCC00; font-weight: 600;">
            VEHICLE MANAGEMENT COMPANY OF TRINIDAD & TOBAGO
          </h3>
          <div class="document-details">
            <div class="badge-grp">
              <span class="document-badge" style="background: rgba(255,255,255,0.2);">
                <i class="fas fa-hashtag"></i> RFQ#: <%= @rfq&.rfq_number || 'N/A' %>
              </span>
              <span class="document-badge" style="background: rgba(255,255,255,0.2);">
                <i class="fas fa-file-alt"></i> QTN#: <%= @quotation.quote_number || 'Auto-generated' %>
              </span>
              <span class="document-badge" style="background: rgba(255,204,0,0.3); color: #FFCC00;">
                <i class="fas fa-building"></i> <%= @rfq&.requesting_agency&.code || 'AGENCY' %>
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2 text-center">
        <div class="document-stamp" style="background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(248,249,250,0.95) 100%);">
          <div class="stamp-header" style="background: #DA291C; color: white; padding: 8px; border-radius: 4px 4px 0 0;">
            <strong><i class="fas fa-calendar-check"></i> VALID UNTIL</strong>
          </div>
          <div class="stamp-body" style="padding: 15px;">
            <div class="date-display" style="color: #DA291C; font-weight: bold; font-size: 1.2em;">
              <%= @quotation.valid_to&.strftime('%d/%m/%Y') || (Date.today + 30.days).strftime('%d/%m/%Y') %>
            </div>
            <small style="color: #666;">(30 days from quote)</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Form Section -->
  <div class="form-body">
    <!-- Section 1: Basic Information - Government Format -->
    <div class="form-section mb-4 gov-section">
      <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #DA291C; border-bottom: 2px solid #dee2e6;">
        <h4 style="color: #2c3e50; font-weight: 700;">
          <i class="fas fa-info-circle me-2" style="color: #DA291C;"></i>SECTION 1: QUOTATION DETAILS
        </h4>
        <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
          Government of Trinidad and Tobago - Standard Quotation Format
        </p>
      </div>
      <div class="section-body">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group mb-3">
              <label class="form-label gov-label">
                <i class="fas fa-building me-1"></i> CONTRACTING PARTY
              </label>
              <div class="gov-input-display" style="background: #e9ecef; padding: 10px; border-radius: 4px; border-left: 4px solid #DA291C;">
                <strong>VMCOTT</strong> - Vehicle Management Company of Trinidad and Tobago
                <br><small class="text-muted">Official Government Vehicle Services Provider</small>
              </div>
            </div>
          </div>
          
          <!-- VEHICLE SEARCH SECTION - REPLACED DROPDOWN WITH SEARCH -->
          <div class="col-md-4">
            <div class="form-group mb-3 position-relative">
              <%= f.label :vehicle_id, "VEHICLE DETAILS", class: 'form-label gov-label' %>
              
              <% if @quotation.vehicle.present? && !@quotation.sent? %>
                <!-- Already selected vehicle - show with option to change -->
                <div class="gov-input-display d-flex justify-content-between align-items-center" style="background: #e9ecef; padding: 10px; border-radius: 4px; border-left: 4px solid #28a745;">
                  <div>
                    <strong><%= @quotation.vehicle.license_plate %></strong> | 
                    <%= @quotation.vehicle.make %> <%= @quotation.vehicle.model %>
                    <br><small class="text-muted">
                      <i class="fas fa-building me-1"></i> <%= @quotation.vehicle.agency&.code %>
                      <% if @quotation.vehicle.year_of_manufacture.present? %>
                        • <%= @quotation.vehicle.year_of_manufacture %>
                      <% end %>
                    </small>
                  </div>
                  <button type="button" 
                          class="btn btn-sm btn-outline-danger change-vehicle-btn"
                          data-action="click->quotation-vehicle-search#clearVehicle"
                          style="border-radius: 20px;">
                    <i class="bi bi-x"></i> Change
                  </button>
                </div>
                <%= f.hidden_field :vehicle_id, value: @quotation.vehicle.id, data: { quotation_vehicle_search_target: "vehicleHidden" } %>
                
              <% elsif @quotation.sent? && @quotation.vehicle.present? %>
                <!-- Sent quotation - display only, no search -->
                <div class="gov-input-display" style="background: #e9ecef; padding: 10px; border-radius: 4px; border-left: 4px solid #28a745;">
                  <strong><%= @quotation.vehicle.license_plate %></strong> | 
                  <%= @quotation.vehicle.make %> <%= @quotation.vehicle.model %>
                  <br><small class="text-muted">
                    <i class="fas fa-building me-1"></i> <%= @quotation.vehicle.agency&.code %>
                    <% if @quotation.vehicle.year_of_manufacture.present? %>
                      • <%= @quotation.vehicle.year_of_manufacture %>
                    <% end %>
                  </small>
                </div>
                <%= f.hidden_field :vehicle_id, value: @quotation.vehicle.id %>
              <% else %>
                <!-- Wrap everything in a div with the controller -->
                <div data-controller="quotation-vehicle-search">
                  <!-- Vehicle search input -->
                  <input type="text"
                        class="form-control gov-input"
                        placeholder="Search by license plate, make, or model..."
                        autocomplete="off"
                        data-quotation-vehicle-search-target="vehicleInput"
                        data-action="input->quotation-vehicle-search#vehicleInput"
                        data-search-url="<%= search_vehicles_path(format: :json) %>">

                  <%= f.hidden_field :vehicle_id, data: { quotation_vehicle_search_target: "vehicleHidden" } %>

                  <!-- Dropdown results -->
                  <div class="list-group position-absolute w-100 shadow"
                      style="z-index: 1055; display:none; max-height: 250px; overflow-y: auto;"
                      data-quotation-vehicle-search-target="vehicleResults">
                    <div data-quotation-vehicle-search-target="vehicleList"></div>
                  </div>

                  <!-- Selected chip (hidden until selection) -->
                  <div class="mt-2" style="display:none;" data-quotation-vehicle-search-target="vehicleSelected">
                    <div class="alert alert-info py-2 mb-0 d-flex justify-content-between align-items-center">
                      <div>
                        <i class="bi bi-car-front me-2"></i>
                        <span data-quotation-vehicle-search-target="vehicleSelectedText"></span>
                      </div>
                      <button type="button"
                              class="btn btn-sm btn-outline-danger"
                              data-action="click->quotation-vehicle-search#clearVehicle">
                        <i class="bi bi-x"></i>
                      </button>
                    </div>
                  </div>
                </div>
              <% end %>
              <small class="form-text text-muted">
                <i class="fas fa-car"></i> RFQ Reference: <%= @rfq&.vehicle&.license_plate || 'Not specified' %>
                <br>
                <i class="fas fa-building"></i> Search across <strong>ALL agencies</strong>
              </small>
            </div>
          </div>         
          <div class="col-md-4">
            <div class="form-group mb-3">
              <label class="form-label gov-label">
                <i class="fas fa-university me-1"></i> REQUESTING AGENCY
              </label>
              <div class="gov-input-display" style="background: #e9ecef; padding: 10px; border-radius: 4px; border-left: 4px solid #007bff;">
                <strong><%= @rfq&.requesting_agency&.code || 'AGENCY' %></strong>
                <br><%= @rfq&.requesting_agency&.name || 'Government Agency' %>
              </div>
            </div>
          </div>
        </div>
        
        <div class="row">
          <div class="col-md-3">
            <div class="form-group mb-3">
              <%= f.label :valid_from, "QUOTATION DATE", class: 'form-label gov-label required' %>
              <div class="input-group">
                <span class="input-group-text gov-input-prefix"><i class="fas fa-calendar-alt"></i></span>
                <%= f.date_field :valid_from, class: 'form-control gov-date-input', required: true, 
                      value: @quotation.valid_from || Date.today, min: Date.today, max: 1.year.from_now.to_date,
                      disabled: @quotation.sent? %>
              </div>
            </div>
          </div>
          
          <div class="col-md-3">
            <div class="form-group mb-3">
              <%= f.label :valid_to, "VALIDITY PERIOD", class: 'form-label gov-label required' %>
              <div class="input-group">
                <span class="input-group-text gov-input-prefix"><i class="fas fa-clock"></i></span>
                <%= f.date_field :valid_to, class: 'form-control gov-date-input', required: true, 
                      value: @quotation.valid_to || (Date.today + 30.days), min: Date.tomorrow, max: 2.years.from_now.to_date,
                      disabled: @quotation.sent? %>
              </div>
              <small class="form-text text-muted">Standard: 30 days from quotation date</small>
            </div>
          </div>
          
          <div class="col-md-3">
            <div class="form-group mb-3">
              <%= f.label :quote_number, "QUOTATION NUMBER", class: 'form-label gov-label required' %>
              <div class="input-group">
                <span class="input-group-text gov-input-prefix"><i class="fas fa-hashtag"></i></span>
                <%= f.text_field :quote_number, class: 'form-control gov-input', required: true,
                      value: @quotation.quote_number || "VMC-QTN-#{Time.now.strftime('%Y%m%d')}-#{SecureRandom.hex(3).upcase}",
                      pattern: '^[A-Z0-9-]{5,}$', title: 'Format: VMC-QTN-YYYYMMDD-XXX',
                      disabled: @quotation.sent? %>
              </div>
              <small class="form-text text-muted">Format: VMC-QTN-YYYYMMDD-XXX</small>
            </div>
          </div>
          
          <div class="col-md-3">
            <div class="form-group mb-3">
              <label class="form-label gov-label">
                <i class="fas fa-money-bill-wave"></i> TOTAL QUOTED AMOUNT
              </label>
              <div class="input-group">
                <span class="input-group-text gov-currency" style="background: #28a745; color: white; font-weight: bold;">TTD</span>
                <input type="text" id="total-amount-display" class="form-control gov-total-input" 
                       value="<%= number_to_currency(@quotation.amount || 0, unit: '$') %>" readonly
                       style="font-weight: bold; font-size: 1.1em; background: #f8f9fa;">
              </div>
              <small class="form-text text-muted">Including VAT 12.5% • Calculated automatically</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- NEW SECTION: Job Template Selection (For VMCOTT only) -->
    <% if current_user.agency&.code == 'VMCOTT' && @labor_job_templates.present? && !@quotation.sent? %>
      <div class="form-section mb-4 gov-section">
        <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #ff6b35; border-bottom: 2px solid #dee2e6;">
          <h4 style="color: #2c3e50; font-weight: 700;">
            <i class="fas fa-clipboard-list me-2" style="color: #ff6b35;"></i>SECTION 1.2: SELECT JOB TEMPLATES
          </h4>
          <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
            Select standard job templates to add to this quotation
          </p>
        </div>
        <div class="section-body">
          <div class="row">
            <!-- Job Templates Selection Panel -->
            <div class="col-md-5">
              <div class="job-templates-panel gov-terms-box">
                <h6 style="color: #ff6b35; font-weight: 600;">
                  <i class="fas fa-tools me-2"></i>AVAILABLE JOB TEMPLATES
                </h6>
                <div class="job-templates-list" style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px;">
                  <% @labor_job_templates.each do |template| %>
                    <div class="template-card mb-2 p-2 border rounded" 
                         data-template-id="<%= template.id %>"
                         data-template-name="<%= template.name %>"
                         data-template-description="<%= template.description %>"
                         data-template-hours="<%= template.standard_hours || 1 %>"
                         data-template-rate="<%= template.labor_rate_per_hour || 100 %>"
                         data-template-total="<%= (template.standard_hours || 1) * (template.labor_rate_per_hour || 100) %>"
                         style="cursor: pointer; transition: background-color 0.2s;">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <strong><%= template.name %></strong>
                          <% if template.category.present? %>
                            <span class="badge bg-secondary ms-2"><%= template.category %></span>
                          <% end %>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary add-template-btn" data-template-id="<%= template.id %>">
                          <i class="fas fa-plus"></i> Add
                        </button>
                      </div>
                      <small class="text-muted d-block"><%= truncate(template.description, length: 80) %></small>
                      <div class="template-details">
                        <small class="text-muted">
                          <i class="fas fa-clock"></i> <%= template.standard_hours || 'N/A' %> hours • 
                          <i class="fas fa-dollar-sign"></i> <%= number_to_currency(template.labor_rate_per_hour || 0) %>/hr
                        </small>
                      </div>
                    </div>
                  <% end %>
                </div>
                <small class="text-muted mt-2 d-block">
                  <i class="fas fa-info-circle"></i> Click "Add" to add job to quotation
                </small>
              </div>
            </div>
            
           <!-- Selected Jobs Preview -->
            <div class="col-md-7">
              <div class="selected-jobs-panel">
                <h6 style="color: #28a745; font-weight: 600;">
                  <i class="fas fa-clipboard-check me-2"></i>SELECTED JOBS
                  <span class="badge bg-primary float-end" id="selected-jobs-count">0</span>
                </h6>
                <div id="selected-jobs-list" class="selected-jobs-list" style="min-height: 200px; border: 1px solid #dee2e6; border-radius: 4px; padding: 15px; background: #f8f9fa;">
                  <p class="text-muted text-center mb-0" id="no-jobs-message">
                    <i class="fas fa-info-circle"></i> No jobs selected yet. Select jobs from the left panel.
                  </p>
                </div>
                
                <div class="mt-3">
                  <div class="alert alert-info gov-alert-info">
                    <i class="fas fa-lightbulb me-2"></i>
                    <strong>How it works:</strong> Selected jobs will be added as labor items to the quotation. 
                    You can adjust hours and rates for each job as needed.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Section 1.5: Assigned Jobs Information -->
    <!-- ALWAYS SHOW THIS SECTION -->
    <div class="form-section mb-4 gov-section" id="jobs-section">
      <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #3949ab; border-bottom: 2px solid #dee2e6;">
        <h4 style="color: #2c3e50; font-weight: 700;">
          <i class="fas fa-tasks me-2" style="color: #3949ab;"></i>SECTION 1.5: ASSIGNED JOBS
        </h4>
        <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
          Labor jobs assigned to this quotation
        </p>
      </div>
      <div class="section-body">
        <div class="table-responsive">
          <table class="table gov-pricing-table">
            <thead>
              <tr class="table-header">
                <th width="20%" style="background: #3949ab; color: white;">Job Name</th>
                <th width="35%" style="background: #3949ab; color: white;">Description</th>
                <th width="10%" class="text-center" style="background: #3949ab; color: white;">Hours</th>
                <th width="15%" class="text-center" style="background: #3949ab; color: white;">Rate/Hour</th>
                <th width="15%" class="text-center" style="background: #28a745; color: white;">Labor Cost</th>
                <th width="5%" class="text-center" style="background: #dc3545; color: white;">Actions</th>
              </tr>
            </thead>
            <tbody id="job-table-body">
              <%= f.fields_for :quotation_jobs do |job| %>
                <tr class="gov-table-row job-row" data-job-index="<%= job.index %>" data-template-id="<%= job.object.job_template_id %>">
                  <td style="background: #f8f9fa;">
                    <div class="job-name-field">
                      <% if job.object.persisted? %>
                        <strong><%= job.object.name %></strong>
                        <%= job.hidden_field :name %>
                      <% else %>
                        <%= job.text_field :name, class: 'form-control gov-input', placeholder: "Job Name", required: true,
                              disabled: @quotation.sent? %>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <div class="job-description-field">
                      <% if job.object.persisted? %>
                        <%= job.object.description %>
                        <%= job.hidden_field :description %>
                      <% else %>
                        <%= job.text_area :description, class: 'form-control gov-textarea', rows: 1, placeholder: "Job Description",
                              disabled: @quotation.sent? %>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-center">
                    <div class="job-hours-field">
                      <% if job.object.persisted? %>
                        <%= job.object.estimated_hours %>
                        <%= job.hidden_field :estimated_hours %>
                      <% else %>
                        <%= job.number_field :estimated_hours, class: 'form-control gov-input', step: '0.25', min: '0.25', 
                              value: job.object.estimated_hours || 1, disabled: @quotation.sent? %>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-center">
                    <div class="job-rate-field">
                      <% if job.object.persisted? %>
                        <%= number_to_currency(job.object.labor_rate_per_hour) %>
                        <%= job.hidden_field :labor_rate_per_hour %>
                      <% else %>
                        <div class="input-group input-group-sm">
                          <span class="input-group-text gov-currency-sm">$</span>
                          <%= job.number_field :labor_rate_per_hour, class: 'form-control form-control-sm', step: '0.01', min: '0', 
                                value: job.object.labor_rate_per_hour || 100, disabled: @quotation.sent? %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-center" style="font-weight: bold; color: #28a745;">
                    <div class="job-total-field">
                      <% if job.object.persisted? %>
                        <%= number_to_currency(job.object.total_labor_cost || 0) %>
                      <% else %>
                        <span class="job-total-amount">
                          $<%= ((job.object.estimated_hours || 1) * (job.object.labor_rate_per_hour || 100)).to_f.round(2) %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-center">
                    <% unless job.object.persisted? && !@quotation.sent? %>
                      <button type="button" class="btn btn-sm btn-danger remove-job-from-table-btn" data-job-index="<%= job.index %>"
                              <%= 'disabled' if @quotation.sent? %>>
                        <span style="font-size: 14px; pointer-events: none;">✕</span>
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              
              <!-- Show empty message if no jobs exist -->
              <% if @quotation.quotation_jobs.empty? %>
                <tr id="no-jobs-row">
                  <td colspan="6" class="text-center text-muted py-4">
                    <i class="fas fa-info-circle me-2"></i>
                    No jobs added yet. Select jobs from the template panel above.
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot id="job-total-footer" style="<%= @quotation.quotation_jobs.any? ? '' : 'display: none;' %>">
              <tr class="table-footer-grandtotal">
                <td colspan="4" class="text-end" style="background: linear-gradient(135deg, #3949ab 0%, #283593 100%); color: white; font-weight: bold; font-size: 1.1em;">
                  <i class="fas fa-tools me-2"></i>TOTAL LABOR COST:
                </td>
                <td id="total-labor-cost" class="text-center" style="background: linear-gradient(135deg, #3949ab 0%, #283593 100%); color: white; font-weight: bold; font-size: 1.2em;">
                  <%= number_to_currency(@quotation.quotation_jobs.sum { |job| job.total_labor_cost.to_f }) %>
                </td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
        
        <div class="calculation-note mt-3">
          <div class="alert alert-info gov-alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Note:</strong> Labor costs shown above are already included in the total quotation amount.
            <br>
            <small class="text-muted">This section provides transparency on labor breakdown for the assigned jobs.</small>
          </div>
        </div>
      </div>
    </div>
    <!-- END OF JOBS SECTION -->

    <!-- Section 2: Inventory Parts for Quotation - UPDATED TO USE INVENTORY PARTS -->
    <% if !@quotation.sent? %>
      <div class="form-section mb-4 gov-section">
        <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #28a745; border-bottom: 2px solid #dee2e6;">
          <h4 style="color: #2c3e50; font-weight: 700;">
            <i class="fas fa-boxes me-2" style="color: #28a745;"></i>SECTION 2: PARTS FROM INVENTORY
          </h4>
          <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
            Select parts from inventory to include in this quotation (excluding VAT 12.5%)
          </p>
        </div>
        
        <!-- Parts Search and Selection Panel -->
        <div class="section-body">
          <div class="row mb-4">
            <div class="col-md-6">
              <div class="input-group mb-3">
                <span class="input-group-text gov-input-prefix"><i class="fas fa-search"></i></span>
                <input type="text" id="parts-search" class="form-control gov-input" 
                       placeholder="Search parts by name or part number...">
                <button class="btn btn-outline-secondary" type="button" id="clear-search">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex justify-content-end">
                <div class="btn-group" role="group">
                  <button type="button" class="btn btn-outline-secondary" id="show-in-stock">
                    <i class="fas fa-check-circle"></i> In Stock Only
                  </button>
                  <button type="button" class="btn btn-outline-secondary" id="show-low-stock">
                    <i class="fas fa-exclamation-triangle"></i> Low Stock
                  </button>
                  <button type="button" class="btn btn-outline-secondary" id="show-all-parts">
                    <i class="fas fa-list"></i> All Parts
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Parts Selection Grid -->
          <div class="parts-grid mb-4" style="border: 1px solid #dee2e6; border-radius: 4px; padding: 15px; max-height: 300px; overflow-y: auto; background: #f8f9fa;">
            <div class="row" id="parts-grid-container">
              <% if @parts.present? %>
                <% @parts.each do |part| %>
                  <div class="col-md-4 mb-3 part-card" 
                       data-part-id="<%= part.id %>"
                       data-part-name="<%= part.name %>"
                       data-part-number="<%= part.part_number %>"
                       data-part-description="<%= part.description %>"
                       data-unit-price="<%= part.selling_price %>"
                       data-current-stock="<%= part.current_stock %>"
                       data-stock-status="<%= part.stock_status %>">
                    <div class="card h-100 border <%= part.stock_status == 'out_of_stock' ? 'border-danger' : part.stock_status == 'low_stock' ? 'border-warning' : 'border-success' %>">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <h6 class="card-title mb-0" style="font-size: 0.9rem;">
                            <strong><%= part.name %></strong>
                          </h6>
                          <span class="badge <%= part.stock_status == 'out_of_stock' ? 'bg-danger' : part.stock_status == 'low_stock' ? 'bg-warning' : 'bg-success' %>">
                            <%= part.current_stock %> in stock
                          </span>
                        </div>
                        
                        <% if part.part_number.present? %>
                          <small class="text-muted d-block mb-2">
                            <i class="fas fa-hashtag"></i> <%= part.part_number %>
                          </small>
                        <% end %>
                        
                        <% if part.description.present? %>
                          <p class="card-text" style="font-size: 0.8rem; color: #6c757d;">
                            <%= truncate(part.description, length: 60) %>
                          </p>
                        <% end %>
                        
                        <div class="mt-2">
                          <div class="d-flex justify-content-between align-items-center">
                            <div>
                              <strong style="color: #28a745; font-size: 0.9rem;">
                                <%= number_to_currency(part.selling_price) %>
                              </strong>
                              <br>
                              <small class="text-muted">
                                Cost: <%= number_to_currency(part.cost_price) %>
                              </small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary add-part-btn" 
                                    data-part-id="<%= part.id %>"
                                    <%= 'disabled' if part.stock_status == 'out_of_stock' %>>
                              <i class="fas fa-plus"></i> Add
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="col-12 text-center py-4">
                  <i class="fas fa-box-open fa-2x text-muted mb-3"></i>
                  <p class="text-muted">No parts found in inventory. Please add parts first.</p>
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- Selected Parts Table -->
          <div class="table-responsive">
            <table class="table gov-pricing-table">
              <thead>
                <tr class="table-header">
                  <th width="5%" class="text-center" style="background: #DA291C; color: white;">
                    <i class="fas fa-hashtag"></i>
                  </th>
                  <th width="30%" style="background: #DA291C; color: white;">PART / DESCRIPTION</th>
                  <th width="10%" class="text-center" style="background: #DA291C; color: white;">STOCK</th>
                  <th width="10%" class="text-center" style="background: #DA291C; color: white;">QUANTITY</th>
                  <th width="15%" class="text-center" style="background: #DA291C; color: white;">UNIT PRICE (TTD)</th>
                  <th width="15%" class="text-center" style="background: #28a745; color: white;">SUBTOTAL (TTD)</th>
                  <th width="15%" class="text-center" style="background: #007bff; color: white;">VAT 12.5%</th>
                </tr>
              </thead>
              <tbody id="parts-table-body">
                <!-- Parts will be dynamically added here -->
              </tbody>
              <tfoot id="parts-table-footer" style="display: none;">
                <tr class="table-footer-subtotal">
                  <td colspan="5" class="text-end" style="font-weight: bold; background: #f8f9fa;">
                    PARTS SUBTOTAL (excluding VAT):
                  </td>
                  <td id="parts-subtotal" class="text-end" style="font-weight: bold; background: #f8f9fa;">
                    $0.00
                  </td>
                  <td id="parts-vat" class="text-end" style="font-weight: bold; background: #f8f9fa;">
                    $0.00
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
          
          <div class="text-center mt-3">
            <button type="button" id="add-custom-part" class="btn btn-outline-secondary gov-btn">
              <i class="fas fa-plus-circle me-1"></i> ADD CUSTOM ITEM (Non-inventory)
            </button>
          </div>
          
          <div class="calculation-note mt-3">
            <div class="alert alert-info gov-alert-info">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Inventory Integration:</strong> Parts are selected from your current inventory. 
              Prices are based on current selling price (cost + markup).
              <br>
              <small class="text-muted">Out of stock parts cannot be added to quotations.</small>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Section 3: Terms & Conditions - Trinidad Government Format -->
    <div class="form-section mb-4 gov-section">
      <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #ffc107; border-bottom: 2px solid #dee2e6;">
        <h4 style="color: #2c3e50; font-weight: 700;">
          <i class="fas fa-gavel me-2" style="color: #ffc107;"></i>SECTION 3: TERMS & CONDITIONS
        </h4>
        <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
          Standard Government of Trinidad and Tobago Procurement Terms
        </p>
      </div>
      <div class="section-body">
        <div class="form-group mb-3">
          <%= f.label :notes, "SPECIAL TERMS / ADDITIONAL CONDITIONS", class: 'form-label gov-label' %>
          <div class="input-group">
            <span class="input-group-text gov-input-prefix"><i class="fas fa-sticky-note"></i></span>
            <%= f.text_area :notes, rows: 4, class: 'form-control gov-textarea', 
                  placeholder: "Enter any special terms, delivery conditions, payment terms, warranty information, or additional notes as per Government procurement regulations...",
                  disabled: @quotation.sent? %>
          </div>
          <small class="form-text text-muted">
            <i class="fas fa-info-circle"></i> Maximum 2000 characters. These terms will form part of the contract.
          </small>
        </div>
        
        <div class="terms-checklist gov-terms-box">
          <h6 class="terms-title" style="color: #DA291C; font-weight: 600;">
            <i class="fas fa-check-circle me-2"></i>STANDARD GOVERNMENT TERMS
          </h6>
          <div class="form-check gov-checkbox mb-3">
            <%= f.check_box :include_vat, class: 'gov-checkbox-input', checked: true, id: 'include_vat',
                  disabled: @quotation.sent? %>
            <label class="gov-checkbox-label" for="include_vat">
              <span class="checkbox-text">
                <strong>VAT Compliance:</strong> All prices exclude VAT 12.5%. VAT will be added as per Government regulations.
              </span>
            </label>
          </div>
          
          <div class="form-check gov-checkbox mb-3">
            <%= f.check_box :prices_valid, class: 'gov-checkbox-input', checked: true, id: 'prices_valid',
                  disabled: @quotation.sent? %>
            <label class="gov-checkbox-label" for='prices_valid'>
              <span class="checkbox-text">
                <strong>Price Validity:</strong> Quoted prices are firm and valid for the period specified above.
              </span>
            </label>
          </div>
          
          <!-- DELIVERY HELPER CHECKBOX - THIS REPLACES delivery_included -->
          <div class="form-check gov-checkbox mb-3">
            <input type="checkbox" class="gov-checkbox-input" id="notes_delivery"
                   <%= 'disabled' if @quotation.sent? %>>
            <label class="gov-checkbox-label" for="notes_delivery">
              <span class="checkbox-text">
                <strong>Delivery/Installation Included:</strong> Check if price includes delivery and installation
              </span>
            </label>
          </div>
          
          <div class="form-check gov-checkbox mb-3">
            <input type="checkbox" class="gov-checkbox-input" id="standard_terms" checked disabled>
            <label class="gov-checkbox-label" for="standard_terms">
              <span class="checkbox-text">
                <strong>Standard Government Terms:</strong> Subject to Government of Trinidad and Tobago procurement regulations.
              </span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 4: Contact Information & Signatures -->
    <div class="form-section mb-4 gov-section">
      <div class="section-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-left: 5px solid #007bff; border-bottom: 2px solid #dee2e6;">
        <h4 style="color: #2c3e50; font-weight: 700;">
          <i class="fas fa-address-card me-2" style="color: #007bff;"></i>SECTION 4: CONTACT & AUTHORIZATION
        </h4>
        <p class="section-subtitle" style="color: #6c757d; font-size: 0.9em;">
          Government of Trinidad and Tobago Official Contacts
        </p>
      </div>
      <div class="section-body">
        <div class="row">
          <div class="col-md-6">
            <div class="contact-card gov-contact-card">
              <div class="card-header" style="background: linear-gradient(135deg, #DA291C 0%, #B31B2E 100%); color: white;">
                <h6 class="mb-0">
                  <i class="fas fa-university me-2"></i> VMCOTT HEADQUARTERS
                </h6>
              </div>
              <div class="card-body" style="background: #f8f9fa;">
                <div class="contact-detail">
                  <i class="fas fa-map-marker-alt text-danger"></i>
                  <div>
                    <strong>Address:</strong><br>
                    Wrightson Road, Port of Spain<br>
                    Trinidad and Tobago
                  </div>
                </div>
                <div class="contact-detail">
                  <i class="fas fa-phone text-primary"></i>
                  <div>
                    <strong>Telephone:</strong><br>
                    (868) 625-VMCT (8628)<br>
                    Main: (868) 625-8475
                  </div>
                </div>
                <div class="contact-detail">
                  <i class="fas fa-envelope text-success"></i>
                  <div>
                    <strong>Email:</strong><br>
                    quotations@vmcott.gov.tt<br>
                    procurement@vmcott.gov.tt
                  </div>
                </div>
                <div class="contact-detail">
                  <i class="fas fa-clock text-warning"></i>
                  <div>
                    <strong>Office Hours:</strong><br>
                    Monday - Friday: 8:00 AM - 4:00 PM<br>
                    (Closed Public Holidays)
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="authorization-card gov-auth-card">
              <div class="card-header" style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%); color: white;">
                <h6 class="mb-0">
                  <i class="fas fa-user-tie me-2"></i> PREPARED BY
                </h6>
              </div>
              <div class="card-body" style="background: #f8f9fa;">
                <div class="auth-detail">
                  <div class="auth-icon">
                    <i class="fas fa-user-circle fa-2x text-success"></i>
                  </div>
                  <div class="auth-info">
                    <h6 class="auth-name mb-1">
                      <strong><%= current_user.name || current_user.email %></strong>
                    </h6>
                    <p class="auth-title mb-1">
                      <i class="fas fa-id-badge"></i> VMCOTT Quotation Officer
                    </p>
                    <p class="auth-id mb-1">
                      <i class="fas fa-fingerprint"></i> Employee ID: VMC-<%= current_user.id.to_s.rjust(5, '0') %>
                    </p>
                    <p class="auth-date mb-0">
                      <i class="fas fa-calendar-alt"></i> Date: <%= Date.today.strftime('%d %B, %Y') %>
                    </p>
                  </div>
                </div>
                
                <!-- Signature Area -->
                <div class="signature-area mt-3 pt-3 border-top">
                  <p class="signature-label mb-2">
                    <i class="fas fa-signature"></i> AUTHORIZED SIGNATURE:
                  </p>
                  <div class="signature-line"></div>
                  <div class="signature-details mt-2">
                    <span class="signature-text">Authorized VMCOTT Representative</span>
                    <span class="signature-date float-end">
                      <i class="fas fa-calendar-check"></i> <%= Date.today.strftime('%d/%m/%Y') %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Agency Acceptance Area -->
        <div class="acceptance-area mt-4 pt-4 border-top">
          <h6 style="color: #DA291C; font-weight: 600;">
            <i class="fas fa-check-double me-2"></i>FOR AGENCY ACCEPTANCE
          </h6>
          <div class="row">
            <div class="col-md-12">
              <div class="agency-acceptance-box">
                <div class="agency-header" style="background: #e9ecef; padding: 10px; border-left: 4px solid #007bff;">
                  <strong><%= @rfq&.requesting_agency&.name || 'REQUESTING AGENCY' %></strong>
                  <small class="float-end">Authorized Procurement Officer</small>
                </div>
                <div class="agency-body" style="padding: 15px; background: #f8f9fa;">
                  <div class="row">
                    <div class="col-md-6">
                      <p class="mb-2">
                        <strong>Accepted by:</strong> ___________________________
                      </p>
                      <p class="mb-2">
                        <strong>Designation:</strong> ___________________________
                      </p>
                    </div>
                    <div class="col-md-6">
                      <p class="mb-2">
                        <strong>Date Accepted:</strong> ___________________________
                      </p>
                      <p class="mb-2">
                        <strong>Purchase Order #:</strong> ___________________________
                      </p>
                    </div>
                  </div>
                  <div class="agency-stamp mt-3 text-center">
                    <div class="stamp" style="border: 2px dashed #007bff; padding: 10px; display: inline-block;">
                      <i class="fas fa-stamp fa-2x text-muted"></i>
                      <br>
                      <small class="text-muted">OFFICIAL ACCEPTANCE STAMP</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions - Trinidad Government Styled -->
  <div class="form-actions mt-4 pt-4 border-top" style="border-top: 3px solid #DA291C !important;">
    <div class="row">
      <div class="col-md-7">
        <div class="gov-submission-notice">
          <div class="notice-header" style="background: linear-gradient(135deg, #DA291C 0%, #B31B2E 100%); color: white; padding: 10px; border-radius: 4px 4px 0 0;">
            <i class="fas fa-exclamation-triangle me-2"></i> IMPORTANT SUBMISSION NOTICE
          </div>
          <div class="notice-body" style="background: #f8f9fa; padding: 15px; border: 1px solid #dee2e6; border-top: none;">
            <p class="mb-2">
              <i class="fas fa-check-circle text-success me-2"></i>
              <strong>Government Procurement Compliance:</strong> This quotation complies with Government of Trinidad and Tobago procurement regulations.
            </p>
            <p class="mb-2">
              <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
              <strong>VAT Application:</strong> All transactions are subject to VAT 12.5% as per national regulations.
            </p>
            <p class="mb-0">
              <i class="fas fa-handshake text-warning me-2"></i>
              <strong>Acceptance Process:</strong> Quotation will be sent to <%= @rfq&.requesting_agency&.name || 'the requesting agency' %> for formal acceptance.
            </p>
          </div>
        </div>
      </div>
      <div class="col-md-5 text-end">
        <div class="action-buttons">
          <%= link_to vmcott_rfq_inbox_path, class: 'btn gov-btn gov-btn-secondary' do %>
            <i class="fas fa-times-circle me-2"></i> CANCEL
          <% end %>
          
          <% if !@quotation.sent? %>
            <%= f.button type: 'submit', name: 'commit', value: 'draft', 
                  class: 'btn gov-btn gov-btn-warning', data: { disable_with: 'Saving Draft...' } do %>
              <i class="fas fa-save me-2"></i> SAVE DRAFT
            <% end %>
            
            <%= f.button type: 'submit', name: 'commit', value: 'submit', 
                  class: 'btn gov-btn gov-btn-primary', 
                  data: { 
                    disable_with: 'Submitting...',
                    confirm: 'Are you sure you want to submit this quotation to the agency? This action cannot be undone and will notify the agency immediately.' 
                  } do %>
              <i class="fas fa-paper-plane me-2"></i> SUBMIT TO AGENCY
            <% end %>
          <% else %>
            <div class="alert alert-info">
              <i class="fas fa-lock me-2"></i> This quotation has been submitted and is locked for editing.
            </div>
          <% end %>
        </div>
        <small class="text-muted d-block mt-2">
          <i class="fas fa-shield-alt"></i> Secure Government Submission System
        </small>
      </div>
    </div>
  </div>
  
  <!-- Hidden fields -->
  <%= f.hidden_field :vendor, value: 'VMCOTT' %>
  <%= f.hidden_field :rfq_id, value: @rfq&.id %>
  <%= f.hidden_field :amount, id: 'quotation_amount' %>
  <%= f.hidden_field :agency_id, value: @rfq&.requesting_agency&.id || @quotation.agency_id || @quotation.vehicle&.agency_id %>
  
  <!-- Hidden field for job template data -->
  <input type="hidden" name="job_template_data" id="job_template_data" value="">
  
  <!-- Hidden field for parts data -->
  <input type="hidden" name="parts_data" id="parts_data" value="[]">
<% end %>

<!-- Hidden template for custom line items -->
<template id="custom-item-template">
  <tr class="gov-table-row custom-item-row" data-index="__INDEX__">
    <td class="text-center item-number" style="font-weight: bold; background: #f8f9fa;">
      __ITEM_NUMBER__
    </td>
    <td>
      <div class="item-description">
        <input type="text" 
               name="quotation[quotation_line_items_attributes][__INDEX__][description]" 
               class="form-control gov-input mb-1" placeholder="Custom item description" required>
        <textarea name="quotation[quotation_line_items_attributes][__INDEX__][specifications]" 
                  class="form-control gov-textarea" rows="1" placeholder="Specifications (optional)"></textarea>
      </div>
    </td>
    <td class="text-center">
      <span class="badge bg-secondary">N/A</span>
    </td>
    <td class="text-center">
      <input type="number" 
             name="quotation[quotation_line_items_attributes][__INDEX__][quantity]" 
             class="form-control gov-input" min="1" value="1" required>
    </td>
    <td>
      <div class="input-group input-group-sm">
        <span class="input-group-text gov-currency-sm">$</span>
        <input type="number" step="0.01" min="0" max="9999999.99"
               name="quotation[quotation_line_items_attributes][__INDEX__][unit_price]" 
               class="form-control form-control-sm custom-unit-price-input" placeholder="0.00"
               data-index="__INDEX__" required>
      </div>
    </td>
    <td class="text-end subtotal-cell" style="font-weight: bold; font-family: 'Courier New', monospace;">
      <span class="subtotal-amount">$0.00</span>
    </td>
    <td class="text-end vat-cell" style="font-weight: bold; font-family: 'Courier New', monospace;">
      <span class="vat-amount">$0.00</span>
    </td>
    <td class="text-center">
      <button type="button" class="btn btn-sm btn-danger remove-custom-item-btn" data-index="__INDEX__">
        <span style="font-size: 12px; pointer-events: none;">✕</span>
      </button>
    </td>
  </tr>
</template>

<!-- Hidden template for inventory parts rows -->
<template id="part-row-template">
  <tr class="gov-table-row inventory-part-row" data-part-id="__PART_ID__" data-index="__INDEX__">
    <td class="text-center item-number" style="font-weight: bold; background: #f8f9fa;">
      __ITEM_NUMBER__
    </td>
    <td>
      <div class="item-description">
        <strong>__PART_NAME__</strong>
        <div class="item-specs text-muted">
          <small><i class="fas fa-hashtag"></i> __PART_NUMBER__</small>
          <br>
          <small><i class="fas fa-info-circle"></i> __PART_DESCRIPTION__</small>
        </div>
        <input type="hidden" 
               name="quotation[quotation_line_items_attributes][__INDEX__][part_id]" 
               value="__PART_ID__">
        <input type="hidden" 
               name="quotation[quotation_line_items_attributes][__INDEX__][description]"
               value="__PART_NAME__">
      </div>
    </td>
    <td class="text-center">
      <span class="badge bg-__STOCK_COLOR__">__CURRENT_STOCK__</span>
    </td>
    <td class="text-center">
      <div class="input-group input-group-sm">
        <input type="number" 
               name="quotation[quotation_line_items_attributes][__INDEX__][quantity]" 
               class="form-control gov-input part-quantity-input" 
               min="1" max="__MAX_QUANTITY__" value="1" 
               data-part-id="__PART_ID__" required>
      </div>
      <small class="text-muted d-block">Max: __MAX_QUANTITY__</small>
    </td>
    <td>
      <div class="input-group input-group-sm">
        <span class="input-group-text gov-currency-sm">$</span>
        <input type="number" step="0.01" min="0" max="9999999.99"
               name="quotation[quotation_line_items_attributes][__INDEX__][unit_price]" 
               class="form-control form-control-sm part-unit-price-input" 
               value="__UNIT_PRICE__" readonly
               data-part-id="__PART_ID__" required>
      </div>
      <small class="text-muted d-block">Inventory price</small>
    </td>
    <td class="text-end subtotal-cell" style="font-weight: bold; font-family: 'Courier New', monospace;">
      <span class="subtotal-amount">$__UNIT_PRICE__</span>
    </td>
    <td class="text-end vat-cell" style="font-weight: bold; font-family: 'Courier New', monospace;">
      <span class="vat-amount">$__VAT_AMOUNT__</span>
    </td>
    <td class="text-center">
      <button type="button" class="btn btn-sm btn-danger remove-part-btn" data-part-id="__PART_ID__">
        <span style="font-size: 12px; pointer-events: none;">✕</span>
      </button>
    </td>
  </tr>
</template>

<!-- Updated Hidden template for adding new job rows with removal button -->
<template id="job-row-template">
  <tr class="gov-table-row job-row" data-job-index="__JOB_INDEX__" data-template-id="__TEMPLATE_ID__">
    <td style="background: #f8f9fa;">
      <input type="text" name="quotation[quotation_jobs_attributes][__JOB_INDEX__][name]" 
             class="form-control gov-input" placeholder="Job Name" required value="__JOB_NAME__">
      <input type="hidden" name="quotation[quotation_jobs_attributes][__JOB_INDEX__][job_template_id]" value="__TEMPLATE_ID__">
    </td>
    <td>
      <textarea name="quotation[quotation_jobs_attributes][__JOB_INDEX__][description]" 
                class="form-control gov-textarea" rows="1" placeholder="Job Description">__JOB_DESCRIPTION__</textarea>
    </td>
    <td class="text-center">
      <input type="number" name="quotation[quotation_jobs_attributes][__JOB_INDEX__][estimated_hours]" 
             class="form-control gov-input job-hours-input" step="0.25" min="0.25" value="__JOB_HOURS__">
    </td>
