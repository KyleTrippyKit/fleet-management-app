  // Add job from template
  function addJobFromTemplate(templateId, name, description, hours, rate) {
    console.log("=== ADDING JOB FROM TEMPLATE ===");
    
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    // Check if already added (by templateId)
    for (const [index, job] of selectedJobs) {
      if (job.templateId == templateId) {
        alert('This job template has already been added.');
        return;
      }
    }
    
    // Create job row in table
    const jobTableBody = document.getElementById('job-table-body');
    const jobRowTemplate = document.getElementById('job-row-template');
    
    if (!jobTableBody || !jobRowTemplate) {
      console.error("Job table body or template not found!");
      alert("Error: Cannot add job. Please refresh the page and try again.");
      return;
    }
    
    // Remove "no jobs" message if it exists
    const noJobsRow = document.getElementById('no-jobs-row');
    if (noJobsRow) {
      noJobsRow.remove();
    }
    
    // Show the total footer
    const jobTotalFooter = document.getElementById('job-total-footer');
    if (jobTotalFooter) {
      jobTotalFooter.style.display = '';
    }
    
    const templateContent = jobRowTemplate.innerHTML;
    const jobTotal = (parseFloat(hours) * parseFloat(rate)).toFixed(2);
    
    const newRowHtml = templateContent
      .replace(/__JOB_INDEX__/g, jobCounter)
      .replace(/__TEMPLATE_ID__/g, templateId)
      .replace(/__JOB_NAME__/g, name)
      .replace(/__JOB_DESCRIPTION__/g, description)
      .replace(/__JOB_HOURS__/g, hours)
      .replace(/__JOB_RATE__/g, rate)
      .replace(/__JOB_TOTAL__/g, jobTotal);
    
    const newRow = document.createElement('tr');
    newRow.className = 'gov-table-row job-row';
    newRow.setAttribute('data-job-index', jobCounter);
    newRow.setAttribute('data-template-id', templateId);
    newRow.innerHTML = newRowHtml;
    
    // Add to table
    jobTableBody.appendChild(newRow);
    
    // Add to selected jobs Map
    selectedJobs.set(jobCounter, {
      name: name,
      description: description,
      hours: parseFloat(hours),
      rate: parseFloat(rate),
      templateId: templateId,
      row: newRow
    });
    
    // Add event listeners to new inputs (only if not sent)
    if (!quotationSent) {
      const hoursInput = newRow.querySelector('.job-hours-input');
      const rateInput = newRow.querySelector('.job-rate-input');
      
      if (hoursInput) {
        hoursInput.addEventListener('input', function() {
          updateJobTotal(newRow);
          calculateAllTotals();
        });
      }
      
      if (rateInput) {
        rateInput.addEventListener('input', function() {
          updateJobTotal(newRow);
          calculateAllTotals();
        });
      }
      
      // Add direct click handler to remove button using a closure
      const removeBtn = newRow.querySelector('.remove-job-from-table-btn');
      if (removeBtn) {
        (function(currentIndex) {
          removeBtn.addEventListener('click', function(e) {
            console.log("DIRECT CLICK HANDLER: Remove button clicked for job:", currentIndex);
            e.preventDefault();
            e.stopPropagation();
            removeJob(currentIndex);
          });
        })(jobCounter);
        
        // Make sure button is visible and clickable
        removeBtn.style.cursor = 'pointer';
        removeBtn.style.position = 'relative';
        removeBtn.style.zIndex = '100';
      }
    }
    
    // Initialize the job total calculation
    updateJobTotal(newRow);
    
    // Update job counter AFTER setting up the click handler
    jobCounter++;
    
    // Update selected jobs display
    updateSelectedJobsDisplay();
    
    // Update totals
    calculateAllTotals();
    
    // Update job template data
    updateJobTemplateData();
    
    return true;
  }
  
  // Update job total display
  function updateJobTotal(row) {
    const hoursInput = row.querySelector('.job-hours-input');
    const rateInput = row.querySelector('.job-rate-input');
    const totalCell = row.querySelector('.job-total-amount');
    
    if (hoursInput && rateInput && totalCell) {
      const hours = parseFloat(hoursInput.value) || 0;
      const rate = parseFloat(rateInput.value) || 0;
      const total = hours * rate;
      totalCell.textContent = formatCurrency(total);
      
      // Update stored job data
      const jobIndex = parseInt(row.getAttribute('data-job-index'));
      if (selectedJobs.has(jobIndex)) {
        const job = selectedJobs.get(jobIndex);
        job.hours = hours;
        job.rate = rate;
        selectedJobs.set(jobIndex, job);
      }
    }
  }
  
  // Remove job
  function removeJob(jobIndex) {
    console.log("=== REMOVING JOB ===");
    
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    if (!selectedJobs.has(jobIndex)) {
      console.log("Job index not found in selectedJobs:", jobIndex);
      return;
    }
    
    // Get job data
    const job = selectedJobs.get(jobIndex);
    
    // Remove from selected jobs Map
    selectedJobs.delete(jobIndex);
    
    // Remove from HTML table if row exists
    if (job.row && job.row.parentNode) {
      job.row.remove();
    }
    
    // Show "no jobs" message if no jobs left
    if (selectedJobs.size === 0) {
      const jobTableBody = document.getElementById('job-table-body');
      const jobTotalFooter = document.getElementById('job-total-footer');
      
      if (jobTableBody && !document.getElementById('no-jobs-row')) {
        const noJobsRow = document.createElement('tr');
        noJobsRow.id = 'no-jobs-row';
        noJobsRow.innerHTML = `
          <td colspan="6" class="text-center text-muted py-4">
            <i class="fas fa-info-circle me-2"></i>
            No jobs added yet. Select jobs from the template panel above.
          </td>
        `;
        jobTableBody.appendChild(noJobsRow);
      }
      
      if (jobTotalFooter) {
        jobTotalFooter.style.display = 'none';
      }
    }
    
    // Update selected jobs display
    updateSelectedJobsDisplay();
    
    // Update totals
    calculateAllTotals();
    
    // Update job template data
    updateJobTemplateData();
  }
  
  // Add part from inventory
  function addPartFromInventory(partId, partName, partNumber, description, unitPrice, currentStock, stockStatus) {
    console.log("=== ADDING PART FROM INVENTORY ===");
    
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    // Check if already added
    if (selectedParts.has(partId)) {
      alert('This part has already been added to the quotation.');
      return;
    }
    
    // Check if in stock
    if (stockStatus === 'out_of_stock') {
      alert('This part is out of stock and cannot be added to the quotation.');
      return;
    }
    
    // Create part row in table
    const partsTableBody = document.getElementById('parts-table-body');
    const partRowTemplate = document.getElementById('part-row-template');
    
    if (!partsTableBody || !partRowTemplate) {
      console.error("Parts table body or template not found!");
      alert("Error: Cannot add part. Please refresh the page and try again.");
      return;
    }
    
    // Show the parts table footer
    const partsTableFooter = document.getElementById('parts-table-footer');
    if (partsTableFooter) {
      partsTableFooter.style.display = '';
    }
    
    const templateContent = partRowTemplate.innerHTML;
    const vatAmount = (unitPrice * vatRate).toFixed(2);
    const maxQuantity = parseInt(currentStock);
    const stockColor = stockStatus === 'low_stock' ? 'warning' : stockStatus === 'out_of_stock' ? 'danger' : 'success';
    
    const newRowHtml = templateContent
      .replace(/__PART_ID__/g, partId)
      .replace(/__INDEX__/g, partCounter)
      .replace(/__ITEM_NUMBER__/g, selectedParts.size + 1)
      .replace(/__PART_NAME__/g, partName)
      .replace(/__PART_NUMBER__/g, partNumber || 'N/A')
      .replace(/__PART_DESCRIPTION__/g, description || 'No description')
      .replace(/__CURRENT_STOCK__/g, currentStock)
      .replace(/__MAX_QUANTITY__/g, maxQuantity)
      .replace(/__UNIT_PRICE__/g, unitPrice.toFixed(2))
      .replace(/__VAT_AMOUNT__/g, vatAmount)
      .replace(/__STOCK_COLOR__/g, stockColor);
    
    const newRow = document.createElement('tr');
    newRow.className = 'gov-table-row inventory-part-row';
    newRow.setAttribute('data-part-id', partId);
    newRow.setAttribute('data-index', partCounter);
    newRow.innerHTML = newRowHtml;
    
    // Add to table
    partsTableBody.appendChild(newRow);
    
    // Add to selected parts Map
    selectedParts.set(partId, {
      partId: partId,
      name: partName,
      partNumber: partNumber,
      description: description,
      unitPrice: unitPrice,
      currentStock: currentStock,
      stockStatus: stockStatus,
      quantity: 1,
      row: newRow
    });
    
    // Add event listener to quantity input (only if not sent)
    if (!quotationSent) {
      const quantityInput = newRow.querySelector('.part-quantity-input');
      if (quantityInput) {
        quantityInput.addEventListener('input', function() {
          const newQuantity = parseInt(this.value) || 1;
          if (newQuantity > maxQuantity) {
            this.value = maxQuantity;
            alert(`Maximum quantity available: ${maxQuantity}`);
          }
          updatePartTotal(partId);
          calculateAllTotals();
        });
      }
      
      // Add event listener to remove button
      const removeBtn = newRow.querySelector('.remove-part-btn');
      if (removeBtn) {
        removeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          removePart(partId);
        });
      }
    }
    
    // Update part counter
    partCounter++;
    
    // Update parts data for submission
    updatePartsData();
    
    // Update totals
    calculateAllTotals();
    
    return true;
  }
  
  // Update part total
  function updatePartTotal(partId) {
    if (!selectedParts.has(partId)) return;
    
    const part = selectedParts.get(partId);
    const row = part.row;
    const quantityInput = row.querySelector('.part-quantity-input');
    const unitPriceInput = row.querySelector('.part-unit-price-input');
    
    if (quantityInput && unitPriceInput) {
      const quantity = parseInt(quantityInput.value) || 1;
      const unitPrice = parseFloat(unitPriceInput.value) || 0;
      
      // Update stored quantity
      part.quantity = quantity;
      selectedParts.set(partId, part);
      
      // Update display
      const subtotal = quantity * unitPrice;
      const vat = subtotal * vatRate;
      
      const subtotalCell = row.querySelector('.subtotal-amount');
      const vatCell = row.querySelector('.vat-amount');
      
      if (subtotalCell) subtotalCell.textContent = formatCurrency(subtotal);
      if (vatCell) vatCell.textContent = formatCurrency(vat);
    }
  }
  
  // Remove part
  function removePart(partId) {
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    if (!selectedParts.has(partId)) return;
    
    const part = selectedParts.get(partId);
    
    // Remove from table
    if (part.row && part.row.parentNode) {
      part.row.remove();
    }
    
    // Remove from Map
    selectedParts.delete(partId);
    
    // Hide footer if no parts left
    if (selectedParts.size === 0) {
      const partsTableFooter = document.getElementById('parts-table-footer');
      if (partsTableFooter) {
        partsTableFooter.style.display = 'none';
      }
    } else {
      // Update item numbers
      updatePartItemNumbers();
    }
    
    // Update parts data
    updatePartsData();
    
    // Update totals
    calculateAllTotals();
  }
  
  // Update part item numbers
  function updatePartItemNumbers() {
    const partRows = document.querySelectorAll('.inventory-part-row');
    partRows.forEach((row, index) => {
      const numberCell = row.querySelector('.item-number');
      if (numberCell) {
        numberCell.textContent = index + 1;
      }
    });
  }
  
  // Add custom item
  function addCustomItem() {
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    const partsTableBody = document.getElementById('parts-table-body');
    const customItemTemplate = document.getElementById('custom-item-template');
    
    if (!partsTableBody || !customItemTemplate) return;
    
    // Show the parts table footer
    const partsTableFooter = document.getElementById('parts-table-footer');
    if (partsTableFooter) {
      partsTableFooter.style.display = '';
    }
    
    const templateContent = customItemTemplate.innerHTML;
    const newRowHtml = templateContent
      .replace(/__INDEX__/g, customItemCounter)
      .replace(/__ITEM_NUMBER__/g, selectedParts.size + customItems.size + 1);
    
    const newRow = document.createElement('tr');
    newRow.className = 'gov-table-row custom-item-row';
    newRow.setAttribute('data-index', customItemCounter);
    newRow.innerHTML = newRowHtml;
    
    // Add to table
    partsTableBody.appendChild(newRow);
    
    // Add to custom items Map
    customItems.set(customItemCounter, {
      index: customItemCounter,
      row: newRow
    });
    
    // Add event listeners
    const quantityInput = newRow.querySelector('input[name*="quantity"]');
    const priceInput = newRow.querySelector('.custom-unit-price-input');
    const removeBtn = newRow.querySelector('.remove-custom-item-btn');
    
    if (quantityInput) {
      quantityInput.addEventListener('input', function() {
        calculateCustomItemTotal(customItemCounter);
        calculateAllTotals();
      });
    }
    
    if (priceInput) {
      priceInput.addEventListener('input', function() {
        calculateCustomItemTotal(customItemCounter);
        calculateAllTotals();
      });
    }
    
    if (removeBtn) {
      removeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        removeCustomItem(customItemCounter);
      });
    }
    
    customItemCounter++;
    calculateAllTotals();
  }
  
  // Calculate custom item total
  function calculateCustomItemTotal(index) {
    if (!customItems.has(index)) return;
    
    const item = customItems.get(index);
    const row = item.row;
    const quantityInput = row.querySelector('input[name*="quantity"]');
    const priceInput = row.querySelector('.custom-unit-price-input');
    
    if (quantityInput && priceInput) {
      const quantity = parseInt(quantityInput.value) || 1;
      const unitPrice = parseFloat(priceInput.value) || 0;
      const subtotal = quantity * unitPrice;
      const vat = subtotal * vatRate;
      
      const subtotalCell = row.querySelector('.subtotal-amount');
      const vatCell = row.querySelector('.vat-amount');
      
      if (subtotalCell) subtotalCell.textContent = formatCurrency(subtotal);
      if (vatCell) vatCell.textContent = formatCurrency(vat);
    }
  }
  
  // Remove custom item
  function removeCustomItem(index) {
    // Check if quotation is sent
    if (quotationSent) {
      alert('This quotation has been submitted and cannot be edited.');
      return;
    }
    
    if (!customItems.has(index)) return;
    
    const item = customItems.get(index);
    
    // Remove from table
    if (item.row && item.row.parentNode) {
      item.row.remove();
    }
    
    // Remove from Map
    customItems.delete(index);
    
    // Hide footer if no items left
    if (selectedParts.size === 0 && customItems.size === 0) {
      const partsTableFooter = document.getElementById('parts-table-footer');
      if (partsTableFooter) {
        partsTableFooter.style.display = 'none';
      }
    }
    
    calculateAllTotals();
  }
  
  // Calculate parts totals
  function calculatePartsTotals() {
    let partsSubtotal = 0;
    let partsVat = 0;
    let partsTotal = 0;
    
    // Calculate inventory parts
    selectedParts.forEach((part) => {
      const quantity = part.quantity || 1;
      const subtotal = quantity * part.unitPrice;
      partsSubtotal += subtotal;
      partsVat += subtotal * vatRate;
    });
    
    // Calculate custom items
    customItems.forEach((item, index) => {
      const row = item.row;
      const quantityInput = row.querySelector('input[name*="quantity"]');
      const priceInput = row.querySelector('.custom-unit-price-input');
      
      if (quantityInput && priceInput) {
        const quantity = parseInt(quantityInput.value) || 1;
        const unitPrice = parseFloat(priceInput.value) || 0;
        const subtotal = quantity * unitPrice;
        partsSubtotal += subtotal;
        partsVat += subtotal * vatRate;
      }
    });
    
    partsTotal = partsSubtotal + partsVat;
    
    // Update parts totals display
    const partsSubtotalElem = document.getElementById('parts-subtotal');
    const partsVatElem = document.getElementById('parts-vat');
    
    if (partsSubtotalElem) partsSubtotalElem.textContent = formatCurrency(partsSubtotal);
    if (partsVatElem) partsVatElem.textContent = formatCurrency(partsVat);
    
    return { partsSubtotal, partsVat, partsTotal };
  }
  
  // Calculate job item totals
  function calculateJobItem(row) {
    const hoursInput = row.querySelector('.job-hours-input') || row.querySelector('input[name*="estimated_hours"]');
    const rateInput = row.querySelector('.job-rate-input') || row.querySelector('input[name*="labor_rate_per_hour"]');
    
    const hours = parseFloat(hoursInput?.value) || 0;
    const rate = parseFloat(rateInput?.value) || 0;
    const total = hours * rate;
    
    // Update display
    const totalCell = row.querySelector('.job-total-amount');
    if (totalCell) totalCell.textContent = formatCurrency(total);
    
    return { hours, rate, total };
  }
  
  // Calculate all totals
  function calculateAllTotals() {
    let jobsTotal = 0;
    
    // Calculate jobs
    selectedJobs.forEach((job) => {
      if (job.row) {
        const { total } = calculateJobItem(job.row);
        jobsTotal += total;
      } else {
        jobsTotal += (job.hours * job.rate);
      }
    });
    
    // Calculate parts
    const { partsTotal } = calculatePartsTotals();
    
    // Grand total = jobs + parts
    const grandTotal = jobsTotal + partsTotal;
    
    // Update summary totals
    const grandTotalElem = document.getElementById('grand-total');
    const totalAmountDisplay = document.getElementById('total-amount-display');
    const quotationAmount = document.getElementById('quotation_amount');
    const totalLaborCost = document.getElementById('total-labor-cost');
    
    // Update jobs section total
    if (totalLaborCost) totalLaborCost.textContent = formatCurrency(jobsTotal);
    
    // Update main totals (jobs + parts)
    if (grandTotalElem) grandTotalElem.textContent = formatCurrency(grandTotal);
    if (totalAmountDisplay) totalAmountDisplay.value = formatCurrency(grandTotal);
    if (quotationAmount) quotationAmount.value = grandTotal.toFixed(2);
    
    return { jobsTotal, partsTotal, grandTotal };
  }
  
  // Update job template data for submission
  function updateJobTemplateData() {
    const jobData = Array.from(selectedJobs.entries()).map(([index, job]) => ({
      index: index,
      templateId: job.templateId,
      name: job.name,
      description: job.description,
      hours: job.hours,
      rate: job.rate
    }));
    
    const jobTemplateData = document.getElementById('job_template_data');
    if (jobTemplateData) {
      jobTemplateData.value = JSON.stringify(jobData);
    }
  }
  
  // Update parts data for submission
  function updatePartsData() {
    const partsData = Array.from(selectedParts.entries()).map(([partId, part]) => ({
      partId: partId,
      quantity: part.quantity,
      unitPrice: part.unitPrice
    }));
    
    const partsDataInput = document.getElementById('parts_data');
    if (partsDataInput) {
      partsDataInput.value = JSON.stringify(partsData);
    }
  }
  
  // Form validation
  function setupFormValidation() {
    const form = document.querySelector('.tt-vmcott-quotation-form');
    if (!form) return;
    
    form.addEventListener('submit', function(e) {
      console.log("Form submit validation");
      
      // Check if quotation is sent
      if (quotationSent) {
        e.preventDefault();
        alert('This quotation has been submitted and cannot be edited.');
        return false;
      }
      
      // Check if we have at least jobs OR parts
      const hasJobs = selectedJobs.size > 0;
      const hasParts = selectedParts.size > 0;
      const hasCustomItems = customItems.size > 0;
      
      if (!hasJobs && !hasParts && !hasCustomItems) {
        e.preventDefault();
        alert('Please add at least one job, part, or custom item before submitting the quotation.');
        return false;
      }
      
      // Validate job data
      let hasValidJobs = true;
      selectedJobs.forEach((job, index) => {
        if (!job.name || job.hours <= 0 || job.rate <= 0) {
          hasValidJobs = false;
          console.error(`Invalid job at index ${index}:`, job);
        }
      });
      
      if (!hasValidJobs) {
        e.preventDefault();
        alert('Please ensure all jobs have valid names, hours, and rates.');
        return false;
      }
      
      console.log("Form validation passed - submitting");
      return true;
    });
  }
  
  // Parts search functionality
  function setupPartsSearch() {
    const searchInput = document.getElementById('parts-search');
    const clearSearchBtn = document.getElementById('clear-search');
    
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const partCards = document.querySelectorAll('.part-card');
        
        partCards.forEach(card => {
          const partName = card.getAttribute('data-part-name').toLowerCase();
          const partNumber = card.getAttribute('data-part-number')?.toLowerCase() || '';
          const partDescription = card.getAttribute('data-part-description')?.toLowerCase() || '';
          
          if (partName.includes(searchTerm) || 
              partNumber.includes(searchTerm) || 
              partDescription.includes(searchTerm)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
    
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', function() {
        searchInput.value = '';
        const partCards = document.querySelectorAll('.part-card');
        partCards.forEach(card => {
          card.style.display = 'block';
        });
      });
    }
  }
  
  // Parts filter functionality
