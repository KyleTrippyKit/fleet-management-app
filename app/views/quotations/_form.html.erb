  // Attach template selection event listeners
  function attachTemplateListeners() {
    console.log("Setting up template listeners...");
    
    // Use event delegation for job templates
    document.addEventListener('click', function(e) {
      const addBtn = e.target.closest('.add-template-btn');
      if (addBtn) {
        e.preventDefault();
        e.stopPropagation();
        
        // Check if quotation is sent
        if (quotationSent) {
          alert('This quotation has been submitted and cannot be edited.');
          return;
        }
        
        const card = addBtn.closest('.template-card');
        if (!card) return;
        
        const templateId = card.getAttribute('data-template-id');
        const name = card.getAttribute('data-template-name');
        const description = card.getAttribute('data-template-description');
        const hours = card.getAttribute('data-template-hours') || 1;
        const rate = card.getAttribute('data-template-rate') || 100;
        
        console.log("Add button clicked for template:", templateId, name);
        
        addJobFromTemplate(templateId, name, description, hours, rate);
        
        // Visual feedback
        card.style.backgroundColor = '#e7f3fe';
        card.style.borderColor = '#007bff';
        setTimeout(() => {
          card.style.backgroundColor = '';
          card.style.borderColor = '';
        }, 500);
      }
    });
  }
  
  // Attach parts selection event listeners
  function attachPartsListeners() {
    // Use event delegation for parts
    document.addEventListener('click', function(e) {
      const addPartBtn = e.target.closest('.add-part-btn');
      if (addPartBtn) {
        e.preventDefault();
        e.stopPropagation();
        
        // Check if quotation is sent
        if (quotationSent) {
          alert('This quotation has been submitted and cannot be edited.');
          return;
        }
        
        const card = addPartBtn.closest('.part-card');
        if (!card) return;
        
        const partId = card.getAttribute('data-part-id');
        const partName = card.getAttribute('data-part-name');
        const partNumber = card.getAttribute('data-part-number');
        const description = card.getAttribute('data-part-description');
        const unitPrice = parseFloat(card.getAttribute('data-unit-price'));
        const currentStock = card.getAttribute('data-current-stock');
        const stockStatus = card.getAttribute('data-stock-status');
        
        addPartFromInventory(partId, partName, partNumber, description, unitPrice, currentStock, stockStatus);
        
        // Visual feedback
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
          card.style.transform = '';
        }, 300);
      }
    });
  }
  
  // Set up event delegation for ALL remove buttons
  function setupRemoveButtonDelegation() {
    console.log("Setting up remove button event delegation...");
    
    // Event delegation for ALL clicks
    document.addEventListener('click', function(e) {
      // Check if clicked on job remove button
      let tableRemoveBtn = e.target.closest('.remove-job-from-table-btn');
      
      // If not found, check if clicked on span inside button
      if (!tableRemoveBtn && e.target.tagName === 'SPAN') {
        tableRemoveBtn = e.target.closest('button');
        if (tableRemoveBtn && tableRemoveBtn.classList.contains('remove-job-from-table-btn')) {
          console.log("Found span inside remove button");
        }
      }
      
      if (tableRemoveBtn) {
        console.log("TABLE REMOVE BUTTON CLICKED VIA DELEGATION");
        e.preventDefault();
        e.stopPropagation();
        
        // Check if quotation is sent
        if (quotationSent) {
          alert('This quotation has been submitted and cannot be edited.');
          return;
        }
        
        const row = tableRemoveBtn.closest('.job-row');
        if (!row) {
          console.error("Could not find job row");
          return;
        }
        
        const jobIndex = parseInt(row.getAttribute('data-job-index'));
        console.log("Removing job index via delegation:", jobIndex);
        removeJob(jobIndex);
        return;
      }
      
      // Check if clicked on remove button in panel
      const panelRemoveBtn = e.target.closest('.remove-selected-job-btn');
      if (panelRemoveBtn) {
        console.log("PANEL REMOVE BUTTON CLICKED VIA DELEGATION");
        e.preventDefault();
        e.stopPropagation();
        
        // Check if quotation is sent
        if (quotationSent) {
          alert('This quotation has been submitted and cannot be edited.');
          return;
        }
        
        const jobIndex = parseInt(panelRemoveBtn.getAttribute('data-index'));
        console.log("Removing job index via delegation:", jobIndex);
        removeJob(jobIndex);
        return;
      }
    }, true); // Use capture phase
  }
  
  // Initialize everything
  function init() {
    console.log("Initializing quotation form - WITH INVENTORY PARTS");
    
    // Attach listeners (only if not sent)
    if (!quotationSent) {
      attachTemplateListeners();
      attachPartsListeners();
      setupRemoveButtonDelegation();
      setupPartsSearch();
      setupPartsFilter();
      setupFormValidation();
      
      // Custom item button
      const addCustomPartBtn = document.getElementById('add-custom-part');
      if (addCustomPartBtn) {
        addCustomPartBtn.addEventListener('click', function(e) {
          e.preventDefault();
          addCustomItem();
        });
      }
    } else {
      // Disable all interactive elements if quotation is sent
      console.log("Quotation is sent - disabling interactive elements");
    }
    
    // Update displays
    updateSelectedJobsDisplay();
    
    // Calculate initial totals
    calculateAllTotals();
    
    // Update data for submission
    updateJobTemplateData();
    updatePartsData();
    
    console.log("Quotation form initialization complete");
  }
  
  // Start initialization
  init();
});
</script>