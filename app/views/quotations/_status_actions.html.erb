<%# app/views/quotations/_status_actions.html.erb %>
<div class="card border-0 shadow-sm">
  <div class="card-header bg-light py-3">
    <h5 class="mb-0 fw-bold">
      <i class="bi bi-activity me-2"></i>
      QUOTATION STATUS & ACTIONS
    </h5>
  </div>
  <div class="card-body p-4">
    <div class="row align-items-center mb-4">
      <div class="col-md-4">
        <div class="text-center">
          <h6 class="fw-bold mb-2">CURRENT STATUS</h6>
          <span class="badge bg-<%= @quotation.status_color %> status-badge fs-6">
            <%= @quotation.status.to_s.upcase %>
          </span>
          <div class="mt-2">
            <% if @quotation.expired? %>
              <span class="text-danger small">
                <i class="bi bi-clock-history me-1"></i>
                Expired <%= time_ago_in_words(@quotation.valid_to) %> ago
              </span>
            <% elsif @quotation.valid_to %>
              <span class="text-success small">
                <i class="bi bi-clock me-1"></i>
                Closes in <%= distance_of_time_in_words(Time.now, @quotation.valid_to) %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
      
      <div class="col-md-8">
        <div class="action-buttons">
          <div class="d-flex flex-wrap gap-2 justify-content-end">
            <!-- Navigation -->
            <%= link_to quotations_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-list-ul me-1"></i> All Quotations
            <% end %>
            
            <!-- Print -->
            <%= link_to print_quotation_path(@quotation, format: :pdf), 
                class: "btn btn-outline-primary", target: "_blank" do %>
              <i class="bi bi-printer me-1"></i> Print RFQ
            <% end %>
            
            <!-- Email -->
            <%= link_to email_quotation_path(@quotation), 
                class: "btn btn-outline-dark" do %>
              <i class="bi bi-envelope me-1"></i> Email to Vendor
            <% end %>
            
            <!-- Management Actions -->
            <% if current_user.can_manage_quotations? %>
              <!-- Edit -->
              <%= link_to edit_quotation_path(@quotation), class: "btn btn-outline-info" do %>
                <i class="bi bi-pencil me-1"></i> Edit
              <% end %>
              
              <!-- Accept/Reject -->
              <% if @quotation.pending? && !@quotation.expired? %>
                <%= button_to accept_quotation_path(@quotation), 
                    method: :post,
                    class: "btn btn-success",
                    form: { data: { turbo_confirm: "Accept this quotation?" } } do %>
                  <i class="bi bi-check-circle me-1"></i> Accept
                <% end %>
                
                <%= button_to reject_quotation_path(@quotation), 
                    method: :post,
                    class: "btn btn-danger",
                    form: { data: { turbo_confirm: "Reject this quotation?" } } do %>
                  <i class="bi bi-x-circle me-1"></i> Reject
                <% end %>
              <% end %>
              
              <!-- Convert to PO -->
              <% if @quotation.accepted? && current_user.finance? %>
                <%= link_to convert_to_purchase_order_quotation_path(@quotation), 
                    method: :post,
                    class: "btn btn-warning",
                    data: { turbo_confirm: "Create purchase order from this quotation?" } do %>
                  <i class="bi bi-cart-check me-1"></i> Create PO
                <% end %>
              <% end %>
              
              <!-- Duplicate -->
              <%= link_to new_quotation_path(duplicate: @quotation.id), 
                  class: "btn btn-outline-secondary" do %>
                <i class="bi bi-copy me-1"></i> Duplicate
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Timeline -->
    <div class="mt-4 pt-3 border-top">
      <h6 class="fw-bold mb-3"><i class="bi bi-timeline me-2"></i>QUOTATION TIMELINE</h6>
      <div class="timeline">
        <div class="timeline-item active">
          <div class="timeline-point"></div>
          <div class="timeline-content">
            <h6 class="fw-bold mb-1">RFQ Created</h6>
            <p class="mb-0 small text-muted">
              <%= @quotation.created_at.strftime("%d %B, %Y at %H:%M") %>
              <% if @quotation.created_by %>
                <br>by <%= @quotation.created_by.name %>
              <% end %>
            </p>
          </div>
        </div>
        
        <% if @quotation.valid_to %>
          <div class="timeline-item <%= @quotation.expired? || @quotation.status != 'pending' ? 'active' : '' %>">
            <div class="timeline-point"></div>
            <div class="timeline-content">
              <h6 class="fw-bold mb-1">Closing Date</h6>
              <p class="mb-0 small text-muted">
                <%= @quotation.valid_to.strftime("%d %B, %Y at 16:00") %>
                <% if @quotation.expired? %>
                  <br><span class="text-danger">Closed</span>
                <% else %>
                  <br><span class="text-success">Open</span>
                <% end %>
              </p>
            </div>
          </div>
        <% end %>
        
        <% if @quotation.status != 'pending' %>
          <div class="timeline-item active">
            <div class="timeline-point"></div>
            <div class="timeline-content">
              <h6 class="fw-bold mb-1">Status Updated</h6>
              <p class="mb-0 small text-muted">
                <%= @quotation.status.humanize %> on <%= @quotation.updated_at.strftime("%d %B, %Y") %>
                <% if @quotation.accepted? %>
                  <br>Ready for purchase order creation
                <% elsif @quotation.rejected? %>
                  <br>Quotation not accepted
                <% elsif @quotation.converted? %>
                  <br>Converted to purchase order
                <% end %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>