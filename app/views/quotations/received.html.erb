<%# app/views/quotations/received.html.erb %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h3 mb-0">
        <i class="fas fa-inbox me-2"></i>
        Quotations Received
      </h1>
      <p class="text-muted">
        <% if current_user.finance? %>
          Review quotations awaiting your team's attention
        <% else %>
          View quotations from VMCOTT
        <% end %>
      </p>
    </div>
  </div>

  <%# Priority Summary for Finance Team %>
  <% if current_user.finance? || current_user.admin? %>
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card border-info">
          <div class="card-body">
            <h6 class="card-title text-info">🔵 Awaiting Finance Team</h6>
            <h3><%= @quotations&.where(status: 'sent')&.count || 0 %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-warning">
          <div class="card-body">
            <h6 class="card-title text-warning">🟡 Under Agency Review</h6>
            <h3><%= @quotations&.where(status: 'pending_acceptance')&.count || 0 %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-success">
          <div class="card-body">
            <h6 class="card-title text-success">🟢 Ready for PO Creation</h6>
            <h3><%= @quotations&.where(status: 'accepted')&.count || 0 %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-danger">
          <div class="card-body">
            <h6 class="card-title text-danger">🔴 Expiring Soon</h6>
            <h3><%= @quotations&.expiring_soon&.count || 0 %></h3>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if @quotations.present? && @quotations.any? %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0">Quote #</th>
                <th class="border-0">Vendor</th>
                <th class="border-0">Vehicle</th>
                <th class="border-0 text-end">Amount</th>
                <th class="border-0">Date Received</th>
                <th class="border-0">Status</th>
                <th class="border-0 text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @quotations.each do |quote| %>
                <tr class="<%= 'table-warning' if quote.status == 'sent' && quote.created_at < 3.days.ago %>">
                  <td class="fw-semibold">
                    <%= link_to quote.quote_number, quotation_path(quote), 
                        class: "text-decoration-none",
                        data: { turbo: false } %>
                  </td>

                  <td>
                    <%= quote.vendor || "—" %>
                  </td>

                  <td>
                    <% if quote.vehicle %>
                      <%= link_to quote.vehicle.license_plate, vehicle_path(quote.vehicle),
                            class: "badge bg-info text-decoration-none",
                            data: { turbo: false } %>
                      <div class="small text-muted">
                        <%= quote.vehicle.make %> <%= quote.vehicle.model %>
                      </div>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>

                  <td class="text-end">
                    <strong class="text-nowrap">
                      $<%= number_with_precision(quote.amount.to_f, precision: 2) %>
                    </strong>
                  </td>

                  <td>
                    <div><%= quote.created_at.strftime('%b %d, %Y') %></div>
                    <small class="text-muted"><%= time_ago_in_words(quote.created_at) %> ago</small>
                  </td>

                  <td>
                    <%= render 'shared/quotation_status_badges', 
                        quotation: quote, 
                        context: 'received' %>
                  </td>

                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to accept_items_quotation_path(quote),
                          class: "btn btn-primary",
                          data: { turbo: false } do %>
                        <i class="fas fa-check-circle me-1"></i>
                        Review & Select
                      <% end %>

                      <%= link_to quotation_path(quote),
                          class: "btn btn-outline-secondary",
                          data: { turbo: false } do %>
                        <i class="fas fa-eye me-1"></i>
                        View
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @quotations.respond_to?(:total_pages) && @quotations.total_pages.to_i > 1 %>
          <div class="card-footer border-0 bg-light">
            <div class="d-flex justify-content-center">
              <%= paginate @quotations %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  <% else %>
    <div class="text-center py-5">
      <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
      <h4 class="text-muted">No quotations received yet</h4>
      <p class="text-muted">When VMCOTT sends you quotations, they'll appear here</p>
    </div>
  <% end %>
</div>