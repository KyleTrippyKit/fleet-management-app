<%# app/views/quotations/workspace.html.erb %>

<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">

  <style>
    /* =========================
       WORKSPACE SCOPED THEME FIX
       ========================= */

    body.quotation-workspace-page {
      background: #f8f9fa;
    }

    /* Force readable text ONLY inside workspace wrapper */
    .quotation-workspace {
      color: #212529;
    }

    .quotation-workspace .text-muted { color: #6c757d !important; }
    .quotation-workspace a { color: inherit; }
    .quotation-workspace a.text-decoration-none:hover { text-decoration: underline; }

    .quotation-workspace .card {
      background: #ffffff;
      color: #212529;
    }

    .quotation-workspace .table,
    .quotation-workspace .table th,
    .quotation-workspace .table td {
      color: #212529 !important;
    }

    /* Keep colored stat cards readable */
    .quotation-workspace .card.bg-primary *,
    .quotation-workspace .card.bg-success *,
    .quotation-workspace .card.bg-info *,
    .quotation-workspace .card.bg-danger *,
    .quotation-workspace .card.bg-dark * {
      color: #ffffff !important;
    }

    .quotation-workspace .card.bg-warning * {
      color: #212529 !important;
    }

    /* =========================
       ACTION BUTTON FIXES
       ========================= */

    /* Keep actions on one line (unless small screens) */
    .quotation-workspace .actions-cell { white-space: nowrap; }

    @media (max-width: 576px) {
      .quotation-workspace .actions-cell { white-space: normal; }
    }

    /* Make buttons align nicely */
    .quotation-workspace .btn-group .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      font-weight: 600;
    }

    /* Rails button_to generates a form — keep it inline like a button */
    .quotation-workspace .btn-group form {
      display: inline-block;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* Ensure text labels are always visible and never "invisible" */
    .quotation-workspace .btn .btn-label {
      display: inline !important;
      opacity: 1 !important;
      visibility: visible !important;
      line-height: 1;
    }

    /* Force outline button text colors (so you always see the words) */
    .quotation-workspace .btn-outline-primary { color: #0d6efd !important; }
    .quotation-workspace .btn-outline-secondary { color: #6c757d !important; }
    .quotation-workspace .btn-outline-success { color: #198754 !important; }
    .quotation-workspace .btn-outline-dark { color: #212529 !important; }

    /* Keep label readable on hover too */
    .quotation-workspace .btn-outline-primary:hover,
    .quotation-workspace .btn-outline-secondary:hover,
    .quotation-workspace .btn-outline-success:hover,
    .quotation-workspace .btn-outline-dark:hover {
      color: #ffffff !important;
    }

    /* Slightly reduce icon width so labels line up */
    .quotation-workspace .btn i {
      width: 1.1rem;
      text-align: center;
    }
  </style>

  <script>
    // Ensure body class is present even if Turbo is on
    function markWorkspaceBody() {
      document.body.classList.add("quotation-workspace-page");
    }
    document.addEventListener("DOMContentLoaded", markWorkspaceBody);
    document.addEventListener("turbo:load", markWorkspaceBody);
  </script>
<% end %>

<div class="container-fluid py-4 quotation-workspace" data-controller="purchase-orders">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h3 mb-0">
        <i class="fas fa-file-invoice-dollar me-2"></i>
        VMCOTT Quotation Workspace
      </h1>
      <p class="text-muted">Manage all quotations from VMCOTT to agencies</p>
    </div>

    <!-- ✅ TOP ACTIONS -->
    <div class="col-auto">
      <%= link_to new_quotation_path, class: "btn btn-primary", data: { turbo: false } do %>
        <i class="fas fa-plus me-2"></i> New Quotation
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">⚪ Draft - VMCOTT Processing</h6>
              <h3 class="mb-0"><%= @stats[:draft] %></h3>
            </div>
            <i class="fas fa-edit fa-2x opacity-50"></i>
          </div>
          <div class="mt-3">
            <%= link_to "View Drafts", quotations_path(status: "draft"),
                  class: "btn btn-light btn-sm w-100",
                  data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-warning text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">🔵 Sent to Agency</h6>
              <h3 class="mb-0"><%= @stats[:sent] %></h3>
            </div>
            <i class="fas fa-paper-plane fa-2x opacity-50"></i>
          </div>
          <div class="mt-3">
            <%= link_to "View Sent", quotations_path(status: "sent"),
                  class: "btn btn-light btn-sm w-100",
                  data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">🟡 Under Agency Review</h6>
              <h3 class="mb-0"><%= @quotations&.where(status: 'pending_acceptance')&.count || 0 %></h3>
            </div>
            <i class="fas fa-clock fa-2x opacity-50"></i>
          </div>
          <div class="mt-3">
            <%= link_to "View Pending", quotations_path(status: "pending_acceptance"),
                  class: "btn btn-light btn-sm w-100",
                  data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-info text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">Total Value</h6>
              <h3 class="mb-0">TTD <%= number_to_currency(@stats[:total_value] || 0, unit: "") %></h3>
            </div>
            <i class="fas fa-dollar-sign fa-2x opacity-50"></i>
          </div>
          <div class="mt-3">
            <%= link_to "All Quotations", quotations_path,
                  class: "btn btn-light btn-sm w-100",
                  data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
      <%= form_with url: workspace_quotations_path, method: :get, local: true,
            class: "row g-3", data: { turbo: false } do %>

        <div class="col-md-3">
          <%= label_tag :agency_id, "Agency", class: "form-label" %>
          <%= select_tag :agency_id,
                options_from_collection_for_select(Agency.where.not(code: "VMCOTT"), :id, :name, params[:agency_id]),
                include_blank: "All Agencies",
                class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= label_tag :status, "Status", class: "form-label" %>
          <%= select_tag :status,
                options_for_select(Quotation.statuses.keys.map { |s| [s.humanize.titleize, s] }, params[:status]),
                include_blank: "All Statuses",
                class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= label_tag :date_from, "From Date", class: "form-label" %>
          <%= date_field_tag :date_from, params[:date_from], class: "form-control" %>
        </div>

        <div class="col-md-2">
          <%= label_tag :date_to, "To Date", class: "form-label" %>
          <%= date_field_tag :date_to, params[:date_to], class: "form-control" %>
        </div>

        <div class="col-md-2">
          <%= label_tag :vehicle_search, "Vehicle", class: "form-label" %>
          <%= text_field_tag :vehicle_search, params[:vehicle_search],
                class: "form-control",
                placeholder: "License plate..." %>
        </div>

        <div class="col-md-1 d-flex align-items-end">
          <div class="btn-group w-100">
            <%= submit_tag "Filter", class: "btn btn-primary" %>
            <%= link_to "Clear", workspace_quotations_path, class: "btn btn-outline-secondary", data: { turbo: false } %>
          </div>
        </div>

      <% end %>
    </div>
  </div>

  <!-- Recent Quotations -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Quote #</th>
              <th class="border-0">Agency</th>
              <th class="border-0">Vehicle</th>
              <th class="border-0">Amount</th>
              <th class="border-0">Status</th>
              <th class="border-0">Valid Until</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if @quotations.any? %>
              <% @quotations.each do |quotation| %>
                <tr>
                  <td>
                    <strong>
                      <%= link_to quotation.quote_number, quotation_path(quotation),
                            class: "text-decoration-none",
                            data: { turbo: false } %>
                    </strong>
                    <div class="small text-muted">
                      <%= quotation.created_at.strftime("%b %d, %Y") %>
                    </div>
                  </td>

                  <td>
                    <% if quotation.vehicle&.agency %>
                      <span class="badge bg-secondary">
                        <%= quotation.vehicle.agency.code %>
                      </span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>

                  <td>
                    <% if quotation.vehicle %>
                      <%= link_to quotation.vehicle.license_plate, quotation.vehicle,
                            class: "badge bg-info text-decoration-none",
                            data: { turbo: false } %>
                      <div class="small text-muted">
                        <%= quotation.vehicle.make %> <%= quotation.vehicle.model %>
                      </div>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>

                  <td>
                    <strong class="text-nowrap">
                      TTD <%= number_with_precision(quotation.amount, precision: 2) %>
                    </strong>
                  </td>

                  <td>
                    <%= render 'shared/quotation_status_badges', 
                        quotation: quotation, 
                        context: 'workspace' %>
                  </td>

                  <td>
                    <div class="d-flex flex-column">
                      <span><%= quotation.valid_to.strftime("%b %d, %Y") %></span>
                      <% if quotation.valid_to < Date.today %>
                        <span class="badge bg-danger mt-1">Expired</span>
                      <% elsif quotation.valid_to < Date.today + 7.days %>
                        <span class="badge bg-warning text-dark mt-1">Expiring Soon</span>
                      <% end %>
                    </div>
                  </td>

                  <td class="actions-cell">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Actions">

                      <%= link_to quotation_path(quotation),
                            class: "btn btn-outline-primary d-inline-flex align-items-center gap-1",
                            title: "View",
                            data: { turbo: false } do %>
                        <i class="fas fa-eye"></i>
                        <span class="btn-label">View</span>
                      <% end %>

                      <% if quotation.draft? %>
                        <%= link_to edit_quotation_path(quotation),
                              class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1",
                              title: "Edit",
                              data: { turbo: false } do %>
                          <i class="fas fa-edit"></i>
                          <span class="btn-label">Edit</span>
                        <% end %>

                        <%= button_to submit_to_agency_quotation_path(quotation),
                              method: :post,
                              class: "btn btn-outline-success d-inline-flex align-items-center gap-1",
                              title: "Submit to Agency",
                              form: { class: "d-inline-block m-0 p-0", data: { turbo: false } },
                              data: { turbo: false, confirm: "Submit this quotation to the agency?" } do %>
                          <i class="fas fa-paper-plane"></i>
                          <span class="btn-label">Submit</span>
                        <% end %>
                      <% end %>

                      <%= link_to print_quotation_path(quotation, format: :pdf),
                            class: "btn btn-outline-dark d-inline-flex align-items-center gap-1",
                            target: "_blank",
                            rel: "noopener",
                            title: "Print",
                            data: { turbo: false } do %>
                        <i class="fas fa-print"></i>
                        <span class="btn-label">Print</span>
                      <% end %>

                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center py-5">
                  <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                  <h4 class="text-muted">No quotations found</h4>
                  <p class="text-muted">Create your first quotation to get started</p>
                  <%= link_to "Create Quotation", new_quotation_path,
                        class: "btn btn-primary",
                        data: { turbo: false } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @quotations.respond_to?(:total_pages) && @quotations.total_pages.to_i > 1 %>
        <div class="card-footer border-0 bg-light">
          <div class="d-flex justify-content-center">
            <%= paginate @quotations %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>