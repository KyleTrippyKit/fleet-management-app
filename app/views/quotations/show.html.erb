<%# app/views/quotations/show.html.erb %>
<%= stylesheet_link_tag "agencies", media: "all", "data-turbo-track": "reload" %>

<%# Breadcrumb Navigation %>
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Quotations", quotations_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @quotation.quote_number %></li>
  </ol>
</nav>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <!-- Agency Header -->
      <%= render 'quotations/agency_header' %>

      <!-- Status and Quick Actions Bar -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
          <div class="row align-items-center">
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <span class="badge <%= @quotation.status_badge_class %> status-badge me-3">
                  <%= @quotation.display_status %>
                </span>
                <% if @quotation.expired? %>
                  <span class="badge bg-danger me-2">Expired</span>
                <% elsif @quotation.days_until_expiry %>
                  <span class="badge <%= @quotation.urgency_badge_class %>">
                    <i class="bi bi-clock me-1"></i>
                    <%= pluralize(@quotation.days_until_expiry, 'day') %> remaining
                  </span>
                <% end %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex justify-content-end flex-wrap gap-2">
                <%= link_to 'Print', print_quotation_path(@quotation), 
                    class: 'btn btn-outline-secondary', target: '_blank' %>
                <%= link_to 'Export CSV', export_quotations_path(format: :csv), 
                    class: 'btn btn-outline-info' %>
                <%= link_to 'Email', email_quotation_path(@quotation), 
                    class: 'btn btn-outline-primary' %>
                <%= link_to 'Back to List', quotations_path, 
                    class: 'btn btn-outline-dark' %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Row -->
      <div class="row">
        <!-- Left Column - Main Details -->
        <div class="col-lg-8">
          <!-- Quotation Details Card -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-file-text me-2"></i>
                QUOTATION DETAILS
              </h5>
            </div>
            <div class="card-body p-4">
              <div class="row">
                <!-- Left Column - Quotation Information -->
                <div class="col-md-6">
                  <div class="mb-4">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">QUOTATION INFORMATION</h6>
                    <table class="table table-sm table-borderless">
                      <tbody>
                        <tr>
                          <td class="text-muted" style="width: 40%">RFQ Number:</td>
                          <td class="fw-bold"><%= @quotation.quote_number %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Date Issued:</td>
                          <td class="fw-bold"><%= @quotation.created_at.strftime("%d %B, %Y") %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Prepared By:</td>
                          <td class="fw-bold"><%= @quotation.created_by&.name || @quotation.created_by&.email || 'System' %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Quotation Type:</td>
                          <td class="fw-bold">Vehicle Fleet Services</td>
                        </tr>
                        <tr>
                          <td class="text-muted">Response Due:</td>
                          <td class="fw-bold <%= @quotation.expired? ? 'text-danger' : 'text-success' %>">
                            <%= @quotation.valid_to&.strftime("%d %B, %Y") || "14 days from issue" %>
                            <% if @quotation.valid_to %>
                              <br><small class="text-muted">(Closes at 16:00 hrs)</small>
                            <% end %>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  <!-- Financial Summary -->
                  <div class="mb-4">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">FINANCIAL SUMMARY</h6>
                    <div class="card border">
                      <div class="card-body p-3">
                        <table class="table table-sm table-borderless mb-0">
                          <tbody>
                            <tr>
                              <td class="text-muted">Subtotal:</td>
                              <td class="text-end fw-bold"><%= @quotation.formatted_amount %></td>
                            </tr>
                            <tr>
                              <td class="text-muted">VAT (12.5%):</td>
                              <td class="text-end fw-bold"><%= number_to_currency(@quotation.vat_amount) %></td>
                            </tr>
                            <tr class="border-top">
                              <td class="text-muted">Total Amount:</td>
                              <td class="text-end fw-bold fs-5"><%= @quotation.formatted_amount_with_vat %></td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Right Column - Vehicle & Vendor Information -->
                <div class="col-md-6">
                  <div class="row">
                    <!-- Vehicle Information -->
                    <div class="col-12 mb-4">
                      <h6 class="text-uppercase text-muted small fw-bold mb-3">VEHICLE INFORMATION</h6>
                      <% if @quotation.vehicle %>
                        <div class="card border">
                          <div class="card-body p-3">
                            <div class="row align-items-center">
                              <div class="col-auto">
                                <div class="vehicle-icon text-center">
                                  <i class="bi bi-<%= @quotation.vehicle.vehicle_type == 'bus' ? 'bus-front' : 
                                                      @quotation.vehicle.vehicle_type == 'truck' ? 'truck' : 
                                                      @quotation.vehicle.vehicle_type == 'van' ? 'van' : 
                                                      'car-front' %> fa-2x text-primary"></i>
                                </div>
                              </div>
                              <div class="col">
                                <table class="table table-sm table-borderless mb-0">
                                  <tbody>
                                    <tr>
                                      <td class="text-muted" style="width: 40%">Registration:</td>
                                      <td class="fw-bold"><%= @quotation.vehicle.license_plate %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">Make/Model:</td>
                                      <td class="fw-bold"><%= @quotation.vehicle.make %> <%= @quotation.vehicle.model %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">Year:</td>
                                      <td class="fw-bold"><%= @quotation.vehicle.year_of_manufacture %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">VIN/Chassis:</td>
                                      <td class="fw-bold"><%= @quotation.vehicle.chassis_number || 'N/A' %></td>
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% else %>
                        <div class="alert alert-warning">
                          <i class="bi bi-exclamation-triangle me-2"></i>
                          No vehicle assigned to this quotation
                        </div>
                      <% end %>
                    </div>

                    <!-- Vendor Information -->
                    <div class="col-12">
                      <h6 class="text-uppercase text-muted small fw-bold mb-3">VENDOR INFORMATION</h6>
                      <div class="card border-success">
                        <div class="card-header bg-success bg-opacity-10 border-success py-2">
                          <h6 class="mb-0 fw-bold"><i class="bi bi-building me-2"></i><%= @quotation.vendor %></h6>
                        </div>
                        <div class="card-body">
                          <p class="mb-2 small">
                            <i class="bi bi-card-checklist me-1"></i>
                            <strong>Vendor Requirements:</strong>
                          </p>
                          <ul class="mb-0 small">
                            <li>Valid Certificate of Compliance (BIR)</li>
                            <li>Company Registration Certificate</li>
                            <li>VAT Registration Certificate</li>
                            <li>Valid Insurance Certificate</li>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Requirements and Specifications -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-clipboard-check me-2"></i>
                SCOPE OF WORK / ITEMS REQUIRED
              </h5>
            </div>
            <div class="card-body p-4">
              <!-- Requirements Table -->
              <div class="table-responsive mb-4">
                <table class="table table-bordered table-hover">
                  <thead class="table-light">
                    <tr>
                      <th width="5%" class="text-center">#</th>
                      <th width="55%">DESCRIPTION OF SERVICES / ITEMS</th>
                      <th width="15%" class="text-center">QTY</th>
                      <th width="15%" class="text-center">UNIT PRICE (TTD)</th>
                      <th width="10%" class="text-center">TOTAL (TTD)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if @quotation.line_items.any? %>
                      <% @quotation.line_items.each_with_index do |item, index| %>
                        <tr>
                          <td class="text-center align-middle"><%= index + 1 %></td>
                          <td class="align-middle">
                            <strong><%= item.description %></strong>
                            <% if item.specifications.present? %>
                              <br><small class="text-muted"><%= item.specifications %></small>
                            <% end %>
                          </td>
                          <td class="text-center align-middle"><%= item.quantity %></td>
                          <td class="text-center align-middle">$<%= number_with_precision(item.unit_price, precision: 2) %></td>
                          <td class="text-center align-middle fw-bold">$<%= number_with_precision(item.total_price, precision: 2) %></td>
                        </tr>
                      <% end %>
                    <% else %>
                      <!-- Default single line item -->
                      <tr>
                        <td class="text-center align-middle">1</td>
                        <td class="align-middle">
                          <strong>Vehicle Maintenance & Repair Services</strong><br>
                          <small class="text-muted">
                            Comprehensive maintenance as per <%= @quotation.vehicle&.make || 'vehicle' %> requirements. 
                            Includes parts, labor, and 90-day warranty on all repairs.
                          </small>
                        </td>
                        <td class="text-center align-middle">1</td>
                        <td class="text-center align-middle"><%= @quotation.formatted_amount %></td>
                        <td class="text-center align-middle fw-bold"><%= @quotation.formatted_amount %></td>
                      </tr>
                    <% end %>
                    
                    <!-- Summary Rows -->
                    <tr class="table-light">
                      <td colspan="4" class="text-end fw-bold">SUBTOTAL (TTD)</td>
                      <td class="text-center fw-bold"><%= @quotation.formatted_amount %></td>
                    </tr>
                    <tr class="table-light">
                      <td colspan="4" class="text-end fw-bold">VAT (12.5%)</td>
                      <td class="text-center fw-bold"><%= number_to_currency(@quotation.vat_amount) %></td>
                    </tr>
                    <tr class="table-active">
                      <td colspan="4" class="text-end fw-bold fs-5">TOTAL AMOUNT (TTD)</td>
                      <td class="text-center fw-bold fs-5"><%= @quotation.formatted_amount_with_vat %></td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Special Requirements -->
              <div class="row">
                <div class="col-md-6">
                  <div class="card border-info">
                    <div class="card-header bg-info bg-opacity-10 border-info py-2">
                      <h6 class="mb-0 fw-bold"><i class="bi bi-tools me-2"></i>SERVICE REQUIREMENTS</h6>
                    </div>
                    <div class="card-body">
                      <ul class="mb-0 small">
                        <li>All work must comply with manufacturer specifications</li>
                        <li>Use only genuine or OEM-equivalent parts</li>
                        <li>Complete diagnostic report required</li>
                        <li>90-day warranty on all parts and labor</li>
                        <li>Environmental compliance for waste disposal</li>
                        <li>24-hour emergency service available</li>
                      </ul>
                    </div>
                  </div>
                </div>
                
                <div class="col-md-6">
                  <div class="card border-warning">
                    <div class="card-header bg-warning bg-opacity-10 border-warning py-2">
                      <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2"></i>DELIVERY TIMELINE</h6>
                    </div>
                    <div class="card-body">
                      <table class="table table-sm table-borderless mb-0">
                        <tbody>
                          <tr>
                            <td class="text-muted">Quotation Submission:</td>
                            <td class="fw-bold"><%= @quotation.valid_to&.strftime("%d %b %Y") || "Within 7 days" %></td>
                          </tr>
                          <tr>
                            <td class="text-muted">Work Commencement:</td>
                            <td class="fw-bold">Within 3 days of PO</td>
                          </tr>
                          <tr>
                            <td class="text-muted">Work Completion:</td>
                            <td class="fw-bold">Maximum 10 working days</td>
                          </tr>
                          <tr>
                            <td class="text-muted">Final Report:</td>
                            <td class="fw-bold">Within 24hrs of completion</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Notes Section (if present) -->
          <% if @quotation.notes.present? %>
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold">
                  <i class="bi bi-chat-left-text me-2"></i>
                  ADDITIONAL NOTES
                </h5>
              </div>
              <div class="card-body">
                <%= simple_format(@quotation.notes, class: 'mb-0') %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column - Timeline and Actions -->
        <div class="col-lg-4">
          <!-- Timeline -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-clock-history me-2"></i>
                QUOTATION TIMELINE
              </h5>
            </div>
            <div class="card-body">
              <div class="timeline">
                <% @timeline_events.each do |event| %>
                  <div class="timeline-item <%= event[:active] ? 'active' : '' %>">
                    <div class="timeline-point"></div>
                    <div class="ms-4">
                      <h6 class="fw-bold mb-1"><%= event[:event] %></h6>
                      <p class="text-muted mb-1 small"><%= event[:date]&.strftime('%d %B, %Y %I:%M %p') %></p>
                      <p class="mb-0 small"><%= event[:description] %></p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Contact Information -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-telephone me-2"></i>
                CONTACT INFORMATION
              </h5>
            </div>
            <div class="card-body">
              <% agency = @quotation.vehicle&.agency %>
              <% if agency %>
                <h6 class="fw-bold mb-2"><%= agency.name %> Procurement</h6>
                <p class="mb-1 small">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= agency.code == 'PTSC' ? 'PTS House, South Quay' : 
                      agency.code == 'TTPS' ? 'Police Headquarters, St Vincent Street' :
                      agency.code == 'TTDF' ? 'Fire Headquarters, Wrightson Road' :
                      agency.code == 'VMCOTT' ? 'Ministry of Works, Port of Spain' :
                      'Administrative Office' %>, Port of Spain
                </p>
              <% end %>
              <p class="mb-1 small"><i class="bi bi-telephone me-1"></i> (868) 623-XXXXXX</p>
              <p class="mb-0 small"><i class="bi bi-envelope me-1"></i> procurement@<%= @quotation.vehicle&.agency&.code&.downcase || 'agency' %>.gov.tt</p>
            </div>
          </div>

          <!-- Terms and Submission -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-file-earmark-text me-2"></i>
                TERMS & SUBMISSION
              </h5>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <p class="fw-bold mb-2">Submission Methods:</p>
                <ul class="small mb-3">
                  <li><strong>Email:</strong> procurement@<%= @quotation.vehicle&.agency&.code&.downcase || 'agency' %>.gov.tt</li>
                  <li><strong>Subject:</strong> RFQ <%= @quotation.quote_number %> - [Your Company]</li>
                  <li><strong>Format:</strong> PDF documents only</li>
                </ul>
              </div>
              
              <div class="alert alert-<%= @quotation.expired? ? 'danger' : 'warning' %>">
                <div class="d-flex align-items-center">
                  <div class="me-3">
                    <i class="bi bi-<%= @quotation.expired? ? 'x-circle' : 'clock' %>-fill"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-1">
                      <%= @quotation.expired? ? 'QUOTATION CLOSED' : 'SUBMISSION DEADLINE' %>
                    </h6>
                    <p class="mb-0 small">
                      <% if @quotation.expired? %>
                        Closed on <strong><%= @quotation.valid_to.strftime("%d %B, %Y at 16:00") %></strong>
                      <% else %>
                        Due by <strong>16:00 hrs on <%= @quotation.valid_to&.strftime("%d %B, %Y") || "the closing date" %></strong>
                      <% end %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-lightning-charge me-2"></i>
                QUOTATION ACTIONS
              </h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <% if @quotation.can_be_edited? && current_user.can_edit_quotations? %>
                  <%= link_to 'Edit Quotation', edit_quotation_path(@quotation), class: 'btn btn-primary' %>
                <% end %>
                
                <%= link_to 'Duplicate', duplicate_quotation_path(@quotation), method: :get, class: 'btn btn-outline-warning' %>
                
                <% if @quotation.can_be_sent? && current_user.can_send_quotations? %>
                  <%= link_to 'Send to Vendor', send_to_vendor_quotation_path(@quotation), method: :post, 
                      class: 'btn btn-info', data: { confirm: 'Send this quotation to vendor?' } %>
                <% end %>
                
                <% if @quotation.can_be_accepted? && current_user.can_accept_quotations? %>
                  <%= link_to 'Accept Quotation', accept_quotation_path(@quotation), method: :post, 
                      class: 'btn btn-success', data: { confirm: 'Accept this quotation?' } %>
                <% end %>
                
                <% if @quotation.can_be_rejected? && current_user.can_reject_quotations? %>
                  <%= button_to 'Reject Quotation', reject_quotation_path(@quotation), method: :post, 
                      class: 'btn btn-danger', data: { confirm: 'Reject this quotation?' } %>
                <% end %>
                
                <% if @quotation.can_be_converted_to_po? && current_user.can_convert_quotations_to_po? %>
                  <%= link_to 'Convert to PO', convert_to_purchase_order_quotation_path(@quotation), method: :post, 
                      class: 'btn btn-primary', data: { confirm: 'Convert to purchase order?' } %>
                <% end %>
                
                <% if @quotation.can_be_edited? && current_user.can_delete_quotations? %>
                  <%= link_to 'Delete Quotation', @quotation, method: :delete, 
                      class: 'btn btn-outline-danger mt-3', 
                      data: { confirm: 'Are you sure? This action cannot be undone.' } %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Custom CSS for Quotation View -->
<style>
  .agency-header-card {
    border-radius: 8px;
    overflow: hidden;
  }
  
  .table th {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .table td {
    vertical-align: middle;
  }
  
  .card {
    border-radius: 8px;
  }
  
  .alert {
    border-left-width: 4px;
  }
  
  .vehicle-icon {
    width: 60px;
    height: 60px;
    background: rgba(13, 110, 253, 0.1);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Status badges */
  .status-badge {
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 20px;
  }
  
  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 20px;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #dee2e6;
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: 20px;
  }
  
  .timeline-point {
    position: absolute;
    left: -20px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #dee2e6;
    border: 2px solid white;
    z-index: 1;
  }
  
  .timeline-item.active .timeline-point {
    background: #0d6efd;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .timeline {
      padding-left: 15px;
    }
    
    .timeline-point {
      left: -15px;
      width: 10px;
      height: 10px;
    }
  }
  
  /* Print styles for browser print */
  @media print {
    .btn, .action-buttons, .card:last-child, .breadcrumb, nav {
      display: none !important;
    }
    
    .card {
      border: 1px solid #000 !important;
      break-inside: avoid;
    }
    
    .alert {
      border: 1px solid #000 !important;
    }
    
    a[href]::after {
      content: none !important;
    }
    
    .timeline::before,
    .timeline-point {
      display: none !important;
    }
  }
</style>