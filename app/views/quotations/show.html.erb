<%# File: app/views/quotations/show.html.erb %>
<%= stylesheet_link_tag "agencies", media: "all", "data-turbo-track": "reload" %>

<!-- ===================== -->
<!-- BREADCRUMB -->
<!-- ===================== -->
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Quotations", quotations_path %></li>
    <li class="breadcrumb-item active"><%= @quotation.quote_number %></li>
  </ol>
</nav>

<!-- ===================== -->
<!-- LOCK NOTICE -->
<!-- ===================== -->
<% if @quotation.sent? %>
  <div class="alert alert-success d-flex align-items-center mb-4">
    <i class="bi bi-lock-fill me-3 fs-4"></i>
    <div>
      <strong>Quotation submitted to agency.</strong><br>
      This document is locked and can no longer be edited.
    </div>
  </div>
<% end %>

<div class="container-fluid py-4">

  <!-- WATERMARK -->
  <% if @quotation.sent? %>
    <div class="pdf-watermark">LOCKED – SUBMITTED</div>
  <% end %>

  <div class="row">

    <!-- ===================== -->
    <!-- LEFT COLUMN -->
    <!-- ===================== -->
    <div class="col-lg-8">

      <!-- QUOTATION DETAILS -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-file-text me-2"></i>
            QUOTATION DETAILS
          </h5>
        </div>

        <div class="card-body">
          <table class="table table-sm table-borderless">
            <tbody>
              <tr>
                <td class="text-muted">Quotation #</td>
                <td class="fw-bold"><%= @quotation.quote_number %></td>
              </tr>
              <tr>
                <td class="text-muted">Vendor</td>
                <td class="fw-bold"><%= @quotation.vendor %></td>
              </tr>
              <tr>
                <td class="text-muted">Agency</td>
                <td class="fw-bold"><%= @quotation.agency_name %></td>
              </tr>
              <tr>
                <td class="text-muted">Prepared By</td>
                <td><%= @quotation.created_by&.name || @quotation.created_by&.email || "System" %></td>
              </tr>
              <tr>
                <td class="text-muted">Date Issued</td>
                <td><%= @quotation.created_at.strftime("%d %B, %Y") %></td>
              </tr>
              <tr>
                <td class="text-muted">Valid Until</td>
                <td>
                  <%= @quotation.valid_to&.strftime("%d %B, %Y") %>
                  <% if @quotation.days_until_expiry.present? %>
                    <span class="badge bg-warning ms-2">
                      <%= pluralize(@quotation.days_until_expiry, "day") %> left
                    </span>
                  <% end %>
                </td>
              </tr>
              <tr>
                <td class="text-muted">Status</td>
                <td>
                  <span class="badge <%= @quotation.status_badge_class %>">
                    <%= @quotation.display_status %>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ===================== -->
      <!-- SCOPE OF WORK -->
      <!-- ===================== -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-clipboard-check me-2"></i>
            SCOPE OF WORK
          </h5>
        </div>

        <div class="card-body p-0">
          <table class="table table-bordered mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Description</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>

            <tbody>
              <% @quotation.quotation_line_items.each_with_index do |item, i| %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td>
                    <strong><%= item.description %></strong>
                    <% if item.specifications.present? %>
                      <br>
                      <small class="text-muted"><%= item.specifications %></small>
                    <% end %>
                  </td>
                  <td class="text-center"><%= item.quantity %></td>
                  <td class="text-end"><%= number_to_currency(item.unit_price) %></td>
                  <td class="text-end fw-bold">
                    <%= number_to_currency(item.quantity.to_f * item.unit_price.to_f) %>
                  </td>
                </tr>
              <% end %>

              <%# ✅ EMPTY STATE (ADDED) %>
              <% if @quotation.quotation_line_items.empty? %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">
                    No line items on this quotation.
                  </td>
                </tr>
              <% end %>

              <tr class="table-light">
                <td colspan="4" class="text-end fw-bold">SUBTOTAL</td>
                <td class="text-end fw-bold"><%= @quotation.formatted_amount %></td>
              </tr>
              <tr class="table-light">
                <td colspan="4" class="text-end fw-bold">VAT (12.5%)</td>
                <td class="text-end fw-bold"><%= number_to_currency(@quotation.vat_amount) %></td>
              </tr>
              <tr class="table-active">
                <td colspan="4" class="text-end fw-bold fs-5">TOTAL</td>
                <td class="text-end fw-bold fs-5"><%= @quotation.formatted_amount_with_vat %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- NOTES -->
      <% if @quotation.notes.present? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-light">
            <h5 class="mb-0 fw-bold">
              <i class="bi bi-chat-left-text me-2"></i>
              NOTES
            </h5>
          </div>
          <div class="card-body">
            <%= simple_format(@quotation.notes) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- ===================== -->
    <!-- RIGHT COLUMN -->
    <!-- ===================== -->
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-lightning-charge me-2"></i>
            ACTIONS
          </h5>
        </div>

        <div class="card-body d-grid gap-2">

          <% if @quotation.sent? %>
            <span class="badge bg-success py-2 text-center">
              <i class="bi bi-lock-fill me-1"></i>
              LOCKED – Submitted to Agency
            </span>
          <% end %>

          <% if @quotation.can_be_edited? && current_user.agency&.code == "VMCOTT" %>
            <%= link_to edit_quotation_path(@quotation),
                  class: "btn btn-outline-secondary" do %>
              <i class="bi bi-pencil"></i> Edit
            <% end %>
          <% end %>

          <% if @quotation.can_be_sent? && current_user.agency&.code == "VMCOTT" %>
            <%= button_to submit_to_agency_quotation_path(@quotation),
                  method: :post,
                  class: "btn btn-success",
                  data: {
                    turbo_confirm: "Submit quotation to agency?\n\nThis will LOCK the quotation and prevent further edits."
                  } do %>
              <i class="bi bi-send-fill"></i> Submit to Agency
            <% end %>
          <% end %>

          <% if current_user.agency&.code != "VMCOTT" && @quotation.sent? %>
            <%= button_to accept_quotation_path(@quotation),
                  method: :post,
                  class: "btn btn-success" do %>
              <i class="bi bi-check-circle"></i> Accept
            <% end %>

            <%= button_to reject_quotation_path(@quotation),
                  method: :post,
                  class: "btn btn-danger" do %>
              <i class="bi bi-x-circle"></i> Reject
            <% end %>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
.pdf-watermark {
  position: fixed;
  top: 40%;
  left: 10%;
  font-size: 70px;
  color: rgba(200,0,0,0.15);
  transform: rotate(-30deg);
  pointer-events: none;
  z-index: 999;
}
</style>
