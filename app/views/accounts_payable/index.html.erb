<%# app/views/payables/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">💰 Accounts Payable</h1>
      <p class="text-muted">Manage all outstanding payables and track payments</p>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Total Payables</h5>
          <h2 class="display-6"><%= number_to_currency(@payables.total_count) %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Open</h5>
          <h2 class="display-6"><%= number_to_currency(@total_open) %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-danger text-white">
        <div class="card-body">
          <h5 class="card-title">Overdue</h5>
          <h2 class="display-6"><%= number_to_currency(@total_overdue) %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Paid</h5>
          <h2 class="display-6"><%= number_to_currency(@payables.paid.sum(:amount)) %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly Breakdown Chart -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">📊 Monthly Payables Breakdown</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <% @monthly_breakdown.each do |month, amount| %>
          <div class="col-md-3 mb-2">
            <div class="d-flex justify-content-between align-items-center p-2 border rounded">
              <span><strong><%= month %></strong></span>
              <span class="badge bg-primary"><%= number_to_currency(amount) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">🔍 Filter Payables</h5>
    </div>
    <div class="card-body">
      <%= form_with url: payables_path, method: :get, local: true, class: "row g-3" do |f| %>
        <div class="col-md-3">
          <%= f.select :status, 
                options_for_select([['All Statuses', ''], ['Open', 'open'], ['Paid', 'paid'], ['Overdue', 'overdue']], params[:status]),
                {}, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= f.select :vendor_id, 
                options_for_select(Supplier.all.map { |s| [s.name, s.id] }, params[:vendor_id]),
                { include_blank: 'All Vendors' }, class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= f.date_field :date_from, value: params[:date_from], class: "form-control", placeholder: "From Date" %>
        </div>
        <div class="col-md-2">
          <%= f.date_field :date_to, value: params[:date_to], class: "form-control", placeholder: "To Date" %>
        </div>
        <div class="col-md-2">
          <%= f.submit "Apply Filters", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Payables Table -->
  <div class="card">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">📋 Payables List</h5>
      <%= link_to new_payable_path, class: "btn btn-sm btn-success" do %>
        <i class="bi bi-plus-circle me-1"></i> New Payable
      <% end %>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Reference</th>
              <th>Vendor</th>
              <th>Description</th>
              <th>Due Date</th>
              <th class="text-end">Amount</th>
              <th class="text-end">Amount Due</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @payables.each do |payable| %>
              <tr class="<%= 'table-danger' if payable.overdue? %>">
                <td><strong>#<%= payable.id %></strong></td>
                <td><%= payable.reference_number %></td>
                <td>
                  <%= payable.vendor_name %>
                  <% 
                    # FIXED: Use vendor_info method instead of payable.vendor
                    vendor = payable.vendor_info 
                  %>
                  <% if vendor %>
                    <br><small class="text-muted"><%= vendor.contact_person %></small>
                  <% end %>
                </td>
                <td><%= truncate(payable.description, length: 50) %></td>
                <td>
                  <%= payable.due_date.strftime("%b %d, %Y") %>
                  <% if payable.overdue? %>
                    <br><small class="text-danger"><%= payable.days_overdue %> days overdue</small>
                  <% end %>
                </td>
                <td class="text-end"><%= number_to_currency(payable.amount) %></td>
                <td class="text-end"><strong><%= number_to_currency(payable.amount_due) %></strong></td>
                <td>
                  <span class="badge bg-<%= 
                    case payable.status
                    when 'open' then 'warning'
                    when 'partially_paid' then 'info'
                    when 'paid' then 'success'
                    when 'overdue' then 'danger'
                    else 'secondary'
                    end %>">
                    <%= payable.status.humanize %>
                  </span>
                </td>
                <td>
                  <div class="btn-group">
                    <%= link_to payable_path(payable), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if payable.open? || payable.partially_paid? %>
                      <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" 
                              data-bs-target="#paymentModal<%= payable.id %>" title="Record Payment">
                        <i class="bi bi-cash"></i>
                      </button>
                    <% end %>
                    <% if payable.open? && (current_user.finance? || current_user.admin?) %>
                      <%= link_to edit_payable_path(payable), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </div>

                  <!-- Payment Modal -->
                  <div class="modal fade" id="paymentModal<%= payable.id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                          <h5 class="modal-title">Record Payment - <%= payable.reference_number %></h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <%= form_with url: record_payment_payable_path(payable), method: :post, local: true do |f| %>
                          <div class="modal-body">
                            <div class="mb-3">
                              <label class="form-label">Payment Amount</label>
                              <%= f.number_field :amount, class: "form-control", 
                                    value: payable.amount_due, 
                                    max: payable.amount_due, 
                                    step: 0.01, 
                                    required: true %>
                              <small class="text-muted">Maximum: <%= number_to_currency(payable.amount_due) %></small>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Payment Method</label>
                              <%= f.select :payment_method, 
                                    options_for_select([['Bank Transfer', 'bank_transfer'], 
                                                       ['Cheque', 'cheque'], 
                                                       ['Cash', 'cash'], 
                                                       ['Credit Card', 'credit_card']]),
                                    {}, class: "form-select" %>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Reference Number</label>
                              <%= f.text_field :reference_number, class: "form-control", 
                                    placeholder: "e.g., Cheque #, Transaction ID" %>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Payment Date</label>
                              <%= f.date_field :payment_date, value: Date.current, class: "form-control" %>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Notes</label>
                              <%= f.text_area :notes, class: "form-control", rows: 2 %>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <%= f.submit "Record Payment", class: "btn btn-success" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if @payables.respond_to?(:total_pages) %>
        <div class="d-flex justify-content-center mt-4">
          <%= paginate @payables %>
        </div>
      <% end %>
    </div>
  </div>
</div>