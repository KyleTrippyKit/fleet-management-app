<%# File: app/views/maintenances/_form.html.erb %>

<% form_model = (@vehicle.present? ? [@vehicle, @maintenance] : @maintenance) %>

<%= form_with(model: form_model, local: true, html: { multipart: true, class: "needs-validation", novalidate: true, data: { controller: "maintenance-form" } }) do |f| %>

  <% if @maintenance.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show">
      <h5 class="mb-2"><%= pluralize(@maintenance.errors.count, "error") %> prevented this maintenance from saving:</h5>
      <ul class="mb-0">
        <% @maintenance.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="row g-4">
    <!-- LEFT -->
    <div class="col-12 col-lg-7">

      <div class="p-3 p-md-4 border rounded-3 bg-light">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <h5 class="mb-0 fw-bold">Maintenance Details</h5>
          <span class="text-muted small">Fields marked * are required</span>
        </div>

        <div class="row g-3">
          <!-- ASSIGNMENT TYPE - REMOVED (handled by hidden field) -->

          <div class="col-12 col-md-6">
            <%= f.label :urgency, "Urgency", class: "form-label fw-semibold" %>
            <div class="d-flex align-items-center gap-2">
              <%= f.select :urgency,
                    options_for_select(Maintenance.urgencies.keys.map { |u| [u.titleize, u] }, @maintenance.urgency),
                    { prompt: "Select urgency" },
                    class: "form-select",
                    id: "urgency_select" %>

              <span id="urgency_badge_preview">
                <% if @maintenance.urgency.present? %>
                  <%= content_tag(:span, @maintenance.urgency.titleize,
                        class: "badge #{@maintenance.urgency_badge_class}") %>
                <% end %>
              </span>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <%= f.label :start_date, "Start Date *", class: "form-label fw-semibold" %>
            <%= f.text_field :start_date,
                  class: "form-control datepicker",
                  autocomplete: "off",
                  required: true,
                  value: @maintenance.start_date || Date.today %>
            <div class="invalid-feedback">Please enter a start date.</div>
          </div>

          <div class="col-12 col-md-6">
            <%= f.label :end_date, "End Date *", class: "form-label fw-semibold" %>
            <%= f.text_field :end_date,
                  class: "form-control datepicker",
                  autocomplete: "off",
                  required: true,
                  value: @maintenance.end_date || Date.today + 7.days %>
            <div class="invalid-feedback">Please enter an end date.</div>
            <div class="form-text">Required for Gantt timeline view</div>
          </div>

          <!-- MAINTENANCE DATE - REMOVED -->
          <!-- NEXT DUE DATE - REMOVED -->
          <!-- REMINDER SENT DATE - REMOVED -->
          <!-- STATUS - REMOVED -->

          <div class="col-12">
            <%= f.label :service_type, "Service Type *", class: "form-label fw-semibold" %>
            <%= f.text_field :service_type,
                  class: "form-control",
                  placeholder: "e.g., Oil Change, Brake Service, Tire Rotation",
                  required: true %>
            <div class="invalid-feedback">Please enter a service type.</div>
          </div>

          <div class="col-12 col-md-6">
            <%= f.label :category, "Category", class: "form-label fw-semibold" %>
            <%= f.select :category,
                  options_for_select(Maintenance::CATEGORIES, @maintenance.category),
                  { prompt: "Select category" },
                  class: "form-select" %>
          </div>

          <div class="col-12 col-md-6">
            <%= f.label :agency_id, "Agency", class: "form-label fw-semibold" %>
            <%= f.collection_select :agency_id, 
                  Agency.all.order(:name), 
                  :id, 
                  :name,
                  { prompt: "Select Agency (e.g., PTSC, TTPS, etc.)" },
                  class: "form-select" %>
          </div>

          <!-- COST - KEPT -->
          <div class="col-12 col-md-6">
            <%= f.label :cost, "Cost (TTD)", class: "form-label fw-semibold" %>
            <div class="input-group">
              <span class="input-group-text">TTD</span>
              <%= f.number_field :cost, class: "form-control", step: 0.01, placeholder: "0.00" %>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="col-12 col-lg-5">

      <div class="p-3 p-md-4 border rounded-3 bg-white shadow-sm">
        <h5 class="fw-bold mb-3">Vehicle & Mileage</h5>

        <% if @vehicle.present? %>
          <div class="mb-3">
            <% if @vehicle.primary_photo.attached? %>
              <%= image_tag url_for(@vehicle.primary_photo), class: "img-fluid rounded w-100", style: "max-height: 240px; object-fit: cover;" %>
            <% else %>
              <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:100%; height:240px;">
                <i class="bi bi-car-front text-muted" style="font-size: 4rem;"></i>
              </div>
            <% end %>

            <div class="mt-3">
              <div class="fw-bold"><%= @vehicle.make %> <%= @vehicle.model %></div>
              <div class="text-muted small">
                <%= @vehicle.registration_number.presence || @vehicle.license_plate.presence || "No ID" %>
              </div>
              <div class="mt-2">
                Owner:
                <span class="badge <%= owner_badge_class(@vehicle.service_owner) %>">
                  <%= @vehicle.service_owner %>
                </span>
              </div>
            </div>
            
            <!-- Hidden field for vehicle_id when vehicle is preselected -->
            <%= f.hidden_field :vehicle_id, value: @vehicle.id %>
          </div>
        <% else %>
          <!-- Vehicle Search - USING THE SAME WORKING PATTERN AS ALERTS -->
          <div class="mb-3 position-relative" data-controller="alert-search">
            <label class="form-label fw-semibold">Vehicle <span class="text-danger">*</span></label>

            <input type="text"
                   class="form-control"
                   placeholder="Search by license plate, make, or model... (min 2 chars)"
                   autocomplete="off"
                   data-alert-search-target="vehicleInput"
                   data-action="input->alert-search#vehicleInput"
                   data-search-url="<%= search_vehicles_path(format: :json) %>">

            <%= f.hidden_field :vehicle_id, 
                  value: @maintenance.vehicle_id,
                  data: { alert_search_target: "vehicleHidden" } %>

            <!-- Search results dropdown -->
            <div class="list-group position-absolute w-100 shadow"
                 style="z-index: 1055; display:none;"
                 data-alert-search-target="vehicleResults">
              <div data-alert-search-target="vehicleList"></div>
            </div>

            <!-- Selected vehicle chip -->
            <div class="mt-2" style="display:none;" data-alert-search-target="vehicleSelected">
              <div class="alert alert-info py-2 mb-0">
                <i class="bi bi-truck me-2"></i>
                <span data-alert-search-target="vehicleSelectedText"></span>
                <button type="button"
                        class="btn btn-sm btn-outline-danger float-end"
                        data-action="click->alert-search#clearVehicle">
                  <i class="bi bi-x"></i>
                </button>
              </div>
            </div>
          </div>
        <% end %>

        <!-- HIDDEN FIELD FOR ASSIGNMENT TYPE - Ensures valid value is submitted -->
        <%= f.hidden_field :assignment_type, value: 'stores' %>

        <!-- MILEAGE TRACKING SECTION - Using existing mileage field + virtual attributes -->
        <div class="row g-3 mt-2">
          <h6 class="fw-semibold mb-0">Mileage Tracking</h6>
          
          <div class="col-md-4">
            <%= f.label :mileage, "Current (km)", class: "form-label" %>
            <%= f.number_field :mileage, 
                class: "form-control", 
                placeholder: "e.g., 125000",
                min: 0,
                step: 1,
                value: @maintenance.mileage || @vehicle&.mileage,
                data: { 
                  maintenance_form_target: "currentMileage",
                  action: "input->maintenance-form#calculateKmLeft"
                } %>
            <% if @vehicle.present? && @vehicle.mileage.present? %>
              <small class="text-muted">Vehicle current: <%= @vehicle.mileage %> km</small>
            <% end %>
          </div>

          <div class="col-md-4">
            <label for="next_maintenance_mileage" class="form-label">Next Service (km)</label>
            <input type="number"
                   name="maintenance[next_maintenance_mileage]"
                   id="maintenance_next_maintenance_mileage"
                   class="form-control"
                   placeholder="e.g., 130000"
                   min="0"
                   step="1"
                   value="<%= @maintenance.instance_variable_get(:@next_maintenance_mileage) || '' %>"
                   data-maintenance-form-target="nextMileage"
                   data-action="input->maintenance-form#calculateKmLeft">
          </div>

          <div class="col-md-4">
            <label class="form-label">KM Until Service</label>
            <div class="form-control bg-light" 
                 style="height: 38px; display: flex; align-items: center;"
                 data-maintenance-form-target="kmLeft">
              —
            </div>
            <small class="text-muted">Auto-calculated</small>
          </div>
        </div>

        <!-- NOTES AND DETAILS -->
        <div class="row g-3 mt-3">
          <div class="col-12">
            <%= f.label :source, "Source", class: "form-label fw-semibold" %>
            <%= f.text_field :source, class: "form-control", placeholder: "e.g., Scheduled, Emergency, Inspection" %>
          </div>

          <div class="col-12">
            <%= f.label :technician, "Technician", class: "form-label fw-semibold" %>
            <%= f.text_field :technician, class: "form-control", placeholder: "Name of technician" %>
          </div>

          <!-- PART IN STOCK - REMOVED -->
          <!-- ESTIMATED DELIVERY DATE - REMOVED -->

          <div class="col-12">
            <%= f.label :notes, "Notes", class: "form-label fw-semibold" %>
            <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: "Enter any notes here" %>
          </div>

          <div class="col-12">
            <%= f.label :details, "Details", class: "form-label fw-semibold" %>
            <%= f.text_area :details, class: "form-control", rows: 4, placeholder: "Detailed description of the maintenance work..." %>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= f.submit(@maintenance.persisted? ? "Update Maintenance" : "Save Maintenance", class: "btn btn-primary px-4") %>

    <% if @vehicle.present? %>
      <%= link_to "Cancel", vehicle_path(@vehicle), class: "btn btn-outline-secondary" %>
    <% else %>
      <%= link_to "Cancel", maintenances_path, class: "btn btn-outline-secondary" %>
    <% end %>

    <%= link_to "View Timeline", gantt_path, class: "btn btn-outline-info ms-lg-auto" %>
  </div>

<% end %>

<!-- Add virtual attributes to the model for this request -->
<% content_for :head do %>
  <script>
    // This ensures the virtual attributes are recognized for this form submission
    document.addEventListener('turbo:load', function() {
      const form = document.querySelector('form.needs-validation');
      if (form) {
        form.addEventListener('submit', function() {
          // Add virtual attributes to the model instance for this request
          // The controller will need to handle these params
        });
      }
    });
  </script>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
    if (typeof flatpickr !== "undefined") {
      document.querySelectorAll(".datepicker").forEach((el) => {
        if (el._flatpickr) return;
        flatpickr(el, { dateFormat: "Y-m-d", allowInput: true });
      });
    }

    // Urgency badge preview
    const urgencySelect = document.getElementById("urgency_select");
    const badgePreview = document.getElementById("urgency_badge_preview");

    function updateUrgencyBadge(urgency) {
      if (!badgePreview) return;
      if (!urgency) { badgePreview.innerHTML = ""; return; }

      const u = urgency.toLowerCase();
      let label = urgency.charAt(0).toUpperCase() + urgency.slice(1);
      let cssClass = "badge bg-secondary";

      if (u === "emergency" || u === "high") cssClass = "badge bg-danger text-white";
      if (u === "medium" || u === "scheduled") cssClass = "badge bg-warning text-dark";
      if (u === "low" || u === "routine") cssClass = "badge bg-primary text-white";

      badgePreview.innerHTML = `<span class="${cssClass}">${label}</span>`;
    }

    urgencySelect?.addEventListener("change", (e) => updateUrgencyBadge(e.target.value));
    updateUrgencyBadge(urgencySelect?.value);

    // Bootstrap validation + date order
    document.querySelectorAll(".needs-validation").forEach((form) => {
      form.addEventListener("submit", (event) => {
        const startField = document.getElementById("maintenance_start_date");
        const endField   = document.getElementById("maintenance_end_date");

        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }

        if (startField?.value && endField?.value) {
          const start = new Date(startField.value);
          const end   = new Date(endField.value);

          if (end < start) {
            event.preventDefault();
            event.stopPropagation();
            endField.classList.add("is-invalid");
          } else {
            endField.classList.remove("is-invalid");
          }
        }

        form.classList.add("was-validated");
      }, false);
    });

    // Mileage calculator
    const currentInput = document.getElementById("maintenance_mileage");
    const nextInput = document.getElementById("maintenance_next_maintenance_mileage");
    const kmLeftDisplay = document.querySelector("[data-maintenance-form-target='kmLeft']");

    function calculateKmLeft() {
      if (!kmLeftDisplay) return;
      
      const current = parseFloat(currentInput?.value) || 0;
      const next = parseFloat(nextInput?.value) || 0;
      
      if (current > 0 && next > current) {
        const kmLeft = next - current;
        kmLeftDisplay.textContent = kmLeft.toLocaleString() + " km";
        kmLeftDisplay.style.color = kmLeft < 1000 ? "#dc3545" : "#198754";
        kmLeftDisplay.style.fontWeight = kmLeft < 1000 ? "bold" : "normal";
      } else {
        kmLeftDisplay.textContent = "—";
        kmLeftDisplay.style.color = "";
        kmLeftDisplay.style.fontWeight = "normal";
      }
    }

    if (currentInput) currentInput.addEventListener("input", calculateKmLeft);
    if (nextInput) nextInput.addEventListener("input", calculateKmLeft);
    
    // Initial calculation
    setTimeout(calculateKmLeft, 100);
  });
</script>