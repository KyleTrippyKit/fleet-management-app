<!-- app/views/maintenances/gantt.html.erb -->
<%= content_for :gantt_page do %>
  <!-- This marks the page as a Gantt page -->
<% end %>

<div class="container-fluid py-4">
  <!-- Debug Info -->
  <% if Rails.env.development? %>
    <div class="alert alert-info mb-4">
      <h5 class="alert-heading">Gantt Chart Status</h5>
      <p><strong>Maintenances found:</strong> <%= @maintenances.count %></p>
      <p><strong>Gantt tasks:</strong> <%= @gantt_tasks&.count || 0 %></p>
      <p><strong>Service Owners:</strong> <%= @service_owners&.join(", ") || "None" %></p>
      <p><strong>Data available:</strong> <%= @gantt_json.present? %></p>
    </div>
  <% end %>

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 mb-1">Maintenance Schedule Gantt Chart</h1>
      <p class="text-muted mb-0">Interactive timeline with drag-and-drop scheduling</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to maintenance_dashboard_vehicles_path, 
            class: "btn btn-outline-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-tools me-2"></i>Maintenance Dashboard
      <% end %>
      <%= link_to new_maintenance_path,
            class: "btn btn-primary d-flex align-items-center gap-2" do %>
        <i class="bi bi-plus-circle me-2"></i>New Maintenance
      <% end %>
    </div>
  </div>

  <!-- Enhanced Filters Card -->
  <div class="card shadow-sm mb-4 card-hover">
    <div class="card-body p-3">
      <%= form_with url: gantt_path, method: :get, local: true, class: "row g-2 align-items-center", id: "ganttFilters" do %>
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">View Mode</label>
          <select name="view_mode" id="viewMode" class="form-select form-select-sm auto-submit">
            <option value="day" <%= 'selected' if params[:view_mode] == 'day' %>>Day View</option>
            <option value="week" <%= 'selected' if params[:view_mode] == 'week' %>>Week View</option>
            <option value="month" <%= params[:view_mode].blank? || params[:view_mode] == 'month' ? 'selected' : '' %>>Month View</option>
            <option value="quarter" <%= 'selected' if params[:view_mode] == 'quarter' %>>Quarter View</option>
          </select>
        </div>
        
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">Date Range</label>
          <select name="date_range" id="dateRange" class="form-select form-select-sm auto-submit">
            <option value="all_time" <%= 'selected' if params[:date_range] == 'all_time' %>>All Time</option>
            
            <optgroup label="Past">
              <option value="last_7_days" <%= 'selected' if params[:date_range] == 'last_7_days' %>>Last 7 Days</option>
              <option value="last_30_days" <%= 'selected' if params[:date_range] == 'last_30_days' %>>Last 30 Days</option>
              <option value="last_3_months" <%= 'selected' if params[:date_range] == 'last_3_months' %>>Last 3 Months</option>
              <option value="last_6_months" <%= 'selected' if params[:date_range] == 'last_6_months' %>>Last 6 Months</option>
              <option value="last_year" <%= 'selected' if params[:date_range] == 'last_year' %>>Last Year</option>
            </optgroup>
            
            <optgroup label="Future">
              <option value="next_7_days" <%= 'selected' if params[:date_range] == 'next_7_days' %>>Next 7 Days</option>
              <option value="next_30_days" <%= 'selected' if params[:date_range] == 'next_30_days' || params[:date_range] == '30' %>>Next 30 Days</option>
              <option value="next_3_months" <%= 'selected' if params[:date_range] == 'next_3_months' || params[:date_range] == '90' %>>Next 3 Months</option>
              <option value="next_6_months" <%= 'selected' if params[:date_range] == 'next_6_months' || params[:date_range] == '180' %>>Next 6 Months</option>
              <option value="next_year" <%= 'selected' if params[:date_range] == 'next_year' || params[:date_range] == '365' %>>Next Year</option>
            </optgroup>
            
            <option value="custom" <%= 'selected' if params[:date_range] == 'custom' %>>Custom Range</option>
          </select>
        </div>
        
        <div class="col-md-3" id="customDateRange" style="display: <%= params[:date_range] == 'custom' ? 'block' : 'none' %>;">
          <div class="row g-1">
            <div class="col-6">
              <label class="form-label small fw-bold mb-1">Start Date</label>
              <input type="date" name="start_date" class="form-control form-control-sm auto-submit-date" 
                     value="<%= params[:start_date] || Date.today.strftime('%Y-%m-%d') %>">
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold mb-1">End Date</label>
              <input type="date" name="end_date" class="form-control form-control-sm auto-submit-date" 
                     value="<%= params[:end_date] || (Date.today + 90.days).strftime('%Y-%m-%d') %>">
            </div>
          </div>
        </div>
        
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">Service Owner</label>
          <%= select_tag :owner,
                options_for_select(["All Owners"] + @service_owners, params[:owner] || "All Owners"),
                class: "form-select form-select-sm auto-submit" %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">Status</label>
          <%= select_tag :status,
                options_for_select(["All Statuses", "Pending", "Completed", "In Progress", "Overdue"], params[:status] || "All Statuses"),
                class: "form-select form-select-sm auto-submit" %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">Vehicle Search</label>
          <div class="input-group input-group-sm">
            <%= text_field_tag :vehicle_search, params[:vehicle_search], 
                  class: "form-control auto-submit-vehicle",
                  placeholder: "Search by reg, make, model...",
                  id: "vehicleSearch" %>
            <button class="btn btn-outline-secondary" type="button" id="clearVehicleSearch" title="Clear search">
              <i class="bi bi-x"></i>
            </button>
          </div>
        </div>
        
        <div class="col-md-2">
          <label class="form-label small fw-bold mb-1">Specific Vehicle</label>
          <%= select_tag :vehicle_id,
                options_for_select([["All Vehicles", ""]] + @vehicles_for_filter.map { |v| ["#{v.make} #{v.model} (#{v.registration_number})", v.id] }, 
                                  params[:vehicle_id] || ""),
                class: "form-select form-select-sm auto-submit",
                id: "vehicleSelect" %>
        </div>
        
        <div class="col-md-2 d-flex align-items-end">
          <div class="d-flex gap-2 w-100">
            <%= submit_tag "Apply Filters", class: "btn btn-primary btn-sm flex-grow-1", id: "applyFilters" %>
            <button type="button" id="resetFilters" class="btn btn-outline-secondary btn-sm">Reset</button>
          </div>
        </div>
        
        <!-- Hidden fields to preserve vehicle_id when using search -->
        <%= hidden_field_tag :vehicle_id, params[:vehicle_id] if params[:vehicle_id].present? %>
      <% end %>
    </div>
  </div>

  <!-- Enhanced Statistics Cards -->
  <div class="row mb-4">
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
              <i class="bi bi-tools text-primary fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= @maintenances.count %></h3>
              <p class="text-muted mb-0 small">Total Tasks</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
              <i class="bi bi-clock text-warning fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= @maintenances.where(status: "Pending").count %></h3>
              <p class="text-muted mb-0 small">Pending</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
              <i class="bi bi-check-circle text-success fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= @maintenances.where(status: "Completed").count %></h3>
              <p class="text-muted mb-0 small">Completed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
              <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= @overdue_count || 0 %></h3>
              <p class="text-muted mb-0 small">Overdue</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
              <i class="bi bi-truck text-info fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= @vehicles_count || 0 %></h3>
              <p class="text-muted mb-0 small">Vehicles</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-2 col-md-4">
      <div class="card border-0 shadow-sm h-100 card-hover">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-dark bg-opacity-10 p-3 me-3">
              <i class="bi bi-currency-dollar text-dark fs-4"></i>
            </div>
            <div>
              <h3 class="mb-0"><%= number_to_currency(@total_cost || 0, unit: "TTD ") %></h3>
              <p class="text-muted mb-0 small">Total Cost</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @gantt_tasks&.any? %>
    <!-- Store data for JavaScript -->
    <div id="ganttData" style="display: none;" data-gantt-tasks='<%= @gantt_json %>'></div>

    <!-- Enhanced Gantt Container -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Maintenance Timeline</h5>
        <div class="d-flex align-items-center gap-2">
          <div class="legend d-flex gap-3">
            <div class="d-flex align-items-center gap-1">
              <div class="legend-color" style="background-color: #6c757d;"></div>
              <span class="small text-muted">Vehicle</span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <div class="legend-color" style="background-color: #198754;"></div>
              <span class="small text-muted">Completed</span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <div class="legend-color" style="background-color: #ffc107;"></div>
              <span class="small text-muted">Pending</span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <div class="legend-color" style="background-color: #dc3545;"></div>
              <span class="small text-muted">Overdue</span>
            </div>
          </div>
          <button class="btn btn-sm btn-outline-secondary me-2" onclick="if (window.gantt) gantt.fitContent();">
            <i class="bi bi-zoom-in"></i> Fit Content
          </button>
          <button class="btn btn-sm btn-outline-secondary" id="fullscreenBtn">
            <i class="bi bi-arrows-fullscreen"></i>
          </button>
        </div>
      </div>
      <div class="card-body p-0">
        <div id="ganttContainer" style="width: 100%; height: 600px;"></div>
      </div>
    </div>

    <!-- Maintenance List -->
    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <h5 class="mb-0">Maintenance Details</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Vehicle</th>
                <th>Service Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Urgency</th>
                <th>Cost (TTD)</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @maintenances.each do |maintenance| %>
                <tr>
                  <td>
                    <div class="fw-medium">
                      <%= maintenance.vehicle&.make %> <%= maintenance.vehicle&.model %>
                    </div>
                    <div class="small text-muted">
                      <%= maintenance.vehicle&.registration_number %>
                    </div>
                  </td>
                  <td>
                    <div class="fw-medium"><%= maintenance.service_type %></div>
                    <% if maintenance.category.present? %>
                      <div class="small text-muted"><%= maintenance.category %></div>
                    <% end %>
                  </td>
                  <td>
                    <%= maintenance.start_date&.strftime("%b %d, %Y") || "Not set" %>
                  </td>
                  <td>
                    <%= maintenance.end_date&.strftime("%b %d, %Y") || "Not set" %>
                  </td>
                  <td>
                    <span class="badge <%= maintenance.status == 'Completed' ? 'bg-success' : 'bg-warning' %>">
                      <%= maintenance.status %>
                    </span>
                    <% if maintenance.overdue? %>
                      <span class="badge bg-danger ms-1">Overdue</span>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge bg-<%= maintenance.urgency == 'high' ? 'danger' : maintenance.urgency == 'medium' ? 'warning' : 'secondary' %>">
                      <%= maintenance.urgency&.titleize || "Normal" %>
                    </span>
                  </td>
                  <td class="fw-medium">
                    <%= number_to_currency(maintenance.cost || 0, unit: "TTD ") %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <%= link_to edit_maintenance_path(maintenance), 
                            class: "btn btn-sm btn-outline-warning", 
                            title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= link_to maintenance_path(maintenance), 
                            class: "btn btn-sm btn-outline-primary",
                            title: "View" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      <% if maintenance.status == 'Pending' %>
                        <%= link_to mark_completed_maintenance_path(maintenance),
                              method: :patch,
                              data: { confirm: "Mark as completed?" },
                              class: "btn btn-sm btn-outline-success",
                              title: "Mark Completed" do %>
                          <i class="bi bi-check-circle"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Enhanced Gantt JavaScript -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Starting Gantt initialization...');
        
        // Function to check if Gantt is loaded
        function checkGanttLoaded() {
          if (typeof gantt !== 'undefined') {
            console.log('✅ DHTMLX Gantt is loaded');
            initializeGantt();
            return true;
          }
          return false;
        }
        
        // Try immediately
        if (!checkGanttLoaded()) {
          console.log('⏳ Gantt not loaded yet, waiting...');
          // Try every 500ms for 5 seconds
          let attempts = 0;
          const maxAttempts = 10;
          const interval = setInterval(function() {
            attempts++;
            if (checkGanttLoaded()) {
              clearInterval(interval);
            } else if (attempts >= maxAttempts) {
              clearInterval(interval);
              console.error('❌ Failed to load Gantt after', maxAttempts * 500, 'ms');
              showError('Failed to load Gantt chart library. Please refresh the page.');
            }
          }, 500);
        }
        
        // Initialize auto-submit functionality
        initializeAutoSubmit();
        
        // Initialize form toggles
        const dateRangeSelect = document.getElementById('dateRangeSelect');
        const customDateRange = document.getElementById('customDateRange');
        
        if (dateRangeSelect && customDateRange) {
          dateRangeSelect.addEventListener('change', function() {
            customDateRange.style.display = this.value === 'custom' ? 'block' : 'none';
          });
        }
        
        // Fullscreen button
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const ganttContainer = document.getElementById('ganttContainer');
        
        if (fullscreenBtn && ganttContainer) {
          fullscreenBtn.addEventListener('click', function() {
            if (!document.fullscreenElement) {
              ganttContainer.requestFullscreen().catch(err => {
                console.log(`Error attempting fullscreen: ${err.message}`);
              });
            } else {
              document.exitFullscreen();
            }
          });
        }
      });
      
      function initializeGantt() {
        // Get data
        const dataElement = document.getElementById('ganttData');
        if (!dataElement) {
          console.error('❌ No Gantt data element found');
          showError('No data available');
          return;
        }
        
        const rawData = dataElement.dataset.ganttTasks;
        if (!rawData) {
          console.error('❌ No Gantt data found');
          showError('No data available');
          return;
        }
        
        try {
          const parsedData = JSON.parse(rawData);
          console.log('✅ Data parsed successfully, tasks:', parsedData.data?.length || 0);
          
          // Enhanced Gantt configuration
          gantt.config.date_format = "%Y-%m-%d %H:%i";
          gantt.config.scale_height = 50;
          gantt.config.row_height = 35;
          gantt.config.bar_height = 20;
          gantt.config.grid_width = 350;
          
          // Enhanced columns
          gantt.config.columns = [
            { name: "text", label: "Task", width: 250, tree: true },
            { name: "start_date", label: "Start", align: "center", width: 100 },
            { name: "end_date", label: "End", align: "center", width: 100 },
            { 
              name: "status", 
              label: "Status", 
              align: "center", 
              width: 100, 
              template: function(task) {
                const status = task.details?.status || task.status || 'Pending';
                let badgeClass = "badge bg-secondary";
                if (status === "Completed") badgeClass = "badge bg-success";
                if (status === "Pending") badgeClass = "badge bg-warning";
                if (status === "In Progress") badgeClass = "badge bg-info";
                return `<span class="${badgeClass}">${status}</span>`;
              }
            },
            { 
              name: "urgency", 
              label: "Urgency", 
              align: "center", 
              width: 90,
              template: function(task) {
                const urgency = task.details?.urgency || task.urgency || 'normal';
                let badgeClass = "badge bg-secondary";
                if (urgency === "high" || urgency === "emergency") badgeClass = "badge bg-danger";
                if (urgency === "medium") badgeClass = "badge bg-warning text-dark";
                if (urgency === "low") badgeClass = "badge bg-primary";
                return `<span class="${badgeClass}">${urgency}</span>`;
              }
            }
          ];
          
          // Enhanced time scale
          gantt.config.scales = [
            { unit: "month", step: 1, format: "%F %Y" },
            { unit: "week", step: 1, format: "Week #%W" }
          ];
          
          // Enhanced tooltip
          gantt.templates.tooltip_text = function(start, end, task) {
            if (task.type === 'vehicle') {
              return `<b>${task.text}</b><br/>Vehicle Group<br/>
                      <b>Owner:</b> ${task.details?.service_owner || 'Unknown'}<br/>
                      <b>Driver:</b> ${task.details?.current_driver || 'Unassigned'}`;
            } else {
              const overdueText = task.overdue ? '<br/><b style="color: #dc3545;">⚠️ OVERDUE</b>' : '';
              return `
                <b>${task.text}</b><br/>
                <b>Vehicle:</b> ${task.details?.vehicle_name || 'Unknown'}<br/>
                <b>Status:</b> ${task.status || 'Pending'}<br/>
                <b>Urgency:</b> ${task.urgency || 'Normal'}<br/>
                <b>Cost:</b> TTD ${task.details?.cost || '0'}<br/>
                <b>Dates:</b> ${gantt.templates.tooltip_date_format(start)} - ${gantt.templates.tooltip_date_format(end)}
                ${overdueText}
              `;
            }
          };
          
          // Initialize and parse
          gantt.init("ganttContainer");
          gantt.parse(parsedData);
          
          // Handle task click to view maintenance
          gantt.attachEvent("onTaskClick", function(id, e) {
            const task = gantt.getTask(id);
            if (task && task.details && task.details.maintenance_id) {
              window.location.href = `/maintenances/${task.details.maintenance_id}`;
            }
            return true;
          });
          
          // Handle task double click for editing
          gantt.attachEvent("onTaskDblClick", function(id, e) {
            const task = gantt.getTask(id);
            if (task && task.details && task.details.maintenance_id) {
              window.location.href = `/maintenances/${task.details.maintenance_id}/edit`;
            }
            return true;
          });
          
          console.log('✅ Gantt chart loaded successfully!');
          
        } catch (error) {
          console.error('❌ Error loading Gantt chart:', error);
          showError('Error loading chart: ' + error.message);
        }
      }
      
      function showError(message) {
        const container = document.getElementById('ganttContainer');
        if (container) {
          container.innerHTML = `
            <div class="alert alert-danger m-4">
              <h4>Error Loading Gantt Chart</h4>
              <p>${message}</p>
              <p>Please refresh the page or check the console for details.</p>
            </div>
          `;
        }
      }
      
      function initializeAutoSubmit() {
        const form = document.getElementById('ganttFilters');
        if (!form) return;
        
        // Debounce function to prevent too many submissions
        let debounceTimer;
        function debounceSubmit(delay = 300) {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            // Clear vehicle_id if vehicle_search is used
            const vehicleSearch = document.getElementById('vehicleSearch');
            const vehicleSelect = document.getElementById('vehicleSelect');
            if (vehicleSearch && vehicleSearch.value.trim() !== '') {
              vehicleSelect.value = '';
            }
            form.submit();
          }, delay);
        }
        
        // Auto-submit for dropdowns
        const autoSubmitElements = document.querySelectorAll('.auto-submit');
        autoSubmitElements.forEach(element => {
          element.addEventListener('change', function() {
            debounceSubmit(100);
          });
        });
        
        // Auto-submit for date inputs
        const autoSubmitDateElements = document.querySelectorAll('.auto-submit-date');
        autoSubmitDateElements.forEach(element => {
          element.addEventListener('change', function() {
            debounceSubmit(300);
          });
        });
        
        // Auto-submit for vehicle search with Enter key
        const vehicleSearch = document.getElementById('vehicleSearch');
        if (vehicleSearch) {
          vehicleSearch.addEventListener('keyup', function(event) {
            if (event.key === 'Enter') {
              const vehicleSelect = document.getElementById('vehicleSelect');
              if (vehicleSelect) vehicleSelect.value = '';
              debounceSubmit(100);
            } else if (this.value.trim() === '') {
              debounceSubmit(500);
            }
          });
          
          // Also submit on blur if value changed
          vehicleSearch.addEventListener('blur', function() {
            if (this.dataset.originalValue !== this.value) {
              const vehicleSelect = document.getElementById('vehicleSelect');
              if (vehicleSelect) vehicleSelect.value = '';
              debounceSubmit(300);
            }
          });
          
          // Store original value
          vehicleSearch.dataset.originalValue = vehicleSearch.value;
        }
        
        // Clear vehicle search button
        const clearVehicleSearch = document.getElementById('clearVehicleSearch');
        if (clearVehicleSearch) {
          clearVehicleSearch.addEventListener('click', function() {
            const vehicleSearch = document.getElementById('vehicleSearch');
            if (vehicleSearch) {
              vehicleSearch.value = '';
              const vehicleSelect = document.getElementById('vehicleSelect');
              if (vehicleSelect) vehicleSelect.value = '';
              form.submit();
            }
          });
        }
        
        // Filter form toggle
        const dateRange = document.getElementById('dateRange');
        if (dateRange) {
          dateRange.addEventListener('change', function() {
            const customRange = document.getElementById('customDateRange');
            if (this.value === 'custom') {
              customRange.style.display = 'block';
            } else {
              customRange.style.display = 'none';
              debounceSubmit(100);
            }
          });
        }
        
        // Reset filters
        const resetFilters = document.getElementById('resetFilters');
        if (resetFilters) {
          resetFilters.addEventListener('click', function() {
            window.location.href = '<%= gantt_path %>';
          });
        }
        
        // View mode toggle
        const viewMode = document.getElementById('viewMode');
        if (viewMode) {
          viewMode.addEventListener('change', function() {
            // Update Gantt scale based on view mode
            if (window.gantt) {
              switch(this.value) {
                case 'day':
                  gantt.config.scales = [
                    { unit: "day", step: 1, format: "%d %F" },
                    { unit: "hour", step: 3, format: "%H:%i" }
                  ];
                  break;
                case 'week':
                  gantt.config.scales = [
                    { unit: "week", step: 1, format: "Week #%W" },
                    { unit: "day", step: 1, format: "%d" }
                  ];
                  break;
                case 'month':
                  gantt.config.scales = [
                    { unit: "month", step: 1, format: "%F %Y" },
                    { unit: "week", step: 1, format: "Week #%W" }
                  ];
                  break;
                case 'quarter':
                  gantt.config.scales = [
                    { unit: "month", step: 3, format: "%F %Y" },
                    { unit: "month", step: 1, format: "%b" }
                  ];
                  break;
              }
              gantt.render();
            }
          });
        }
      }
    </script>
    
  <% else %>
    <!-- No data message -->
    <div class="card shadow-sm border-0">
      <div class="card-body text-center py-5">
        <div class="mb-4">
          <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
        </div>
        <h4 class="mb-3">No maintenance scheduled</h4>
        <p class="text-muted mb-4">No maintenance records found with valid dates.</p>
        
        <div class="d-flex justify-content-center gap-3 mt-4">
          <%= link_to "View All Vehicles", vehicles_path, class: "btn btn-primary" %>
          <%= link_to "Add Maintenance", new_maintenance_path, class: "btn btn-success" %>
          <%= link_to "Reset Filters", gantt_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

