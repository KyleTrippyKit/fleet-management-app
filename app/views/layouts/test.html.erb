<!DOCTYPE html>
<html>
<head>
  <title>Test Layout - Trinidad Fleet Management</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <style>
    body {
      background: white !important;
      color: black !important;
      padding: 20px;
      font-family: Arial, sans-serif;
    }
    .debug-header {
      background: #ff0;
      color: #000;
      padding: 15px;
      margin-bottom: 20px;
      border: 3px solid #f00;
      border-radius: 5px;
      font-weight: bold;
    }
    .content-area {
      background: #fff;
      border: 3px solid #00f;
      padding: 20px;
      min-height: 500px;
    }
  </style>
</head>
<body>
  <div class="debug-header">
    🔧 TEST LAYOUT - Time: <%= Time.current.strftime("%H:%M:%S") %> | 
    Controller: <%= params[:controller] %> | 
    Action: <%= params[:action] %>
    <button onclick="this.parentElement.remove()" style="float:right; padding:5px 15px;">Hide</button>
  </div>
  
  <div class="content-area">
    <%= yield %>
  </div>
  
  <div style="margin-top:20px; padding:10px; background:#eee; border:1px solid #ccc;">
    <strong>Test Layout Footer</strong> - This confirms the test layout is working
  </div>
</body>
</html>