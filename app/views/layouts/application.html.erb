<!DOCTYPE html>
<html lang="en">
  <head>
    <%# File: app/views/layouts/application.html.erb - WITH DOCTYPE DETECTION %>
    <title>Trinidad Fleet Management</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="page-type" content="<%= content_for?(:gantt_page) ? 'gantt' : 'normal' %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Cache Control for Development -->
    <% if Rails.env.development? %>
      <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
      <meta http-equiv="Pragma" content="no-cache">
      <meta http-equiv="Expires" content="0">
    <% end %>

    <!-- COMPLETELY DISABLE TURBO -->
    <meta name="turbo-visit-control" content="reload">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-prefetch" content="false">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <% if content_for?(:gantt_page) %>
      <link rel="stylesheet" href="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.css">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% if content_for?(:gantt_page) %>
      <script src="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.js" crossorigin="anonymous"></script>
    <% end %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      /* Basic layout styles */
      body { 
        background: #f8f9fa; 
        min-height: 100vh;
        padding-top: 20px;
      }
      .container { 
        max-width: 1400px; 
        margin: 0 auto; 
        padding: 20px;
      }
      
      /* PTSC theme overrides */
      body.ptsc-theme-active .ptsc-header {
        background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%) !important;
      }

      /* Gantt chart container */
      .gantt-chart {
        width: 100%;
        height: 600px;
        border: 1px solid #e9ecef;
        border-radius: 0.5rem;
        overflow: hidden;
      }

      /* Flash message animations */
      .alert-auto-hide {
        animation: fadeOutAlert 2.5s forwards !important;
        animation-delay: 2s !important;
      }

      @keyframes fadeOutAlert {
        0% { opacity: 1; transform: translateY(0); }
        70% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(-20px); max-height: 0; padding: 0; margin: 0; }
      }

      /* Loading button state */
      .btn-loading {
        position: relative;
        pointer-events: none;
        opacity: 0.7;
      }

      .btn-loading:after {
        content: '';
        position: absolute;
        width: 1rem;
        height: 1rem;
        top: 50%;
        left: 50%;
        margin-left: -0.5rem;
        margin-top: -0.5rem;
        border: 2px solid #fff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spinner 0.6s linear infinite;
      }

      @keyframes spinner {
        to { transform: rotate(360deg); }
      }
      
      /* Debug panel styles */
      #debug-panel {
        position: fixed;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,0.9);
        color: #0f0;
        padding: 15px;
        border-radius: 5px;
        font-family: monospace;
        font-size: 12px;
        z-index: 99999;
        border: 2px solid #0f0;
        max-width: 400px;
      }
    </style>
    
    <!-- Allow views to add their own head content -->
    <%= yield :head %>
  </head>

  <%
    # Agency theme detection
    agency_code =
      if defined?(current_user) && current_user&.respond_to?(:agency) && current_user.agency
        current_user.agency.code.to_s.downcase
      else
        @agency.to_s.downcase
      end

    is_vmcott = (agency_code == "vmcott") || request.path.to_s.downcase.include?("vmcott")
    is_ptsc   = (agency_code == "ptsc")   || request.path.to_s.downcase.include?("ptsc")
  %>

  <body class="<%= 'vmcott-page' if is_vmcott %>
               <%= 'ptsc-theme-active' if is_ptsc %>
               <%= 'gantt-page' if content_for?(:gantt_page) %>"
        data-turbo="false"
        data-turbolinks="false">

    <!-- DOCTYPE FORCE AND DETECTION - RUNS FIRST -->
    <script>
      (function() {
        console.log('🔍 DOCTYPE CHECK - START');
        
        // Get the first few characters of the HTML to check for doctype
        const htmlStart = document.documentElement.outerHTML.substring(0, 200);
        console.log('🔍 HTML starts with:', htmlStart);
        
        // Check if doctype exists
        const hasDoctype = document.doctype !== null;
        console.log('🔍 Doctype exists:', hasDoctype);
        
        if (document.doctype) {
          console.log('🔍 Doctype name:', document.doctype.name);
          console.log('🔍 Doctype publicId:', document.doctype.publicId);
          console.log('🔍 Doctype systemId:', document.doctype.systemId);
        }
        
        // Check if we're in quirks mode
        const isQuirksMode = document.compatMode === 'BackCompat';
        console.log('🔍 Browser compat mode:', document.compatMode);
        console.log('🔍 Is Quirks Mode:', isQuirksMode);
        
        if (isQuirksMode) {
          console.warn('⚠️ Page is in QUIRKS MODE - forcing standards');
          
          // Force standards mode by recreating the doctype
          // This is a hack but can work
          const newDoctype = document.implementation.createDocumentType('html', '', '');
          document.replaceChild(newDoctype, document.firstChild);
          
          console.log('✅ Doctype replaced, reloading...');
          // Reload to apply changes
          setTimeout(function() {
            window.location.reload();
          }, 100);
        }
        
        // Also check for any whitespace before doctype
        const firstChild = document.firstChild;
        console.log('🔍 First child node type:', firstChild?.nodeType);
        console.log('🔍 First child node name:', firstChild?.nodeName);
        
        if (firstChild && firstChild.nodeType === 3) { // Text node
          console.warn('⚠️ Found text before doctype:', firstChild.textContent);
          // Remove it
          firstChild.remove();
          console.log('✅ Removed text before doctype');
        }
      })();
    </script>

    <div id="modal-container"></div>

    <!-- DEBUG PANEL - Will show if page is loading -->
    <div id="debug-panel">
      <strong>🔍 DEBUG PANEL</strong><br>
      <div id="debug-time"></div>
      <div id="debug-status">Initializing...</div>
      <div id="debug-url"></div>
      <div id="debug-user"></div>
      <div id="debug-compat"></div>
      <button onclick="this.parentElement.remove()" style="margin-top:10px; padding:5px;">Hide</button>
    </div>

    <script>
      // Update debug panel immediately
      (function() {
        const panel = document.getElementById('debug-panel');
        if (panel) {
          document.getElementById('debug-time').textContent = 'Time: ' + new Date().toISOString();
          document.getElementById('debug-url').textContent = 'URL: ' + window.location.href;
          document.getElementById('debug-user').textContent = 'User: <%= user_signed_in? ? current_user.email : 'Not logged in' %>';
          document.getElementById('debug-status').textContent = '✅ Page loaded at: ' + new Date().toLocaleTimeString();
          document.getElementById('debug-compat').textContent = 'Compat Mode: ' + document.compatMode;
        }
      })();
    </script>

    <!-- Navigation for logged-in users (skip for special pages) -->
    <% unless params[:controller] == 'screensaver' || 
              (params[:controller] == 'home' && params[:action] == 'index' && !user_signed_in?) ||
              params[:controller] == 'devise/sessions' ||
              params[:controller] == 'devise/passwords' ||
              params[:controller] == 'devise/registrations' %>
      
      <% if user_signed_in? %>
        <div class="container mt-3">
          <%= render "shared/navigation" %>
        </div>
      <% end %>

      <!-- Flash Messages -->
      <div id="flash-messages" class="container mt-3" data-flash-container>
        <%= render "shared/flash" %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="container">
      <%= yield %>
    </main>

    <!-- Flash auto-hide script -->
    <script>
      (function() {
        // Guard to prevent double initialization
        if (window.flashHandlerInitialized) return;
        window.flashHandlerInitialized = true;
        
        function hideFlashOnly() {
          const container = document.getElementById("flash-messages");
          if (!container) return;
          const alerts = container.querySelectorAll(".alert, .alert-dismissible, [role='alert']");
          if (!alerts.length) return;
          
          console.log("✅ Flash fallback: found", alerts.length, "alerts");
          alerts.forEach(function (alertEl) {
            alertEl.classList.add("alert-auto-hide");
            setTimeout(function () {
              try { alertEl.remove(); } catch (_) {}
            }, 3200);
          });
        }
        
        // Run on load
        document.addEventListener("DOMContentLoaded", hideFlashOnly);
        
        // Also run immediately
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          setTimeout(hideFlashOnly, 100);
        }
      })();
    </script>

    <!-- Layout Debug Info -->
    <%= render 'shared/layout_debug' if Rails.env.development? %>
    
    <!-- Page Load Monitor -->
    <script>
      (function() {
        // Update debug panel with page load status
        const panel = document.getElementById('debug-panel');
        const status = document.getElementById('debug-status');
        const compat = document.getElementById('debug-compat');
        
        // Monitor page visibility
        document.addEventListener('visibilitychange', function() {
          if (status) {
            status.textContent = '📱 Page visibility: ' + document.visibilityState;
          }
        });
        
        // Check if page is blank
        setTimeout(function() {
          if (document.body.children.length === 0 || 
              document.body.innerText.trim() === '') {
            if (status) {
              status.textContent = '❌ BLANK PAGE DETECTED!';
              status.style.color = '#f00';
            }
            console.error('❌ BLANK PAGE DETECTED at:', new Date().toISOString());
          } else {
            if (status) {
              status.textContent = '✅ Page has content - ' + document.body.children.length + ' elements';
              status.style.color = '#0f0';
            }
          }
          
          // Update compat mode
          if (compat) {
            compat.textContent = 'Compat Mode: ' + document.compatMode + (document.compatMode === 'BackCompat' ? ' ⚠️ QUIRKS MODE' : ' ✅ STANDARDS MODE');
          }
        }, 500);
        
        // Log page load
        console.log('📄 Page loaded at:', new Date().toISOString());
        console.log('📄 Body children:', document.body.children.length);
        console.log('📄 First few elements:', 
          Array.from(document.body.children).slice(0, 3).map(el => el.tagName));
        console.log('📄 Compat mode:', document.compatMode);
      })();
    </script>
  </body>
</html>