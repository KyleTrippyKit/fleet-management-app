<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%# File: app/views/layouts/application.html.erb %>
    <title>Trinidad Fleet Management</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="page-type" content="<%= content_for?(:gantt_page) ? 'gantt' : 'normal' %>">

    <%# Comment out favicon line until you add a favicon.ico file %>
    <%# <%= favicon_link_tag 'favicon.ico' %>
    
    <!-- Alternative: Use an inline SVG favicon to avoid 404 -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🚗%3C/text%3E%3C/svg%3E">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Cache Control for Development -->
    <% if Rails.env.development? %>
      <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
      <meta http-equiv="Pragma" content="no-cache">
      <meta http-equiv="Expires" content="0">
    <% end %>

    <!-- Turbo Control -->
    <meta name="turbo-visit-control" content="reload">
    <meta name="turbo-cache-control" content="no-cache">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <% if content_for?(:gantt_page) %>
      <link rel="stylesheet" href="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.css">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% if content_for?(:gantt_page) %>
      <script src="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.js" crossorigin="anonymous"></script>
    <% end %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      /* Basic layout styles */
      body { 
        background: #f8f9fa; 
        min-height: 100vh;
        padding-top: 20px;
      }
      .container { 
        max-width: 1400px; 
        margin: 0 auto; 
        padding: 20px;
      }
      
      /* PTSC theme overrides */
      body.ptsc-theme-active .ptsc-header {
        background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%) !important;
      }

      /* Gantt chart container */
      .gantt-chart {
        width: 100%;
        height: 600px;
        border: 1px solid #e9ecef;
        border-radius: 0.5rem;
        overflow: hidden;
      }

      /* Flash message animations */
      .alert-auto-hide {
        animation: fadeOutAlert 2.5s forwards !important;
        animation-delay: 2s !important;
      }

      @keyframes fadeOutAlert {
        0% { opacity: 1; transform: translateY(0); }
        70% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(-20px); max-height: 0; padding: 0; margin: 0; }
      }

      /* Loading button state */
      .btn-loading {
        position: relative;
        pointer-events: none;
        opacity: 0.7;
      }

      .btn-loading:after {
        content: '';
        position: absolute;
        width: 1rem;
        height: 1rem;
        top: 50%;
        left: 50%;
        margin-left: -0.5rem;
        margin-top: -0.5rem;
        border: 2px solid #fff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spinner 0.6s linear infinite;
      }

      @keyframes spinner {
        to { transform: rotate(360deg); }
      }
    </style>
    
    <!-- Allow views to add their own head content -->
    <%= yield :head %>
  </head>

  <%
    # Agency theme detection
    agency_code =
      if defined?(current_user) && current_user&.respond_to?(:agency) && current_user.agency
        current_user.agency.code.to_s.downcase
      else
        @agency.to_s.downcase
      end

    is_vmcott = (agency_code == "vmcott") || request.path.to_s.downcase.include?("vmcott")
    is_ptsc   = (agency_code == "ptsc")   || request.path.to_s.downcase.include?("ptsc")
  %>

  <body class="<%= 'vmcott-page' if is_vmcott %>
               <%= 'ptsc-theme-active' if is_ptsc %>
               <%= 'gantt-page' if content_for?(:gantt_page) %>"
        data-turbo="false">

    <div id="modal-container"></div>

    <%# ============================================================ %>
    <%# SKIP NAVIGATION FOR INVENTORY DASHBOARD - FIXES BLANK PAGE %>
    <%# ============================================================ %>
    <%
      # Determine if we should skip navigation
      skip_navigation = (
        params[:controller] == 'screensaver' || 
        (params[:controller] == 'home' && params[:action] == 'index' && !user_signed_in?) ||
        params[:controller] == 'devise/sessions' ||
        params[:controller] == 'devise/passwords' ||
        params[:controller] == 'devise/registrations' ||
        # Skip navigation for inventory dashboard to fix blank page issue
        (params[:controller] == 'vmcott/inventory' && params[:action] == 'dashboard')
      )
    %>

    <!-- Navigation for logged-in users (skip for special pages and inventory dashboard) -->
    <% unless skip_navigation %>
      <% if user_signed_in? %>
        <div class="container mt-3">
          <%= render "shared/navigation" %>
        </div>
      <% end %>

      <!-- Flash Messages -->
      <div id="flash-messages" class="container mt-3" data-flash-container>
        <%= render "shared/flash" %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="container">
      <%= yield %>
    </main>

    <!-- Flash auto-hide script -->
    <script>
      (function() {
        if (window.flashHandlerInitialized) return;
        window.flashHandlerInitialized = true;
        
        function hideFlashOnly() {
          const container = document.getElementById("flash-messages");
          if (!container) return;
          const alerts = container.querySelectorAll(".alert, .alert-dismissible, [role='alert']");
          if (!alerts.length) return;
          
          alerts.forEach(function (alertEl) {
            alertEl.classList.add("alert-auto-hide");
            setTimeout(function () {
              try { alertEl.remove(); } catch (_) {}
            }, 3200);
          });
        }
        
        document.addEventListener("DOMContentLoaded", hideFlashOnly);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          setTimeout(hideFlashOnly, 100);
        }
      })();
    </script>

    <!-- Layout Debug Info - Only shows in development -->
    <%# <%= render 'shared/layout_debug' if Rails.env.development? %> %>
  </body>
</html>