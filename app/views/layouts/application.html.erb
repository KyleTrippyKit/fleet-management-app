<!-- File: app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Trinidad Fleet Management</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="page-type" content="<%= content_for?(:gantt_page) ? 'gantt' : 'normal' %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap 5 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <% if content_for?(:gantt_page) %>
      <link rel="stylesheet" href="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.css">
    <% end %>

    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

    <!-- Importmap entrypoint -->
    <%= javascript_importmap_tags %>

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚗</text></svg>">

    <% if content_for?(:gantt_page) %>
      <script src="https://cdn.dhtmlx.com/gantt/edge/dhtmlxgantt.js" crossorigin="anonymous"></script>
    <% end %>

    <!-- Bootstrap 5 JS Bundle (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>

    <script>
      function initializeGanttWhenReady() {
        if (typeof gantt !== 'undefined' && gantt && typeof window.initGanttChart === 'function') {
          console.log("✅ Gantt library is loaded, initializing...");
          window.initGanttChart();
        } else {
          setTimeout(initializeGanttWhenReady, 100);
        }
      }

      function setupApp() {
        const csrfToken = document.querySelector('meta[name="csrf-token"]');
        if (csrfToken) window.csrfToken = csrfToken.getAttribute('content');

        if (document.querySelector('meta[name="page-type"]')?.content === 'gantt') {
          console.log("🚀 Starting Gantt initialization...");
          initializeGanttWhenReady();
        }
      }

      document.addEventListener('DOMContentLoaded', setupApp);
      document.addEventListener('turbo:load', setupApp);
    </script>

    <!-- Keep your existing inline styles (OK for now) -->
    <style>
      /* PTSC blue overrides (kept) */
      body.ptsc-theme-active .ptsc-header,
      .ptsc-header {
        background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%) !important;
      }

      body.ptsc-theme-active .badge.bg-primary,
      body.ptsc-theme-active .nav-tabs .nav-link.active,
      body.ptsc-theme-active .btn-outline-primary,
      body.ptsc-theme-active .btn-primary {
        background-color: #1a73e8 !important;
        border-color: #1a73e8 !important;
        color: white !important;
      }

      body.ptsc-theme-active .badge-ptsc,
      .badge-ptsc {
        background: linear-gradient(135deg, #1a73e8, #0d47a1) !important;
        color: white !important;
        border-left: 4px solid #004AAD !important;
      }

      /* Gantt chart container styling */
      .gantt-chart {
        width: 100%;
        height: 600px;
        border: 1px solid #e9ecef;
        border-radius: 0.5rem;
        overflow: hidden;
      }

      /* Ensure Gantt page has full height */
      body.gantt-page {
        height: auto;
        overflow-y: auto;   /* ✅ allow scroll */
        overflow-x: hidden; /* optional */
      }
      
      /* AUTO-HIDE FLASH MESSAGES CSS FALLBACK */
      .alert-auto-hide {
        animation: fadeOutAlert 2.5s forwards !important;
        animation-delay: 2s !important; /* Show for 2 seconds, then fade */
      }
      
      @keyframes fadeOutAlert {
        0% { opacity: 1; transform: translateY(0); }
        70% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(-20px); max-height: 0; padding: 0; margin: 0; }
      }
      
      /* Flash container animation */
      #flash-messages {
        transition: max-height 0.5s ease-out;
      }
    </style>
  </head>

  <%
    # Prefer current_user.agency.code, fallback to @agency (string), fallback to path.
    agency_code =
      if defined?(current_user) && current_user&.respond_to?(:agency) && current_user.agency
        current_user.agency.code.to_s.downcase
      else
        @agency.to_s.downcase
      end

    is_vmcott = (agency_code == "vmcott") || request.path.to_s.downcase.include?("vmcott")
    is_ptsc   = (agency_code == "ptsc")   || request.path.to_s.downcase.include?("ptsc")
  %>

  <body class="<%= 'vmcott-page' if is_vmcott %>
               <%= 'ptsc-theme-active' if is_ptsc %>
               <%= 'gantt-page' if content_for?(:gantt_page) %>">

    <div id="modal-container"></div>

    <!-- NAVIGATION (shows everywhere, including VMCOTT, when logged in) -->
    <% if defined?(user_signed_in?) && user_signed_in? %>
      <div class="container mt-3">
        <%= render "shared/navigation" %>
      </div>
    <% end %>

    <!-- Flash Messages -->
    <div id="flash-messages" class="container mt-3">
      <%= render "shared/flash" %>
    </div>

    <%= yield %>
    
    <!-- EXTRA JAVASCRIPT FALLBACK FOR FLASH HIDING -->
    <script>
      // Extra fallback: Force hide any flash messages after 2.5 seconds
      setTimeout(function() {
        const allAlerts = document.querySelectorAll('.alert, [role="alert"]');
        console.log('Fallback timer: Checking for', allAlerts.length, 'alerts');
        
        allAlerts.forEach(function(alert) {
          console.log('Hiding alert with text:', alert.textContent?.substring(0, 50));
          
          // Add auto-hide CSS class as fallback
          alert.classList.add('alert-auto-hide');
          
          // Also hide via JS
          setTimeout(function() {
            alert.style.display = 'none';
            alert.style.visibility = 'hidden';
            alert.style.opacity = '0';
            alert.style.height = '0';
            alert.style.padding = '0';
            alert.style.margin = '0';
            alert.style.overflow = 'hidden';
            alert.style.border = '0';
          }, 500);
        });
      }, 2500); // 2.5 seconds
    </script>
  </body>
</html>