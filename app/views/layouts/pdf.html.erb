<%# app/views/layouts/pdf.html.erb - SIMPLIFIED %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= yield(:title) || "ActivePlus Report" %></title>
    
    <!-- Use inline CSS only -->
    <style type="text/css">
      /* Simple, wkhtmltopdf-friendly CSS */
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        color: #000000;
        line-height: 1.4;
        margin: 0;
        padding: 0;
      }
      
      h1 { font-size: 20px; margin: 0 0 10px 0; }
      h2 { font-size: 16px; margin: 15px 0 8px 0; }
      h3 { font-size: 14px; margin: 12px 0 6px 0; }
      
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
      }
      
      th {
        background-color: #f2f2f2;
        border: 1px solid #cccccc;
        padding: 6px;
        text-align: left;
        font-weight: bold;
        font-size: 11px;
      }
      
      td {
        border: 1px solid #cccccc;
        padding: 6px;
        text-align: left;
        font-size: 11px;
      }
      
      .header {
        text-align: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #DA291C;
      }
      
      .footer {
        margin-top: 30px;
        padding-top: 10px;
        border-top: 1px solid #cccccc;
        font-size: 10px;
        color: #666666;
        text-align: center;
      }
      
      .currency {
        text-align: right;
        font-family: 'Courier New', monospace;
      }
      
      /* Page break handling */
      .page-break {
        page-break-before: always;
      }
      
      /* Avoid breaking inside tables */
      table, tr, td, th {
        page-break-inside: avoid;
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>