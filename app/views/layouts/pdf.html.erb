<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title><%= @page_title || "ActivePlus Document" %></title>

    <style type="text/css">
      /* =========================================================
         wkhtmltopdf OPTIMIZED BASE STYLES
         Used for RFQs, Quotations, Invoices, Ledger, Trial Balance
         ========================================================= */

      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        line-height: 1.4;
        color: #000;
        margin: 0;
        padding: 20px;
      }

      /* ================= HEADER ================= */
      .document-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid #DA291C;
      }

      .document-header h1 {
        font-size: 24px;
        margin: 0 0 10px 0;
        color: #DA291C;
        font-weight: bold;
      }

      .document-header h2 {
        font-size: 18px;
        margin: 0;
        color: #333;
        font-weight: normal;
      }

      .document-header p {
        margin: 5px 0 0;
        font-size: 11px;
        color: #555;
      }

      /* ================= SECTIONS ================= */
      .section {
        margin-bottom: 25px;
        page-break-inside: avoid;
      }

      .section-header {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-bottom: none;
        padding: 10px 15px;
        margin: 0;
      }

      .section-header h3 {
        font-size: 16px;
        margin: 0;
        color: #333;
      }

      .section-body {
        border: 1px solid #dee2e6;
        padding: 15px;
      }

      /* ================= TABLES ================= */
      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        border: 1px solid #dee2e6;
        padding: 8px;
        vertical-align: top;
      }

      th {
        background-color: #e9ecef;
        font-weight: bold;
        font-size: 11px;
        text-align: left;
      }

      td {
        font-size: 11px;
      }

      .text-end {
        text-align: right;
      }

      .text-center {
        text-align: center;
      }

      /* Compact tables (ledger, trial balance) */
      .table-sm th,
      .table-sm td {
        padding: 6px;
        font-size: 10.5px;
      }

      /* ================= BADGES ================= */
      .badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: bold;
        border-radius: 4px;
        color: white;
      }

      .bg-success { background-color: #28a745; }
      .bg-warning { background-color: #ffc107; color: #000; }
      .bg-danger  { background-color: #dc3545; }
      .bg-info    { background-color: #17a2b8; }
      .bg-muted   { background-color: #6c757d; }

      /* ================= UTILITIES ================= */
      .text-muted { color: #6c757d !important; }
      .small { font-size: 85%; }

      .mb-0 { margin-bottom: 0 !important; }
      .mb-1 { margin-bottom: 5px !important; }
      .mb-2 { margin-bottom: 10px !important; }
      .mb-3 { margin-bottom: 15px !important; }
      .mb-4 { margin-bottom: 20px !important; }

      .no-break {
        page-break-inside: avoid;
      }

      /* ================= GRID / INFO BOXES ================= */
      .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 15px;
      }

      .detail-item {
        border: 1px solid #dee2e6;
        padding: 10px;
        border-radius: 4px;
        background-color: #f8f9fa;
      }

      .detail-label {
        font-weight: bold;
        font-size: 10px;
        color: #495057;
        margin-bottom: 5px;
        display: block;
      }

      .detail-value {
        font-size: 11px;
      }

      /* ================= FOOTER ================= */
      .document-footer {
        margin-top: 50px;
        padding-top: 10px;
        border-top: 1px solid #ccc;
        font-size: 10px;
        color: #666;
        text-align: center;
      }

      /* ================= PRINT ================= */
      @media print {
        .no-print {
          display: none !important;
        }
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>