<%# app/views/quickbooks/connection/index.html.erb %>
<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">QuickBooks Integration - <%= @current_agency %></h1>
      <p class="text-gray-600">Connect your QuickBooks Online account to sync transactions, invoices, and payments.</p>
      
      <!-- Demo Mode Banner -->
      <div class="mt-4 bg-yellow-50 border-l-4 border-yellow-400 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700">
              <strong>Demo Mode:</strong> This is a simulation of QuickBooks integration. To enable real OAuth connection, 
              update your .env file with actual QuickBooks credentials from 
              <a href="https://developer.intuit.com/" class="underline" target="_blank">Intuit Developer</a>.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Connection Status Card -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-gray-800">Connection Status</h2>
        <% if @quickbooks_integration&.connected? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Connected (Demo)
          </span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            Not Connected
          </span>
        <% end %>
      </div>

      <% if @quickbooks_integration&.connected? %>
        <!-- Connected State -->
        <div class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Company ID</h3>
              <p class="text-gray-900 font-mono text-sm"><%= @quickbooks_integration.company_id %></p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Last Sync</h3>
              <p class="text-gray-900">
                <% if @quickbooks_integration.last_sync_at %>
                  <%= time_ago_in_words(@quickbooks_integration.last_sync_at) %> ago
                  <br><small class="text-gray-500"><%= @quickbooks_integration.last_sync_at.strftime('%b %d, %Y %I:%M %p') %></small>
                <% else %>
                  Never
                <% end %>
              </p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Sync Status</h3>
              <p class="text-gray-900">
                <% if @quickbooks_integration.sync_status.present? %>
                  <span class="capitalize <%= 
                    @quickbooks_integration.sync_status == 'success' ? 'text-green-600' : 
                    @quickbooks_integration.sync_status == 'failed' ? 'text-red-600' : 
                    'text-yellow-600'
                  %>">
                    <%= @quickbooks_integration.sync_status %>
                  </span>
                <% else %>
                  Not started
                <% end %>
              </p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Auto-Sync</h3>
              <p class="text-gray-900">
                <% if @quickbooks_integration.auto_sync %>
                  <span class="text-green-600">✅ Enabled</span>
                <% else %>
                  <span class="text-gray-600">❌ Disabled</span>
                <% end %>
              </p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Access Token</h3>
              <p class="text-gray-900 font-mono text-sm truncate" title="<%= @quickbooks_integration.access_token %>">
                <%= truncate(@quickbooks_integration.access_token, length: 20) %>
              </p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="font-medium text-gray-700 mb-1">Token Expires</h3>
              <p class="text-gray-900">
                <% if @quickbooks_integration.token_expires_at %>
                  <%= time_ago_in_words(@quickbooks_integration.token_expires_at) %> from now
                <% else %>
                  Not set
                <% end %>
              </p>
            </div>
          </div>

          <% if @quickbooks_integration.sync_error.present? %>
            <div class="bg-red-50 border-l-4 border-red-400 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-red-700">Last sync error: <%= @quickbooks_integration.sync_error %></p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-200">
            <%= link_to "🔗 Connect (Real OAuth)", quickbooks_connect_path, 
                class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
            
            <%= link_to "🚫 Disconnect", quickbooks_disconnect_path, 
                method: :delete, 
                data: { confirm: "Are you sure you want to disconnect from QuickBooks?" },
                class: "px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2" %>
            
            <%= link_to "🔄 Sync Now", quickbooks_sync_path, 
                method: :post,
                class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
            
            <% if @quickbooks_integration.auto_sync %>
              <%= link_to "⏸️ Disable Auto-Sync", quickbooks_toggle_auto_sync_path, 
                  method: :post,
                  class: "px-4 py-2 bg-yellow-600 text-white rounded-md hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2" %>
            <% else %>
              <%= link_to "▶️ Enable Auto-Sync", quickbooks_toggle_auto_sync_path, 
                  method: :post,
                  class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
            <% end %>
          </div>
        </div>
      <% else %>
        <!-- Not Connected State -->
        <div class="text-center py-8">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <h3 class="mt-4 text-lg font-medium text-gray-900">Not connected to QuickBooks</h3>
          <p class="mt-2 text-sm text-gray-500 max-w-md mx-auto">
            <% if ENV['QUICKBOOKS_CLIENT_ID'].blank? || ENV['QUICKBOOKS_CLIENT_ID'] == 'your_client_id_here' %>
              <span class="text-red-600 font-medium">⚠️ QuickBooks credentials not configured.</span><br>
              To enable real OAuth connection, update your .env file with valid QuickBooks OAuth credentials from 
              <a href="https://developer.intuit.com/" class="underline" target="_blank">Intuit Developer</a>.
            <% else %>
              Connect your QuickBooks Online account to automatically sync transactions, invoices, and payments.
            <% end %>
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <% if ENV['QUICKBOOKS_CLIENT_ID'].blank? || ENV['QUICKBOOKS_CLIENT_ID'] == 'your_client_id_here' %>
              <button disabled class="inline-flex items-center justify-center px-4 py-2 bg-gray-400 text-white rounded-md cursor-not-allowed">
                🔒 QuickBooks Not Configured
              </button>
              <p class="text-xs text-gray-500">
                Using demo mode. For real integration, get credentials from 
                <a href="https://developer.intuit.com/" class="underline" target="_blank">Intuit Developer</a>.
              </p>
              <%= link_to "🎭 Try Demo Connection", quickbooks_connect_path, 
                  class: "inline-flex items-center justify-center px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2" %>
            <% else %>
              <%= link_to "🔗 Connect to QuickBooks", quickbooks_connect_path, 
                  class: "inline-flex items-center justify-center px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
              <%= link_to "🎭 Try Demo Mode Instead", quickbooks_connect_path, 
                  class: "inline-flex items-center justify-center px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <%= link_to quickbooks_sync_transactions_path, method: :post, 
          class: "bg-blue-50 border border-blue-200 rounded-lg p-6 hover:bg-blue-100 transition-colors" do %>
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-blue-900">Sync Transactions</h3>
            <p class="mt-1 text-sm text-blue-700">Sync payment transactions to QuickBooks</p>
          </div>
        </div>
      <% end %>
      
      <%= link_to quickbooks_sync_invoices_path, method: :post,
          class: "bg-purple-50 border border-purple-200 rounded-lg p-6 hover:bg-purple-100 transition-colors" do %>
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-purple-900">Sync Invoices</h3>
            <p class="mt-1 text-sm text-purple-700">Sync invoices and billing data</p>
          </div>
        </div>
      <% end %>
      
      <%= link_to quickbooks_sync_all_path, method: :post,
          class: "bg-green-50 border border-green-200 rounded-lg p-6 hover:bg-green-100 transition-colors" do %>
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-green-900">Full Sync</h3>
            <p class="mt-1 text-sm text-green-700">Sync all pending data at once</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sync Statistics (Only show if connected) -->
    <% if @quickbooks_integration&.connected? && defined?(@transactions_count) %>
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-6">Sync Statistics</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Transactions -->
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-medium text-gray-700">Transactions</h3>
              <span class="text-sm font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded">
                <%= @transactions_count || 0 %>
              </span>
            </div>
            <div class="space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Synced</span>
                <span class="font-medium text-green-600"><%= @synced_transactions_count || 0 %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Pending</span>
                <span class="font-medium text-yellow-600"><%= @pending_transactions_count || 0 %></span>
              </div>
              <div class="pt-2">
                <%= link_to "View All Transactions", transactions_path, class: "text-sm text-blue-600 hover:text-blue-800 hover:underline" %>
              </div>
            </div>
          </div>

          <!-- Invoices -->
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-medium text-gray-700">Invoices</h3>
              <span class="text-sm font-medium text-purple-600 bg-purple-50 px-2 py-1 rounded">
                <%= @invoices_count || 0 %>
              </span>
            </div>
            <div class="space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Synced</span>
                <span class="font-medium text-green-600"><%= @synced_invoices_count || 0 %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Pending</span>
                <span class="font-medium text-yellow-600"><%= @pending_invoices_count || 0 %></span>
              </div>
              <div class="pt-2">
                <%= link_to "View All Invoices", invoices_path, class: "text-sm text-purple-600 hover:text-purple-800 hover:underline" %>
              </div>
            </div>
          </div>

          <!-- Sync Status -->
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-medium text-gray-700">Sync Health</h3>
              <span class="text-sm">
                <% sync_percentage = @transactions_count > 0 ? (@synced_transactions_count.to_f / @transactions_count * 100).to_i : 0 %>
                <span class="<%= sync_percentage > 80 ? 'text-green-600' : sync_percentage > 50 ? 'text-yellow-600' : 'text-red-600' %>">
                  <%= sync_percentage %>%
                </span>
              </span>
            </div>
            <div class="space-y-3">
              <div>
                <div class="w-full bg-gray-200 rounded-full h-2.5">
                  <div class="<%= sync_percentage > 80 ? 'bg-green-600' : sync_percentage > 50 ? 'bg-yellow-600' : 'bg-red-600' %> h-2.5 rounded-full" 
                       style="width: <%= sync_percentage %>%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">Data sync completion</p>
              </div>
              <div>
                <p class="text-sm text-gray-500 mb-1">Last Successful Sync</p>
                <p class="font-medium">
                  <% if @quickbooks_integration.last_sync_at %>
                    <%= @quickbooks_integration.last_sync_at.strftime('%b %d, %Y') %>
                  <% else %>
                    Never
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Setup Instructions -->
    <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-800 mb-4">Setup Instructions</h3>
      <div class="prose prose-sm max-w-none">
        <p class="text-gray-600 mb-4">To enable real QuickBooks integration:</p>
        <ol class="list-decimal pl-5 space-y-2 text-gray-600">
          <li>Register at <a href="https://developer.intuit.com/" class="text-blue-600 underline" target="_blank">Intuit Developer</a></li>
          <li>Create a new app in the Developer Portal</li>
          <li>Get your Client ID and Client Secret</li>
          <li>Add <code class="bg-gray-100 px-1 py-0.5 rounded">http://localhost:3000/quickbooks/callback</code> as a Redirect URI</li>
          <li>Update your <code class="bg-gray-100 px-1 py-0.5 rounded">.env</code> file with the credentials</li>
          <li>Restart your Rails server</li>
        </ol>
      </div>
    </div>
  </div>
</div>