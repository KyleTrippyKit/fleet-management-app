<%# app/views/purchase_order_mailer/po_paid.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Confirmed - PO #<%= @po_number %></title>
  <style>
    /* Same styles as above */
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Payment Confirmed</h2>
      <p><%= @po_number %></p>
    </div>

    <div class="content">
      <p>Dear <strong><%= @vendor %></strong>,</p>
      
      <p>Payment for Purchase Order <strong><%= @po_number %></strong> has been confirmed.</p>

      <div class="po-details">
        <strong>💰 Payment Details</strong><br>
        <strong>Amount:</strong> $<%= number_with_precision(@amount, precision: 2) %><br>
        <strong>Payment Method:</strong> <%= @payment_method %><br>
        <strong>Reference:</strong> <%= @payment_reference %>
      </div>
    </div>
  </div>
</body>
</html>