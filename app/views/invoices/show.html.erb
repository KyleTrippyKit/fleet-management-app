<%# app/views/invoices/show.html.erb - COMPLETE VERSION WITH APPROVAL AND PAYABLE %>
<%= stylesheet_link_tag "agencies", media: "all", "data-turbo-track": "reload" %>

<%= render "approval_panel" %>

<%# Breadcrumb Navigation %>
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Invoices", invoices_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @invoice.invoice_number %></li>
  </ol>
</nav>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <!-- Invoice Header -->
      <div class="card border-0 shadow-sm mb-4 agency-header-card">
        <div class="card-body p-0">
          <div class="row g-0">
            <div class="col-md-8 p-4">
              <div class="d-flex align-items-center">
                <% if @invoice.vehicle&.agency %>
                  <div class="me-3">
                    <div class="agency-logo bg-<%= @invoice.vehicle.agency.code.downcase %>">
                      <%= @invoice.vehicle.agency.code %>
                    </div>
                  </div>
                <% end %>
                <div>
                  <h1 class="h2 mb-1">Invoice <%= @invoice.invoice_number %></h1>
                  <p class="text-muted mb-0">
                    <% if @invoice.vehicle&.agency %>
                      <%= @invoice.vehicle.agency.name %>
                    <% else %>
                      Vehicle Management System
                    <% end %>
                    • Received from <%= @invoice.vendor %>
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-4 bg-light p-4 border-start">
              <div class="text-end">
                <div class="d-flex justify-content-end align-items-center mb-2">
                  <span class="badge <%= @invoice.status_badge_class %> status-badge me-3">
                    <%= @invoice.status.humanize %>
                  </span>
                  <% if @invoice.overdue? %>
                    <span class="badge bg-danger me-2">OVERDUE</span>
                  <% end %>
                  <% if @invoice.quickbooks_id && @invoice.last_sync_at %>
                    <% if @invoice.recently_synced?(24) %>
                      <span class="badge bg-success me-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Recently Synced
                      </span>
                    <% elsif @invoice.sync_stale? %>
                      <span class="badge bg-warning me-2">
                        <i class="bi bi-clock-history me-1"></i>
                        Sync Stale
                      </span>
                    <% end %>
                  <% end %>
                </div>
                <p class="mb-1"><strong>Invoice Date:</strong> <%= @invoice.invoice_date.strftime("%d %B, %Y") %></p>
                <p class="mb-0"><strong>Due Date:</strong> <%= @invoice.due_date.strftime("%d %B, %Y") %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Status and Quick Actions Bar -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
          <div class="row align-items-center">
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <% if @invoice.overdue? %>
                  <span class="badge bg-danger me-2">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <%= pluralize(@invoice.days_overdue, 'day') %> overdue
                  </span>
                <% elsif @invoice.days_until_due %>
                  <span class="badge <%= @invoice.urgency_badge_class %>">
                    <i class="bi bi-clock me-1"></i>
                    <%= pluralize(@invoice.days_until_due, 'day') %> remaining
                  </span>
                <% end %>
                
                <% if @invoice.quickbooks_id %>
                  <% if @invoice.sync_success? %>
                    <% if @invoice.recently_synced?(1) %>
                      <span class="badge bg-success me-2">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        QuickBooks - Recent
                      </span>
                    <% elsif @invoice.recently_synced?(24) %>
                      <span class="badge bg-info me-2">
                        <i class="bi bi-check-circle me-1"></i>
                        QuickBooks - Today
                      </span>
                    <% elsif @invoice.sync_stale? %>
                      <span class="badge bg-warning me-2">
                        <i class="bi bi-clock-history me-1"></i>
                        QuickBooks - Stale
                      </span>
                    <% else %>
                      <span class="badge bg-secondary me-2">
                        <i class="bi bi-check-circle me-1"></i>
                        QuickBooks
                      </span>
                    <% end %>
                  <% elsif @invoice.sync_failed? %>
                    <span class="badge bg-danger me-2">
                      <i class="bi bi-x-circle me-1"></i>
                      QuickBooks - Failed
                    </span>
                  <% elsif @invoice.sync_error? %>
                    <span class="badge bg-danger me-2">
                      <i class="bi bi-exclamation-triangle-fill me-1"></i>
                      QuickBooks - Error
                    </span>
                  <% end %>
                <% else %>
                  <span class="badge bg-light text-dark border me-2">
                    <i class="bi bi-cloud-upload me-1"></i>
                    QuickBooks - Not Synced
                  </span>
                <% end %>
                
                <% if @invoice.pos_transaction %>
                  <span class="badge bg-success me-2">
                    <i class="bi bi-credit-card me-1"></i>
                    POS Payment
                  </span>
                <% end %>
                
                <% if @invoice.approved? %>
                  <span class="badge bg-success me-2">
                    <i class="bi bi-check-circle me-1"></i>
                    Approved
                  </span>
                <% end %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex justify-content-end flex-wrap gap-2">
                <%= link_to 'Print', print_invoice_path(@invoice), 
                    class: 'btn btn-outline-secondary', target: '_blank' %>
                <%= link_to 'Download', download_invoice_path(@invoice), 
                    class: 'btn btn-outline-info' %>
                <%= link_to 'Back to List', invoices_path, 
                    class: 'btn btn-outline-dark' %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Row -->
      <div class="row">
        <!-- Left Column - Main Details -->
        <div class="col-lg-8">
          <!-- Invoice Details Card -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-file-text me-2"></i>
                INVOICE DETAILS
              </h5>
            </div>
            <div class="card-body p-4">
              <div class="row">
                <!-- Left Column - Invoice Information -->
                <div class="col-md-6">
                  <div class="mb-4">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">INVOICE INFORMATION</h6>
                    <table class="table table-sm table-borderless">
                      <tbody>
                        <tr>
                          <td class="text-muted" style="width: 40%">Invoice Number:</td>
                          <td class="fw-bold"><%= @invoice.invoice_number %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Vendor:</td>
                          <td class="fw-bold"><%= @invoice.vendor %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Date Received:</td>
                          <td class="fw-bold"><%= @invoice.invoice_date.strftime("%d %B, %Y") %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Prepared By:</td>
                          <td class="fw-bold"><%= @invoice.created_by&.name || @invoice.created_by&.email || 'System' %></td>
                        </tr>
                        <tr>
                          <td class="text-muted">Invoice Type:</td>
                          <td class="fw-bold"><%= @invoice.category.present? ? @invoice.category.humanize : 'Vehicle Services' %></td>
                        </tr>
                        <% if @invoice.approved? %>
                          <tr>
                            <td class="text-muted">Approved By:</td>
                            <td class="fw-bold"><%= @invoice.approved_by&.name %></td>
                          </tr>
                          <tr>
                            <td class="text-muted">Approved At:</td>
                            <td class="fw-bold"><%= @invoice.approved_at&.strftime("%d %B, %Y") %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>

                  <!-- Financial Summary -->
                  <div class="mb-4">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">FINANCIAL SUMMARY</h6>
                    <div class="card border">
                      <div class="card-body p-3">
                        <table class="table table-sm table-borderless mb-0">
                          <tbody>
                            <tr>
                              <td class="text-muted">Invoice Amount:</td>
                              <td class="text-end fw-bold"><%= number_to_currency(@invoice.amount) %></td>
                            </tr>
                            <tr>
                              <td class="text-muted">VAT (12.5%):</td>
                              <td class="text-end fw-bold"><%= number_to_currency(@invoice.vat_amount) %></td>
                            </tr>
                            <tr class="border-top">
                              <td class="text-muted">Total Amount:</td>
                              <td class="text-end fw-bold fs-5"><%= number_to_currency(@invoice.total_with_vat) %></td>
                            </tr>
                            <% if @invoice.transactions.any? %>
                              <tr class="border-top">
                                <td class="text-muted">Total Paid:</td>
                                <td class="text-end fw-bold text-success"><%= number_to_currency(@invoice.transactions.sum(:amount)) %></td>
                              </tr>
                              <tr>
                                <td class="text-muted">Balance Due:</td>
                                <td class="text-end fw-bold text-danger"><%= number_to_currency(@invoice.balance_due) %></td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Right Column - Vehicle & Integration Information -->
                <div class="col-md-6">
                  <div class="row">
                    <!-- Vehicle Information -->
                    <div class="col-12 mb-4">
                      <h6 class="text-uppercase text-muted small fw-bold mb-3">VEHICLE INFORMATION</h6>
                      <% if @invoice.vehicle %>
                        <div class="card border">
                          <div class="card-body p-3">
                            <div class="row align-items-center">
                              <div class="col-auto">
                                <div class="vehicle-icon text-center">
                                  <i class="bi bi-<%= @invoice.vehicle.vehicle_type == 'bus' ? 'bus-front' : 
                                                      @invoice.vehicle.vehicle_type == 'truck' ? 'truck' : 
                                                      @invoice.vehicle.vehicle_type == 'van' ? 'van' : 
                                                      'car-front' %> fa-2x text-primary"></i>
                                </div>
                              </div>
                              <div class="col">
                                <table class="table table-sm table-borderless mb-0">
                                  <tbody>
                                    <tr>
                                      <td class="text-muted" style="width: 40%">Registration:</td>
                                      <td class="fw-bold"><%= @invoice.vehicle.license_plate %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">Make/Model:</td>
                                      <td class="fw-bold"><%= @invoice.vehicle.make %> <%= @invoice.vehicle.model %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">Year:</td>
                                      <td class="fw-bold"><%= @invoice.vehicle.year_of_manufacture %></td>
                                    </tr>
                                    <tr>
                                      <td class="text-muted">Service Owner:</td>
                                      <td class="fw-bold"><%= @invoice.vehicle.service_owner || 'N/A' %></td>
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% else %>
                        <div class="alert alert-warning">
                          <i class="bi bi-exclamation-triangle me-2"></i>
                          No vehicle assigned to this invoice
                        </div>
                      <% end %>
                    </div>

                    <!-- Approval Section - Finance Team Only -->
                    <div class="col-12">
                      <h6 class="text-uppercase text-muted small fw-bold mb-3">ACCOUNTING APPROVAL</h6>
                      <div class="card border-success">
                        <div class="card-header bg-success bg-opacity-10 border-success py-2">
                          <h6 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Ledger Posting</h6>
                        </div>
                        <div class="card-body">
                          <% if @invoice.approved? %>
                            <p class="mb-2"><strong>✅ Invoice Approved</strong></p>
                            <p class="mb-1 small">Approved by: <%= @invoice.approved_by&.name %></p>
                            <p class="mb-3 small">Approved on: <%= @invoice.approved_at&.strftime("%d %b %Y %H:%M") %></p>
                            
                            <% if @invoice.ledger_entries.any? %>
                              <p class="mb-1"><strong>Ledger Entries Created:</strong></p>
                              <ul class="mb-0 small">
                                <% @invoice.ledger_entries.each do |entry| %>
                                  <li><%= entry.account_code %> - <%= entry.account_name %>: <%= number_to_currency(entry.debit.positive? ? entry.debit : entry.credit) %></li>
                                <% end %>
                              </ul>
                            <% end %>
                          <% else %>
                            <p class="mb-3">This invoice requires accounting approval and ledger posting.</p>
                            <% if @invoice.pending? && (current_user.finance? || current_user.admin?) %>
                              <%= button_to "✅ Approve & Post to Ledger",
                                    approve_invoice_path(@invoice),
                                    method: :patch,
                                    class: "btn btn-success w-100",
                                    data: { turbo_confirm: "Approve this invoice and post to ledger?" } %>
                            <% else %>
                              <p class="text-muted mb-0 text-center">
                                <i class="bi bi-clock fs-4"></i><br>
                                Awaiting finance approval
                              </p>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Service Details -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-clipboard-check me-2"></i>
                SERVICE DETAILS
              </h5>
            </div>
            <div class="card-body p-4">
              <div class="row">
                <div class="col-md-8">
                  <h6 class="text-muted mb-3">Description of Services</h6>
                  <p class="mb-4">
                    <% if @invoice.maintenance %>
                      <%= @invoice.maintenance.description %>
                    <% elsif @invoice.notes.present? %>
                      <%= @invoice.notes %>
                    <% else %>
                      Vehicle maintenance and repair services as specified in the invoice.
                    <% end %>
                  </p>
                </div>
                <div class="col-md-4">
                  <h6 class="text-muted mb-3">Payment Status</h6>
                  <div class="progress mb-3" style="height: 20px;">
                    <% paid_percentage = @invoice.amount > 0 ? (@invoice.transactions.sum(:amount) / @invoice.amount * 100).to_i : 0 %>
                    <div class="progress-bar <%= paid_percentage == 100 ? 'bg-success' : 'bg-warning' %>" 
                         role="progressbar" 
                         style="width: <%= paid_percentage %>%;" 
                         aria-valuenow="<%= paid_percentage %>" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                      <%= paid_percentage %>%
                    </div>
                  </div>
                  <p class="mb-1 small">Paid: <%= number_to_currency(@invoice.transactions.sum(:amount)) %></p>
                  <p class="mb-0 small">Balance: <%= number_to_currency(@invoice.balance_due) %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Payment History -->
          <% if @invoice.transactions.any? %>
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold">
                  <i class="bi bi-credit-card me-2"></i>
                  PAYMENT HISTORY
                </h5>
              </div>
              <div class="card-body p-4">
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead class="table-light">
                      <tr>
                        <th>Date</th>
                        <th>Payment Method</th>
                        <th>Reference #</th>
                        <th class="text-end">Amount (TTD)</th>
                        <th>Notes</th>
                        <th>Processed By</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @transactions.each do |transaction| %>
                        <tr>
                          <td><%= transaction.transaction_date.strftime("%d %b %Y") %></td>
                          <td><span class="badge bg-info"><%= transaction.payment_method.humanize %></span></td>
                          <td><%= transaction.reference_number %></td>
                          <td class="text-end fw-bold"><%= number_to_currency(transaction.amount) %></td>
                          <td><%= transaction.notes %></td>
                          <td><%= transaction.user&.name || 'System' %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Notes Section -->
          <% if @invoice.notes.present? %>
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold">
                  <i class="bi bi-chat-left-text me-2"></i>
                  ADDITIONAL NOTES
                </h5>
              </div>
              <div class="card-body">
                <%= simple_format(@invoice.notes, class: 'mb-0') %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column - Actions and Information -->
        <div class="col-lg-4">
          <!-- Quick Actions -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-lightning-charge me-2"></i>
                QUICK ACTIONS
              </h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <% if @invoice.pending? && (current_user.finance? || current_user.admin?) %>
                  <%= button_to "✅ Approve & Post to Ledger",
                        approve_invoice_path(@invoice),
                        method: :patch,
                        class: 'btn btn-success',
                        data: { turbo_confirm: 'Approve this invoice and post to ledger?' } %>
                <% end %>
                
                <% if @invoice.pending? && (current_user.finance? || current_user.admin?) %>
                  <button type="button" 
                          class="btn btn-success mt-2" 
                          data-bs-toggle="modal" 
                          data-bs-target="#recordPaymentModal">
                    <i class="bi bi-credit-card me-2"></i>Record Payment
                  </button>
                <% end %>
                
                <% if @invoice.pending? && (current_user.finance? || current_user.admin?) %>
                  <button type="button" 
                          class="btn btn-warning mt-2" 
                          data-bs-toggle="modal" 
                          data-bs-target="#disputeModal">
                    <i class="bi bi-question-circle me-2"></i>Dispute Invoice
                  </button>
                <% end %>
                
                <!-- REMOVED: Edit Invoice button - only admins should edit invoices -->
              </div>
            </div>
          </div>

          <!-- Record Payment Modal -->
          <div class="modal fade" id="recordPaymentModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Record Payment</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <%= form_with url: record_payment_invoice_path(@invoice), method: :post do |f| %>
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Payment Amount (TTD)</label>
                      <%= f.number_field :amount, class: 'form-control', step: '0.01', min: '0', 
                            value: @invoice.balance_due, max: @invoice.balance_due %>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Payment Method</label>
                      <%= f.select :payment_method, 
                            options_for_select([['Cash', 'cash'], ['Cheque', 'cheque'], 
                                                ['Bank Transfer', 'bank_transfer'], 
                                                ['Credit Card', 'credit_card']]), 
                            {}, class: 'form-select' %>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Notes</label>
                      <%= f.text_area :notes, class: 'form-control', rows: 3, 
                            placeholder: 'Payment details...' %>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <%= f.submit 'Record Payment', class: 'btn btn-success' %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Dispute Modal -->
          <div class="modal fade" id="disputeModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Dispute Invoice</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <%= form_with url: dispute_invoice_path(@invoice), method: :post do |f| %>
                  <div class="modal-body">
                    <p>Dispute invoice <strong><%= @invoice.invoice_number %></strong> from <%= @invoice.vendor %>?</p>
                    <div class="mb-3">
                      <label class="form-label">Reason for dispute:</label>
                      <%= f.text_area :reason, class: "form-control", rows: 3, 
                            placeholder: "Enter reason for disputing this invoice..." %>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <%= f.submit "Dispute Invoice", class: "btn btn-warning" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Ledger Entries -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-journal me-2"></i>
                LEDGER ENTRIES
              </h5>
            </div>
            <div class="card-body">
              <% if @invoice.ledger_entries.any? %>
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Account</th>
                      <th class="text-end">Debit</th>
                      <th class="text-end">Credit</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @invoice.ledger_entries.each do |e| %>
                      <tr>
                        <td><%= e.account_code %> – <%= e.account_name %></td>
                        <td class="text-end"><%= number_to_currency(e.debit) %></td>
                        <td class="text-end"><%= number_to_currency(e.credit) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
                
                <!-- Finance Team Actions for Ledger - FIXED -->
                <% if current_user.finance? || current_user.admin? %>
                  <div class="mt-3">
                    <div class="alert alert-info p-2 small">
                      <i class="bi bi-info-circle me-1"></i>
                      Standard ledger entries (Debit: 6000, Credit: 2000) are created automatically when approving invoices.
                    </div>
                  </div>
                <% end %>
              <% else %>
                <p class="text-muted mb-0 text-center">
                  <i class="bi bi-journal-x fs-4"></i><br>
                  No ledger entries yet.
                </p>
                <% if @invoice.pending? && (current_user.finance? || current_user.admin?) %>
                  <div class="text-center mt-3">
                    <%= button_to "Post to Ledger", approve_invoice_path(@invoice),
                          method: :patch,
                          class: "btn btn-outline-success btn-sm w-100",
                          data: { turbo_confirm: "Approve and post to ledger?" } %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- 🔥 NEW: Payable Information Card (FIXED with correct path) -->
          <% if @invoice.payable.present? %>
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-info text-white py-3">
                <h5 class="mb-0 fw-bold">
                  <i class="bi bi-cash-stack me-2"></i>
                  ACCOUNTS PAYABLE
                </h5>
              </div>
              <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                  <tbody>
                    <tr>
                      <td class="text-muted">Payable ID:</td>
                      <td class="fw-bold">#<%= @invoice.payable.id %></td>
                    </tr>
                    <tr>
                      <td class="text-muted">Status:</td>
                      <td>
                        <span class="badge bg-<%= @invoice.payable.status == 'paid' ? 'success' : 'warning' %>">
                          <%= @invoice.payable.status.humanize %>
                        </span>
                      </td>
                    </tr>
                    <tr>
                      <td class="text-muted">Amount Due:</td>
                      <td class="fw-bold"><%= number_to_currency(@invoice.payable.amount_due) %></td>
                    </tr>
                    <tr>
                      <td class="text-muted">Due Date:</td>
                      <td><%= @invoice.payable.due_date.strftime("%d %b %Y") %></td>
                    </tr>
                    <% if @invoice.payable.account.present? %>
                      <tr>
                        <td class="text-muted">Account:</td>
                        <td><%= @invoice.payable.account.name %> (<%= @invoice.payable.account.account_number %>)</td>
                      </tr>
                    <% end %>
                    <tr>
                      <td class="text-muted">Reference:</td>
                      <td><%= @invoice.payable.reference_number %></td>
                    </tr>
                  </tbody>
                </table>
                
                <div class="mt-3">
                  <%= link_to "View Payable", accounts_payable_path(@invoice.payable), class: "btn btn-sm btn-outline-info w-100" %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Payable Information (if linked to Purchase Order) - KEPT FOR BACKWARD COMPATIBILITY -->
          <% if @invoice.purchase_order && @invoice.purchase_order.payable && @invoice.payable.nil? %>
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold">
                  <i class="bi bi-cash-stack me-2"></i>
                  PAYABLE INFORMATION
                </h5>
              </div>
              <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                  <tbody>
                    <tr>
                      <td class="text-muted">PO Number:</td>
                      <td class="fw-bold"><%= link_to @invoice.purchase_order.po_number, @invoice.purchase_order %></td>
                    </tr>
                    <tr>
                      <td class="text-muted">Payable Status:</td>
                      <td>
                        <span class="badge bg-<%= @invoice.purchase_order.payable.status == 'paid' ? 'success' : 'warning' %>">
                          <%= @invoice.purchase_order.payable.status.humanize %>
                        </span>
                      </td>
                    </tr>
                    <tr>
                      <td class="text-muted">Amount Due:</td>
                      <td class="fw-bold"><%= number_to_currency(@invoice.purchase_order.payable.amount_due) %></td>
                    </tr>
                    <tr>
                      <td class="text-muted">Due Date:</td>
                      <td><%= @invoice.purchase_order.payable.due_date.strftime("%d %b %Y") %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>

          <!-- Invoice Information -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
              <h5 class="mb-0 fw-bold">
                <i class="bi bi-info-circle me-2"></i>
                INVOICE INFORMATION
              </h5>
            </div>
            <div class="card-body">
              <table class="table table-sm table-borderless mb-0">
                <tbody>
                  <tr>
                    <td class="text-muted">Created:</td>
                    <td class="text-end"><%= @invoice.created_at.strftime("%d %b %Y") %></td>
                  </tr>
                  <tr>
                    <td class="text-muted">Last Updated:</td>
                    <td class="text-end"><%= @invoice.updated_at.strftime("%d %b %Y") %></td>
                  </tr>
                  <% if @invoice.received_by %>
                    <tr>
                      <td class="text-muted">Reviewed By:</td>
                      <td class="text-end"><%= @invoice.received_by.name %></td>
                    </tr>
                  <% end %>
                  <% if @invoice.quickbooks_id %>
                    <tr>
                      <td class="text-muted">QuickBooks ID:</td>
                      <td class="text-end"><%= @invoice.quickbooks_id %></td>
                    </tr>
                    <% if @invoice.last_sync_at %>
                      <tr>
                        <td class="text-muted">Last Sync:</td>
                        <td class="text-end">
                          <%= @invoice.last_sync_at.strftime("%d %b %Y %H:%M") %>
                          <% if @invoice.recently_synced?(1) %>
                            <span class="badge bg-success ms-2">Recent</span>
                          <% elsif @invoice.sync_stale? %>
                            <span class="badge bg-warning ms-2">Stale</span>
                          <% end %>
                        </td>
                      </tr>
                      <tr>
                        <td class="text-muted">Sync Status:</td>
                        <td class="text-end">
                          <% if @invoice.sync_success? %>
                            <span class="badge bg-success">Success</span>
                          <% elsif @invoice.sync_failed? %>
                            <span class="badge bg-danger">Failed</span>
                          <% elsif @invoice.sync_error? %>
                            <span class="badge bg-danger">Error</span>
                          <% else %>
                            <span class="badge bg-secondary">Pending</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  <% else %>
                    <tr>
                      <td class="text-muted">QuickBooks:</td>
                      <td class="text-end">
                        <span class="badge bg-secondary">Not Synced</span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

