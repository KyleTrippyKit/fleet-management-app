<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <%= link_to invoices_path, class: "btn btn-light border shadow-sm px-3 py-1" do %>
      <i class="bi bi-arrow-left me-1"></i> Back to Invoices
    <% end %>
    
    <div class="btn-group" style="margin-right: 100px;">
      <%# Download button %>
      <%= link_to download_invoice_path(@invoice), class: "btn btn-primary shadow-sm px-3 py-1", title: "Download PDF" do %>
        <i class="bi bi-download me-1"></i> Download
      <% end %>
      
      <%# Action buttons based on status and permissions %>
      <% if @invoice.pending? %>
        <% if current_user.can_review_invoices? %>
          <%= button_to mark_as_reviewed_invoice_path(@invoice), 
                method: :post,
                class: "btn btn-info text-white shadow-sm px-3 py-1",
                title: "Mark as Reviewed",
                data: { confirm: "Mark this invoice as reviewed?" } do %>
            <i class="bi bi-check-circle me-1"></i> Mark Reviewed
          <% end %>
        <% end %>
        
        <% if current_user.can_pay_invoices? %>
          <%= button_to mark_as_paid_invoice_path(@invoice), 
                method: :post,
                class: "btn btn-success shadow-sm px-3 py-1",
                title: "Mark as Paid",
                data: { confirm: "Mark this invoice as paid?" } do %>
            <i class="bi bi-currency-dollar me-1"></i> Mark Paid
          <% end %>
        <% end %>
        
        <% if current_user.can_dispute_invoices? %>
          <button type="button" 
                  class="btn btn-warning text-dark shadow-sm px-3 py-1" 
                  title: "Dispute Invoice"
                  data-bs-toggle="modal" 
                  data-bs-target="#disputeModal">
            <i class="bi bi-question-circle me-1"></i> Dispute
          </button>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <!-- Main Invoice Details -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
              <h2 class="fw-bold mb-1">Invoice <%= @invoice.invoice_number %></h2>
              <p class="text-muted mb-0"><%= @invoice.vendor %></p>
              <p class="text-muted mb-0">
                <small>
                  Created: <%= @invoice.created_at&.strftime("%B %d, %Y at %I:%M %p") %>
                  <% if @invoice.updated_at != @invoice.created_at %>
                    • Updated: <%= @invoice.updated_at&.strftime("%B %d, %Y at %I:%M %p") %>
                  <% end %>
                </small>
              </p>
            </div>

            <span class="badge fs-6
              <%= case @invoice.status
                  when "paid" then "bg-success"
                  when "overdue" then "bg-danger"
                  when "pending" then "bg-warning text-dark"
                  when "cancelled" then "bg-secondary"
                  else "bg-info"
                  end %>">
              <%= @invoice.status.titleize %>
            </span>
          </div>

          <hr>

          <div class="row mb-4">
            <div class="col-md-6">
              <p class="small text-muted mb-1">Invoice Date</p>
              <p class="fw-bold"><%= @invoice.invoice_date&.strftime("%B %d, %Y") %></p>
            </div>

            <div class="col-md-6">
              <p class="small text-muted mb-1">Due Date</p>
              <p class="fw-bold <%= 'text-danger' if @invoice.overdue? %>">
                <%= @invoice.due_date&.strftime("%B %d, %Y") %>
                <% if @invoice.overdue? %>
                  <span class="badge bg-danger ms-2">OVERDUE</span>
                <% elsif @invoice.days_until_due && @invoice.days_until_due >= 0 %>
                  <small class="text-muted d-block">(<%= @invoice.days_until_due %> days remaining)</small>
                <% end %>
              </p>
            </div>
          </div>

          <h6 class="fw-bold mb-3">Vehicle Information</h6>
          <% if @invoice.vehicle %>
            <div class="card bg-light mb-3">
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <p class="mb-1"><strong>Make/Model:</strong> <%= @invoice.vehicle.make %> <%= @invoice.vehicle.model %></p>
                    <p class="mb-1"><strong>Plate:</strong> <%= @invoice.vehicle.license_plate %></p>
                    <p class="mb-1"><strong>VIN:</strong> <%= @invoice.vehicle.chassis_number || 'N/A' %></p>
                  </div>
                  <div class="col-md-6">
                    <p class="mb-1"><strong>Agency:</strong> <%= @invoice.vehicle.service_owner %></p>
                    <p class="mb-1"><strong>Year:</strong> <%= @invoice.vehicle.year_of_manufacture || 'N/A' %></p>
                    <p class="mb-1"><strong>Status:</strong> <%= @invoice.vehicle.status&.titleize || 'N/A' %></p>
                  </div>
                </div>
                <%= link_to "View Vehicle Details", vehicle_path(@invoice.vehicle), class: "btn btn-sm btn-primary mt-2 px-2 py-1" %>
              </div>
            </div>
          <% else %>
            <p class="text-muted">No vehicle assigned to this invoice</p>
          <% end %>

          <% if @invoice.maintenance %>
            <h6 class="fw-bold mb-3 mt-4">Related Maintenance</h6>
            <div class="card bg-light">
              <div class="card-body">
                <p class="mb-1"><strong>Description:</strong> <%= @invoice.maintenance.description %></p>
                <p class="mb-1"><strong>Date:</strong> <%= @invoice.maintenance.date&.strftime("%B %d, %Y") %></p>
                <p class="mb-1"><strong>Status:</strong> <%= @invoice.maintenance.status&.titleize || 'N/A' %></p>
                <p class="mb-0"><strong>Cost:</strong> <%= number_to_currency(@invoice.maintenance.cost || 0) %></p>
              </div>
            </div>
          <% end %>

          <% if @invoice.notes.present? %>
            <hr class="my-4">
            <h6 class="fw-bold mb-3">Notes</h6>
            <div class="card bg-light">
              <div class="card-body">
                <%= simple_format(@invoice.notes) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Summary & Actions -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Invoice Summary</h6>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Subtotal</span>
            <span><%= number_to_currency(@invoice.subtotal || @invoice.amount) %></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Tax</span>
            <span><%= number_to_currency(@invoice.tax || 0) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total</span>
            <span><%= number_to_currency(@invoice.amount) %></span>
          </div>

          <% if @invoice.category.present? %>
            <div class="mt-3">
              <span class="text-muted">Category:</span>
              <span class="badge bg-info"><%= @invoice.category.humanize %></span>
            end
          <% end %>
        </div>
      </div>

      <!-- Agency Information -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Agency Information</h6>
          
          <div class="mb-3">
            <p class="small text-muted mb-1">Service Owner/Agency</p>
            <p class="fw-bold"><%= @invoice.agency_name %></p>
          </div>
          
          <div class="mb-3">
            <p class="small text-muted mb-1">Invoice Aging</p>
            <p class="fw-bold"><%= @invoice.aging_days %> days since invoice date</p>
          </div>
          
          <div class="mb-3">
            <p class="small text-muted mb-1">Payment Status</p>
            <p class="fw-bold">
              <% if @invoice.paid? %>
                <span class="text-success">✓ Paid</span>
              <% elsif @invoice.overdue? %>
                <span class="text-danger">⚠️ Overdue</span>
              <% elsif @invoice.pending? %>
                <span class="text-warning">⏳ Pending</span>
              <% else %>
                <%= @invoice.status.titleize %>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Dispute Modal -->
<% if @invoice.pending? && current_user.can_dispute_invoices? %>
  <div class="modal fade" id="disputeModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Dispute Invoice</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: dispute_invoice_path(@invoice), method: :post do |f| %>
          <div class="modal-body">
            <p>Are you sure you want to dispute invoice <strong><%= @invoice.invoice_number %></strong>?</p>
            <div class="mb-3">
              <label class="form-label">Reason for dispute:</label>
              <%= text_area_tag :reason, nil, class: "form-control", rows: 4, 
                    placeholder: "Please provide a detailed reason for disputing this invoice..." %>
            </div>
            <div class="alert alert-warning">
              <small>
                <i class="bi bi-exclamation-triangle"></i>
                Disputing an invoice will mark it as cancelled and notify VMCOTT.
              </small>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light border px-3 py-1" data-bs-dismiss="modal">Cancel</button>
            <%= submit_tag "Submit Dispute", class: "btn btn-warning px-3 py-1" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>