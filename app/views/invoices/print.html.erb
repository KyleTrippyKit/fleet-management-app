<%# app/views/invoices/print.pdf.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice <%= @invoice.invoice_number %></title>
  <style>
    /* Minimal print-friendly styles */
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      margin: 0;
      padding: 20px;
    }
    
    .header {
      text-align: center;
      margin-bottom: 30px;
      border-bottom: 2px solid #000;
      padding-bottom: 15px;
    }
    
    .header h1 {
      font-size: 24px;
      margin: 0 0 5px 0;
    }
    
    .header h2 {
      font-size: 18px;
      margin: 0;
      color: #333;
    }
    
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .info-box {
      border: 1px solid #ddd;
      padding: 15px;
    }
    
    .info-box h3 {
      margin: 0 0 10px 0;
      font-size: 14px;
      border-bottom: 1px solid #eee;
      padding-bottom: 5px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    
    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    
    th {
      background-color: #f5f5f5;
    }
    
    .text-right {
      text-align: right;
    }
    
    .total-row {
      font-weight: bold;
      background-color: #f9f9f9;
    }
    
    .summary {
      margin-top: 30px;
      padding: 15px;
      background-color: #f9f9f9;
      border: 1px solid #ddd;
    }
    
    .summary-row {
      display: flex;
      justify-content: space-between;
      margin: 5px 0;
    }
    
    .grand-total {
      font-size: 16px;
      font-weight: bold;
      border-top: 2px solid #000;
      padding-top: 10px;
      margin-top: 10px;
    }
    
    @media print {
      .no-print {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="no-print" style="text-align: center; margin-bottom: 20px;">
    <button onclick="window.print()">Print</button>
    <button onclick="window.close()">Close</button>
  </div>

  <div class="header">
    <h1>VMCOTT</h1>
    <h2>INVOICE #<%= @invoice.invoice_number %></h2>
  </div>

  <div class="info-grid">
    <div class="info-box">
      <h3>From</h3>
      <p>
        <strong><%= @invoice.vendor %></strong><br>
        Vendor Address<br>
        Phone: (868) 623-XXXX
      </p>
    </div>
    
    <div class="info-box">
      <h3>To</h3>
      <p>
        <strong><%= @invoice.agency_name || 'Agency' %></strong><br>
        <%= @invoice.vehicle&.service_owner || 'Government Agency' %><br>
        Port of Spain, Trinidad
      </p>
    </div>
  </div>

  <!-- Vehicle Info (if available) -->
  <% if @invoice.vehicle %>
  <div class="info-box" style="margin-bottom: 20px;">
    <h3>Vehicle Details</h3>
    <p>
      <strong>Vehicle:</strong> <%= @invoice.vehicle.make %> <%= @invoice.vehicle.model %><br>
      <strong>License Plate:</strong> <%= @invoice.vehicle.license_plate %><br>
      <strong>Year:</strong> <%= @invoice.vehicle.year_of_manufacture %>
    </p>
  </div>
  <% end %>

  <!-- Invoice Details Table -->
  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th class="text-right">Amount (TTD)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <strong><%= @invoice.category&.humanize || 'Services' %></strong>
          <% if @invoice.notes.present? %>
            <br><small><%= @invoice.notes %></small>
          <% end %>
        </td>
        <td class="text-right"><%= number_to_currency(@invoice.amount) %></td>
      </tr>
      
      <tr class="total-row">
        <td class="text-right"><strong>Subtotal:</strong></td>
        <td class="text-right"><%= number_to_currency(@invoice.amount) %></td>
      </tr>
      <tr class="total-row">
        <td class="text-right"><strong>VAT (12.5%):</strong></td>
        <td class="text-right"><%= number_to_currency(@invoice.vat_amount) %></td>
      </tr>
      <tr class="total-row">
        <td class="text-right"><strong>TOTAL:</strong></td>
        <td class="text-right"><strong><%= number_to_currency(@invoice.total_with_vat) %></strong></td>
      </tr>
    </tbody>
  </table>

  <!-- Payment Summary -->
  <div class="summary">
    <h3>Payment Summary</h3>
    <div class="summary-row">
      <span>Invoice Date:</span>
      <span><%= @invoice.invoice_date.strftime("%B %d, %Y") %></span>
    </div>
    <div class="summary-row">
      <span>Due Date:</span>
      <span><%= @invoice.due_date.strftime("%B %d, %Y") %></span>
    </div>
    <div class="summary-row">
      <span>Status:</span>
      <span><%= @invoice.status.upcase %></span>
    </div>
    <% if @invoice.paid? %>
    <div class="summary-row">
      <span>Paid Date:</span>
      <span><%= @invoice.paid_at.strftime("%B %d, %Y") %></span>
    </div>
    <% end %>
    <div class="summary-row grand-total">
      <span>Amount Due:</span>
      <span><%= number_to_currency(@invoice.balance_due) %></span>
    </div>
  </div>

  <!-- Footer -->
  <div style="margin-top: 50px; text-align: center; font-size: 10px; color: #666; border-top: 1px solid #ccc; padding-top: 10px;">
    <p>Thank you for your business! | Generated on <%= Time.current.strftime("%B %d, %Y") %></p>
  </div>
</body>
</html>