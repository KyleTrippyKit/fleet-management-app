<%# app/views/invoices/index.html.erb - UPDATED WITH SYNC INDICATORS %>
<div class="container-fluid mt-4">
  <%# Page Header - Show agency name %>
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h2 mb-1">
        <% if current_user.agency_name.present? %>
          <%= current_user.agency_name %> Invoices
        <% else %>
          Invoices
        <% end %>
      </h1>
      <p class="text-muted mb-0">
        Manage invoices received from service providers
        <% if current_user.agency_name.present? %>
          for <%= current_user.agency_name %>
        <% end %>
      </p>
    </div>
    
    <div class="d-flex align-items-center gap-2" style="transform: translateX(-120px);">
      <%# "Back to Dashboard" button - Now links to ptsc_dashboard %>
      <%= link_to ptsc_dashboard_path, class: "btn btn-light border px-3 py-1" do %>
        <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
      <% end %>
      
      <% if current_user.can_view_invoice_reports? %>
        <%= link_to reports_invoices_path, class: "btn btn-outline-primary px-3 py-1" do %>
          <i class="bi bi-graph-up me-1"></i> Reports
        <% end %>
      <% end %>
      
      <%# NEW: Sync status filter dropdown %>
      <div class="dropdown">
        <button class="btn btn-outline-info px-3 py-1 dropdown-toggle" type="button" id="syncFilterDropdown" data-bs-toggle="dropdown">
          <i class="bi bi-cloud-arrow-up me-1"></i> Sync Status
        </button>
        <ul class="dropdown-menu" aria-labelledby="syncFilterDropdown">
          <li><%= link_to "All Sync Status", invoices_path, class: "dropdown-item" %></li>
          <li><%= link_to "Recently Synced (< 24h)", invoices_path(sync_status: "recent"), class: "dropdown-item" %></li>
          <li><%= link_to "Sync Stale (> 7d)", invoices_path(sync_status: "stale"), class: "dropdown-item" %></li>
          <li><%= link_to "Not Synced", invoices_path(sync_status: "not_synced"), class: "dropdown-item" %></li>
          <li><%= link_to "Sync Failed", invoices_path(sync_status: "failed"), class: "dropdown-item" %></li>
        </ul>
      </div>
    </div>
  </div>

  <%# Stats Dashboard - Agency specific %>
  <div class="row mb-4">
    <div class="col-md-3 col-6">
      <div class="card border-primary">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total Invoices</h6>
              <h3 class="mb-0"><%= @stats[:total] %></h3>
            </div>
            <div class="avatar-sm bg-primary bg-opacity-10 rounded">
              <i class="bi bi-receipt fs-4 text-primary"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-info">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Pending</h6>
              <h3 class="mb-0"><%= @stats[:pending] %></h3>
            </div>
            <div class="avatar-sm bg-info bg-opacity-10 rounded">
              <i class="bi bi-clock-history fs-4 text-info"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-danger">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Overdue</h6>
              <h3 class="mb-0"><%= @stats[:overdue] %></h3>
            </div>
            <div class="avatar-sm bg-danger bg-opacity-10 rounded">
              <i class="bi bi-exclamation-triangle fs-4 text-danger"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-warning">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Amount Due</h6>
              <h3 class="mb-0">$<%= number_with_precision(@stats[:pending_amount], precision: 2) %></h3>
            </div>
            <div class="avatar-sm bg-warning bg-opacity-10 rounded">
              <i class="bi bi-currency-dollar fs-4 text-warning"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# NEW: Sync Stats Row %>
  <div class="row mb-4">
    <div class="col-md-3 col-6">
      <div class="card border-success">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Synced</h6>
              <h3 class="mb-0"><%= @stats[:synced] || 0 %></h3>
            </div>
            <div class="avatar-sm bg-success bg-opacity-10 rounded">
              <i class="bi bi-cloud-check fs-4 text-success"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-secondary">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Not Synced</h6>
              <h3 class="mb-0"><%= @stats[:not_synced] || 0 %></h3>
            </div>
            <div class="avatar-sm bg-secondary bg-opacity-10 rounded">
              <i class="bi bi-cloud-slash fs-4 text-secondary"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-warning">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Recently Synced</h6>
              <h3 class="mb-0"><%= @stats[:recently_synced] || 0 %></h3>
            </div>
            <div class="avatar-sm bg-warning bg-opacity-10 rounded">
              <i class="bi bi-clock-history fs-4 text-warning"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 col-6">
      <div class="card border-danger">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Sync Stale</h6>
              <h3 class="mb-0"><%= @stats[:sync_stale] || 0 %></h3>
            </div>
            <div class="avatar-sm bg-danger bg-opacity-10 rounded">
              <i class="bi bi-exclamation-triangle fs-4 text-danger"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Filters card %>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-3"><i class="bi bi-funnel me-2"></i>Filter Invoices</h5>
      <%= form_with url: invoices_path, method: :get, class: "row g-3" do |f| %>
        <div class="col-md-2">
          <label class="form-label">Status</label>
          <%= select_tag :status, 
              options_for_select([
                ['All Statuses', ''],
                ['Pending', 'pending'],
                ['Paid', 'paid'],
                ['Overdue', 'overdue'],
                ['Cancelled', 'cancelled']
              ], params[:status]),
              class: "form-select" %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label">Vendor</label>
          <%= text_field_tag :vendor, params[:vendor], class: "form-control", placeholder: "Search vendor..." %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label">Sync Status</label>
          <%= select_tag :sync_filter, 
              options_for_select([
                ['All Sync', ''],
                ['Recently Synced', 'recent'],
                ['Sync Stale', 'stale'],
                ['Not Synced', 'not_synced'],
                ['Sync Failed', 'failed']
              ], params[:sync_filter]),
              class: "form-select" %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label">From Date</label>
          <%= date_field_tag :date_from, params[:date_from], class: "form-control" %>
        </div>
        
        <div class="col-md-2">
          <label class="form-label">To Date</label>
          <%= date_field_tag :date_to, params[:date_to], class: "form-control" %>
        </div>
        
        <div class="col-md-2 d-flex align-items-end">
          <div class="w-100 d-flex gap-2">
            <%= submit_tag "Apply", class: "btn btn-primary flex-grow-1 px-3 py-1" %>
            <%= link_to "Clear", invoices_path, class: "btn btn-outline-secondary flex-grow-1 px-3 py-1" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Invoices table %>
  <div class="card">
    <div class="card-body">
      <% if @invoices.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Vehicle</th>
                <th>Vendor</th>
                <th>Date</th>
                <th>Due Date</th>
                <th class="text-end">Amount</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each do |invoice| %>
                <tr class="<%= 'table-danger' if invoice.overdue? %> <%= 'table-warning' if invoice.pending? %>">
                  <td>
                    <strong><%= link_to invoice.invoice_number, invoice_path(invoice), class: "text-decoration-none" %></strong>
                    <% if invoice.pending? %>
                      <span class="badge bg-warning ms-1" title="Pending">PENDING</span>
                    <% end %>
                    <% if invoice.quickbooks_id %>
                      <% if invoice.sync_success? %>
                        <% if invoice.recently_synced?(1) %>
                          <span class="badge bg-success ms-1" title="Recently synced to QuickBooks (within 1 hour)">
                            <i class="bi bi-check-circle-fill"></i> Recent
                          </span>
                        <% elsif invoice.recently_synced?(24) %>
                          <span class="badge bg-info ms-1" title="Synced today to QuickBooks">
                            <i class="bi bi-check-circle"></i> Today
                          </span>
                        <% elsif invoice.sync_stale? %>
                          <span class="badge bg-warning ms-1" title="Sync stale (more than 7 days)">
                            <i class="bi bi-clock-history"></i> Stale
                          </span>
                        <% else %>
                          <span class="badge bg-secondary ms-1" title="Synced to QuickBooks">
                            <i class="bi bi-check-circle"></i> Synced
                          </span>
                        <% end %>
                      <% elsif invoice.sync_failed? %>
                        <span class="badge bg-danger ms-1" title="QuickBooks sync failed">
                          <i class="bi bi-x-circle"></i> Failed
                        </span>
                      <% elsif invoice.sync_error? %>
                        <span class="badge bg-danger ms-1" title="QuickBooks sync error">
                          <i class="bi bi-exclamation-triangle-fill"></i> Error
                        </span>
                      <% end %>
                    <% else %>
                      <span class="badge bg-light text-dark border ms-1" title="Not synced to QuickBooks">
                        <i class="bi bi-cloud-upload"></i> Not Synced
                      </span>
                    <% end %>
                  </td>
                  
                  <td>
                    <% if invoice.vehicle %>
                      <%= link_to invoice.vehicle.license_plate, vehicle_path(invoice.vehicle), class: "text-decoration-none" %>
                      <br>
                      <small class="text-muted"><%= invoice.vehicle.make %> <%= invoice.vehicle.model %></small>
                    <% else %>
                      <span class="text-muted">No vehicle</span>
                    <% end %>
                  </td>
                  
                  <td><%= invoice.vendor %></td>
                  
                  <td>
                    <%= invoice.invoice_date&.strftime('%b %d, %Y') %>
                    <br>
                    <small class="text-muted"><%= invoice.aging_days %> days</small>
                  </td>
                  
                  <td class="<%= 'text-danger fw-bold' if invoice.overdue? %>">
                    <%= invoice.due_date&.strftime('%b %d, %Y') %>
                    <% if invoice.overdue? %>
                      <br><small class="badge bg-danger">OVERDUE</small>
                    <% elsif invoice.days_until_due && invoice.days_until_due >= 0 %>
                      <br><small class="text-muted"><%= invoice.days_until_due %> days</small>
                    <% end %>
                  </td>
                  
                  <td class="text-end">
                    <strong class="<%= 'text-danger' if invoice.overdue? %>">
                      $<%= number_with_precision(invoice.amount, precision: 2) %>
                    </strong>
                    <% if invoice.category.present? %>
                      <br><small class="text-muted"><%= invoice.category.humanize %></small>
                    <% end %>
                  </td>
                  
                  <td>
                    <span class="badge <%= invoice.status_badge_class %>">
                      <%= invoice.status.humanize %>
                    </span>
                  </td>
                  
                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group" style="min-width: 220px;">
                      <%= link_to invoice_path(invoice), class: "btn btn-outline-primary px-2 py-1", title: "View Details", style: "width: 40px;" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      
                      <%= link_to invoice_path(invoice, format: :pdf), 
                                  class: "btn btn-outline-secondary px-2 py-1", 
                                  title: "Download PDF",
                                  data: { turbo: false } do %>
                        <i class="bi bi-download"></i>
                      <% end %>
                      
                      <% if invoice.pending? && current_user.can_review_invoices? %>
                        <%= button_to mark_as_reviewed_invoice_path(invoice), 
                              method: :post,
                              class: "btn btn-info px-2 py-1",
                              title: "Mark as Reviewed",
                              form: { class: "d-inline" },
                              style: "width: 40px;",
                              data: { confirm: "Mark this invoice as reviewed?" } do %>
                          <i class="bi bi-check"></i>
                        <% end %>
                      <% end %>
                      
                      <% if invoice.pending? && current_user.can_pay_invoices? %>
                        <%= button_to mark_as_paid_invoice_path(invoice), 
                              method: :post,
                              class: "btn btn-success px-2 py-1",
                              title: "Mark as Paid",
                              form: { class: "d-inline" },
                              style: "width: 40px;",
                              data: { confirm: "Mark this invoice as paid?" } do %>
                          <i class="bi bi-currency-dollar"></i>
                        <% end %>
                      <% end %>
                      
                      <% if invoice.pending? && current_user.can_dispute_invoices? %>
                        <button type="button" 
                                class="btn btn-warning px-2 py-1" 
                                title="Dispute Invoice"
                                style="width: 40px;"
                                data-bs-toggle="modal" 
                                data-bs-target="#disputeModal<%= invoice.id %>">
                          <i class="bi bi-question-circle"></i>
                        </button>
                      <% end %>
                      
                      <%# NEW: Quick sync button %>
                      <% if invoice.quickbooks_id.blank? && current_user.can_sync_quickbooks? %>
                        <%= button_to sync_to_quickbooks_invoice_path(invoice), 
                              method: :post,
                              class: "btn btn-outline-info px-2 py-1",
                              title: "Sync to QuickBooks",
                              form: { class: "d-inline" },
                              style: "width: 40px;",
                              data: { confirm: "Sync this invoice with QuickBooks?" } do %>
                          <i class="bi bi-cloud-arrow-up"></i>
                        <% end %>
                      <% elsif invoice.sync_stale? && current_user.can_sync_quickbooks? %>
                        <%= button_to sync_to_quickbooks_invoice_path(invoice), 
                              method: :post,
                              class: "btn btn-outline-warning px-2 py-1",
                              title: "Re-sync to QuickBooks",
                              form: { class: "d-inline" },
                              style: "width: 40px;",
                              data: { confirm: "Re-sync this stale invoice with QuickBooks?" } do %>
                          <i class="bi bi-arrow-repeat"></i>
                        <% end %>
                      <% end %>
                    </div>
                    
                    <%# Dispute Modal %>
                    <% if invoice.pending? && current_user.can_dispute_invoices? %>
                      <div class="modal fade" id="disputeModal<%= invoice.id %>" tabindex="-1">
                        <div class="modal-dialog">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title">Dispute Invoice</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <%= form_with url: dispute_invoice_path(invoice), method: :post do |f| %>
                              <div class="modal-body">
                                <p>Dispute invoice <strong><%= invoice.invoice_number %></strong> from <%= invoice.vendor %>?</p>
                                <div class="mb-3">
                                  <label class="form-label">Reason for dispute:</label>
                                  <%= text_area_tag :reason, nil, class: "form-control", rows: 3, placeholder: "Enter reason for disputing this invoice..." %>
                                </div>
                              </div>
                              <div class="modal-footer">
                                <button type="button" class="btn btn-light border px-3 py-1" data-bs-dismiss="modal">Cancel</button>
                                <%= submit_tag "Dispute Invoice", class: "btn btn-warning px-3 py-1" %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# Pagination %>
        <div class="mt-4">
          <%= paginate @invoices, theme: 'bootstrap-5' %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="text-muted">
            <i class="bi bi-inbox display-4 d-block mb-3"></i>
            <h4>No invoices found</h4>
            <p class="mb-4">
              <% if params.any? %>
                No invoices match your filters. Try clearing filters or contact VMCOTT.
              <% else %>
                No invoices have been received yet. Invoices from VMCOTT will appear here.
              <% end %>
            </p>
            <div class="d-flex justify-content-center gap-2">
              <% if params.any? %>
                <%= link_to "Clear filters", invoices_path, class: "btn btn-primary px-3 py-1" %>
              <% end %>
              <%= link_to ptsc_dashboard_path, class: "btn btn-light border px-3 py-1" do %>
                <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# CSS for sync badges %>
<style>
  .sync-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .sync-recent { background-color: #d1e7dd; color: #0f5132; }
  .sync-stale { background-color: #fff3cd; color: #664d03; }
  .sync-failed { background-color: #f8d7da; color: #842029; }
  .sync-success { background-color: #d1e7dd; color: #0f5132; }
  .sync-not-synced { background-color: #e2e3e5; color: #41464b; border: 1px solid #d3d6d8; }
</style>