  height: 10px;
  display: inline-block;
  border-radius: 2px;
}

.flag-red { background-color: #B91C1C; }
.flag-white { background-color: #FFFFFF; border: 1px solid #9CA3AF; }
.flag-black { background-color: #111827; }

/* Agency Badge */
.agency-badge {
