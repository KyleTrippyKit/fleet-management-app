<%# app/views/invoices/index.html.erb - TRINIDAD & TOBAGO THEMED INVOICE DASHBOARD %>
<%# UPDATED: Richer colors, less white space, more visual depth %>

<%
  # VMCOTT Official Colors - Richer palette
  vmcott_dark_blue = "#1E3A8A"     # Deep navy
  vmcott_medium_blue = "#2563EB"   # Bright blue
  vmcott_light_blue = "#3B82F6"    # Lighter blue
  vmcott_gold = "#B45309"          # Rich gold
  vmcott_light_gold = "#FBBF24"    # Light gold
  vmcott_cream = "#FEF3C7"         # Cream color
  vmcott_light_gray = "#F3F4F6"    # Light gray
  vmcott_medium_gray = "#E5E7EB"   # Medium gray
  vmcott_border_gray = "#D1D5DB"   # Darker border
  vmcott_text_gray = "#374151"     # Darker text
  vmcott_success = "#047857"       # Deep green
  vmcott_success_light = "#D1FAE5" # Light green
  vmcott_warning = "#B45309"       # Deep orange
  vmcott_warning_light = "#FEF3C7" # Light orange
  vmcott_danger = "#B91C1C"        # Deep red
  vmcott_danger_light = "#FEE2E2"  # Light red
  vmcott_info = "#1E40AF"          # Deep blue
  vmcott_info_light = "#DBEAFE"    # Light blue
  vmcott_purple = "#5B21B6"        # Deep purple
  vmcott_purple_light = "#EDE9FE"  # Light purple
  
  # TT Flag colors - Bold
  tt_red = "#B91C1C"
  tt_white = "#FFFFFF"
  tt_black = "#111827"
  
  # Agency colors - More vibrant
  agency_colors = {
    "PTSC" => { bg: "#2563EB", text: "#FFFFFF", light_bg: "#DBEAFE", accent: "#FBBF24" },
    "TTPS" => { bg: "#B91C1C", text: "#FFFFFF", light_bg: "#FEE2E2", accent: "#FCD34D" },
    "TTDF" => { bg: "#047857", text: "#FBBF24", light_bg: "#D1FAE5", accent: "#FBBF24" },
    "VMCOTT" => { bg: "#1E3A8A", text: "#FFFFFF", light_bg: "#DBEAFE", accent: "#B45309" }
  }
  
  current_agency_code = current_user.agency&.code.to_s.upcase
  agency_color = agency_colors[current_agency_code] || { bg: "#4B5563", text: "#FFFFFF", light_bg: "#F3F4F6", accent: "#FBBF24" }
%>

<!-- Font Awesome 6 (Free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="vmcott-invoice-dashboard">
  <!-- Fixed width container -->
  <div class="container-fluid px-4 py-4" style="max-width: 1800px; margin: 0 auto;">

    <!-- ===== HEADER SECTION - Rich gradient ===== -->
    <div class="header-section mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center">
        <div>
          <div class="d-flex align-items-center gap-3">
            <!-- TT Flag Stripe - Prominent -->
            <div class="tt-flag-stripe">
              <div class="stripe-red"></div>
              <div class="stripe-white"></div>
              <div class="stripe-black"></div>
            </div>
            
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h2 fw-bold mb-0" style="color: <%= vmcott_dark_blue %>;">Invoices</h1>
                
                <% if current_user.agency.present? %>
                  <span class="agency-badge" 
                        style="background: <%= agency_color[:bg] %>; color: <%= agency_color[:text] %>; border-left: 3px solid <%= agency_color[:accent] %>;">
                    <i class="fas fa-building me-1"></i> <%= current_user.agency.code %>
                  </span>
                <% end %>
                
                <!-- TT Flag Badge - Bold -->
                <span class="tt-flag-badge">
                  <span class="flag-red"></span>
                  <span class="flag-white"></span>
                  <span class="flag-black"></span>
                  <span class="ms-1 fw-bold">T&T</span>
                </span>
              </div>
              
              <p class="mb-0 header-description">
                <i class="fas fa-file-invoice me-2" style="color: <%= vmcott_gold %>;"></i>
                <span class="fw-medium">Invoice Management System</span>
              </p>
              
              <div class="d-flex align-items-center gap-3 mt-2">
                <span class="time-badge">
                  <i class="far fa-clock me-1" style="color: <%= vmcott_dark_blue %>;"></i>
                  <%= Time.current.strftime("%b %d, %I:%M %p") %>
                </span>
                
                <% if @quickbooks_connected %>
                  <span class="quickbooks-badge">
                    <i class="fas fa-check-circle me-1"></i>
                    QB Connected
                  </span>
                <% else %>
                  <span class="quickbooks-badge offline">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    QB Offline
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        
        <!-- No action buttons - completely removed -->
      </div>
    </div>

    <!-- ===== KEY METRICS SECTION - Rich colored cards ===== -->
    <div class="row g-3 mb-4">
      <!-- Total Invoices -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card total-card" style="background: linear-gradient(145deg, <%= vmcott_info_light %>, white);">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="metric-label">Total Invoices</span>
              <div class="metric-value"><%= @stats[:total] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:total_amount] || 0, precision: 0) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_info %>20;">
              <i class="fas fa-file-invoice" style="color: <%= vmcott_info %>;"></i>
            </div>
          </div>
          <div class="metric-footer">
            <span class="trend-indicator">↗️ +8.2%</span>
            <span class="trend-label">vs last month</span>
          </div>
        </div>
      </div>
      
      <!-- Pending -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card pending-card" style="background: linear-gradient(145deg, <%= vmcott_warning_light %>, white);">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="metric-label">Pending</span>
              <div class="metric-value"><%= @stats[:pending] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:pending_amount] || 0, precision: 0) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_warning %>20;">
              <i class="fas fa-clock" style="color: <%= vmcott_warning %>;"></i>
            </div>
          </div>
          <div class="metric-footer">
            <span class="trend-indicator warning">⏳ <%= @stats[:pending] || 0 %> awaiting payment</span>
          </div>
        </div>
      </div>
      
      <!-- Overdue -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card overdue-card" style="background: linear-gradient(145deg, <%= vmcott_danger_light %>, white);">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="metric-label">Overdue</span>
              <div class="metric-value"><%= @stats[:overdue] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:overdue_amount] || 0, precision: 0) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= tt_red %>20;">
              <i class="fas fa-exclamation-triangle" style="color: <%= tt_red %>;"></i>
            </div>
          </div>
          <div class="metric-footer">
            <span class="trend-indicator danger">⚠️ <%= @stats[:aging_bands]&.dig(:over_90, :count) || 0 %> >90 days</span>
          </div>
        </div>
      </div>
      
      <!-- Paid This Month -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card paid-card" style="background: linear-gradient(145deg, <%= vmcott_success_light %>, white);">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="metric-label">Paid MTD</span>
              <div class="metric-value">$<%= number_with_precision(@stats[:paid_this_month] || 0, precision: 0) %></div>
              <span class="metric-subvalue">
                <%= @stats[:paid_count] || 0 %> invoices
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_success %>20;">
              <i class="fas fa-check-circle" style="color: <%= vmcott_success %>;"></i>
            </div>
          </div>
          <div class="metric-footer">
            <span class="trend-indicator success">✓ <%= ((@stats[:paid_this_month].to_f / @stats[:total_amount].to_f) * 100).round(0) rescue 0 %>% collected</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== SOURCE METRICS + AGING - Rich cards ===== -->
    <div class="row g-3 mb-4">
      <!-- Source metrics row -->
      <div class="col-12 col-md-9">
        <div class="row g-3">
          <div class="col-12 col-sm-4">
            <div class="source-metric-card" style="background: linear-gradient(145deg, <%= vmcott_purple_light %>, white); border-left: 4px solid <%= vmcott_purple %>;">
              <div class="d-flex align-items-center gap-3">
                <div class="source-icon" style="background: <%= vmcott_purple %>20;">
                  <i class="fas fa-shield-alt" style="color: <%= vmcott_purple %>;"></i>
                </div>
                <div>
                  <div class="source-label">VMCOTT Work</div>
                  <div class="source-value"><%= @stats[:from_vmcott] || 0 %></div>
                  <div class="source-trend">
                    $<%= number_with_precision(@stats[:vmcott_amount] || 0, precision: 0) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-sm-4">
            <div class="source-metric-card" style="background: linear-gradient(145deg, <%= vmcott_info_light %>, white); border-left: 4px solid <%= vmcott_info %>;">
              <div class="d-flex align-items-center gap-3">
                <div class="source-icon" style="background: <%= vmcott_info %>20;">
                  <i class="fas fa-diagram-project" style="color: <%= vmcott_info %>;"></i>
                </div>
                <div>
                  <div class="source-label">RFQ Workflow</div>
                  <div class="source-value"><%= @stats[:from_rfq] || 0 %></div>
                  <div class="source-trend">
                    $<%= number_with_precision(@stats[:rfq_amount] || 0, precision: 0) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-sm-4">
            <div class="source-metric-card" style="background: linear-gradient(145deg, <%= vmcott_success_light %>, white); border-left: 4px solid <%= vmcott_success %>;">
              <div class="d-flex align-items-center gap-3">
                <div class="source-icon" style="background: <%= vmcott_success %>20;">
                  <i class="fas fa-cloud-upload-alt" style="color: <%= vmcott_success %>;"></i>
                </div>
                <div>
                  <div class="source-label">QB Synced</div>
                  <div class="source-value"><%= @stats[:qb_synced] || 0 %></div>
                  <div class="source-trend">
                    <%= ((@stats[:qb_synced].to_f / @stats[:total].to_f) * 100).round(0) rescue 0 %>% of total
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Aging Summary - Rich card -->
      <div class="col-12 col-md-3">
        <div class="aging-compact-card" style="background: linear-gradient(145deg, #FEF3C7, white);">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
              <div class="aging-icon" style="background: <%= tt_red %>20; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-hourglass-half" style="color: <%= tt_red %>;"></i>
              </div>
              <span class="aging-compact-label fw-bold">Aging Analysis</span>
            </div>
          </div>
          
          <% aging_bands = @stats[:aging_bands] || {} %>
          <div class="aging-bands-detailed">
            <div class="aging-band-item">
              <div class="band-info">
                <span class="band-label">1-29 days</span>
                <span class="band-count"><%= aging_bands.dig(:under_30, :count) || 0 %></span>
              </div>
              <div class="band-progress">
                <div class="band-progress-bar yellow" style="width: <%= ((aging_bands.dig(:under_30, :count).to_f / @stats[:pending].to_f) * 100).round rescue 0 %>%"></div>
              </div>
              <span class="band-amount">$<%= number_with_precision(aging_bands.dig(:under_30, :amount) || 0, precision: 0) %></span>
            </div>
            
            <div class="aging-band-item">
              <div class="band-info">
                <span class="band-label">30-59 days</span>
                <span class="band-count"><%= aging_bands.dig(:days_30_59, :count) || 0 %></span>
              </div>
              <div class="band-progress">
                <div class="band-progress-bar amber" style="width: <%= ((aging_bands.dig(:days_30_59, :count).to_f / @stats[:pending].to_f) * 100).round rescue 0 %>%"></div>
              </div>
              <span class="band-amount">$<%= number_with_precision(aging_bands.dig(:days_30_59, :amount) || 0, precision: 0) %></span>
            </div>
            
            <div class="aging-band-item">
              <div class="band-info">
                <span class="band-label">60-89 days</span>
                <span class="band-count"><%= aging_bands.dig(:days_60_89, :count) || 0 %></span>
              </div>
              <div class="band-progress">
                <div class="band-progress-bar orange" style="width: <%= ((aging_bands.dig(:days_60_89, :count).to_f / @stats[:pending].to_f) * 100).round rescue 0 %>%"></div>
              </div>
              <span class="band-amount">$<%= number_with_precision(aging_bands.dig(:days_60_89, :amount) || 0, precision: 0) %></span>
            </div>
            
            <div class="aging-band-item">
              <div class="band-info">
                <span class="band-label">90+ days</span>
                <span class="band-count"><%= aging_bands.dig(:over_90, :count) || 0 %></span>
              </div>
              <div class="band-progress">
                <div class="band-progress-bar red" style="width: <%= ((aging_bands.dig(:over_90, :count).to_f / @stats[:pending].to_f) * 100).round rescue 0 %>%"></div>
              </div>
              <span class="band-amount">$<%= number_with_precision(aging_bands.dig(:over_90, :amount) || 0, precision: 0) %></span>
            </div>
          </div>
          
          <div class="aging-compact-total mt-3 pt-2" style="border-top: 1px solid #E2E8F0;">
            <div class="d-flex justify-content-between">
              <span>Total Overdue</span>
              <span class="fw-bold text-danger">$<%= number_with_precision(@stats[:overdue_amount] || 0, precision: 0) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== WORKFLOW INFO BANNER - Rich gradient ===== -->
    <div class="workflow-banner" style="background: linear-gradient(90deg, <%= vmcott_info_light %>, <%= vmcott_purple_light %>);">
      <div class="d-flex align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-info-circle" style="color: <%= vmcott_dark_blue %>;"></i>
          <span class="workflow-label fw-bold">Invoice Sources:</span>
        </div>
        <span class="source-tag vmcott"><i class="fas fa-shield-alt me-1"></i> VMCOTT Work</span>
        <span class="source-tag rfq"><i class="fas fa-diagram-project me-1"></i> RFQ → PO → Invoice</span>
        <span class="source-tag direct"><i class="fas fa-file me-1"></i> Direct Provider</span>
        <span class="source-tag manual"><i class="fas fa-pen me-1"></i> Manual Entry</span>
      </div>
    </div>

    <!-- ===== FILTERS SECTION - Rich card ===== -->
    <div class="filters-card" style="background: linear-gradient(145deg, white, <%= vmcott_light_gray %>);">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="filter-icon" style="background: <%= vmcott_dark_blue %>20; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-sliders-h" style="color: <%= vmcott_dark_blue %>;"></i>
          </div>
          <h6 class="fw-bold mb-0 filter-title">Filter Invoices</h6>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="advancedFiltersToggle" 
                 data-bs-toggle="collapse" data-bs-target="#filtersCollapse">
          <label class="form-check-label small fw-medium" for="advancedFiltersToggle">Advanced</label>
        </div>
      </div>
      
      <% quick_filter_base = request.query_parameters.symbolize_keys.except(:status, :page) %>
      <div class="quick-filter-row mb-3">
        <div class="quick-filter-group">
          <span class="quick-filter-label">Status:</span>
          <%= link_to "All", invoices_path(quick_filter_base), class: "quick-filter-chip #{'active' if params[:status].blank?}" %>
          <%= link_to "Pending", invoices_path(quick_filter_base.merge(status: 'pending')), class: "quick-filter-chip pending #{'active' if params[:status] == 'pending'}" %>
          <%= link_to "Paid", invoices_path(quick_filter_base.merge(status: 'paid')), class: "quick-filter-chip paid #{'active' if params[:status] == 'paid'}" %>
          <%= link_to "Overdue", invoices_path(quick_filter_base.merge(status: 'overdue')), class: "quick-filter-chip overdue #{'active' if params[:status] == 'overdue'}" %>
        </div>
      </div>

      <div class="collapse" id="filtersCollapse">
        <%= form_with url: invoices_path, method: :get, class: "row g-2" do |f| %>
          <div class="col-md-3">
            <label class="filter-label small fw-medium">Search #</label>
            <%= text_field_tag :search, params[:search], class: "filter-input", placeholder: "INV-2026..." %>
          </div>

          <div class="col-md-2">
            <label class="filter-label small fw-medium">Status</label>
            <%= select_tag :status, 
                options_for_select([
                  ['All', ''],
                  ['Pending', 'pending'],
                  ['Paid', 'paid'],
                  ['Overdue', 'overdue']
                ], params[:status]),
                class: "filter-select" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label small fw-medium">From</label>
            <%= date_field_tag :date_from, params[:date_from], class: "filter-input" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label small fw-medium">To</label>
            <%= date_field_tag :date_to, params[:date_to], class: "filter-input" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label small fw-medium">Sort</label>
            <%= select_tag :sort,
                options_for_select([
                  ['Newest', ''],
                  ['Oldest', 'oldest'],
                  ['Due soon', 'due_date_asc'],
                  ['Amount high', 'amount_desc']
                ], params[:sort]),
                class: "filter-select" %>
          </div>

          <div class="col-md-1">
            <label class="filter-label small fw-medium">Show</label>
            <%= select_tag :per_page,
                options_for_select([['20', 20], ['50', 50], ['100', 100]], params[:per_page].presence || 20),
                class: "filter-select" %>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <div class="w-100 d-flex gap-1">
              <%= submit_tag "Apply", class: "filter-apply-btn btn-sm" %>
              <%= link_to "Clear", invoices_path, class: "filter-clear-btn btn-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- ===== INVOICES TABLE - Rich row colors ===== -->
    <div class="invoices-table-card">
      <% if @invoices.any? %>
        <div class="table-responsive">
          <table class="invoices-table">
            <thead>
              <tr style="background: linear-gradient(90deg, <%= vmcott_dark_blue %>, <%= vmcott_medium_blue %>);">
                <th style="color: white;">Invoice</th>
                <th style="color: white;">Vehicle</th>
                <th style="color: white;">Vendor</th>
                <th style="color: white;">Source</th>
                <th style="color: white;">Date</th>
                <th style="color: white;">Due</th>
                <th class="text-end" style="color: white;">Amount</th>
                <th style="color: white;">Status</th>
                <th class="text-end" style="color: white;"></th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each_with_index do |invoice, index| %>
                <% 
                  row_class = case invoice.status
                    when 'paid' then 'paid-row'
                    when 'overdue' then 'overdue-row'
                    when 'pending' then 'pending-row'
                    else ''
                  end
                %>
                <tr class="<%= row_class %> <%= 'even-row' if index.even? %>">
                  <td>
                    <div>
                      <strong class="invoice-number">
                        <%= link_to invoice.invoice_number, invoice_path(invoice), 
                              class: "text-decoration-none", style: "color: #{vmcott_dark_blue};" %>
                      </strong>
                      <div class="d-flex gap-1 mt-1">
                        <% if invoice.received_by.nil? %>
                          <span class="badge-new">NEW</span>
                        <% end %>
                        <% if invoice.quickbooks_id %>
                          <span class="badge-qb" title="Synced to QB">QB</span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  
                  <td>
                    <% if invoice.vehicle %>
                      <span class="fw-medium"><%= invoice.vehicle.license_plate %></span>
                      <br>
                      <small class="text-secondary"><%= invoice.vehicle.make %></small>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </td>
                  
                  <td>
                    <div class="vendor-cell">
                      <span class="vendor-name"><%= invoice.vendor %></span>
                      <% if invoice.vendor == "VMCOTT" %>
                        <span class="vmcott-badge-small" style="background: <%= vmcott_success %>;">V</span>
                      <% end %>
                    </div>
                  </td>
                  
                  <td>
                    <% if invoice.purchase_order %>
                      <span class="source-badge-sm rfq" style="background: <%= vmcott_info_light %>; color: <%= vmcott_info %>;">
                        <i class="fas fa-diagram-project me-1"></i> RFQ
                      </span>
                    <% elsif invoice.vendor == "VMCOTT" %>
                      <span class="source-badge-sm vmcott" style="background: <%= vmcott_success_light %>; color: <%= vmcott_success %>;">
                        <i class="fas fa-shield-alt me-1"></i> VMC
                      </span>
                    <% else %>
                      <span class="source-badge-sm direct" style="background: <%= vmcott_light_gray %>; color: <%= vmcott_text_gray %>;">
                        <i class="fas fa-file me-1"></i> Dir
                      </span>
                    <% end %>
                  </td>
                  
                  <td>
                    <div class="date-cell">
                      <span class="fw-medium"><%= invoice.invoice_date&.strftime('%m/%d/%y') %></span>
                      <small class="aging-days"><%= invoice.aging_days %> days</small>
                    </div>
                  </td>
                  
                  <td>
                    <div class="date-cell <%= 'text-danger fw-bold' if invoice.overdue? %>">
                      <span><%= invoice.due_date&.strftime('%m/%d/%y') %></span>
                      <% if invoice.overdue? %>
                        <span class="overdue-badge-small" style="background: <%= tt_red %>;">!</span>
                      <% end %>
                    </div>
                  </td>
                  
                  <td class="text-end fw-bold amount-cell" style="font-size: 1rem;">
                    $<%= number_with_precision(invoice.amount, precision: 0) %>
                  </td>
                  
                  <td>
                    <span class="status-badge <%= invoice.status %>">
                      <% case invoice.status %>
                      <% when 'pending' %>
                        <i class="fas fa-clock me-1"></i> Pending
                      <% when 'paid' %>
                        <i class="fas fa-check-circle me-1"></i> Paid
                      <% when 'overdue' %>
                        <i class="fas fa-exclamation-triangle me-1"></i> Overdue
                      <% else %>
                        <%= invoice.status.titleize %>
                      <% end %>
                    </span>
                  </td>
                  
                  <td class="text-end">
                    <div class="action-buttons">
                      <%= link_to invoice_path(invoice), class: "action-btn-sm", title: "View", style: "color: #{vmcott_dark_blue};" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      
                      <%= link_to edit_invoice_path(invoice), class: "action-btn-sm", title: "Edit", style: "color: #{vmcott_dark_blue};" do %>
                        <i class="fas fa-edit"></i>
                      <% end %>
                      
                      <div class="dropdown d-inline-block">
                        <button class="action-btn-sm" type="button" data-bs-toggle="dropdown" style="color: <%= vmcott_dark_blue %>;">
                          <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                          <li>
                            <%= link_to download_invoice_path(invoice), class: "dropdown-item py-2" do %>
                              <i class="fas fa-download me-2"></i>Download PDF
                            <% end %>
                          </li>
                          <% if invoice.pending? %>
                            <li>
                              <%= button_to mark_as_paid_invoice_path(invoice), 
                                    method: :post,
                                    class: "dropdown-item py-2" do %>
                                <i class="fas fa-check me-2" style="color: <%= vmcott_success %>;"></i>Mark as Paid
                              <% end %>
                            </li>
                          <% end %>
                          <li>
                            <%= link_to "#", class: "dropdown-item py-2" do %>
                              <i class="fas fa-history me-2"></i>View History
                            <% end %>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination - Rich -->
        <div class="pagination-wrapper" style="background: linear-gradient(90deg, <%= vmcott_light_gray %>, white);">
          <div class="pagination-info">
            <i class="fas fa-file-invoice me-1" style="color: <%= vmcott_dark_blue %>;"></i>
            Showing <%= @invoices.offset_value + 1 %>-<%= @invoices.offset_value + @invoices.length %> of <%= @invoices.total_count %> invoices
          </div>
          <%= paginate @invoices, theme: 'bootstrap-5', pagination_class: "pagination-sm mb-0" %>
        </div>
        
      <% else %>
        <!-- Empty State - Rich (removed New Invoice button) -->
        <div class="empty-state" style="background: linear-gradient(145deg, <%= vmcott_light_gray %>, white);">
          <div class="empty-icon" style="background: <%= vmcott_dark_blue %>10;">
            <i class="fas fa-file-invoice" style="color: <%= vmcott_dark_blue %>;"></i>
          </div>
          <h5 class="fw-bold mb-2">No invoices found</h5>
          <p class="text-secondary mb-3">
            <% active_filter_keys = %w[search status date_from date_to sort per_page] %>
            <% if params.slice(*active_filter_keys).values.any?(&:present?) %>
              Try clearing your filters
            <% else %>
              No invoices to display
            <% end %>
          </p>
          
          <div class="d-flex justify-content-center gap-2">
            <%= link_to "Clear Filters", invoices_path, class: "btn-outline-ptsc" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- ===== FOOTER - Rich ===== -->
    <div class="dashboard-footer" style="background: linear-gradient(90deg, <%= vmcott_dark_blue %>, <%= vmcott_medium_blue %>);">
      <div class="d-flex align-items-center gap-3">
        <div class="tt-flag-mini">
          <span class="mini-red"></span>
          <span class="mini-white"></span>
          <span class="mini-black"></span>
        </div>
        <span class="footer-text text-white">VMCOTT • Trinidad & Tobago • Invoice Management System v2.0</span>
      </div>
      <span class="footer-text text-white opacity-75">© <%= Date.today.year %> All rights reserved</span>
    </div>
  </div>
</div>

<!-- ===== QUICKBOOKS STATUS MODAL ===== -->
<div class="modal fade" id="quickbooksStatusModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header py-2" style="background: linear-gradient(90deg, <%= vmcott_dark_blue %>, <%= vmcott_medium_blue %>);">
        <h6 class="modal-title text-white">QuickBooks Status</h6>
        <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body py-3">
        <% if @quickbooks_connected %>
          <div class="d-flex align-items-center gap-2 text-success mb-2">
            <div style="background: <%= vmcott_success_light %>; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-check-circle" style="color: <%= vmcott_success %>;"></i>
            </div>
            <div>
              <span class="fw-bold d-block">Connected</span>
              <small class="text-secondary">Last sync: <%= @quickbooks_last_sync&.strftime('%b %d, %Y') || 'Never' %></small>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top">
            <div class="d-flex justify-content-between">
              <span>Synced invoices:</span>
              <span class="fw-bold"><%= @stats[:qb_synced] || 0 %> of <%= @stats[:total] || 0 %></span>
            </div>
          </div>
        <% else %>
          <div class="d-flex align-items-center gap-2 text-warning mb-2">
            <div style="background: <%= vmcott_warning_light %>; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-exclamation-triangle" style="color: <%= vmcott_warning %>;"></i>
            </div>
            <div>
              <span class="fw-bold d-block">Offline</span>
              <small class="text-secondary">Connection inactive</small>
            </div>
          </div>
          <p class="small text-secondary mt-2 mb-0">QuickBooks connection is not active. Contact your administrator to restore the connection.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
/* ============================================================
   INVOICE DASHBOARD - Rich colors, minimal white
   ============================================================ */

.vmcott-invoice-dashboard {
  background: linear-gradient(135deg, #F3F4F6 0%, #F9FAFB 100%);
