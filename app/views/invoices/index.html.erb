    text-decoration: none;
  }
  
  .badge.bg-info a:hover,
  .badge.bg-success a:hover {
    text-decoration: underline;
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }
  
  .btn-group-sm > .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }
  
  .dropdown-toggle::after {
    margin-left: 0.25rem;
  }
</style>

<%# ===== JAVASCRIPT ===== %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-submit sort filter
  const sortSelect = document.getElementById('sort');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      this.form.submit();
    });
  }
  
  // Toggle advanced filters
  const filtersToggle = document.getElementById('advancedFiltersToggle');
  if (filtersToggle) {
    filtersToggle.addEventListener('change', function() {
      const label = this.nextElementSibling;
      if (this.checked) {
        label.textContent = 'Hide Filters';
      } else {
        label.textContent = 'Show Filters';
      }
    });
  }
  
  // QuickBooks status modal
  const quickbooksBadge = document.querySelector('[data-bs-target="#quickbooksStatusModal"]');
  if (quickbooksBadge) {
    quickbooksBadge.addEventListener('click', function() {
      new bootstrap.Modal(document.getElementById('quickbooksStatusModal')).show();
    });
  }
  
  // Initialize tooltips
  const tooltipTriggerList = document.querySelectorAll('[title]');
  tooltipTriggerList.forEach(function (tooltipTriggerEl) {
    new bootstrap.Tooltip(tooltipTriggerEl);
  });
});
</script>