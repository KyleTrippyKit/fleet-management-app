  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: #111827;
}

/* Header Section */
.header-section {
  background: linear-gradient(145deg, white, #F0F4FA);
  border: 1px solid #D1D5DB;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

/* TT Flag */
.tt-flag-stripe {
  display: flex;
  flex-direction: column;
  width: 6px;
