<%# app/views/invoices/index.html.erb - TRINIDAD & TOBAGO THEMED INVOICE DASHBOARD %>

<%
  # VMCOTT Official Colors
  vmcott_dark_blue = "#002D62"  # Primary - Dark professional blue
  vmcott_gold = "#D4AF37"        # Accent - Subtle gold
  vmcott_light_gray = "#F8F9FA"  # Background
  vmcott_border_gray = "#E5E7EB" # Borders
  vmcott_text_gray = "#4B5563"   # Text
  vmcott_success = "#10B981"     # Success green
  vmcott_warning = "#F59E0B"     # Warning orange
  vmcott_danger = "#EF4444"      # Danger red
  
  # TT Flag colors
  tt_red = "#C8102E"
  tt_white = "#FFFFFF"
  tt_black = "#000000"
  
  # Agency colors
  agency_colors = {
    "PTSC" => { bg: "#0033a0", text: "#FFFFFF" },
    "TTPS" => { bg: "#C8102E", text: "#FFFFFF" },
    "TTDF" => { bg: "#006747", text: "#D4AF37" },
    "VMCOTT" => { bg: vmcott_dark_blue, text: "#FFFFFF" }
  }
  
  current_agency_code = current_user.agency&.code.to_s.upcase
  agency_color = agency_colors[current_agency_code] || { bg: "#6B7280", text: "#FFFFFF" }
%>

<!-- Font Awesome 6 (Free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="vmcott-invoice-dashboard">
  <!-- Fixed width container for better readability -->
  <div class="container-fluid px-4 py-4" style="max-width: 1800px; margin: 0 auto;">

    <!-- ===== HEADER SECTION - Professional with TT Flag ===== -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4 pb-3 border-bottom" style="border-color: <%= vmcott_border_gray %> !important;">
      <div>
        <div class="d-flex align-items-center gap-3">
          <!-- TT Flag Stripe (prominent but professional) -->
          <div class="tt-flag-stripe" style="height: 56px;">
            <div class="stripe-red"></div>
            <div class="stripe-white"></div>
            <div class="stripe-black"></div>
          </div>
          
          <div>
            <div class="d-flex align-items-center gap-3 mb-1">
              <h1 class="h2 fw-bold mb-0" style="color: <%= vmcott_dark_blue %>;">Invoice Management</h1>
              
              <% if current_user.agency.present? %>
                <span class="badge rounded-pill px-3 py-2" 
                      style="background: <%= agency_color[:bg] %>; color: <%= agency_color[:text] %>; font-size: 0.75rem;">
                  <i class="fas fa-building me-1"></i> <%= current_user.agency.code %>
                </span>
              <% end %>
              
              <!-- TT Flag Badge -->
              <span class="tt-flag-badge">
                <span class="flag-red"></span>
                <span class="flag-white"></span>
                <span class="flag-black"></span>
                <span class="ms-1">Trinidad & Tobago</span>
              </span>
            </div>
            
            <p class="text-muted mb-0" style="color: <%= vmcott_text_gray %> !important;">
              <i class="fas fa-file-invoice me-2" style="color: <%= vmcott_gold %>;"></i>
              Manage invoices from VMCOTT, service providers, and RFQ workflow
            </p>
            
            <div class="d-flex align-items-center gap-3 mt-2">
              <span class="small text-muted">
                <i class="far fa-clock me-1" style="color: <%= vmcott_gold %>;"></i>
                <%= Time.current.strftime("%B %d, %Y at %I:%M %p") %>
              </span>
              
              <% if @quickbooks_connected %>
                <span class="quickbooks-badge" data-bs-toggle="modal" data-bs-target="#quickbooksStatusModal">
                  <i class="fas fa-check-circle me-1" style="color: <%= vmcott_success %>;"></i>
                  QuickBooks Connected
                </span>
              <% else %>
                <span class="quickbooks-badge offline" data-bs-toggle="modal" data-bs-target="#quickbooksStatusModal">
                  <i class="fas fa-exclamation-triangle me-1" style="color: <%= vmcott_warning %>;"></i>
                  QuickBooks Offline
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Action Buttons -->
      <div class="mt-3 mt-lg-0">
        <div class="d-flex gap-2">
          <%= link_to ptsc_dashboard_path, class: "btn-outline-ptsc" do %>
            <i class="fas fa-chart-pie me-2"></i> Dashboard
          <% end %>
          
          <%= link_to aging_report_invoices_path, class: "btn-outline-ptsc" do %>
            <i class="fas fa-clock me-2"></i> Aging Report
          <% end %>
          
          <%= link_to bulk_payment_interface_path, class: "btn-ptsc-primary" do %>
            <i class="fas fa-credit-card me-2"></i> Bulk Payment
          <% end %>
          
          <!-- Quick Actions Dropdown -->
          <div class="dropdown">
            <button class="btn-ptsc-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="fas fa-plus-circle me-2"></i> Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if current_user.can_create_invoices? %>
                <li>
                  <%= link_to new_invoice_path, class: "dropdown-item" do %>
                    <i class="fas fa-file-invoice me-2" style="color: <%= vmcott_dark_blue %>;"></i>
                    New Invoice
                  <% end %>
                </li>
              <% end %>
              
              <% if current_user.can_pay_invoices? %>
                <li>
                  <%= link_to new_transaction_path, class: "dropdown-item" do %>
                    <i class="fas fa-credit-card me-2" style="color: <%= vmcott_success %>;"></i>
                    Record Payment
                  <% end %>
                </li>
                
                <li><hr class="dropdown-divider"></li>
              <% end %>
              
              <% if current_user.can_sync_quickbooks? %>
                <li>
                  <%= button_to sync_quickbooks_invoices_path, method: :post, class: "dropdown-item" do %>
                    <i class="fas fa-sync me-2" style="color: <%= vmcott_gold %>;"></i>
                    Sync with QuickBooks
                  <% end %>
                </li>
              <% end %>
              
              <li><hr class="dropdown-divider"></li>
              
              <li>
                <%= link_to reports_invoices_path, class: "dropdown-item" do %>
                  <i class="fas fa-chart-line me-2" style="color: <%= vmcott_dark_blue %>;"></i>
                  Reports & Analytics
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== KEY METRICS SECTION - KPI Cards with TT Flag accents ===== -->
    <div class="row g-4 mb-5">
      <!-- Total Invoices -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card" style="border-left: 4px solid <%= vmcott_dark_blue %>;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="metric-label">Total Invoices</span>
              <div class="metric-value"><%= @stats[:total] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:total_amount] || 0, precision: 2) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_dark_blue %>10;">
              <i class="fas fa-file-invoice" style="color: <%= vmcott_dark_blue %>;"></i>
            </div>
          </div>
          <div class="tt-flag-accent"></div>
        </div>
      </div>
      
      <!-- Pending -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card" style="border-left: 4px solid <%= vmcott_warning %>;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="metric-label">Pending</span>
              <div class="metric-value"><%= @stats[:pending] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:pending_amount] || 0, precision: 2) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_warning %>10;">
              <i class="fas fa-clock" style="color: <%= vmcott_warning %>;"></i>
            </div>
          </div>
          <div class="tt-flag-accent"></div>
        </div>
      </div>
      
      <!-- Overdue -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card" style="border-left: 4px solid <%= tt_red %>;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="metric-label">Overdue</span>
              <div class="metric-value"><%= @stats[:overdue] %></div>
              <span class="metric-subvalue">
                $<%= number_with_precision(@stats[:overdue_amount] || 0, precision: 2) %>
              </span>
            </div>
            <div class="metric-icon" style="background: <%= tt_red %>10;">
              <i class="fas fa-exclamation-triangle" style="color: <%= tt_red %>;"></i>
            </div>
          </div>
          <div class="tt-flag-accent"></div>
        </div>
      </div>
      
      <!-- Paid This Month -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card" style="border-left: 4px solid <%= vmcott_success %>;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="metric-label">Paid This Month</span>
              <div class="metric-value">$<%= number_with_precision(@stats[:paid_this_month] || 0, precision: 0) %></div>
              <span class="metric-subvalue">
                <%= @stats[:paid_count] || 0 %> invoices
              </span>
            </div>
            <div class="metric-icon" style="background: <%= vmcott_success %>10;">
              <i class="fas fa-check-circle" style="color: <%= vmcott_success %>;"></i>
            </div>
          </div>
          <div class="tt-flag-accent"></div>
        </div>
      </div>
    </div>

    <!-- ===== SECONDARY METRICS ROW ===== -->
    <div class="row g-4 mb-5">
      <!-- From VMCOTT -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="secondary-metric-card">
          <div class="d-flex align-items-center gap-3">
            <div class="secondary-icon" style="background: <%= vmcott_success %>10;">
              <i class="fas fa-shield-alt" style="color: <%= vmcott_success %>;"></i>
            </div>
            <div>
              <div class="secondary-label">VMCOTT Work</div>
              <div class="secondary-value"><%= @stats[:from_vmcott] || 0 %></div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- From RFQ Workflow -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="secondary-metric-card">
          <div class="d-flex align-items-center gap-3">
            <div class="secondary-icon" style="background: <%= vmcott_gold %>20;">
              <i class="fas fa-diagram-project" style="color: <%= vmcott_dark_blue %>;"></i>
            </div>
            <div>
              <div class="secondary-label">RFQ Workflow</div>
              <div class="secondary-value"><%= @stats[:from_rfq] || 0 %></div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Synced to QB -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="secondary-metric-card">
          <div class="d-flex align-items-center gap-3">
            <div class="secondary-icon" style="background: <%= vmcott_dark_blue %>10;">
              <i class="fas fa-cloud-upload-alt" style="color: <%= vmcott_dark_blue %>;"></i>
            </div>
            <div>
              <div class="secondary-label">QuickBooks Synced</div>
              <div class="secondary-value"><%= @stats[:qb_synced] || 0 %></div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Aging > 30 days -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="secondary-metric-card">
          <div class="d-flex align-items-center gap-3">
            <div class="secondary-icon" style="background: <%= tt_red %>10;">
              <i class="fas fa-hourglass-half" style="color: <%= tt_red %>;"></i>
            </div>
            <div>
              <div class="secondary-label">Aging > 30 days</div>
              <div class="secondary-value"><%= @stats[:aging_30] || 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== WORKFLOW INFO BANNER ===== -->
    <div class="workflow-banner" role="status" aria-live="polite">
      <div class="d-flex align-items-center">
        <div class="tt-flag-stripe-small me-3">
          <span class="stripe-red"></span>
          <span class="stripe-white"></span>
          <span class="stripe-black"></span>
        </div>
        <div class="flex-grow-1">
          <i class="fas fa-info-circle me-2" style="color: <%= vmcott_dark_blue %>;"></i>
          <strong>Invoice Sources:</strong>
          <span class="source-badge vmcott ms-2">VMCOTT Work</span>
          <span class="source-badge rfq ms-2">RFQ → PO → Invoice</span>
          <span class="source-badge direct ms-2">Direct Provider</span>
        </div>
      </div>
    </div>

    <!-- ===== FILTERS SECTION ===== -->
    <div class="filters-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="filter-icon">
            <i class="fas fa-sliders-h" style="color: <%= vmcott_dark_blue %>;"></i>
          </div>
          <h5 class="fw-bold mb-0" style="color: <%= vmcott_dark_blue %>;">Filter Invoices</h5>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="advancedFiltersToggle" 
                 data-bs-toggle="collapse" data-bs-target="#filtersCollapse">
          <label class="form-check-label" for="advancedFiltersToggle">Show Filters</label>
        </div>
      </div>
      
      <div class="collapse show" id="filtersCollapse">
        <%= form_with url: invoices_path, method: :get, class: "row g-3" do |f| %>
          <div class="col-md-3">
            <label class="filter-label">Search Invoice #</label>
            <%= text_field_tag :search, params[:search], class: "filter-input", placeholder: "INV-2026-001..." %>
          </div>

          <div class="col-md-2">
            <label class="filter-label">Status</label>
            <%= select_tag :status, 
                options_for_select([
                  ['All Statuses', ''],
                  ['Pending', 'pending'],
                  ['Paid', 'paid'],
                  ['Overdue', 'overdue']
                ], params[:status]),
                class: "filter-select" %>
          </div>
          
          <div class="col-md-3">
            <label class="filter-label">Vendor</label>
            <%= text_field_tag :vendor, params[:vendor], class: "filter-input", placeholder: "Vendor name..." %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label">Source</label>
            <%= select_tag :source, 
                options_for_select([
                  ['All Sources', ''],
                  ['VMCOTT', 'vmcott'],
                  ['RFQ', 'rfq'],
                  ['Direct', 'direct']
                ], params[:source]),
                class: "filter-select" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label">From Date</label>
            <%= date_field_tag :date_from, params[:date_from], class: "filter-input" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label">To Date</label>
            <%= date_field_tag :date_to, params[:date_to], class: "filter-input" %>
          </div>
          
          <div class="col-md-2">
            <label class="filter-label">Sort</label>
            <%= select_tag :sort,
                options_for_select([
                  ['Newest first', ''],
                  ['Oldest first', 'oldest'],
                  ['Due date (soonest)', 'due_date_asc'],
                  ['Due date (latest)', 'due_date_desc'],
                  ['Amount (highest)', 'amount_desc'],
                  ['Amount (lowest)', 'amount_asc']
                ], params[:sort]),
                class: "filter-select" %>
          </div>

          <div class="col-md-1">
            <label class="filter-label">Per Page</label>
            <%= select_tag :per_page,
                options_for_select([['20', 20], ['50', 50], ['100', 100]], params[:per_page].presence || 20),
                class: "filter-select" %>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <div class="w-100 d-flex gap-2">
              <%= submit_tag "Apply", class: "filter-apply-btn" %>
              <%= link_to "Clear", invoices_path, class: "filter-clear-btn" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- ===== INVOICES TABLE ===== -->
    <div class="invoices-table-card">
      <% if @invoices.any? %>
        <div class="table-responsive">
          <table class="invoices-table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Vehicle</th>
                <th>Vendor</th>
                <th>Source</th>
                <th>Date</th>
                <th>Due Date</th>
                <th class="text-end">Amount</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each do |invoice| %>
                <% row_class = invoice.overdue? ? 'overdue-row' : nil %>
                <tr class="<%= row_class %>">
                  <!-- Invoice Number -->
                  <td>
                    <div class="d-flex flex-column">
                      <strong class="invoice-number">
                        <%= link_to invoice.invoice_number, invoice_path(invoice), 
                              class: "text-decoration-none", style: "color: #{vmcott_dark_blue};" %>
                      </strong>
                      <div class="d-flex flex-wrap gap-1 mt-1">
                        <% if invoice.received_by.nil? %>
                          <span class="badge-new">New</span>
                        <% end %>
                        
                        <% if invoice.quickbooks_id %>
                          <span class="badge-qb" title="Synced to QuickBooks">
                            <i class="fas fa-cloud-upload-alt"></i> QB
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  
                  <!-- Vehicle -->
                  <td>
                    <% if invoice.vehicle %>
                      <span class="fw-medium"><%= invoice.vehicle.license_plate %></span>
                      <br>
                      <small class="text-muted"><%= invoice.vehicle.make %></small>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  
                  <!-- Vendor -->
                  <td>
                    <%= invoice.vendor %>
                    <% if invoice.vendor == "VMCOTT" %>
                      <span class="vmcott-badge">VMCOTT</span>
                    <% end %>
                  </td>
                  
                  <!-- Source -->
                  <td>
                    <% if invoice.purchase_order %>
                      <span class="source-rfq">
                        <%= link_to "PO: #{invoice.purchase_order.po_number}", 
                              purchase_order_path(invoice.purchase_order),
                              class: "text-decoration-none text-white" %>
                      </span>
                    <% elsif invoice.vendor == "VMCOTT" %>
                      <span class="source-vmcott">VMCOTT Work</span>
                    <% else %>
                      <span class="source-direct">Direct</span>
                    <% end %>
                  </td>
                  
                  <!-- Date -->
                  <td>
                    <%= invoice.invoice_date&.strftime('%b %d, %Y') %>
                    <br>
                    <small class="text-muted"><%= invoice.aging_days %> days</small>
                  </td>
                  
                  <!-- Due Date -->
                  <td class="<%= 'text-danger fw-bold' if invoice.overdue? %>">
                    <%= invoice.due_date&.strftime('%b %d, %Y') %>
                    <% if invoice.overdue? %>
                      <br><span class="overdue-badge">OVERDUE</span>
                    <% end %>
                  </td>
                  
                  <!-- Amount -->
                  <td class="text-end">
                    <strong class="<%= 'text-danger' if invoice.overdue? %>">
                      $<%= number_with_precision(invoice.amount, precision: 2) %>
                    </strong>
                  </td>
                  
                  <!-- Status -->
                  <td>
                    <span class="status-badge <%= invoice.status %>">
                      <%= invoice.status.humanize %>
                    </span>
                  </td>
                  
                  <!-- Actions -->
                  <td class="text-end">
                    <div class="action-buttons">
                      <%= link_to invoice_path(invoice), class: "action-btn", title: "View" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      
                      <div class="dropdown d-inline-block">
                        <button class="action-btn" type="button" data-bs-toggle="dropdown">
                          <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                          <li>
                            <%= link_to download_invoice_path(invoice), class: "dropdown-item" do %>
                              <i class="fas fa-download me-2"></i>Download PDF
                            <% end %>
                          </li>
                          
                          <% if invoice.pending? %>
                            <li>
                              <%= button_to mark_as_paid_invoice_path(invoice), 
                                    method: :post,
                                    class: "dropdown-item text-success" do %>
                                <i class="fas fa-check me-2"></i>Mark Paid
                              <% end %>
                            </li>
                          <% end %>
                          
                          <% if current_user.can_sync_quickbooks? && invoice.quickbooks_id.blank? %>
                            <li>
                              <%= button_to sync_to_quickbooks_invoice_path(invoice), 
                                    method: :post,
                                    class: "dropdown-item" do %>
                                <i class="fas fa-cloud-upload-alt me-2"></i>Sync to QB
                              <% end %>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-wrapper">
          <div class="text-muted small">
            Showing <%= @invoices.offset_value + 1 %> to 
            <%= @invoices.offset_value + @invoices.length %> of 
            <%= @invoices.total_count %> invoices
          </div>
          <%= paginate @invoices, theme: 'bootstrap-5' %>
        </div>
        
      <% else %>
        <!-- Empty State -->
        <div class="empty-state">
          <div class="empty-icon">
            <i class="fas fa-file-invoice"></i>
          </div>
          <h4>No invoices found</h4>
          <p class="text-muted">
            <% active_filter_keys = %w[search status vendor source date_from date_to sort per_page] %>
            <% if params.slice(*active_filter_keys).values.any?(&:present?) %>
              No invoices match your current filters.
            <% else %>
              Invoices will appear here when generated from RFQs or VMCOTT work.
            <% end %>
          </p>
          
          <div class="d-flex justify-content-center gap-3">
            <%= link_to "Clear Filters", invoices_path, class: "btn-ptsc-primary" %>
            <%= link_to "View RFQs", sent_rfqs_path, class: "btn-outline-ptsc" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- ===== FOOTER ===== -->
    <div class="dashboard-footer">
      <div class="d-flex align-items-center gap-3">
        <div class="tt-flag-stripe-small">
          <span class="stripe-red"></span>
          <span class="stripe-white"></span>
          <span class="stripe-black"></span>
        </div>
        <span class="small text-muted">
          <i class="fas fa-shield-alt me-1" style="color: <%= vmcott_gold %>;"></i>
          Vehicle Maintenance Corporation of Trinidad and Tobago
        </span>
      </div>
      <span class="small text-muted">
        © <%= Date.today.year %> • All rights reserved
      </span>
    </div>
  </div>
</div>

<!-- ===== QUICKBOOKS STATUS MODAL ===== -->
<div class="modal fade" id="quickbooksStatusModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">QuickBooks Integration</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <% if @quickbooks_connected %>
          <div class="alert alert-success">
            <i class="fas fa-check-circle me-2"></i>
            Connected to QuickBooks Pro
          </div>
          <p><strong>Last Sync:</strong> <%= @quickbooks_last_sync&.strftime('%b %d, %Y %I:%M %p') || 'Never' %></p>
          <p><strong>Synced Invoices:</strong> <%= @stats[:qb_synced] || 0 %> of <%= @stats[:total] || 0 %></p>
        <% else %>
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            QuickBooks connection offline
          </div>
          <p>Please contact your administrator to configure QuickBooks.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

