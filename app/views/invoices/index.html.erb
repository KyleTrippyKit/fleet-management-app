}

.stripe-red { flex: 1; background-color: #B91C1C; }
.stripe-white { flex: 1; background-color: #FFFFFF; border-top: 1px solid #E5E7EB; border-bottom: 1px solid #E5E7EB; }
.stripe-black { flex: 1; background-color: #111827; }

.tt-flag-mini {
  display: flex;
  gap: 3px;
}

.mini-red, .mini-white, .mini-black {
  width: 4px;
  height: 16px;
  border-radius: 2px;
}

.mini-red { background: #B91C1C; }
.mini-white { background: #FFFFFF; border: 1px solid #D1D5DB; }
.mini-black { background: #111827; }

.tt-flag-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 4px 8px;
  background: linear-gradient(90deg, #B91C1C, #111827);
