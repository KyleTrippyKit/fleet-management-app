<%# app/views/invoices/index.html.erb - TRINIDAD & TOBAGO THEMED INVOICE DASHBOARD %>
<%# REVISED: Cleaner design, removed QuickBooks, better uniformity %>

<%
  # VMCOTT Official Colors - Professional palette
  vmcott_dark_blue = "#1E3A8A"     # Deep navy
  vmcott_medium_blue = "#2563EB"   # Bright blue
  vmcott_light_blue = "#3B82F6"    # Lighter blue
  vmcott_gold = "#B45309"          # Rich gold
  vmcott_light_gold = "#FBBF24"    # Light gold
  vmcott_cream = "#FEF3C7"         # Cream color
  vmcott_light_gray = "#F3F4F6"    # Light gray
  vmcott_medium_gray = "#E5E7EB"   # Medium gray
  vmcott_border_gray = "#D1D5DB"   # Darker border
  vmcott_text_gray = "#374151"     # Darker text
  vmcott_success = "#047857"       # Deep green
  vmcott_success_light = "#D1FAE5" # Light green
  vmcott_warning = "#B45309"       # Deep orange
  vmcott_warning_light = "#FEF3C7" # Light orange
  vmcott_danger = "#B91C1C"        # Deep red
  vmcott_danger_light = "#FEE2E2"  # Light red
  vmcott_info = "#1E40AF"          # Deep blue
  vmcott_info_light = "#DBEAFE"    # Light blue
  vmcott_purple = "#5B21B6"        # Deep purple
  vmcott_purple_light = "#EDE9FE"  # Light purple
  
  # TT Flag colors - Bold
  tt_red = "#B91C1C"
  tt_white = "#FFFFFF"
  tt_black = "#111827"
  
  # Agency colors - Clean and consistent
  agency_colors = {
    "PTSC" => { bg: "#2563EB", text: "#FFFFFF", light_bg: "#DBEAFE", accent: "#FBBF24" },
    "TTPS" => { bg: "#B91C1C", text: "#FFFFFF", light_bg: "#FEE2E2", accent: "#FCD34D" },
    "TTDF" => { bg: "#047857", text: "#FBBF24", light_bg: "#D1FAE5", accent: "#FBBF24" },
    "VMCOTT" => { bg: "#1E3A8A", text: "#FFFFFF", light_bg: "#DBEAFE", accent: "#B45309" }
  }
  
  current_agency_code = current_user.agency&.code.to_s.upcase
  agency_color = agency_colors[current_agency_code] || { bg: "#4B5563", text: "#FFFFFF", light_bg: "#F3F4F6", accent: "#FBBF24" }
  
  # Calculate percentages for trends
  collection_rate = @stats[:total_amount].to_f > 0 ? ((@stats[:paid_this_month].to_f / @stats[:total_amount].to_f) * 100).round(0) : 0
  overdue_percentage = @stats[:pending].to_f > 0 ? ((@stats[:overdue].to_f / @stats[:pending].to_f) * 100).round(0) : 0
%>

<!-- Font Awesome 6 (Free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="vmcott-invoice-dashboard">
  <div class="container-fluid px-4 py-4" style="max-width: 1800px; margin: 0 auto;">

    <!-- ===== HEADER SECTION - Clean and professional ===== -->
    <div class="header-section mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center">
        <div class="d-flex align-items-center gap-4">
          <!-- TT Flag Stripe -->
          <div class="tt-flag-stripe" style="height: 70px; width: 8px;">
            <div class="stripe-red"></div>
            <div class="stripe-white"></div>
            <div class="stripe-black"></div>
          </div>
          
          <div>
            <div class="d-flex align-items-center gap-3 mb-2">
              <h1 class="display-6 fw-bold mb-0" style="color: <%= vmcott_dark_blue %>;">Invoices</h1>
              
              <% if current_user.agency.present? %>
                <span class="agency-badge" 
                      style="background: <%= agency_color[:bg] %>; color: <%= agency_color[:text] %>; border-left: 4px solid <%= agency_color[:accent] %>; padding: 0.5rem 1.2rem;">
                  <i class="fas fa-building me-2"></i> <%= current_user.agency.code %>
                </span>
              <% end %>
              
              <!-- TT Flag Badge -->
              <span class="tt-flag-badge" style="background: linear-gradient(90deg, <%= tt_red %>, <%= tt_black %>); padding: 0.5rem 1.2rem;">
                <span class="flag-red"></span>
                <span class="flag-white"></span>
                <span class="flag-black"></span>
                <span class="ms-2 fw-semibold">T&T</span>
              </span>
            </div>
            
            <div class="d-flex align-items-center gap-3">
              <span class="time-badge">
                <i class="far fa-clock me-2" style="color: <%= vmcott_dark_blue %>;"></i>
                <%= Time.current.strftime("%B %d, %Y • %I:%M %p") %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== KEY METRICS SECTION - Clean cards with better hierarchy ===== -->
    <div class="row g-3 mb-4">
      <!-- Total Invoices -->
      <div class="col-12 col-sm-6 col-xl-3 d-flex">
        <div class="metric-card total-card w-100">
          <div class="d-flex flex-column h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="metric-label">Total Invoices</span>
              <div class="metric-icon" style="background: <%= vmcott_info %>20;">
                <i class="fas fa-file-invoice" style="color: <%= vmcott_info %>;"></i>
              </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-1">
              <div class="metric-value"><%= @stats[:total] %></div>
              <span class="metric-badge badge" style="background: <%= vmcott_info %>10; color: <%= vmcott_info %>;">invoices</span>
            </div>
            <div class="metric-amount mt-auto">
              <span class="fw-bold" style="font-size: 1.4rem;">$<%= number_with_precision(@stats[:total_amount] || 0, precision: 0) %></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Pending -->
      <div class="col-12 col-sm-6 col-xl-3 d-flex">
        <div class="metric-card pending-card w-100">
          <div class="d-flex flex-column h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="metric-label">Pending</span>
              <div class="metric-icon" style="background: <%= vmcott_warning %>20;">
                <i class="fas fa-clock" style="color: <%= vmcott_warning %>;"></i>
              </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-1">
              <div class="metric-value"><%= @stats[:pending] %></div>
              <span class="metric-badge badge" style="background: <%= vmcott_warning %>10; color: <%= vmcott_warning %>;">awaiting</span>
            </div>
            <div class="metric-amount mt-auto">
              <span class="fw-bold" style="font-size: 1.4rem;">$<%= number_with_precision(@stats[:pending_amount] || 0, precision: 0) %></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Overdue -->
      <div class="col-12 col-sm-6 col-xl-3 d-flex">
        <div class="metric-card overdue-card w-100">
          <div class="d-flex flex-column h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="metric-label">Overdue</span>
              <div class="metric-icon" style="background: <%= tt_red %>20;">
                <i class="fas fa-exclamation-triangle" style="color: <%= tt_red %>;"></i>
              </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-1">
              <div class="metric-value"><%= @stats[:overdue] %></div>
              <span class="metric-badge badge" style="background: <%= tt_red %>10; color: <%= tt_red %>;">past due</span>
            </div>
            <div class="metric-amount mt-auto">
              <span class="fw-bold" style="font-size: 1.4rem;">$<%= number_with_precision(@stats[:overdue_amount] || 0, precision: 0) %></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Paid This Month -->
      <div class="col-12 col-sm-6 col-xl-3 d-flex">
        <div class="metric-card paid-card w-100">
          <div class="d-flex flex-column h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="metric-label">Paid MTD</span>
              <div class="metric-icon" style="background: <%= vmcott_success %>20;">
                <i class="fas fa-check-circle" style="color: <%= vmcott_success %>;"></i>
              </div>
            </div>
            <div class="metric-amount mb-2">
              <span class="fw-bold" style="font-size: 2rem;">$<%= number_with_precision(@stats[:paid_this_month] || 0, precision: 0) %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-auto">
              <span class="text-muted small"><%= @stats[:paid_count] || 0 %> invoices</span>
              <span class="trend-indicator success"><%= collection_rate %>% collected</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== AGING SUMMARY - Compact and visual ===== -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <div class="aging-summary-card">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="aging-icon" style="background: <%= tt_red %>20; width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-hourglass-half" style="color: <%= tt_red %>;"></i>
            </div>
            <h5 class="fw-bold mb-0">Aging Analysis</h5>
            <span class="badge ms-auto" style="background: <%= vmcott_dark_blue %>10; color: <%= vmcott_dark_blue %>; padding: 0.5rem 1rem;">
              <%= @stats[:pending] || 0 %> pending
            </span>
          </div>
          
          <% aging_bands = @stats[:aging_bands] || {} %>
          <% bands = [
            { label: "1-29 days", key: :under_30, color: "#FCD34D", bg: "#FEF3C7", text_color: "#92400E" },
            { label: "30-59 days", key: :days_30_59, color: "#F59E0B", bg: "#FFEDD5", text_color: "#B45309" },
            { label: "60-89 days", key: :days_60_89, color: "#F97316", bg: "#FFF3E0", text_color: "#C2410C" },
            { label: "90+ days", key: :over_90, color: "#EF4444", bg: "#FEE2E2", text_color: "#B91C1C" }
          ] %>
          
          <div class="row g-2">
            <% bands.each do |band| %>
              <% count = aging_bands.dig(band[:key], :count) || 0 %>
              <% amount = aging_bands.dig(band[:key], :amount) || 0 %>
              <% percentage = @stats[:pending].to_f > 0 ? ((count.to_f / @stats[:pending].to_f) * 100).round(0) : 0 %>
              
              <div class="col-md-3">
                <div class="aging-band-item p-3 rounded-3" style="background: <%= band[:bg] %>;">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold" style="color: <%= band[:text_color] %>;"><%= band[:label] %></span>
                    <span class="badge rounded-pill" style="background: <%= band[:color] %>20; color: <%= band[:color] %>;">
                      <%= count %>
                    </span>
                  </div>
                  <div class="progress mb-2" style="height: 8px; background: rgba(0,0,0,0.05);">
                    <div class="progress-bar rounded-pill" role="progressbar" 
                         style="width: <%= percentage %>%; background: <%= band[:color] %>;"></div>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span class="small text-muted">Amount:</span>
                    <span class="fw-bold small" style="color: <%= band[:text_color] %>;">$<%= number_with_precision(amount, precision: 0) %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          
          <div class="mt-3 pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid <%= vmcott_border_gray %>;">
            <span class="fw-medium">Total Overdue</span>
            <span class="fw-bold text-danger h5 mb-0">$<%= number_with_precision(@stats[:overdue_amount] || 0, precision: 0) %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== FILTERS SECTION - Simplified ===== -->
    <div class="filters-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="filter-icon" style="background: <%= vmcott_dark_blue %>20; width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-sliders-h" style="color: <%= vmcott_dark_blue %>;"></i>
          </div>
          <h5 class="fw-bold mb-0">Filter Invoices</h5>
        </div>
      </div>
      
      <% quick_filter_base = request.query_parameters.symbolize_keys.except(:status, :page) %>
      <div class="quick-filter-row mb-3">
        <div class="quick-filter-group d-flex flex-wrap gap-2">
          <span class="quick-filter-label fw-medium me-2">Status:</span>
          <%= link_to "All", invoices_path(quick_filter_base), 
              class: "quick-filter-chip #{'active' if params[:status].blank?}" %>
          <%= link_to "Pending", invoices_path(quick_filter_base.merge(status: 'pending')), 
              class: "quick-filter-chip pending #{'active' if params[:status] == 'pending'}" %>
          <%= link_to "Paid", invoices_path(quick_filter_base.merge(status: 'paid')), 
              class: "quick-filter-chip paid #{'active' if params[:status] == 'paid'}" %>
          <%= link_to "Overdue", invoices_path(quick_filter_base.merge(status: 'overdue')), 
              class: "quick-filter-chip overdue #{'active' if params[:status] == 'overdue'}" %>
        </div>
      </div>

      <%= form_with url: invoices_path, method: :get, class: "row g-3", local: true do |f| %>
        <div class="col-md-4">
          <label class="filter-label small fw-medium" for="search">Search</label>
          <div class="position-relative">
            <%= text_field_tag :search, params[:search], 
                  class: "filter-input form-control", 
                  id: "search",
                  placeholder: "Invoice #, vendor, vehicle...",
                  style: "border-radius: 8px; padding: 0.5rem 2rem 0.5rem 1rem;" %>
            <i class="fas fa-search position-absolute top-50 end-0 translate-middle-y me-3" style="color: #9CA3AF;"></i>
          </div>
        </div>

        <div class="col-md-2">
          <label class="filter-label small fw-medium" for="status">Status</label>
          <%= select_tag :status, 
              options_for_select([
                ['All', ''],
                ['Pending', 'pending'],
                ['Paid', 'paid'],
                ['Overdue', 'overdue']
              ], params[:status]),
              class: "form-select",
              style: "border-radius: 8px; padding: 0.5rem;" %>
        </div>
        
        <div class="col-md-2">
          <label class="filter-label small fw-medium" for="date_from">From</label>
          <%= date_field_tag :date_from, params[:date_from], 
              class: "form-control",
              style: "border-radius: 8px; padding: 0.5rem;" %>
        </div>
        
        <div class="col-md-2">
          <label class="filter-label small fw-medium" for="date_to">To</label>
          <%= date_field_tag :date_to, params[:date_to], 
              class: "form-control",
              style: "border-radius: 8px; padding: 0.5rem;" %>
        </div>

        <div class="col-md-2 d-flex align-items-end">
          <div class="d-grid w-100">
            <%= submit_tag "Apply", class: "btn", style: "background: #{vmcott_dark_blue}; color: white; border-radius: 8px; padding: 0.5rem;" %>
          </div>
        </div>

        <div class="col-12">
          <%= link_to "Clear all filters", invoices_path, class: "small text-muted" %>
        </div>
      <% end %>
    </div>

    <!-- ===== INVOICES TABLE - Clean and consistent ===== -->
    <div class="invoices-table-card">
      <% if @invoices.any? %>
        <div class="table-responsive">
          <table class="invoices-table">
            <thead>
              <tr style="background: <%= vmcott_dark_blue %>;">
                <th scope="col" style="color: white; border-radius: 12px 0 0 0;">Invoice</th>
                <th scope="col" style="color: white;">Vehicle</th>
                <th scope="col" style="color: white;">Vendor</th>
                <th scope="col" style="color: white;">Date</th>
                <th scope="col" style="color: white;">Due</th>
                <th scope="col" class="text-end" style="color: white;">Amount</th>
                <th scope="col" style="color: white;">Status</th>
                <th scope="col" class="text-end" style="color: white; border-radius: 0 12px 0 0;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each do |invoice| %>
                <tr>
                  <td>
                    <strong>
                      <%= link_to invoice.invoice_number, invoice_path(invoice), 
                            class: "text-decoration-none", 
                            style: "color: #{vmcott_dark_blue};" %>
                    </strong>
                  </td>
                  
                  <td>
                    <% if invoice.vehicle %>
                      <span><%= invoice.vehicle.license_plate %></span>
                      <small class="text-secondary d-block"><%= invoice.vehicle.make %></small>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </td>
                  
                  <td>
                    <span class="vendor-name"><%= invoice.vendor %></span>
                  </td>
                  
                  <td>
                    <div><%= invoice.invoice_date&.strftime('%m/%d/%y') %></div>
                    <small class="text-secondary"><%= invoice.aging_days %> days</small>
                  </td>
                  
                  <td>
                    <div class="<%= 'text-danger fw-bold' if invoice.overdue? %>">
                      <%= invoice.due_date&.strftime('%m/%d/%y') %>
                      <% if invoice.overdue? %>
                        <span class="badge bg-danger ms-1" style="font-size: 0.6rem;">!</span>
                      <% end %>
                    </div>
                  </td>
                  
                  <td class="text-end fw-bold">
                    $<%= number_with_precision(invoice.amount, precision: 0) %>
                  </td>
                  
                  <td>
                    <span class="status-badge status-<%= invoice.status %>">
                      <% case invoice.status %>
                      <% when 'pending' %>
                        <i class="fas fa-clock me-1"></i> Pending
                      <% when 'paid' %>
                        <i class="fas fa-check-circle me-1"></i> Paid
                      <% when 'overdue' %>
                        <i class="fas fa-exclamation-triangle me-1"></i> Overdue
                      <% else %>
                        <%= invoice.status.titleize %>
                      <% end %>
                    </span>
                  </td>
                  
                  <td class="text-end">
                    <div class="action-buttons d-flex gap-2 justify-content-end">
                      <%= link_to invoice_path(invoice), 
                            class: "action-btn", 
                            title: "View",
                            style: "color: #{vmcott_dark_blue};" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                      
                      <div class="dropdown">
                        <button class="action-btn" 
                                type="button" 
                                data-bs-toggle="dropdown">
                          <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                          <li>
                            <%= link_to edit_invoice_path(invoice), class: "dropdown-item" do %>
                              <i class="fas fa-edit me-2"></i>Edit
                            <% end %>
                          </li>
                          <li>
                            <%= link_to download_invoice_path(invoice), class: "dropdown-item" do %>
                              <i class="fas fa-download me-2"></i>Download PDF
                            <% end %>
                          </li>
                          <% if invoice.pending? %>
                            <li>
                              <%= button_to mark_as_paid_invoice_path(invoice), 
                                    method: :post,
                                    class: "dropdown-item",
                                    form_class: "d-inline" do %>
                                <i class="fas fa-check me-2"></i>Mark as Paid
                              <% end %>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-wrapper d-flex justify-content-between align-items-center px-4 py-3">
          <div class="pagination-info">
            <span>Showing <%= @invoices.offset_value + 1 %>-<%= @invoices.offset_value + @invoices.length %> of <%= @invoices.total_count %> invoices</span>
          </div>
          <%= paginate @invoices, theme: 'bootstrap-5', pagination_class: "pagination-sm mb-0" %>
        </div>
        
      <% else %>
        <!-- Empty State -->
        <div class="empty-state text-center py-5">
          <div class="empty-icon mx-auto mb-4" style="background: <%= vmcott_dark_blue %>10; width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-file-invoice fa-3x" style="color: <%= vmcott_dark_blue %>;"></i>
          </div>
          <h4 class="fw-bold mb-2">No invoices found</h4>
          <p class="text-secondary mb-4">
            <% if params[:search].present? || params[:status].present? || params[:date_from].present? %>
              Try clearing your filters
            <% else %>
              No invoices to display
            <% end %>
          </p>
          <%= link_to "Clear Filters", invoices_path, class: "btn", style: "background: white; color: #{vmcott_dark_blue}; border: 1px solid #{vmcott_border_gray}; border-radius: 8px; padding: 0.5rem 2rem;" %>
        </div>
      <% end %>
    </div>

    <!-- ===== FOOTER ===== -->
    <div class="dashboard-footer mt-4" style="background: <%= vmcott_dark_blue %>; border-radius: 12px; padding: 1rem 1.5rem;">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-white opacity-75 small">VMCOTT • Trinidad & Tobago</span>
        <span class="text-white opacity-50 small">© <%= Date.today.year %></span>
      </div>
    </div>
  </div>
</div>

<style>
/* ============================================================
   INVOICE DASHBOARD - CLEAN PROFESSIONAL STYLES
   ============================================================ */

.vmcott-invoice-dashboard {
  background: #F9FAFB;
  min-height: 100vh;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

/* Header */
.header-section {
  background: white;
  border: 1px solid #E5E7EB;
  border-radius: 16px;
  padding: 1.5rem;
}

.tt-flag-stripe {
  display: flex;
  flex-direction: column;
  border-radius: 4px;
  overflow: hidden;
}

.stripe-red { flex: 1; background-color: #B91C1C; }
.stripe-white { flex: 1; background-color: #FFFFFF; border-top: 1px solid #E5E7EB; border-bottom: 1px solid #E5E7EB; }
.stripe-black { flex: 1; background-color: #111827; }

.agency-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 40px;
  font-size: 0.85rem;
  font-weight: 600;
}

.tt-flag-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 40px;
  font-size: 0.8rem;
  font-weight: 600;
  color: white;
}

.flag-red, .flag-white, .flag-black {
  width: 12px;
  height: 12px;
  display: inline-block;
  border-radius: 3px;
}

.flag-red { background-color: #B91C1C; }
.flag-white { background-color: #FFFFFF; border: 1px solid #9CA3AF; }
.flag-black { background-color: #111827; }

.time-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1.2rem;
  background: white;
  border: 1px solid #E5E7EB;
  border-radius: 40px;
  font-size: 0.8rem;
  color: #374151;
}

/* Metric Cards */
.metric-card {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #E5E7EB;
  transition: all 0.2s ease;
}

.metric-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 20px rgba(0,0,0,0.05);
}

.metric-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  color: #6B7280;
  font-weight: 600;
}

.metric-value {
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.metric-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}

.metric-badge {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 0.25rem 0.8rem;
  border-radius: 30px;
}

/* Aging Summary */
.aging-summary-card {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #E5E7EB;
}

.aging-band-item {
  height: 100%;
  border: 1px solid rgba(0,0,0,0.05);
}

/* Filters */
.filters-card {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #E5E7EB;
}

.quick-filter-chip {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  padding: 0.4rem 1.2rem;
  border: 1px solid #E5E7EB;
  border-radius: 40px;
