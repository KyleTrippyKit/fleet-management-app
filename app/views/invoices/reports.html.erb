<%# app/views/invoices/reports.html.erb %>

<%# Breadcrumb Navigation %>
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Invoices", invoices_path %></li>
    <li class="breadcrumb-item active" aria-current="page">Reports</li>
  </ol>
</nav>

<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h2 mb-1">PTSC Invoice Reports</h1>
      <p class="text-muted mb-0">Financial reports and analytics for PTSC invoices</p>
    </div>
    
    <%# Back Button %>
    <div class="position-relative" style="right: 120px;">
      <%= link_to invoices_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Back to Invoices
      <% end %>
    </div>
  </div>

  <%# Report Filters %>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-3"><i class="bi bi-calendar-range me-2"></i>Report Period</h5>
      <%= form_with url: reports_invoices_path, method: :get, class: "row g-3" do %>
        <div class="col-md-3">
          <label class="form-label">Start Date</label>
          <%= date_field_tag :start_date, @start_date, class: "form-control" %>
        </div>
        <div class="col-md-3">
          <label class="form-label">End Date</label>
          <%= date_field_tag :end_date, @end_date, class: "form-control" %>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <%= submit_tag "Generate Report", class: "btn btn-primary w-100" %>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <%= link_to "Export to Excel", reports_invoices_path(format: :csv, start_date: @start_date, end_date: @end_date), class: "btn btn-outline-success w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Summary Stats - FIXED: Added nil check %>
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Summary Report: <%= @start_date %> to <%= @end_date %></h5>
        </div>
        <div class="card-body">
          <div class="row">
            <% if @report_invoices.present? && @report_invoices.any? %>
              <% total_invoices = @report_invoices.count %>
              <% total_amount = @report_invoices.sum(:amount) %>
              <% paid_amount = @report_invoices.paid.sum(:amount) %>
              
              <div class="col-md-4">
                <div class="border rounded p-3 text-center">
                  <h3 class="text-primary"><%= total_invoices %></h3>
                  <p class="text-muted mb-0">Total Invoices</p>
                </div>
              </div>
              
              <div class="col-md-4">
                <div class="border rounded p-3 text-center">
                  <h3 class="text-success">$<%= number_with_precision(total_amount, precision: 2) %></h3>
                  <p class="text-muted mb-0">Total Billed</p>
                </div>
              </div>
              
              <div class="col-md-4">
                <div class="border rounded p-3 text-center">
                  <h3 class="text-info">$<%= number_with_precision(paid_amount, precision: 2) %></h3>
                  <p class="text-muted mb-0">Total Paid</p>
                </div>
              </div>
            <% else %>
              <div class="col-12 text-center py-4">
                <p class="text-muted">No invoices found for the selected period</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Status Breakdown - FIXED: Added nil checks %>
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">
          <h5 class="mb-0">Invoices by Status</h5>
        </div>
        <div class="card-body">
          <% if @report_stats && @report_stats[:by_status].present? && @report_stats[:by_status].any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Status</th>
                  <th class="text-end">Count</th>
                  <th class="text-end">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @report_stats[:by_status].each do |status, count| %>
                  <%# FIXED: Use safe navigation and provide default for status_badge_class %>
                  <%
                    badge_class = if status.present? && Invoice.statuses.key?(status)
                      Invoice.new(status: status).status_badge_class
                    else
                      'bg-secondary'
                    end
                  %>
                  <tr>
                    <td><span class="badge <%= badge_class %>"><%= status.present? ? status.humanize : 'Unknown' %></span></td>
                    <td class="text-end"><%= count %></td>
                    <td class="text-end">
                      <% if @report_invoices.present? %>
                        $<%= number_with_precision(@report_invoices.where(status: status).sum(:amount), precision: 2) %>
                      <% else %>
                        $0.00
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center py-4">No data for selected period</p>
          <% end %>
        </div>
      </div>
    </div>

    <%# Top Vendors - FIXED: Added nil checks %>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">
          <h5 class="mb-0">Top Vendors</h5>
        </div>
        <div class="card-body">
          <% if @report_stats && @report_stats[:by_vendor].present? && @report_stats[:by_vendor].any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Vendor</th>
                  <th class="text-end">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @report_stats[:by_vendor].first(5).each do |vendor, amount| %>
                  <tr>
                    <td><%= vendor.present? ? vendor : 'Unknown Vendor' %></td>
                    <td class="text-end">$<%= number_with_precision(amount, precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center py-4">No data for selected period</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Category Breakdown - FIXED: Added nil checks %>
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Expenses by Category</h5>
        </div>
        <div class="card-body">
          <% if @report_stats && @report_stats[:by_category].present? && @report_stats[:by_category].any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Category</th>
                  <th class="text-end">Amount</th>
                  <th class="text-end">Percentage</th>
                </tr>
              </thead>
              <tbody>
                <% total = @report_stats[:by_category].values.sum.to_f %>
                <% @report_stats[:by_category].sort_by { |_, amount| -amount }.each do |category, amount| %>
                  <tr>
                    <td><%= category.present? ? category.humanize : 'Uncategorized' %></td>
                    <td class="text-end">$<%= number_with_precision(amount, precision: 2) %></td>
                    <td class="text-end">
                      <% if total > 0 %>
                        <%= number_to_percentage((amount / total) * 100, precision: 1) %>
                      <% else %>
                        0.0%
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center py-4">No data for selected period</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Monthly Breakdown - FIXED: Added nil checks for monthly_counts %>
  <% if @report_stats && @report_stats[:monthly_totals].present? && @report_stats[:monthly_totals].any? %>
    <div class="row mt-4">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Monthly Breakdown</h5>
          </div>
          <div class="card-body">
            <table class="table">
              <thead>
                <tr>
                  <th>Month</th>
                  <th class="text-end">Invoices</th>
                  <th class="text-end">Total Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @report_stats[:monthly_totals].each do |month, amount| %>
                  <tr>
                    <td><%= month %></td>
                    <td class="text-end">
                      <%# FIXED: Added nil check for monthly_counts %>
                      <% monthly_count = @report_stats[:monthly_counts] ? @report_stats[:monthly_counts][month] : nil %>
                      <%= monthly_count || 0 %>
                    </td>
                    <td class="text-end">$<%= number_with_precision(amount, precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>