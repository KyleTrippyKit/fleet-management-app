<%# app/views/invoices/pdf.html.erb - COMPLETE REVISED VERSION %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice <%= @invoice.invoice_number %></title>
  <style>
    /* Reset for PDF generation */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #000;
      padding: 20px;
    }
    
    .invoice-header {
      border-bottom: 2px solid #000;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    
    .company-info {
      float: left;
      width: 50%;
    }
    
    .invoice-info {
      float: right;
      width: 45%;
      text-align: right;
    }
    
    .clearfix::after {
      content: "";
      display: table;
      clear: both;
    }
    
    h1 {
      font-size: 24px;
      margin-bottom: 10px;
      color: #333;
    }
    
    h2 {
      font-size: 18px;
      margin: 20px 0 10px 0;
      color: #555;
      border-bottom: 1px solid #ddd;
      padding-bottom: 5px;
    }
    
    h3 {
      font-size: 16px;
      margin: 15px 0 10px 0;
    }
    
    .section {
      margin-bottom: 25px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
    }
    
    th {
      background-color: #f5f5f5;
      font-weight: bold;
      text-align: left;
      padding: 8px;
      border: 1px solid #ddd;
    }
    
    td {
      padding: 8px;
      border: 1px solid #ddd;
    }
    
    .amount {
      text-align: right;
    }
    
    .total-row {
      font-weight: bold;
      background-color: #f9f9f9;
    }
    
    .status {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: bold;
    }
    
    .status-paid {
      background-color: #d4edda;
      color: #155724;
    }
    
    .status-pending {
      background-color: #fff3cd;
      color: #856404;
    }
    
    .status-overdue {
      background-color: #f8d7da;
      color: #721c24;
    }
    
    .customer-info {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 11px;
      color: #666;
    }
    
    .signature-area {
      margin-top: 60px;
    }
    
    .signature-line {
      border-top: 1px solid #000;
      width: 100%;
      margin: 10px 0 5px 0;
    }
    
    .page-break {
      page-break-before: always;
    }
    
    /* Grid layout for addresses */
    .address-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin: 20px 0;
    }
    
    .address-box {
      border: 1px solid #ddd;
      padding: 15px;
      border-radius: 5px;
    }
    
    .payment-details {
      background-color: #e9ecef;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    
    .payment-details h4 {
      margin-bottom: 10px;
    }
    
    .payment-details ul {
      list-style-type: none;
      margin-left: 0;
    }
    
    .payment-details li {
      margin-bottom: 5px;
    }
    
    /* Financial summary */
    .financial-summary {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    
    .summary-row {
      display: flex;
      justify-content: space-between;
      margin: 5px 0;
    }
    
    .summary-label {
      font-weight: bold;
    }
    
    .summary-value {
      font-weight: bold;
    }
    
    .total-due {
      font-size: 16px;
      color: #dc3545;
      border-top: 2px solid #000;
      padding-top: 10px;
      margin-top: 10px;
    }
    
    /* Signature styles */
    .signature-block {
      width: 45%;
    }
    
    .signature-header {
      margin-bottom: 15px;
    }
    
    .signature-header strong {
      display: block;
      margin-bottom: 5px;
    }
    
    .signature-details {
      margin-top: 15px;
    }
    
    .signature-details p {
      margin: 5px 0;
      font-size: 11px;
    }
  </style>
</head>
<body>
  <div class="invoice-header clearfix">
    <div class="company-info">
      <h1>INVOICE</h1>
      <p>
        <strong><%= @invoice.agency_name || 'Vehicle Management System' %></strong><br>
        <% if @invoice.vehicle&.service_owner.present? %>
          <%= @invoice.vehicle.service_owner %> - Administrative Office<br>
          Phone: (868) 623-XXXXXX<br>
          Email: <%= @invoice.vehicle.service_owner.downcase.gsub(/\s+/, '.') %>@gov.tt
        <% else %>
          Government Building, Port of Spain<br>
          Phone: (868) 623-XXXXXX<br>
          Email: finance@agency.gov.tt
        <% end %>
      </p>
    </div>
    
    <div class="invoice-info">
      <h2>Invoice #: <%= @invoice.invoice_number %></h2>
      <p><strong>Invoice Date:</strong> <%= @invoice.invoice_date.strftime('%B %d, %Y') %></p>
      <p><strong>Due Date:</strong> <%= @invoice.due_date.strftime('%B %d, %Y') %></p>
      <p>
        <strong>Status:</strong> 
        <span class="status status-<%= @invoice.status %>">
          <%= @invoice.status.humanize.upcase %>
        </span>
      </p>
      <% if @invoice.overdue? %>
        <p class="text-danger"><strong>OVERDUE:</strong> <%= @invoice.days_overdue %> days</p>
      <% end %>
    </div>
  </div>

  <div class="address-grid">
    <div class="address-box">
      <h3>Bill From:</h3>
      <p>
        <strong><%= @invoice.vendor || 'Vendor Name' %></strong><br>
        Vendor Address<br>
        Vendor City, Country<br>
        Phone: Vendor Phone<br>
        Email: vendor@example.com
      </p>
    </div>
    
    <div class="address-box">
      <h3>Bill To:</h3>
      <p>
        <strong><%= @invoice.agency_name || 'Agency Name' %></strong><br>
        <% if @invoice.vehicle&.service_owner.present? %>
          <%= @invoice.vehicle.service_owner %> Administrative Building<br>
          Port of Spain, Trinidad & Tobago<br>
          Phone: (868) 623-XXXXXX<br>
          Email: <%= @invoice.vehicle.service_owner.downcase.gsub(/\s+/, '.') %>@gov.tt
        <% else %>
          Government Building<br>
          Port of Spain, Trinidad & Tobago<br>
          Phone: (868) 623-XXXXXX<br>
          Email: finance@agency.gov.tt
        <% end %>
      </p>
    </div>
  </div>

  <div class="section">
    <h2>Vehicle Information</h2>
    <table>
      <tr>
        <th>Registration</th>
        <th>Make/Model</th>
        <th>Year</th>
        <th>VIN/Chassis</th>
        <th>Service Owner</th>
      </tr>
      <tr>
        <td><%= @invoice.vehicle&.license_plate || 'N/A' %></td>
        <td><%= @invoice.vehicle_display || 'N/A' %></td>
        <td><%= @invoice.vehicle&.year_of_manufacture || 'N/A' %></td>
        <td><%= @invoice.vehicle&.chassis_number || 'N/A' %></td>
        <td><%= @invoice.vehicle&.service_owner || 'N/A' %></td>
      </tr>
    </table>
  </div>

  <div class="section">
    <h2>Invoice Details</h2>
    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th>Quantity</th>
          <th>Unit Price (TTD)</th>
          <th>Total (TTD)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <strong>
              <% if @invoice.category.present? %>
                <%= @invoice.category.humanize %> - <%= @invoice.vendor %>
              <% elsif @invoice.maintenance %>
                <%= @invoice.maintenance.description %>
              <% else %>
                Vehicle Service/Repair - <%= @invoice.vendor %>
              <% end %>
            </strong>
            <% if @invoice.notes.present? %>
              <br><small><%= @invoice.notes %></small>
            <% end %>
          </td>
          <td>1</td>
          <td class="amount"><%= number_to_currency(@invoice.amount) %></td>
          <td class="amount"><%= number_to_currency(@invoice.amount) %></td>
        </tr>
        <tr class="total-row">
          <td colspan="3" class="text-right"><strong>Subtotal:</strong></td>
          <td class="amount"><%= number_to_currency(@invoice.amount) %></td>
        </tr>
        <tr class="total-row">
          <td colspan="3" class="text-right"><strong>VAT (12.5%):</strong></td>
          <td class="amount"><%= number_to_currency(@invoice.vat_amount) %></td>
        </tr>
        <tr class="total-row">
          <td colspan="3" class="text-right"><strong>TOTAL AMOUNT:</strong></td>
          <td class="amount"><strong><%= number_to_currency(@invoice.total_with_vat) %></strong></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="financial-summary">
    <div class="summary-row">
      <span class="summary-label">Invoice Total:</span>
      <span class="summary-value"><%= number_to_currency(@invoice.total_with_vat) %></span>
    </div>
    
    <% if @invoice.transactions.any? %>
      <div class="summary-row">
        <span class="summary-label">Total Paid:</span>
        <span class="summary-value"><%= number_to_currency(@invoice.transactions.sum(:amount)) %></span>
      </div>
      
      <div class="summary-row total-due">
        <span class="summary-label">Balance Due:</span>
        <span class="summary-value"><%= number_to_currency(@invoice.balance_due) %></span>
      </div>
    <% end %>
  </div>

  <% if @invoice.transactions.any? %>
  <div class="section">
    <h2>Payment History</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Payment Method</th>
          <th>Reference #</th>
          <th>Amount (TTD)</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% @invoice.transactions.order(transaction_date: :desc).each do |transaction| %>
          <tr>
            <td><%= transaction.transaction_date.strftime('%Y-%m-%d') %></td>
            <td><%= transaction.payment_method.humanize %></td>
            <td><%= transaction.reference_number %></td>
            <td class="amount"><%= number_to_currency(transaction.amount) %></td>
            <td><%= transaction.notes %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>

  <% if @invoice.notes.present? %>
  <div class="section">
    <h2>Additional Notes</h2>
    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; border-left: 4px solid #007bff;">
      <%= simple_format(@invoice.notes) %>
    </div>
  </div>
  <% end %>

  <div class="section">
    <div class="payment-details">
      <h4>Payment Instructions</h4>
      <ul>
        <li><strong>Bank Transfer:</strong> Republic Bank Ltd., Account #: 1234567890</li>
        <li><strong>Payable to:</strong> <%= @invoice.agency_name || 'Government of Trinidad & Tobago' %></li>
        <li><strong>Reference:</strong> <%= @invoice.invoice_number %></li>
        <li><strong>Due Date:</strong> <%= @invoice.due_date.strftime('%B %d, %Y') %></li>
      </ul>
    </div>
  </div>

  <!-- FIXED SIGNATURE AREA WITH PROPER SPACING -->
  <div class="signature-area">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 40px;">
      
      <!-- Vendor Signature Block -->
      <div class="signature-block">
        <div class="signature-header">
          <strong>VENDOR AUTHORIZATION</strong>
          <div style="font-size: 11px; color: #666;">
            <%= @invoice.vendor || 'Vendor Company' %> Representative
          </div>
        </div>
        
        <div class="signature-line"></div>
        
        <div class="signature-details">
          <p><strong>Date:</strong> _______________________</p>
          <p><strong>Name:</strong> _______________________</p>
          <p><strong>Title:</strong> _______________________</p>
          <p><strong>Signature:</strong> _______________________</p>
          <p style="margin-top: 10px;">
            <strong>Company Stamp:</strong>
            <span style="display: inline-block; width: 60px; height: 40px; border: 1px dashed #999; margin-left: 10px; vertical-align: middle;"></span>
          </p>
        </div>
      </div>
      
      <!-- Agency Signature Block -->
      <div class="signature-block" style="text-align: right;">
        <div class="signature-header">
          <strong>AGENCY AUTHORIZATION</strong>
          <div style="font-size: 11px; color: #666;">
            <%= @invoice.agency_name || 'Government Agency' %> Finance Department
          </div>
        </div>
        
        <div class="signature-line" style="margin-left: auto;"></div>
        
        <div class="signature-details" style="text-align: right;">
          <p><strong>Date:</strong> _______________________</p>
          <p><strong>Name:</strong> _______________________</p>
          <p><strong>Title:</strong> _______________________</p>
          <p><strong>Signature:</strong> _______________________</p>
          <p style="margin-top: 10px;">
            <strong>Approval Code:</strong> __________
            <span style="display: inline-block; margin-left: 10px;">
              <strong>Stamp:</strong>
              <span style="display: inline-block; width: 40px; height: 40px; border: 1px solid #999; margin-left: 5px; vertical-align: middle;"></span>
            </span>
          </p>
        </div>
      </div>
      
    </div>
    
    <!-- Terms and Conditions -->
    <div style="margin-top: 30px; padding: 15px; background-color: #f9f9f9; border-radius: 5px; font-size: 10px; border: 1px solid #eee;">
      <p style="margin: 0 0 10px 0; font-weight: bold; text-decoration: underline;">TERMS & CONDITIONS:</p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div>
          <p style="margin: 3px 0;"><strong>• Payment Terms:</strong> Net 30 days from invoice date</p>
          <p style="margin: 3px 0;"><strong>• Late Payment:</strong> 2% monthly charge on overdue balances</p>
          <p style="margin: 3px 0;"><strong>• Payment Method:</strong> Bank transfer only</p>
        </div>
        <div>
          <p style="margin: 3px 0;"><strong>• Dispute Period:</strong> 7 days from receipt</p>
          <p style="margin: 3px 0;"><strong>• Tax:</strong> VAT included at 12.5%</p>
          <p style="margin: 3px 0;"><strong>• Currency:</strong> Trinidad & Tobago Dollars (TTD)</p>
        </div>
      </div>
    </div>
  </div>

  <div class="footer clearfix">
    <div style="float: left; width: 50%;">
      <p><strong>Thank you for your business!</strong></p>
      <p>For inquiries, contact: finance@agency.gov.tt</p>
      <p style="margin-top: 10px; font-size: 10px;">
        <strong>Office Hours:</strong> Monday-Friday, 8:00 AM - 4:00 PM<br>
        <strong>Phone:</strong> (868) 623-XXXXXX<br>
        <strong>Website:</strong> www.agency.gov.tt
      </p>
    </div>
    
    <div style="float: right; width: 45%; text-align: right;">
      <p>Generated on: <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %></p>
      <p>Invoice #<%= @invoice.invoice_number %> | Page 1 of 1</p>
      <% if @invoice.quickbooks_id %>
        <p>QuickBooks ID: <%= @invoice.quickbooks_id %></p>
      <% end %>
      <p style="margin-top: 10px; font-size: 10px; color: #999;">
        This is a computer-generated document.<br>
        No signature required for electronic processing.
      </p>
    </div>
  </div>
</body>
</html>