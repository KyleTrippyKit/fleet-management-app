<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="display-6 fw-bold text-success">
        <i class="bi bi-shield-fill text-success me-2"></i>
        TTDF Fleet Management Dashboard
      </h1>
      <p class="text-muted mb-0">
        Trinidad and Tobago Defence Force - Military Vehicle Management
      </p>
    </div>
    <div class="badge badge-ttdf fs-5 p-3">
      <i class="bi bi-building me-2"></i>
      <%= current_user.agency.name %>
    </div>
  </div>
  
  <div class="alert alert-success">
    <h4><i class="bi bi-check-circle me-2"></i>Success!</h4>
    <p>You have been correctly redirected to the TTDF dashboard.</p>
    <p class="mb-0">User: <strong><%= current_user.email %></strong></p>
    <p class="mb-0">Agency: <strong><%= current_user.agency.name %> (<%= current_user.agency.code %>)</strong></p>
  </div>
</div>
