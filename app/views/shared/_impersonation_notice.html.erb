<%# app/views/shared/_impersonation_notice.html.erb %>
<% if session[:admin_id].present? %>
  <div class="alert alert-warning alert-dismissible fade show mb-0 rounded-0" role="alert">
    <div class="container">
      <i class="bi bi-incognito me-2"></i>
      You are impersonating <strong><%= current_user.email %></strong>. 
      <%= link_to "Stop Impersonating", stop_impersonating_admin_users_path, method: :post, class: "alert-link" %>
    </div>
  </div>
<% end %>