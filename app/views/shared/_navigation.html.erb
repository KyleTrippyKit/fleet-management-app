<%# app/views/shared/_navigation.html.erb - COMPLETE VMCOTT WORKFLOW NAVIGATION %>
<%# UPDATED: Renamed roles - security_gate_officer (was receptionist), inventory_manager (was parts_coordinator), procurement (was billing) %>
<%# KEPT: inspector, mechanic as is %>
<%# finance kept as finance (finance_accounting for display) %>

<% return unless current_user.present? %>

<% agency      = current_user&.agency %>
<% agency_code = agency&.code.to_s.upcase %>
<% user_role   = current_user.role.to_s %>

<% is_admin = !!current_user&.admin? %>

<%# ============================================================
    NOTIFICATION COUNTS
   ============================================================ %>
<%
  @unread_notifications_count ||= 0
  @pending_inspections_count ||= 0
  @pending_parts_count ||= 0
  @pending_quotations_count ||= 0
  @available_jobs_count ||= 0
  @pending_qc_count ||= 0
  @ready_for_pickup_count ||= 0
  @parts_needing_review_count ||= 0
  @parts_to_order_count ||= 0
  @pending_purchase_requests_count ||= 0
  @low_stock_alert_count ||= 0
  @inspections_today_count ||= 0
  @pending_qc_inspections_count ||= 0
  @assigned_jobs_count ||= 0
  @in_progress_count ||= 0
  @pending_parts_requests_count ||= 0
  @quotations_to_review_count ||= 0
  @pending_po_approval_count ||= 0
  @at_vmcott_count ||= 0
  @in_progress_count_ptsc ||= 0
  @ready_for_pickup_count_ptsc ||= 0
  @pending_rfq_responses_count ||= 0
  @pending_condition_reports_count ||= 0
%>

<%# ============================================================
    VMCOTT ROLE DEFINITIONS - RENAMED
   ============================================================ %>
<% is_vmcott_admin = is_admin && agency_code == "VMCOTT" %>
<% is_vmcott_staff = user_role == 'vmcott_staff' %>
<% is_vmcott_finance = user_role == 'finance' && agency_code == "VMCOTT" %>
<% is_vmcott_workshop_manager = user_role == 'workshop_manager' && agency_code == "VMCOTT" %>
<% is_vmcott_inventory_clerk = user_role == 'inventory_clerk' && agency_code == "VMCOTT" %>

<%# Explicit VMCOTT workflow roles - RENAMED %>
<% is_vmcott_security_gate_officer = user_role == 'security_gate_officer' && agency_code == "VMCOTT" %>
<% is_vmcott_inspector = user_role == 'inspector' && agency_code == "VMCOTT" %>
<% is_vmcott_inventory_manager = user_role == 'inventory_manager' && agency_code == "VMCOTT" %>
<% is_vmcott_mechanic = user_role == 'mechanic' && agency_code == "VMCOTT" %>
<% is_vmcott_procurement = user_role == 'procurement' && agency_code == "VMCOTT" %>
<% is_vmcott_finance = user_role == 'finance' && agency_code == "VMCOTT" %>

<%# Keep old names for backward compatibility in views %>
<% is_vmcott_receptionist = is_vmcott_security_gate_officer %>
<% is_vmcott_parts_coordinator = is_vmcott_inventory_manager %>
<% is_vmcott_billing = is_vmcott_procurement %>

<%# PTSC Role Definitions %>
<% is_ptsc_admin = is_admin && agency_code == "PTSC" %>
<% is_ptsc_fleet_manager = user_role == 'fleet_manager' && agency_code == "PTSC" %>
<% is_ptsc_finance = user_role == 'finance' && agency_code == "PTSC" %>
<% is_ptsc_driver = user_role == 'driver' && agency_code == "PTSC" %>
<% is_ptsc_maintenance = user_role == 'maintenance' && agency_code == "PTSC" %>

<%# Regular users see only their specific role %>
<% is_fleet_manager = user_role == 'fleet_manager' %>
<% is_maintenance_supervisor = user_role == 'maintenance_supervisor' || user_role == 'maintenance' %>
<% is_financial_officer = user_role == 'finance' %>
<% is_driver = user_role == 'driver' %>
<% is_supervisor = user_role == 'supervisor' %>

<%# Admins see all roles for their agency type %>
<% if is_admin %>
  <% case agency_code %>
  <% when 'VMCOTT' %>
    <% is_vmcott_admin = true %>
    <% is_vmcott_security_gate_officer = true %>
    <% is_vmcott_inspector = true %>
    <% is_vmcott_inventory_manager = true %>
    <% is_vmcott_mechanic = true %>
    <% is_vmcott_procurement = true %>
    <% is_vmcott_finance = true %>
    <% is_vmcott_workshop_manager = true %>
    <% is_vmcott_inventory_clerk = true %>
  <% when 'PTSC' %>
    <% is_ptsc_admin = true %>
    <% is_ptsc_fleet_manager = true %>
    <% is_ptsc_finance = true %>
    <% is_ptsc_driver = true %>
    <% is_ptsc_maintenance = true %>
  <% else %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% end %>
<% end %>

<%# Supervisors also get maintenance supervisor access %>
<% if is_supervisor %>
  <% is_maintenance_supervisor = true %>
<% end %>

<%# Only VMCOTT can write maintenance %>
<% can_write_maintenance = agency_code == "VMCOTT" %>

<%# ============================================================
    HELPER: Calculate total alerts for a role
   ============================================================ %>
<% 
  security_gate_alerts = @pending_condition_reports_count.to_i + @pending_inspections_count.to_i
  inspector_alerts = @pending_inspections_count.to_i + @pending_qc_inspections_count.to_i
  inventory_alerts = @pending_parts_count.to_i + @low_stock_alert_count.to_i
  procurement_alerts = @pending_parts_requests_count.to_i
  finance_alerts = @quotations_to_review_count.to_i + @pending_po_approval_count.to_i + @ready_for_pickup_count.to_i
  mechanic_alerts = @available_jobs_count.to_i + @pending_qc_count.to_i
%>

<!-- Navigation with highest stacking context -->
<div class="mb-4" style="position: relative; z-index: 9999;">
  <div class="card border-0 shadow-sm nav-card" style="border-radius: 16px; overflow: visible;">
    <div class="card-body p-3" style="overflow: visible;">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2" style="overflow: visible;">

        <!-- LEFT SIDE - MAIN WORKFLOW BUTTONS -->
        <div class="d-flex flex-wrap gap-2 align-items-center">

          <!-- ================= VMCOTT WORKFLOW ================= -->
          <% if agency_code == "VMCOTT" %>

            <!-- STEP 1: SECURITY GATE OFFICER (was Reception) -->
            <% if is_vmcott_security_gate_officer || is_vmcott_admin %>
              <%= link_to vmcott_security_gate_officer_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_security_gate_officer_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-door-open me-1"></i> Gate
                <% if security_gate_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= security_gate_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 2: INSPECTOR (KEPT AS IS) -->
            <% if is_vmcott_inspector || is_vmcott_admin %>
              <%= link_to vmcott_inspector_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_inspector_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-search me-1"></i> Inspector
                <% if inspector_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= inspector_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 3: INVENTORY MANAGER (was Parts Coordinator) -->
            <% if is_vmcott_inventory_manager || is_vmcott_admin %>
              <%= link_to vmcott_inventory_manager_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_inventory_manager_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-box-seam me-1"></i> Inventory
                <% if inventory_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= inventory_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 4: PROCUREMENT (was Billing) -->
            <% if is_vmcott_procurement || is_vmcott_admin %>
              <%= link_to vmcott_procurement_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_procurement_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-envelope-paper me-1"></i> Procurement
                <% if procurement_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= procurement_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 5: FINANCE (kept as Finance) -->
            <% if is_vmcott_finance || is_vmcott_admin %>
              <%= link_to vmcott_finance_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_finance_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-cash-stack me-1"></i> Finance
                <% if finance_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= finance_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 5.5: RFQ INBOX - For Finance -->
            <% if is_vmcott_finance || is_vmcott_admin %>
              <%= link_to vmcott_vendor_rfqs_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_vendor_rfqs_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-envelope me-1"></i> RFQ Inbox
                <% if @pending_rfq_responses_count.to_i > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @pending_rfq_responses_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 6: MECHANIC (KEPT AS IS) -->
            <% if is_vmcott_mechanic || is_vmcott_admin %>
              <%= link_to vmcott_mechanic_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_mechanic_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-tools me-1"></i> Mechanic
                <% if mechanic_alerts > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= mechanic_alerts %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- READY FOR PICKUP - For Finance/Admin -->
            <% if is_vmcott_finance || is_vmcott_admin %>
              <%= link_to vmcott_finance_invoices_path(status: 'pending'), 
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative btn-outline-primary" do %>
                <i class="bi bi-truck me-1"></i> Pickup
                <% if @ready_for_pickup_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                    <%= @ready_for_pickup_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

          <!-- ================= PTSC WORKFLOW ================= -->
          <% elsif agency_code == "PTSC" %>

            <!-- PTSC FLEET MANAGER DASHBOARD -->
            <% if is_ptsc_fleet_manager || is_ptsc_admin %>
              <%= link_to ptsc_fleet_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(ptsc_fleet_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-truck me-1"></i> Fleet
              <% end %>
            <% end %>

            <!-- PTSC ADMIN - VEHICLE STATUS TRACKING -->
            <% if is_ptsc_admin %>
              <%= link_to ptsc_admin_vehicle_status_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(ptsc_admin_vehicle_status_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-eye me-1"></i> Live Status
                <% if @at_vmcott_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info">
                    <%= @at_vmcott_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- PTSC FINANCE - PROCUREMENT DROPDOWN -->
            <% if is_ptsc_finance || is_ptsc_admin %>
              <div class="dropdown nav-dd" style="position: relative;">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-bs-boundary="viewport"
                        data-bs-display="static">
                  <i class="bi bi-cart me-1"></i> Procurement
                  <% if @pending_rfq_responses_count.to_i > 0 %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                      <%= @pending_rfq_responses_count %>
                    </span>
                  <% end %>
                </button>

                <ul class="dropdown-menu dropdown-menu-float dropdown-scroll" style="position: absolute; z-index: 1000000; background: white !important;">
                  <li class="dropdown-section" style="color: #0d47a1 !important;">📋 RFQs</li>
                  
                  <% if agency.present? %>
                    <li>
                      <%= link_to new_agency_rfq_path(agency), class: "dropdown-item" do %>
                        <i class="bi bi-file-earmark-plus me-2"></i> New RFQ (to VMCOTT)
                      <% end %>
                    </li>
                  <% end %>

                  <li>
                    <%= link_to sent_rfqs_path, class: "dropdown-item" do %>
                      <i class="bi bi-send me-2"></i> Sent RFQs
                    <% end %>
                  </li>

                  <li>
                    <%= link_to received_quotations_path, class: "dropdown-item" do %>
                      <i class="bi bi-inbox me-2"></i> Quotations Inbox
                      <% if @pending_rfq_responses_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @pending_rfq_responses_count %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section" style="color: #0d47a1 !important;">📊 REVIEW</li>

                  <% if defined?(ptsc_quotation_review_path) %>
                    <li>
                      <%= link_to ptsc_quotation_review_path, class: "dropdown-item" do %>
                        <i class="bi bi-ui-checks me-2"></i> Quotation Review
                      <% end %>
                    </li>
                  <% end %>

                  <% if defined?(ptsc_po_acceptance_path) %>
                    <li>
                      <%= link_to ptsc_po_acceptance_path, class: "dropdown-item" do %>
                        <i class="bi bi-clipboard-check me-2"></i> PO Acceptance Queue
                      <% end %>
                    </li>
                  <% end %>

                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section" style="color: #0d47a1 !important;">📦 ORDERS</li>
                  <li>
                    <%= link_to purchase_orders_path, class: "dropdown-item" do %>
                      <i class="bi bi-bag-check me-2"></i> All Purchase Orders
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>

            <!-- PTSC FINANCE DASHBOARD -->
            <% if is_ptsc_finance || is_ptsc_admin %>
              <%= link_to ptsc_finance_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(ptsc_finance_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-cash-stack me-1"></i> Finance
              <% end %>
            <% end %>

            <!-- PTSC MAINTENANCE -->
            <% if is_ptsc_maintenance || is_ptsc_admin %>
              <%= link_to ptsc_maintenance_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(ptsc_maintenance_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-wrench me-1"></i> Maintenance
              <% end %>
            <% end %>

            <!-- PTSC DRIVER -->
            <% if is_ptsc_driver || is_ptsc_admin %>
              <%= link_to ptsc_driver_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(ptsc_driver_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-person-badge me-1"></i> Driver
              <% end %>
            <% end %>

          <!-- ================= OTHER AGENCIES ================= -->
          <% else %>
            <% if is_fleet_manager %>
              <%= link_to agency_vehicles_path(agency), class: "btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill" do %>
                <i class="bi bi-truck me-1"></i> Fleet
              <% end %>
            <% end %>

            <% if is_maintenance_supervisor %>
              <%= link_to maintenances_path, class: "btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill" do %>
                <i class="bi bi-wrench me-1"></i> Maintenance
              <% end %>
            <% end %>

            <% if is_financial_officer %>
              <%= link_to invoices_path, class: "btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill" do %>
                <i class="bi bi-receipt me-1"></i> Invoices
              <% end %>
            <% end %>
          <% end %>

        </div>

        <!-- RIGHT SIDE - NOTIFICATIONS, AGENCY, USER MENU -->
        <div class="d-flex gap-2 align-items-center" style="position: relative;">

          <!-- AGENCY BADGE -->
          <% if agency_code.present? %>
            <span class="badge nav-agency-pill">
              <i class="bi bi-building me-1"></i> <%= agency_code %>
              <% if agency_code == "PTSC" && @at_vmcott_count.to_i > 0 %>
                <span class="badge bg-warning ms-1"><%= @at_vmcott_count %> at VMCOTT</span>
              <% end %>
            </span>
          <% end %>

          <!-- NOTIFICATION CENTER -->
          <div class="dropdown nav-dd" style="position: relative;">
            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 position-relative"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
              <i class="bi bi-bell"></i>
              <% if @unread_notifications_count > 0 %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= @unread_notifications_count %>
                </span>
              <% end %>
            </button>

            <ul class="dropdown-menu" style="position: absolute; z-index: 1000000; background: white !important; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); min-width: 300px; right: 0; left: auto;">
              <li class="dropdown-section" style="color: #0d47a1 !important;">🔔 NOTIFICATIONS</li>
              <% if @recent_notifications && @recent_notifications.any? %>
                <% @recent_notifications.first(5).each do |notification| %>
                  <li>
                    <%= link_to notification_path(notification), class: "dropdown-item #{'fw-bold' unless notification.read?}", style: "color: #1e293b !important;" do %>
                      <div class="d-flex align-items-center">
                        <div class="me-2"><%= notification.title %></div>
                        <small class="text-muted ms-auto"><%= time_ago_in_words(notification.created_at) %> ago</small>
                      </div>
                    <% end %>
                  </li>
                <% end %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to notifications_path, class: "dropdown-item text-center", style: "color: #1e293b !important;" do %>
                    View All
                  <% end %>
                </li>
              <% else %>
                <li><span class="dropdown-item text-muted">No notifications</span></li>
              <% end %>
            </ul>
          </div>

          <!-- USER MENU - HIGHEST Z-INDEX -->
          <div class="dropdown nav-dd" style="position: relative;">
            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i> <%= current_user.name&.split&.first || 'User' %>
            </button>

            <ul class="dropdown-menu dropdown-menu-end" style="position: absolute; z-index: 10000000; background: white !important; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.25); min-width: 280px; max-height: 90vh; overflow-y: auto; right: 0; left: auto; top: 100%; margin-top: 8px;">
              
              <!-- QUICK LINKS SECTION -->
              <li class="dropdown-section" style="color: #0d47a1 !important; font-weight: bold;">⚡ QUICK LINKS</li>
              
              <% if agency_code == "VMCOTT" %>
                <!-- VMCOTT Quick Links -->
                <% if is_vmcott_admin %>
                  <li><%= link_to "Parts Catalog", "/vmcott/parts", class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Suppliers", suppliers_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Inventory Dashboard", vmcott_inventory_dashboard_no_nav_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Condition Reports", vmcott_vehicle_condition_reports_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_inventory_manager %>
                  <li><%= link_to "Parts Catalog", "/vmcott/parts", class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Inventory Dashboard", vmcott_inventory_dashboard_no_nav_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Suppliers", suppliers_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Low Stock", low_stock_vmcott_inventory_manager_parts_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_procurement %>
                  <li><%= link_to "Suppliers", suppliers_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_finance %>
                  <li><%= link_to "RFQ Inbox", vmcott_vendor_rfqs_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Invoices", vmcott_finance_invoices_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Quotations", vmcott_finance_quotations_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Aging Report", vmcott_finance_aging_report_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_security_gate_officer %>
                  <li><%= link_to "Today's Check-ins", today_vmcott_security_gate_officer_reception_logs_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Condition Reports", vmcott_vehicle_condition_reports_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Manual Entry", vmcott_security_gate_officer_manual_entry_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_inspector %>
                  <li><%= link_to "Pending QC", vmcott_inspector_dashboard_path(anchor: 'qc-pending'), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Inspections Today", vmcott_inspector_inspections_today_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Recent Activity", vmcott_inspector_recent_activity_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_vmcott_mechanic %>
                  <li><%= link_to "Dashboard", vmcott_mechanic_dashboard_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Verification Queue", verification_vmcott_mechanic_jobs_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Request Part", new_vmcott_mechanic_parts_request_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>

              <% elsif agency_code == "PTSC" %>
                <!-- PTSC Quick Links -->
                <% if is_ptsc_admin %>
                  <li><%= link_to "Live Vehicle Status", ptsc_admin_vehicle_status_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Fleet Dashboard", ptsc_fleet_dashboard_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Maintenance Schedule", ptsc_maintenance_dashboard_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "All Vehicles", vehicles_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <% if agency.present? %>
                    <li><%= link_to "New RFQ", new_agency_rfq_path(agency), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <% end %>
                <% elsif is_ptsc_fleet_manager %>
                  <li><%= link_to "Fleet Analytics", agency_analytics_path(agency), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Vehicle Status", vehicles_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_ptsc_finance %>
                  <li><%= link_to "RFQ Inbox", sent_rfqs_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Quotations Received", received_quotations_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Purchase Orders", purchase_orders_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Invoices", invoices_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Payables", payables_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% elsif is_ptsc_maintenance %>
                  <li><%= link_to "Gantt View", gantt_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Work Orders", maintenances_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>
              <% else %>
                <!-- Non-VMCOTT/PTSC Quick Links -->
                <% if is_fleet_manager %>
                  <li><%= link_to "Fleet Analytics", agency_analytics_path(agency), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>
                <% if is_maintenance_supervisor %>
                  <li><%= link_to "Gantt View", gantt_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>
                <% if is_financial_officer %>
                  <li><%= link_to "Payables", payables_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>
              <% end %>

              <!-- ADMIN SECTION - For all admins -->
              <% if is_admin %>
                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section" style="color: #0d47a1 !important; font-weight: bold;">🔐 ADMIN</li>
                
                <li><%= link_to "Manage Users", admin_users_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                
                <% if agency_code == "VMCOTT" %>
                  <li><%= link_to "Create VMCOTT User", new_admin_user_path(agency_id: agency.id), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <% if defined?(admin_roles_path) %>
                    <li><%= link_to "Role Management", admin_roles_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <% end %>
                  <% if defined?(admin_settings_path) %>
                    <li><%= link_to "System Settings", admin_settings_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <% end %>
                <% elsif agency_code == "PTSC" %>
                  <li><%= link_to "Create PTSC User", new_admin_user_path(agency_id: agency.id), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                  <li><%= link_to "Vehicle Status Report", ptsc_admin_vehicle_status_path, class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% else %>
                  <li><%= link_to "Create New User", new_admin_user_path(agency_id: agency.id), class: "dropdown-item", style: "color: #1e293b !important;" %></li>
                <% end %>
              <% end %>

              <!-- ACCOUNT SECTION -->
              <li><hr class="dropdown-divider"></li>
              <li class="dropdown-section" style="color: #0d47a1 !important; font-weight: bold;">👤 ACCOUNT</li>
              <li><%= link_to "Profile", "#", class: "dropdown-item", onclick: "return false;", style: "color: #1e293b !important;" %></li>
              <li><%= link_to "Settings", "#", class: "dropdown-item", onclick: "return false;", style: "color: #1e293b !important;" %></li>
              
              <!-- LOGOUT -->
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to destroy_user_session_path,
                    method: :delete,
                    class: "dropdown-item text-danger",
                    style: "color: #dc2626 !important;",
                    form: { "data-turbo" => "false", style: "width: 100%;" } do %>
                  <i class="bi bi-box-arrow-right me-2"></i> Logout
                <% end %>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>

