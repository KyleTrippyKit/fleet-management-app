<%# app/views/shared/_navigation.html.erb - COMPLETE ROLE-BASED DASHBOARD NAVIGATION WITH NOTIFICATIONS %>
<%# Updated to match VMCOTT workflow - COMPATIBLE WITH EXISTING ROUTES %>

<% return unless current_user.present? %>

<% agency      = current_user&.agency %>
<% agency_code = agency&.code.to_s.upcase %>
<% user_role   = current_user.role.to_s %>

<% is_admin   = !!current_user&.admin? %>

<%# ============================================================
    NOTIFICATION COUNTS - FETCH FOR EACH ROLE
   ============================================================ %>
<%
  # These would be helper methods or instance variables set in ApplicationController
  @unread_notifications_count ||= 0
  @pending_inspections_count ||= 0
  @pending_parts_count ||= 0
  @pending_quotations_count ||= 0
  @available_jobs_count ||= 0
  @pending_qc_count ||= 0
  @ready_for_pickup_count ||= 0
  @parts_needing_review_count ||= 0
  @parts_to_order_count ||= 0
%>

<%# ============================================================
    VMCOTT ROLE DEFINITIONS
   ============================================================ %>
<% is_vmcott_admin           = is_admin && agency_code == "VMCOTT" %>
<% is_vmcott_staff           = user_role == 'vmcott_staff' %>
<% is_vmcott_finance         = user_role == 'finance' && agency_code == "VMCOTT" %>
<% is_vmcott_workshop_manager = user_role == 'workshop_manager' && agency_code == "VMCOTT" %>
<% is_vmcott_inventory_clerk  = user_role == 'inventory_clerk' && agency_code == "VMCOTT" %>

<%# Explicit VMCOTT workflow roles %>
<% is_vmcott_receptionist     = user_role == 'receptionist' && agency_code == "VMCOTT" %>
<% is_vmcott_inspector        = user_role == 'inspector' && agency_code == "VMCOTT" %>
<% is_vmcott_parts_coordinator = user_role == 'parts_coordinator' && agency_code == "VMCOTT" %>
<% is_vmcott_mechanic         = user_role == 'mechanic' && agency_code == "VMCOTT" %>
<% is_vmcott_billing          = user_role == 'finance' && agency_code == "VMCOTT" %>

<%# New separate billing/finance distinction %>
<% is_vmcott_billing_team     = user_role == 'billing' && agency_code == "VMCOTT" %>

<%# Regular users see only their specific role %>
<% is_fleet_manager          = user_role == 'fleet_manager' %>
<% is_maintenance_supervisor = user_role == 'maintenance_supervisor' || user_role == 'maintenance' %>
<% is_financial_officer      = user_role == 'finance' %>
<% is_driver                 = user_role == 'driver' %>
<% is_supervisor             = user_role == 'supervisor' %>

<%# Admins see all roles for their agency type %>
<% if is_admin %>
  <% case agency_code %>
  <% when 'PTSC', 'TTPS', 'TTDF' %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% when 'VMCOTT' %>
    <%# VMCOTT Admin gets EVERYTHING %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
    <% is_vmcott_staff = true %>
    <% is_vmcott_workshop_manager = true %>
    <% is_vmcott_inventory_clerk = true %>
    <% is_vmcott_receptionist = true %>
    <% is_vmcott_inspector = true %>
    <% is_vmcott_parts_coordinator = true %>
    <% is_vmcott_mechanic = true %>
    <% is_vmcott_billing = true %>
    <% is_vmcott_billing_team = true %>
  <% else %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% end %>
<% end %>

<%# Supervisors also get maintenance supervisor access %>
<% if is_supervisor %>
  <% is_maintenance_supervisor = true %>
<% end %>

<%# Only VMCOTT can write maintenance - PTSC users cannot add maintenance even if admin %>
<% can_write_maintenance = agency_code == "VMCOTT" %>

<%# ============================================================
    ROLE-BASED DASHBOARD PATH - USING EXISTING ROUTES
   ============================================================ %>
<%
  # Determine the correct dashboard path for each user type
  dashboard_path = if agency_code == "PTSC"
    case current_user.role
    when 'fleet_manager'
      ptsc_fleet_dashboard_path
    when 'finance'
      ptsc_finance_dashboard_path
    when 'driver'
      ptsc_driver_dashboard_path
    when 'maintenance_supervisor', 'maintenance'
      ptsc_maintenance_dashboard_path
    when 'admin'
      ptsc_dashboard_path
    else
      ptsc_dashboard_path
    end
  elsif agency_code == "VMCOTT"
    # VMCOTT users get role-specific dashboards
    case current_user.role
    when 'receptionist'
      vmcott_receptionist_dashboard_path
    when 'inspector'
      vmcott_inspector_dashboard_path
    when 'parts_coordinator'
      vmcott_parts_coordinator_dashboard_path
    when 'mechanic'
      vmcott_mechanic_dashboard_path
    when 'workshop_manager'
      vmcott_workshop_supervisor_dashboard_path
    when 'finance'
      vmcott_billing_dashboard_path
    when 'billing'
      # For new billing role, fallback to finance dashboard for now
      vmcott_billing_dashboard_path
    when 'admin'
      vmcott_dashboard_path
    else
      vmcott_dashboard_path
    end
  else
    # Other agencies (TTPS, TTDF, HEALTH, etc.)
    case current_user.role
    when 'fleet_manager'
      agency.present? ? agency_vehicles_path(agency) : main_dashboard_path
    when 'finance'
      main_dashboard_path
    when 'driver'
      driver_dashboard_path
    when 'maintenance_supervisor', 'maintenance'
      maintenance_dashboard_path
    when 'admin'
      main_dashboard_path
    else
      # Legacy agency-based dashboards as fallback
      case agency_code
      when "TTPS"   then ttps_dashboard_path
      when "TTDF"   then ttdf_dashboard_path
      else
        main_dashboard_path
      end
    end
  end
%>

<div class="mb-4">
  <div class="card border-0 shadow-sm nav-card">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">

        <!-- LEFT -->
        <div class="d-flex flex-wrap gap-2 align-items-center">

          <!-- Dashboard - Role-based -->
          <%= link_to dashboard_path,
            class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill #{current_page?(dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          <% end %>

          <!-- ================= VMCOTT WORKFLOW NAVIGATION - USING EXISTING ROUTES ================= -->
          <% if agency_code == "VMCOTT" %>

            <!-- STEP 1: RECEPTIONIST -->
            <% if is_vmcott_receptionist || is_admin %>
              <%= link_to vmcott_receptionist_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_receptionist_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-door-open me-1"></i> Reception
              <% end %>
            <% end %>

            <!-- STEP 2: INSPECTOR -->
            <% if is_vmcott_inspector || is_admin %>
              <%= link_to vmcott_inspector_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_inspector_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-search me-1"></i> Inspector
                <% if @pending_inspections_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @pending_inspections_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 3: PARTS COORDINATOR -->
            <% if is_vmcott_parts_coordinator || is_admin %>
              <%= link_to vmcott_parts_coordinator_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_parts_coordinator_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-box-seam me-1"></i> Parts Coordinator
                <% if @pending_parts_count > 0 || @parts_needing_review_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @pending_parts_count + @parts_needing_review_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 4: BILLING TEAM (RFQs) - Using existing finance routes -->
            <% if is_vmcott_billing || is_vmcott_billing_team || is_admin %>
              <%= link_to vmcott_billing_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_billing_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-envelope-paper me-1"></i> Billing
                <% if @pending_quotations_count > 0 || @parts_to_order_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning" style="color: #000;">
                    <%= @pending_quotations_count + @parts_to_order_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 5: FINANCE TEAM (Quotations) -->
            <% if is_vmcott_finance || is_admin %>
              <%= link_to vmcott_billing_dashboard_path, 
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_billing_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-cash-stack me-1"></i> Finance
                <% if @pending_quotations_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @pending_quotations_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 6: MECHANIC -->
            <% if is_vmcott_mechanic || is_admin %>
              <%= link_to vmcott_mechanic_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_mechanic_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-tools me-1"></i> Mechanic
                <% if @available_jobs_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                    <%= @available_jobs_count %>
                  </span>
                <% end %>
                <% if @pending_qc_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning" style="color: #000;">
                    QC:<%= @pending_qc_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- READY FOR PICKUP -->
            <% if is_vmcott_billing || is_vmcott_finance || is_admin %>
              <%= link_to vmcott_billing_invoices_path(status: 'pending'), 
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative btn-outline-primary" do %>
                <i class="bi bi-truck me-1"></i> Ready for Pickup
                <% if @ready_for_pickup_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                    <%= @ready_for_pickup_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

          <% end %>

          <!-- ================= NOTIFICATION CENTER - FOR ALL VMCOTT ROLES ================= -->
          <% if agency_code == "VMCOTT" && (is_vmcott_receptionist || is_vmcott_inspector || is_vmcott_parts_coordinator || is_vmcott_mechanic || is_vmcott_billing || is_admin) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-bell me-1"></i> Notifications
                <% if @unread_notifications_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @unread_notifications_count %>
                    <span class="visually-hidden">unread notifications</span>
                  </span>
                <% end %>
              </button>

              <ul class="dropdown-menu dropdown-menu-float dropdown-scroll" style="min-width: 300px;">
                <li class="dropdown-section">🔔 RECENT NOTIFICATIONS</li>
                
                <%# This would be populated from a @recent_notifications variable %>
                <% if @recent_notifications && @recent_notifications.any? %>
                  <% @recent_notifications.each do |notification| %>
                    <li>
                      <%= link_to notification_path(notification), class: "dropdown-item #{'fw-bold' unless notification.read?}" do %>
                        <div class="d-flex align-items-center">
                          <div class="me-2">
                            <% case notification.notifiable_type %>
                            <% when 'Inspection' %>
                              <i class="bi bi-search text-info"></i>
                            <% when 'PartsRequest' %>
                              <i class="bi bi-box-seam text-warning"></i>
                            <% when 'PurchaseOrder' %>
                              <i class="bi bi-file-text text-success"></i>
                            <% else %>
                              <i class="bi bi-bell text-primary"></i>
                            <% end %>
                          </div>
                          <div class="flex-grow-1">
                            <div><%= notification.title %></div>
                            <small class="text-muted"><%= time_ago_in_words(notification.created_at) %> ago</small>
                          </div>
                          <% unless notification.read? %>
                            <span class="badge bg-danger rounded-pill ms-2">New</span>
                          <% end %>
                        </div>
                      <% end %>
                    </li>
                  <% end %>
                <% else %>
                  <li><span class="dropdown-item text-muted">No notifications</span></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- ================= WORKFLOW DROPDOWN (COMPLETE VIEW) - USING EXISTING ROUTES ================= -->
          <% if agency_code == "VMCOTT" && (is_admin || is_vmcott_workshop_manager || is_vmcott_staff) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-diagram-3 me-1"></i> Full Workflow
              </button>

              <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                
                <%# RECEPTION %>
                <% if is_admin || is_vmcott_staff || is_vmcott_receptionist %>
                  <li class="dropdown-section">🚪 1. RECEPTION</li>
                  <li>
                    <%= link_to vmcott_receptionist_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-badge me-2"></i> Vehicle Reception
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_receptionist_scan_path, class: "dropdown-item" do %>
                      <i class="bi bi-qr-code-scan me-2"></i> Scan QR Code
                    <% end %>
                  </li>
                <% end %>

                <%# INSPECTION %>
                <% if is_admin || is_vmcott_staff || is_vmcott_inspector %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔍 2. INSPECTION</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-search me-2"></i> Inspections Dashboard
                      <% if @pending_inspections_count > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_inspections_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path, class: "dropdown-item" do %>
                      <i class="bi bi-list-check me-2"></i> All Inspections
                    <% end %>
                  </li>
                <% end %>

                <%# PARTS COORDINATOR %>
                <% if is_admin || is_vmcott_staff || is_vmcott_parts_coordinator %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📦 3. PARTS COORDINATION</li>
                  <li>
                    <%= link_to vmcott_parts_coordinator_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-box-seam me-2"></i> Parts Dashboard
                      <% if @pending_parts_count > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_parts_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path, class: "dropdown-item" do %>
                      <i class="bi bi-gear me-2"></i> Parts Catalog
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inventory_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-archive me-2"></i> Inventory Lookup
                    <% end %>
                  </li>
                <% end %>
                
                <%# BILLING (RFQs) %>
                <% if is_admin || is_vmcott_staff || is_vmcott_billing || is_vmcott_billing_team %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📨 4. BILLING (RFQs)</li>
                  <li>
                    <%= link_to vmcott_billing_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-envelope-paper me-2"></i> Billing Dashboard
                      <% if @pending_quotations_count > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_quotations_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_rfq_inbox_path, class: "dropdown-item" do %>
                      <i class="bi bi-inbox me-2"></i> RFQ Inbox
                    <% end %>
                  </li>
                  <li>
                    <%= link_to suppliers_path, class: "dropdown-item" do %>
                      <i class="bi bi-building me-2"></i> Suppliers/Vendors
                    <% end %>
                  </li>
                <% end %>

                <%# FINANCE (Quotations) %>
                <% if is_admin || is_vmcott_staff || is_vmcott_finance %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">💰 5. FINANCE (Quotations)</li>
                  <li>
                    <%= link_to vmcott_billing_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-cash-stack me-2"></i> Review Quotations
                      <% if @pending_quotations_count > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_quotations_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_quotation_workspace_path, class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-data me-2"></i> Quotation Workspace
                    <% end %>
                  </li>
                  <li>
                    <%= link_to purchase_orders_path, class: "dropdown-item" do %>
                      <i class="bi bi-bag-check me-2"></i> Purchase Orders
                    <% end %>
                  </li>
                <% end %>

                <%# WORKSHOP %>
                <% if is_admin || is_vmcott_workshop_manager || is_vmcott_mechanic %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔧 6. WORKSHOP</li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-tools me-2"></i> Jobs by Vehicle
                      <% if @available_jobs_count > 0 %>
                        <span class="badge bg-success float-end"><%= @available_jobs_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to active_work_vmcott_internal_pos_path, class: "dropdown-item" do %>
                      <i class="bi bi-play-circle me-2"></i> Active Work Orders
                    <% end %>
                  </li>
                  <% if is_admin || is_vmcott_workshop_manager %>
                    <li>
                      <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "dropdown-item" do %>
                        <i class="bi bi-clipboard-check me-2"></i> Supervisor View
                      <% end %>
                    </li>
                  <% end %>
                <% end %>

                <%# QUALITY CONTROL %>
                <% if is_admin || is_vmcott_inspector %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">✅ 7. QUALITY CONTROL</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i> Pending QC
                      <% if @pending_qc_count > 0 %>
                        <span class="badge bg-warning float-end"><%= @pending_qc_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>

                <%# INVOICING %>
                <% if is_admin || is_vmcott_finance || is_vmcott_billing %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">💵 8. INVOICING</li>
                  <li>
                    <%= link_to vmcott_billing_invoices_path, class: "dropdown-item" do %>
                      <i class="bi bi-receipt me-2"></i> All Invoices
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_billing_invoices_path(status: 'pending'), class: "dropdown-item" do %>
                      <i class="bi bi-truck me-2"></i> Ready for Pickup
                      <% if @ready_for_pickup_count > 0 %>
                        <span class="badge bg-success float-end"><%= @ready_for_pickup_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- ================= Admin Section - PTSC ONLY ================= -->
          <% if current_user.admin? && agency_code == "PTSC" %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-shield-lock me-1"></i> Admin
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">USER MANAGEMENT</li>
                <li>
                  <%= link_to admin_users_path, class: "dropdown-item" do %>
                    <i class="bi bi-people me-2"></i> Manage Users
                  <% end %>
                </li>
                <li>
                  <%= link_to new_admin_user_path, class: "dropdown-item" do %>
                    <i class="bi bi-person-plus me-2"></i> Create New User
                  <% end %>
                </li>
              </ul>
            </div>
          <% end %>

          <!-- ================= Fleet Manager ================= -->
          <% if is_fleet_manager %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-truck me-1"></i> Fleet Manager
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">FLEET</li>

                <% if agency.present? && agency_code != "VMCOTT" %>
                  <li>
                    <%= link_to agency_vehicles_path(agency), class: "dropdown-item" do %>
                      <i class="bi bi-truck me-2"></i> My Fleet
                    <% end %>
                  </li>

                  <li>
                    <%= link_to agency_analytics_path(agency), class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Fleet Analytics
                    <% end %>
                  </li>
                <% elsif agency_code == "VMCOTT" && (is_admin || is_vmcott_staff || is_vmcott_workshop_manager) %>
                  <li>
                    <%= link_to vehicles_path, class: "dropdown-item" do %>
                      <i class="bi bi-truck-flatbed me-2"></i> All Fleets
                    <% end %>
                  </li>

                  <li>
                    <%= link_to analytics_vehicles_path, class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Fleet Analytics
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <span class="dropdown-item disabled-item">
                      <i class="bi bi-truck me-2"></i> My Fleet (No agency)
                    </span>
                  </li>
                <% end %>

                <%# DRIVERS SECTION - SHOW ONLY FOR NON-VMCOTT USERS %>
                <% if agency_code != "VMCOTT" %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">DRIVERS</li>
                  <li>
                    <%= link_to drivers_path, class: "dropdown-item" do %>
