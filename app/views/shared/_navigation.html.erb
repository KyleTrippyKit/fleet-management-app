          <% end %>

        </div>

        <!-- RIGHT -->
        <div class="d-flex gap-2 align-items-center">

          <%# Show user role and notification bell for non-VMCOTT users %>
          <% if agency_code.present? && agency_code != "VMCOTT" %>
            <span class="badge nav-agency-pill">
              <i class="bi bi-building me-1"></i> <%= agency_code %>
            </span>
            
            <%# Simple notification bell for non-VMCOTT users %>
            <%= link_to alerts_path, class: "btn btn-sm btn-outline-primary rounded-pill px-3 py-2 position-relative" do %>
              <i class="bi bi-bell"></i>
              <% if @alerts_count && @alerts_count > 0 %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= @alerts_count %>
                </span>
              <% end %>
            <% end %>
          <% end %>

          <%= button_to destroy_user_session_path,
            method: :delete,
            class: "btn btn-sm btn-outline-danger rounded-pill px-3 py-2 fw-semibold nav-pill",
            form: { "data-turbo" => "false" } do %>
            <i class="bi bi-box-arrow-right me-1"></i> Logout
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>

