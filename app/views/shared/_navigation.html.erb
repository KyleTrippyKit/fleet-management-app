<%# app/views/shared/_navigation.html.erb - COMPLETE ROLE-BASED DASHBOARD NAVIGATION WITH NOTIFICATIONS %>
<%# Updated to match VMCOTT workflow - COMPATIBLE WITH EXISTING ROUTES %>
<%# REMOVED generic Dashboard button - each role has their own home button %>
<%# SEPARATED Billing Team and Finance Team into distinct buttons with their own routes %>
<%# FIXED: Billing uses vmcott_billing_dashboard_path, Finance uses vmcott_finance_dashboard_path %>

<% return unless current_user.present? %>

<% agency      = current_user&.agency %>
<% agency_code = agency&.code.to_s.upcase %>
<% user_role   = current_user.role.to_s %>

<% is_admin   = !!current_user&.admin? %>

<%# ============================================================
    NOTIFICATION COUNTS - FETCH FOR EACH ROLE
   ============================================================ %>
<%
  # These would be helper methods or instance variables set in ApplicationController
  @unread_notifications_count ||= 0
  @pending_inspections_count ||= 0
  @pending_parts_count ||= 0                     # Parts needing coordinator review
  @pending_quotations_count ||= 0
  @available_jobs_count ||= 0
  @pending_qc_count ||= 0
  @ready_for_pickup_count ||= 0
  @parts_needing_review_count ||= 0               # Parts needing coordinator attention
  @parts_to_order_count ||= 0                     # Parts that need ordering
  @pending_purchase_requests_count ||= 0          # Purchase requests waiting for billing
  @low_stock_alert_count ||= 0                    # Low stock alerts
  @inspections_today_count ||= 0                  # Inspections done today
  @pending_qc_inspections_count ||= 0             # Vehicles waiting for QC
  @assigned_jobs_count ||= 0                      # Jobs assigned to current mechanic
  @in_progress_count ||= 0                        # Jobs in progress
  @pending_parts_requests_count ||= 0             # Parts requests needing RFQ (for Billing)
  @quotations_to_review_count ||= 0                # Quotations ready for Finance review
  @pending_po_approval_count ||= 0                 # POs awaiting Finance approval
%>

<%# ============================================================
    VMCOTT ROLE DEFINITIONS
   ============================================================ %>
<% is_vmcott_admin           = is_admin && agency_code == "VMCOTT" %>
<% is_vmcott_staff           = user_role == 'vmcott_staff' %>
<% is_vmcott_finance         = user_role == 'finance' && agency_code == "VMCOTT" %>
<% is_vmcott_workshop_manager = user_role == 'workshop_manager' && agency_code == "VMCOTT" %>
<% is_vmcott_inventory_clerk  = user_role == 'inventory_clerk' && agency_code == "VMCOTT" %>

<%# Explicit VMCOTT workflow roles %>
<% is_vmcott_receptionist     = user_role == 'receptionist' && agency_code == "VMCOTT" %>
<% is_vmcott_inspector        = user_role == 'inspector' && agency_code == "VMCOTT" %>
<% is_vmcott_parts_coordinator = user_role == 'parts_coordinator' && agency_code == "VMCOTT" %>
<% is_vmcott_mechanic         = user_role == 'mechanic' && agency_code == "VMCOTT" %>

<%# Billing and Finance are now SEPARATE roles %>
<% is_vmcott_billing          = user_role == 'billing' && agency_code == "VMCOTT" %>
<% is_vmcott_finance          = user_role == 'finance' && agency_code == "VMCOTT" %>

<%# Regular users see only their specific role %>
<% is_fleet_manager          = user_role == 'fleet_manager' %>
<% is_maintenance_supervisor = user_role == 'maintenance_supervisor' || user_role == 'maintenance' %>
<% is_financial_officer      = user_role == 'finance' %>
<% is_driver                 = user_role == 'driver' %>
<% is_supervisor             = user_role == 'supervisor' %>

<%# Admins see all roles for their agency type %>
<% if is_admin %>
  <% case agency_code %>
  <% when 'PTSC', 'TTPS', 'TTDF' %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% when 'VMCOTT' %>
    <%# VMCOTT Admin gets EVERYTHING %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
    <% is_vmcott_staff = true %>
    <% is_vmcott_workshop_manager = true %>
    <% is_vmcott_inventory_clerk = true %>
    <% is_vmcott_receptionist = true %>
    <% is_vmcott_inspector = true %>
    <% is_vmcott_parts_coordinator = true %>
    <% is_vmcott_mechanic = true %>
    <% is_vmcott_billing = true %>
    <% is_vmcott_finance = true %>
  <% else %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% end %>
<% end %>

<%# Supervisors also get maintenance supervisor access %>
<% if is_supervisor %>
  <% is_maintenance_supervisor = true %>
<% end %>

<%# Only VMCOTT can write maintenance - PTSC users cannot add maintenance even if admin %>
<% can_write_maintenance = agency_code == "VMCOTT" %>

<div class="mb-4">
  <div class="card border-0 shadow-sm nav-card">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">

        <!-- LEFT -->
        <div class="d-flex flex-wrap gap-2 align-items-center">

          <!-- ================= VMCOTT WORKFLOW NAVIGATION - USING EXISTING ROUTES ================= -->
          <% if agency_code == "VMCOTT" %>

            <!-- STEP 1: RECEPTIONIST (Simple button) -->
            <% if is_vmcott_receptionist || is_admin %>
              <%= link_to vmcott_receptionist_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill #{current_page?(vmcott_receptionist_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-door-open me-1"></i> Reception
              <% end %>
            <% end %>

            <!-- STEP 2: INSPECTOR - ORGANIZED DROPDOWN -->
            <% if is_vmcott_inspector || is_admin %>
              <div class="dropdown nav-dd">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-bs-boundary="viewport"
                        data-bs-display="static">
                  <i class="bi bi-search me-1"></i> Inspector
                  <% if @pending_inspections_count.to_i > 0 || @pending_qc_inspections_count.to_i > 0 %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                      <%= @pending_inspections_count.to_i + @pending_qc_inspections_count.to_i %>
                    </span>
                  <% end %>
                </button>

                <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                  <!-- Dashboard Home -->
                  <li class="dropdown-section">📊 DASHBOARD</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i> Inspector Dashboard
                      <% if @pending_inspections_count.to_i > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_inspections_count %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <!-- INSPECTIONS SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔍 INSPECTIONS</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path(anchor: 'pending'), class: "dropdown-item" do %>
                      <i class="bi bi-clock me-2"></i> Pending Inspections
                      <% if @pending_inspections_count.to_i > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_inspections_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path, class: "dropdown-item" do %>
                      <i class="bi bi-list-check me-2"></i> All Inspections
                      <% if @inspections_today_count.to_i > 0 %>
                        <span class="badge bg-info float-end"><%= @inspections_today_count %> today</span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path(status: 'completed'), class: "dropdown-item" do %>
                      <i class="bi bi-check-circle me-2"></i> Completed Inspections
                    <% end %>
                  </li>

                  <!-- QUALITY CONTROL SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">✅ QUALITY CONTROL</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path(anchor: 'qc'), class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i> Pending QC
                      <% if @pending_qc_inspections_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @pending_qc_inspections_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path(status: 'qc_completed'), class: "dropdown-item" do %>
                      <i class="bi bi-check-circle me-2"></i> QC Completed
                    <% end %>
                  </li>

                  <!-- REPORTS SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📊 REPORTS</li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path(report: 'daily'), class: "dropdown-item" do %>
                      <i class="bi bi-calendar-day me-2"></i> Daily Report
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path(report: 'weekly'), class: "dropdown-item" do %>
                      <i class="bi bi-calendar-week me-2"></i> Weekly Summary
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>

            <!-- STEP 3: PARTS COORDINATOR - ORGANIZED DROPDOWN -->
            <% if is_vmcott_parts_coordinator || is_admin %>
              <div class="dropdown nav-dd">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-bs-boundary="viewport"
                        data-bs-display="static">
                  <i class="bi bi-box-seam me-1"></i> Parts Coordinator
                  <% total_alerts = (@pending_parts_count || 0) + (@parts_needing_review_count || 0) + (@low_stock_alert_count || 0) %>
                  <% if total_alerts > 0 %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                      <%= total_alerts %>
                    </span>
                  <% end %>
                </button>

                <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                  <!-- Dashboard Home -->
                  <li class="dropdown-section">📊 DASHBOARD</li>
                  <li>
                    <%= link_to vmcott_parts_coordinator_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i> Coordinator Dashboard
                      <% if total_alerts > 0 %>
                        <span class="badge bg-danger float-end"><%= total_alerts %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <!-- PARTS REVIEW SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔍 PARTS REVIEW</li>
                  <li>
                    <%= link_to vmcott_parts_coordinator_dashboard_path(anchor: 'pending'), class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i> Pending Parts Review
                      <% if @pending_parts_count.to_i > 0 %>
                        <span class="badge bg-danger float-end"><%= @pending_parts_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path, class: "dropdown-item" do %>
                      <i class="bi bi-gear me-2"></i> Parts Catalog
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path(category: 'consumables'), class: "dropdown-item" do %>
                      <i class="bi bi-droplet me-2"></i> Consumables
                    <% end %>
                  </li>

                  <!-- INVENTORY MANAGEMENT -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📦 INVENTORY</li>
                  <li>
                    <%= link_to vmcott_inventory_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-archive me-2"></i> Inventory Dashboard
                      <% if @low_stock_alert_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @low_stock_alert_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inventory_low_stock_path, class: "dropdown-item" do %>
                      <i class="bi bi-exclamation-triangle me-2"></i> Low Stock Alerts
                      <% if @low_stock_alert_count.to_i > 0 %>
                        <span class="badge bg-danger float-end"><%= @low_stock_alert_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path, class: "dropdown-item" do %>
                      <i class="bi bi-plus-circle me-2"></i> Add New Part
                    <% end %>
                  </li>

                  <!-- PURCHASE REQUESTS -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📋 PURCHASE REQUESTS</li>
                  <li>
                    <%= link_to vmcott_inventory_purchase_requests_path, class: "dropdown-item" do %>
                      <i class="bi bi-cart-plus me-2"></i> All Purchase Requests
                      <% if @pending_purchase_requests_count.to_i > 0 %>
                        <span class="badge bg-info float-end"><%= @pending_purchase_requests_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inventory_new_purchase_request_path, class: "dropdown-item" do %>
                      <i class="bi bi-plus-circle me-2"></i> Create Purchase Request
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inventory_purchase_requests_path(status: 'pending'), class: "dropdown-item" do %>
                      <i class="bi bi-clock me-2"></i> Pending Requests
                      <% if @pending_purchase_requests_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @pending_purchase_requests_count %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <!-- SUPPLIER MANAGEMENT -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🏢 SUPPLIERS</li>
                  <li>
                    <%= link_to suppliers_path, class: "dropdown-item" do %>
                      <i class="bi bi-building me-2"></i> All Suppliers
                    <% end %>
                  </li>
                  <li>
                    <%= link_to new_supplier_path, class: "dropdown-item" do %>
                      <i class="bi bi-plus-circle me-2"></i> Add Supplier
                    <% end %>
                  </li>
                  <li>
                    <%= link_to suppliers_path(active: true), class: "dropdown-item" do %>
                      <i class="bi bi-star me-2"></i> Preferred Suppliers
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>

            <!-- STEP 4: BILLING TEAM (RFQs) - FIXED: Uses vmcott_billing_dashboard_path -->
            <% if is_vmcott_billing || is_admin %>
              <%= link_to vmcott_billing_dashboard_path,
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_billing_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-envelope-paper me-1"></i> Billing
                <% if @pending_parts_requests_count.to_i > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @pending_parts_requests_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 5: FINANCE TEAM (Quotations & POs) - FIXED: Uses vmcott_finance_dashboard_path -->
            <% if is_vmcott_finance || is_admin %>
              <%= link_to vmcott_finance_dashboard_path, 
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative #{current_page?(vmcott_finance_dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
                <i class="bi bi-cash-stack me-1"></i> Finance
                <% if (@quotations_to_review_count.to_i + @pending_po_approval_count.to_i) > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @quotations_to_review_count.to_i + @pending_po_approval_count.to_i %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

            <!-- STEP 6: MECHANIC - ORGANIZED DROPDOWN -->
            <% if is_vmcott_mechanic || is_admin %>
              <div class="dropdown nav-dd">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-bs-boundary="viewport"
                        data-bs-display="static">
                  <i class="bi bi-tools me-1"></i> Mechanic
                  <% total_mechanic_alerts = (@available_jobs_count || 0) + (@pending_qc_count || 0) %>
                  <% if total_mechanic_alerts > 0 %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                      <%= total_mechanic_alerts %>
                    </span>
                  <% end %>
                </button>

                <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                  <!-- Dashboard Home -->
                  <li class="dropdown-section">📊 DASHBOARD</li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i> Mechanic Dashboard
                      <% if @available_jobs_count.to_i > 0 || @pending_qc_count.to_i > 0 %>
                        <span class="badge bg-danger float-end"><%= @available_jobs_count.to_i + @pending_qc_count.to_i %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <!-- MY JOBS SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔧 MY JOBS</li>
                  <li>
                    <%= link_to assigned_vmcott_mechanic_jobs_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-workspace me-2"></i> My Assigned Jobs
                      <% if @assigned_jobs_count.to_i > 0 %>
                        <span class="badge bg-primary float-end"><%= @assigned_jobs_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path(anchor: 'in-progress'), class: "dropdown-item" do %>
                      <i class="bi bi-play-circle me-2"></i> In Progress
                      <% if @in_progress_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @in_progress_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to completed_vmcott_mechanic_jobs_path, class: "dropdown-item" do %>
                      <i class="bi bi-check-circle me-2"></i> Completed Jobs
                    <% end %>
                  </li>

                  <!-- AVAILABLE JOBS SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📋 AVAILABLE JOBS</li>
                  <li>
                    <%= link_to available_vmcott_mechanic_jobs_path, class: "dropdown-item" do %>
                      <i class="bi bi-briefcase me-2"></i> Available Jobs
                      <% if @available_jobs_count.to_i > 0 %>
                        <span class="badge bg-success float-end"><%= @available_jobs_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path(anchor: 'by-vehicle'), class: "dropdown-item" do %>
                      <i class="bi bi-truck me-2"></i> Grouped by Vehicle
                    <% end %>
                  </li>

                  <!-- QUALITY CONTROL SECTION -->
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">✅ QUALITY CONTROL</li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path(anchor: 'pending-qc'), class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i> Pending QC
                      <% if @pending_qc_count.to_i > 0 %>
                        <span class="badge bg-warning float-end"><%= @pending_qc_count %></span>
                      <% end %>
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>

            <!-- READY FOR PICKUP - Shared button (for Finance/Admin) -->
            <% if is_vmcott_finance || is_admin %>
              <%= link_to vmcott_finance_invoices_path(status: 'pending'), 
                  class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill position-relative btn-outline-primary" do %>
                <i class="bi bi-truck me-1"></i> Ready for Pickup
                <% if @ready_for_pickup_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                    <%= @ready_for_pickup_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>

          <% end %>

          <!-- ================= NOTIFICATION CENTER - FOR ALL VMCOTT ROLES ================= -->
          <% if agency_code == "VMCOTT" && (is_vmcott_receptionist || is_vmcott_inspector || is_vmcott_parts_coordinator || is_vmcott_mechanic || is_vmcott_billing || is_vmcott_finance || is_admin) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle position-relative"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-bell me-1"></i> Notifications
                <% if @unread_notifications_count > 0 %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @unread_notifications_count %>
                    <span class="visually-hidden">unread notifications</span>
                  </span>
                <% end %>
              </button>

              <ul class="dropdown-menu dropdown-menu-float dropdown-scroll" style="min-width: 300px;">
                <li class="dropdown-section">🔔 RECENT NOTIFICATIONS</li>
                
                <%# This would be populated from a @recent_notifications variable %>
                <% if @recent_notifications && @recent_notifications.any? %>
                  <% @recent_notifications.each do |notification| %>
                    <li>
                      <%= link_to notification_path(notification), class: "dropdown-item #{'fw-bold' unless notification.read?}" do %>
                        <div class="d-flex align-items-center">
                          <div class="me-2">
                            <% case notification.notifiable_type %>
                            <% when 'Inspection' %>
                              <i class="bi bi-search text-info"></i>
                            <% when 'PartsRequest' %>
                              <i class="bi bi-box-seam text-warning"></i>
                            <% when 'PurchaseOrder' %>
                              <i class="bi bi-file-text text-success"></i>
                            <% else %>
                              <i class="bi bi-bell text-primary"></i>
                            <% end %>
                          </div>
                          <div class="flex-grow-1">
                            <div><%= notification.title %></div>
                            <small class="text-muted"><%= time_ago_in_words(notification.created_at) %> ago</small>
                          </div>
                          <% unless notification.read? %>
                            <span class="badge bg-danger rounded-pill ms-2">New</span>
                          <% end %>
                        </div>
                      <% end %>
                    </li>
                  <% end %>
                <% else %>
                  <li><span class="dropdown-item text-muted">No notifications</span></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- ================= WORKFLOW DROPDOWN (COMPLETE VIEW) - USING EXISTING ROUTES ================= -->
          <% if agency_code == "VMCOTT" && (is_admin || is_vmcott_workshop_manager || is_vmcott_staff) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-diagram-3 me-1"></i> Full Workflow
              </button>

              <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                
                <%# RECEPTION %>
                <% if is_admin || is_vmcott_staff || is_vmcott_receptionist %>
                  <li class="dropdown-section">🚪 1. RECEPTION</li>
                  <li>
                    <%= link_to vmcott_receptionist_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-badge me-2"></i> Vehicle Reception
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_receptionist_scan_path, class: "dropdown-item" do %>
                      <i class="bi bi-qr-code-scan me-2"></i> Scan QR Code
                    <% end %>
                  </li>
                <% end %>

