<%# app/views/shared/_navigation.html.erb - COMPLETE ROLE-BASED DASHBOARD NAVIGATION %>
<%# Includes all VMCOTT workflow roles: Receptionist, Inspector, Parts Coordinator, Mechanic, Workshop Supervisor, Billing %>

<% return unless current_user.present? %>

<% agency      = current_user&.agency %>
<% agency_code = agency&.code.to_s.upcase %>
<% user_role   = current_user.role.to_s %>

<% is_admin   = !!current_user&.admin? %>

<%# ============================================================
    VMCOTT ROLE DEFINITIONS
   ============================================================ %>
<% is_vmcott_admin           = is_admin && agency_code == "VMCOTT" %>
<% is_vmcott_staff           = user_role == 'vmcott_staff' %>
<% is_vmcott_finance         = user_role == 'finance' && agency_code == "VMCOTT" %>
<% is_vmcott_workshop_manager = user_role == 'workshop_manager' %>
<% is_vmcott_inventory_clerk  = user_role == 'inventory_clerk' %>

<%# NEW: Explicit VMCOTT workflow roles %>
<% is_vmcott_receptionist     = user_role == 'receptionist' && agency_code == "VMCOTT" %>
<% is_vmcott_inspector        = user_role == 'inspector' && agency_code == "VMCOTT" %>
<% is_vmcott_parts_coordinator = user_role == 'parts_coordinator' && agency_code == "VMCOTT" %>
<% is_vmcott_mechanic         = user_role == 'mechanic' && agency_code == "VMCOTT" %>
<% is_vmcott_billing          = user_role == 'finance' && agency_code == "VMCOTT" %>

<%# Regular users see only their specific role %>
<% is_fleet_manager          = user_role == 'fleet_manager' %>
<% is_maintenance_supervisor = user_role == 'maintenance_supervisor' || user_role == 'maintenance' %>
<% is_financial_officer      = user_role == 'finance' %>
<% is_driver                 = user_role == 'driver' %>
<% is_supervisor             = user_role == 'supervisor' %>

<%# Admins see all roles for their agency type %>
<% if is_admin %>
  <% case agency_code %>
  <% when 'PTSC', 'TTPS', 'TTDF' %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% when 'VMCOTT' %>
    <%# VMCOTT Admin gets EVERYTHING %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
    <% is_vmcott_staff = true %>
    <% is_vmcott_workshop_manager = true %>
    <% is_vmcott_inventory_clerk = true %>
    <% is_vmcott_receptionist = true %>
    <% is_vmcott_inspector = true %>
    <% is_vmcott_parts_coordinator = true %>
    <% is_vmcott_mechanic = true %>
    <% is_vmcott_billing = true %>
  <% else %>
    <% is_fleet_manager = true %>
    <% is_maintenance_supervisor = true %>
    <% is_financial_officer = true %>
  <% end %>
<% end %>

<%# Supervisors also get maintenance supervisor access %>
<% if is_supervisor %>
  <% is_maintenance_supervisor = true %>
<% end %>

<%# Only VMCOTT can write maintenance - PTSC users cannot add maintenance even if admin %>
<% can_write_maintenance = agency_code == "VMCOTT" %>

<%# ROLE-BASED DASHBOARD PATH - MATCHES HOMECONTROLLER LOGIC %>
<%
  # PTSC Admin goes to PTSC dashboard
  if agency_code == "PTSC" && current_user.admin?
    dashboard_path = ptsc_dashboard_path
  # PTSC users by role
  elsif agency_code == "PTSC"
    case current_user.role
    when 'fleet_manager'
      dashboard_path = ptsc_fleet_dashboard_path
    when 'finance'
      dashboard_path = ptsc_finance_dashboard_path
    when 'driver'
      dashboard_path = ptsc_driver_dashboard_path
    when 'maintenance_supervisor', 'maintenance'
      dashboard_path = ptsc_maintenance_dashboard_path
    else
      dashboard_path = ptsc_dashboard_path
    end
  # VMCOTT users (including admins) always go to VMCOTT dashboard
  elsif agency_code == "VMCOTT"
    dashboard_path = vmcott_dashboard_path
  else
    # For other agencies, use role-based routing
    case current_user.role
    when 'admin'
      dashboard_path = main_dashboard_path
    when 'fleet_manager'
      if agency.present?
        dashboard_path = agency_vehicles_path(agency)
      else
        dashboard_path = main_dashboard_path
      end
    when 'finance'
      dashboard_path = main_dashboard_path
    when 'driver'
      dashboard_path = driver_dashboard_path
    when 'maintenance_supervisor', 'maintenance'
      dashboard_path = maintenance_dashboard_path
    else
      # Legacy agency-based dashboards as fallback
      case agency_code
      when "TTPS"   then ttps_dashboard_path
      when "TTDF"   then ttdf_dashboard_path
      else
        main_dashboard_path
      end
    end
  end
%>

<div class="mb-4">
  <div class="card border-0 shadow-sm nav-card">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">

        <!-- LEFT -->
        <div class="d-flex flex-wrap gap-2 align-items-center">

          <!-- Dashboard - Role-based -->
          <%= link_to dashboard_path,
            class: "btn btn-sm rounded-pill px-3 py-2 fw-semibold nav-pill #{current_page?(dashboard_path) ? 'btn-primary nav-active' : 'btn-outline-primary'}" do %>
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          <% end %>

          <!-- ================= Admin Section - PTSC ONLY ================= -->
          <% if current_user.admin? && agency_code == "PTSC" %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-shield-lock me-1"></i> Admin
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">USER MANAGEMENT</li>
                <li>
                  <%= link_to admin_users_path, class: "dropdown-item" do %>
                    <i class="bi bi-people me-2"></i> Manage Users
                  <% end %>
                </li>
                <li>
                  <%= link_to new_admin_user_path, class: "dropdown-item" do %>
                    <i class="bi bi-person-plus me-2"></i> Create New User
                  <% end %>
                </li>
                <!-- MANAGE AGENCIES LINK REMOVED - PTSC only manages its own users -->
              </ul>
            </div>
          <% end %>

          <!-- ================= Fleet Manager ================= -->
          <% if is_fleet_manager %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-truck me-1"></i> Fleet Manager
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">FLEET</li>

                <% if agency.present? && agency_code != "VMCOTT" %>
                  <li>
                    <%= link_to agency_vehicles_path(agency), class: "dropdown-item" do %>
                      <i class="bi bi-truck me-2"></i> My Fleet
                    <% end %>
                  </li>

                  <li>
                    <%= link_to agency_analytics_path(agency), class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Fleet Analytics
                    <% end %>
                  </li>
                <% elsif agency_code == "VMCOTT" && (is_admin || is_vmcott_staff || is_vmcott_workshop_manager) %>
                  <li>
                    <%= link_to vehicles_path, class: "dropdown-item" do %>
                      <i class="bi bi-truck-flatbed me-2"></i> All Fleets
                    <% end %>
                  </li>

                  <li>
                    <%= link_to analytics_vehicles_path, class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Fleet Analytics
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <span class="dropdown-item disabled-item">
                      <i class="bi bi-truck me-2"></i> My Fleet (No agency)
                    </span>
                  </li>
                <% end %>

                <%# DRIVERS SECTION - SHOW ONLY FOR NON-VMCOTT USERS %>
                <% if agency_code != "VMCOTT" %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">DRIVERS</li>
                  <li>
                    <%= link_to drivers_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-badge me-2"></i> Manage Drivers
                    <% end %>
                  </li>
                  <li>
                    <%= link_to new_driver_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-plus me-2"></i> Add New Driver
                    <% end %>
                  </li>
                <% end %>

                <%# Alerts section - Show for all except VMCOTT %>
                <% if agency_code != "VMCOTT" %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">ALERTS</li>
                  <li>
                    <%= link_to alerts_path, class: "dropdown-item" do %>
                      <i class="bi bi-bell me-2"></i> Alerts
                    <% end %>
                  </li>
                <% end %>

              </ul>
            </div>
          <% end %>

          <!-- ================= Maintenance Supervisor ================= -->
          <% if is_maintenance_supervisor %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-wrench-adjustable-circle me-1"></i> Maintenance
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">MAINTENANCE</li>

                <!-- REMOVED: Dashboard link from Maintenance dropdown -->

                <li>
                  <%= link_to gantt_path, class: "dropdown-item" do %>
                    <i class="bi bi-bar-chart-steps me-2"></i> Timeline (Gantt)
                  <% end %>
                </li>

                <li>
                  <%= link_to maintenances_path, class: "dropdown-item" do %>
                    <i class="bi bi-list me-2"></i> View All
                  <% end %>
                </li>

                <%# Add Maintenance option - ONLY visible to VMCOTT users with write access %>
                <% if can_write_maintenance && (is_admin || is_vmcott_workshop_manager || is_vmcott_staff) %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">WORKSHOP</li>
                  <li>
                    <%= link_to new_maintenance_path, class: "dropdown-item" do %>
                      <i class="bi bi-plus-circle me-2"></i> Add Maintenance
                    <% end %>
                  </li>
                <% end %>

              </ul>
            </div>
          <% end %>

          <!-- ================= PROCUREMENT (Agencies only) ================= -->
          <% if is_financial_officer && agency_code.present? && agency_code != "VMCOTT" %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-cart me-1"></i> Procurement
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">RFQs</li>
                
                <% if agency.present? && respond_to?(:new_agency_rfq_path) %>
                  <li>
                    <%= link_to new_agency_rfq_path(agency), class: "dropdown-item" do %>
                      <i class="bi bi-file-earmark-plus me-2"></i> New RFQ (to VMCOTT)
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <span class="dropdown-item disabled-item">
                      <i class="bi bi-file-earmark-plus me-2"></i> New RFQ (Unavailable)
                    </span>
                  </li>
                <% end %>

                <li>
                  <%= link_to sent_rfqs_path, class: "dropdown-item" do %>
                    <i class="bi bi-send me-2"></i> Sent RFQs
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>

                <li class="dropdown-section">QUOTATIONS</li>
                <li>
                  <%= link_to received_quotations_path, class: "dropdown-item" do %>
                    <i class="bi bi-inbox me-2"></i> Quotations Inbox
                  <% end %>
                </li>

                <% if agency_code == "PTSC" && respond_to?(:ptsc_quotation_review_path) %>
                  <li>
                    <%= link_to ptsc_quotation_review_path, class: "dropdown-item" do %>
                      <i class="bi bi-ui-checks me-2"></i> Quotation Review
                    <% end %>
                  </li>
                <% end %>

                <% if agency_code == "PTSC" && respond_to?(:ptsc_po_acceptance_path) %>
                  <li>
                    <%= link_to ptsc_po_acceptance_path, class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i> PO Acceptance Queue
                    <% end %>
                  </li>
                <% end %>

                <li><hr class="dropdown-divider"></li>

                <li class="dropdown-section">ORDERS</li>
                <li>
                  <%= link_to purchase_orders_path, class: "dropdown-item" do %>
                    <i class="bi bi-bag-check me-2"></i> Purchase Orders
                  <% end %>
                </li>
              </ul>
            </div>
          <% end %>

          <!-- ================= WORKFLOW (VMCOTT Internal) - COMPLETE ================= -->
          <% if agency_code == "VMCOTT" && (is_admin || is_vmcott_staff || is_vmcott_workshop_manager || is_vmcott_inventory_clerk || is_vmcott_receptionist || is_vmcott_inspector || is_vmcott_parts_coordinator || is_vmcott_mechanic) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-gear-wide-connected me-1"></i> Workflow
              </button>

              <ul class="dropdown-menu dropdown-menu-float dropdown-scroll">
                
                <%# RECEPTION %>
                <% if is_admin || is_vmcott_staff || is_vmcott_receptionist %>
                  <li class="dropdown-section">🚪 RECEPTION</li>
                  <li>
                    <%= link_to vmcott_receptionist_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-person-badge me-2"></i> Vehicle Reception
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_receptionist_scan_path, class: "dropdown-item" do %>
                      <i class="bi bi-qr-code-scan me-2"></i> Scan QR Code
                    <% end %>
                  </li>
                <% end %>

                <%# INSPECTION %>
                <% if is_admin || is_vmcott_staff || is_vmcott_inspector %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔍 INSPECTION</li>
                  <li>
                    <%= link_to vmcott_inspector_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-search me-2"></i> Inspections Dashboard
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_inspector_inspections_path, class: "dropdown-item" do %>
                      <i class="bi bi-list-check me-2"></i> All Inspections
                    <% end %>
                  </li>
                <% end %>

                <%# PARTS COORDINATOR %>
                <% if is_admin || is_vmcott_staff || is_vmcott_parts_coordinator %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📦 PARTS</li>
                  <li>
                    <%= link_to vmcott_parts_coordinator_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-box-seam me-2"></i> Parts Dashboard
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path, class: "dropdown-item" do %>
                      <i class="bi bi-gear me-2"></i> Parts Catalog
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_coordinator_new_rfq_path(part_id: 0), class: "dropdown-item" do %>
                      <i class="bi bi-file-earmark-plus me-2"></i> Create RFQ
                    <% end %>
                  </li>
                <% end %>
                
                <%# RFQ PROCESSING %>
                <% if is_admin || is_vmcott_staff || is_vmcott_workshop_manager %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📋 RFQ PROCESSING</li>
                  <li>
                    <%= link_to vmcott_rfq_inbox_path, class: "dropdown-item" do %>
                      <i class="bi bi-inbox me-2"></i> RFQ Inbox
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_quotation_workspace_path, class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-data me-2"></i> Quotation Workspace
                    <% end %>
                  </li>
                <% end %>

                <%# WORKSHOP OPERATIONS %>
                <% if is_admin || is_vmcott_workshop_manager || is_vmcott_mechanic %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">🔧 WORKSHOP</li>
                  <li>
                    <%= link_to vmcott_mechanic_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-tools me-2"></i> Mechanic Dashboard
                    <% end %>
                  </li>
                  <li>
                    <%= link_to active_work_vmcott_internal_pos_path, class: "dropdown-item" do %>
                      <i class="bi bi-play-circle me-2"></i> Active Work Orders
                    <% end %>
                  </li>
                  <% if is_admin || is_vmcott_workshop_manager %>
                    <li>
                      <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "dropdown-item" do %>
                        <i class="bi bi-clipboard-check me-2"></i> Supervisor View
                      <% end %>
                    </li>
                  <% end %>
                <% end %>

                <%# ORDERS %>
                <% if is_admin || is_vmcott_staff || is_vmcott_workshop_manager %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📦 ORDERS</li>
                  <li>
                    <%= link_to purchase_orders_path, class: "dropdown-item" do %>
                      <i class="bi bi-bag-check me-2"></i> Purchase Orders
                    <% end %>
                  </li>
                <% end %>

                <%# INVENTORY %>
                <% if is_admin || is_vmcott_inventory_clerk || is_vmcott_staff %>
                  <li><hr class="dropdown-divider"></li>
                  <li class="dropdown-section">📦 INVENTORY</li>
                  <li>
                    <%= link_to vmcott_inventory_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-box-seam me-2"></i> Inventory Dashboard
                    <% end %>
                  </li>
                  <li>
                    <%= link_to vmcott_parts_path, class: "dropdown-item" do %>
                      <i class="bi bi-gear me-2"></i> Parts Catalog
                    <% end %>
                  </li>
                  <li>
                    <%= link_to suppliers_path, class: "dropdown-item" do %>
                      <i class="bi bi-building me-2"></i> Suppliers
                    <% end %>
                  </li>
                <% end %>

                <%# MONITORING %>
                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">📊 MONITORING</li>
                <li>
                  <%= link_to alerts_path, class: "dropdown-item" do %>
                    <i class="bi bi-bell me-2"></i> System Alerts
                    <% if Alert.active.count > 0 %>
                      <span class="badge bg-danger ms-2"><%= Alert.active.count %></span>
                    <% end %>
                  <% end %>
                </li>
              </ul>
            </div>
          <% end %>

          <!-- ================= FINANCE (VMCOTT) - COMPLETE ================= -->
          <% if agency_code == "VMCOTT" && (is_admin || is_vmcott_finance || is_vmcott_billing) %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-cash-stack me-1"></i> Finance
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">💰 BILLING</li>
                <li>
                  <%= link_to vmcott_billing_invoices_path, class: "dropdown-item" do %>
                    <i class="bi bi-receipt me-2"></i> All Invoices
                  <% end %>
                </li>
                <li>
                  <%= link_to vmcott_billing_dashboard_path, class: "dropdown-item" do %>
                    <i class="bi bi-speedometer2 me-2"></i> Billing Dashboard
                  <% end %>
                </li>
                <li>
                  <%= link_to new_vmcott_billing_invoice_path, class: "dropdown-item" do %>
                    <i class="bi bi-plus-circle me-2"></i> Create Invoice
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">📊 REPORTS</li>
                <li>
                  <%= link_to aging_report_invoices_path, class: "dropdown-item" do %>
                    <i class="bi bi-hourglass-split me-2"></i> Invoice Aging
                  <% end %>
                </li>
                <li>
                  <%= link_to reports_invoices_path, class: "dropdown-item" do %>
                    <i class="bi bi-graph-up me-2"></i> Financial Reports
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">📋 ACCOUNTING</li>
                <li>
                  <%= link_to accounts_path, class: "dropdown-item" do %>
                    <i class="bi bi-journal me-2"></i> Chart of Accounts
                  <% end %>
                </li>
                <li>
                  <%= link_to account_transactions_path, class: "dropdown-item" do %>
                    <i class="bi bi-list me-2"></i> Transactions
                  <% end %>
                </li>
              </ul>
            </div>

          <!-- ================= FINANCE (Agencies) - COMPLETE ================= -->
          <% elsif is_financial_officer && agency_code.present? && agency_code != "VMCOTT" %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-cash-stack me-1"></i> Finance
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">💰 BILLING</li>
                <li>
                  <%= link_to invoices_path, class: "dropdown-item" do %>
                    <i class="bi bi-receipt me-2"></i> Invoices
                  <% end %>
                </li>
                <li>
                  <%= link_to aging_report_invoices_path, class: "dropdown-item" do %>
                    <i class="bi bi-hourglass-split me-2"></i> Invoice Aging
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">💳 PAYABLES</li>
                <li>
                  <%= link_to payables_path, class: "dropdown-item" do %>
                    <i class="bi bi-cash-stack me-2"></i> Accounts Payable
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">⚠️ ALERTS</li>
                <li>
                  <%= link_to alerts_path, class: "dropdown-item" do %>
                    <i class="bi bi-bell me-2"></i> View All Alerts
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">📊 DASHBOARD</li>
                <li>
                  <% if agency_code == "PTSC" %>
                    <%= link_to ptsc_finance_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Finance Dashboard
                    <% end %>
                  <% else %>
                    <%= link_to main_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-graph-up me-2"></i> Main Dashboard
                    <% end %>
                  <% end %>
                </li>
              </ul>
            </div>
          <% end %>

          <!-- ================= Driver ================= -->
          <% if is_driver %>
            <div class="dropdown nav-dd">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold nav-pill dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-bs-boundary="viewport"
                      data-bs-display="static">
                <i class="bi bi-person-badge me-1"></i> Driver
              </button>

              <ul class="dropdown-menu dropdown-menu-float">
                <li class="dropdown-section">DRIVER</li>

                <li>
                  <% if agency_code == "PTSC" %>
                    <%= link_to ptsc_driver_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i> Driver Dashboard
                    <% end %>
                  <% else %>
                    <%= link_to driver_dashboard_path, class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i> Driver Dashboard
                    <% end %>
                  <% end %>
                </li>

                <li>
                  <%= link_to my_vehicle_drivers_path, class: "dropdown-item" do %>
                    <i class="bi bi-truck me-2"></i> My Vehicle
                  <% end %>
                </li>

                <li>
                  <%= link_to my_trips_drivers_path, class: "dropdown-item" do %>
                    <i class="bi bi-map me-2"></i> My Trips
                  <% end %>
                </li>

                <li>
                  <%= link_to new_issue_drivers_path, class: "dropdown-item" do %>
                    <i class="bi bi-exclamation-diamond me-2"></i> Report Issue
                  <% end %>
                </li>
              </ul>
            </div>
          <% end %>

        </div>

        <!-- RIGHT -->
        <div class="d-flex gap-2 align-items-center">

          <%# Optional: show agency code pill for quick context %>
          <% if agency_code.present? %>
            <span class="badge nav-agency-pill">
              <i class="bi bi-building me-1"></i> <%= agency_code %>
            </span>
          <% end %>

          <%= button_to destroy_user_session_path,
            method: :delete,
            class: "btn btn-sm btn-outline-danger rounded-pill px-3 py-2 fw-semibold nav-pill",
            form: { "data-turbo" => "false" } do %>
            <i class="bi bi-box-arrow-right me-1"></i> Logout
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>

