                      <span class="badge bg-success float-end"><%= @ready_for_pickup_count %></span>
                    <% end %>
                  <% end %>
                </li>

                <li><hr class="dropdown-divider"></li>
                <li class="dropdown-section">📊 REPORTS</li>
                <li>
                  <%= link_to aging_report_invoices_path, class: "dropdown-item" do %>
