<%# app/views/shared/dashboards/_vehicle_analytics.html.erb %>
<div class="card">
  <div class="card-header">
    <h5 class="mb-0">
      <i class="bi bi-graph-up me-2"></i>
      Vehicle Usage Analytics
    </h5>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-3">
        <div class="text-center">
          <div class="display-6 fw-bold text-primary"><%= analytics[:total_distance].round(1) %></div>
          <small class="text-muted">Total Distance (km)</small>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="display-6 fw-bold text-success"><%= analytics[:average_utilization] %>%</div>
          <small class="text-muted">Avg Utilization</small>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="display-6 fw-bold text-warning">$<%= analytics[:fuel_consumption].round(2) %></div>
          <small class="text-muted">Monthly Fuel Cost</small>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="display-6 fw-bold text-danger">$<%= analytics[:maintenance_cost].round(2) %></div>
          <small class="text-muted">Maintenance Cost</small>
        </div>
      </div>
    </div>
  </div>
</div>