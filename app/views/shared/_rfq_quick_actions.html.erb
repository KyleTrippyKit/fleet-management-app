<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title mb-3">Request Quotation</h5>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to "New RFQ", new_agency_rfq_path(current_user.agency_id), class: "btn btn-primary" %>
      <%= link_to "Received Quotations", quotations_received_path, class: "btn btn-outline-primary" %>
      <%= link_to "Purchase Orders", purchase_orders_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Invoices", invoices_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Aging Report", invoices_aging_report_path, class: "btn btn-outline-secondary" if respond_to?(:invoices_aging_report_path) %>
    </div>
  </div>
</div>
