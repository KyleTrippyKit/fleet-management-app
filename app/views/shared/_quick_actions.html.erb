<%# app/views/shared/_quick_actions.html.erb %>
<div class="dropdown">
  <button class="btn btn-primary rounded-circle position-fixed bottom-0 end-0 m-4" 
          style="width: 60px; height: 60px;" 
          data-bs-toggle="dropdown">
    <i class="bi bi-plus-lg"></i>
  </button>
  <ul class="dropdown-menu dropdown-menu-end">
    <li><h6 class="dropdown-header">Quick Actions</h6></li>
    <% if current_user.security_gate_officer? %>
      <li><%= link_to "Manual Entry", vmcott_security_gate_officer_manual_entry_path, class: "dropdown-item" %></li>
      <li><%= link_to "Scan QR", vmcott_security_gate_officer_scan_path, class: "dropdown-item" %></li>
    <% elsif current_user.inspector? %>
      <li><%= link_to "New Inspection", vmcott_inspector_pre_inspection_path, class: "dropdown-item" %></li>
      <li><%= link_to "QC Queue", vmcott_inspector_dashboard_path(anchor: 'qc-pending'), class: "dropdown-item" %></li>
    <% end %>
  </ul>
</div>