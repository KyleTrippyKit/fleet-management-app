<%# app/views/rfqs/index.html.erb %>
<div class="container mt-4">
  <h1>Request for Quotations</h1>
  <p class="text-muted">Manage your Requests for Quotation (RFQs)</p>
  
  <!-- Stats & Filters -->
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="btn-group" role="group">
        <%= link_to 'All RFQs', rfqs_path, 
              class: "btn btn-outline-primary #{'active' unless params[:status].present?}" %>
        <%= link_to 'Drafts', rfqs_path(status: 'draft'), 
              class: "btn btn-outline-primary #{'active' if params[:status] == 'draft'}" %>
        <%= link_to 'Submitted', rfqs_path(status: 'submitted'), 
              class: "btn btn-outline-primary #{'active' if params[:status] == 'submitted'}" %>
        <%= link_to 'Under Review', rfqs_path(status: 'under_review'), 
              class: "btn btn-outline-primary #{'active' if params[:status] == 'under_review'}" %>
        <%= link_to 'Sent', sent_rfqs_path, 
              class: "btn btn-outline-primary #{'active' if current_page?(sent_rfqs_path)}" %>
      </div>
    </div>
    <div class="col-md-4 text-end">
      <%= link_to '📝 New RFQ', new_agency_rfq_path(current_user.agency), 
            class: 'btn btn-success' %>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <% if @stats.present? %>
    <div class="row mb-4">
      <div class="col-md-12">
        <div class="card">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between">
              <div class="text-center px-3">
                <h5 class="mb-0"><%= @stats[:total] %></h5>
                <small class="text-muted">Total</small>
              </div>
              <div class="text-center px-3">
                <h5 class="mb-0 text-warning"><%= @stats[:draft] %></h5>
                <small class="text-muted">Drafts</small>
              </div>
              <div class="text-center px-3">
                <h5 class="mb-0 text-info"><%= @stats[:submitted] %></h5>
                <small class="text-muted">Submitted</small>
              </div>
              <div class="text-center px-3">
                <h5 class="mb-0 text-success"><%= @stats[:converted] || 0 %></h5>
                <small class="text-muted">Converted</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  
  <!-- Search & Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with(url: rfqs_path, method: :get, local: true, class: 'row g-3') do |f| %>
        <div class="col-md-4">
          <%= text_field_tag :search, params[:search], 
                class: 'form-control', 
                placeholder: 'Search by description or notes...' %>
        </div>
        <div class="col-md-3">
          <%= select_tag :vehicle_id, 
                options_from_collection_for_select(@vehicles || [], :id, :display_name, params[:vehicle_id]),
                include_blank: 'All Vehicles',
                class: 'form-control' %>
        </div>
        <div class="col-md-2">
          <%= date_field_tag :date_from, params[:date_from], 
                class: 'form-control', placeholder: 'From date' %>
        </div>
        <div class="col-md-2">
          <%= date_field_tag :date_to, params[:date_to], 
                class: 'form-control', placeholder: 'To date' %>
        </div>
        <div class="col-md-1">
          <%= submit_tag 'Filter', class: 'btn btn-primary w-100' %>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- RFQs Table -->
  <div class="card">
    <div class="card-header bg-white">
      <h5 class="mb-0">
        <% if params[:status].present? %>
          <%= params[:status].humanize %> RFQs
        <% else %>
          All RFQs
        <% end %>
        <span class="badge bg-secondary ms-2"><%= @rfqs.total_count %></span>
      </h5>
    </div>
    
    <div class="card-body p-0">
      <% if @rfqs.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>RFQ #</th>
                <th>Vehicle</th>
                <th>Description</th>
                <th>Status</th>
                <th>Date</th>
                <th>Response Due</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @rfqs.each do |rfq| %>
                <tr>
                  <td>
                    <strong><%= rfq.rfq_number %></strong>
                    <% if rfq.urgency == 'urgent' %>
                      <span class="badge bg-danger ms-1">URGENT</span>
                    <% end %>
                  </td>
                  <td>
                    <%= rfq.vehicle&.license_plate || 'No Vehicle' %>
                    <br>
                    <small class="text-muted">
                      <%= rfq.vehicle&.make %> <%= rfq.vehicle&.model %>
                    </small>
                  </td>
                  <td>
                    <div class="fw-semibold"><%= truncate(rfq.description, length: 60) %></div>
                    <% if rfq.special_instructions.present? %>
                      <small class="text-muted">
                        <i class="bi bi-info-circle"></i> Has special instructions
                      </small>
                    <% end %>
                    <% if rfq.rfq_line_items.any? %>
                      <small class="text-muted d-block">
                        <i class="bi bi-list-check"></i> <%= rfq.rfq_line_items.count %> items
                      </small>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge bg-<%= rfq_status_badge(rfq.status) %>">
                      <%= rfq.status.humanize %>
                    </span>
                    <% if rfq.converted_to_quotation_id.present? %>
                      <br>
                      <small class="text-success">
                        <i class="bi bi-check-circle"></i> Converted
                      </small>
                    <% end %>
                  </td>
                  <td>
                    <%= rfq.request_date.strftime('%b %d, %Y') %>
                    <br>
                    <small class="text-muted">
                      <%= time_ago_in_words(rfq.created_at) %> ago
                    </small>
                  </td>
                  <td>
                    <% if rfq.response_due_date.present? %>
                      <%= rfq.response_due_date.strftime('%b %d') %>
                      <% if rfq.response_due_date < Date.today %>
                        <br>
                        <small class="text-danger">
                          <i class="bi bi-exclamation-triangle"></i> Overdue
                        </small>
                      <% end %>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to rfq_path(rfq), 
                            class: 'btn btn-outline-primary',
                            title: 'View RFQ' do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      
                      <% if rfq.draft? %>
                        <%= link_to edit_rfq_path(rfq), 
                              class: 'btn btn-outline-warning',
                              title: 'Edit RFQ' do %>
                          <i class="bi bi-pencil"></i>
                        <% end %>
                        <%= link_to submit_to_vmcott_rfq_path(rfq),
                              method: :post,
                              data: { 
                                confirm: 'Submit this RFQ to VMCOTT?',
                                turbo_confirm: 'Submit this RFQ to VMCOTT?'
                              },
                              class: 'btn btn-outline-success',
                              title: 'Submit to VMCOTT' do %>
                          <i class="bi bi-send"></i>
                        <% end %>
                      <% end %>
                      
                      <% if rfq.submitted? && current_user.agency&.code == 'VMCOTT' %>
                        <%= link_to convert_from_rfq_quotations_path(rfq.id),
                              class: 'btn btn-sm btn-outline-success',
                              data: { turbo: false } do %>
                          <i class="fas fa-exchange-alt"></i> Convert to Quotation
                        <% end %>
                      <% end %>
                    </div>
                    
                    <!-- Quick Actions Dropdown -->
                    <div class="dropdown d-inline-block ms-1">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                              type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <li>
                          <%= link_to 'View Details', rfq_path(rfq), 
                                class: 'dropdown-item' %>
                        </li>
                        <% if rfq.draft? %>
                          <li>
                            <%= link_to 'Duplicate', clone_rfq_path(rfq), 
                                  class: 'dropdown-item' %>
                          </li>
                        <% end %>
                        <% if rfq.submitted? && current_user.agency&.code == 'VMCOTT' %>
                          <li>
                            <%= link_to 'Acknowledge Receipt', 
                                  acknowledge_receipt_rfq_path(rfq),
                                  method: :post,
                                  class: 'dropdown-item' %>
                          </li>
                        <% end %>
                        <% if rfq.draft? %>
                          <li><hr class="dropdown-divider"></li>
                          <li>
                            <%= link_to 'Delete', rfq_path(rfq),
                                  method: :delete,
                                  data: { 
                                    confirm: 'Delete this RFQ?',
                                    turbo_confirm: 'Delete this RFQ?'
                                  },
                                  class: 'dropdown-item text-danger' %>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="mb-3">
            <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
          </div>
          <h5>No RFQs found</h5>
          <p class="text-muted">
            <% if params[:search].present? || params[:status].present? %>
              Try changing your filters or
            <% end %>
            <%= link_to 'create your first RFQ', new_agency_rfq_path(current_user.agency) %>
          </p>
        </div>
      <% end %>
    </div>
    
    <!-- Pagination -->
    <% if @rfqs.total_pages > 1 %>
      <div class="card-footer bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-muted">
              Showing <%= @rfqs.offset_value + 1 %> to 
              <%= @rfqs.offset_value + @rfqs.length %> of 
              <%= @rfqs.total_count %> entries
            </small>
          </div>
          <div>
            <%= paginate @rfqs, theme: 'bootstrap-5' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <!-- Help Section -->
  <div class="card mt-4">
    <div class="card-header">
      <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>RFQ Workflow Guide</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div class="text-center mb-3">
            <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center" 
                 style="width: 60px; height: 60px;">
              <i class="bi bi-pencil fs-4 text-primary"></i>
            </div>
            <h6 class="mt-2 mb-1">1. Create Draft</h6>
            <p class="text-muted small">Create RFQ with required items</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center mb-3">
            <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center" 
                 style="width: 60px; height: 60px;">
              <i class="bi bi-send fs-4 text-warning"></i>
            </div>
            <h6 class="mt-2 mb-1">2. Submit to VMCOTT</h6>
            <p class="text-muted small">Submit RFQ for quotation</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center mb-3">
            <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex align-items-center justify-content-center" 
                 style="width: 60px; height: 60px;">
              <i class="bi bi-file-earmark-text fs-4 text-info"></i>
            </div>
            <h6 class="mt-2 mb-1">3. VMCOTT Creates Quote</h6>
            <p class="text-muted small">VMCOTT prepares quotation with prices</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-center mb-3">
            <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center" 
                 style="width: 60px; height: 60px;">
              <i class="bi bi-check-circle fs-4 text-success"></i>
            </div>
            <h6 class="mt-2 mb-1">4. Review & Accept</h6>
            <p class="text-muted small">Review quotation and accept items</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Helper method for status badges %>
<% def rfq_status_badge(status) 
  case status
  when 'draft' then 'secondary'
  when 'submitted' then 'warning'
  when 'under_review' then 'info'
  when 'converted' then 'success'
  when 'cancelled' then 'danger'
  else 'secondary'
  end
end %>