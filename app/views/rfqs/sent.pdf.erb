<%# app/views/rfqs/sent.pdf.erb - Improved Export PDF %>

<%
  # Set page title
  @page_title = "Sent RFQs Report - #{Date.today.strftime('%d/%m/%Y')}"
%>

<!-- Main Content -->
<div class="document-header">
  <h1>Sent RFQs Report</h1>
  <h2>PTSC → VMCOTT</h2>
  <p>Generated: <%= Time.now.strftime("%d/%m/%Y %I:%M %p") %></p>
</div>

<% if @rfqs.any? %>
  <!-- Stats Summary - Like individual PDF -->
  <div class="section no-break">
    <div class="section-header" style="background-color: #f8f9fa; padding: 10px 15px; border: 1px solid #dee2e6;">
      <h3 style="margin: 0; font-size: 16px; color: #DA291C;">Summary</h3>
    </div>
    <div class="section-body" style="border: 1px solid #dee2e6; padding: 15px;">
      <div style="display: flex; gap: 20px; margin-bottom: 15px;">
        <div style="flex: 1; border: 1px solid #dee2e6; padding: 10px; border-radius: 4px; background-color: #f8f9fa;">
          <strong style="font-size: 10px; color: #495057; display: block; margin-bottom: 5px;">TOTAL RFQS</strong>
          <span style="font-size: 24px; font-weight: bold; color: #0033a0;"><%= @rfqs.total_count %></span>
        </div>
        <div style="flex: 1; border: 1px solid #dee2e6; padding: 10px; border-radius: 4px; background-color: #f8f9fa;">
          <strong style="font-size: 10px; color: #495057; display: block; margin-bottom: 5px;">GENERATED</strong>
          <span style="font-size: 14px; font-weight: bold;"><%= Date.today.strftime("%d %B %Y") %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- RFQs Table -->
  <div class="section no-break">
    <div class="section-header" style="background-color: #f8f9fa; padding: 10px 15px; border: 1px solid #dee2e6;">
      <h3 style="margin: 0; font-size: 16px; color: #DA291C;">RFQ Details</h3>
    </div>
    <div class="section-body" style="border: 1px solid #dee2e6; padding: 0;">
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background-color: #e9ecef;">
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: left; font-size: 11px;">RFQ #</th>
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: left; font-size: 11px;">Vehicle</th>
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: left; font-size: 11px;">Description</th>
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: center; font-size: 11px;">Sent Date</th>
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: center; font-size: 11px;">Due Date</th>
            <th style="border: 1px solid #dee2e6; padding: 8px; text-align: center; font-size: 11px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @rfqs.each do |rfq| %>
            <% is_overdue = rfq.response_overdue? %>
            <tr>
              <td style="border: 1px solid #dee2e6; padding: 8px;">
                <strong><%= rfq.rfq_number %></strong>
              </td>
              <td style="border: 1px solid #dee2e6; padding: 8px;">
                <%= rfq.vehicle&.license_plate || 'N/A' %>
                <% if rfq.vehicle.present? %>
                  <br><span style="color: #6c757d; font-size: 10px;">
                    <%= rfq.vehicle.make %> <%= rfq.vehicle.model %>
                  </span>
                <% end %>
              </td>
              <td style="border: 1px solid #dee2e6; padding: 8px;">
                <%= truncate(rfq.description, length: 50) %>
                <% if rfq.special_instructions.present? %>
                  <br><span style="color: #6c757d; font-size: 9px;">
                    <em>Special instructions</em>
                  </span>
                <% end %>
              </td>
              <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">
                <%= rfq.request_date.strftime('%d/%m/%y') %>
              </td>
              <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">
                <% if rfq.response_due_date.present? %>
                  <%= rfq.response_due_date.strftime('%d/%m/%y') %>
                  <% if is_overdue %>
                    <br><span style="background-color: #dc3545; color: white; padding: 2px 6px; border-radius: 4px; font-size: 8px; display: inline-block; margin-top: 4px;">Overdue</span>
                  <% end %>
                <% else %>
                  <span style="color: #6c757d;">—</span>
                <% end %>
              </td>
              <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">
                <% 
                  status_bg = case rfq.status
                  when 'draft' then '#6c757d'
                  when 'sent', 'submitted' then '#17a2b8'
                  when 'under_review' then '#ffc107'
                  when 'quoted', 'accepted' then '#28a745'
                  when 'rejected' then '#dc3545'
                  else '#6c757d'
                  end
                %>
                <span style="background-color: <%= status_bg %>; color: white; padding: 4px 8px; border-radius: 4px; font-size: 10px; display: inline-block;">
                  <%= rfq.status.humanize %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Footer -->
  <div style="margin-top: 30px; padding-top: 10px; border-top: 1px solid #ccc; font-size: 9px; color: #666; text-align: center;">
    <p>Total RFQs: <%= @rfqs.total_count %> • PTSC Procurement • Trinidad & Tobago</p>
  </div>

<% else %>
  <div style="text-align: center; padding: 50px;">
    <p>No sent RFQs found matching your criteria.</p>
  </div>
<% end %>