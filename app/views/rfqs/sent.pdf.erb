<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Sent RFQs Report - <%= Date.today.strftime("%d/%m/%Y") %></title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 11px; margin: 20px; }
    h1 { color: #DA291C; font-size: 18px; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
    th { background-color: #f5f5f5; font-weight: bold; }
    .footer { margin-top: 30px; font-size: 9px; color: #666; text-align: center; }
  </style>
</head>
<body>
  <h1>Sent RFQs Report - <%= Date.today.strftime("%d/%m/%Y") %></h1>
  
  <% if @rfqs.any? %>
    <table>
      <thead>
        <tr>
          <th>RFQ #</th>
          <th>Vehicle</th>
          <th>Description</th>
          <th>Sent Date</th>
          <th>Due Date</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @rfqs.each do |rfq| %>
          <tr>
            <td><%= rfq.rfq_number %></td>
            <td><%= rfq.vehicle&.license_plate || 'N/A' %></td>
            <td><%= truncate(rfq.description, length: 40) %></td>
            <td><%= rfq.request_date.strftime('%d/%m/%y') %></td>
            <td><%= rfq.response_due_date.present? ? rfq.response_due_date.strftime('%d/%m/%y') : 'Not set' %></td>
            <td><%= rfq.status.humanize %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    
    <div class="footer">
      <p>Generated: <%= Time.now.strftime("%d/%m/%Y %I:%M %p") %></p>
      <p>Total: <%= @rfqs.total_count %> RFQs sent</p>
    </div>
  <% else %>
    <p>No sent RFQs found</p>
  <% end %>
</body>
</html>