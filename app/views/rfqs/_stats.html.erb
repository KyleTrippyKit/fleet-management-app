<div class="row mb-4">
  <div class="col-md-2">
    <div class="card bg-primary text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Total</h5>
        <h2 class="display-6"><%= stats[:total] %></h2>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <div class="card bg-info text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Submitted</h5>
        <h2 class="display-6"><%= stats[:submitted] %></h2>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <div class="card bg-warning text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Under Review</h5>
        <h2 class="display-6"><%= stats[:under_review] %></h2>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <div class="card bg-success text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Converted</h5>
        <h2 class="display-6"><%= stats[:converted] %></h2>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <div class="card bg-danger text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Rejected</h5>
        <h2 class="display-6"><%= stats[:rejected] %></h2>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <div class="card bg-secondary text-white">
      <div class="card-body text-center">
        <h5 class="card-title">Draft</h5>
        <h2 class="display-6"><%= stats[:draft] %></h2>
      </div>
    </div>
  </div>
</div>