<h1>Convert RFQ #<%= @rfq.id %> to Quotation</h1>

<%= form_with url: convert_to_quotation_rfq_path(@rfq), method: :post do |f| %>
  <div>
    <h3>RFQ Details:</h3>
    <p><strong>Description:</strong> <%= @rfq.description %></p>
    <p><strong>Agency:</strong> <%= @rfq.agency.name %></p>
    
    <h4>Items:</h4>
    <ul>
      <% @rfq.rfq_line_items.each do |item| %>
        <li><%= item.quantity %> x <%= item.description %></li>
      <% end %>
    </ul>
  </div>
  
  <div class="actions">
    <%= f.submit 'Convert to Quotation', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', rfq_path(@rfq), class: 'btn btn-secondary' %>
  </div>
<% end %>