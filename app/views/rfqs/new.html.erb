<%# app/views/rfqs/new.html.erb – PTSC NEW RFQ REQUEST (TRINIDAD & TOBAGO THEME) %>

<%
  # TT Flag colors
  tt_red = "#c8102e"
  tt_white = "#ffffff"
  tt_black = "#000000"
  ptsc_yellow = "#ffb81c"
  ptsc_blue = "#0033a0"
  
  agency_code = current_user&.agency&.code.to_s.upcase
%>

<!-- Font Awesome 6 (Free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="ptsc-rfq-new container-fluid py-4 px-4">

  <!-- HEADER - PTSC STYLE WITH FLAG -->
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4">
    <div>
      <div class="d-flex align-items-center gap-3 mb-2">
        <!-- TT Flag Stripe Accent -->
        <div class="tt-flag-stripe">
          <div class="stripe-red"></div>
          <div class="stripe-white"></div>
          <div class="stripe-black"></div>
        </div>
        <!-- PTSC Logo Circle with RFQ ICON -->
        <div class="ptsc-tt-logo-wrapper">
          <div class="ptsc-tt-logo">
            <i class="fas fa-file-invoice fa-2x"></i>
          </div>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h1 class="display-6 fw-bold mb-0 ptsc-tt-title">New RFQ Request</h1>
            <span class="tt-flag-badge">Trinidad & Tobago</span>
          </div>
          <div class="d-flex align-items-center gap-3 mt-1">
            <span class="text-muted"><i class="fas fa-file-signature me-1"></i> PTSC → VMCOTT</span>
            <span class="vr"></span>
            <span class="text-muted">
              <i class="far fa-clock me-1"></i><%= Time.current.strftime("%H:%M") %>
            </span>
            <span class="vr"></span>
            <span class="text-ptsc-blue fw-medium">
              <i class="fas fa-bus me-1"></i> <%= @vehicles.count %> vehicles
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= form_with(model: [@agency, @rfq], local: true, class: "ptsc-rfq-form") do |f| %>
    
    <!-- Show validation errors - PTSC STYLE -->
    <% if @rfq.errors.any? %>
      <div class="ptsc-critical-alert mb-4">
        <div class="d-flex align-items-center">
          <div class="alert-icon me-3">
            <i class="fas fa-exclamation-triangle fa-2x" style="color: <%= tt_red %>;"></i>
          </div>
          <div>
            <h5 class="fw-bold mb-1" style="color: <%= tt_red %>;"><%= pluralize(@rfq.errors.count, "error") %> prevented this RFQ from being saved:</h5>
            <ul class="mb-0 text-muted">
              <% @rfq.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
    
    <!-- REQUEST DETAILS CARD -->
    <div class="ptsc-filter-card card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-transparent pt-4 px-4">
        <div class="d-flex align-items-center gap-2">
          <div class="ptsc-icon-circle-sm bg-ptsc-blue-light">
            <i class="fas fa-clipboard-list text-ptsc-blue"></i>
          </div>
          <h5 class="fw-bold mb-0">Request Details</h5>
          <span class="tt-flag-mini ms-2">
            <span class="flag-red"></span>
            <span class="flag-white"></span>
            <span class="flag-black"></span>
          </span>
        </div>
      </div>
      <div class="card-body p-4">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="form-group">
              <%= f.label :title, "Title/Description", class: "form-label small fw-semibold text-muted" %>
              <div class="ptsc-search-group">
                <span class="ptsc-search-icon">
                  <i class="fas fa-heading" style="color: <%= ptsc_blue %>;"></i>
                </span>
                <%= f.text_field :title, class: 'ptsc-search-input form-control', required: true,
                      placeholder: "e.g., Engine Oil Change Service" %>
              </div>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="form-group">
              <%= f.label :vehicle_id, "Vehicle", class: "form-label small fw-semibold text-muted" %>
              <div class="ptsc-select-wrapper">
                <%= f.collection_select :vehicle_id, @vehicles, :id, :display_name, 
                      { include_blank: "Select Vehicle" }, 
                      { class: 'ptsc-select form-control', required: true, id: 'vehicle-select' } %>
                <i class="fas fa-chevron-down select-arrow"></i>
              </div>
              <!-- Vehicle Search Helper -->
              <div class="mt-2">
                <div class="ptsc-search-group" style="width: 100%;">
                  <span class="ptsc-search-icon">
                    <i class="fas fa-search" style="color: <%= ptsc_blue %>;"></i>
                  </span>
                  <input type="text" id="vehicle-search" class="ptsc-search-input form-control" 
                         placeholder="Type to search vehicles..." autocomplete="off">
                </div>
                <div class="small text-muted mt-1">
                  <i class="fas fa-info-circle me-1"></i> Search by plate, make, model, or owner
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="row g-4 mt-2">
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :request_date, "Request Date", class: "form-label small fw-semibold text-muted" %>
              <div class="ptsc-search-group">
                <span class="ptsc-search-icon">
                  <i class="fas fa-calendar" style="color: <%= ptsc_blue %>;"></i>
                </span>
                <%= f.date_field :request_date, class: 'ptsc-search-input form-control', required: true,
                      value: Date.today %>
              </div>
            </div>
          </div>
          
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :response_due_date, "Response Due Date (Optional)", class: "form-label small fw-semibold text-muted" %>
              <div class="ptsc-search-group">
                <span class="ptsc-search-icon">
                  <i class="fas fa-calendar-check" style="color: <%= ptsc_blue %>;"></i>
                </span>
                <%= f.date_field :response_due_date, class: 'ptsc-search-input form-control',
                      value: Date.today + 7.days %>
              </div>
            </div>
          </div>
          
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :urgency, "Urgency", class: "form-label small fw-semibold text-muted" %>
              <div class="ptsc-select-wrapper">
                <%= f.select :urgency, 
                      [['Normal', 'normal'], ['High', 'high'], ['Urgent', 'urgent']],
                      {}, class: 'ptsc-select form-control' %>
                <i class="fas fa-chevron-down select-arrow"></i>
              </div>
            </div>
          </div>
        </div>
        
        <div class="form-group mt-4">
          <%= f.label :description, "Detailed Description", class: "form-label small fw-semibold text-muted" %>
          <%= f.text_area :description, class: 'form-control ptsc-textarea', rows: 4,
                placeholder: "Detailed description of the maintenance or repair work needed..." %>
        </div>
        
        <div class="form-group mt-4">
          <%= f.label :special_instructions, "Special Instructions (Optional)", class: "form-label small fw-semibold text-muted" %>
          <%= f.text_area :special_instructions, class: 'form-control ptsc-textarea', rows: 2,
                placeholder: "Any special requirements, timing constraints, or specific instructions..." %>
        </div>
      </div>
    </div>
    
    <!-- FORM ACTIONS -->
    <div class="d-flex justify-content-between">
      <%= link_to sent_rfqs_path, class: "ptsc-clear-btn px-4 py-3" do %>
        <i class="fas fa-times me-2"></i> Cancel
      <% end %>
      
      <div class="d-flex gap-2">
        <%= f.submit 'Save as Draft', name: 'save_draft', class: "ptsc-outline-btn px-4 py-3" %>
        <%= f.submit 'Submit to VMCOTT', name: 'submit_to_vmcott', class: "ptsc-primary-btn px-4 py-3" %>
      </div>
    </div>
  <% end %>
  
  <!-- PTSC RFQ Footer -->
  <div class="ptsc-rfq-footer mt-5">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span class="tt-flag-stripe-small">
          <span class="stripe-red"></span>
          <span class="stripe-white"></span>
          <span class="stripe-black"></span>
        </span>
        <span class="small text-muted">
          <i class="fas fa-file-invoice me-1" style="color: <%= ptsc_blue %>;"></i> 
          PTSC Procurement • <%= Date.today.strftime("%B %d, %Y") %>
        </span>
      </div>
      <span class="tt-footer-emblem">
        <i class="fas fa-file-invoice me-1"></i> 🇹🇹
      </span>
    </div>
  </div>
</div>

<!-- JavaScript for Vehicle Search -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('vehicle-search');
  const vehicleSelect = document.getElementById('vehicle-select');
  
  if (!searchInput || !vehicleSelect) return;
  
  // Store all original options
  const originalOptions = Array.from(vehicleSelect.options);
  
  searchInput.addEventListener('keyup', function() {
    const searchTerm = this.value.toLowerCase().trim();
    
    // Clear current options
    vehicleSelect.innerHTML = '';
    
    if (searchTerm === '') {
      // Restore all options
      originalOptions.forEach(option => {
        vehicleSelect.appendChild(option.cloneNode(true));
      });
    } else {
      // Filter and add matching options
      const matchingOptions = originalOptions.filter(option => {
        const optionText = option.text.toLowerCase();
        return optionText.includes(searchTerm) || option.value === ''; // Always keep the blank option
      });
      
      // Add blank option first
      const blankOption = originalOptions.find(opt => opt.value === '');
      if (blankOption) {
        vehicleSelect.appendChild(blankOption.cloneNode(true));
      }
      
      // Add matching options
      matchingOptions.forEach(option => {
        if (option.value !== '') { // Skip blank option as we already added it
          vehicleSelect.appendChild(option.cloneNode(true));
        }
      });
      
      // If no matches found (besides blank), show a message
      if (matchingOptions.length === 0 || (matchingOptions.length === 1 && matchingOptions[0].value === '')) {
        const noResultsOption = document.createElement('option');
        noResultsOption.disabled = true;
        noResultsOption.textContent = 'No vehicles found';
        vehicleSelect.appendChild(noResultsOption);
      }
    }
    
    // Preserve selected value if it still exists in the new options
    const selectedValue = vehicleSelect.getAttribute('data-selected') || '';
    if (selectedValue && Array.from(vehicleSelect.options).some(opt => opt.value === selectedValue)) {
      vehicleSelect.value = selectedValue;
    }
  });
  
  // Store selected value when it changes
  vehicleSelect.addEventListener('change', function() {
    this.setAttribute('data-selected', this.value);
  });
  
  // Clear search when a vehicle is selected (optional)
  vehicleSelect.addEventListener('change', function() {
    if (this.value) {
      // You can choose to clear the search or leave it
      // searchInput.value = '';
    }
  });
});
</script>

<style>
/* ============================================================
   PTSC NEW RFQ REQUEST - TRINIDAD & TOBAGO THEME
   ============================================================ */

.ptsc-rfq-new {
  background: linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);
  min-height: 100vh;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* TT Flag Stripe */
.tt-flag-stripe {
  display: flex;
  flex-direction: column;
  width: 8px;
  height: 56px;
  border-radius: 4px;
  overflow: hidden;
}

.stripe-red { background-color: #c8102e; }
.stripe-white { 
  background-color: #ffffff;
  border-top: 1px solid #e0e0e0;
  border-bottom: 1px solid #e0e0e0;
}
.stripe-black { background-color: #000000; }

/* TT Flag Indicators */
.tt-flag-indicator {
  display: inline-flex;
  gap: 3px;
  align-items: center;
}

.tt-dot-red {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #c8102e;
}

.tt-dot-white {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
}

.tt-dot-black {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #000000;
}

.tt-flag-mini {
  display: inline-flex;
  gap: 2px;
  align-items: center;
}

.flag-red, .flag-white, .flag-black {
  width: 12px;
  height: 12px;
}

.flag-red { background-color: #c8102e; }
.flag-white { 
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
}
.flag-black { background-color: #000000; }

/* PTSC Logo */
.ptsc-tt-logo-wrapper {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  background: linear-gradient(135deg, #ffb81c 0%, #ffd700 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 16px rgba(255, 184, 28, 0.15);
}

.ptsc-tt-logo {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #0033a0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffb81c;
}

.ptsc-tt-title {
  color: #0033a0;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.tt-flag-badge {
  background: linear-gradient(90deg, #c8102e 0%, #000000 50%, #c8102e 100%);
  color: white;
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.text-ptsc-blue {
  color: #0033a0 !important;
}

/* Critical Alert (for errors) */
.ptsc-critical-alert {
  background: rgba(200, 16, 46, 0.05);
  border-left: 4px solid #c8102e;
  border-radius: 16px;
  padding: 1.25rem;
}

.alert-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(200, 16, 46, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Buttons */
.ptsc-primary-btn {
  background: linear-gradient(135deg, #ffb81c 0%, #ffd700 100%);
  color: #0033a0 !important;
  border: none;
  padding: 0.6rem 1.2rem;
  border-radius: 100px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(255, 184, 28, 0.2);
}

.ptsc-primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(255, 184, 28, 0.3);
  color: #0033a0 !important;
  background: linear-gradient(135deg, #ffd700 0%, #ffb81c 100%);
}

.ptsc-outline-btn {
  background: white;
  color: #0033a0 !important;
  border: 1px solid rgba(0, 51, 160, 0.2);
  padding: 0.6rem 1.2rem;
  border-radius: 100px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: all 0.2s ease;
}

.ptsc-outline-btn:hover {
  background: rgba(0, 51, 160, 0.04);
  border-color: #0033a0;
  color: #0033a0 !important;
}

.ptsc-clear-btn {
  background: white;
  color: #6c757d;
  border: 1px solid rgba(0, 0, 0, 0.1);
  padding: 0.6rem 1.5rem;
  border-radius: 100px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48px;
}

.ptsc-clear-btn:hover {
  background: #f8f9fa;
  color: #6c757d;
}

/* Icon Circles */
.ptsc-icon-circle-sm {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bg-ptsc-blue-light {
  background: rgba(0, 51, 160, 0.08);
}

/* Filter Card (used for form sections) */
.ptsc-filter-card {
  border: 1px solid rgba(0, 51, 160, 0.08) !important;
}

/* Form Elements */
.ptsc-search-group {
  position: relative;
  display: flex;
  align-items: center;
}

.ptsc-search-icon {
  position: absolute;
  left: 16px;
  z-index: 10;
}

.ptsc-search-input {
  padding-left: 48px !important;
  border-radius: 100px !important;
  border: 1px solid rgba(0, 51, 160, 0.15) !important;
  height: 48px;
}

.ptsc-search-input:focus {
  border-color: #0033a0 !important;
  box-shadow: 0 0 0 3px rgba(0, 51, 160, 0.1) !important;
}

.ptsc-textarea {
  border-radius: 16px !important;
  border: 1px solid rgba(0, 51, 160, 0.15) !important;
  padding: 0.75rem 1rem;
}

.ptsc-textarea:focus {
  border-color: #0033a0 !important;
  box-shadow: 0 0 0 3px rgba(0, 51, 160, 0.1) !important;
}

.ptsc-select-wrapper {
  position: relative;
}

.ptsc-select {
  border-radius: 100px !important;
  border: 1px solid rgba(0, 51, 160, 0.15) !important;
  height: 48px;
  padding-right: 40px;
  appearance: none;
}

.ptsc-select:focus {
  border-color: #0033a0 !important;
  box-shadow: 0 0 0 3px rgba(0, 51, 160, 0.1) !important;
}

.select-arrow {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: #0033a0;
  pointer-events: none;
}

/* Footer */
.ptsc-rfq-footer {
  padding: 1rem 0;
  border-top: 1px solid rgba(0, 51, 160, 0.1);
}

.tt-flag-stripe-small {
  display: flex;
  gap: 2px;
}

.tt-flag-stripe-small .stripe-red,
.tt-flag-stripe-small .stripe-white,
.tt-flag-stripe-small .stripe-black {
  width: 4px;
  height: 24px;
  border-radius: 1px;
}

.tt-footer-emblem {
  font-size: 1.2rem;
  opacity: 0.7;
}

/* Form Labels */
.form-label {
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

/* Responsive */
@media (max-width: 768px) {
  .d-flex.gap-2 {
    flex-wrap: wrap;
  }
  
  .ptsc-primary-btn, .ptsc-outline-btn, .ptsc-clear-btn {
    width: 100%;
    margin-bottom: 0.5rem;
  }
}

/* Import Inter Font */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
</style>