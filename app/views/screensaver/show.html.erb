</style>

<!-- Keep all the JavaScript -->
<script>
  // Update time every second
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('en-US', { 
      hour: '2-digit', 
      minute: '2-digit',
      second: '2-digit',
      hour12: true 
    });
    const dateString = now.toLocaleDateString('en-US', { 
      month: 'short', 
      day: 'numeric',
      year: 'numeric'
    });
    const timeElement = document.getElementById('currentTime');
    if (timeElement) {
      timeElement.innerHTML = `${dateString} | ${timeString}`;
    }
  }
  
  updateTime();
  setInterval(updateTime, 1000);
  
  // Exit screensaver function
  let isRedirecting = false;
  
  function exitScreensaver() {
    if (!isRedirecting) {
      isRedirecting = true;
      <% if user_signed_in? %>
        window.location.href = '/';
      <% else %>
        window.location.href = '/users/sign_in';
      <% end %>
    }
  }
  
  // Any click returns to appropriate page
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.touch-to-start') && !isRedirecting) {
      isRedirecting = true;
      <% if user_signed_in? %>
        window.location.href = '/';
      <% else %>
        window.location.href = '/users/sign_in';
      <% end %>
    }
  });
  
  // Also return on keypress
  document.addEventListener('keypress', function(e) {
    if (!isRedirecting && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
      isRedirecting = true;
      <% if user_signed_in? %>
        window.location.href = '/';
      <% else %>
        window.location.href = '/users/sign_in';
      <% end %>
    }
  });
  
  // Prevent any default form submissions
  document.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!isRedirecting) {
      isRedirecting = true;
      <% if user_signed_in? %>
        window.location.href = '/';
      <% else %>
        window.location.href = '/users/sign_in';
      <% end %>
    }
  });
</script>