<%# app/views/screensaver/show.html.erb %>

<!-- Animated Particles -->
<div class="particles">
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
</div>

<!-- Grid Overlay -->
<div class="grid-overlay"></div>

<!-- Screensaver Content -->
<div class="screensaver" id="screensaver">
  
  <!-- Header with Time -->
  <div class="screensaver-header">
    <div></div> <!-- Spacer -->
    <div class="time-display" id="currentTime"></div>
  </div>

  <!-- Floating Messages Container - ON THE SIDES ONLY -->
  <div class="floating-messages">
    <% if @recent_activities.present? %>
      <% @recent_activities.each_with_index do |activity, index| %>
        <% case index % 6 %>
        <% when 0 %>
          <div class="floating-message top-left">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% when 1 %>
          <div class="floating-message top-right">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% when 2 %>
          <div class="floating-message mid-left">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% when 3 %>
          <div class="floating-message mid-right">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% when 4 %>
          <div class="floating-message bottom-left">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% when 5 %>
          <div class="floating-message bottom-right">
            <div class="message-content">
              <span class="message-dot <%= activity[:type] %>"></span>
              <span><%= truncate(activity[:message], length: 35) %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <!-- Default messages if no real data -->
      <div class="floating-message top-left">
        <div class="message-content">
          <span class="message-dot info"></span>
          <span>System Online • All Services Operational</span>
        </div>
      </div>
      
      <div class="floating-message bottom-right">
        <div class="message-content">
          <span class="message-dot warning"></span>
          <span><%= Time.current.strftime("%b %d") %> • <%= @pending_tasks_count || 0 %> Tasks</span>
        </div>
      </div>
      
      <div class="floating-message mid-right">
        <div class="message-content">
          <span class="message-dot success"></span>
          <span>Fleet Status: 92% Operational</span>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Main Content - CENTERED, NOT BLOCKED -->
  <div class="screensaver-main">
    <div class="logo-container">
      <div class="logo-wrapper">
        <div class="logo-icon">
          <!-- Your "Active Plus" Icon -->
          <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="100" height="100" rx="20" fill="url(#gradient)" />
            <path d="M30 50H70M50 30V70" stroke="white" stroke-width="8" stroke-linecap="round"/>
            <circle cx="50" cy="50" r="15" stroke="white" stroke-width="3" fill="none"/>
            <defs>
              <linearGradient id="gradient" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4F46E5"/>
                <stop offset="1" stop-color="#7C3AED"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="logo-text">
          <h1>ACTIVE PLUS</h1>
          <p><%= @current_user&.agency&.code || 'FLEET MANAGEMENT' %></p>
        </div>
        
        <% if @current_user.present? %>
          <div class="user-greeting">
            Welcome back, <%= @current_user.name&.split&.first || 'User' %>!
          </div>
          <div class="role-badge">
            <%= @current_user.role_name %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Stats Container - Now positioned below logo, not blocking -->
    <% if @current_user.present? %>
      <div class="stats-container">
        <% if @current_user.security_gate_officer? %>
          <div class="stat-card">
            <div class="stat-number"><%= @today_checkins || 0 %></div>
            <div class="stat-label">Today's Check-ins</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @vehicles_on_site || 0 %></div>
            <div class="stat-label">Vehicles on Site</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @pending_condition_reports || 0 %></div>
            <div class="stat-label">Pending Reports</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @expected_arrivals || 0 %></div>
            <div class="stat-label">Expected</div>
          </div>
          
        <% elsif @current_user.inspector? %>
          <div class="stat-card">
            <div class="stat-number"><%= @pending_inspections || 0 %></div>
            <div class="stat-label">Pending Inspections</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @pending_qc || 0 %></div>
            <div class="stat-label">QC Queue</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @inspections_today || 0 %></div>
            <div class="stat-label">Completed Today</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @vehicles_with_issues || 0 %></div>
            <div class="stat-label">Issues Found</div>
          </div>
          
        <% elsif @current_user.inventory_manager? %>
          <div class="stat-card">
            <div class="stat-number"><%= @low_stock_items || 0 %></div>
            <div class="stat-label">Low Stock</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @parts_to_process || 0 %></div>
            <div class="stat-label">Parts to Process</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @pending_rfqs || 0 %></div>
            <div class="stat-label">RFQs Pending</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @orders_received || 0 %></div>
            <div class="stat-label">Orders Received</div>
          </div>
          
        <% elsif @current_user.procurement? %>
          <div class="stat-card">
            <div class="stat-number"><%= @rfqs_to_send || 0 %></div>
            <div class="stat-label">RFQs to Send</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @quotations_received || 0 %></div>
            <div class="stat-label">Quotations</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @pending_selection || 0 %></div>
            <div class="stat-label">To Select</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @quotes_awaiting || 0 %></div>
            <div class="stat-label">Awaiting Response</div>
          </div>
          
        <% elsif @current_user.finance? %>
          <div class="stat-card">
            <div class="stat-number"><%= number_to_currency(@receivables_total || 0, precision: 0) %></div>
            <div class="stat-label">Receivables</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= number_to_currency(@payables_total || 0, precision: 0) %></div>
            <div class="stat-label">Payables</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @overdue_invoices || 0 %></div>
            <div class="stat-label">Overdue</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= number_to_currency(@monthly_profit || 0, precision: 0) %></div>
            <div class="stat-label">Monthly P&L</div>
          </div>
          
        <% elsif @current_user.mechanic? %>
          <div class="stat-card">
            <div class="stat-number"><%= @assigned_jobs || 0 %></div>
            <div class="stat-label">My Jobs</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @available_jobs || 0 %></div>
            <div class="stat-label">Available</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @in_progress || 0 %></div>
            <div class="stat-label">In Progress</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @completed_today || 0 %></div>
            <div class="stat-label">Completed</div>
          </div>
          
        <% elsif @current_user.admin? %>
          <div class="stat-card">
            <div class="stat-number"><%= @total_users || 0 %></div>
            <div class="stat-label">Active Users</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @total_vehicles || 0 %></div>
            <div class="stat-label">Total Vehicles</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @active_maintenance || 0 %></div>
            <div class="stat-label">In Maintenance</div>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= @system_uptime || '99.9%' %></div>
            <div class="stat-label">System Health</div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Public Stats -->
      <div class="stats-container">
        <div class="stat-card">
          <div class="stat-number"><%= number_with_delimiter(Vehicle.count) %></div>
          <div class="stat-label">Fleet Size</div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= number_with_delimiter(User.where(role: 'mechanic').count) %></div>
          <div class="stat-label">Service Team</div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= Time.current.year %></div>
          <div class="stat-label">© Active Plus</div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= Time.current.strftime("%H:%M") %></div>
          <div class="stat-label">Local Time</div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Trust Badges -->
  <div class="trust-badges">
    <p>Trusted by leading government agencies</p>
    <div class="badge-group">
      <span class="trust-icon">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Government
      </span>
      <span class="trust-icon">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Public Sector
      </span>
      <span class="trust-icon">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Municipal
      </span>
    </div>
  </div>

  <!-- Touch to Start -->
  <div class="touch-to-start" onclick="exitScreensaver()">
    👆 TOUCH TO START
  </div>
</div>

<!-- Keep all the styles -->
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background: radial-gradient(circle at 20% 30%, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    overflow: hidden;
    position: relative;
  }

  /* Animated Particles Background */
  .particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .particle {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    pointer-events: none;
    animation: float 15s infinite ease-in-out;
  }

  .particle:nth-child(1) { width: 150px; height: 150px; top: 10%; left: 5%; animation-delay: 0s; }
  .particle:nth-child(2) { width: 100px; height: 100px; top: 60%; left: 80%; animation-delay: 2s; }
  .particle:nth-child(3) { width: 200px; height: 200px; top: 70%; left: 20%; animation-delay: 4s; }
  .particle:nth-child(4) { width: 80px; height: 80px; top: 20%; left: 85%; animation-delay: 6s; }
  .particle:nth-child(5) { width: 120px; height: 120px; top: 80%; left: 60%; animation-delay: 8s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
    50% { transform: translateY(-30px) scale(1.1); opacity: 0.5; }
  }

  /* Grid Overlay */
  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: 2;
    pointer-events: none;
  }

  /* Screensaver Container */
  .screensaver {
    position: relative;
    z-index: 10;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    color: white;
    cursor: none;
  }

  /* Header section with time */
  .screensaver-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 20px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 50;
    pointer-events: none;
  }

  .time-display {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    font-weight: 300;
    background: rgba(0, 0, 0, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    letter-spacing: 1px;
  }

  /* Main content area - centered */
  .screensaver-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 20;
    padding: 20px;
    pointer-events: none;
  }

  /* Logo Container */
  .logo-container {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 20;
  }

  .logo-wrapper {
    margin-bottom: 20px;
  }

  .logo-icon {
    width: 220px;
    height: 220px;
    margin: 0 auto;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
    animation: logoGlow 4s ease-in-out infinite;
  }

  @keyframes logoGlow {
    0%, 100% { filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3)) brightness(1); }
    50% { filter: drop-shadow(0 30px 60px rgba(102, 126, 234, 0.5)) brightness(1.1); }
  }

  .logo-icon svg {
    width: 100%;
    height: 100%;
  }

  .logo-text {
    opacity: 0;
    animation: fadeInUp 1s ease-out forwards;
  }

  .logo-text h1 {
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 4px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    background: linear-gradient(135deg, #fff 0%, #e0e0ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
  }

  .logo-text p {
    font-size: 1.4rem;
    opacity: 0.9;
    letter-spacing: 3px;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    font-weight: 300;
    white-space: nowrap;
  }

  .user-greeting {
    font-size: 2rem;
    color: white;
    margin-top: 20px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    opacity: 0;
    animation: fadeInUp 1s ease-out 0.3s forwards;
  }

  .role-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: 8px 20px;
    margin-top: 10px;
    font-size: 0.9rem;
    letter-spacing: 1px;
    opacity: 0;
    animation: fadeInUp 1s ease-out 0.6s forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Stats Container */
  .stats-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    margin-top: 30px;
    perspective: 1000px;
    z-index: 30;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    padding: 25px 35px;
    min-width: 180px;
    text-align: center;
    transform-style: preserve-3d;
    animation: cardFloat 5s ease-in-out infinite;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .stat-card:nth-child(1) { animation-delay: 0s; }
  .stat-card:nth-child(2) { animation-delay: 0.5s; }
  .stat-card:nth-child(3) { animation-delay: 1s; }
  .stat-card:nth-child(4) { animation-delay: 1.5s; }

  @keyframes cardFloat {
    0%, 100% { transform: translateY(0) rotateX(0deg); }
    50% { transform: translateY(-15px) rotateX(2deg); }
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: white;
    line-height: 1;
    margin-bottom: 8px;
    text-shadow: 0 0 30px rgba(255,255,255,0.5);
  }

  .stat-label {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 400;
  }

  /* Floating Messages */
  .floating-messages {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 15;
    pointer-events: none;
  }

  .floating-message {
    position: absolute;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    padding: 10px 20px;
    color: white;
    font-size: 0.9rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    animation: messageFloat 7s ease-in-out infinite;
    pointer-events: none;
    max-width: 300px;
    white-space: nowrap;
  }

  /* Message positions */
  .floating-message.top-left { top: 100px; left: 30px; }
  .floating-message.top-right { top: 100px; right: 30px; }
  .floating-message.mid-left { top: 50%; left: 30px; transform: translateY(-50%); }
  .floating-message.mid-right { top: 50%; right: 30px; transform: translateY(-50%); }
  .floating-message.bottom-left { bottom: 150px; left: 30px; }
  .floating-message.bottom-right { bottom: 150px; right: 30px; }

  @keyframes messageFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .message-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .message-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 15px #4ade80;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }

  .message-dot.warning {
    background: #fbbf24;
    box-shadow: 0 0 15px #fbbf24;
  }

  .message-dot.critical {
    background: #ef4444;
    box-shadow: 0 0 15px #ef4444;
  }

  .message-dot.info {
    background: #3b82f6;
    box-shadow: 0 0 15px #3b82f6;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  /* Trust Badges */
  .trust-badges {
    position: absolute;
    bottom: 80px;
    left: 0;
    right: 0;
    text-align: center;
    z-index: 25;
    pointer-events: none;
  }

  .trust-badges p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .badge-group {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .trust-icon {
    display: flex;
    align-items: center;
    gap: 6px;
    color: white;
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 16px;
    border-radius: 50px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.8rem;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
  }

  .trust-icon:nth-child(1) { animation-delay: 0.2s; }
  .trust-icon:nth-child(2) { animation-delay: 0.4s; }
  .trust-icon:nth-child(3) { animation-delay: 0.6s; }

  .trust-icon:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  }

  .trust-icon svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Touch to Start Button */
  .touch-to-start {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-size: 1.1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    z-index: 40;
    padding: 16px 40px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    animation: buttonPulse 2s ease-in-out infinite;
    transition: all 0.3s ease;
    white-space: nowrap;
    pointer-events: auto;
  }

  .touch-to-start:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-50%) scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  @keyframes buttonPulse {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
  }

  /* Hide cursor */
  * {
    cursor: none;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .logo-icon {
      width: 150px;
      height: 150px;
    }

    .logo-text h1 {
      font-size: 2.8rem;
      letter-spacing: 2px;
