<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">💰 Billing Dashboard</h1>
      <p class="text-muted">VMCOTT Billing - Invoices, RFQs and Purchase Orders</p>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Pending RFQs</h5>
          <h2 class="display-4"><%= @pending_rfqs_count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Quotations Received</h5>
          <h2 class="display-4"><%= @quotations_received_count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Pending Finance Review</h5>
          <h2 class="display-4"><%= @pending_finance_review_count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Pending POs</h5>
          <h2 class="display-4"><%= @pending_pos_count || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Parts Requests Needing Billing Action -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Parts Requests Needing RFQ Creation</h5>
          <span class="badge bg-light text-dark"><%= @parts_needing_rfq&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @parts_needing_rfq && @parts_needing_rfq.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Inspection #</th>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Notified At</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts_needing_rfq.each do |pr| %>
                    <tr>
                      <td><%= link_to "##{pr.inspection.id}", vmcott_inspector_inspection_path(pr.inspection) %></td>
                      <td><%= pr.inspection.vehicle.license_plate %></td>
                      <td><%= pr.part.name %></td>
                      <td><%= pr.quantity %></td>
                      <td>
                        <span class="badge bg-<%= 
                          case pr.status
                          when 'billing_notified' then 'info'
                          when 'rfq_sent' then 'primary'
                          when 'quotations_received' then 'success'
                          else 'secondary'
                          end %>">
                          <%= pr.status.humanize %>
                        </span>
                      </td>
                      <td><%= pr.notified_billing_at&.strftime("%b %d, %Y") || 'N/A' %></td>
                      <td>
                        <% if pr.status == 'billing_notified' %>
                          <%= link_to "Create RFQ", new_vendor_rfq_path(parts_request_id: pr.id), class: "btn btn-sm btn-primary" %>
                        <% elsif pr.status == 'rfq_sent' %>
                          <span class="badge bg-info">Awaiting Quotes</span>
                        <% elsif pr.status == 'quotations_received' %>
                          <%= link_to "View Quotes", vendor_rfq_path(pr.vendor_rfq), class: "btn btn-sm btn-success" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No parts requests needing RFQ creation</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotations Received Needing Finance Review -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Quotations Received - Ready for Finance Review</h5>
          <span class="badge bg-light text-dark"><%= @quotations_received&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @quotations_received && @quotations_received.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>RFQ #</th>
                    <th>Vehicle</th>
                    <th>Supplier</th>
                    <th># of Quotes</th>
                    <th>Received</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @quotations_received.each do |rfq| %>
                    <tr>
                      <td><%= link_to rfq.rfq_number, vendor_rfq_path(rfq) %></td>
                      <td><%= rfq.vendor_rfq_items.first&.part&.name || 'Multiple Parts' %></td>
                      <td><%= rfq.vendor_quotations.map(&:supplier).compact.map(&:name).join(', ') %></td>
                      <td><span class="badge bg-info"><%= rfq.vendor_quotations.count %> quotes</span></td>
                      <td><%= rfq.updated_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <%= link_to "Review Quotes", compare_vendor_rfq_path(rfq), class: "btn btn-sm btn-warning" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No quotations ready for finance review</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Purchase Orders Pending Finance Approval -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Purchase Orders Pending Finance Approval</h5>
          <span class="badge bg-dark text-white"><%= @pending_pos&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @pending_pos && @pending_pos.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>PO #</th>
                    <th>Vendor</th>
                    <th>Amount</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_pos.each do |po| %>
                    <tr>
                      <td><%= link_to po.po_number, purchase_order_path(po) %></td>
                      <td><%= po.vendor %></td>
                      <td><%= number_to_currency(po.amount) %></td>
                      <td><%= po.purchase_order_items.count %></td>
                      <td><%= po.created_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to "Review", purchase_order_path(po), class: "btn btn-outline-primary" %>
                          <%= link_to "Approve", approve_purchase_order_path(po), method: :post, class: "btn btn-outline-success", data: { confirm: "Approve this purchase order?" } %>
                          <%= link_to "Reject", reject_purchase_order_path(po), method: :post, class: "btn btn-outline-danger", data: { confirm: "Reject this purchase order?" } %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No purchase orders pending finance approval</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Parts Received (Ready for Stock Update) -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Parts Received - Ready for Stock Update</h5>
          <span class="badge bg-light text-dark"><%= @parts_received&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @parts_received && @parts_received.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Inspection #</th>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>PO #</th>
                    <th>Received At</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts_received.each do |pr| %>
                    <tr>
                      <td><%= link_to "##{pr.inspection.id}", vmcott_inspector_inspection_path(pr.inspection) %></td>
                      <td><%= pr.inspection.vehicle.license_plate %></td>
                      <td><%= pr.part.name %></td>
                      <td><%= pr.quantity %></td>
                      <td><%= link_to pr.purchase_order.po_number, purchase_order_path(pr.purchase_order) if pr.purchase_order %></td>
                      <td><%= pr.parts_received_at&.strftime("%b %d, %Y") %></td>
                      <td>
                        <% if pr.status == 'parts_received' && !pr.in_stock %>
                          <%= button_to "Update Stock", update_stock_parts_request_path(pr), method: :post, class: "btn btn-sm btn-success", data: { confirm: "Add #{pr.quantity} #{pr.part.name} to inventory?" } %>
                        <% else %>
                          <span class="badge bg-success">Stock Updated</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No parts received awaiting stock update</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>