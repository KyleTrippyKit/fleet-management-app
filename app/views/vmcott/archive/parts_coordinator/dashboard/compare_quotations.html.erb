<%# app/views/vmcott/parts_coordinator/dashboard/compare_quotations.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">📊 Compare Quotations</h1>
          <p class="text-muted">
            RFQ #<%= @rfq.rfq_number %>
            <% if @part %>
              - <%= @part.name %>
            <% end %>
          </p>
        </div>
        <%= link_to "← Back to Dashboard", vmcott_parts_coordinator_dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Vendor Quotations</h5>
        </div>
        <div class="card-body">
          <% if @quotations.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th class="text-end">Total Amount</th>
                    <th>Notes</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @quotations.each do |quote| %>
                    <% is_lowest = quote.total_amount == @lowest_price %>
                    <% is_frequent = quote.supplier_id == @most_frequent_vendor %>
                    <tr class="<%= 'table-success' if is_lowest %> <%= 'table-info' if is_frequent && !is_lowest %>">
                      <td>
                        <strong><%= quote.supplier.name %></strong>
                        <% if is_lowest %>
                          <span class="badge bg-success ms-2">Best Price</span>
                        <% end %>
                        <% if is_frequent && !is_lowest %>
                          <span class="badge bg-info ms-2">Frequent Vendor</span>
                        <% end %>
                      </td>
                      <td><%= quote.created_at.strftime("%b %d, %Y") %></td>
                      <td class="text-end"><strong><%= number_to_currency(quote.total_amount) %></strong></td>
                      <td><%= truncate(quote.notes, length: 30) if quote.notes.present? %></td>
                      <td class="text-center">
                        <%= link_to "View Details", "#", 
                              class: "btn btn-sm btn-outline-primary me-1",
                              data: { bs_toggle: "modal", bs_target: "#quoteModal#{quote.id}" } %>
                        <%= button_to "Accept", 
                              vmcott_parts_coordinator_accept_quotation_path(quote), 
                              method: :post,
                              class: "btn btn-sm btn-success",
                              data: { confirm: "Accept this quotation and create a purchase order?" } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="2" class="text-end">Lowest Price:</th>
                    <th class="text-end"><%= number_to_currency(@lowest_price) %></th>
                    <th colspan="2"></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% else %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              No quotations have been received yet for this RFQ.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quotation Detail Modals -->
<% @quotations.each do |quote| %>
  <div class="modal fade" id="quoteModal<%= quote.id %>" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title">Quotation Details - <%= quote.supplier.name %></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <!-- Quotation Header -->
          <div class="row mb-3">
            <div class="col-md-6">
              <p><strong>Date:</strong> <%= quote.created_at.strftime("%B %d, %Y") %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Total Amount:</strong> <span class="fw-bold"><%= number_to_currency(quote.total_amount) %></span></p>
            </div>
          </div>

          <!-- Line Items -->
          <% if quote.vendor_quotation_lines.any? %>
            <h6 class="fw-bold">Line Items</h6>
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Description</th>
                  <th class="text-end">Quantity</th>
                  <th class="text-end">Unit Price</th>
                  <th class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                <% quote.vendor_quotation_lines.each do |line| %>
                  <tr>
                    <td><%= line.description || line.part&.name %></td>
                    <td class="text-end"><%= line.quantity %></td>
                    <td class="text-end"><%= number_to_currency(line.unit_price) %></td>
                    <td class="text-end"><%= number_to_currency(line.total_price) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>

          <!-- Notes -->
          <% if quote.notes.present? %>
            <div class="mt-3">
              <h6 class="fw-bold">Notes</h6>
              <p class="text-muted"><%= simple_format(quote.notes) %></p>
            </div>
          <% end %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <%= button_to "Accept Quotation", 
                vmcott_parts_coordinator_accept_quotation_path(quote), 
                method: :post,
                class: "btn btn-success",
                data: { confirm: "Accept this quotation and create a purchase order?" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>