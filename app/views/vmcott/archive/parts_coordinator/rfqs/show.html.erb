<%# app/views/vmcott/parts_coordinator/rfqs/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">📋 RFQ #<%= @rfq.rfq_number %></h1>
      <p class="text-muted">Request for Quotation Details</p>
    </div>
    <div class="col text-end">
      <%= link_to "← Back to RFQs", vmcott_parts_coordinator_rfqs_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">RFQ Information</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <tr>
              <th>RFQ Number:</th>
              <td><%= @rfq.rfq_number %></td>
            </tr>
            <tr>
              <th>Status:</th>
              <td>
                <span class="badge bg-<%= @rfq.status == 'sent' ? 'success' : 'warning' %>">
                  <%= @rfq.status.titleize %>
                </span>
              </td>
            </tr>
            <tr>
              <th>Sent Date:</th>
              <td><%= @rfq.sent_date&.strftime("%B %d, %Y") || 'Not sent' %></td>
            </tr>
            <tr>
              <th>Due Date:</th>
              <td><%= @rfq.due_date&.strftime("%B %d, %Y") || 'Not set' %></td>
            </tr>
            <tr>
              <th>Created By:</th>
              <td><%= @rfq.created_by&.name || 'System' %></td>
            </tr>
            <tr>
              <th>Created At:</th>
              <td><%= @rfq.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            </tr>
          </table>
          
          <% if @rfq.notes.present? %>
            <div class="mt-3">
              <h6>Notes:</h6>
              <p class="bg-light p-3 rounded"><%= @rfq.notes %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">Parts Requested</h5>
        </div>
        <div class="card-body">
          <% @rfq.vendor_rfq_items.each do |item| %>
            <div class="border-bottom pb-3 mb-3">
              <h6><%= item.part&.name || 'Unknown Part' %></h6>
              <p class="small text-muted mb-1">Part #: <%= item.part&.part_number || 'N/A' %></p>
              <p class="mb-1">Quantity: <strong><%= item.quantity %> <%= item.unit_of_measure %></strong></p>
              <% if item.description.present? %>
                <p class="small mb-0"><%= item.description %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotations Received -->
  <div class="card mt-2">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">Quotations Received (<%= @quotations.count %>)</h5>
    </div>
    <div class="card-body">
      <% if @quotations.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Supplier</th>
                <th>Part</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th>Received</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @quotations.each do |quote| %>
                <% quote.vendor_quotation_lines.each do |line| %>
                  <tr>
                    <td><strong><%= quote.supplier&.name || 'Unknown' %></strong></td>
                    <td><%= line.part&.name || 'Unknown' %></td>
                    <td><%= line.quantity %></td>
                    <td>$<%= number_with_precision(line.unit_price, precision: 2) %></td>
                    <td>$<%= number_with_precision(line.total_price, precision: 2) %></td>
                    <td><%= time_ago_in_words(quote.created_at) %> ago</td>
                    <td>
                      <%= link_to "Accept", 
                        accept_vendor_quotation_path(quote.id),
                        method: :post,
                        class: "btn btn-sm btn-success",
                        data: { confirm: "Accept this quotation?" } %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted text-center py-4">No quotations received yet</p>
      <% end %>
    </div>
  </div>
</div>