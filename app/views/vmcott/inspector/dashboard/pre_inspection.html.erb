<%# app/views/vmcott/inspector/dashboard/pre_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2"><i class="bi bi-clipboard2-check me-2"></i>Vehicle Inspection</h1>
          <p class="text-muted">Step 1: Document findings and observations | Workshop Supervisor will review and determine workflow</p>
        </div>
        <%= link_to "← Back", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary rounded-pill", data: { turbo: false } %>
      </div>
    </div>
  </div>

  <!-- Workflow Preview Banner -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0 rounded-3 shadow-sm">
        <div class="d-flex align-items-center">
          <i class="bi bi-diagram-3 fs-3 me-3 text-primary"></i>
          <div>
            <strong>Workflow After This Step:</strong><br>
            <small>1. You complete inspection → 2. Workshop Supervisor reviews findings → 3. Supervisor selects workflow type → 4. Procurement creates quotation → 5. Work begins after client approval</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <%= form_with url: vmcott_inspector_proceed_to_jobs_path, method: :post, local: true, id: "inspection-form", multipart: true, data: { turbo: false }, html: { onsubmit: "return validateForm()" } do |f| %>
        <%= hidden_field_tag :vehicle_id, @vehicle.id %>

        <!-- Vehicle Summary -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-primary text-white border-0 rounded-top-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-truck me-2"></i><%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %></h5>
            <span class="badge bg-light text-dark">Current Odometer: <%= @vehicle.mileage || 'N/A' %> km</span>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label fw-bold">Current Mileage *</label>
                <%= number_field_tag :current_mileage, @vehicle.mileage, class: "form-control rounded-pill", required: true, min: @vehicle.mileage || 0 %>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold">Fuel Level *</label>
                <%= select_tag :fuel_level, options_for_select([['1/4', 25], ['1/2', 50], ['3/4', 75], ['Full', 100]]), { prompt: 'Select', class: 'form-select rounded-pill', required: true } %>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold">Vehicle Condition *</label>
                <%= select_tag :vehicle_condition, options_for_select(['Excellent', 'Good', 'Fair', 'Poor', 'Damaged']), { prompt: 'Select', class: 'form-select rounded-pill', required: true } %>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold">Priority *</label>
                <%= select_tag :inspection_priority, options_for_select([['Low', 'low'], ['Normal', 'normal'], ['High', 'high'], ['Critical', 'critical']]), { prompt: 'Select', class: 'form-select rounded-pill', required: true } %>
              </div>
            </div>
          </div>
        </div>

        <!-- ORIGINAL REQUEST (if any) -->
        <% if @original_request.present? %>
          <div class="alert alert-warning border-0 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Customer Request:</strong> <%= @original_request.description || 'No specific request' %>
            <div class="form-check mt-2">
              <input type="checkbox" name="verify_reported_issues" value="true" id="verify_issues" class="form-check-input" required>
              <label for="verify_issues" class="form-check-label">I have verified these issues</label>
            </div>
          </div>
        <% end %>

        <!-- TWO-COLUMN LAYOUT: Findings on Left, Photos & Sign-off on Right -->
        <div class="row">
          <!-- LEFT COLUMN: Inspection Findings -->
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 mb-4 h-100">
              <div class="card-header bg-secondary text-white border-0 rounded-top-4">
                <h5 class="mb-0"><i class="bi bi-search me-2"></i>Inspection Findings</h5>
                <p class="small mb-0 mt-1 text-white-50">Document all observations. Supervisor will review and determine workflow.</p>
              </div>
              <div class="card-body" style="max-height: 700px; overflow-y: auto;">
                
                <!-- Exterior Section -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Exterior</h6>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][body_damage]" value="true" id="body_damage" class="form-check-input">
                        <label for="body_damage" class="form-check-label">Body Damage</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][rust]" value="true" id="rust" class="form-check-input">
                        <label for="rust" class="form-check-label">Rust/Corrosion</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][windshield]" value="true" id="windshield" class="form-check-input">
                        <label for="windshield" class="form-check-label">Windshield Cracked</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][lights]" value="true" id="lights" class="form-check-input">
                        <label for="lights" class="form-check-label">Lights Not Working</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][tires]" value="true" id="tires" class="form-check-input">
                        <label for="tires" class="form-check-label">Tire Damage/Wear</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[exterior][mirrors]" value="true" id="mirrors" class="form-check-input">
                        <label for="mirrors" class="form-check-label">Mirror Damage</label>
                      </div>
                    </div>
                  </div>
                  <textarea name="findings[exterior][notes]" class="form-control form-control-sm mt-2 rounded-3" rows="2" placeholder="Exterior notes (location of damage, etc.)"></textarea>
                </div>

                <!-- Interior Section -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Interior</h6>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[interior][seats]" value="true" id="seats" class="form-check-input">
                        <label for="seats" class="form-check-label">Seat Damage</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[interior][dashboard_lights]" value="true" id="dashboard_lights" class="form-check-input">
                        <label for="dashboard_lights" class="form-check-label">Warning Lights On</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[interior][ac]" value="true" id="ac" class="form-check-input">
                        <label for="ac" class="form-check-label">AC Not Working</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[interior][electronics]" value="true" id="electronics" class="form-check-input">
                        <label for="electronics" class="form-check-label">Electronics Issues</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[interior][smell]" value="true" id="smell" class="form-check-input">
                        <label for="smell" class="form-check-label">Unusual Odor</label>
                      </div>
                    </div>
                  </div>
                  <textarea name="findings[interior][notes]" class="form-control form-control-sm mt-2 rounded-3" rows="2" placeholder="Interior notes..."></textarea>
                </div>

                <!-- Mechanical Section -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Mechanical</h6>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][engine_noise]" value="true" id="engine_noise" class="form-check-input">
                        <label for="engine_noise" class="form-check-label">Engine Noise</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][smoke]" value="true" id="smoke" class="form-check-input">
                        <label for="smoke" class="form-check-label">Exhaust Smoke</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][leaks]" value="true" id="leaks" class="form-check-input">
                        <label for="leaks" class="form-check-label">Fluid Leaks</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][brakes]" value="true" id="brakes" class="form-check-input">
                        <label for="brakes" class="form-check-label">Brake Issues</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][transmission]" value="true" id="transmission" class="form-check-input">
                        <label for="transmission" class="form-check-label">Transmission Issues</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[mechanical][steering]" value="true" id="steering" class="form-check-input">
                        <label for="steering" class="form-check-label">Steering Issues</label>
                      </div>
                    </div>
                  </div>
                  <textarea name="findings[mechanical][notes]" class="form-control form-control-sm mt-2 rounded-3" rows="2" placeholder="Mechanical notes..."></textarea>
                </div>

                <!-- Safety Systems -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Safety Systems</h6>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[safety][seatbelts]" value="true" id="seatbelts" class="form-check-input">
                        <label for="seatbelts" class="form-check-label">Seatbelts Issue</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[safety][airbag]" value="true" id="airbag" class="form-check-input">
                        <label for="airbag" class="form-check-label">Airbag Light</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[safety][horn]" value="true" id="horn" class="form-check-input">
                        <label for="horn" class="form-check-label">Horn Not Working</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[safety][wipers]" value="true" id="wipers" class="form-check-input">
                        <label for="wipers" class="form-check-label">Wipers Issue</label>
                      </div>
                    </div>
                  </div>
                  <textarea name="findings[safety][notes]" class="form-control form-control-sm mt-2 rounded-3" rows="2" placeholder="Safety system notes..."></textarea>
                </div>

                <!-- Fluids & Leaks -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Fluids & Leaks</h6>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[fluids][oil]" value="true" id="oil_leak" class="form-check-input">
                        <label for="oil_leak" class="form-check-label">Oil Leak</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[fluids][coolant]" value="true" id="coolant_leak" class="form-check-input">
                        <label for="coolant_leak" class="form-check-label">Coolant Leak</label>
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[fluids][brake_fluid]" value="true" id="brake_fluid_leak" class="form-check-input">
                        <label for="brake_fluid_leak" class="form-check-label">Brake Fluid Leak</label>
                      </div>
                      <div class="form-check mb-2">
                        <input type="checkbox" name="findings[fluids][transmission]" value="true" id="transmission_leak" class="form-check-input">
                        <label for="transmission_leak" class="form-check-label">Transmission Leak</label>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-2">
                    <div class="col-4">
                      <label class="form-label small">Oil Level</label>
                      <%= select_tag :oil_level, options_for_select(['Full', 'OK', 'Low', 'Empty']), { prompt: 'Select', class: 'form-select form-select-sm rounded-pill' } %>
                    </div>
                    <div class="col-4">
                      <label class="form-label small">Coolant Level</label>
                      <%= select_tag :coolant_level, options_for_select(['Full', 'OK', 'Low', 'Empty']), { prompt: 'Select', class: 'form-select form-select-sm rounded-pill' } %>
                    </div>
                    <div class="col-4">
                      <label class="form-label small">Brake Fluid</label>
                      <%= select_tag :brake_fluid_level, options_for_select(['Full', 'OK', 'Low', 'Empty']), { prompt: 'Select', class: 'form-select form-select-sm rounded-pill' } %>
                    </div>
                  </div>
                </div>

                <!-- Brake & Tire Measurements -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Brake & Tire Measurements</h6>
                  <div class="row">
                    <div class="col-6">
                      <label class="form-label small">Front Brake Pad Thickness (mm)</label>
                      <input type="number" name="brake_front" class="form-control form-control-sm rounded-pill" step="0.5" placeholder="mm">
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Rear Brake Pad Thickness (mm)</label>
                      <input type="number" name="brake_rear" class="form-control form-control-sm rounded-pill" step="0.5" placeholder="mm">
                    </div>
                  </div>
                  <div class="row mt-2">
                    <div class="col-6">
                      <label class="form-label small">Tire Tread Depth (mm)</label>
                      <input type="number" name="tire_tread" class="form-control form-control-sm rounded-pill" step="0.5" placeholder="mm">
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Tire Pressure (PSI)</label>
                      <input type="number" name="tire_pressure" class="form-control form-control-sm rounded-pill" placeholder="PSI">
                    </div>
                  </div>
                </div>

                <!-- Diagnostic Codes -->
                <div class="mb-4">
                  <h6 class="border-bottom pb-2">Diagnostic Codes</h6>
                  <input type="text" name="diagnostic_codes" class="form-control form-control-sm mb-2 rounded-pill" placeholder="e.g., P0300, P0420">
                  <input type="text" name="diagnostic_equipment" class="form-control form-control-sm rounded-pill" placeholder="Equipment used">
                </div>

                <!-- Summary -->
                <div class="mb-3">
                  <h6 class="border-bottom pb-2">Inspection Summary *</h6>
                  <textarea name="preliminary_summary" class="form-control rounded-3" rows="4" required placeholder="Summarize your findings. Include what you observed, any concerns, and recommendations for the supervisor."></textarea>
                  <small class="text-muted">The Workshop Supervisor will review this summary to determine workflow and job recommendations.</small>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Photo Documentation & Sign-off with Camera Support -->
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 mb-4 h-100">
              <div class="card-header bg-info text-white border-0 rounded-top-4">
                <h5 class="mb-0"><i class="bi bi-camera me-2"></i>Photo Documentation & Sign-off</h5>
                <p class="small mb-0 mt-1 text-white-50">Take photos now or upload from gallery</p>
              </div>
              <div class="card-body" style="max-height: 700px; overflow-y: auto;">
                <div class="alert alert-info mb-3 rounded-3">
                  <i class="bi bi-info-circle me-2"></i>
                  <small><i class="bi bi-camera me-1"></i> Tap camera icon to take photo immediately, or click "Browse" to select existing photos</small>
                </div>
                
                <!-- Front View with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Front View
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[front]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_front">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_front')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_front" class="mt-2" style="display: none;">
                    <img id="preview_front_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <!-- Rear View with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Rear View
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[rear]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_rear">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_rear')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_rear" class="mt-2" style="display: none;">
                    <img id="preview_rear_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <!-- Left Side with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Left Side
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[left]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_left">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_left')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_left" class="mt-2" style="display: none;">
                    <img id="preview_left_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <!-- Right Side with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Right Side
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[right]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_right">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_right')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_right" class="mt-2" style="display: none;">
                    <img id="preview_right_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <!-- Dashboard with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Dashboard
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[dashboard]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_dashboard">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_dashboard')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_dashboard" class="mt-2" style="display: none;">
                    <img id="preview_dashboard_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <!-- Damage / Issue Area (Multiple photos allowed) -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Damage / Issue Area
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[damage]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_damage" multiple>
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="captureMultiplePhotos()">
                      <i class="bi bi-camera"></i> Take Photos
                    </button>
                  </div>
                  <small class="text-muted">You can select multiple photos or take multiple photos</small>
                  <div id="preview_damage" class="mt-2 d-flex flex-wrap gap-2" style="display: none;"></div>
                </div>
                
                <!-- Underbody / Chassis with Camera Support -->
                <div class="mb-3">
                  <label class="form-label fw-bold">
                    <i class="bi bi-camera-fill me-1"></i> Underbody / Chassis
                  </label>
                  <div class="input-group">
                    <input type="file" name="photos[underbody]" accept="image/*" capture="environment" class="form-control rounded-pill" id="photo_underbody">
                    <button type="button" class="btn btn-outline-primary rounded-pill" onclick="capturePhoto('photo_underbody')">
                      <i class="bi bi-camera"></i> Take Photo
                    </button>
                  </div>
                  <div id="preview_underbody" class="mt-2" style="display: none;">
                    <img id="preview_underbody_img" style="max-width: 100%; max-height: 120px; border-radius: 8px; border: 1px solid #ddd;">
                  </div>
                </div>
                
                <hr class="my-4">
                
                <!-- Inspector Sign-off -->
                <div class="border rounded-3 p-3 bg-light">
                  <h6 class="fw-bold mb-3"><i class="bi bi-pen me-2"></i>Inspector Sign-off</h6>
                  <div class="form-check mb-2">
                    <input type="checkbox" name="inspector_confirmation" id="inspector_confirmation" class="form-check-input" required>
                    <label for="inspector_confirmation" class="form-check-label">
                      I confirm that I have personally inspected this vehicle and all findings are accurate
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input type="checkbox" name="photos_complete" id="photos_complete" class="form-check-input" required>
                    <label for="photos_complete" class="form-check-label">
                      I have documented all damage areas with photos
                    </label>
                  </div>
                  <div class="mt-3">
                    <label class="form-label fw-bold">Inspector Name</label>
                    <input type="text" class="form-control rounded-pill" value="<%= current_user.name %>" readonly disabled>
                  </div>
                  <div class="mt-2">
                    <label class="form-label fw-bold">Date & Time</label>
                    <input type="text" class="form-control rounded-pill" value="<%= Time.current.strftime('%B %d, %Y at %I:%M %p') %>" readonly disabled>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex justify-content-between mt-4">
          <%= link_to "Cancel", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary rounded-pill px-4", data: { turbo: false } %>
          <button type="submit" class="btn btn-purple btn-lg rounded-pill px-5" id="submit-btn">
            <i class="bi bi-send me-2"></i>Complete Inspection & Send to Supervisor
          </button>
        </div>
        
        <!-- Explanation of next steps -->
        <div class="alert alert-success mt-4 rounded-3">
          <div class="d-flex align-items-start">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
              <strong>What happens after submission?</strong>
              <ol class="mb-0 mt-2 ps-3">
                <li>Your inspection data will be saved</li>
                <li>You'll be taken to the <strong>Job Recommendations</strong> page</li>
                <li>Add your recommended jobs for this vehicle</li>
                <li>Submit to <strong>Workshop Supervisor</strong> for review</li>
                <li>Supervisor selects workflow type and approves jobs</li>
                <li>Procurement creates quotation for client</li>
              </ol>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Camera capture function for single photos
function capturePhoto(inputId) {
  const fileInput = document.getElementById(inputId);
  if (fileInput) {
    fileInput.click();
    fileInput.addEventListener('change', function(e) {
      if (e.target.files && e.target.files[0]) {
        const previewId = inputId.replace('photo_', 'preview_');
        const previewDiv = document.getElementById(previewId);
        const previewImg = document.getElementById(previewId + '_img');
        
        if (previewImg) {
          const reader = new FileReader();
          reader.onload = function(e) {
            previewImg.src = e.target.result;
            previewDiv.style.display = 'block';
          };
          reader.readAsDataURL(e.target.files[0]);
        }
      }
    });
  }
}

// Handle multiple photos for damage area
function captureMultiplePhotos() {
  const fileInput = document.getElementById('photo_damage');
  if (fileInput) {
    fileInput.click();
    fileInput.addEventListener('change', function(e) {
      const previewDiv = document.getElementById('preview_damage');
      previewDiv.style.display = 'flex';
      previewDiv.innerHTML = ''; // Clear previous previews
      
      for (let i = 0; i < e.target.files.length; i++) {
        const file = e.target.files[i];
        const img = document.createElement('img');
        img.style.maxWidth = '80px';
        img.style.maxHeight = '80px';
        img.style.borderRadius = '8px';
        img.style.border = '1px solid #ddd';
        img.style.objectFit = 'cover';
        
        const reader = new FileReader();
        reader.onload = (function(img) {
          return function(e) {
            img.src = e.target.result;
          };
        })(img);
        reader.readAsDataURL(file);
        previewDiv.appendChild(img);
      }
    });
  }
}

// Add preview for all photo inputs on page load
document.addEventListener('DOMContentLoaded', function() {
  const photoInputs = document.querySelectorAll('input[type="file"][accept="image/*"]');
  photoInputs.forEach(input => {
    if (input.id && input.id !== 'photo_damage') {
      input.addEventListener('change', function(e) {
        if (e.target.files && e.target.files[0]) {
          const previewId = input.id.replace('photo_', 'preview_');
          const previewDiv = document.getElementById(previewId);
          const previewImg = document.getElementById(previewId + '_img');
          
          if (previewImg) {
            const reader = new FileReader();
            reader.onload = function(e) {
              previewImg.src = e.target.result;
              previewDiv.style.display = 'block';
            };
            reader.readAsDataURL(e.target.files[0]);
          }
        }
      });
    }
  });
});

function validateForm() {
  const mileage = document.getElementById('current_mileage');
  const fuelLevel = document.getElementById('fuel_level');
  const condition = document.getElementById('vehicle_condition');
  const priority = document.getElementById('inspection_priority');
  const summary = document.querySelector('textarea[name="preliminary_summary"]');
  const inspectorConfirm = document.getElementById('inspector_confirmation');
  const photosComplete = document.getElementById('photos_complete');
  
  if (!mileage.value || mileage.value < 0) {
    alert('Please enter current mileage');
    mileage.focus();
    return false;
  }
  
  if (!fuelLevel.value) {
    alert('Please select fuel level');
    fuelLevel.focus();
    return false;
  }
  
  if (!condition.value) {
    alert('Please select vehicle condition');
    condition.focus();
    return false;
  }
  
  if (!priority.value) {
    alert('Please select priority');
    priority.focus();
    return false;
  }
  
  if (!summary.value.trim()) {
    alert('Please enter inspection summary');
    summary.focus();
    return false;
  }
  
  if (!inspectorConfirm.checked) {
    alert('Please confirm that your inspection findings are accurate');
    inspectorConfirm.focus();
    return false;
  }
  
  if (!photosComplete.checked) {
    alert('Please confirm that you have documented damage with photos');
    photosComplete.focus();
    return false;
  }
  
  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
  
  return true;
}
</script>

