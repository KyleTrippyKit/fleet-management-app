<%# app/views/vmcott/inspector/dashboard/job_recommendations.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2"><i class="bi bi-clipboard-check me-2"></i>Job Recommendations</h1>
          <p class="text-muted">Step 2: Recommend jobs for <%= @vehicle.license_plate %></p>
          <div class="alert alert-info mt-2 rounded-3">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Note:</strong> These are <strong>recommendations</strong>. The Workshop Supervisor will review and finalize the jobs, then select the workflow type.
          </div>
        </div>
        <%= link_to "← Back to Pre-Inspection", vmcott_inspector_pre_inspection_path(@vehicle.id), class: "btn btn-outline-secondary rounded-pill" %>
      </div>
    </div>
  </div>

  <!-- Workflow Preview Card -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm rounded-4 bg-gradient-purple">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
              <i class="bi bi-diagram-3 text-purple fs-4 me-2"></i>
              <span class="fw-semibold">Next Step After Submission:</span>
              <span class="text-muted ms-2">Workshop Supervisor reviews recommendations → Selects workflow type → Procurement creates quotation</span>
            </div>
            <div class="d-flex gap-2">
              <span class="badge bg-purple text-white p-2">
                <i class="bi bi-person-walking me-1"></i> Supervisor's Turn
              </span>
              <span class="badge bg-info text-white p-2">
                <i class="bi bi-envelope-paper me-1"></i> Then Procurement
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Summary of Pre-Inspection Findings -->
      <% if @pre_inspection_data.present? %>
        <div class="alert alert-info border-0 rounded-3 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <i class="bi bi-info-circle me-2"></i>
              <strong>Findings:</strong> 
              <%= @pre_inspection_data['preliminary_summary']&.truncate(100) %>
            </div>
            <span class="badge bg-primary rounded-pill">Priority: <%= @pre_inspection_data['priority']&.titleize || 'Normal' %></span>
          </div>
        </div>
      <% end %>

      <!-- ✅ FIX: Changed form action to vmcott_inspector_create_inspection_path -->
      <%= form_with url: vmcott_inspector_inspections_path, method: :post, local: true, id: "inspection-form", data: { turbo: false } do |f| %>
        <%= hidden_field_tag :vehicle_id, @vehicle.id %>

        <!-- Custom Jobs Section -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-white border-0 pt-4">
            <h5 class="mb-0 fw-bold">
              <i class="bi bi-pencil-square me-2 text-primary"></i>Recommended Jobs
            </h5>
            <p class="text-muted small mt-1 mb-0">Add recommended jobs that need to be performed. Supervisor will review and finalize.</p>
          </div>
          <div class="card-body">
            <!-- Add New Custom Job Input -->
            <div class="mb-4">
              <label for="custom-job-input" class="form-label fw-semibold">
                <i class="bi bi-plus-circle me-1"></i>New Recommended Job
              </label>
              <div class="input-group">
                <input type="text" 
                       id="custom-job-input" 
                       class="form-control rounded-pill" 
                       placeholder="e.g., 'Replace brake pads', 'Check unusual noise', 'Inspect electrical system'"
                       autocomplete="off">
                <button class="btn btn-primary rounded-pill" type="button" id="add-custom-job-btn">
                  <i class="bi bi-plus-circle me-1"></i>Add Recommendation
                </button>
              </div>
              <div class="form-text mt-1">Press Enter or click Add Recommendation to add to the list</div>
            </div>

            <!-- List of Added Custom Jobs -->
            <div id="custom-jobs-list" class="mt-4">
              <!-- Custom jobs will appear here -->
            </div>

            <!-- Hidden field to ensure at least one job is submitted -->
            <div id="no-jobs-message" class="alert alert-warning mt-3 rounded-3" style="display: none;">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Please add at least one job recommendation before proceeding.
            </div>
          </div>
        </div>

        <!-- Additional Notes -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-white border-0 pt-4">
            <h5 class="mb-0 fw-bold">
              <i class="bi bi-pencil me-2 text-info"></i>Additional Notes for Supervisor
            </h5>
            <p class="text-muted small mt-1 mb-0">Any specific instructions or observations for the supervisor</p>
          </div>
          <div class="card-body">
            <%= text_area_tag :notes, nil, 
                  class: "form-control rounded-3", 
                  rows: 3,
                  placeholder: "Example: 'Vehicle has unusual noise when turning left', 'Check for oil leak under engine', etc." %>
          </div>
        </div>

        <!-- Next Service Recommendation -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-white border-0 pt-4">
            <h5 class="mb-0 fw-bold">
              <i class="bi bi-calendar me-2 text-secondary"></i>Next Service Recommendation
            </h5>
            <p class="text-muted small mt-1 mb-0">Optional recommendation for future service</p>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6 mb-3 mb-md-0">
                <label class="form-label fw-semibold">Service at (km)</label>
                <%= number_field_tag :next_service_mileage, @vehicle.mileage.to_i + 5000, class: "form-control rounded-pill" %>
                <div class="form-text">Current mileage: <%= number_with_delimiter(@vehicle.mileage) %> km</div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">or by date</label>
                <%= date_field_tag :next_service_date, 6.months.from_now.to_date, class: "form-control rounded-pill" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex justify-content-between align-items-center gap-3">
          <%= link_to "Cancel", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
          <button type="submit" class="btn btn-purple btn-lg rounded-pill px-5" id="submit-btn">
            <i class="bi bi-send me-2"></i>Submit Recommendations to Supervisor
          </button>
        </div>
        
        <!-- Explanation of what happens next -->
        <div class="alert alert-success mt-4 rounded-3">
          <div class="d-flex align-items-start">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
              <strong>What happens after submission?</strong>
              <ol class="mb-0 mt-2 ps-3">
                <li>Workshop Supervisor reviews your recommendations</li>
                <li>Supervisor selects workflow type (Option A: Payment Before Work OR Option B: Work Before Payment)</li>
                <li>Supervisor sets labor rates and parts markup</li>
                <li>Procurement team creates quotation for client</li>
                <li>Client approves (if Option A) or work begins (if Option B)</li>
              </ol>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- JavaScript for Custom Jobs Management -->
<script>
(function() {
  'use strict';
  
  console.log('🔧 Custom Jobs script loaded');
  
  function initializeCustomJobs() {
    console.log('🔍 Initializing custom jobs...');
    
    const customJobInput = document.getElementById('custom-job-input');
    const addJobBtn = document.getElementById('add-custom-job-btn');
    const customJobsList = document.getElementById('custom-jobs-list');
    const noJobsMessage = document.getElementById('no-jobs-message');
    const form = document.getElementById('inspection-form');
    
    // Check if elements exist
    if (!customJobInput || !addJobBtn || !customJobsList || !noJobsMessage || !form) {
      console.log('❌ Required elements not found');
      return;
    }
    
    console.log('✅ Elements found, attaching event listeners');
    
    // Remove any existing event listeners by cloning and replacing
    const newInput = customJobInput.cloneNode(true);
    const newButton = addJobBtn.cloneNode(true);
    const newForm = form.cloneNode(true);
    
    customJobInput.parentNode.replaceChild(newInput, customJobInput);
    addJobBtn.parentNode.replaceChild(newButton, addJobBtn);
    form.parentNode.replaceChild(newForm, form);
    
    // Update references
    const updatedInput = document.getElementById('custom-job-input');
    const updatedButton = document.getElementById('add-custom-job-btn');
    const updatedForm = document.getElementById('inspection-form');
    const updatedList = document.getElementById('custom-jobs-list');
    const updatedNoJobs = document.getElementById('no-jobs-message');
    
    // Function to add a new custom job
    function addCustomJob(description) {
      if (!description.trim()) return;
      
      console.log('➕ Adding job:', description);
      
      // Create job element
      const jobDiv = document.createElement('div');
      jobDiv.className = 'custom-job-item card mb-2 border-start border-4 border-purple';
      jobDiv.style.animation = 'slideIn 0.3s ease';
      jobDiv.innerHTML = `
        <div class="card-body py-3">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <i class="bi bi-star text-purple me-3 fs-5"></i>
              <div>
                <span class="fw-medium">${escapeHtml(description)}</span>
                <span class="badge bg-purple text-white ms-2">Recommended</span>
                <input type="hidden" name="custom_jobs[][description]" value="${escapeHtml(description)}">
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill remove-custom-job" title="Remove recommendation">
              <i class="bi bi-trash me-1"></i>Remove
            </button>
          </div>
        </div>
      `;
      
      // Add remove functionality
      const removeBtn = jobDiv.querySelector('.remove-custom-job');
      removeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('🗑️ Removing job');
        jobDiv.style.animation = 'slideOut 0.2s ease';
        setTimeout(() => {
          jobDiv.remove();
          updateJobsListVisibility();
        }, 150);
      });
      
      // Add to list
      updatedList.appendChild(jobDiv);
      
      // Clear input and focus
      updatedInput.value = '';
      updatedInput.focus();
      
      // Update visibility
      updateJobsListVisibility();
    }
    
    // Helper function to escape HTML
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    
    // Function to update visibility of jobs list and messages
    function updateJobsListVisibility() {
      const jobsCount = document.querySelectorAll('input[name="custom_jobs[][description]"]').length;
      console.log('📊 Jobs count:', jobsCount);
      
      if (jobsCount === 0) {
        updatedNoJobs.style.display = 'block';
        
        // Only show empty message if no jobs exist
        if (!updatedList.querySelector('.custom-job-item')) {
          updatedList.innerHTML = '<div class="text-center text-muted py-4" id="empty-jobs-message"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No recommendations added yet. Add a job recommendation above.</div>';
        }
      } else {
        updatedNoJobs.style.display = 'none';
        // Remove empty message if it exists
        const emptyMsg = document.getElementById('empty-jobs-message');
        if (emptyMsg) emptyMsg.remove();
      }
    }
    
    // Add job on button click
    updatedButton.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      addCustomJob(updatedInput.value);
    });
    
    // Add job on Enter key
    updatedInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        e.stopPropagation();
        addCustomJob(this.value);
      }
    });
    
    // Form validation before submit
    updatedForm.addEventListener('submit', function(e) {
      const jobsCount = document.querySelectorAll('input[name="custom_jobs[][description]"]').length;
      console.log('📝 Form submit, jobs count:', jobsCount);
      
      if (jobsCount === 0) {
        e.preventDefault();
        e.stopPropagation();
        updatedNoJobs.style.display = 'block';
        updatedList.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        // Shake animation for attention
        updatedNoJobs.style.animation = 'shake 0.5s';
        setTimeout(() => {
          updatedNoJobs.style.animation = '';
        }, 500);
      } else {
        // Show loading state on button
        const submitBtn = document.getElementById('submit-btn');
        if (submitBtn) {
          submitBtn.classList.add('btn-loading');
          submitBtn.disabled = true;
        }
      }
    });
    
    // Initialize with empty state message
    updateJobsListVisibility();
    
    // Focus on input on page load
    setTimeout(() => updatedInput.focus(), 100);
    
    console.log('✅ Custom jobs initialized successfully');
  }
  
  // Try multiple initialization methods
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCustomJobs);
  } else {
    initializeCustomJobs();
  }
  
  // Handle Turbo
  document.addEventListener('turbo:load', initializeCustomJobs);
  
  // Also try after a short delay as fallback
  setTimeout(initializeCustomJobs, 100);
  setTimeout(initializeCustomJobs, 500);
  
})();

// Add animations
const style = document.createElement('style');
style.textContent = `
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
  20%, 40%, 60%, 80% { transform: translateX(5px); }
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideOut {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(20px); }
}

/* Purple theme */
.bg-purple {
  background-color: #8b5cf6 !important;
}

.btn-purple {
  background-color: #8b5cf6;
  border-color: #8b5cf6;
  color: white;
}

.btn-purple:hover {
  background-color: #7c3aed;
  border-color: #7c3aed;
  color: white;
}

.text-purple {
  color: #8b5cf6 !important;
}

.border-purple {
  border-color: #8b5cf6 !important;
}

.custom-job-item {
  background-color: #f8f9fa;
  border-left: 4px solid #8b5cf6 !important;
  transition: all 0.2s ease;
}

.custom-job-item:hover {
  background-color: #f3e8ff;
  transform: translateX(5px);
  box-shadow: 0 2px 8px rgba(139, 92, 246, 0.2);
}

#custom-job-input:focus {
  border-color: #8b5cf6;
  box-shadow: 0 0 0 0.2rem rgba(139, 92, 246, 0.25);
}

#add-custom-job-btn {
  min-width: 100px;
}

/* Loading state */
.btn-loading {
  position: relative;
  pointer-events: none;
  opacity: 0.7;
}

.btn-loading:after {
  content: '';
  position: absolute;
  width: 1rem;
  height: 1rem;
  top: 50%;
  left: 50%;
  margin-left: -0.5rem;
  margin-top: -0.5rem;
  border: 2px solid #fff;
  border-radius: 50%;
  border-top-color: transparent;
  animation: spinner 0.6s linear infinite;
}

@keyframes spinner {
  to { transform: rotate(360deg); }
}

/* Animation for empty state */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

#custom-jobs-list > div:first-child {
  animation: fadeIn 0.3s ease;
}

/* Rounded corners */
.rounded-4 {
  border-radius: 1rem !important;
}

.rounded-pill {
  border-radius: 50rem !important;
}
`;
document.head.appendChild(style);
</script>

