<%# app/views/vmcott/inspector/dashboard/new_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2"><i class="bi bi-wrench me-2"></i>Select Required Jobs</h1>
          <p class="text-muted">Step 2: Choose jobs that need to be performed on <%= @vehicle.license_plate %></p>
          <p class="text-info"><i class="bi bi-info-circle me-1"></i> Parts will be requested by mechanics during repair</p>
        </div>
        <%= link_to "← Back to Pre-Inspection", vmcott_inspector_pre_inspection_path(@vehicle.id), class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Summary of Pre-Inspection Findings -->
      <% if @pre_inspection_data.present? %>
        <div class="alert alert-info mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <i class="bi bi-info-circle me-2"></i>
              <strong>Findings:</strong> 
              <%= @pre_inspection_data['preliminary_summary']&.truncate(100) %>
            </div>
            <span class="badge bg-primary">Priority: <%= @pre_inspection_data['priority']&.titleize || 'Normal' %></span>
          </div>
        </div>
      <% end %>

      <%= form_with url: vmcott_inspector_inspections_path, method: :post, local: true do |f| %>
        <%= hidden_field_tag :vehicle_id, @vehicle.id %>

        <!-- Job Templates - NO PARTS SECTION -->
        <div class="card mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Select Jobs to Perform</h5>
          </div>
          <div class="card-body">
            <p class="text-muted mb-3">Check all jobs that need to be done. Mechanics will determine specific parts needed.</p>
            
            <!-- Job Templates -->
            <div class="mb-4">
              <h6 class="border-bottom pb-2">Job Templates</h6>
              <div id="job-templates-container">
                <% JobTemplate.for_vehicle(@vehicle).active.each do |template| %>
                  <div class="form-check mb-2">
                    <input type="checkbox" 
                           name="job_template_ids[]" 
                           value="<%= template.id %>" 
                           class="form-check-input" 
                           id="template_<%= template.id %>">
                    <label class="form-check-label" for="template_<%= template.id %>">
                      <strong><%= template.name %></strong>
                      <small class="text-muted d-block"><%= template.description %></small>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Custom Job -->
            <div class="mb-3">
              <h6 class="border-bottom pb-2">Custom Job</h6>
              <div class="mb-2">
                <input type="text" 
                       name="custom_jobs[][description]" 
                       class="form-control" 
                       placeholder="Describe custom job needed (e.g., 'Check unusual noise')"
                       id="custom-job-input">
              </div>
              <div id="custom-jobs-list"></div>
              <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="add-custom-job" style="display: none;">
                Add Another Custom Job
              </button>
            </div>

            <div class="alert alert-warning mt-3">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <strong>Note:</strong> You're only identifying jobs that need to be done. 
              Mechanics will inspect and request specific parts during repair.
            </div>
          </div>
        </div>

        <!-- Additional Notes -->
        <div class="card mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Additional Notes for Mechanics</h5>
          </div>
          <div class="card-body">
            <%= text_area_tag :notes, nil, 
                  class: "form-control", 
                  rows: 3,
                  placeholder: "Any specific instructions or observations for the mechanics..." %>
          </div>
        </div>

        <!-- Next Service Recommendation -->
        <div class="card mb-4">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-calendar me-2"></i>Next Service Recommendation</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <label class="form-label">Service at (km)</label>
                <%= number_field_tag :next_service_mileage, @vehicle.mileage.to_i + 5000, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <label class="form-label">or by date</label>
                <%= date_field_tag :next_service_date, 6.months.from_now.to_date, class: "form-control" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex justify-content-between">
          <%= link_to "Cancel", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary" %>
          <button type="submit" class="btn btn-primary btn-lg" id="submit-btn">
            <i class="bi bi-check-circle me-2"></i>Complete Inspection & Send to Mechanics
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const customJobInput = document.getElementById('custom-job-input');
  const customJobsList = document.getElementById('custom-jobs-list');
  const addBtn = document.getElementById('add-custom-job');
  
  let customJobs = [];
  
  customJobInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter' && this.value.trim()) {
      e.preventDefault();
      addCustomJob(this.value.trim());
      this.value = '';
    }
  });
  
  function addCustomJob(description) {
    const jobId = 'custom_' + Date.now();
    const jobDiv = document.createElement('div');
    jobDiv.className = 'custom-job-item card mb-2';
    jobDiv.dataset.jobId = jobId;
    jobDiv.innerHTML = `
      <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center">
          <span><i class="bi bi-wrench me-2"></i>${description}</span>
          <input type="hidden" name="custom_jobs[][description]" value="${description}">
          <button type="button" class="btn btn-sm btn-outline-danger remove-custom-job">
            <i class="bi bi-x"></i>
          </button>
        </div>
      </div>
    `;
    
    jobDiv.querySelector('.remove-custom-job').addEventListener('click', function() {
      jobDiv.remove();
      if (customJobsList.children.length === 0) {
        addBtn.style.display = 'none';
      }
    });
    
    customJobsList.appendChild(jobDiv);
    addBtn.style.display = 'block';
  }
  
  addBtn.addEventListener('click', function() {
    if (customJobInput.value.trim()) {
      addCustomJob(customJobInput.value.trim());
      customJobInput.value = '';
    }
  });
  
  // Form validation
  document.getElementById('submit-btn').addEventListener('click', function(e) {
    const templates = document.querySelectorAll('input[name="job_template_ids[]"]:checked');
    const customJobs = document.querySelectorAll('input[name="custom_jobs[][description]"]');
    
    if (templates.length === 0 && customJobs.length === 0) {
      e.preventDefault();
      alert('Please select at least one job or add a custom job description.');
    }
  });
});
</script>

<style>
.custom-job-item {
  background-color: #f8f9fa;
  border-left: 4px solid #28a745;
}

.form-check {
  padding-left: 2rem;
}

.form-check-input {
  cursor: pointer;
  width: 1.2rem;
  height: 1.2rem;
  margin-left: -2rem;
}

.form-check-label {
  cursor: pointer;
  font-size: 1rem;
}
</style>