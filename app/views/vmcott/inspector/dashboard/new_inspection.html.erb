<%# app/views/vmcott/inspector/dashboard/new_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2"><i class="bi bi-wrench me-2"></i>Add Custom Jobs</h1>
          <p class="text-muted">Step 2: Add custom jobs that need to be performed on <%= @vehicle.license_plate %></p>
          <p class="text-info"><i class="bi bi-info-circle me-1"></i> Parts will be requested by mechanics during repair</p>
        </div>
        <%= link_to "← Back to Pre-Inspection", vmcott_inspector_pre_inspection_path(@vehicle.id), class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Summary of Pre-Inspection Findings -->
      <% if @pre_inspection_data.present? %>
        <div class="alert alert-info mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <i class="bi bi-info-circle me-2"></i>
              <strong>Findings:</strong> 
              <%= @pre_inspection_data['preliminary_summary']&.truncate(100) %>
            </div>
            <span class="badge bg-primary">Priority: <%= @pre_inspection_data['priority']&.titleize || 'Normal' %></span>
          </div>
        </div>
      <% end %>

      <%= form_with url: vmcott_inspector_inspections_path, method: :post, local: true do |f| %>
        <%= hidden_field_tag :vehicle_id, @vehicle.id %>

        <!-- Custom Jobs Section -->
        <div class="card mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Add Custom Jobs</h5>
          </div>
          <div class="card-body">
            <p class="text-muted mb-3">Add one or more custom jobs that need to be performed. You can add multiple jobs.</p>
            
            <!-- Add New Custom Job Input -->
            <div class="mb-3">
              <label for="custom-job-input" class="form-label fw-bold">New Custom Job</label>
              <div class="input-group">
                <input type="text" 
                       id="custom-job-input" 
                       class="form-control" 
                       placeholder="e.g., 'Check unusual noise', 'Inspect electrical system'"
                       autocomplete="off">
                <button class="btn btn-primary" type="button" id="add-custom-job-btn">
                  <i class="bi bi-plus-circle me-1"></i>Add Job
                </button>
              </div>
              <div class="form-text">Press Enter or click Add Job to add to the list</div>
            </div>

            <!-- List of Added Custom Jobs -->
            <div id="custom-jobs-list" class="mt-4">
              <!-- Custom jobs will appear here -->
            </div>

            <!-- Hidden field to ensure at least one job is submitted -->
            <div id="no-jobs-message" class="alert alert-warning mt-3" style="display: none;">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Please add at least one custom job before proceeding.
            </div>
          </div>
        </div>

        <!-- Additional Notes -->
        <div class="card mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Additional Notes for Mechanics</h5>
          </div>
          <div class="card-body">
            <%= text_area_tag :notes, nil, 
                  class: "form-control", 
                  rows: 3,
                  placeholder: "Any specific instructions or observations for the mechanics..." %>
          </div>
        </div>

        <!-- Next Service Recommendation -->
        <div class="card mb-4">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-calendar me-2"></i>Next Service Recommendation</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <label class="form-label">Service at (km)</label>
                <%= number_field_tag :next_service_mileage, @vehicle.mileage.to_i + 5000, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <label class="form-label">or by date</label>
                <%= date_field_tag :next_service_date, 6.months.from_now.to_date, class: "form-control" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex justify-content-between">
          <%= link_to "Cancel", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary" %>
          <button type="submit" class="btn btn-primary btn-lg" id="submit-btn">
            <i class="bi bi-check-circle me-2"></i>Complete Inspection & Send to Mechanics
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- JavaScript for Custom Jobs Management -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const customJobInput = document.getElementById('custom-job-input');
  const addJobBtn = document.getElementById('add-custom-job-btn');
  const customJobsList = document.getElementById('custom-jobs-list');
  const noJobsMessage = document.getElementById('no-jobs-message');
  const submitBtn = document.getElementById('submit-btn');
  
  // Array to store custom jobs
  let customJobs = [];
  
  // Function to add a new custom job
  function addCustomJob(description) {
    if (!description.trim()) return;
    
    // Create unique ID for this job
    const jobId = 'job_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    
    // Create job element
    const jobDiv = document.createElement('div');
    jobDiv.className = 'custom-job-item card mb-2 border-start border-4 border-success';
    jobDiv.dataset.jobId = jobId;
    jobDiv.innerHTML = `
      <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <i class="bi bi-wrench text-success me-3 fs-5"></i>
            <div>
              <span class="fw-medium">${escapeHtml(description)}</span>
              <input type="hidden" name="custom_jobs[][description]" value="${escapeHtml(description)}">
            </div>
          </div>
          <button type="button" class="btn btn-sm btn-outline-danger remove-custom-job" title="Remove job">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </div>
    `;
    
    // Add remove functionality
    jobDiv.querySelector('.remove-custom-job').addEventListener('click', function() {
      jobDiv.remove();
      customJobs = customJobs.filter(job => job.id !== jobId);
      updateJobsListVisibility();
    });
    
    // Add to list
    customJobsList.appendChild(jobDiv);
    
    // Store in array
    customJobs.push({
      id: jobId,
      description: description
    });
    
    // Update visibility
    updateJobsListVisibility();
  }
  
  // Helper function to escape HTML
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  // Function to update visibility of jobs list and messages
  function updateJobsListVisibility() {
    if (customJobs.length === 0) {
      noJobsMessage.style.display = 'block';
      customJobsList.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No jobs added yet. Add a custom job above.</div>';
    } else {
      noJobsMessage.style.display = 'none';
    }
  }
  
  // Add job on button click
  addJobBtn.addEventListener('click', function() {
    if (customJobInput.value.trim()) {
      addCustomJob(customJobInput.value.trim());
      customJobInput.value = '';
      customJobInput.focus();
    }
  });
  
  // Add job on Enter key
  customJobInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (this.value.trim()) {
        addCustomJob(this.value.trim());
        this.value = '';
      }
    }
  });
  
  // Form validation before submit
  submitBtn.addEventListener('click', function(e) {
    const customJobsCount = document.querySelectorAll('input[name="custom_jobs[][description]"]').length;
    
    if (customJobsCount === 0) {
      e.preventDefault();
      noJobsMessage.style.display = 'block';
      noJobsMessage.classList.add('alert', 'alert-warning');
      customJobsList.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      // Shake animation for attention
      noJobsMessage.style.animation = 'shake 0.5s';
      setTimeout(() => {
        noJobsMessage.style.animation = '';
      }, 500);
    }
  });
  
  // Initialize with empty state message
  updateJobsListVisibility();
  
  // Focus on input on page load
  customJobInput.focus();
});

// Add shake animation
const style = document.createElement('style');
style.textContent = `
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
  20%, 40%, 60%, 80% { transform: translateX(5px); }
}
.custom-job-item {
  transition: all 0.2s ease;
}
.custom-job-item:hover {
  transform: translateX(5px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
`;
document.head.appendChild(style);
</script>

<style>
.custom-job-item {
  background-color: #f8f9fa;
  border-left: 4px solid #28a745 !important;
  transition: all 0.2s ease;
}

.custom-job-item:hover {
  background-color: #f0f9ff;
  transform: translateX(5px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

#custom-job-input:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
}

#add-custom-job-btn {
  min-width: 100px;
}

/* Animation for empty state */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

#custom-jobs-list > div:first-child {
  animation: fadeIn 0.3s ease;
}
</style>