<%# app/views/vmcott/inspector/dashboard/recent_activity.html.erb %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-clock-history me-2"></i>
      Recent Activity
    </h1>
    <%= link_to vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary rounded-pill" do %>
      <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    <% end %>
  </div>

  <!-- Stats Cards - IMPROVED COLOR CODING -->
  <div class="row mb-4 g-3">
    <!-- Total Completed Card -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="card-title text-white-50 mb-2" style="letter-spacing: 0.5px;">
                <i class="bi bi-check2-circle me-1"></i> Total Completed
              </h6>
              <h2 class="mb-0 fw-bold text-white" style="font-size: 2.5rem;"><%= @total_count %></h2>
            </div>
            <div class="rounded-circle p-3" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-check2-circle fs-2 text-white"></i>
            </div>
          </div>
          <div class="mt-3 small text-white-50">
            <i class="bi bi-calendar-range me-1"></i> Completed inspections
          </div>
        </div>
      </div>
    </div>

    <!-- Approved for Repair Card -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="card-title text-white-50 mb-2" style="letter-spacing: 0.5px;">
                <i class="bi bi-check-circle me-1"></i> Approved for Repair
              </h6>
              <h2 class="mb-0 fw-bold text-white" style="font-size: 2.5rem;"><%= @approved_count %></h2>
            </div>
            <div class="rounded-circle p-3" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-check-circle fs-2 text-white"></i>
            </div>
          </div>
          <div class="mt-3 small text-white-50">
            <i class="bi bi-wrench me-1"></i> Ready for workshop
          </div>
        </div>
      </div>
    </div>

    <!-- Parts Received Card -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="card-title text-white-50 mb-2" style="letter-spacing: 0.5px;">
                <i class="bi bi-box-seam me-1"></i> Parts Received
              </h6>
              <h2 class="mb-0 fw-bold text-white" style="font-size: 2.5rem;"><%= @parts_received_count %></h2>
            </div>
            <div class="rounded-circle p-3" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-box-seam fs-2 text-white"></i>
            </div>
          </div>
          <div class="mt-3 small text-white-50">
            <i class="bi bi-truck me-1"></i> Parts received from vendors
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Optional: Additional Stats Row -->
  <div class="row mb-4 g-3">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2" style="background: #eff6ff;">
              <i class="bi bi-hourglass-split text-primary"></i>
            </div>
            <div>
              <div class="small text-muted">Pending Inspection</div>
              <div class="fw-bold fs-4"><%= @pending_inspections_count || 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2" style="background: #fef3c7;">
              <i class="bi bi-clipboard-check text-warning"></i>
            </div>
            <div>
              <div class="small text-muted">Awaiting QC</div>
              <div class="fw-bold fs-4"><%= @awaiting_qc_count || 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2" style="background: #e0e7ff;">
              <i class="bi bi-truck text-info"></i>
            </div>
            <div>
              <div class="small text-muted">Ready for Pickup</div>
              <div class="fw-bold fs-4"><%= @ready_for_pickup_count || 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2" style="background: #fef9e6;">
              <i class="bi bi-exclamation-triangle text-danger"></i>
            </div>
            <div>
              <div class="small text-muted">Issues Found</div>
              <div class="fw-bold fs-4"><%= @issues_found_count || 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body">
      <%= form_tag vmcott_inspector_recent_activity_path, method: :get, class: "row g-3" do %>
        <div class="col-md-3">
          <%= label_tag :from_date, "From Date", class: "form-label fw-semibold small text-muted" %>
          <%= date_field_tag :from_date, params[:from_date], class: "form-control rounded-pill" %>
        </div>
        <div class="col-md-3">
          <%= label_tag :to_date, "To Date", class: "form-label fw-semibold small text-muted" %>
          <%= date_field_tag :to_date, params[:to_date], class: "form-control rounded-pill" %>
        </div>
        <div class="col-md-3">
          <%= label_tag :status, "Status", class: "form-label fw-semibold small text-muted" %>
          <%= select_tag :status, 
                options_for_select([
                  ['All Statuses', ''],
                  ['Approved for Repair', 'approved_for_repair'],
                  ['Ready for Pickup', 'ready_for_pickup'],
                  ['QC Completed', 'qc_completed'],
                  ['Completed', 'completed'],
                  ['Parts Received', 'parts_received']
                ], params[:status]),
                class: "form-select rounded-pill" %>
        </div>
        <div class="col-md-3">
          <%= label_tag :vehicle_id, "Vehicle", class: "form-label fw-semibold small text-muted" %>
          <%= select_tag :vehicle_id,
                options_from_collection_for_select(@vehicles, :id, :license_plate, params[:vehicle_id]),
                include_blank: "All Vehicles",
                class: "form-select rounded-pill" %>
        </div>
        <div class="col-12">
          <%= submit_tag "Apply Filters", class: "btn btn-primary rounded-pill px-4" %>
          <%= link_to "Clear Filters", vmcott_inspector_recent_activity_path, class: "btn btn-outline-secondary rounded-pill px-4 ms-2" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Inspections List -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-4">
      <h5 class="mb-0 fw-bold">
        <i class="bi bi-list-check me-2 text-primary"></i>
        Inspection History
      </h5>
    </div>
    <div class="card-body p-0">
      <% if @inspections.present? && @inspections.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0 py-3">ID</th>
                <th class="border-0 py-3">Vehicle</th>
                <th class="border-0 py-3">Inspector</th>
                <th class="border-0 py-3">Status</th>
                <th class="border-0 py-3">Date</th>
                <th class="border-0 py-3 text-end">Actions</th>
               </thead>
            <tbody>
              <% @inspections.each do |inspection| %>
                <tr>
                  <td class="fw-semibold">#<%= inspection.id %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle bg-light p-2">
                        <i class="bi bi-truck text-muted"></i>
                      </div>
                      <div>
                        <strong><%= inspection.vehicle&.license_plate || 'N/A' %></strong>
                        <br><small class="text-muted"><%= inspection.vehicle&.make %> <%= inspection.vehicle&.model %></small>
                      </div>
                    </div>
                  </td>
                  <td><%= inspection.inspector&.name || 'N/A' %></td>
                  <td>
                    <% 
                      status_badge = case inspection.status
                        when 'approved_for_repair'
                          { class: 'bg-success', icon: 'bi-check-circle' }
                        when 'ready_for_pickup'
                          { class: 'bg-info', icon: 'bi-truck' }
                        when 'qc_completed'
                          { class: 'bg-primary', icon: 'bi-clipboard-check' }
                        when 'completed'
                          { class: 'bg-secondary', icon: 'bi-check-all' }
                        when 'parts_received'
                          { class: 'bg-warning', icon: 'bi-box-seam' }
                        else
                          { class: 'bg-secondary', icon: 'bi-hourglass' }
                      end
                    %>
                    <span class="badge <%= status_badge[:class] %> px-3 py-2 rounded-pill">
                      <i class="bi <%= status_badge[:icon] %> me-1"></i>
                      <%= inspection.status.humanize %>
                    </span>
                  </td>
                  <td><%= inspection.created_at.strftime("%b %d, %Y") %></td>
                  <td class="text-end">
                    <%= link_to vmcott_inspector_inspection_path(inspection), class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %>
                      <i class="bi bi-eye me-1"></i> View
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
           </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
          <h6 class="text-muted">No inspection records found</h6>
          <p class="small text-muted">Try adjusting your filters or check back later</p>
        </div>
      <% end %>
    </div>
    <% if @inspections.respond_to?(:total_pages) && @inspections.total_pages > 1 %>
      <div class="card-footer bg-white border-0 pt-0 pb-4">
        <%= paginate @inspections, theme: 'bootstrap-5' %>
      </div>
    <% end %>
  </div>
</div>

<style>
  /* Additional styling for better visibility */
  .card {
    transition: all 0.2s ease;
  }
  
  .card:hover {
    transform: translateY(-2px);
  }
  
  .table tbody tr:hover {
    background-color: #f8fafc;
  }
  
  .badge {
    font-weight: 500;
    font-size: 0.75rem;
  }
  
  /* Custom scrollbar for table */
  .table-responsive::-webkit-scrollbar {
    height: 8px;
  }
  
  .table-responsive::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }
  
  .table-responsive::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  
  .table-responsive::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>