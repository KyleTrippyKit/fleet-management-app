<%# app/views/vmcott/inspector/dashboard/index.html.erb %>
<div class="container-fluid px-4 py-5">

  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2 mb-1 fw-bold" style="color: #1e293b;">Inspector Dashboard</h1>
          <p class="text-muted mb-0">Quality Control & Inspection Management</p>
        </div>
        <div class="text-end">
          <div class="bg-white rounded-3 px-3 py-2 shadow-sm">
            <i class="bi bi-calendar3 me-2 text-primary"></i>
            <%= Time.current.strftime("%A, %B %d, %Y") %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 1: AWAITING INSPECTION -->
  <div id="pending-inspections" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 pb-0">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-hourglass-split me-2" style="color: #f59e0b;"></i>
            Awaiting Inspection
          </h5>
          <p class="text-muted small mb-0">Vehicles queued for initial diagnostic</p>
        </div>
        <span class="badge px-3 py-2 rounded-pill" style="background: #fef3c7; color: #b45309;">
          <i class="bi bi-clock me-1"></i> <%= @pending_inspections&.count || 0 %> Pending
        </span>
      </div>
    </div>
    <div class="card-body">
      <% if @pending_inspections&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="bg-light">
              <tr>
                <th class="border-0 py-3">#</th>
                <th class="border-0 py-3">Inspection ID</th>
                <th class="border-0 py-3">License Plate</th>
                <th class="border-0 py-3">Vehicle Details</th>
                <th class="border-0 py-3">Received</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
              <tbody>
                <% @pending_inspections.each_with_index do |inspection, index| %>
                  <tr class="<%= 'table-warning' if inspection.created_at > 1.hour.ago %>">
                    <td class="text-muted">#<%= index + 1 %></td>
                    <td class="fw-semibold">#<%= inspection.id %></td>
                    <td class="fw-semibold">
                      <span class="badge bg-secondary text-white px-3 py-2">
                        <%= inspection.vehicle&.license_plate || "Unknown" %>
                      </span>
                    </td>
                    <td>
                      <div><%= inspection.vehicle&.make %> <%= inspection.vehicle&.model %></div>
                      <small class="text-muted"><%= inspection.vehicle&.color %> • <%= inspection.vehicle&.year_of_manufacture %></small>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border px-3 py-2">
                        <%= time_ago_in_words(inspection.created_at) %> ago
                      </span>
                      <small class="d-block text-muted"><%= inspection.created_at.strftime("%I:%M %p") %></small>
                    </td>
                    <td class="text-end">
                      <%= link_to "Start Inspection", vmcott_inspector_pre_inspection_path(inspection.vehicle_id), 
                            class: "btn btn-primary btn-sm px-4 rounded-pill" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
            <h6 class="text-muted">No vehicles waiting for inspection</h6>
            <p class="small text-muted">All vehicles have been processed</p>
            <% if @recent_checkins&.any? %>
              <div class="alert alert-info mt-3 text-start">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Recently checked in (last 24 hours):</strong>
                <ul class="mt-2 mb-0">
                  <% @recent_checkins.each do |log| %>
                    <li>
                      <%= log.vehicle&.license_plate %> - 
                      <%= time_ago_in_words(log.received_at) %> ago
                      <% if log.inspection %>
                        <span class="badge bg-success ms-2">✓ Inspection #<%= log.inspection.id %></span>
                      <% else %>
                        <span class="badge bg-danger ms-2">⚠️ Missing inspection</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <div class="mt-3">
              <%= link_to "Go to Security Gate", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-primary btn-sm rounded-pill" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- SECTION 2: ACTIVE INSPECTIONS -->
    <div id="active-inspections" class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white border-0 pt-4 pb-0">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h5 class="mb-1 fw-bold" style="color: #1e293b;">
              <i class="bi bi-gear-wide-connected me-2" style="color: #3b82f6;"></i>
              Active Inspections
            </h5>
            <p class="text-muted small mb-0">Work currently in progress</p>
          </div>
          <span class="badge px-3 py-2 rounded-pill" style="background: #dbeafe; color: #1e40af;">
            <i class="bi bi-play-circle me-1"></i> <%= @in_progress&.count || 0 %> Active
          </span>
        </div>
      </div>
      <div class="card-body">
        <% if @in_progress&.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="bg-light">
                <tr>
                  <th class="border-0 py-3">#</th>
                  <th class="border-0 py-3">License Plate</th>
                  <th class="border-0 py-3">Vehicle Details</th>
                  <th class="border-0 py-3">Started</th>
                  <th class="border-0 py-3">Progress</th>
                  <th class="border-0 py-3 text-end">Action</th>
                 </thead>
                <tbody>
                  <% @in_progress.each_with_index do |inspection, index| %>
                    <% jobs_completed = inspection.inspection_jobs.where(completed_at: nil).count == 0 %>
                    <% total_jobs = inspection.inspection_jobs.count %>
                    <% completed_jobs = inspection.inspection_jobs.where.not(completed_at: nil).count %>
                    <% progress_percent = total_jobs > 0 ? (completed_jobs.to_f / total_jobs * 100).round : 0 %>
                    <tr>
                      <td class="text-muted">#<%= index + 1 %></td>
                      <td class="fw-semibold"><span class="badge bg-secondary text-white px-3 py-2"><%= inspection.vehicle&.license_plate || "Unknown" %></span></td>
                      <td>
                        <div><%= inspection.vehicle&.make %> <%= inspection.vehicle&.model %></div>
                        <small class="text-muted"><%= inspection.vehicle&.color %> • <%= inspection.vehicle&.year_of_manufacture %></small>
                      </td>
                      <td><span class="badge bg-light text-dark border px-3 py-2"><%= time_ago_in_words(inspection.updated_at) %> ago</span></td>
                      <td>
                        <% if jobs_completed %>
                          <span class="badge bg-success text-white px-3 py-2"><i class="bi bi-check-circle me-1"></i> Ready for Review</span>
                        <% else %>
                          <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 120px; height: 8px; background-color: #e2e8f0;">
                              <div class="progress-bar bg-primary" style="width: <%= progress_percent %>%; border-radius: 4px;"></div>
                            </div>
                            <span class="badge bg-info text-white px-2 py-1"><%= completed_jobs %>/<%= total_jobs %> jobs</span>
                          </div>
                        <% end %>
                      </td>
                      <td class="text-end">
                        <div class="btn-group btn-group-sm">
                          <%= link_to "Continue", vmcott_inspector_inspection_path(inspection), class: "btn btn-outline-primary btn-sm rounded-pill" %>
                          <%= button_to "Complete", complete_inspection_vmcott_inspector_inspection_path(inspection), method: :patch, class: "btn btn-success btn-sm rounded-pill ms-1", data: { confirm: "Mark this inspection as complete?" } %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-hourglass text-muted fs-1 mb-3 d-block"></i>
              <h6 class="text-muted">No active inspections</h6>
              <p class="small text-muted">Start an inspection from the waiting list</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- SECTION 3: WORKFLOW STATUS - CLICKABLE -->
      <div class="workflow-container rounded-4 mb-4" style="background: #ffffff; border: 1px solid #e2e8f0;">
        <div class="p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h5 class="mb-0 fw-bold" style="color: #1e293b;">
                <i class="bi bi-diagram-3 me-2" style="color: #3b82f6;"></i>
                Inspection Workflow Status
              </h5>
              <p class="text-muted small mt-1 mb-0">Real-time tracking of vehicles through the inspection lifecycle</p>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="bg-light rounded-pill px-3 py-1">
                <i class="bi bi-arrow-repeat me-1 text-primary"></i>
                <small class="text-muted">Auto-refresh every 30s</small>
              </div>
              <div class="text-muted small">
                <i class="bi bi-clock me-1"></i>
                Updated: <%= Time.current.strftime("%I:%M:%S %p") %>
              </div>
            </div>
          </div>
          
          <%
            pending_inspections = @pending_inspections&.count.to_i
            inspections_in_progress = @in_progress&.count.to_i
            qc_pending_count = @qc_pending&.count.to_i
            approved_for_repair = Inspection.where(status: 'approved_for_repair').count.to_i
            ready_for_pickup = Inspection.where(status: 'ready_for_pickup').count.to_i
            
            avg_inspection_time = 45
            estimated_wait = (pending_inspections * avg_inspection_time) / 60
            overall_status = if pending_inspections > 5
              'critical'
            elsif pending_inspections > 2
              'warning'
            elsif qc_pending_count > 3
              'warning'
            else
              'normal'
            end
          %>
          
          <div class="workflow-steps-wrapper">
            <div class="workflow-steps d-flex justify-content-between align-items-center">
              <% steps = [
                { 
                  name: 'Pending', 
                  count: pending_inspections,
                  active: pending_inspections > 0,
                  icon: 'bi-hourglass-split',
                  color: pending_inspections > 5 ? '#dc2626' : (pending_inspections > 2 ? '#f59e0b' : '#10b981'),
                  bg: pending_inspections > 5 ? '#fee2e2' : (pending_inspections > 2 ? '#fef3c7' : '#d1fae5'),
                  status: pending_inspections > 0 ? 'active' : 'complete',
                  detail: pending_inspections > 0 ? "#{pending_inspections} waiting" : "0 waiting",
                  tooltip: pending_inspections > 0 ? "Est. wait: #{estimated_wait} hours" : "Queue empty",
                  target: '#pending-inspections',
                  action: 'scroll'
                },
                { 
                  name: 'In Progress', 
                  count: inspections_in_progress,
                  active: inspections_in_progress > 0,
                  icon: 'bi-gear',
                  color: inspections_in_progress > 0 ? '#3b82f6' : '#94a3b8',
                  bg: inspections_in_progress > 0 ? '#dbeafe' : '#f1f5f9',
                  status: inspections_in_progress > 0 ? 'active' : 'idle',
                  detail: inspections_in_progress > 0 ? "#{inspections_in_progress} active" : "None",
                  tooltip: inspections_in_progress > 0 ? "Currently being worked on" : "No active work",
                  target: '#active-inspections',
                  action: 'scroll'
                },
                { 
                  name: 'QC Review', 
                  count: qc_pending_count,
                  active: qc_pending_count > 0,
                  icon: 'bi-clipboard-check',
                  color: qc_pending_count > 3 ? '#f59e0b' : (qc_pending_count > 0 ? '#8b5cf6' : '#94a3b8'),
                  bg: qc_pending_count > 3 ? '#fef3c7' : (qc_pending_count > 0 ? '#ede9fe' : '#f1f5f9'),
                  status: qc_pending_count > 0 ? 'active' : 'complete',
                  detail: qc_pending_count > 0 ? "#{qc_pending_count} need QC" : "All passed",
                  tooltip: qc_pending_count > 0 ? "Quality check required" : "QC complete",
                  target: '#qc-review',
                  action: 'scroll'
                },
                { 
                  name: 'Approved', 
                  count: approved_for_repair,
                  active: approved_for_repair > 0,
                  icon: 'bi-check-circle',
                  color: approved_for_repair > 0 ? '#10b981' : '#94a3b8',
                  bg: approved_for_repair > 0 ? '#d1fae5' : '#f1f5f9',
                  status: approved_for_repair > 0 ? 'active' : 'idle',
                  detail: approved_for_repair > 0 ? "#{approved_for_repair} approved" : "None",
                  tooltip: approved_for_repair > 0 ? "Ready for mechanic assignment" : "No approvals",
                  target: '/vmcott/inspector/recent_activity?status=approved_for_repair',
                  action: 'link'
                },
                { 
                  name: 'Ready', 
                  count: ready_for_pickup,
                  active: ready_for_pickup > 0,
                  icon: 'bi-truck',
                  color: ready_for_pickup > 0 ? '#6b7280' : '#94a3b8',
                  bg: ready_for_pickup > 0 ? '#f3f4f6' : '#f1f5f9',
                  status: ready_for_pickup > 0 ? 'active' : 'idle',
                  detail: ready_for_pickup > 0 ? "#{ready_for_pickup} ready" : "None",
                  tooltip: ready_for_pickup > 0 ? "Ready for customer pickup" : "No vehicles ready",
                  target: '/vmcott/inspector/recent_activity?status=ready_for_pickup',
                  action: 'link'
                }
              ] %>
              
              <% steps.each_with_index do |step, index| %>
                <div class="workflow-step-item text-center flex-grow-1 position-relative clickable-step" 
                     data-bs-toggle="tooltip" 
                     title="<%= step[:tooltip] %>"
                     data-target="<%= step[:target] %>"
                     data-action="<%= step[:action] %>"
                     data-step-name="<%= step[:name] %>"
                     style="cursor: pointer; transition: all 0.2s ease;">
                  <div class="step-wrapper">
                    <div class="step-circle <%= 'active' if step[:active] %>" 
                         style="background: <%= step[:active] ? step[:color] : '#e2e8f0' %>;
                                box-shadow: <%= step[:active] ? '0 4px 12px ' + step[:color] + '40' : 'none' %>;">
                      <i class="bi <%= step[:icon] %> text-white"></i>
                      <% if step[:count] > 0 %>
                        <span class="step-count-badge"><%= step[:count] %></span>
                      <% end %>
                    </div>
                    <div class="step-number small mt-2 text-muted">Step <%= index + 1 %></div>
                    <div class="step-label mt-1">
                      <strong class="d-block" style="color: #1e293b;"><%= step[:name] %></strong>
                      <span class="badge mt-1" style="background: <%= step[:bg] %>; color: <%= step[:color] %>;">
                        <%= step[:detail] %>
                      </span>
                    </div>
                  </div>
                  <% if index < 4 %>
                    <div class="step-connector <%= 'active-connector' if steps[index + 1][:status] == 'active' || step[:status] == 'active' %>"></div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Action Alert -->
          <div class="mt-4">
            <% if pending_inspections > 0 && @pending_inspections&.first %>
              <div class="alert <%= pending_inspections > 5 ? 'alert-danger' : 'alert-warning' %> border-0 rounded-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <div class="alert-icon me-3">
                    <i class="bi <%= pending_inspections > 5 ? 'bi-exclamation-octagon-fill' : 'bi-exclamation-triangle-fill' %> fs-4"></i>
                  </div>
                  <div>
                    <strong class="d-block"><%= pending_inspections > 5 ? '⚠️ HIGH BACKLOG - Immediate Action Required' : 'Action Required' %></strong>
                    <span><%= pending_inspections %> vehicle<%= 's' if pending_inspections > 1 %> waiting for initial inspection.</span>
                    <div class="small mt-1">
                      <i class="bi bi-clock me-1"></i> Estimated wait time: <%= estimated_wait %> hours
                      <% if pending_inspections > 5 %><span class="badge bg-danger ms-2">Exceeds SLA</span><% end %>
                    </div>
                  </div>
                </div>
                <%= link_to "Inspect #{@pending_inspections.first.vehicle&.license_plate}", 
                      vmcott_inspector_pre_inspection_path(@pending_inspections.first.vehicle_id),
                      class: "btn btn-primary btn-sm rounded-pill px-4" %>
              </div>
            <% elsif qc_pending_count > 3 %>
              <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <div class="alert-icon me-3"><i class="bi bi-clipboard2-check fs-4"></i></div>
                  <div>
                    <strong class="d-block">Quality Control Backlog</strong>
                    <span><%= qc_pending_count %> vehicles waiting for QC inspection.</span>
                  </div>
                </div>
                <%= link_to "View QC Queue", vmcott_inspector_qc_path(@qc_pending.first), class: "btn btn-warning btn-sm rounded-pill px-4" if @qc_pending&.first %>
              </div>
            <% elsif qc_pending_count > 0 %>
              <div class="alert alert-info border-0 rounded-3 d-flex align-items-center">
                <div class="alert-icon me-3"><i class="bi bi-info-circle-fill fs-4"></i></div>
                <div>
                  <strong class="d-block">Quality Check Needed</strong>
                  <span><%= qc_pending_count %> job<%= 's' if qc_pending_count > 1 %> completed repairs waiting for your quality inspection.</span>
                </div>
              </div>
            <% elsif approved_for_repair > 0 %>
              <div class="alert alert-success border-0 rounded-3 d-flex align-items-center">
                <div class="alert-icon me-3"><i class="bi bi-check-circle-fill fs-4"></i></div>
                <div>
                  <strong class="d-block">Inspection Complete</strong>
                  <span><%= approved_for_repair %> inspection<%= 's' if approved_for_repair > 1 %> approved. Mechanics can now begin repairs.</span>
                </div>
              </div>
            <% else %>
              <div class="alert alert-success border-0 rounded-3 d-flex align-items-center">
                <div class="alert-icon me-3"><i class="bi bi-check-all fs-4"></i></div>
                <div>
                  <strong class="d-block">All Caught Up!</strong>
                  <span>No pending work. Great job!</span>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Stats Row - Improved Colors -->
          <div class="row mt-4 g-3">
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3">
                <div class="rounded-circle bg-primary bg-opacity-15 p-2"><i class="bi bi-speedometer2 text-primary"></i></div>
                <div><div class="small text-muted">Today's Capacity</div><div class="fw-bold"><%= @recent_completed&.count || 0 %> / 8 inspections</div></div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3">
                <div class="rounded-circle bg-success bg-opacity-15 p-2"><i class="bi bi-clock-history text-success"></i></div>
                <div><div class="small text-muted">Avg. Inspection Time</div><div class="fw-bold">45 min</div></div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3">
                <div class="rounded-circle bg-info bg-opacity-15 p-2"><i class="bi bi-check2-circle text-info"></i></div>
                <div><div class="small text-muted">QC Pass Rate</div><div class="fw-bold">96%</div></div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3">
                <div class="rounded-circle bg-<%= overall_status == 'critical' ? 'danger' : (overall_status == 'warning' ? 'warning' : 'success') %> bg-opacity-15 p-2">
                  <i class="bi bi-activity text-<%= overall_status == 'critical' ? 'danger' : (overall_status == 'warning' ? 'warning' : 'success') %>"></i>
                </div>
                <div><div class="small text-muted">System Status</div><div class="fw-bold text-<%= overall_status == 'critical' ? 'danger' : (overall_status == 'warning' ? 'warning' : 'success') %>">
                  <%= overall_status == 'critical' ? 'High Load' : (overall_status == 'warning' ? 'Moderate Load' : 'Normal') %>
                </div></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 4: QUALITY CONTROL REVIEW -->
      <div id="qc-review" class="card border-0 shadow-lg mb-4" style="border-top: 4px solid #f59e0b;">
        <div class="card-header bg-white border-0 pt-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
              <h5 class="mb-1 fw-bold" style="color: #1e293b;">
                <i class="bi bi-clipboard2-check me-2" style="color: #f59e0b;"></i>
                Quality Control Review
              </h5>
              <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Final inspection after mechanic work</strong> - Verify repairs meet quality standards
              </p>
            </div>
            <span class="badge px-3 py-2 rounded-pill" style="background: #fef3c7; color: #b45309;">
              <i class="bi bi-exclamation-triangle me-1"></i> <%= @qc_pending&.count || 0 %> Pending
            </span>
          </div>
        </div>
        <div class="card-body">
          <% if @qc_pending&.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="bg-light">
                  <tr>
                    <th class="border-0 py-3">ID</th>
                    <th class="border-0 py-3">Vehicle</th>
                    <th class="border-0 py-3 text-center">Jobs</th>
                    <th class="border-0 py-3">Completed</th>
                    <th class="border-0 py-3">Parts Used</th>
                    <th class="border-0 py-3">Status</th>
                    <th class="border-0 py-3 text-end">Action</th>
                  </td>
                </thead>
                <tbody>
                  <% @qc_pending.each do |inspection| %>
                    <tr>
                      <td class="fw-semibold">#<%= inspection.id %></td>
                      <td>
                        <div><strong><%= inspection.vehicle&.license_plate || 'N/A' %></strong></div>
                        <small class="text-muted"><%= inspection.vehicle&.make %> <%= inspection.vehicle&.model %></small>
                      </td>
                      <td class="text-center"><span class="badge bg-secondary text-white px-3 py-1"><%= inspection.inspection_jobs.count %></span></td>
                      <td><span class="badge bg-success text-white px-3 py-1"><i class="bi bi-check-circle me-1"></i> <%= time_ago_in_words(inspection.updated_at) %> ago</span></td>
                      <td>
                        <% total_parts = inspection.total_parts_used %>
                        <% if total_parts > 0 %>
                          <div class="d-flex flex-column">
                            <span class="badge bg-info text-white px-3 py-1 mb-1">
                              <i class="bi bi-box-seam me-1"></i> <%= total_parts %> part(s) used
                            </span>
                          </div>
                        <% else %>
                          <span class="badge bg-secondary text-white px-3 py-1">
                            <i class="bi bi-box me-1"></i> No parts used
                          </span>
                        <% end %>
                      </td>
                      <td><span class="badge px-3 py-1" style="background: #fef3c7; color: #b45309;">Ready for QC</span></td>
                      <td class="text-end">
                        <%= link_to vmcott_inspector_qc_path(inspection), class: "btn btn-warning btn-sm px-3 rounded-pill" do %>
                          <i class="bi bi-clipboard2-check me-1"></i> Start QC
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
              <h6 class="text-muted">No QC pending</h6>
              <p class="small text-muted">All completed repairs have been verified</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 🔥 NEW SECTION 5: RECENTLY PASSED QC -->
      <div id="recent-qc-passed" class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #10b981;">
        <div class="card-header bg-white border-0 pt-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-1 fw-bold" style="color: #1e293b;">
                <i class="bi bi-check2-circle me-2 text-success"></i>
                Recently Passed QC
              </h5>
              <p class="text-muted small mb-0">Jobs that have passed quality control inspection and are ready for pickup</p>
            </div>
            <span class="badge bg-success px-3 py-2 rounded-pill">
              <i class="bi bi-calendar-check me-1"></i> <%= @recent_qc_passed&.count || 0 %> Today
            </span>
          </div>
        </div>
        <div class="card-body">
          <% if @recent_qc_passed&.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="bg-light">
                  <tr>
                    <th class="border-0 py-3">Job #</th>
                    <th class="border-0 py-3">Vehicle</th>
                    <th class="border-0 py-3">Passed At</th>
                    <th class="border-0 py-3">Inspector</th>
                    <th class="border-0 py-3">QC Notes</th>
                    <th class="border-0 py-3 text-end">Status</th>
                   </thead>
                  <tbody>
                    <% @recent_qc_passed.each do |job| %>
                      <tr class="table-success">
                        <td class="fw-semibold">#<%= job.id %></td>
                        <td>
                          <div><strong><%= job.inspection&.vehicle&.license_plate || 'N/A' %></strong></div>
                          <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                        </td>
                        <td>
                          <span class="badge bg-success text-white px-3 py-1">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <%= time_ago_in_words(job.qc_passed_at) %> ago
                          </span>
                          <br>
                          <small class="text-muted"><%= job.qc_passed_at&.strftime("%b %d, %Y • %I:%M %p") %></small>
                        </td>
                        <td><%= User.find_by(id: job.qc_passed_by_id)&.name || current_user&.name || 'You' %></td>
                        <td><%= job.qc_notes&.truncate(40) || 'No notes' %></td>
                        <td class="text-end">
                          <span class="badge bg-info text-white px-3 py-1">
                            <i class="bi bi-truck me-1"></i> Ready for Pickup
                          </span>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center py-5">
                <i class="bi bi-check-circle text-muted fs-1 mb-3 d-block"></i>
                <h6 class="text-muted">No QC passed today</h6>
                <p class="small text-muted">Vehicles that pass QC inspection will appear here</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- SECTION 6: RECENT ACTIVITY SUMMARY -->
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-white border-0 pt-4">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h5 class="mb-1 fw-bold" style="color: #1e293b;">
                  <i class="bi bi-activity me-2" style="color: #8b5cf6;"></i>
                  Today's Activity Summary
                </h5>
                <p class="text-muted small mb-0">Overview of your inspection activity for today</p>
              </div>
              <%= link_to "View All Activity", vmcott_inspector_recent_activity_path, class: "btn btn-sm btn-outline-secondary rounded-pill" %>
            </div>
          </div>
          <div class="card-body">
            <div class="row g-4">
              <div class="col-md-3">
                <div class="text-center p-3 bg-light rounded-3">
                  <div class="display-6 fw-bold text-primary"><%= @recent_completed&.count || 0 %></div>
                  <div class="small text-muted">Inspections Completed</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 bg-light rounded-3">
                  <div class="display-6 fw-bold text-success"><%= @qc_passed_today&.count || 0 %></div>
                  <div class="small text-muted">QC Passed</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 bg-light rounded-3">
                  <div class="display-6 fw-bold text-warning"><%= @qc_pending&.count || 0 %></div>
                  <div class="small text-muted">QC Pending</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 bg-light rounded-3">
                  <div class="display-6 fw-bold text-info"><%= @pending_inspections&.count || 0 %></div>
                  <div class="small text-muted">Awaiting Inspection</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      <style>
        /* Professional Color Scheme */
        .stats-card {
          background: white;
          transition: all 0.3s ease;
          border: 1px solid #e2e8f0;
          cursor: pointer;
        }
        .stats-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 12px 24px rgba(0,0,0,0.08);
          border-color: transparent;
        }
        .stats-icon {
          transition: all 0.3s ease;
        }
        .stats-card:hover .stats-icon {
          transform: scale(1.05);
        }
        .progress {
          background-color: #e2e8f0;
          border-radius: 8px;
          overflow: hidden;
        }
        .progress-bar {
          border-radius: 8px;
          transition: width 0.3s ease;
        }
        
        /* Clickable steps styling */
        .clickable-step {
          cursor: pointer;
          transition: transform 0.2s ease, opacity 0.2s ease;
        }
        .clickable-step:hover {
          transform: scale(1.02);
          opacity: 0.95;
        }
        .clickable-step:active {
          transform: scale(0.98);
        }
        
        /* Badge Styles - Improved Visibility */
        .badge.bg-light {
          background-color: #f8fafc !important;
          border: 1px solid #e2e8f0;
          color: #1e293b !important;
        }
        .badge.bg-secondary {
          background-color: #475569 !important;
          color: white !important;
        }
        .badge.bg-success {
          background-color: #059669 !important;
          color: white !important;
        }
        .badge.bg-info {
          background-color: #0891b2 !important;
          color: white !important;
        }
        .badge.bg-warning-custom {
          background-color: #f59e0b !important;
          color: white !important;
        }
        
        /* Border badge for time indicators */
        .badge.border {
          background-color: #ffffff !important;
          border: 1px solid #e2e8f0 !important;
          color: #475569 !important;
          font-weight: 500;
        }
        
        .workflow-container {
          background: #ffffff;
          border: 1px solid #e2e8f0;
        }
        .workflow-steps-wrapper {
          padding: 1rem 0;
        }
        .workflow-steps {
          position: relative;
        }
        .workflow-step-item {
          position: relative;
          z-index: 2;
        }
        .step-circle {
          width: 64px;
          height: 64px;
          margin: 0 auto;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.3s ease;
          background: #e2e8f0;
          position: relative;
        }
        .step-circle.active {
          transform: scale(1.08);
          animation: pulse 2s infinite;
        }
        .step-count-badge {
          position: absolute;
          top: -8px;
          right: -8px;
          background: #ef4444;
          color: white;
          border-radius: 20px;
          padding: 2px 6px;
          font-size: 10px;
          font-weight: bold;
        }
        @keyframes pulse {
          0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
          70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
          100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
        }
        .step-circle i { font-size: 1.5rem; }
        .step-connector {
          position: absolute;
          top: 32px;
          left: 50%;
          width: calc(100% - 64px);
          height: 3px;
          background: #e2e8f0;
          z-index: 1;
        }
        .step-connector.active-connector {
          background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        }
        .step-number { font-size: 0.7rem; font-weight: 600; }
        .step-label { font-size: 0.85rem; }
        .alert-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
        
        /* Opacity helpers */
        .bg-opacity-15 {
          --bs-bg-opacity: 0.15;
        }
        
        .table > :not(caption) > * > * { padding: 0.75rem 0.75rem; }
        .bg-light th { 
          background-color: #f8fafc !important;
          font-weight: 600;
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          color: #475569;
        }
        [data-bs-toggle="tooltip"] { cursor: help; }
        
        /* Card styling */
        .card {
          border-radius: 16px !important;
          overflow: hidden;
        }
        
        .card-header {
          background: white !important;
        }
        
        @media (max-width: 992px) {
          .step-connector { display: none; }
          .workflow-steps { flex-wrap: wrap; gap: 1.5rem; }
          .workflow-step-item { flex: 0 0 calc(33.333% - 1rem); }
        }
        @media (max-width: 768px) {
          .step-circle { width: 52px; height: 52px; }
          .step-circle i { font-size: 1.25rem; }
          .workflow-step-item { flex: 0 0 calc(50% - 1rem); }
          .step-connector { display: none; }
        }
      </style>

      <!-- JavaScript for Clickable Steps -->
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Make workflow steps clickable
          const clickableSteps = document.querySelectorAll('.clickable-step');
          
          clickableSteps.forEach(step => {
            step.addEventListener('click', function(e) {
              const target = this.getAttribute('data-target');
              const action = this.getAttribute('data-action');
              const stepName = this.getAttribute('data-step-name');
              
              console.log(`Clicked ${stepName} - Action: ${action}, Target: ${target}`);
              
              if (action === 'scroll' && target) {
                // Scroll to the target element
                const targetElement = document.querySelector(target);
                if (targetElement) {
                  targetElement.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'start',
                    inline: 'nearest'
                  });
                  // Add a highlight effect
                  targetElement.style.transition = 'box-shadow 0.3s ease';
                  targetElement.style.boxShadow = '0 0 0 3px #3b82f6, 0 0 0 6px rgba(59,130,246,0.2)';
                  setTimeout(() => {
                    targetElement.style.boxShadow = '';
                  }, 1500);
                } else {
                  console.warn(`Target element not found: ${target}`);
                }
              } else if (action === 'link' && target) {
                // Navigate to the link
                window.location.href = target;
              }
            });
          });
        });
      </script>