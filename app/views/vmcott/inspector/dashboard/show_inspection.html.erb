<%# app/views/vmcott/inspector/dashboard/show_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">🔍 Inspection Details</h1>
          <p class="text-muted">VMCOTT Inspector - Inspection #<%= @inspection.id %></p>
        </div>
        <div>
          <%= link_to "← Back to Dashboard", vmcott_inspector_dashboard_path, class: "btn btn-outline-secondary me-2" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="alert <%= @inspection.completed_at.present? ? 'alert-success' : 'alert-primary' %> mb-4">
    <div class="d-flex align-items-center">
      <i class="bi <%= @inspection.completed_at.present? ? 'bi-check-circle-fill' : 'bi-clock-fill' %> fs-3 me-3"></i>
      <div>
        <strong>Status:</strong> <%= @inspection.completed_at.present? ? 'Completed' : 'In Progress' %>
        <% if @inspection.completed_at %>
          <br><small>Completed: <%= @inspection.completed_at.strftime("%B %d, %Y at %I:%M %p") %></small>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <!-- Vehicle Information Card -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Vehicle Information</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>License Plate:</th>
                  <td><%= @inspection.vehicle.license_plate %></td>
                </tr>
                <tr>
                  <th>Make/Model:</th>
                  <td><%= @inspection.vehicle.make %> <%= @inspection.vehicle.model %></td>
                </tr>
                <tr>
                  <th>Year:</th>
                  <td><%= @inspection.vehicle.year_of_manufacture %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Mileage at Inspection:</th>
                  <td>
                    <% if @inspection.mileage_at_inspection.present? %>
                      <%= number_with_delimiter(@inspection.mileage_at_inspection) %> km
                    <% else %>
                      <span class="text-muted">Not recorded</span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Inspected By:</th>
                  <td><%= @inspection.inspector&.name || 'Unknown' %></td>
                </tr>
                <tr>
                  <th>Inspection Date:</th>
                  <td><%= @inspection.created_at.strftime("%B %d, %Y") %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Inspection Notes Card -->
      <% if @inspection.notes.present? %>
        <div class="card mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Inspection Notes</h5>
          </div>
          <div class="card-body">
            <p class="mb-0"><%= simple_format(@inspection.notes) %></p>
          </div>
        </div>
      <% end %>

      <!-- Inspection Jobs Card -->
      <% if @inspection.inspection_jobs.any? %>
        <div class="card mb-4">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Recommended Jobs</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Job</th>
                    <th>Description</th>
                    <th>Labor Cost</th>
                    <th>Parts Cost</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  <% @inspection.inspection_jobs.each do |job| %>
                    <tr>
                      <td>
                        <% if job.job_template.present? %>
                          <strong><%= job.job_template.name %></strong>
                          <div class="small text-muted">Template</div>
                        <% else %>
                          <strong>Custom Job</strong>
                        <% end %>
                      </td>
                      <td><%= job.description || job.job_template&.description %></td>
                      <td><%= number_to_currency(job.estimated_labor_cost) %></td>
                      <td><%= number_to_currency(job.estimated_parts_cost) %></td>
                      <td><strong><%= number_to_currency(job.estimated_total) %></strong></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="4" class="text-end">Total Estimated Cost:</th>
                    <th><%= number_to_currency(@inspection.total_estimated_cost) %></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Next Service Recommendation -->
      <% if @inspection.next_service_mileage.present? || @inspection.next_service_date.present? %>
        <div class="card mb-4">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Next Service Recommendation</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% if @inspection.next_service_mileage.present? %>
                <div class="col-md-6">
                  <strong>Service at:</strong> <%= number_with_delimiter(@inspection.next_service_mileage) %> km
                </div>
              <% end %>
              <% if @inspection.next_service_date.present? %>
                <div class="col-md-6">
                  <strong>or by:</strong> <%= @inspection.next_service_date.strftime("%B %d, %Y") %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <!-- Quick Actions Card -->
      <div class="card mb-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <% if @inspection.inspection_jobs.any? && @inspection.purchase_order.blank? %>
              <%= button_to "Create Purchase Order", 
                    create_po_vmcott_inspector_inspection_path(@inspection), 
                    method: :post,
                    class: "btn btn-warning btn-lg",
                    data: { confirm: "Create a purchase order from these inspection jobs?" } %>
            <% end %>
            
            <% if @inspection.purchase_order.present? %>
              <%= link_to "View Purchase Order", 
                    purchase_order_path(@inspection.purchase_order), 
                    class: "btn btn-info btn-lg" %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Timeline Card -->
      <div class="card">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-3">
              <i class="bi bi-plus-circle text-primary me-2"></i>
              <strong>Created:</strong><br>
              <small class="text-muted"><%= @inspection.created_at.strftime("%B %d, %Y at %I:%M %p") %></small>
            </li>
            <% if @inspection.completed_at %>
              <li class="mb-3">
                <i class="bi bi-check-circle text-success me-2"></i>
                <strong>Completed:</strong><br>
                <small class="text-muted"><%= @inspection.completed_at.strftime("%B %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>