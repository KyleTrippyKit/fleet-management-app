<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">✏️ Edit Purchase Request #<%= @purchase_request.id %></h1>
      <%= link_to "← Back", vmcott_purchase_request_path(@purchase_request), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Edit Purchase Request</h5>
        </div>
        <div class="card-body">
          <%= form_with model: @purchase_request, url: vmcott_purchase_request_path(@purchase_request), method: :patch, local: true do |f| %>
            <% if @purchase_request.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@purchase_request.errors.count, "error") %> prohibited this purchase request from being saved:</h6>
                <ul class="mb-0">
                  <% @purchase_request.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :part_id, "Part", class: "form-label fw-bold" %>
              <%= f.collection_select :part_id, Part.active.order(:name), :id, :name_with_details, 
                  { include_blank: "Select a part..." }, 
                  { class: "form-select", required: true } %>
            </div>

            <div class="mb-3">
              <%= f.label :quantity, "Quantity", class: "form-label fw-bold" %>
              <%= f.number_field :quantity, class: "form-control", min: 1, required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :urgency, "Urgency", class: "form-label fw-bold" %>
              <%= f.select :urgency, 
                  ['normal', 'high', 'urgent'], 
                  {}, 
                  { class: "form-select", required: true } %>
            </div>

            <div class="mb-3">
              <%= f.label :needed_by_date, "Needed By Date", class: "form-label fw-bold" %>
              <%= f.date_field :needed_by_date, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :notes, "Notes", class: "form-label fw-bold" %>
              <%= f.text_area :notes, class: "form-control", rows: 3 %>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <%= link_to "Cancel", vmcott_purchase_request_path(@purchase_request), class: "btn btn-outline-secondary" %>
              <%= f.submit "Update Purchase Request", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>