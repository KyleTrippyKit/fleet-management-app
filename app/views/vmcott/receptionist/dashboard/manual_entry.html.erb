<div class="container-fluid py-4" data-controller="alert-search">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">📝 Manual Vehicle Entry</h1>
      <%= link_to "← Back to Dashboard", vmcott_receptionist_dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Vehicle Reception</h5>
        </div>
        <div class="card-body">
          <%= form_tag vmcott_receptionist_receive_vehicle_path, method: :post, id: "vehicle-reception-form" do %>
            
            <!-- Option 1: Vehicle Search -->
            <div class="mb-4 p-3 border rounded">
              <label class="form-label fw-bold fs-5">🔍 Option 1: Search for Existing Vehicle</label>
              <p class="small text-muted mb-3">Search by license plate, make, or model (type at least 2 characters)</p>

              <div class="position-relative">
                <input type="text"
                       class="form-control form-control-lg"
                       placeholder="Start typing to search for a vehicle..."
                       autocomplete="off"
                       data-alert-search-target="vehicleInput"
                       data-action="input->alert-search#vehicleInput"
                       data-search-url="<%= search_vehicles_path(format: :json) %>">

                <%= hidden_field_tag :vehicle_id, nil, data: { alert_search_target: "vehicleHidden" } %>

                <!-- Search results dropdown -->
                <div class="list-group position-absolute w-100 shadow"
                     style="z-index: 1055; display:none;"
                     data-alert-search-target="vehicleResults">
                  <div data-alert-search-target="vehicleList"></div>
                </div>

                <!-- Selected vehicle chip -->
                <div class="mt-2" style="display:none;" data-alert-search-target="vehicleSelected">
                  <div class="alert alert-success py-2 mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Selected:</strong>
                    <span data-alert-search-target="vehicleSelectedText"></span>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger float-end"
                            data-action="click->alert-search#clearVehicle">
                      <i class="bi bi-x"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="text-center my-4">
              <span class="badge bg-secondary p-3 rounded-circle">OR</span>
            </div>

            <!-- Option 2: Purchase Order with Vehicle -->
            <div class="mb-4 p-3 border rounded">
              <label class="form-label fw-bold fs-5">📋 Option 2: Select Purchase Order with Vehicle</label>
              <p class="small text-muted mb-3">Choose a PO that already has a vehicle assigned</p>
              
              <%= select_tag :purchase_order_id, 
                  options_from_collection_for_select(@purchase_orders_with_vehicles, :id, :po_number_with_vehicle_info), 
                  include_blank: "-- Select a Purchase Order --", 
                  class: "form-select form-select-lg" %>
              
              <small class="text-muted mt-2 d-block">
                <i class="bi bi-info-circle"></i>
                Only POs with assigned vehicles are shown. The vehicle will be automatically selected.
              </small>
            </div>

            <hr class="my-4">

            <!-- Driver Name (Always Required) -->
            <div class="mb-4">
              <label for="driver_name" class="form-label fw-bold fs-5">👤 Driver Name <span class="text-danger">*</span></label>
              <%= text_field_tag :driver_name, nil, 
                  class: "form-control form-control-lg", 
                  required: true, 
                  placeholder: "Enter driver's full name",
                  id: "driver_name" %>
            </div>

            <!-- Notes (Optional) -->
            <div class="mb-4">
              <label for="notes" class="form-label fw-bold">📝 Notes (optional)</label>
              <%= text_area_tag :notes, nil, 
                  class: "form-control", 
                  rows: 2, 
                  placeholder: "Any additional information about this reception..." %>
            </div>

            <!-- Validation Summary -->
            <div id="validation-summary" class="alert alert-warning mt-3" style="display:none;">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <span id="validation-message"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <%= link_to "Cancel", vmcott_receptionist_dashboard_path, class: "btn btn-outline-secondary btn-lg" %>
              <%= submit_tag "Receive Vehicle", 
                  class: "btn btn-primary btn-lg px-5", 
                  data: { disable_with: "Processing..." } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('vehicle-reception-form');
    const vehicleHidden = document.querySelector('[data-alert-search-target="vehicleHidden"]');
    const vehicleSelected = document.querySelector('[data-alert-search-target="vehicleSelected"]');
    const poSelect = document.querySelector('select[name="purchase_order_id"]');
    const driverNameInput = document.getElementById('driver_name');
    const validationSummary = document.getElementById('validation-summary');
    const validationMessage = document.getElementById('validation-message');
    
    // Function to validate form before submission
    function validateForm() {
      const vehicleSelectedViaSearch = vehicleHidden.value && vehicleSelected.style.display === 'block';
      const poSelected = poSelect && poSelect.value && poSelect.value !== '';
      const driverName = driverNameInput.value.trim();
      
      // Check if driver name is provided
      if (!driverName) {
        validationMessage.textContent = 'Please enter the driver name.';
        validationSummary.style.display = 'block';
        validationSummary.className = 'alert alert-warning mt-3';
        return false;
      }
      
      // Check if either vehicle is selected OR PO is selected
      if (!vehicleSelectedViaSearch && !poSelected) {
        validationMessage.textContent = 'Please select a vehicle (either by searching or by selecting a Purchase Order with an associated vehicle).';
        validationSummary.style.display = 'block';
        validationSummary.className = 'alert alert-warning mt-3';
        return false;
      }
      
      // If PO is selected, show info
      if (poSelected) {
        validationSummary.style.display = 'none';
        return true;
      }
      
      validationSummary.style.display = 'none';
      return true;
    }
    
    // Add validation on form submit
    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        return false;
      }
    });
    
    // Add validation on vehicle selection
    if (vehicleHidden) {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.attributeName === 'style' && vehicleSelected.style.display === 'block') {
            // Clear PO selection when vehicle is selected
            if (poSelect) poSelect.value = '';
          }
        });
      });
      
      observer.observe(vehicleSelected, { attributes: true });
    }
    
    // Add validation on PO selection
    if (poSelect) {
      poSelect.addEventListener('change', function() {
        if (this.value) {
          // Clear vehicle selection when PO is selected
          if (vehicleHidden) vehicleHidden.value = '';
          if (vehicleSelected) vehicleSelected.style.display = 'none';
          if (document.querySelector('[data-alert-search-target="vehicleInput"]')) {
            document.querySelector('[data-alert-search-target="vehicleInput"]').value = '';
          }
        }
      });
    }
    
    // Real-time driver name validation
    if (driverNameInput) {
      driverNameInput.addEventListener('input', function() {
        if (this.value.trim()) {
          validationSummary.style.display = 'none';
        }
      });
    }
  });
</script>

<style>
.search-result-item { 
  cursor: pointer; 
  padding: 0.75rem 1rem;
  border-left: 3px solid transparent;
  transition: all 0.2s;
}
.search-result-item:hover { 
  background-color: #f8f9fa;
  border-left-color: #0d6efd;
}

[data-alert-search-target="vehicleResults"] {
  max-height: 300px;
  overflow-y: auto;
  background: white;
  border-radius: 0 0 0.5rem 0.5rem;
  border: 1px solid rgba(0,0,0,0.1);
  border-top: none;
}

.badge.p-3 {
  font-size: 1rem;
}
</style>