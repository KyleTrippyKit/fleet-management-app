<%# app/views/vmcott/parts_requests/show.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-box-seam me-2"></i>
      Parts Request #<%= @parts_request.id %>
    </h1>
    <div>
      <%= link_to "← Back to Dashboard", vmcott_inventory_manager_dashboard_path, class: "btn btn-outline-secondary me-2" %>
      <%= link_to "All Parts Requests", vmcott_parts_requests_path, class: "btn btn-outline-primary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <!-- Main Details Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Request Details</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Status:</th>
                  <td>
                    <% status_badge = @parts_request.respond_to?(:status_badge_class) ? @parts_request.status_badge_class : 'secondary' %>
                    <% status_display = @parts_request.respond_to?(:status_display) ? @parts_request.status_display : @parts_request.status.humanize %>
                    <span class="badge bg-<%= status_badge %>">
                      <%= status_display %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <th>In Stock?:</th>
                  <td>
                    <% in_stock = @parts_request.respond_to?(:in_stock?) ? @parts_request.in_stock? : @parts_request.in_stock %>
                    <% if in_stock %>
                      <span class="badge bg-success">Yes</span>
                    <% else %>
                      <span class="badge bg-danger">No</span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Quantity:</th>
                  <td><%= @parts_request.quantity %></td>
                </tr>
                <tr>
                  <th>Created:</th>
                  <td><%= @parts_request.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
                </tr>
                <tr>
                  <th>Last Updated:</th>
                  <td><%= time_ago_in_words(@parts_request.updated_at) %> ago</td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Inspection #:</th>
                  <td>
                    <% if @inspection.present? %>
                      <% inspection_path = defined?(vmcott_inspector_inspection_path) ? vmcott_inspector_inspection_path(@inspection) : '#' %>
                      <%= link_to @inspection.id, inspection_path, target: "_blank" %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Vehicle:</th>
                  <td>
                    <% if @vehicle.present? %>
                      <strong><%= @vehicle.license_plate %></strong><br>
                      <small><%= @vehicle.make %> <%= @vehicle.model %></small>
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Job:</th>
                  <td>
                    <% if @parts_request.inspection_job.present? %>
                      <% job_path = defined?(vmcott_mechanic_job_path) ? vmcott_mechanic_job_path(@parts_request.inspection_job) : '#' %>
                      <%= link_to @parts_request.inspection_job.description.to_s.truncate(30), job_path, target: "_blank" %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Purchase Order:</th>
                  <td>
                    <% if @purchase_order.present? %>
                      <% po_path = defined?(purchase_order_path) ? purchase_order_path(@purchase_order) : '#' %>
                      <%= link_to @purchase_order.po_number, po_path, target: "_blank" %>
                    <% else %>
                      <span class="text-muted">Not created yet</span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
          </div>
          
          <!-- Part Information -->
          <div class="mt-3 p-3 bg-light rounded">
            <h6 class="fw-bold mb-3">Part Information</h6>
            <div class="row">
              <div class="col-md-6">
                <strong>Name:</strong> 
                <%= @parts_request.part&.name || @parts_request.custom_part_name || 'N/A' %>
              </div>
              <div class="col-md-6">
                <strong>Part #:</strong> 
                <%= @parts_request.part&.part_number || 'N/A' %>
              </div>
              <% if @parts_request.part.present? %>
                <div class="col-md-6 mt-2">
                  <strong>Current Stock:</strong> 
                  <% stock_class = @parts_request.part.current_stock.to_i <= @parts_request.part.reorder_point.to_i ? 'danger' : 'success' %>
                  <span class="badge bg-<%= stock_class %>">
                    <%= @parts_request.part.current_stock %> units
                  </span>
                </div>
                <div class="col-md-6 mt-2">
                  <strong>Reorder Point:</strong> 
                  <%= @parts_request.part.reorder_point %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <!-- Action Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-gear me-2"></i> Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            
            <!-- Mark In Stock - For parts that are already in inventory -->
            <% if @parts_request.status == 'pending' && (@parts_request.respond_to?(:in_stock?) ? @parts_request.in_stock? : @parts_request.in_stock) %>
              <% if defined?(vmcott_inventory_manager_mark_in_stock_path) %>
                <%= form_with url: vmcott_inventory_manager_mark_in_stock_path(@parts_request.id), 
                              method: :post, 
                              local: true,
                              data: { turbo: false } do |f| %>
                  <%= f.submit "✓ Mark In Stock", 
                      class: "btn btn-success w-100 mb-2",
                      data: { confirm: "Mark this part as in-stock?" } %>
                <% end %>
              <% end %>
            <% end %>
            
            <!-- Send to Procurement - For parts that need to be ordered -->
            <% if @parts_request.status == 'pending' && !(@parts_request.respond_to?(:in_stock?) ? @parts_request.in_stock? : @parts_request.in_stock) %>
              <% if defined?(vmcott_inventory_manager_send_to_procurement_path) %>
                <%= form_with url: vmcott_inventory_manager_send_to_procurement_path(@parts_request.id), 
                              method: :post, 
                              local: true,
                              data: { turbo: false } do |f| %>
                  <%= f.submit "📤 Send to Procurement", 
                      class: "btn btn-warning w-100 mb-2",
                      data: { confirm: "Send this part to procurement team?" } %>
                <% end %>
              <% end %>
            <% end %>
            
            <!-- Create RFQ - After procurement is notified -->
            <% if @parts_request.part.present? && @parts_request.status == 'parts_coordinator_notified' %>
              <% if defined?(vmcott_inventory_manager_create_rfq_path) %>
                <%= link_to "📋 Create RFQ", 
                    vmcott_inventory_manager_create_rfq_path(parts_request_id: @parts_request.id),
                    class: "btn btn-primary w-100 mb-2" %>
              <% end %>
            <% end %>
            
            <!-- View Purchase Order - If PO exists -->
            <% if @purchase_order.present? %>
              <% po_path = defined?(purchase_order_path) ? purchase_order_path(@purchase_order) : '#' %>
              <%= link_to "📦 View PO", 
                  po_path,
                  class: "btn btn-outline-secondary w-100 mb-2" %>
            <% end %>
            
            <!-- Back to Dashboard -->
            <hr>
            <%= link_to "🏠 Return to Dashboard", 
                defined?(vmcott_inventory_manager_dashboard_path) ? vmcott_inventory_manager_dashboard_path : '#',
                class: "btn btn-outline-primary w-100" %>
          </div>
        </div>
      </div>

      <!-- Timeline Card -->
      <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i> Timeline</h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <div class="list-group-item">
              <small class="text-muted d-block">Created</small>
              <strong><%= @parts_request.created_at.strftime("%b %d, %Y at %I:%M %p") %></strong>
            </div>
            
            <% if @parts_request.respond_to?(:sent_to_procurement_at) && @parts_request.sent_to_procurement_at.present? %>
              <div class="list-group-item">
                <small class="text-muted d-block">Sent to Procurement</small>
                <strong><%= @parts_request.sent_to_procurement_at.strftime("%b %d, %Y at %I:%M %p") %></strong>
              </div>
            <% end %>
            
            <% if @purchase_order.present? && @purchase_order.respond_to?(:ordered_at) && @purchase_order.ordered_at.present? %>
              <div class="list-group-item">
                <small class="text-muted d-block">Ordered</small>
                <strong><%= @purchase_order.ordered_at.strftime("%b %d, %Y at %I:%M %p") %></strong>
              </div>
            <% end %>
            
            <% if @purchase_order.present? && @purchase_order.respond_to?(:received_at) && @purchase_order.received_at.present? %>
              <div class="list-group-item">
                <small class="text-muted d-block">Received</small>
                <strong><%= @purchase_order.received_at.strftime("%b %d, %Y at %I:%M %p") %></strong>
              </div>
            <% end %>
            
            <% if @parts_request.respond_to?(:parts_received?) && @parts_request.parts_received? && @parts_request.respond_to?(:parts_received_at) && @parts_request.parts_received_at.present? %>
              <div class="list-group-item">
                <small class="text-muted d-block">Parts Received</small>
                <strong><%= @parts_request.parts_received_at.strftime("%b %d, %Y at %I:%M %p") %></strong>
              </div>
            <% end %>
            
            <% if @parts_request.updated_at != @parts_request.created_at %>
              <div class="list-group-item">
                <small class="text-muted d-block">Last Updated</small>
                <strong><%= time_ago_in_words(@parts_request.updated_at) %> ago</strong>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript to ensure POST requests work properly -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Log all form submissions
    document.querySelectorAll('form').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        console.log('Form submitted:', {
          action: this.action,
          method: this.method,
          turbo: this.dataset.turbo
        });
      });
    });
  });
</script>

<style>
  .table-sm th {
    width: 120px;
    color: #6c757d;
    font-weight: 500;
  }
  
  .table-sm td {
    font-weight: 500;
  }
  
  .bg-light {
    background-color: #f8f9fa !important;
  }
  
  /* Ensure buttons take full width and have proper spacing */
  .btn, form {
    width: 100%;
  }
  
  form .btn {
    margin-bottom: 0.5rem;
  }
  
  .btn:last-child {
    margin-bottom: 0;
  }
</style>