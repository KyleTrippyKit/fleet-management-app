<%# app/views/vmcott/mechanic/jobs/completed.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">✅ Completed Jobs</h1>
          <p class="text-muted">Jobs you have completed</p>
        </div>
        <%= link_to "← Back to Dashboard", vmcott_mechanic_dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0">Completed Jobs (<%= @jobs.count %>)</h5>
    </div>
    <div class="card-body">
      <% if @jobs.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Job #</th>
                <th>Vehicle</th>
                <th>Description</th>
                <th>Completed</th>
                <th>QC Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @jobs.each do |job| %>
                <tr>
                  <td><strong>#<%= job.id %></strong></td>
                  <td>
                    <%= job.inspection&.vehicle&.license_plate || 'Unknown' %>
                    <br><small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.description&.truncate(50) %></td>
                  <td><%= time_ago_in_words(job.completed_at) if job.completed_at %> ago</td>
                  <td>
                    <% if job.inspection&.status == 'qc_completed' %>
                      <span class="badge bg-success">Passed</span>
                    <% elsif job.inspection&.status == 'ready_for_qc' %>
                      <span class="badge bg-warning">Pending QC</span>
                    <% else %>
                      <span class="badge bg-secondary">Waiting</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to "View", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted text-center py-4">No completed jobs yet.</p>
      <% end %>
    </div>
  </div>
</div>