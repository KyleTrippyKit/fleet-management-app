<%# app/views/vmcott/mechanic/jobs/assigned.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">🔧 My Assigned Jobs</h1>
          <p class="text-muted">Jobs currently assigned to you</p>
        </div>
        <%= link_to "← Back to Dashboard", vmcott_mechanic_dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Assigned Jobs (<%= @jobs.count %>)</h5>
    </div>
    <div class="card-body">
      <% if @jobs.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Job #</th>
                <th>Vehicle</th>
                <th>Description</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @jobs.each do |job| %>
                <% assignment = job.mechanic_assignments.find_by(mechanic_id: current_user.id) %>
                <tr>
                  <td><strong>#<%= job.id %></strong></td>
                  <td>
                    <%= job.inspection&.vehicle&.license_plate || 'Unknown' %>
                    <br><small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.description&.truncate(50) %></td>
                  <td>
                    <span class="badge bg-<%= job.priority == 'high' ? 'danger' : 'info' %>">
                      <%= job.priority&.humanize || 'Normal' %>
                    </span>
                  </td>
                  <td>
                    <% if job.completed_at %>
                      <span class="badge bg-success">Completed</span>
                    <% elsif assignment&.started_at %>
                      <span class="badge bg-warning">In Progress</span>
                    <% else %>
                      <span class="badge bg-secondary">Assigned</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to "View", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted text-center py-4">No jobs assigned to you at the moment.</p>
      <% end %>
    </div>
  </div>
</div>