<%# app/views/vmcott/mechanic/jobs/verify.html.erb %>
<div class="container">
  <h2>Verify Job: <%= @job.description %></h2>
  
  <div class="card mb-4">
    <div class="card-header bg-info">
      Inspector's Notes
    </div>
    <div class="card-body">
      <%= @job.inspection.notes %>
      <hr>
      <strong>Suspected Parts:</strong>
      <ul>
        <% @job.inspection_job_parts.each do |part| %>
          <li><%= part.part&.name || part.custom_part_name %> (x<%= part.quantity %>)</li>
        <% end %>
      </ul>
    </div>
  </div>
  
  <%= form_with model: @job, url: verify_mechanic_job_path(@job) do |f| %>
    <div class="form-group mb-3">
      <%= f.label :verification_status, "Verification Result" %>
      <%= f.select :verification_status, 
            [
              ['✅ Verified - Issue Confirmed', 'verified'],
              ['❌ Not Found - No Issue', 'rejected'],
              ['⚠️ Different Issue Found', 'different']
            ],
            { prompt: 'Select verification result' },
            class: 'form-select' %>
    </div>
    
    <div class="form-group mb-3">
      <%= f.label :mechanic_notes, "Mechanic's Findings" %>
      <%= f.text_area :mechanic_notes, rows: 4, class: 'form-control',
            placeholder: 'Describe what you actually found...' %>
    </div>
    
    <div id="different-issue-fields" style="display: none;">
      <h5>What's the correct issue?</h5>
      <%= f.fields_for :corrected_job do |cj| %>
        <div class="form-group mb-3">
          <%= cj.label :description, "Correct Job Description" %>
          <%= cj.text_field :description, class: 'form-control' %>
        </div>
        
        <div class="form-group mb-3">
          <%= cj.label :parts_needed, "Parts Actually Needed" %>
          <div id="mechanic-parts-container">
            <!-- Dynamic part addition here -->
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary add-mechanic-part">
            Add Part
          </button>
        </div>
      <% end %>
    </div>
    
    <%= f.submit "Submit Verification", class: "btn btn-primary" %>
  <% end %>
</div>

<script>
document.querySelector('[name="inspection_job[verification_status]"]').addEventListener('change', function() {
  document.getElementById('different-issue-fields').style.display = 
    this.value === 'different' ? 'block' : 'none';
});
</script>