<%# app/views/vmcott/mechanic/dashboard/show_job.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">🔧 Work Order Details</h1>
          <p class="text-muted">Job #<%= @job&.id %></p>
        </div>
        <%= link_to "← Back to Dashboard", vmcott_mechanic_dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="alert <%= 
    case @assignment&.status
    when 'in_progress' then 'alert-primary'
    when 'completed' then 'alert-success'
    when 'assigned' then 'alert-warning'
    else 'alert-secondary'
    end %> mb-4">
    <div class="d-flex align-items-center">
      <i class="bi <%= 
        case @assignment&.status
        when 'in_progress' then 'bi-gear-fill'
        when 'completed' then 'bi-check-circle-fill'
        when 'assigned' then 'bi-clock-fill'
        else 'bi-info-circle-fill'
        end %> fs-3 me-3"></i>
      <div>
        <strong>Status:</strong> <%= @assignment&.status&.humanize || (@job.assigned_mechanic_id.nil? ? 'Available' : 'Pending') %>
        <% if @assignment&.started_at %>
          <br><small>Started: <%= @assignment.started_at.strftime("%B %d, %Y at %I:%M %p") %></small>
        <% end %>
        <% if @job&.completed_at %>
          <br><small>Completed: <%= @job.completed_at.strftime("%B %d, %Y at %I:%M %p") %></small>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <!-- Job Information Card -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Job Information</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Job ID:</th>
                  <td><strong>#<%= @job&.id %></strong></td>
                </tr>
                <tr>
                  <th>Priority:</th>
                  <td>
                    <span class="badge bg-<%= 
                      case @job&.priority
                      when 'high' then 'danger'
                      when 'normal' then 'info'
                      else 'secondary'
                      end %>">
                      <%= @job&.priority&.humanize || 'Normal' %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <th>Description:</th>
                  <td><%= @job&.description || 'No description' %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Assigned To:</th>
                  <td>
                    <% if @job&.assigned_mechanic_id == current_user.id %>
                      <span class="badge bg-success">You</span>
                    <% elsif @job&.assigned_mechanic_id.present? %>
                      <%= User.find_by(id: @job.assigned_mechanic_id)&.name || 'Another mechanic' %>
                    <% else %>
                      <span class="badge bg-info">Available</span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Created:</th>
                  <td><%= time_ago_in_words(@job&.created_at) %> ago</td>
                </tr>
                <tr>
                  <th>Template:</th>
                  <td><%= @job&.job_template&.name || 'Custom Job' %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Vehicle Information Card -->
      <% if @vehicle.present? %>
        <div class="card mb-4">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Vehicle Information</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <table class="table table-sm">
                  <tr>
                    <th>Make/Model:</th>
                    <td><%= @vehicle.make %> <%= @vehicle.model %></td>
                  </tr>
                  <tr>
                    <th>License Plate:</th>
                    <td><strong><%= @vehicle.license_plate %></strong></td>
                  </tr>
                  <tr>
                    <th>Year:</th>
                    <td><%= @vehicle.year_of_manufacture %></td>
                  </tr>
                </table>
              </div>
              <div class="col-md-6">
                <table class="table table-sm">
                  <tr>
                    <th>Mileage:</th>
                    <td><%= number_with_delimiter(@vehicle.mileage) %> km</td>
                  </tr>
                  <tr>
                    <th>Vehicle Type:</th>
                    <td><%= @vehicle.vehicle_type %></td>
                  </tr>
                  <tr>
                    <th>Fuel Type:</th>
                    <td><%= @vehicle.fuel_type || 'N/A' %></td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Job Description Card -->
      <% if @job&.notes.present? %>
        <div class="card mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-card-text me-2"></i>Additional Notes</h5>
          </div>
          <div class="card-body">
            <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;"><%= @job.notes %></pre>
          </div>
        </div>
      <% end %>

      <!-- Parts Required Card -->
      <% if @parts&.any? %>
        <div class="card mb-4">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Parts Required</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Part</th>
                    <th>Part Number</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-center">Stock Available</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts.each do |part_item| %>
                    <tr>
                      <td>
                        <%= part_item.part_name %>
                        <% if part_item.custom? %>
                          <br><small class="text-warning">Custom Part</small>
                        <% end %>
                      </td>
                      <td><%= part_item.part&.part_number || 'N/A' %></td>
                      <td class="text-center"><span class="badge bg-secondary"><%= part_item.quantity %></span></td>
                      <td class="text-center">
                        <% if part_item.inventory? && part_item.part.present? %>
                          <%= part_item.part.current_stock %>
                        <% else %>
                          N/A
                        <% end %>
                      </td>
                      <td class="text-center">
                        <% if part_item.custom? %>
                          <span class="badge bg-warning">To Order</span>
                        <% elsif part_item.part.present? %>
                          <% if part_item.part.current_stock >= part_item.quantity %>
                            <span class="badge bg-success">In Stock</span>
                          <% else %>
                            <span class="badge bg-danger">Low Stock</span>
                          <% end %>
                        <% else %>
                          <span class="badge bg-secondary">Unknown</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <% if part_item.inventory? && part_item.part.present? && part_item.part.current_stock >= part_item.quantity && @assignment&.status == 'in_progress' %>
                          <button class="btn btn-sm btn-success use-part" 
                                  data-part-id="<%= part_item.part.id %>"
                                  data-part-name="<%= part_item.part_name %>"
                                  data-quantity="<%= part_item.quantity %>">
                            <i class="bi bi-check-circle"></i> Use Part
                          </button>
                        <% elsif part_item.custom? || (part_item.part.present? && part_item.part.current_stock < part_item.quantity) %>
                          <span class="badge bg-warning">Need to Order</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Progress Updates -->
      <% if @assignment&.mechanic_notes.present? %>
        <div class="card mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-chat-text me-2"></i>Progress Updates</h5>
          </div>
          <div class="card-body">
            <div class="bg-light p-3 rounded" style="max-height: 200px; overflow-y: auto;">
              <%= simple_format(@assignment.mechanic_notes) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <!-- Actions Card -->
      <div class="card mb-4">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <% if @job.assigned_mechanic_id.nil? %>
              <!-- Job not assigned - anyone can take it -->
              <%= button_to "Take This Job", vmcott_mechanic_assign_job_path(@job), 
                    method: :post, 
                    class: "btn btn-success btn-lg",
                    data: { confirm: "Assign this job to yourself?" } %>
              <p class="text-muted small text-center mt-2">Take this job to start working on it</p>
              
            <% elsif @job.assigned_mechanic_id == current_user.id %>
              <!-- Job assigned to current user -->
              <% if @assignment&.status == 'assigned' || @assignment.nil? %>
                <%= button_to "Start Work", vmcott_mechanic_start_job_path(@job), 
                      method: :post, 
                      class: "btn btn-success btn-lg",
                      data: { confirm: "Start working on this job?" } %>
              <% end %>
              
              <% if @assignment&.status == 'in_progress' %>
                <button type="button" class="btn btn-warning btn-lg" data-bs-toggle="modal" data-bs-target="#progressModal">
                  <i class="bi bi-pencil-square me-2"></i>Update Progress
                </button>
                
                <!-- Request Parts Button -->
                <button type="button" class="btn btn-info btn-lg" data-bs-toggle="modal" data-bs-target="#requestPartModal">
                  <i class="bi bi-box-seam me-2"></i>Request Parts
                </button>
                
                <!-- Additional Finding Button -->
                <button type="button" class="btn btn-secondary btn-lg" data-bs-toggle="modal" data-bs-target="#additionalFindingModal">
                  <i class="bi bi-exclamation-triangle me-2"></i>Report Additional Finding
                </button>
                
                <%= button_to "Request QC", vmcott_mechanic_request_qc_path(@job), 
                      method: :post, 
                      class: "btn btn-primary btn-lg",
                      data: { confirm: "Mark this job as complete and request QC inspection?" } %>
              <% end %>
              
            <% else %>
              <!-- Job assigned to someone else - view only -->
              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                This job is assigned to another mechanic. You can view details but cannot take it.
              </div>
              <% assigned_mechanic = User.find_by(id: @job.assigned_mechanic_id) %>
              <p class="text-muted small">Assigned to: <strong><%= assigned_mechanic&.name || 'Unknown' %></strong></p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Stats Card -->
      <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Job Stats</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-2">
              <i class="bi bi-clock me-2"></i>
              <strong>Time in progress:</strong> 
              <% if @assignment&.started_at %>
                <%= distance_of_time_in_words(@assignment.started_at, Time.current) %>
              <% else %>
                Not started
              <% end %>
            </li>
            <li class="mb-2">
              <i class="bi bi-box-seam me-2"></i>
              <strong>Parts used:</strong> <%= @job.inspection_job_parts.sum(:quantity) %>
            </li>
            <li class="mb-2">
              <i class="bi bi-cash me-2"></i>
              <strong>Est. labor:</strong> $<%= number_with_delimiter(@job.estimated_labor_cost || 0) %>
            </li>
            <li class="mb-2">
              <i class="bi bi-cash-stack me-2"></i>
              <strong>Est. parts:</strong> $<%= number_with_delimiter(@job.estimated_parts_cost || 0) %>
            </li>
          </ul>
        </div>
      </div>

      <!-- Progress Timeline Card -->
      <div class="card">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-3">
              <i class="bi bi-plus-circle text-primary me-2"></i>
              <strong>Created:</strong><br>
              <small class="text-muted"><%= @job&.created_at&.strftime("%b %d, %Y at %I:%M %p") || 'Unknown' %></small>
            </li>
            <% if @assignment&.started_at %>
              <li class="mb-3">
                <i class="bi bi-play-circle text-success me-2"></i>
                <strong>Started:</strong><br>
                <small class="text-muted"><%= @assignment.started_at.strftime("%b %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
            <% if @job&.completed_at %>
              <li class="mb-3">
                <i class="bi bi-check-circle text-success me-2"></i>
                <strong>Completed:</strong><br>
                <small class="text-muted"><%= @job.completed_at.strftime("%b %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Progress Update Modal -->
  <div class="modal fade" id="progressModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-warning">
          <h5 class="modal-title">Update Progress</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: vmcott_mechanic_update_progress_path(@job), method: :post, local: true do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= label_tag :progress_update, "What have you completed?", class: "form-label fw-bold" %>
              <%= text_area_tag :progress_update, nil, class: "form-control", rows: 4, 
                    placeholder: "Describe what you've done so far...", required: true %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Save Progress", class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Request Parts Modal - FIXED WITH PROPER INITIALIZATION -->
  <div class="modal fade" id="requestPartModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title">Request Parts</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: vmcott_mechanic_request_part_path(@job), method: :post, local: true, data: { turbo: false }, html: { id: "part-request-form" } do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= label_tag :part_type, "Part Type", class: "form-label fw-bold" %>
              <div class="form-check">
                <%= radio_button_tag :part_type, 'inventory', true, class: 'form-check-input', id: 'part_type_inventory' %>
                <%= label_tag :part_type_inventory, "Select from Inventory", class: 'form-check-label' %>
              </div>
              <div class="form-check">
                <%= radio_button_tag :part_type, 'custom', false, class: 'form-check-input', id: 'part_type_custom' %>
                <%= label_tag :part_type_custom, "Custom Part (Not in System)", class: 'form-check-label' %>
              </div>
            </div>

            <div id="inventory-part-fields">
              <div class="mb-3">
                <%= label_tag :part_search, "Search Parts", class: "form-label fw-bold" %>
                <div class="position-relative">
                  <%= text_field_tag :part_search, nil, 
                        class: "form-control form-control-lg", 
                        placeholder: "Type part name or number... (e.g., 'Spark Plug', 'Battery')",
                        id: "part-search-input",
                        autocomplete: "off" %>
                  <div id="search-spinner" class="position-absolute end-0 top-0 mt-2 me-3" style="display: none;">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div>
                  </div>
                </div>
                <small class="text-muted">Start typing to search for parts in inventory</small>
              </div>

              <!-- Search Results Container -->
              <div id="search-results" class="mb-3" style="max-height: 300px; overflow-y: auto; display: none;">
                <div class="list-group">
                  <!-- Results will be dynamically inserted here -->
                </div>
              </div>

              <!-- Selected Part (hidden field) -->
              <%= hidden_field_tag :part_id, nil, id: "selected-part-id" %>
              
              <!-- Quick Select for Common Parts -->
              <div class="mb-3" id="common-parts-section">
                <label class="form-label fw-bold">Quick Select</label>
                <div class="d-flex flex-wrap gap-2">
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Spark Plug">Spark Plug</button>
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Ignition Coil">Ignition Coil</button>
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Oil Filter">Oil Filter</button>
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Air Filter">Air Filter</button>
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Brake Pad">Brake Pad</button>
                  <button type="button" class="btn btn-sm btn-outline-primary common-part" data-part-name="Battery">Battery</button>
                </div>
              </div>

              <!-- Selected Part Display -->
              <div id="selected-part-display" class="alert alert-success mt-2" style="display: none;">
                <i class="bi bi-check-circle-fill me-2"></i>
                Selected: <strong id="selected-part-name"></strong>
                <button type="button" class="btn-close float-end" id="clear-selected-part" aria-label="Close"></button>
              </div>
            </div>

            <div id="custom-part-fields" style="display: none;">
              <div class="mb-3">
                <%= label_tag :custom_part_name, "Part Name", class: "form-label fw-bold" %>
                <%= text_field_tag :custom_part_name, nil, class: "form-control form-control-lg", 
                      placeholder: "e.g., Special bracket for model XYZ", id: "custom-part-name-input" %>
                <small class="text-muted">Enter the name of the custom part you need</small>
              </div>
            </div>

            <div class="mb-3">
              <%= label_tag :quantity, "Quantity", class: "form-label fw-bold" %>
              <%= number_field_tag :quantity, 1, class: "form-control form-control-lg", min: 1, required: true, id: "part-quantity" %>
            </div>

            <div class="mb-3">
              <%= label_tag :description, "Description (Optional)", class: "form-label fw-bold" %>
              <%= text_area_tag :description, nil, class: "form-control", rows: 2, placeholder: "Any specific requirements..." %>
            </div>

            <!-- Hidden fields to pass the correct associations -->
            <%= hidden_field_tag :inspection_id, @job.inspection_id %>
            <%= hidden_field_tag :inspection_job_id, @job.id %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Submit Request", class: "btn btn-info btn-lg", id: "submit-part-request", disabled: true %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Additional Finding Modal - FIXED VERSION -->
  <div class="modal fade" id="additionalFindingModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-secondary text-white">
          <h5 class="modal-title">Report Additional Finding</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: vmcott_mechanic_create_additional_finding_path(@job.inspection), method: :post, local: true, data: { turbo: false } do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= label_tag :description, "Description of Additional Work Needed", class: "form-label fw-bold" %>
              <%= text_area_tag :description, nil, class: "form-control", rows: 3, 
                    placeholder: "Describe what additional work is needed...", required: true %>
            </div>
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Additional work will require a new quotation from finance.
            </div>
            
            <!-- Add hidden job_id field to ensure we can redirect back -->
            <%= hidden_field_tag :job_id, @job.id %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Report Finding", class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for part usage, search, and form toggles - FIXED VERSION -->
<script>
(function() {
  'use strict';
  
  console.log('🔧 Parts search script loaded');
  
  function initializePartsSearch() {
    console.log('🔍 Initializing parts search...');
    
    // Handle part type toggle
    const inventoryRadio = document.getElementById('part_type_inventory');
    const customRadio = document.getElementById('part_type_custom');
    const inventoryFields = document.getElementById('inventory-part-fields');
    const customFields = document.getElementById('custom-part-fields');
    const partSearchInput = document.getElementById('part-search-input');
    const searchResults = document.getElementById('search-results');
    const searchSpinner = document.getElementById('search-spinner');
    const selectedPartId = document.getElementById('selected-part-id');
    const selectedPartDisplay = document.getElementById('selected-part-display');
    const selectedPartName = document.getElementById('selected-part-name');
    const clearSelectedPart = document.getElementById('clear-selected-part');
    const submitButton = document.getElementById('submit-part-request');
    const quantityInput = document.getElementById('part-quantity');
    const customPartNameInput = document.getElementById('custom-part-name-input');
    const commonPartButtons = document.querySelectorAll('.common-part');
    
    // Check if we're on the right page
    if (!inventoryRadio || !customRadio) {
      console.log('❌ Part type radios not found - wrong page');
      return;
    }
    
    console.log('✅ Elements found, attaching event listeners');
    
    let searchTimeout;
    let selectedPart = null;
  
    // Function to update field visibility and required attributes
    function updatePartFields() {
      if (inventoryRadio && inventoryRadio.checked) {
        inventoryFields.style.display = 'block';
        customFields.style.display = 'none';
        
        if (partSearchInput) {
          partSearchInput.disabled = false;
          setTimeout(() => partSearchInput.focus(), 100);
        }
        if (customPartNameInput) {
          customPartNameInput.required = false;
          customPartNameInput.disabled = true;
          customPartNameInput.value = '';
        }
        
        updateSubmitButton();
        
      } else if (customRadio && customRadio.checked) {
        inventoryFields.style.display = 'none';
        customFields.style.display = 'block';
        
        if (partSearchInput) {
          partSearchInput.disabled = true;
          partSearchInput.value = '';
        }
        if (customPartNameInput) {
          customPartNameInput.required = true;
          customPartNameInput.disabled = false;
          setTimeout(() => customPartNameInput.focus(), 100);
        }
        
        // Clear any selected inventory part
        selectedPart = null;
        selectedPartId.value = '';
        selectedPartDisplay.style.display = 'none';
        searchResults.style.display = 'none';
        
        updateSubmitButton();
      }
    }
  
    // Function to update submit button state
    function updateSubmitButton() {
      if (inventoryRadio && inventoryRadio.checked) {
        // Inventory mode: need selected part and quantity
        submitButton.disabled = !(selectedPartId.value && quantityInput.value > 0);
      } else if (customRadio && customRadio.checked) {
        // Custom mode: need custom name and quantity
        submitButton.disabled = !(customPartNameInput.value.trim() && quantityInput.value > 0);
      }
    }
  
    // Search function
    function searchParts(query) {
      if (query.length < 2) {
        searchResults.style.display = 'none';
        return;
      }
      
      searchSpinner.style.display = 'block';
      
      fetch(`/vmcott/parts/search?q=${encodeURIComponent(query)}`, {
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]')?.content
        },
        credentials: 'same-origin'
      })
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        searchSpinner.style.display = 'none';
        
        if (data.length > 0) {
          displaySearchResults(data);
        } else {
          searchResults.innerHTML = '<div class="list-group-item text-muted">No parts found</div>';
          searchResults.style.display = 'block';
        }
      })
      .catch(error => {
        console.error('Search error:', error);
        searchSpinner.style.display = 'none';
        searchResults.innerHTML = '<div class="list-group-item text-danger">Error searching parts</div>';
        searchResults.style.display = 'block';
      });
    }
  
    // Display search results
    function displaySearchResults(parts) {
      let html = '';
      parts.forEach(part => {
        const stockClass = part.current_stock > 0 ? 'text-success' : 'text-danger';
        const stockText = part.current_stock > 0 ? `${part.current_stock} in stock` : 'Out of stock';
        
        html += `
          <button type="button" class="list-group-item list-group-item-action part-result" 
                  data-part-id="${part.id}"
                  data-part-name="${part.name}"
                  data-part-number="${part.part_number || ''}"
                  data-stock="${part.current_stock || 0}">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <strong>${escapeHtml(part.name)}</strong>
                <br><small class="text-muted">${escapeHtml(part.part_number || 'No part #')}</small>
              </div>
              <div>
                <span class="badge ${stockClass}">${stockText}</span>
              </div>
            </div>
          </button>
        `;
      });
      
      searchResults.innerHTML = html;
      searchResults.style.display = 'block';
      
      // Add click handlers to results
      document.querySelectorAll('.part-result').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          selectPart({
            id: this.dataset.partId,
            name: this.dataset.partName,
            number: this.dataset.partNumber
          });
        });
      });
    }
  
    // Helper function to escape HTML
    function escapeHtml(text) {
      if (!text) return '';
      return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  
    // Select a part
    function selectPart(part) {
      selectedPartId.value = part.id;
      selectedPartName.textContent = part.name;
      selectedPartDisplay.style.display = 'block';
      searchResults.style.display = 'none';
      partSearchInput.value = part.name;
      updateSubmitButton();
    }
  
    // Clear selected part
    if (clearSelectedPart) {
      clearSelectedPart.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        selectedPartId.value = '';
        selectedPartDisplay.style.display = 'none';
        partSearchInput.value = '';
        partSearchInput.focus();
        updateSubmitButton();
      });
    }
  
    // Set initial state
    if (inventoryRadio && inventoryRadio.checked) {
      updatePartFields();
    }
  
    // Add event listeners for radio buttons
    if (inventoryRadio) {
      inventoryRadio.addEventListener('change', updatePartFields);
    }
    
    if (customRadio) {
      customRadio.addEventListener('change', updatePartFields);
    }
  
    // Search input handler
    if (partSearchInput) {
      partSearchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim();
        
        if (query.length < 2) {
          searchResults.style.display = 'none';
          return;
        }
        
        searchTimeout = setTimeout(() => searchParts(query), 300);
      });
    }
  
    // Quantity input handler
    if (quantityInput) {
      quantityInput.addEventListener('input', updateSubmitButton);
    }
  
    // Custom part name input handler
    if (customPartNameInput) {
      customPartNameInput.addEventListener('input', updateSubmitButton);
    }
  
    // Common part buttons
    commonPartButtons.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (partSearchInput) {
          partSearchInput.value = this.dataset.partName;
          partSearchInput.dispatchEvent(new Event('input'));
        }
      });
    });
  
    // Handle use part clicks
    document.querySelectorAll('.use-part').forEach(button => {
      const newBtn = button.cloneNode(true);
      button.parentNode.replaceChild(newBtn, button);
      
      newBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const partId = this.dataset.partId;
        const partName = this.dataset.partName;
        const suggestedQty = this.dataset.quantity || '1';
        const quantity = prompt(`Enter quantity of ${partName} to use:`, suggestedQty);
        
        if (quantity && !isNaN(quantity) && parseInt(quantity) > 0) {
          logPartUsage(partId, quantity);
        }
      });
    });
    
    function logPartUsage(partId, quantity) {
      const formData = new FormData();
      formData.append('part_id', partId);
      formData.append('quantity', quantity);
      
      fetch('<%= vmcott_mechanic_log_parts_path(@job) %>', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          location.reload();
        } else {
          alert('Error: ' + data.message);
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while logging part usage.');
      });
    }
    
    console.log('✅ Parts search initialized successfully');
  }
  
  // Try multiple initialization methods
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePartsSearch);
  } else {
    initializePartsSearch();
  }
  
  // Handle Turbolinks/Turbo
  document.addEventListener('turbo:load', initializePartsSearch);
  document.addEventListener('turbolinks:load', initializePartsSearch);
  
  // Also try when modal is shown
  document.getElementById('requestPartModal')?.addEventListener('shown.bs.modal', function() {
    console.log('📱 Modal shown, reinitializing...');
    setTimeout(initializePartsSearch, 100);
  });
  
  // Fallback initialization
  setTimeout(initializePartsSearch, 500);
  
})();
</script>

