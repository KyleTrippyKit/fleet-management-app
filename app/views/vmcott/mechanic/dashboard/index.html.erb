<%# app/views/vmcott/mechanic/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">🔧 Welcome, <%= current_user.name %></h1>
      <p class="text-muted">VMCOTT Mechanic - Repairs & Work Orders</p>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">My Assigned Jobs</h5>
          <h2 class="display-4"><%= @assigned_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Available Jobs</h5>
          <h2 class="display-4"><%= @available_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Completed Today</h5>
          <h2 class="display-4"><%= @completed_today || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Pending QC</h5>
          <h2 class="display-4"><%= @pending_qc || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <!-- My Assigned Jobs -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-tools me-2"></i>My Assigned Jobs</h5>
        </div>
        <div class="card-body">
          <% if @assigned_jobs && @assigned_jobs.any? %>
            <% @assigned_jobs.each do |job| %>
              <div class="d-flex justify-content-between align-items-center mb-3 p-3 border rounded">
                <div>
                  <strong><%= job.work_order_number %></strong>
                  <div class="small">
                    <% if job.extracted_work_section.present? %>
                      <span class="badge bg-info"><%= job.extracted_work_section %></span>
                    <% end %>
                    <% if job.extracted_work_role.present? %>
                      <span class="badge bg-secondary"><%= job.extracted_work_role %></span>
                    <% end %>
                    <br>
                    <%= job.short_description.truncate(50) %><br>
                    
                    <!-- Using the helper method for cleaner code -->
                    <span class="text-muted"><%= display_vehicle_info(job) %></span>
                  </div>
                  <div class="mt-2">
                    <span class="badge bg-<%= job.status == 'in_progress' ? 'warning' : 'secondary' %>">
                      <%= job.status.humanize %>
                    </span>
                    <span class="badge bg-<%= 
                      case job.priority
                      when 'high' then 'danger'
                      when 'normal' then 'info'
                      else 'secondary'
                      end %>">
                      <%= job.priority.humanize %>
                    </span>
                  </div>
                </div>
                <div>
                  <%= link_to "View", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-primary" %>
                  <% if job.status == 'pending' && job.assigned_to_id == current_user.id %>
                    <%= button_to "Start Work", vmcott_mechanic_start_job_path(job), 
                          method: :post, 
                          class: "btn btn-sm btn-success mt-1",
                          data: { confirm: "Start working on this job?" } %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted text-center py-3">No assigned jobs</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Available Jobs with Preview -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-list-task me-2"></i>Available Jobs</h5>
        </div>
        <div class="card-body">
          <% if @available_jobs && @available_jobs.any? %>
            <% @available_jobs.each do |job| %>
              <div class="d-flex justify-content-between align-items-center mb-3 p-3 border rounded">
                <div>
                  <strong><%= job.work_order_number %></strong>
                  <div class="small">
                    <% if job.extracted_work_section.present? %>
                      <span class="badge bg-info"><%= job.extracted_work_section %></span>
                    <% end %>
                    <% if job.extracted_work_role.present? %>
                      <span class="badge bg-secondary"><%= job.extracted_work_role %></span>
                    <% end %>
                    <br>
                    <%= job.short_description.truncate(50) %><br>
                    
                    <!-- Using the helper method for cleaner code -->
                    <span class="text-muted"><%= display_vehicle_info(job) %></span>
                  </div>
                  <div class="mt-2">
                    <span class="badge bg-<%= 
                      case job.priority
                      when 'high' then 'danger'
                      when 'normal' then 'info'
                      else 'secondary'
                      end %>">
                      <%= job.priority.humanize %>
                    </span>
                  </div>
                </div>
                <div class="d-flex flex-column gap-2">
                  <!-- Preview Button -->
                  <button type="button" class="btn btn-sm btn-outline-info" 
                          data-bs-toggle="modal" 
                          data-bs-target="#previewJobModal<%= job.id %>">
                    <i class="bi bi-eye me-1"></i>Preview
                  </button>
                  <%= button_to "Assign to Me", vmcott_mechanic_assign_job_path(job), 
                        method: :post, 
                        class: "btn btn-sm btn-success",
                        data: { confirm: "Assign this job to yourself?" } %>
                </div>
              </div>

              <!-- Preview Modal for this Job -->
              <div class="modal fade" id="previewJobModal<%= job.id %>" tabindex="-1" aria-labelledby="previewJobModalLabel<%= job.id %>" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                  <div class="modal-content">
                    <div class="modal-header bg-info text-white">
                      <h5 class="modal-title" id="previewJobModalLabel<%= job.id %>">
                        <i class="bi bi-eye me-2"></i>Job Preview: <%= job.work_order_number %>
                      </h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <!-- Status Badge -->
                      <div class="mb-3">
                        <span class="badge bg-<%= 
                          case job.priority
                          when 'high' then 'danger'
                          when 'normal' then 'info'
                          else 'secondary'
                          end %> fs-6 me-2">
                          <%= job.priority.humanize %> Priority
                        </span>
                        <span class="badge bg-secondary fs-6">
                          <%= job.extracted_work_section || 'Workshop' %> / <%= job.extracted_work_role || 'Technician' %>
                        </span>
                      </div>

                      <div class="row">
                        <!-- Job Information -->
                        <div class="col-md-6">
                          <div class="mb-3">
                            <h6 class="fw-bold border-bottom pb-2">
                              <i class="bi bi-info-circle me-2"></i>Job Information
                            </h6>
                            <table class="table table-sm">
                              <tr>
                                <th>Work Order:</th>
                                <td><%= job.work_order_number %></td>
                              </tr>
                              <tr>
                                <th>Status:</th>
                                <td><span class="badge bg-warning"><%= job.status.humanize %></span></td>
                              </tr>
                              <tr>
                                <th>Created:</th>
                                <td><%= time_ago_in_words(job.created_at) %> ago</td>
                              </tr>
                              <tr>
                                <th>Est. Completion:</th>
                                <td><%= job.estimated_completion_date&.strftime("%b %d, %Y") || 'Not set' %></td>
                              </tr>
                            </table>
                          </div>
                        </div>

                        <!-- Vehicle Details -->
                        <div class="col-md-6">
                          <div class="mb-3">
                            <h6 class="fw-bold border-bottom pb-2">
                              <i class="bi bi-truck me-2"></i>Vehicle Details
                            </h6>
                            <% vehicle = job.vehicle || job.purchase_order&.vehicle %>
                            <% if vehicle.present? %>
                              <table class="table table-sm">
                                <tr>
                                  <th>Make/Model:</th>
                                  <td><%= vehicle.make %> <%= vehicle.model %></td>
                                </tr>
                                <tr>
                                  <th>License Plate:</th>
                                  <td><strong><%= vehicle.license_plate %></strong></td>
                                </tr>
                                <tr>
                                  <th>Year:</th>
                                  <td><%= vehicle.year_of_manufacture %></td>
                                </tr>
                                <tr>
                                  <th>Mileage:</th>
                                  <td><%= number_with_delimiter(vehicle.mileage) %> km</td>
                                </tr>
                                <tr>
                                  <th>Fuel Type:</th>
                                  <td><%= vehicle.fuel_type || 'N/A' %></td>
                                </tr>
                              </table>
                            <% else %>
                              <p class="text-muted">Vehicle information unavailable</p>
                            <% end %>
                          </div>
                        </div>
                      </div>

                      <!-- Job Description -->
                      <div class="mb-3">
                        <h6 class="fw-bold border-bottom pb-2">
                          <i class="bi bi-card-text me-2"></i>Job Description
                        </h6>
                        <div class="bg-light p-3 rounded" style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;">
                          <%= job.notes %>
                        </div>
                      </div>

                      <!-- Parts Required with Enhanced Stock Display -->
                      <% if job.purchase_order.present? && job.purchase_order.purchase_order_items.any? %>
                        <div class="mb-3">
                          <h6 class="fw-bold border-bottom pb-2">
                            <i class="bi bi-box-seam me-2"></i>Parts Required
                          </h6>
                          <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                              <thead class="table-light">
                                <tr>
                                  <th>Part</th>
                                  <th class="text-center">Qty</th>
                                  <th class="text-center">Stock</th>
                                  <th class="text-center">Status</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% job.purchase_order.purchase_order_items.each do |item| %>
                                  <tr>
                                    <td><%= item.description %></td>
                                    <td class="text-center"><%= item.quantity %></td>
                                    <td class="text-center">
                                      <% if item.part.present? %>
                                        <%= item.part.current_stock %>
                                      <% else %>
                                        N/A
                                      <% end %>
                                    </td>
                                    <td class="text-center">
                                      <% if item.part.present? %>
                                        <% stock_class = item.part.current_stock >= item.quantity ? 'success' : 'danger' %>
                                        <span class="badge bg-<%= stock_class %>">
                                          <%= item.part.current_stock >= item.quantity ? 'In Stock' : 'Low Stock' %>
                                        </span>
                                      <% else %>
                                        <span class="badge bg-secondary">Not Tracked</span>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      <% end %>

                      <!-- Additional Info -->
                      <div class="row">
                        <div class="col-md-6">
                          <p class="small text-muted mb-1">
                            <i class="bi bi-person me-1"></i>Created by: <%= job.created_by&.name || 'System' %>
                          </p>
                        </div>
                        <div class="col-md-6">
                          <p class="small text-muted mb-1">
                            <i class="bi bi-calendar me-1"></i>Created: <%= job.created_at.strftime("%b %d, %Y at %I:%M %p") %>
                          </p>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Close
                      </button>
                      <%= button_to vmcott_mechanic_assign_job_path(job), 
                            method: :post, 
                            class: "btn btn-success",
                            form_class: "d-inline",
                            data: { confirm: "Assign this job to yourself?" } do %>
                        <i class="bi bi-check-circle me-1"></i>Assign to Me
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted text-center py-3">No available jobs at this time</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recently Completed Jobs -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recently Completed Jobs</h5>
        </div>
        <div class="card-body">
          <% if @recently_completed && @recently_completed.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Work Order</th>
                    <th>Vehicle</th>
                    <th>Description</th>
                    <th>Completed</th>
                    <th>QC Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @recently_completed.each do |job| %>
                    <tr>
                      <td><strong><%= job.work_order_number %></strong></td>
                      <td>
                        <% vehicle = job.vehicle || job.purchase_order&.vehicle %>
                        <% if vehicle.present? %>
                          <%= vehicle.make %> <%= vehicle.model %><br>
                          <small class="text-muted"><%= vehicle.license_plate %></small>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td><%= job.short_description.truncate(40) %></td>
                      <td><%= time_ago_in_words(job.completed_at) if job.completed_at %> ago</td>
                      <td>
                        <% if job.notes.to_s.include?('QC PASSED') %>
                          <span class="badge bg-success">Passed</span>
                        <% elsif job.notes.to_s.include?('QC FAILED') %>
                          <span class="badge bg-danger">Failed</span>
                        <% else %>
                          <span class="badge bg-warning">Pending</span>
                        <% end %>
                      </td>
                      <td>
                        <%= link_to "View", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No recently completed jobs</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>