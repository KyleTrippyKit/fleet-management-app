<%# app/views/vmcott/mechanic/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">🔧 Welcome, <%= current_user.name %></h1>
      <p class="text-muted">VMCOTT Mechanic - Repairs & Work Orders</p>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">My Assigned Jobs</h5>
          <h2 class="display-4"><%= @assigned_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Available Jobs</h5>
          <h2 class="display-4"><%= @available_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Completed Today</h5>
          <h2 class="display-4"><%= @completed_today || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Ready for QC</h5>
          <h2 class="display-4"><%= @pending_qc || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- My Assigned Jobs Grouped by Vehicle -->
  <% if @jobs_by_vehicle && @jobs_by_vehicle.any? %>
    <div class="row mt-4">
      <div class="col-12">
        <h4 class="mb-3"><i class="bi bi-tools me-2"></i>My Assigned Jobs by Vehicle</h4>
      </div>
    </div>
    
    <% @jobs_by_vehicle.each do |vehicle, jobs| %>
      <div class="card mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0">
              <i class="bi bi-truck me-2"></i>
              <%= vehicle.license_plate %> - <%= vehicle.make %> <%= vehicle.model %>
            </h5>
            <small class="text-white-50"><%= jobs.count %> job(s) assigned</small>
          </div>
          <span class="badge bg-light text-dark"><%= number_with_delimiter(vehicle.mileage) %> km</span>
        </div>
        <div class="card-body">
          <div class="row">
            <% jobs.each do |job| %>
              <div class="col-md-6 mb-3">
                <div class="card border">
                  <div class="card-body">
                    <div class="d-flex justify-content-between">
                      <h6 class="fw-bold">Job #<%= job.id %></h6>
                      <!-- FIXED: Handle nil priority -->
                      <span class="badge bg-<%= 
                        case job.priority
                        when 'high' then 'danger'
                        when 'normal' then 'info'
                        when 'low' then 'secondary'
                        else 'secondary'
                        end %>">
                        <%= job.priority&.humanize || 'Normal' %>
                      </span>
                    </div>
                    
                    <p class="small text-muted mt-2 mb-2">
                      <%= job.description&.truncate(100) || 'No description' %>
                    </p>

                    <!-- Parts needed for this job -->
                    <% if job.inspection_job_parts&.any? %>
                      <div class="bg-light p-2 rounded mb-2">
                        <small class="fw-bold">Parts needed:</small>
                        <% job.inspection_job_parts.each do |part_item| %>
                          <div class="d-flex justify-content-between align-items-center mt-1">
                            <span>
                              <% if part_item.custom? %>
                                <span class="text-warning">🔧 <%= part_item.part_name %></span>
                                <small class="text-muted d-block">Custom Part</small>
                              <% else %>
                                <%= part_item.part_name %>
                                <small class="text-muted d-block">Part #: <%= part_item.part&.part_number %></small>
                              <% end %>
                            </span>
                            <div class="text-end">
                              <span class="badge bg-secondary">x<%= part_item.quantity %></span>
                              <% if part_item.inventory? && part_item.part.present? %>
                                <% if part_item.part.current_stock.to_i >= part_item.quantity %>
                                  <span class="badge bg-success">In Stock</span>
                                <% else %>
                                  <span class="badge bg-danger">Low Stock</span>
                                <% end %>
                              <% else %>
                                <span class="badge bg-warning">To Order</span>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>

                    <!-- Job Status -->
                    <div class="mt-2">
                      <% if job.completed_at %>
                        <span class="badge bg-success">Completed</span>
                      <% elsif job.assigned_mechanic_id == current_user.id %>
                        <span class="badge bg-warning">In Progress</span>
                      <% else %>
                        <span class="badge bg-secondary">Pending</span>
                      <% end %>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                      <small class="text-muted">From: <%= job.inspection&.vehicle&.agency&.name || 'Unknown' %></small>
                      <%= link_to "View Job", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary" %>
                    </div>
                    
                    <!-- Start Work Button -->
                    <% if job.assigned_mechanic_id == current_user.id && !job.completed_at %>
                      <div class="mt-2">
                        <%= button_to "Start Work", vmcott_mechanic_start_job_path(job), 
                              method: :post, 
                              class: "btn btn-sm btn-success w-100",
                              data: { confirm: "Start working on this job?" } %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Available Jobs Grouped by Vehicle -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-list-task me-2"></i>Available Jobs by Vehicle</h5>
        </div>
        <div class="card-body">
          <% if @available_jobs_by_vehicle && @available_jobs_by_vehicle.any? %>
            <div class="row">
              <% @available_jobs_by_vehicle.each do |vehicle, jobs| %>
                <% if vehicle.present? %>
                  <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card border h-100">
                      <div class="card-header bg-light">
                        <h6 class="mb-0 fw-bold">
                          <i class="bi bi-truck me-1"></i>
                          <%= vehicle.license_plate %>
                        </h6>
                        <small class="text-muted"><%= vehicle.make %> <%= vehicle.model %></small>
                      </div>
                      <div class="card-body">
                        <% jobs.each do |job| %>
                          <div class="mb-2 pb-2 border-bottom">
                            <div class="d-flex justify-content-between">
                              <strong><%= job.description&.truncate(30) || 'No description' %></strong>
                              <!-- FIXED: Handle nil priority -->
                              <span class="badge bg-<%= 
                                case job.priority
                                when 'high' then 'danger'
                                when 'normal' then 'info'
                                when 'low' then 'secondary'
                                else 'secondary'
                                end %>">
                                <%= job.priority&.humanize || 'Normal' %>
                              </span>
                            </div>
                            
                            <!-- Parts Summary -->
                            <% if job.inspection_job_parts&.any? %>
                              <div class="small mt-1">
                                <span class="text-muted">Parts: </span>
                                <% if job.inspection_job_parts.all? { |p| p.inventory? && p.part&.current_stock.to_i >= p.quantity } %>
                                  <span class="badge bg-success">Ready</span>
                                <% elsif job.inspection_job_parts.any?(&:custom?) %>
                                  <span class="badge bg-warning">Has Custom Parts</span>
                                <% else %>
                                  <span class="badge bg-danger">Needs Parts</span>
                                <% end %>
                              </div>
                            <% end %>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2">
                              <small class="text-muted">From: <%= job.inspection&.vehicle&.agency&.name || 'Unknown' %></small>
                              <%= button_to "Assign to Me", vmcott_mechanic_assign_job_path(job), 
                                    method: :post, 
                                    class: "btn btn-sm btn-success",
                                    data: { confirm: "Assign this job to yourself?" } %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No available jobs at this time</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recently Completed Jobs -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recently Completed Jobs</h5>
        </div>
        <div class="card-body">
          <% if @recently_completed && @recently_completed.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Job</th>
                    <th>Vehicle</th>
                    <th>Description</th>
                    <th>Completed</th>
                    <th>QC Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @recently_completed.each do |job| %>
                    <tr>
                      <td><strong>#<%= job.id %></strong></td>
                      <td>
                        <%= job.inspection&.vehicle&.license_plate || 'N/A' %><br>
                        <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                      </td>
                      <td><%= job.description&.truncate(40) || 'No description' %></td>
                      <td><%= time_ago_in_words(job.completed_at) if job.completed_at %> ago</td>
                      <td>
                        <% if job.inspection&.status == 'qc_completed' %>
                          <span class="badge bg-success">Passed</span>
                        <% elsif job.inspection&.status == 'ready_for_qc' %>
                          <span class="badge bg-warning">Pending QC</span>
                        <% else %>
                          <span class="badge bg-secondary">Waiting</span>
                        <% end %>
                      </td>
                      <td>
                        <%= link_to "View", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No recently completed jobs</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>