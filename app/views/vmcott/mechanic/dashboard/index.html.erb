<%# app/views/vmcott/mechanic/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <!-- Welcome Header -->
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">🔧 Welcome back, <%= current_user.name %></h1>
      <p class="text-muted">Here's what needs your attention today</p>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h6><i class="bi bi-tools me-2"></i>My Current Jobs</h6>
          <h2><%= @assigned_jobs&.count || 0 %></h2>
          <small>Jobs you're working on</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h6><i class="bi bi-play-circle me-2"></i>Ready to Start</h6>
          <h2><%= @ready_jobs&.count || 0 %></h2>
          <small>Available right now</small>
          <!-- NEW: Badge for new job notifications -->
          <% new_jobs_count = @new_jobs_available.to_i %>
          <% if new_jobs_count > 0 %>
            <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle">
              <span class="visually-hidden">New jobs available</span>
            </span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h6><i class="bi bi-check-circle me-2"></i>Completed Today</h6>
          <h2><%= @completed_today || 0 %></h2>
          <small>Great work!</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h6><i class="bi bi-clipboard-check me-2"></i>Ready for QC</h6>
          <h2><%= @pending_qc || 0 %></h2>
          <small>Waiting for inspector</small>
          <% if (@pending_qc || 0) > 0 %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= @pending_qc %> pending
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- NEW: Flash notification for new jobs -->
  <% if flash[:job_ready] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-megaphone me-2"></i>
      <strong><%= flash[:job_ready] %></strong>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <!-- WORKFLOW STATUS - Simple like Inspector page -->
  <div class="card mb-4">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Workflow Status</h5>
    </div>
    <div class="card-body">
      <div class="workflow-timeline">
        <%
          # Calculate workflow step statuses
          inspections_complete = @inspections_complete.to_i
          parts_ready = @parts_complete.to_i
          parts_pending = @parts_pending.to_i
          jobs_active = @assigned_jobs_count.to_i
          jobs_available = @available_jobs_count.to_i
          jobs_complete = @repairs_complete.to_i
          qc_pending = @pending_qc.to_i
          qc_complete = @qc_complete.to_i
          ready_pickup = @ready_for_pickup.to_i
          new_jobs_available = @new_jobs_available.to_i
          
          # Determine current active step
          current_step = if inspections_complete == 0
            'inspection'
          elsif parts_pending > 0
            'parts'
          elsif jobs_available > 0 || jobs_active > 0
            'repairs'
          elsif qc_pending > 0
            'qc'
          else
            'pickup'
          end
        %>
        
        <% workflow_steps = [
          { 
            name: 'Inspection Complete', 
            completed: inspections_complete > 0,
            active: current_step == 'inspection',
            icon: inspections_complete > 0 ? 'bi-check-circle-fill' : 'bi-circle',
            turn: 'Inspector'
          },
          { 
            name: 'Parts Ready', 
            completed: parts_ready > 0 && parts_pending == 0,
            active: current_step == 'parts',
            detail: parts_pending > 0 ? "#{parts_pending} parts pending" : "#{parts_ready} parts ready",
            icon: (parts_ready > 0 && parts_pending == 0) ? 'bi-check-circle-fill' : (parts_pending > 0 ? 'bi-hourglass-split' : 'bi-circle'),
            turn: 'Parts Team'
          },
          { 
            name: 'Repairs', 
            completed: jobs_complete > 0 && jobs_active == 0 && jobs_available == 0,
            active: current_step == 'repairs',
            detail: jobs_active > 0 ? "#{jobs_active} active" : (jobs_available > 0 ? "#{jobs_available} available" : "#{jobs_complete} done"),
            icon: jobs_complete > 0 && jobs_active == 0 && jobs_available == 0 ? 'bi-check-circle-fill' : (jobs_active > 0 ? 'bi-tools' : (jobs_available > 0 ? 'bi-play-circle' : 'bi-circle')),
            turn: 'Mechanic'
          },
          { 
            name: 'QC Check', 
            completed: qc_complete > 0 && qc_pending == 0,
            active: current_step == 'qc',
            detail: qc_pending > 0 ? "#{qc_pending} pending" : "#{qc_complete} passed",
            icon: qc_complete > 0 && qc_pending == 0 ? 'bi-check-circle-fill' : (qc_pending > 0 ? 'bi-clipboard-check' : 'bi-circle'),
            turn: 'Inspector'
          },
          { 
            name: 'Ready for Pickup', 
            completed: ready_pickup > 0,
            active: current_step == 'pickup',
            detail: ready_pickup > 0 ? "#{ready_pickup} vehicles" : "0 vehicles",
            icon: ready_pickup > 0 ? 'bi-check-circle-fill' : 'bi-circle',
            turn: 'Finance'
          }
        ] %>
        
        <% workflow_steps.each_with_index do |step, index| %>
          <div class="workflow-step mb-3 p-2 rounded <%= 'bg-light border border-warning' if step[:active] %>">
            <div class="d-flex align-items-center">
              <div class="step-indicator me-3">
                <i class="bi <%= step[:icon] %> 
                  <%= step[:completed] ? 'text-success' : (step[:active] ? 'text-warning' : 'text-secondary') %> 
                  fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= step[:name] %></strong>
                    <% if step[:detail].present? %>
                      <br><small class="text-muted"><%= step[:detail] %></small>
                    <% end %>
                  </div>
                  <% if step[:active] %>
                    <span class="badge bg-warning text-dark ms-2">
                      <i class="bi bi-person-walking me-1"></i><%= step[:turn] %>'s Turn
                    </span>
                  <% elsif step[:completed] %>
                    <span class="badge bg-success ms-2">
                      <i class="bi bi-check-circle me-1"></i>Done
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Next Action Hint -->
      <% if current_step == 'repairs' && jobs_available > 0 %>
        <div class="alert alert-success mt-3 mb-0">
          <i class="bi bi-play-circle-fill me-2"></i>
          <strong>Ready to work!</strong> There <%= jobs_available == 1 ? 'is' : 'are' %> <strong><%= jobs_available %></strong> job<%= 's' if jobs_available > 1 %> waiting for you.
          <% if new_jobs_available > 0 %>
            <span class="badge bg-danger ms-2">🔥 NEW</span>
          <% end %>
        </div>
      <% elsif current_step == 'repairs' && jobs_active > 0 %>
        <div class="alert alert-primary mt-3 mb-0">
          <i class="bi bi-tools me-2"></i>
          <strong>Keep going!</strong> You have <strong><%= jobs_active %></strong> active job<%= 's' if jobs_active > 1 %> in progress.
        </div>
      <% elsif current_step == 'parts' %>
        <div class="alert alert-warning mt-3 mb-0">
          <i class="bi bi-hourglass-split me-2"></i>
          <strong>Waiting for parts.</strong> <%= parts_pending %> part<%= 's' if parts_pending > 1 %> still need to be ordered.
        </div>
      <% elsif current_step == 'qc' %>
        <div class="alert alert-info mt-3 mb-0">
          <i class="bi bi-clipboard-check me-2"></i>
          <strong>QC pending.</strong> <%= qc_pending %> job<%= 's' if qc_pending > 1 %> waiting for inspection.
        </div>
      <% end %>
    </div>
  </div>

  <!-- COMPLETED - WAITING FOR QC SECTION -->
  <% if @pending_qc_jobs&.any? %>
    <div class="card mb-4 border-info border-3">
      <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>✅ Completed - Waiting for QC (<%= @pending_qc_jobs.count %>)</h5>
        <span class="badge bg-dark text-white"><%= @pending_qc_jobs.count %> need QC</span>
      </div>
      <div class="card-body">
        <p class="text-info mb-3"><i class="bi bi-info-circle me-1"></i> These jobs are completed and waiting for inspector QC. You cannot start QC - this is for inspectors only.</p>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-info">
              <tr>
                <th>Job #</th>
                <th>Vehicle</th>
                <th>Description</th>
                <th>Completed</th>
                <th>Parts Used</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_qc_jobs.each do |job| %>
                <% inspection = job.inspection %>
                <tr>
                  <td><strong>#<%= job.id %></strong></td>
                  <td>
                    <%= inspection&.vehicle&.license_plate %><br>
                    <small class="text-muted"><%= inspection&.vehicle&.make %> <%= inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.description.truncate(40) %></td>
                  <td>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>
                      <%= time_ago_in_words(job.completed_at) if job.completed_at %> ago
                    </span>
                  </td>
                  <td>
                    <% if job.inspection_job_parts&.any? %>
                      <% job.inspection_job_parts.each do |part_item| %>
                        <div><small><%= part_item.part_name %> x<%= part_item.quantity %></small></div>
                      <% end %>
                    <% else %>
                      <small class="text-muted">No parts used</small>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge bg-warning">
                      <i class="bi bi-hourglass-split me-1"></i> Pending QC
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- MY CURRENT JOBS SECTION -->
  <% if @assigned_jobs&.any? %>
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-tools me-2"></i>My Current Jobs (<%= @assigned_jobs.count %>)</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <% @assigned_jobs.each do |assignment| %>
            <% job = assignment.inspection_job %>
            <div class="col-md-6 mb-3">
              <div class="card border-primary">
                <div class="card-body">
                  <div class="d-flex justify-content-between mb-2">
                    <h6 class="fw-bold">Job #<%= job.id %></h6>
                    <span class="badge bg-<%= job.priority == 'high' ? 'danger' : 'info' %>">
                      <%= job.priority&.humanize || 'Normal' %> Priority
                    </span>
                  </div>
                  
                  <p class="fw-bold"><%= job.description %></p>
                  
                  <div class="text-muted small mb-2">
                    <i class="bi bi-truck me-1"></i> <%= job.inspection&.vehicle&.license_plate %> 
                    (<%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %>)
                  </div>

                  <!-- Status Badge -->
                  <div class="mb-2">
                    <span class="badge bg-<%= job_status_color(job, assignment) %>" style="font-size: 0.9rem;">
                      <%= job_status(job, assignment) %>
                    </span>
                  </div>

                  <!-- Progress Bar -->
                  <div class="progress mb-2" style="height: 8px;">
                    <% if job.completed_at %>
                      <div class="progress-bar bg-success" style="width: 100%"></div>
                    <% elsif assignment.started_at %>
                      <div class="progress-bar bg-warning" style="width: 50%"></div>
                    <% else %>
                      <div class="progress-bar bg-info" style="width: 25%"></div>
                    <% end %>
                  </div>

                  <!-- Time info -->
                  <div class="small text-muted mb-2">
                    <% if job.completed_at %>
                      <i class="bi bi-check-circle"></i> Completed <%= time_ago_in_words(job.completed_at) %> ago
                    <% elsif assignment.started_at %>
                      <i class="bi bi-clock"></i> Started <%= time_ago_in_words(assignment.started_at) %> ago
                    <% else %>
                      <i class="bi bi-hourglass"></i> Assigned <%= time_ago_in_words(job.created_at) %> ago
                    <% end %>
                  </div>

                  <!-- Parts needed summary -->
                  <% if job.inspection_job_parts&.any? %>
                    <div class="bg-light p-2 rounded small mb-2">
                      <strong>Parts needed:</strong>
                      <% job.inspection_job_parts.each do |part_item| %>
                        <div class="d-flex justify-content-between">
                          <span><%= part_item.part_name %></span>
                          <span>x<%= part_item.quantity %></span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                  <%= link_to "View Job Details →", vmcott_mechanic_job_path(job), class: "btn btn-sm btn-outline-primary w-100" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- READY TO START SECTION - Green = Take these! -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-play-circle me-2"></i>✅ Ready to Start (<%= @ready_jobs&.count || 0 %>)</h5>
      <!-- NEW: Badge for new jobs in this section -->
      <% new_jobs_count = @new_jobs_available.to_i %>
      <% if new_jobs_count > 0 %>
        <span class="badge bg-warning text-dark ms-2">🔥 <%= new_jobs_count %> NEW</span>
      <% end %>
    </div>
    <div class="card-body">
      <% if @ready_jobs&.any? %>
        <p class="text-success mb-3">
          <i class="bi bi-info-circle me-1"></i> These jobs are ready for you to take right now!
          <!-- NEW: Visual indicator for new jobs -->
          <% if new_jobs_count > 0 %>
            <span class="badge bg-warning text-dark ms-2">🆕 New jobs just arrived!</span>
          <% end %>
        </p>
        <div class="row">
          <% @ready_jobs.each_with_index do |job, index| %>
            <% is_new_job = index < new_jobs_count %>
            <div class="col-md-6 col-lg-4 mb-3">
              <div class="card border-success h-100 <%= 'border-warning border-3' if is_new_job %>">
                <div class="card-body">
                  <!-- NEW: "NEW" badge for fresh jobs -->
                  <% if is_new_job %>
                    <div class="position-absolute top-0 end-0 m-2">
                      <span class="badge bg-warning text-dark">NEW</span>
                    </div>
                  <% end %>
                  
                  <div class="d-flex justify-content-between mb-2">
                    <h6 class="fw-bold">Job #<%= job.id %></h6>
                    <span class="badge bg-<%= job.priority == 'high' ? 'danger' : 'success' %>">
                      <%= job.priority&.humanize || 'Normal' %> Priority
                    </span>
                  </div>
                  
                  <p class="fw-bold"><%= job.description %></p>
                  
                  <div class="mb-2">
                    <i class="bi bi-truck me-1"></i> <%= job.inspection&.vehicle&.license_plate %><br>
                    <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </div>

                  <!-- Status Badge -->
                  <div class="mb-2">
                    <span class="badge bg-success" style="font-size: 0.9rem;">✅ Ready to Start</span>
                  </div>

                  <!-- Parts status - simple -->
                  <% if job.inspection_job_parts&.any? %>
                    <div class="small mb-2">
                      <% if job.inspection_job_parts.all? { |p| p.inventory? && p.part&.current_stock.to_i >= p.quantity } %>
                        <span class="badge bg-success">✅ All parts in stock</span>
                      <% else %>
                        <span class="badge bg-warning">⏳ Some parts need ordering</span>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="small text-muted mb-3">
                    <i class="bi bi-calendar"></i> Created <%= time_ago_in_words(job.created_at) %> ago
                  </div>

                  <%= button_to "Take This Job", vmcott_mechanic_assign_job_path(job), 
                        method: :post, 
                        class: "btn btn-success w-100",
                        data: { confirm: "Start working on this job?" } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted mb-0">No jobs ready to start right now. Check back soon!</p>
      <% end %>
    </div>
  </div>

  <!-- WAITING SECTION - Yellow = Not ready yet, here's why -->
  <% if @waiting_jobs&.any? %>
    <div class="card mb-4">
      <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-hourglass-split me-2"></i>⏳ Waiting for Approval (<%= @waiting_jobs.count %>)</h5>
      </div>
      <div class="card-body">
        <p class="text-warning mb-3"><i class="bi bi-info-circle me-1"></i> These jobs aren't ready to start yet:</p>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>Job #</th>
                <th>Vehicle</th>
                <th>Description</th>
                <th>Status</th>
                <th>Waiting Since</th>
              </tr>
            </thead>
            <tbody>
              <% @waiting_jobs.each do |job| %>
                <tr>
                  <td><strong>#<%= job.id %></strong></td>
                  <td>
                    <%= job.inspection&.vehicle&.license_plate %><br>
                    <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.description.truncate(40) %></td>
                  <td>
                    <span class="badge bg-<%= waiting_status_color(job) %>" style="font-size: 0.9rem;">
                      <%= waiting_status(job) %>
                    </span>
                  </td>
                  <td><%= time_ago_in_words(job.created_at) %> ago</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- TAKEN BY OTHERS SECTION - Grey = Other mechanics working on these -->
  <% if @taken_jobs&.any? %>
    <div class="card mb-4">
      <div class="card-header bg-secondary text-white">
        <h5 class="mb-0"><i class="bi bi-people me-2"></i>👥 Being Worked On By Others (<%= @taken_jobs.count %>)</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>Job</th>
                <th>Vehicle</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Started</th>
              </tr>
            </thead>
            <tbody>
              <% @taken_jobs.each do |job| %>
                <% mechanic = User.find_by(id: job.assigned_mechanic_id) %>
                <% assignment = job.mechanic_assignments.find_by(mechanic_id: job.assigned_mechanic_id) %>
                <tr>
                  <td>#<%= job.id %></td>
                  <td><%= job.inspection&.vehicle&.license_plate %></td>
                  <td><%= mechanic&.name || 'Unknown' %></td>
                  <td>
                    <% if assignment&.started_at %>
                      <span class="badge bg-info">🔧 In Progress</span>
                    <% else %>
                      <span class="badge bg-secondary">📋 Assigned</span>
                    <% end %>
                  </td>
                  <td><%= time_ago_in_words(job.updated_at) %> ago</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Add CSS for workflow styling and animations -->
<style>
.workflow-step {
  transition: all 0.2s ease;
  border-left: 4px solid transparent;
}

.workflow-step.bg-light.border.border-warning {
  background-color: #fff3cd !important;
  border-left: 4px solid #ffc107 !important;
}

.workflow-step .step-indicator {
  width: 32px;
  text-align: center;
}

.bg-light.border.border-warning {
  background-color: #fff9e6 !important;
  border-width: 1px !important;
}

/* NEW: Animation for new job indicators */
@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.8; }
  100% { transform: scale(1); opacity: 1; }
}

.position-absolute.top-0.start-100.translate-middle.p-2.bg-danger {
  animation: pulse 2s infinite;
}

.border-warning.border-3 {
  box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.3);
  transition: box-shadow 0.3s ease;
}

.border-warning.border-3:hover {
  box-shadow: 0 0 0 5px rgba(255, 193, 7, 0.5);
}
</style>