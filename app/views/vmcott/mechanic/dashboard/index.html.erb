<%# app/views/vmcott/mechanic/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">🔧 Welcome, <%= current_user.name %></h1>
      <p class="text-muted">VMCOTT Mechanic - Repairs & Work Orders</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">My Assigned Jobs</h5>
          <h2 class="display-4"><%= @assigned_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Available Jobs</h5>
          <h2 class="display-4"><%= @available_jobs&.count || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Completed Today</h5>
          <h2 class="display-4"><%= @completed_today || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>My Assigned Jobs</h5>
        </div>
        <div class="card-body">
          <% if @assigned_jobs && @assigned_jobs.any? %>
            <% @assigned_jobs.each do |job| %>
              <div class="d-flex justify-content-between align-items-center mb-2 p-2 border-bottom">
                <div>
                  <strong><%= job.work_order_number %></strong>
                  <div class="small text-muted"><%= job.vehicle&.license_plate %></div>
                </div>
                <div>
                  <span class="badge bg-<%= job.status == 'in_progress' ? 'warning' : 'secondary' %> me-2">
                    <%= job.status.humanize %>
                  </span>
                  <%= link_to "View", mechanic_job_path(job), class: "btn btn-sm btn-primary" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">No assigned jobs</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Available Jobs</h5>
        </div>
        <div class="card-body">
          <% if @available_jobs && @available_jobs.any? %>
            <% @available_jobs.each do |job| %>
              <div class="d-flex justify-content-between align-items-center mb-2 p-2 border-bottom">
                <div>
                  <strong><%= job.work_order_number %></strong>
                  <div class="small text-muted"><%= job.vehicle&.license_plate %></div>
                </div>
                <%= button_to "Assign to Me", mechanic_assign_job_path(job), method: :post, class: "btn btn-sm btn-success" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">No available jobs</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>