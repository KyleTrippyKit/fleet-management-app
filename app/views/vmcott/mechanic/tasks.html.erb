<%# app/views/vmcott/mechanic/tasks.html.erb %>
<div class="min-h-screen bg-gray-100 pb-24">
  <!-- Header -->
  <div class="bg-white shadow p-4 sticky top-0 z-10">
    <h1 class="text-xl font-bold">🔧 My Tasks</h1>
    <p class="text-sm text-gray-500">Welcome back, <%= current_user.name %></p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-3 p-4">
    <div class="bg-blue-500 text-white rounded-xl p-3 shadow">
      <p class="text-sm">In Progress</p>
      <p class="text-2xl font-bold"><%= @in_progress_count %></p>
    </div>
    <div class="bg-yellow-500 text-white rounded-xl p-3 shadow">
      <p class="text-sm">Paused</p>
      <p class="text-2xl font-bold"><%= @paused_count %></p>
    </div>
    <div class="bg-red-500 text-white rounded-xl p-3 shadow">
      <p class="text-sm">Blocked</p>
      <p class="text-2xl font-bold"><%= @blocked_count %></p>
    </div>
    <div class="bg-green-500 text-white rounded-xl p-3 shadow">
      <p class="text-sm">Hours Today</p>
      <p class="text-2xl font-bold"><%= number_with_precision(@total_hours_today, precision: 1) %></p>
    </div>
  </div>

  <!-- My Assigned Tasks -->
  <% if @assigned_tasks.present? %>
    <div class="p-4">
      <h2 class="text-lg font-bold mb-2">📋 My Tasks</h2>
      <% @assigned_tasks.each do |task| %>
        <div class="bg-white rounded-xl shadow p-4 mb-3 hover:shadow-md transition">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h3 class="font-semibold text-gray-800"><%= task.name %></h3>
              <p class="text-sm text-gray-600 mt-1">
                <% if task.inspection_job&.work_order&.vehicle %>
                  <%= task.inspection_job.work_order.vehicle.license_plate %>
                <% else %>
                  <span class="text-gray-400">No vehicle assigned</span>
                <% end %>
              </p>
              <p class="text-sm text-gray-500 mt-1"><%= truncate(task.description, length: 80) if task.description %></p>
            </div>
            <span class="text-xs px-2 py-1 rounded 
              <%= case task.status
                  when 'in_progress' then 'bg-green-100 text-green-700'
                  when 'paused' then 'bg-yellow-100 text-yellow-700'
                  when 'blocked' then 'bg-red-100 text-red-700'
                  else 'bg-gray-100 text-gray-600'
                  end %>">
              <%= task.status.upcase %>
            </span>
          </div>
          
          <div class="mt-3">
            <div class="flex justify-between text-sm text-gray-600 mb-1">
              <span>Progress</span>
              <span><%= task.progress_percentage %>%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-500 rounded-full h-2" style="width: <%= task.progress_percentage %>%"></div>
            </div>
          </div>
          
          <div class="mt-3 flex gap-2">
            <% if task.status == 'approved' %>
              <%= button_to "Start", start_vmcott_mechanic_task_path(task), method: :post, class: "flex-1 bg-blue-600 text-white py-2 rounded-lg font-medium" %>
            <% elsif task.status == 'in_progress' %>
              <%= button_to "Pause", pause_vmcott_mechanic_task_path(task), method: :post, class: "flex-1 bg-yellow-500 text-white py-2 rounded-lg font-medium" %>
              <%= button_to "Complete", complete_vmcott_mechanic_task_path(task), method: :post, class: "flex-1 bg-green-600 text-white py-2 rounded-lg font-medium" %>
              <%= button_tag "Block", onclick: "showBlockModal(<%= task.id %>)", class: "flex-1 bg-red-500 text-white py-2 rounded-lg font-medium" %>
            <% elsif task.status == 'paused' %>
              <%= button_to "Resume", resume_vmcott_mechanic_task_path(task), method: :post, class: "flex-1 bg-blue-600 text-white py-2 rounded-lg font-medium" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Available Tasks -->
  <% if @available_tasks.present? %>
    <div class="p-4">
      <h2 class="text-lg font-bold mb-2">🆓 Available Tasks</h2>
      <% @available_tasks.each do |task| %>
        <div class="bg-white rounded-xl shadow p-4 mb-3">
          <div class="flex justify-between">
            <h3 class="font-semibold"><%= task.name %></h3>
            <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600">
              <%= task.priority.upcase if task.priority %>
            </span>
          </div>
          <p class="text-sm text-gray-600 mt-1">
            <% if task.inspection_job&.work_order&.vehicle %>
              <%= task.inspection_job.work_order.vehicle.license_plate %>
            <% else %>
              <span class="text-gray-400">No vehicle assigned</span>
            <% end %>
          </p>
          <p class="text-sm text-gray-500 mt-1"><%= truncate(task.description, length: 80) if task.description %></p>
          <div class="mt-2 flex justify-between text-sm">
            <span>Est: <%= task.estimated_hours ? "#{task.estimated_hours} hrs" : "Not set" %></span>
            <%= button_to "Take Task", assign_vmcott_mechanic_task_path(task), method: :post, class: "bg-blue-600 text-white px-4 py-1 rounded-lg text-sm font-medium" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Completed Today -->
  <div class="p-4">
    <h2 class="text-lg font-bold mb-2">✅ Completed Today (<%= @completed_tasks_count %>)</h2>
  </div>
</div>

<!-- Block Modal -->
<div id="blockModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-20">
  <div class="bg-white rounded-xl w-full max-w-md mx-4">
    <div class="p-4 border-b">
      <h3 class="text-lg font-bold">Block Task</h3>
    </div>
    <div class="p-4">
      <input type="hidden" id="block-task-id">
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Reason for blocking</label>
        <textarea id="block-reason" rows="3" class="w-full border rounded-lg p-2" placeholder="Why is this task blocked?"></textarea>
      </div>
    </div>
    <div class="p-4 border-t flex gap-2">
      <button onclick="closeBlockModal()" class="flex-1 bg-gray-200 py-2 rounded-lg">Cancel</button>
      <button onclick="submitBlock()" class="flex-1 bg-red-500 text-white py-2 rounded-lg">Block Task</button>
    </div>
  </div>
</div>

<script>
function showBlockModal(taskId) {
  document.getElementById('block-task-id').value = taskId;
  document.getElementById('blockModal').classList.remove('hidden');
  document.getElementById('blockModal').classList.add('flex');
}

function closeBlockModal() {
  document.getElementById('blockModal').classList.add('hidden');
  document.getElementById('blockModal').classList.remove('flex');
}

async function submitBlock() {
  const taskId = document.getElementById('block-task-id').value;
  const reason = document.getElementById('block-reason').value;
  
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = `/vmcott/mechanic/tasks/${taskId}/block`;
  
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
  const csrfInput = document.createElement('input');
  csrfInput.type = 'hidden';
  csrfInput.name = 'authenticity_token';
  csrfInput.value = csrfToken;
  form.appendChild(csrfInput);
  
  const reasonInput = document.createElement('input');
  reasonInput.type = 'hidden';
  reasonInput.name = 'reason';
  reasonInput.value = reason;
  form.appendChild(reasonInput);
  
  document.body.appendChild(form);
  form.submit();
}
</script>