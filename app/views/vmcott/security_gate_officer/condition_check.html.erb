<%# app/views/vmcott/security_gate_officer/condition_check.html.erb %>
<%# Condensed vehicle condition check-in form - Mobile/Tablet friendly %>

<div class="container-fluid py-3">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">
      <i class="bi bi-clipboard-check me-2"></i>
      Check-in: <strong><%= @vehicle.license_plate %></strong>
    </h5>
    <%= link_to "← Back", vmcott_security_gate_officer_manual_entry_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>

  <!-- Vehicle Info Card -->
  <div class="card bg-light mb-3">
    <div class="card-body py-2">
      <div class="row">
        <div class="col">
          <small class="text-muted d-block"><%= @vehicle.make %> <%= @vehicle.model %> (<%= @vehicle.year_of_manufacture %>)</small>
          <small class="text-muted"><%= @vehicle.color %> • <%= @vehicle.vehicle_type %></small>
        </div>
        <div class="col-auto">
          <span class="badge bg-primary"><%= @vehicle.agency&.code || 'PUBLIC' %></span>
        </div>
      </div>
    </div>
  </div>

  <%= form_with url: vmcott_security_gate_officer_submit_condition_path(@vehicle.id), 
                local: true, 
                html: { multipart: true, id: "condition-form", class: "needs-validation" } do |f| %>

    <!-- SECTION 1: Quick Stats -->
    <div class="card mb-3">
      <div class="card-header bg-primary text-white py-2">
        <h6 class="mb-0"><i class="bi bi-speedometer2 me-2"></i> Quick Stats</h6>
      </div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label small fw-bold">Fuel Level (%)</label>
            <div class="input-group input-group-sm">
              <input type="number" name="fuel_level" class="form-control" min="0" max="100" required value="50">
              <span class="input-group-text">%</span>
            </div>
          </div>
          <div class="col-6">
            <label class="form-label small fw-bold">Odometer (km)</label>
            <input type="number" name="odometer" class="form-control" required value="<%= @vehicle.mileage || 0 %>">
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Condition Tiles (Condensed) -->
    <div class="card mb-3">
      <div class="card-header bg-success text-white py-2">
        <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i> Vehicle Condition</h6>
      </div>
      <div class="card-body p-2">
        
        <!-- Exterior Damage - Horizontal Tiles -->
        <div class="mb-3">
          <label class="form-label small fw-bold mb-1">Exterior Damage</label>
          <div class="d-flex flex-wrap gap-2">
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="scratches" class="btn-check" id="ext_scratches" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_scratches">Scratches</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="dents" class="btn-check" id="ext_dents" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_dents">Dents</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="paint" class="btn-check" id="ext_paint" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_paint">Paint</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="glass" class="btn-check" id="ext_glass" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_glass">Glass</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="mirror" class="btn-check" id="ext_mirror" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_mirror">Mirror</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="lights" class="btn-check" id="ext_lights" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="ext_lights">Lights</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="exterior[]" value="none" class="btn-check" id="ext_none" autocomplete="off" checked>
              <label class="btn btn-outline-success btn-sm" for="ext_none">✅ None</label>
            </div>
          </div>
          <input type="text" name="exterior_notes" class="form-control form-control-sm mt-2" placeholder="Location of damage (if any)">
        </div>

        <!-- Interior Issues - Horizontal Tiles -->
        <div class="mb-3">
          <label class="form-label small fw-bold mb-1">Interior</label>
          <div class="d-flex flex-wrap gap-2">
            <div class="form-check">
              <input type="checkbox" name="interior[]" value="clean" class="btn-check" id="int_clean" autocomplete="off" checked>
              <label class="btn btn-outline-success btn-sm" for="int_clean">✅ Clean</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="interior[]" value="dirty" class="btn-check" id="int_dirty" autocomplete="off">
              <label class="btn btn-outline-warning btn-sm" for="int_dirty">Dirty</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="interior[]" value="seat_damage" class="btn-check" id="int_seat" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="int_seat">Seat damage</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="interior[]" value="carpet_damage" class="btn-check" id="int_carpet" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="int_carpet">Carpet</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="interior[]" value="odor" class="btn-check" id="int_odor" autocomplete="off">
              <label class="btn btn-outline-danger btn-sm" for="int_odor">Odor</label>
            </div>
          </div>
        </div>

        <!-- Tires - Radio Buttons -->
        <div class="mb-3">
          <label class="form-label small fw-bold mb-1">Tires</label>
          <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
              <input type="radio" name="tire_status" value="good" class="form-check-input" id="tire_good" checked>
              <label class="form-check-label small" for="tire_good">✅ Good</label>
            </div>
            <div class="form-check">
              <input type="radio" name="tire_status" value="low_pressure" class="form-check-input" id="tire_low">
              <label class="form-check-label small" for="tire_low">⚠️ Low pressure</label>
            </div>
            <div class="form-check">
              <input type="radio" name="tire_status" value="damage" class="form-check-input" id="tire_damage">
              <label class="form-check-label small" for="tire_damage">🔴 Damage</label>
            </div>
          </div>
          <input type="text" name="tire_notes" class="form-control form-control-sm mt-2" placeholder="Tire notes (if any)">
        </div>

        <!-- Warning Lights -->
        <div class="mb-2">
          <label class="form-label small fw-bold mb-1">Warning Lights</label>
          <div class="d-flex flex-wrap gap-2">
            <div class="form-check">
              <input type="checkbox" name="warnings[]" value="none" class="btn-check" id="warn_none" autocomplete="off" checked>
              <label class="btn btn-outline-success btn-sm" for="warn_none">✅ None</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="warnings[]" value="check_engine" class="btn-check" id="warn_engine" autocomplete="off">
              <label class="btn btn-outline-warning btn-sm" for="warn_engine">Check engine</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="warnings[]" value="other" class="btn-check" id="warn_other" autocomplete="off">
              <label class="btn btn-outline-warning btn-sm" for="warn_other">Other</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 3: Notes & Photos -->
    <div class="card mb-3">
      <div class="card-header bg-secondary text-white py-2">
        <h6 class="mb-0"><i class="bi bi-camera me-2"></i> Notes & Photos</h6>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label small fw-bold">Additional Notes</label>
          <textarea name="notes" class="form-control" rows="2" placeholder="Any visible issues?"></textarea>
        </div>
        
        <label class="form-label small fw-bold mb-2">Quick Photos</label>
        <div class="row g-2">
          <div class="col-6">
            <input type="file" name="photo_front" accept="image/*" class="form-control form-control-sm" id="photo_front" capture="environment">
            <label for="photo_front" class="small text-muted">Front</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_rear" accept="image/*" class="form-control form-control-sm" id="photo_rear" capture="environment">
            <label for="photo_rear" class="small text-muted">Rear</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_left" accept="image/*" class="form-control form-control-sm" id="photo_left" capture="environment">
            <label for="photo_left" class="small text-muted">Left side</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_right" accept="image/*" class="form-control form-control-sm" id="photo_right" capture="environment">
            <label for="photo_right" class="small text-muted">Right side</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_dashboard" accept="image/*" class="form-control form-control-sm" id="photo_dash" capture="environment">
            <label for="photo_dash" class="small text-muted">Dashboard</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_odometer" accept="image/*" class="form-control form-control-sm" id="photo_odo" capture="environment">
            <label for="photo_odo" class="small text-muted">Odometer</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_fuel" accept="image/*" class="form-control form-control-sm" id="photo_fuel" capture="environment">
            <label for="photo_fuel" class="small text-muted">Fuel gauge</label>
          </div>
          <div class="col-6">
            <input type="file" name="photo_damage" accept="image/*" class="form-control form-control-sm" id="photo_damage" capture="environment">
            <label for="photo_damage" class="small text-muted">Damage</label>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 4: Driver Signature (Condensed) -->
    <div class="card mb-3 border-warning">
      <div class="card-header bg-warning text-dark py-2">
        <h6 class="mb-0"><i class="bi bi-pen me-2"></i> Driver Acknowledgment</h6>
      </div>
      <div class="card-body">
        <div class="alert alert-warning py-2 small mb-3">
          <i class="bi bi-exclamation-triangle me-1"></i>
          Driver must review and sign
        </div>
        
        <div class="row g-2 mb-3">
          <div class="col-8">
            <label class="form-label small fw-bold">Driver Name</label>
            <input type="text" name="driver_name" class="form-control" required value="<%= @driver_name %>">
          </div>
          <div class="col-4">
            <label class="form-label small fw-bold">ID (opt)</label>
            <input type="text" name="driver_id_number" class="form-control" placeholder="ID #">
          </div>
        </div>
        
        <!-- Simple Signature Pad -->
        <div class="mb-3">
          <label class="form-label small fw-bold">Signature</label>
          <div class="border rounded bg-light" style="height: 80px; width: 100%;" id="signature-pad" onclick="openSignatureModal()">
            <div class="d-flex align-items-center justify-content-center h-100 text-muted small">
              <i class="bi bi-pencil me-1"></i> Tap to sign
            </div>
          </div>
          <input type="hidden" name="signature_data" id="signature-data">
          <small class="text-muted">Driver acknowledges vehicle condition is accurate</small>
        </div>
        
        <!-- Simple Signature Modal (Bootstrap) -->
        <div class="modal fade" id="signatureModal" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h6 class="modal-title">Driver Signature</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <canvas id="signature-canvas" style="width: 100%; height: 150px; border: 1px solid #ccc; touch-action: none;"></canvas>
                <div class="mt-2 d-flex gap-2">
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="clear-signature">Clear</button>
                  <button type="button" class="btn btn-sm btn-success" id="save-signature" data-bs-dismiss="modal">Save</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Terms checkbox -->
        <div class="form-check">
          <input type="checkbox" name="terms_agreed" class="form-check-input" id="terms" required>
          <label class="form-check-label small" for="terms">
            I confirm the vehicle condition above is accurate
          </label>
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="d-grid gap-2">
      <button type="submit" class="btn btn-success btn-lg" id="submit-btn">
        <i class="bi bi-check-circle me-2"></i> Complete Check-in
      </button>
    </div>
  <% end %>
</div>

<!-- Signature Pad JavaScript -->
<script>
  let canvas, ctx, drawing = false;
  
  function openSignatureModal() {
    var modal = new bootstrap.Modal(document.getElementById('signatureModal'));
    modal.show();
    
    // Initialize canvas after modal is shown
    setTimeout(() => {
      canvas = document.getElementById('signature-canvas');
      if (canvas) {
        ctx = canvas.getContext('2d');
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 2;
        
        // Mouse events
        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mouseleave', stopDrawing);
        
        // Touch events for mobile
        canvas.addEventListener('touchstart', handleTouchStart);
        canvas.addEventListener('touchmove', handleTouchMove);
        canvas.addEventListener('touchend', stopDrawing);
      }
    }, 200);
  }
  
  function startDrawing(e) {
    drawing = true;
    ctx.beginPath();
    ctx.moveTo(e.offsetX, e.offsetY);
  }
  
  function draw(e) {
    if (!drawing) return;
    ctx.lineTo(e.offsetX, e.offsetY);
    ctx.stroke();
  }
  
  function handleTouchStart(e) {
    e.preventDefault();
    const touch = e.touches[0];
    const rect = canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    
    drawing = true;
    ctx.beginPath();
    ctx.moveTo(x, y);
  }
  
  function handleTouchMove(e) {
    e.preventDefault();
    if (!drawing) return;
    
    const touch = e.touches[0];
    const rect = canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    
    ctx.lineTo(x, y);
    ctx.stroke();
  }
  
  function stopDrawing() {
    drawing = false;
  }
  
  document.getElementById('clear-signature')?.addEventListener('click', function() {
    if (ctx && canvas) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  });
  
  document.getElementById('save-signature')?.addEventListener('click', function() {
    if (canvas) {
      const signatureData = canvas.toDataURL();
      document.getElementById('signature-data').value = signatureData;
      
      // Update the signature pad display
      const pad = document.getElementById('signature-pad');
      pad.innerHTML = '<img src="' + signatureData + '" style="width: 100%; height: 100%; object-fit: contain;">';
      pad.onclick = null;
    }
  });
  
  // Auto-uncheck "None" when other checkboxes are checked
  document.querySelectorAll('input[name="exterior[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const noneCheckbox = document.getElementById('ext_none');
      if (this.value !== 'none' && this.checked) {
        noneCheckbox.checked = false;
      }
      if (this.value === 'none' && this.checked) {
        document.querySelectorAll('input[name="exterior[]"]:not(#ext_none)').forEach(cb => cb.checked = false);
      }
    });
  });
  
  document.querySelectorAll('input[name="interior[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const cleanCheckbox = document.getElementById('int_clean');
      if (this.value !== 'clean' && this.checked) {
        cleanCheckbox.checked = false;
      }
      if (this.value === 'clean' && this.checked) {
        document.querySelectorAll('input[name="interior[]"]:not(#int_clean)').forEach(cb => cb.checked = false);
      }
    });
  });
  
  document.querySelectorAll('input[name="warnings[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const noneCheckbox = document.getElementById('warn_none');
      if (this.value !== 'none' && this.checked) {
        noneCheckbox.checked = false;
      }
      if (this.value === 'none' && this.checked) {
        document.querySelectorAll('input[name="warnings[]"]:not(#warn_none)').forEach(cb => cb.checked = false);
      }
    });
  });
</script>