<%# app/views/vmcott/security_gate_officer/reception_logs/show.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-receipt me-2"></i>
      Check-in Details
    </h1>
    <div>
      <% if @log.condition_report %>
        <%= link_to "🖨️ Print Report", print_vmcott_vehicle_condition_report_path(@log.condition_report), 
            class: "btn btn-outline-primary me-2", 
            target: "_blank" %>
      <% end %>
      <%= link_to "← Back", vmcott_security_gate_officer_reception_logs_path, class: "btn btn-outline-secondary me-2" %>
      <%= link_to "Dashboard", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-primary" %>
    </div>
  </div>

  <!-- 🔥 Customer Portal Access Card with Auto-fill Button -->
  <div class="card shadow-sm mb-4 border-info">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0"><i class="bi bi-globe2 me-2"></i> Customer Portal Access</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="text-muted small mb-1">License Plate</label>
          <div class="bg-light p-3 rounded">
            <code class="fs-4 fw-bold"><%= @log.vehicle&.license_plate || 'N/A' %></code>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <label class="text-muted small mb-1">Receipt Number</label>
          <div class="bg-light p-3 rounded">
            <code class="fs-5"><%= @log.receipt_number || 'N/A' %></code>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <label class="text-muted small mb-1">Portal Login URL</label>
          <div class="bg-light p-3 rounded">
            <code class="small" style="word-break: break-all;"><%= customer_login_url %></code>
            <button onclick="copyToClipboard('<%= customer_login_url %>')" class="btn btn-sm btn-outline-primary ms-2">
              <i class="bi bi-clipboard"></i> Copy
            </button>
          </div>
        </div>
      </div>
      
      <!-- 🔥 Auto-fill Portal Link Button -->
      <div class="mt-3">
        <a href="<%= customer_login_url(license_plate: @log.vehicle&.license_plate, receipt_number: @log.receipt_number, auto_filled: true) %>" 
           target="_blank" 
           class="btn btn-success w-100 mb-2">
          <i class="bi bi-box-arrow-up-right me-2"></i> Open Customer Portal (Auto-filled)
        </a>
        <p class="small text-muted mb-0 text-center">
          <i class="bi bi-info-circle me-1"></i> 
          Clicking this button will open the portal with license plate and receipt number pre-filled.
          Customer only needs to enter their email.
        </p>
      </div>
      
      <div class="alert alert-success mt-3 mb-0">
        <div class="d-flex align-items-center">
          <i class="bi bi-info-circle-fill me-2"></i>
          <div>
            <strong>Customer Instructions:</strong> Share these credentials with the customer so they can track their vehicle repair online.
            <ul class="mt-2 mb-0">
              <li>1. Click the "Open Customer Portal (Auto-filled)" button above</li>
              <li>2. Enter your email address</li>
              <li>3. View inspection status, approve quotations, and track repairs</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Main Details -->
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Vehicle Information</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th width="40%">License Plate:</th>
                  <td><strong><%= @log.vehicle&.license_plate || 'N/A' %></strong> 
                  <button onclick="copyToClipboard('<%= @log.vehicle&.license_plate %>')" class="btn btn-sm btn-outline-secondary ms-2"><i class="bi bi-clipboard"></i></button>
                </td>
                </tr>
                <tr>
                  <th>Make/Model:</th>
                  <td><%= @log.vehicle&.make %> <%= @log.vehicle&.model %></td>
                </tr>
                <tr>
                  <th>Year:</th>
                  <td><%= @log.vehicle&.year_of_manufacture %></td>
                </tr>
                <tr>
                  <th>Color:</th>
                  <td><%= @log.vehicle&.color %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th width="40%">Agency:</th>
                  <td><span class="badge bg-primary"><%= @log.vehicle&.agency&.code || 'Public' %></span></th>
                </tr>
                <tr>
                  <th>Check-in Time:</th>
                  <td><%= @log.received_at.strftime("%B %d, %Y at %I:%M %p") %></td>
                </tr>
                <tr>
                  <th>Driver:</th>
                  <td><%= @log.driver_name %></td>
                </tr>
                <tr>
                  <th>Receipt Number:</th>
                  <td>
                    <code><%= @log.receipt_number || 'N/A' %></code>
                    <button onclick="copyToClipboard('<%= @log.receipt_number %>')" class="btn btn-sm btn-outline-secondary ms-1"><i class="bi bi-clipboard"></i></button>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Customer Contact Card -->
      <% if @log.customer_email.present? || @log.customer_phone.present? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i> Customer Contact</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% if @log.customer_name.present? %>
                <div class="col-md-12 mb-2">
                  <strong>Name:</strong> <%= @log.customer_name %>
                </div>
              <% end %>
              <% if @log.customer_email.present? %>
                <div class="col-md-6">
                  <strong>Email:</strong> <%= @log.customer_email %>
                </div>
              <% end %>
              <% if @log.customer_phone.present? %>
                <div class="col-md-6">
                  <strong>Phone:</strong> <%= @log.customer_phone %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Condition Report Card -->
      <% if @log.condition_report %>
        <div class="card shadow-sm mb-4">
          <div class="card-header <%= @log.condition_report.exterior_damage? ? 'bg-warning' : 'bg-success' %> text-white">
            <h5 class="mb-0"><i class="bi bi-clipboard-check me-2"></i> Condition Report #<%= @log.condition_report.id %></h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="fw-bold">Quick Stats</h6>
                <table class="table table-sm">
                  <tr>
                    <th>Fuel Level:</th>
                    <td><%= @log.condition_report.fuel_level %>%</th>
                  </tr>
                  <tr>
                    <th>Odometer:</th>
                    <td><%= @log.condition_report.odometer %> km</th>
                  </tr>
                  <tr>
                    <th>Signed:</th>
                    <td>
                      <% if @log.condition_report.signed_at.present? %>
                        <% if @log.condition_report.signed_at.is_a?(String) %>
                          <%= @log.condition_report.signed_at %>
                        <% else %>
                          <%= @log.condition_report.signed_at.strftime("%I:%M %p") %>
                        <% end %>
                      <% else %>
                        N/A
                      <% end %>
                    </td>
                  </tr>
                </table>
              </div>
              <div class="col-md-6">
                <h6 class="fw-bold">Condition Summary</h6>
                <ul class="list-unstyled">
                  <li><strong>Exterior:</strong> 
                    <% if @log.condition_report.condition_data&.[]('exterior_damage')&.any? %>
                      <%= @log.condition_report.condition_data['exterior_damage'].join(', ') %>
                    <% else %>
                      No damage
                    <% end %>
                  </li>
                  <li><strong>Interior:</strong> 
                    <% if @log.condition_report.condition_data&.[]('interior_issues')&.any? %>
                      <%= @log.condition_report.condition_data['interior_issues'].join(', ') %>
                    <% else %>
                      Clean
                    <% end %>
                  </li>
                  <li><strong>Tires:</strong> 
                    <%= @log.condition_report.condition_data&.[]('tire_status')&.humanize || 'Good' %>
                  </li>
                  <li><strong>Warnings:</strong> 
                    <% if @log.condition_report.condition_data&.[]('warning_lights')&.any? %>
                      <%= @log.condition_report.condition_data['warning_lights'].join(', ') %>
                    <% else %>
                      None
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <% if @log.condition_report.condition_data&.[]('additional_notes').present? %>
              <div class="mt-3 p-3 bg-light rounded">
                <strong>Notes:</strong><br>
                <%= @log.condition_report.condition_data['additional_notes'] %>
              </div>
            <% end %>

            <div class="mt-3 text-end">
              <%= link_to "View Full Report", vmcott_vehicle_condition_report_path(@log.condition_report), 
                  class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i> No Condition Report</h5>
          </div>
          <div class="card-body">
            <p class="mb-0">This reception log is not linked to a condition report. Condition report ID: <%= @log.condition_report_id || 'Not set' %></p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
      <!-- Quick Access Card -->
      <div class="card shadow-sm mb-4 border-primary">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-key me-2"></i> Quick Access for Customer</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="text-muted small mb-1">Portal URL</label>
            <div class="input-group">
              <input type="text" id="portal-url" class="form-control form-control-sm" value="<%= customer_login_url %>" readonly>
              <button class="btn btn-outline-primary btn-sm" onclick="copyToClipboardFromInput('portal-url')">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </div>
          <div class="mb-3">
            <label class="text-muted small mb-1">License Plate</label>
            <div class="input-group">
              <input type="text" id="license-plate" class="form-control form-control-sm" value="<%= @log.vehicle&.license_plate || 'N/A' %>" readonly>
              <button class="btn btn-outline-secondary btn-sm" onclick="copyToClipboardFromInput('license-plate')">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </div>
          <div class="mb-3">
            <label class="text-muted small mb-1">Receipt Number</label>
            <div class="input-group">
              <input type="text" id="receipt-number" class="form-control form-control-sm" value="<%= @log.receipt_number || 'N/A' %>" readonly>
              <button class="btn btn-outline-secondary btn-sm" onclick="copyToClipboardFromInput('receipt-number')">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </div>
          <hr>
          <a href="<%= customer_login_url %>" target="_blank" class="btn btn-info w-100 mb-2">
            <i class="bi bi-box-arrow-up-right me-2"></i> Open Customer Portal
          </a>
          <button class="btn btn-outline-success w-100" onclick="copyAllCustomerInfo()">
            <i class="bi bi-files me-2"></i> Copy All Info
          </button>
        </div>
      </div>

      <!-- Driver Signature Card -->
      <% if @log.condition_report&.signature_data.present? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-pen me-2"></i> Driver Signature</h5>
          </div>
          <div class="card-body text-center">
            <img src="<%= @log.condition_report.signature_data %>" style="max-width: 100%; max-height: 150px; background: #f8f9fa; padding: 10px; border-radius: 5px;">
            <p class="mt-2 mb-0">
              <strong><%= @log.condition_report.driver_name %></strong><br>
              <small class="text-muted">
                Signed at 
                <% if @log.condition_report.signed_at.present? %>
                  <% if @log.condition_report.signed_at.is_a?(String) %>
                    <%= @log.condition_report.signed_at %>
                  <% else %>
                    <%= @log.condition_report.signed_at.strftime("%I:%M %p") %>
                  <% end %>
                <% else %>
                  Unknown time
                <% end %>
              </small>
            </p>
            <% if @log.condition_report.driver_id_number.present? %>
              <p class="mb-0"><small>ID: <%= @log.condition_report.driver_id_number %></small></p>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Photos Card -->
      <% if @log.condition_report&.condition_photos&.attached? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-camera me-2"></i> Photos</h5>
          </div>
          <div class="card-body">
            <div class="row g-2">
              <% @log.condition_report.condition_photos.each do |photo| %>
                <div class="col-6">
                  <%= link_to photo, target: "_blank" do %>
                    <%= image_tag photo, class: "img-fluid rounded", style: "width: 100%; height: 100px; object-fit: cover;" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Status Card -->
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Status</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-2">
              <strong>Check-in:</strong><br>
              <span class="badge bg-success">Completed</span>
            </li>
            <li class="mb-2">
              <strong>Inspection:</strong><br>
              <% if @log.inspected? %>
                <span class="badge bg-success">Completed</span>
              <% else %>
                <span class="badge bg-warning">Pending</span>
              <% end %>
            </li>
            <li class="mb-2">
              <strong>Condition Report:</strong><br>
              <% if @log.condition_report %>
                <span class="badge bg-success">Completed (ID: <%= @log.condition_report.id %>)</span>
              <% elsif @log.condition_report_id.present? %>
                <span class="badge bg-danger">Missing - Report #<%= @log.condition_report_id %> not found</span>
              <% else %>
                <span class="badge bg-danger">Not Linked</span>
              <% end %>
            </li>
            <li class="mb-2">
              <strong>Portal Access:</strong><br>
              <% if @log.portal_access_token.present? && @log.portal_access_expires_at.present? && @log.portal_access_expires_at > Time.current %>
                <span class="badge bg-success">Active until <%= @log.portal_access_expires_at.strftime("%b %d, %Y") %></span>
              <% elsif @log.portal_access_token.present? %>
                <span class="badge bg-warning">Expired</span>
              <% else %>
                <span class="badge bg-secondary">Not generated</span>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function copyToClipboard(text) {
  navigator.clipboard.writeText(text).then(function() {
    // Show temporary feedback
    const btn = event.target.closest('button');
    const originalHtml = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
    setTimeout(() => {
      btn.innerHTML = originalHtml;
    }, 2000);
  });
}

function copyToClipboardFromInput(inputId) {
  const input = document.getElementById(inputId);
  input.select();
  input.setSelectionRange(0, 99999);
  document.execCommand('copy');
  
  // Show feedback
  const btn = event.target.closest('button');
  const originalHtml = btn.innerHTML;
  btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
  setTimeout(() => {
    btn.innerHTML = originalHtml;
  }, 2000);
}

function copyAllCustomerInfo() {
  const portalUrl = document.getElementById('portal-url')?.value || '';
  const licensePlate = document.getElementById('license-plate')?.value || '';
  const receiptNumber = document.getElementById('receipt-number')?.value || '';
  
  const message = `Customer Portal Access:\n\nURL: ${portalUrl}\nLicense Plate: ${licensePlate}\nReceipt Number: ${receiptNumber}\n\nInstructions:\n1. Go to the portal URL\n2. Enter your license plate\n3. Enter your receipt number\n4. Track your vehicle repair status`;
  
  navigator.clipboard.writeText(message).then(function() {
    alert('✅ Customer portal information copied to clipboard!');
  });
}
</script>