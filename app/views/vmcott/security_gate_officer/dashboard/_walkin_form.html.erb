<%# app/views/vmcott/security_gate_officer/dashboard/_walkin_form.html.erb %>
<div class="card border-info">
  <div class="card-header bg-info text-white">
    <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i> Walk-in Customer Information</h6>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <%= label_tag :walkin_name, "Full Name", class: "form-label fw-bold" %>
        <span class="text-danger">*</span>
        <%= text_field_tag "walkin[name]", nil, class: "form-control", id: "walkin_name", placeholder: "John Doe", disabled: true %>
      </div>
      
      <div class="col-md-6">
        <%= label_tag :walkin_phone, "Phone Number", class: "form-label fw-bold" %>
        <span class="text-danger">*</span>
        <%= text_field_tag "walkin[phone]", nil, class: "form-control", id: "walkin_phone", placeholder: "868-555-1234", disabled: true %>
      </div>
      
      <div class="col-md-6">
        <%= label_tag :walkin_email, "Email Address", class: "form-label fw-bold" %>
        <%= email_field_tag "walkin[email]", nil, class: "form-control", id: "walkin_email", placeholder: "client@example.com", disabled: true %>
      </div>
      
      <div class="col-md-6">
        <%= label_tag :walkin_id, "ID Number", class: "form-label fw-bold" %>
        <%= text_field_tag "walkin[id_number]", nil, class: "form-control", id: "walkin_id", placeholder: "Passport/ID", disabled: true %>
      </div>
      
      <div class="col-12">
        <%= label_tag :walkin_address, "Address", class: "form-label fw-bold" %>
        <%= text_field_tag "walkin[address]", nil, class: "form-control", id: "walkin_address", placeholder: "123 Main St, Port of Spain", disabled: true %>
      </div>
    </div>
    
    <!-- Hidden payment terms (cash on pickup) -->
    <input type="hidden" name="walkin[payment_terms]" value="cash_on_pickup">
    
    <div class="alert alert-success mt-3 mb-0 d-flex align-items-center">
      <i class="bi bi-info-circle-fill me-2 fs-5"></i>
      <small>Payment: <strong>Cash on Pickup</strong></small>
    </div>
  </div>
</div>