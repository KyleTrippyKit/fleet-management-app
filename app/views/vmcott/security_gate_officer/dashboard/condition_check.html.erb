<%# app/views/vmcott/security_gate_officer/dashboard/condition_check.html.erb %>
<div class="container-fluid py-4" style="background: linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.95)), url('https://images.unsplash.com/photo-1580273916550-e323be2ae537?ixlib=rb-4.0.3&auto=format&fit=crop&w=1964&q=80');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  min-height: 100vh;">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-white bg-dark bg-opacity-50 p-3 rounded-3">
      <i class="bi bi-clipboard-check me-2"></i>
      Vehicle Condition Check
    </h1>
    <div>
      <%= link_to "← Back", vmcott_security_gate_officer_manual_entry_path, class: "btn btn-light me-2" %>
      <%= link_to "Dashboard", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-light" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card shadow-lg border-0" style="backdrop-filter: blur(5px); background-color: rgba(255, 255, 255, 0.98);">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Vehicle: <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %></h5>
        </div>
        <div class="card-body">
          
          <%= form_with url: vmcott_security_gate_officer_submit_condition_path(@vehicle.id), 
                        method: :post,
                        local: true, 
                        class: "needs-validation", 
                        id: "condition-form",
                        data: { 
                          turbo: false,
                          controller: "vehicle-catalog",
                          vehicle_catalog_url_value: "/vehicles/catalog_search"
                        } do |f| %>
            
            <!-- Hidden field for vehicle selection -->
            <input type="hidden" name="vehicle_id" id="selected-vehicle-id" value="<%= @vehicle.id %>">
            <input type="hidden" name="create_new_vehicle" id="create-new-vehicle" value="false">
            
            <!-- VEHICLE SELECTION - Like the vehicle form with catalog search -->
            <div class="card mb-4 border-primary">
              <div class="card-header bg-primary bg-opacity-10 border-bottom border-primary py-3">
                <div class="d-flex align-items-center">
                  <i class="bi bi-search text-primary fs-4 me-2"></i>
                  <h6 class="fw-bold mb-0 text-primary">Vehicle Selection</h6>
                </div>
              </div>
              <div class="card-body">
                
                <!-- Mode Toggle Cards - Like manual_entry -->
                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <div class="card h-100 border-2" id="existing-mode-card" style="cursor: pointer; transition: all 0.2s;">
                      <div class="card-body text-center p-4">
                        <i class="bi bi-search display-4 text-primary mb-3"></i>
                        <h5 class="fw-bold">Search Existing</h5>
                        <p class="small text-muted mb-0">Find vehicle by license plate</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="card h-100 border-2" id="new-mode-card" style="cursor: pointer; transition: all 0.2s;">
                      <div class="card-body text-center p-4">
                        <i class="bi bi-plus-circle display-4 text-success mb-3"></i>
                        <h5 class="fw-bold">Add New Vehicle</h5>
                        <p class="small text-muted mb-0">Register a new vehicle</p>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Current vehicle display (when vehicle is pre-selected) -->
                <% if @vehicle.present? %>
                  <div class="alert alert-info mb-3 d-flex align-items-center" id="current-vehicle-alert">
                    <i class="bi bi-info-circle-fill me-2 fs-4"></i>
                    <div>
                      <strong>Current Vehicle:</strong> 
                      <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %> 
                      (<%= @vehicle.owner_name %>)
                      <button type="button" class="btn btn-sm btn-outline-primary ms-3" id="change-vehicle-btn">
                        <i class="bi bi-pencil me-1"></i> Change
                      </button>
                    </div>
                  </div>
                <% end %>
                
                <!-- License Plate Entry with Live Search (for selecting existing vehicles) -->
                <div id="existing-vehicle-section" class="mb-3 position-relative" style="<%= 'display: none;' if @vehicle.present? %>">
                  <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-upc-scan text-primary me-2"></i>
                    <label for="license-plate-search" class="form-label fw-bold mb-0">Search Vehicle</label>
                    <span class="badge bg-primary bg-opacity-10 text-primary ms-2">Required</span>
                  </div>
                  
                  <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-upc-scan text-muted"></i></span>
                    <input type="text" 
                           id="license-plate-search"
                           class="form-control border-start-0 ps-0" 
                           placeholder="Enter license plate (e.g., ABC-1234)" 
                           autofocus
                           autocomplete="off"
                           data-vehicle-catalog-target="query"
                           data-action="input->vehicle-catalog#search keydown->vehicle-catalog#keydown">
                  </div>
                  <div class="form-text text-muted mt-2">
                    <i class="bi bi-info-circle me-1"></i> Type at least 3 characters to search
                  </div>
                  
                  <!-- Search Results Dropdown - Like vehicle form -->
                  <div data-vehicle-catalog-target="results"
                       class="list-group position-absolute w-100 shadow"
                       style="display:none; z-index:2000; max-height:260px; overflow:auto;">
                  </div>
                </div>
                
                <!-- New Vehicle Form (hidden by default) -->
                <div id="newVehicleForm" class="mb-3" style="display: none;">
                  <div class="card border-2 border-success">
                    <div class="card-header bg-success bg-opacity-10 border-bottom border-success py-2">
                      <div class="d-flex align-items-center">
                        <i class="bi bi-plus-circle text-success fs-5 me-2"></i>
                        <h6 class="fw-bold mb-0 text-success">New Vehicle Registration</h6>
                      </div>
                    </div>
                    <div class="card-body bg-light">
                      <div class="row g-2">
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_make, "Make", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= text_field_tag "new_vehicle[make]", nil, class: "form-control form-control-sm", id: "new_vehicle_make", placeholder: "e.g., Toyota" %>
                        </div>
                        
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_model, "Model", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= text_field_tag "new_vehicle[model]", nil, class: "form-control form-control-sm", id: "new_vehicle_model", placeholder: "e.g., Hilux" %>
                        </div>
                        
                        <div class="col-md-4">
                          <%= label_tag :new_vehicle_year_of_manufacture, "Year", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= number_field_tag "new_vehicle[year_of_manufacture]", nil, class: "form-control form-control-sm", id: "new_vehicle_year_of_manufacture", placeholder: "2023", min: 1900, max: Time.current.year + 1 %>
                        </div>
                        
                        <div class="col-md-4">
                          <%= label_tag :new_vehicle_color, "Color", class: "form-label fw-bold small" %>
                          <%= text_field_tag "new_vehicle[color]", nil, class: "form-control form-control-sm", id: "new_vehicle_color", placeholder: "e.g., White" %>
                        </div>
                        
                        <div class="col-md-4">
                          <%= label_tag :new_vehicle_vehicle_type, "Type", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= select_tag "new_vehicle[vehicle_type]", 
                              options_for_select(["Car", "SUV", "Pickup", "Van", "Bus", "Truck", "Motorcycle", "Other"]), 
                              prompt: "Select...", 
                              class: "form-select form-select-sm", 
                              id: "new_vehicle_vehicle_type" %>
                        </div>
                        
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_chassis_number, "Chassis / VIN", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= text_field_tag "new_vehicle[chassis_number]", nil, class: "form-control form-control-sm", id: "new_vehicle_chassis_number", placeholder: "VIN number" %>
                        </div>
                        
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_serial_number, "Serial Number", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= text_field_tag "new_vehicle[serial_number]", nil, class: "form-control form-control-sm", id: "new_vehicle_serial_number", placeholder: "Serial number" %>
                        </div>
                        
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_engine_number, "Engine Number", class: "form-label fw-bold small" %>
                          <%= text_field_tag "new_vehicle[engine_number]", nil, class: "form-control form-control-sm", id: "new_vehicle_engine_number", placeholder: "Engine number" %>
                        </div>
                        
                        <div class="col-md-6">
                          <%= label_tag :new_vehicle_license_plate, "License Plate", class: "form-label fw-bold small" %>
                          <span class="text-danger">*</span>
                          <%= text_field_tag "new_vehicle[license_plate]", nil, class: "form-control form-control-sm", id: "new_vehicle_license_plate", placeholder: "e.g., ABC-1234" %>
                        </div>
                        
                        <!-- Owner fields - hidden for condition check, will be set by controller -->
                        <%= hidden_field_tag "client_type", session[:client_type] || 'agency' %>
                        <%= hidden_field_tag "agency_id", session[:agency_id] if session[:agency_id] %>
                        <% if session[:client_params].present? %>
                          <% session[:client_params].each do |key, value| %>
                            <%= hidden_field_tag "client[#{key}]", value %>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Stats Row -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold">Fuel Level (%)</label>
                <div class="input-group">
                  <input type="number" name="fuel_level" class="form-control" min="0" max="100" value="50" required>
                  <span class="input-group-text">%</span>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Odometer (km)</label>
                <input type="number" name="odometer" class="form-control" value="<%= @vehicle.mileage || 0 %>" required>
              </div>
            </div>

            <!-- EXTERIOR DAMAGE - Horizontal Tiles -->
            <div class="card mb-4">
              <div class="card-header bg-warning bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Exterior Damage</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="scratches" class="btn-check" id="ext_scratches" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_scratches">Scratches</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="dents" class="btn-check" id="ext_dents" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_dents">Dents</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="paint" class="btn-check" id="ext_paint" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_paint">Paint damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="glass" class="btn-check" id="ext_glass" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_glass">Glass/Windshield</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="mirror" class="btn-check" id="ext_mirror" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_mirror">Mirror</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="lights" class="btn-check" id="ext_lights" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_lights">Lights</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="none" class="btn-check" id="ext_none" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="ext_none">✅ None</label>
                  </div>
                </div>
                <input type="text" name="exterior_notes" class="form-control" placeholder="Location of damage (if any)">
              </div>
            </div>

            <!-- INTERIOR CONDITION -->
            <div class="card mb-4">
              <div class="card-header bg-info bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap-fill me-2"></i> Interior Condition</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="clean" class="btn-check" id="int_clean" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="int_clean">✅ Clean</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="dirty" class="btn-check" id="int_dirty" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="int_dirty">Dirty</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="seat_damage" class="btn-check" id="int_seat" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_seat">Seat damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="carpet_damage" class="btn-check" id="int_carpet" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_carpet">Carpet damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="odor" class="btn-check" id="int_odor" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_odor">Unusual odor</label>
                  </div>
                </div>
              </div>
            </div>

            <!-- TIRES & WHEELS -->
            <div class="card mb-4">
              <div class="card-header bg-success bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-circle me-2"></i> Tires & Wheels</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-3 mb-3">
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="good" class="form-check-input" id="tire_good" checked>
                    <label class="form-check-label" for="tire_good">✅ Good</label>
                  </div>
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="low_pressure" class="form-check-input" id="tire_low">
                    <label class="form-check-label" for="tire_low">⚠️ Low pressure</label>
                  </div>
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="damage" class="form-check-input" id="tire_damage">
                    <label class="form-check-label" for="tire_damage">🔴 Visible damage</label>
                  </div>
                </div>
                <input type="text" name="tire_notes" class="form-control" placeholder="Tire notes (if any)">
              </div>
            </div>

            <!-- WARNING LIGHTS -->
            <div class="card mb-4">
              <div class="card-header bg-danger bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-exclamation-diamond me-2"></i> Warning Lights</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="none" class="btn-check" id="warn_none" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="warn_none">✅ None</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="check_engine" class="btn-check" id="warn_engine" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="warn_engine">Check engine</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="other" class="btn-check" id="warn_other" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="warn_other">Other lights</label>
                  </div>
                </div>
              </div>
            </div>

            <!-- PHOTOS SECTION -->
            <div class="card mb-4">
              <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="bi bi-camera me-2"></i> Photos (Quick Capture)</h6>
              </div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Front View</label>
                    <input type="file" name="photo_front" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Rear View</label>
                    <input type="file" name="photo_rear" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Left Side</label>
                    <input type="file" name="photo_left" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Right Side</label>
                    <input type="file" name="photo_right" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Dashboard</label>
                    <input type="file" name="photo_dashboard" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Odometer</label>
                    <input type="file" name="photo_odometer" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Fuel Gauge</label>
                    <input type="file" name="photo_fuel" accept="image/*" class="form-control" capture="environment">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Damage (if any)</label>
                    <input type="file" name="photo_damage" accept="image/*" class="form-control" capture="environment">
                  </div>
                </div>
              </div>
            </div>

            <!-- ADDITIONAL NOTES -->
            <div class="mb-4">
              <label class="form-label fw-bold">Additional Notes</label>
              <textarea name="notes" class="form-control" rows="2" placeholder="Any other observations?"></textarea>
            </div>

            <!-- DRIVER SIGNATURE SECTION -->
            <div class="card mb-4 border-warning" id="signature-section">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pen me-2"></i> Driver Acknowledgment & Signature</h6>
              </div>
              <div class="card-body">
                <div class="alert alert-warning">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  The driver must review the condition above and sign below.
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-8">
                    <label class="form-label fw-bold">Driver Full Name</label>
                    <input type="text" name="driver_name" class="form-control" required value="<%= session[:driver_name] %>">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-bold">ID Number (Optional)</label>
                    <input type="text" name="driver_id_number" class="form-control">
                  </div>
                </div>

                <!-- Signature Pad -->
                <div class="mb-3" id="signature-wrapper">
                  <label class="form-label fw-bold">Driver Signature</label>
                  <div class="border rounded bg-light" style="height: 150px; width: 100%; cursor: pointer;" id="signature-pad" onclick="openSignatureModal()">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                      <i class="bi bi-pencil fs-1 mb-2"></i>
                      <span>Click to sign</span>
                    </div>
                  </div>
                  <input type="hidden" name="signature_data" id="signature-data">
                </div>

                <!-- Signature Modal -->
                <div class="modal fade" id="signatureModal" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-bottom modal-lg">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Driver Signature</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <div style="background: white; border: 2px solid #dee2e6; border-radius: 8px; padding: 10px;">
                          <canvas id="signature-canvas" 
                                  width="600" 
                                  height="200" 
                                  style="width: 100%; height: 200px; display: block; background: white; cursor: crosshair; border: 1px dashed #aaa;"></canvas>
                        </div>
                        
                        <div class="alert alert-info mt-3 mb-2 py-2">
                          <div class="d-flex align-items-center">
                            <i class="bi bi-mouse fs-5 me-2"></i>
                            <div>
                              <strong>How to sign:</strong> Click and hold to draw.
                            </div>
                          </div>
                        </div>
                        
                        <div class="d-flex gap-2 mt-3">
                          <button type="button" class="btn btn-outline-secondary flex-grow-1" id="clear-signature">
                            <i class="bi bi-eraser me-1"></i> Clear
                          </button>
                          <button type="button" class="btn btn-success flex-grow-1" id="save-signature">
                            <i class="bi bi-check-lg me-1"></i> Save Signature
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Terms and conditions -->
                <div class="form-check mt-3">
                  <input type="checkbox" name="terms_agreed" class="form-check-input" id="terms" required>
                  <label class="form-check-label" for="terms">
                    I confirm that the vehicle condition above accurately reflects the state of the vehicle upon arrival.
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-success btn-lg" id="submit-btn">
                <i class="bi bi-check-circle me-2"></i>
                Complete Check-in & Save
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for vehicle search and mode switching -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // ============================================
    // MODE TOGGLE FUNCTIONALITY
    // ============================================
    const existingModeCard = document.getElementById('existing-mode-card');
    const newModeCard = document.getElementById('new-mode-card');
    const existingSection = document.getElementById('existing-vehicle-section');
    const newSection = document.getElementById('newVehicleForm');
    const currentVehicleAlert = document.getElementById('current-vehicle-alert');
    const createNewVehicle = document.getElementById('create-new-vehicle');
    const selectedVehicleId = document.getElementById('selected-vehicle-id');
    
    let isNewVehicleMode = false;
    
    function setMode(isNew) {
      isNewVehicleMode = isNew;
      createNewVehicle.value = isNew ? 'true' : 'false';
      
      if (isNew) {
        // New vehicle mode
        if (existingSection) existingSection.style.display = 'none';
        if (newSection) newSection.style.display = 'block';
        if (existingModeCard) {
          existingModeCard.classList.remove('border-primary', 'bg-light');
          newModeCard.classList.add('border-primary', 'bg-light');
        }
        if (currentVehicleAlert) currentVehicleAlert.style.display = 'none';
        
        // Clear any selected vehicle
        if (selectedVehicleId) selectedVehicleId.value = '';
        
      } else {
        // Existing vehicle mode
        if (existingSection) existingSection.style.display = 'block';
        if (newSection) newSection.style.display = 'none';
        if (existingModeCard) {
          newModeCard.classList.remove('border-primary', 'bg-light');
          existingModeCard.classList.add('border-primary', 'bg-light');
        }
        if (currentVehicleAlert) currentVehicleAlert.style.display = 'flex';
      }
    }
    
    if (existingModeCard) {
      existingModeCard.addEventListener('click', () => setMode(false));
    }
    if (newModeCard) {
      newModeCard.addEventListener('click', () => setMode(true));
    }
    
    // Change vehicle button
    const changeVehicleBtn = document.getElementById('change-vehicle-btn');
    if (changeVehicleBtn) {
      changeVehicleBtn.addEventListener('click', function() {
        if (currentVehicleAlert) currentVehicleAlert.style.display = 'none';
        if (existingSection) existingSection.style.display = 'block';
        if (selectedVehicleId) selectedVehicleId.value = '';
      });
    }
    
    // ============================================
    // VEHICLE CATALOG SEARCH
    // ============================================
    const searchInput = document.getElementById('license-plate-search');
    const resultsDiv = document.querySelector('[data-vehicle-catalog-target="results"]');
    
    if (searchInput && resultsDiv) {
      let searchTimeout;
      
      searchInput.addEventListener('input', function(e) {
        const query = this.value.trim();
        clearTimeout(searchTimeout);
        
        if (query.length < 2) {
          resultsDiv.style.display = 'none';
          return;
        }
        
        resultsDiv.innerHTML = '<div class="list-group-item text-center py-2"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Searching...</div>';
        resultsDiv.style.display = 'block';
        
        searchTimeout = setTimeout(() => {
          fetch(`/vehicles/search?q=${encodeURIComponent(query)}`, {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            if (data && data.length > 0) {
              resultsDiv.innerHTML = '';
              data.forEach(vehicle => {
                const ownerDisplay = vehicle.agency_code ? 
                  `(${vehicle.agency_code})` : 
                  (vehicle.owner_type === 'Client' ? '(Public)' : '');
                
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'list-group-item list-group-item-action py-2';
                item.setAttribute('data-vehicle-id', vehicle.id);
                item.setAttribute('data-vehicle-make', vehicle.make || '');
                item.setAttribute('data-vehicle-model', vehicle.model || '');
                item.setAttribute('data-vehicle-plate', vehicle.license_plate || '');
                item.innerHTML = `
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong>${escapeHtml(vehicle.license_plate || 'N/A')}</strong>
                      <br><small>${escapeHtml(vehicle.make || '')} ${escapeHtml(vehicle.model || '')} ${ownerDisplay}</small>
                    </div>
                    <span class="badge bg-primary">Select</span>
                  </div>
                `;
                item.addEventListener('click', function() {
                  selectVehicle(vehicle);
                });
                resultsDiv.appendChild(item);
              });
            } else {
              resultsDiv.innerHTML = '<div class="list-group-item text-center py-3 text-muted">No vehicles found. <a href="#" onclick="switchToNewMode(); return false;">Add new vehicle?</a></div>';
            }
          })
          .catch(error => {
            console.error('Search error:', error);
            resultsDiv.innerHTML = '<div class="list-group-item text-center py-3 text-danger">Error searching vehicles</div>';
          });
        }, 300);
      });
      
      // Close results when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
          resultsDiv.style.display = 'none';
        }
      });
    }
    
    // Function to select a vehicle
    window.selectVehicle = function(vehicle) {
      if (selectedVehicleId) selectedVehicleId.value = vehicle.id;
      if (searchInput) {
        searchInput.value = `${vehicle.license_plate || ''} - ${vehicle.make || ''} ${vehicle.model || ''}`.trim();
      }
      if (resultsDiv) resultsDiv.style.display = 'none';
      
      // Show success message
      showTemporaryMessage(`Selected: ${vehicle.license_plate}`);
    };
    
    // Function to switch to new vehicle mode
    window.switchToNewMode = function() {
      setMode(true);
      if (resultsDiv) resultsDiv.style.display = 'none';
    };
    
    // Helper: escape HTML
    function escapeHtml(unsafe) {
      if (!unsafe) return '';
      return String(unsafe)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
    
    // Helper: show temporary message
    function showTemporaryMessage(message) {
      const alertDiv = document.createElement('div');
      alertDiv.className = 'alert alert-success alert-dismissible fade show mt-2';
      alertDiv.innerHTML = `
        <div class="d-flex align-items-center">
          <i class="bi bi-check-circle-fill me-2"></i>
          <span>${escapeHtml(message)}</span>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
      `;
      if (searchInput && searchInput.parentElement) {
        searchInput.parentElement.appendChild(alertDiv);
        setTimeout(() => alertDiv.remove(), 3000);
      }
    }
    
    // ============================================
    // CHECKBOX BEHAVIOR
    // ============================================
    
    // Auto-uncheck "None" when other checkboxes are checked
    document.querySelectorAll('input[name="exterior[]"]').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const noneCheckbox = document.getElementById('ext_none');
        if (this.value !== 'none' && this.checked) {
          noneCheckbox.checked = false;
        }
        if (this.value === 'none' && this.checked) {
          document.querySelectorAll('input[name="exterior[]"]:not(#ext_none)').forEach(cb => cb.checked = false);
        }
      });
    });
    
    document.querySelectorAll('input[name="interior[]"]').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const cleanCheckbox = document.getElementById('int_clean');
        if (this.value !== 'clean' && this.checked) {
          cleanCheckbox.checked = false;
        }
        if (this.value === 'clean' && this.checked) {
          document.querySelectorAll('input[name="interior[]"]:not(#int_clean)').forEach(cb => cb.checked = false);
        }
      });
    });
    
    document.querySelectorAll('input[name="warnings[]"]').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const noneCheckbox = document.getElementById('warn_none');
        if (this.value !== 'none' && this.checked) {
          noneCheckbox.checked = false;
        }
        if (this.value === 'none' && this.checked) {
          document.querySelectorAll('input[name="warnings[]"]:not(#warn_none)').forEach(cb => cb.checked = false);
        }
      });
    });

    // ============================================
    // SIGNATURE PAD FUNCTIONS
    // ============================================
    
    let canvas, ctx, drawing = false;
    
    window.openSignatureModal = function() {
      const modalEl = document.getElementById('signatureModal');
      const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
      modal.show();
      
      setTimeout(initCanvas, 300);
    };
    
    function initCanvas() {
      canvas = document.getElementById('signature-canvas');
      if (!canvas) return;
      
      canvas.width = 600;
      canvas.height = 200;
      ctx = canvas.getContext('2d');
      
      ctx.strokeStyle = '#000';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      
      ctx.fillStyle = 'white';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      canvas.addEventListener('mousedown', startDrawing);
      canvas.addEventListener('mousemove', draw);
      canvas.addEventListener('mouseup', stopDrawing);
      canvas.addEventListener('mouseleave', stopDrawing);
      
      canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
      canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
      canvas.addEventListener('touchend', stopDrawing);
    }
    
    function startDrawing(e) {
      e.preventDefault();
      drawing = true;
      const rect = canvas.getBoundingClientRect();
      const x = (e.clientX - rect.left) * (canvas.width / rect.width);
      const y = (e.clientY - rect.top) * (canvas.height / rect.height);
      ctx.beginPath();
      ctx.moveTo(x, y);
    }
    
    function draw(e) {
      if (!drawing) return;
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const x = (e.clientX - rect.left) * (canvas.width / rect.width);
      const y = (e.clientY - rect.top) * (canvas.height / rect.height);
      ctx.lineTo(x, y);
      ctx.stroke();
    }
    
    function handleTouchStart(e) {
      e.preventDefault();
      const touch = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      const x = (touch.clientX - rect.left) * (canvas.width / rect.width);
      const y = (touch.clientY - rect.top) * (canvas.height / rect.height);
      drawing = true;
      ctx.beginPath();
      ctx.moveTo(x, y);
    }
    
    function handleTouchMove(e) {
      e.preventDefault();
      if (!drawing) return;
      const touch = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      const x = (touch.clientX - rect.left) * (canvas.width / rect.width);
      const y = (touch.clientY - rect.top) * (canvas.height / rect.height);
      ctx.lineTo(x, y);
      ctx.stroke();
    }
    
    function stopDrawing(e) {
      if (e) e.preventDefault();
      drawing = false;
      ctx.closePath();
    }
    
    document.getElementById('clear-signature')?.addEventListener('click', function(e) {
      e.preventDefault();
      if (ctx && canvas) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
    });
    
    document.getElementById('save-signature')?.addEventListener('click', function(e) {
      e.preventDefault();
      if (!canvas || !ctx) return;
      
      const signatureData = canvas.toDataURL('image/png');
      document.getElementById('signature-data').value = signatureData;
      
      const pad = document.getElementById('signature-pad');
      pad.innerHTML = `<img src="${signatureData}" style="width: 100%; height: 100%; object-fit: contain; background: white;">`;
      pad.onclick = null;
      
      const modal = bootstrap.Modal.getInstance(document.getElementById('signatureModal'));
      if (modal) modal.hide();
    });

    // Form validation
    document.getElementById('condition-form')?.addEventListener('submit', function(e) {
      const signature = document.getElementById('signature-data').value;
      const driverName = document.querySelector('input[name="driver_name"]')?.value.trim();
      const termsAgreed = document.getElementById('terms')?.checked;
      
      if (!signature) {
        e.preventDefault();
        alert('Please capture driver signature');
        return false;
      }
      
      if (!driverName) {
        e.preventDefault();
        alert('Please enter driver name');
        return false;
      }
      
      if (!termsAgreed) {
        e.preventDefault();
        alert('Please agree to the terms');
        return false;
      }
      
      return true;
    });
    
  });
</script>

