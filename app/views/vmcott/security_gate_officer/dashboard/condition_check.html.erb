  }
  
  .modal-dialog-bottom {
    margin: 0;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    max-width: 100%;
  }
  
  .modal-dialog-bottom .modal-content {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  
  /* Search results styling */
  [data-vehicle-catalog-target="results"] {
    border-radius: 8px;
    border: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    z-index: 2000;
  }
  
  [data-vehicle-catalog-target="results"] .list-group-item {
    border-left: none;
    border-right: none;
    padding: 8px 12px;
  }
  
  [data-vehicle-catalog-target="results"] .list-group-item:first-child {
    border-top: none;
