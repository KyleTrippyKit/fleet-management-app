<%# app/views/vmcott/security_gate_officer/dashboard/condition_check.html.erb %>
<div class="container-fluid py-4" style="background: linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.95)), url('https://images.unsplash.com/photo-1580273916550-e323be2ae537?ixlib=rb-4.0.3&auto=format&fit=crop&w=1964&q=80');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  min-height: 100vh;">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-white bg-dark bg-opacity-50 p-3 rounded-3">
      <i class="bi bi-clipboard-check me-2"></i>
      Vehicle Condition Check
    </h1>
    <div>
      <%= link_to "← Back", vmcott_security_gate_officer_manual_entry_path, class: "btn btn-light me-2" %>
      <%= link_to "Dashboard", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-light" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card shadow-lg border-0" style="backdrop-filter: blur(5px); background-color: rgba(255, 255, 255, 0.98);">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Vehicle: <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %></h5>
        </div>
        <div class="card-body">
          
          <%= form_with url: vmcott_security_gate_officer_submit_condition_path(@vehicle.id), 
                        method: :post,
                        local: true, 
                        class: "needs-validation", 
                        id: "condition-form",
                        data: { turbo: false },
                        multipart: true do |f| %>
            
            <!-- Hidden field for vehicle ID -->
            <input type="hidden" name="vehicle_id" value="<%= @vehicle.id %>">
            
            <!-- ============================================ -->
            <!-- HIDDEN CLIENT FIELDS - Pass data from session -->
            <!-- ============================================ -->
            <input type="hidden" name="client_type" value="<%= @client_type %>">
            
            <% if @agency_id.present? %>
              <input type="hidden" name="agency_id" value="<%= @agency_id %>">
            <% end %>
            
            <% if @client_params.present? %>
              <% @client_params.each do |key, value| %>
                <input type="hidden" name="client[<%= key %>]" value="<%= value %>">
              <% end %>
            <% end %>
            
            <!-- Also pass the create_new_vehicle flag if it was a new vehicle -->
            <% if session[:new_vehicle_params].present? %>
              <input type="hidden" name="create_new_vehicle" value="true">
            <% end %>
            
            <!-- Vehicle Summary Card -->
            <div class="card mb-4 border-primary bg-light">
              <div class="card-body py-3">
                <div class="row align-items-center">
                  <div class="col-md-8">
                    <div class="d-flex align-items-center">
                      <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
                      <div>
                        <h6 class="mb-1 fw-bold">Selected Vehicle</h6>
                        <p class="mb-0">
                          <strong><%= @vehicle.license_plate %></strong> • 
                          <%= @vehicle.make %> <%= @vehicle.model %> • 
                          <%= @vehicle.year_of_manufacture %> • 
                          <span class="badge bg-info"><%= @vehicle.owner_name %></span>
                        </p>
                        <% if @client_type == 'public' && @client_params.present? %>
                          <small class="text-muted d-block mt-1">
                            Client: <%= @client_params[:name] %> • <%= @client_params[:phone] %>
                          </small>
                        <% elsif @agency_id.present? %>
                          <small class="text-muted d-block mt-1">
                            Agency: <%= Agency.find_by(id: @agency_id)&.name %>
                          </small>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4 text-md-end">
                    <%= link_to "Change Vehicle", vmcott_security_gate_officer_manual_entry_path, class: "btn btn-sm btn-outline-primary" %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Stats Row - Fuel Level and Odometer -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold">Fuel Level (%)</label>
                <div class="input-group">
                  <input type="number" name="fuel_level" class="form-control" min="0" max="100" value="50" required>
                  <span class="input-group-text">%</span>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Odometer (km)</label>
                <input type="number" name="odometer" id="odometer-input" class="form-control" value="<%= @vehicle.mileage || 0 %>" min="0" step="1" required>
                <div class="invalid-feedback">Please enter a valid odometer reading (cannot be negative)</div>
              </div>
            </div>

            <!-- EXTERIOR DAMAGE -->
            <div class="card mb-4">
              <div class="card-header bg-warning bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Exterior Damage</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="scratches" class="btn-check" id="ext_scratches" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_scratches">Scratches</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="dents" class="btn-check" id="ext_dents" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_dents">Dents</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="paint" class="btn-check" id="ext_paint" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_paint">Paint damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="glass" class="btn-check" id="ext_glass" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_glass">Glass/Windshield</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="mirror" class="btn-check" id="ext_mirror" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_mirror">Mirror</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="lights" class="btn-check" id="ext_lights" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="ext_lights">Lights</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="exterior[]" value="none" class="btn-check" id="ext_none" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="ext_none">✅ None</label>
                  </div>
                </div>
                <input type="text" name="exterior_notes" class="form-control" placeholder="Location of damage (if any)">
              </div>
            </div>

            <!-- INTERIOR CONDITION -->
            <div class="card mb-4">
              <div class="card-header bg-info bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap-fill me-2"></i> Interior Condition</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="clean" class="btn-check" id="int_clean" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="int_clean">✅ Clean</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="dirty" class="btn-check" id="int_dirty" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="int_dirty">Dirty</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="seat_damage" class="btn-check" id="int_seat" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_seat">Seat damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="carpet_damage" class="btn-check" id="int_carpet" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_carpet">Carpet damage</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="interior[]" value="odor" class="btn-check" id="int_odor" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="int_odor">Unusual odor</label>
                  </div>
                </div>
              </div>
            </div>

            <!-- TIRES & WHEELS -->
            <div class="card mb-4">
              <div class="card-header bg-success bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-circle me-2"></i> Tires & Wheels</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-3 mb-3">
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="good" class="form-check-input" id="tire_good" checked>
                    <label class="form-check-label" for="tire_good">✅ Good</label>
                  </div>
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="low_pressure" class="form-check-input" id="tire_low">
                    <label class="form-check-label" for="tire_low">⚠️ Low pressure</label>
                  </div>
                  <div class="form-check">
                    <input type="radio" name="tire_status" value="damage" class="form-check-input" id="tire_damage">
                    <label class="form-check-label" for="tire_damage">🔴 Visible damage</label>
                  </div>
                </div>
                <input type="text" name="tire_notes" class="form-control" placeholder="Tire notes (if any)">
              </div>
            </div>

            <!-- WARNING LIGHTS -->
            <div class="card mb-4">
              <div class="card-header bg-danger bg-opacity-25">
                <h6 class="mb-0 fw-bold"><i class="bi bi-exclamation-diamond me-2"></i> Warning Lights</h6>
              </div>
              <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="none" class="btn-check" id="warn_none" autocomplete="off" checked>
                    <label class="btn btn-outline-success btn-sm" for="warn_none">✅ None</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="check_engine" class="btn-check" id="warn_engine" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="warn_engine">Check engine</label>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="warnings[]" value="other" class="btn-check" id="warn_other" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm" for="warn_other">Other lights</label>
                  </div>
                </div>
              </div>
            </div>

            <!-- PHOTOS SECTION - Enhanced with Camera/Browse Options -->
            <div class="card mb-4">
              <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="bi bi-camera me-2"></i> Photos</h6>
              </div>
              <div class="card-body">
                <p class="text-muted small">Tap the camera icon to take a photo, or click "Browse" to select from gallery</p>
                
                <div class="row g-3">
                  <!-- Front View -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Front View</label>
                      <div class="photo-preview mb-2" id="preview-front" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_front">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_front">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_front" accept="image/*" class="d-none file-input" id="photo_front_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Rear View -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Rear View</label>
                      <div class="photo-preview mb-2" id="preview-rear" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_rear">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_rear">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_rear" accept="image/*" class="d-none file-input" id="photo_rear_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Left Side -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Left Side</label>
                      <div class="photo-preview mb-2" id="preview-left" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_left">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_left">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_left" accept="image/*" class="d-none file-input" id="photo_left_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Right Side -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Right Side</label>
                      <div class="photo-preview mb-2" id="preview-right" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_right">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_right">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_right" accept="image/*" class="d-none file-input" id="photo_right_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Dashboard -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Dashboard</label>
                      <div class="photo-preview mb-2" id="preview-dashboard" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_dashboard">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_dashboard">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_dashboard" accept="image/*" class="d-none file-input" id="photo_dashboard_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Odometer -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Odometer</label>
                      <div class="photo-preview mb-2" id="preview-odometer" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_odometer">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_odometer">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_odometer" accept="image/*" class="d-none file-input" id="photo_odometer_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Fuel Gauge -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Fuel Gauge</label>
                      <div class="photo-preview mb-2" id="preview-fuel" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_fuel">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_fuel">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_fuel" accept="image/*" class="d-none file-input" id="photo_fuel_input" capture="environment">
                    </div>
                  </div>
                  
                  <!-- Damage Photos -->
                  <div class="col-md-6">
                    <div class="photo-upload-card border rounded-3 p-2 text-center">
                      <label class="form-label fw-bold d-block">Damage Photos</label>
                      <div class="photo-preview mb-2" id="preview-damage" style="min-height: 120px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera fs-1 text-muted"></i>
                      </div>
                      <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-primary btn-sm camera-btn" data-target="photo_damage">
                          <i class="bi bi-camera-fill"></i> Camera
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm browse-btn" data-target="photo_damage">
                          <i class="bi bi-folder2-open"></i> Browse
                        </button>
                      </div>
                      <input type="file" name="photo_damage" accept="image/*" class="d-none file-input" id="photo_damage_input" capture="environment">
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ADDITIONAL NOTES -->
            <div class="mb-4">
              <label class="form-label fw-bold">Additional Notes</label>
              <textarea name="notes" class="form-control" rows="2" placeholder="Any other observations?"></textarea>
            </div>

            <!-- DRIVER SIGNATURE SECTION -->
            <div class="card mb-4 border-warning" id="signature-section">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pen me-2"></i> Driver Acknowledgment & Signature</h6>
              </div>
              <div class="card-body">
                <div class="alert alert-warning">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  The driver must review the condition above and sign below.
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-8">
                    <label class="form-label fw-bold">Driver Full Name</label>
                    <input type="text" name="driver_name" class="form-control" required value="<%= session[:driver_name] %>">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-bold">ID Number (Optional)</label>
                    <input type="text" name="driver_id_number" class="form-control">
                  </div>
                </div>

                <!-- Signature Pad -->
                <div class="mb-3">
                  <label class="form-label fw-bold">Driver Signature</label>
                  <div class="border rounded p-2 bg-white" style="border: 2px solid #dee2e6 !important;">
                    <canvas id="signature-canvas" 
                            width="600" 
                            height="200" 
                            style="width: 100%; height: 200px; display: block; background: white; cursor: crosshair; border: 1px dashed #aaa; touch-action: none;"></canvas>
                  </div>
                  
                  <div class="d-flex justify-content-between mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="clear-signature">
                      <i class="bi bi-eraser me-1"></i> Clear Signature
                    </button>
                    <small class="text-muted">Draw your signature above</small>
                  </div>
                  
                  <input type="hidden" name="signature_data" id="signature-data">
                </div>

                <!-- Terms and conditions -->
                <div class="form-check mt-3">
                  <input type="checkbox" name="terms_agreed" class="form-check-input" id="terms" required>
                  <label class="form-check-label" for="terms">
                    I confirm that the vehicle condition above accurately reflects the state of the vehicle upon arrival.
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-success btn-lg" id="submit-btn">
                <i class="bi bi-check-circle me-2"></i>
                Complete Check-in & Save
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ============================================
  // PHOTO UPLOAD WITH CAMERA/BROWSE OPTIONS
  // ============================================
  
  // Setup all photo upload buttons
  const photoTypes = ['front', 'rear', 'left', 'right', 'dashboard', 'odometer', 'fuel', 'damage'];
  
  photoTypes.forEach(type => {
    const cameraBtn = document.querySelector(`.camera-btn[data-target="photo_${type}"]`);
    const browseBtn = document.querySelector(`.browse-btn[data-target="photo_${type}"]`);
    const fileInput = document.getElementById(`photo_${type}_input`);
    const previewDiv = document.getElementById(`preview-${type}`);
    
    if (cameraBtn && fileInput) {
      cameraBtn.addEventListener('click', function() {
        fileInput.click();
      });
    }
    
    if (browseBtn && fileInput) {
      browseBtn.addEventListener('click', function() {
        // Remove capture attribute to allow file selection
        fileInput.removeAttribute('capture');
        fileInput.click();
        // Re-add capture for next time if on mobile
        setTimeout(() => {
          if (isMobileDevice()) {
            fileInput.setAttribute('capture', 'environment');
          }
        }, 100);
      });
    }
    
    if (fileInput && previewDiv) {
      fileInput.addEventListener('change', function(e) {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          reader.onload = function(event) {
            previewDiv.innerHTML = `<img src="${event.target.result}" style="max-width: 100%; max-height: 100px; border-radius: 4px;">`;
            previewDiv.style.background = '#fff';
          };
          reader.readAsDataURL(this.files[0]);
        }
      });
    }
  });
  
  // Helper to detect mobile device
  function isMobileDevice() {
    return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  }
  
  // Set capture attribute on mobile devices
  if (isMobileDevice()) {
    document.querySelectorAll('.file-input').forEach(input => {
      input.setAttribute('capture', 'environment');
    });
  }
  
  // ============================================
  // ODOMETER VALIDATION
  // ============================================
  const odometerInput = document.getElementById('odometer-input');
  if (odometerInput) {
    odometerInput.addEventListener('input', function(e) {
      let value = parseInt(this.value);
      if (this.value < 0 || isNaN(value) || value < 0) {
        this.value = 0;
        this.classList.add('is-invalid');
      } else {
        this.classList.remove('is-invalid');
      }
    });
    
    odometerInput.addEventListener('blur', function(e) {
      let value = parseInt(this.value);
      if (this.value === '' || isNaN(value)) {
        this.value = 0;
      } else if (value < 0) {
        this.value = 0;
      }
      this.classList.remove('is-invalid');
    });
    
    odometerInput.addEventListener('keydown', function(e) {
      if (e.key === '-' || e.key === 'Minus') {
        e.preventDefault();
        return false;
      }
    });
  }
  
  // ============================================
  // CHECKBOX BEHAVIOR
  // ============================================
  
  document.querySelectorAll('input[name="exterior[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const noneCheckbox = document.getElementById('ext_none');
      if (this.value !== 'none' && this.checked) {
        noneCheckbox.checked = false;
      }
      if (this.value === 'none' && this.checked) {
        document.querySelectorAll('input[name="exterior[]"]:not(#ext_none)').forEach(cb => cb.checked = false);
      }
    });
  });
  
  document.querySelectorAll('input[name="interior[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const cleanCheckbox = document.getElementById('int_clean');
      if (this.value !== 'clean' && this.checked) {
        cleanCheckbox.checked = false;
      }
      if (this.value === 'clean' && this.checked) {
        document.querySelectorAll('input[name="interior[]"]:not(#int_clean)').forEach(cb => cb.checked = false);
      }
    });
  });
  
  document.querySelectorAll('input[name="warnings[]"]').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const noneCheckbox = document.getElementById('warn_none');
      if (this.value !== 'none' && this.checked) {
        noneCheckbox.checked = false;
      }
      if (this.value === 'none' && this.checked) {
        document.querySelectorAll('input[name="warnings[]"]:not(#warn_none)').forEach(cb => cb.checked = false);
      }
    });
  });

  // ============================================
  // SIGNATURE PAD
  // ============================================
  
  const canvas = document.getElementById('signature-canvas');
  if (canvas) {
    canvas.width = 600;
    canvas.height = 200;
    
    const ctx = canvas.getContext('2d');
    let drawing = false;
    
    ctx.strokeStyle = '#000';
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    
    ctx.fillStyle = 'white';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    function getCanvasCoordinates(e) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      
      let clientX, clientY;
      
      if (e.touches) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else {
        clientX = e.clientX;
        clientY = e.clientY;
      }
      
      return {
        x: Math.max(0, Math.min(canvas.width, (clientX - rect.left) * scaleX)),
        y: Math.max(0, Math.min(canvas.height, (clientY - rect.top) * scaleY))
      };
    }
    
    function startDrawing(e) {
      e.preventDefault();
      drawing = true;
      const coords = getCanvasCoordinates(e);
      ctx.beginPath();
      ctx.moveTo(coords.x, coords.y);
    }
    
    function draw(e) {
      if (!drawing) return;
      e.preventDefault();
      const coords = getCanvasCoordinates(e);
      ctx.lineTo(coords.x, coords.y);
      ctx.stroke();
    }
    
    function stopDrawing(e) {
      if (e) e.preventDefault();
      drawing = false;
      ctx.closePath();
    }
    
    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseleave', stopDrawing);
    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', stopDrawing);
    canvas.addEventListener('touchcancel', stopDrawing);
    
    document.getElementById('clear-signature').addEventListener('click', function(e) {
      e.preventDefault();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = 'white';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      document.getElementById('signature-data').value = '';
    });
  }
  
  // Form submission
  document.getElementById('condition-form').addEventListener('submit', function(e) {
    const canvas = document.getElementById('signature-canvas');
    if (canvas) {
      const imageData = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data;
      const isCanvasEmpty = !imageData.some(value => value !== 255);
      
      if (isCanvasEmpty) {
        e.preventDefault();
        alert('Please provide a signature');
        return false;
      }
      
      const signatureData = canvas.toDataURL('image/png');
      document.getElementById('signature-data').value = signatureData;
    }
    
    const driverName = document.querySelector('input[name="driver_name"]')?.value.trim();
    const termsAgreed = document.getElementById('terms')?.checked;
    
    if (!driverName) {
      e.preventDefault();
      alert('Please enter driver name');
      return false;
    }
    
    if (!termsAgreed) {
      e.preventDefault();
      alert('Please agree to the terms');
      return false;
    }
    
    return true;
  });
});
</script>

