<%# app/views/vmcott/security_gate_officer/dashboard/scan.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-qr-code-scan me-2"></i>
      Scan QR Code
    </h1>
    <%= link_to "← Back to Dashboard", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body text-center p-5">
          <div class="mb-4">
            <i class="bi bi-qr-code-scan" style="font-size: 5rem; color: #0d6efd;"></i>
          </div>
          
          <h4 class="mb-3">Scan Vehicle QR Code</h4>
          
          <p class="text-muted mb-4">
            Position the QR code in front of your camera to scan.
            The QR code should be on the vehicle's windshield or documentation.
          </p>
          
          <!-- Simulated QR scanner (in a real app, you'd use a JavaScript library) -->
          <div class="bg-light p-5 mb-4 rounded-3" style="border: 2px dashed #ccc; min-height: 200px;">
            <div class="text-center">
              <i class="bi bi-camera" style="font-size: 3rem; color: #999;"></i>
              <p class="text-muted mt-2">Camera preview would appear here</p>
            </div>
          </div>
          
          <div class="d-grid gap-2">
            <%= link_to "Manual Entry Instead", vmcott_security_gate_officer_manual_entry_path, class: "btn btn-outline-primary" %>
          </div>
          
          <hr class="my-4">
          
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Quick Test:</strong> 
            <%= link_to "Skip scanning and go to manual entry", vmcott_security_gate_officer_manual_entry_path %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>