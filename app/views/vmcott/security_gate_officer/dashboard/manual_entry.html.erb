<%# app/views/vmcott/security_gate_officer/dashboard/manual_entry.html.erb %>
<div class="container-fluid min-vh-100 py-4" style="background: linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.95)), url('https://images.unsplash.com/photo-1580273916550-e323be2ae537?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1964&q=80');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;">
  
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Dashboard", vmcott_security_gate_officer_dashboard_path, class: "text-white text-decoration-none opacity-75" %></li>
          <li class="breadcrumb-item active text-white" aria-current="page">Manual Entry</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0 text-white">
        <i class="bi bi-pencil-square me-2"></i>
        Manual Vehicle Entry
      </h1>
    </div>
    <%= link_to vmcott_security_gate_officer_dashboard_path, class: "btn btn-light btn-lg rounded-pill px-4 shadow-sm" do %>
      <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
    <% end %>
  </div>

  <!-- Flash Messages -->
  <% if flash[:alert] %>
    <div class="row">
      <div class="col-md-8 mx-auto">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
          <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div><%= flash[:alert] %></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="row">
      <div class="col-md-8 mx-auto">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
          <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div><%= flash[:notice] %></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="backdrop-filter: blur(10px); background-color: rgba(255, 255, 255, 0.98);">
        <div class="card-header bg-gradient-primary text-white border-0 py-3 px-4">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-white bg-opacity-25 p-2 me-3">
              <i class="bi bi-truck fs-4"></i>
            </div>
            <div>
              <h5 class="mb-0 fw-bold">Vehicle Check-in Form</h5>
              <small class="opacity-75">Step 1: Select Client Type first</small>
            </div>
          </div>
        </div>
        
        <div class="card-body p-4">
          
          <%= form_with url: vmcott_security_gate_officer_receive_vehicle_path, 
                        method: :post,
                        local: true, 
                        class: "needs-validation", 
                        id: "vehicle-form",
                        data: { turbo: false },
                        novalidate: true do |f| %>
            
            <!-- Hidden fields -->
            <input type="hidden" name="selection_method" id="selection-method" value="">
            <input type="hidden" name="create_new_vehicle" id="create-new-vehicle" value="false">
            <input type="hidden" name="vehicle_id" id="selected-vehicle-id" value="">
            <input type="hidden" name="selected_client_type" id="selected-client-type" value="">
            
            <!-- STEP 1: CLIENT TYPE SELECTION -->
            <div class="card mb-4 border-3 border-primary" id="client-type-step">
              <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i> Step 1: Select Client Type <span class="text-warning">*Required</span></h5>
              </div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-md-4">
                    <div class="card client-type-card h-100 border-2" id="agency-card" data-client-type="agency" style="cursor: pointer;">
                      <div class="card-body text-center p-3">
                        <div class="selected-indicator">
                          <i class="bi bi-check-circle-fill text-success selected-icon" style="display: none;"></i>
                        </div>
                        <i class="bi bi-building fs-1 text-primary mb-3"></i>
                        <h6 class="fw-bold">Agency</h6>
                        <small class="text-muted">PTSC</small>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-4">
                    <div class="card client-type-card h-100 border-2" id="walkin-card" data-client-type="walkin" style="cursor: pointer;">
                      <div class="card-body text-center p-3">
                        <div class="selected-indicator">
                          <i class="bi bi-check-circle-fill text-success selected-icon" style="display: none;"></i>
                        </div>
                        <i class="bi bi-person fs-1 text-info mb-3"></i>
                        <h6 class="fw-bold">Walk-in Customer</h6>
                        <small class="text-muted">One-time visitor</small>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-4">
                    <div class="card client-type-card h-100 border-2" id="new-company-card" data-client-type="new_company" style="cursor: pointer;">
                      <div class="card-body text-center p-3">
                        <div class="selected-indicator">
                          <i class="bi bi-check-circle-fill text-success selected-icon" style="display: none;"></i>
                        </div>
                        <i class="bi bi-building-add fs-1 text-success mb-3"></i>
                        <h6 class="fw-bold">New Company</h6>
                        <small class="text-muted">Register now</small>
                      </div>
                    </div>
                  </div>
                </div>
                <div id="client-type-error" class="invalid-feedback d-none mt-2">Please select a client type</div>
              </div>
            </div>

            <!-- AGENCY SELECTION -->
            <div id="agency-selection" class="mb-4 p-3 bg-light rounded-3 border-start border-4 border-primary" style="display: none;">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-building text-primary me-2"></i>
                <label for="agency_id" class="form-label fw-bold mb-0">Select Agency</label>
                <span class="text-danger ms-1">*</span>
              </div>
              <select name="agency_id" id="agency_id" class="form-select form-select-lg" disabled>
                <option value="">-- Choose an agency --</option>
                <% Agency.where(code: ['PTSC', 'TTPS', 'TTDF', 'VMCOTT']).order(:name).each do |agency| %>
                  <option value="<%= agency.id %>"><%= agency.name %> (<%= agency.code %>)</option>
                <% end %>
              </select>
            </div>

            <!-- WALK-IN CUSTOMER FORM - SIMPLIFIED (only name and phone) -->
            <div id="walkin-form" class="mb-4" style="display: none;">
              <div class="card border-info">
                <div class="card-header bg-info text-white">
                  <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i> Walk-in Customer Information</h6>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <%= label_tag :walkin_name, "Full Name", class: "form-label fw-bold" %>
                      <span class="text-danger">*</span>
                      <%= text_field_tag "walkin[name]", nil, class: "form-control", id: "walkin_name", placeholder: "John Doe", disabled: true %>
                    </div>
                    
                    <div class="col-md-6">
                      <%= label_tag :walkin_phone, "Phone Number", class: "form-label fw-bold" %>
                      <%= text_field_tag "walkin[phone]", nil, class: "form-control", id: "walkin_phone", placeholder: "868-555-1234", disabled: true %>
                    </div>
                    
                    <div class="col-md-6">
                      <%= label_tag :walkin_email, "Email Address", class: "form-label" %>
                      <%= email_field_tag "walkin[email]", nil, class: "form-control", id: "walkin_email", placeholder: "client@example.com", disabled: true %>
                    </div>
                  </div>
                  <input type="hidden" name="walkin[payment_terms]" value="cash">
                  <div class="alert alert-success mt-3 mb-0">
                    <small>Payment: <strong>Cash on Pickup</strong></small>
                  </div>
                </div>
              </div>
            </div>

            <!-- NEW COMPANY FORM -->
            <div id="new-company-form" class="mb-4" style="display: none;">
              <div class="card border-success">
                <div class="card-header bg-success text-white">
                  <h6 class="mb-0"><i class="bi bi-building-add me-2"></i> New Company Registration</h6>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <%= label_tag :company_name, "Company Name", class: "form-label fw-bold" %>
                      <span class="text-danger">*</span>
                      <%= text_field_tag "company[name]", nil, class: "form-control", id: "company_name", placeholder: "ABC Motors Ltd", disabled: true %>
                    </div>
                    
                    <div class="col-md-6">
                      <%= label_tag :company_contact_person, "Contact Person", class: "form-label fw-bold" %>
                      <span class="text-danger">*</span>
                      <%= text_field_tag "company[contact_person]", nil, class: "form-control", id: "company_contact_person", placeholder: "John Doe", disabled: true %>
                    </div>
                    
                    <div class="col-md-6">
                      <%= label_tag :company_phone, "Phone Number", class: "form-label fw-bold" %>
                      <%= text_field_tag "company[phone]", nil, class: "form-control", id: "company_phone", placeholder: "868-555-1234", disabled: true %>
                    </div>
                    
                    <div class="col-md-6">
                      <%= label_tag :company_email, "Email Address", class: "form-label fw-bold" %>
                      <span class="text-danger">*</span>
                      <%= email_field_tag "company[email]", nil, class: "form-control", id: "company_email", placeholder: "info@abcmotors.com", disabled: true %>
                    </div>
                    
                    <div class="col-12">
                      <%= label_tag :company_address, "Business Address", class: "form-label fw-bold" %>
                      <span class="text-danger">*</span>
                      <%= text_field_tag "company[address]", nil, class: "form-control", id: "company_address", placeholder: "123 Industrial Ave, Port of Spain", disabled: true %>
                    </div>
                    
                    <div class="col-12 mt-3">
                      <label class="form-label fw-bold">Select Payment Terms <span class="text-danger">*</span></label>
                      <div class="row g-2">
                        <div class="col-md-3">
                          <div class="form-check">
                            <input class="form-check-input" type="radio" name="company[payment_terms]" id="term_cash" value="cash" disabled>
                            <label class="form-check-label" for="term_cash">Cash on Pickup</label>
                          </div>
                        </div>
                        <div class="col-md-3">
                          <div class="form-check">
                            <input class="form-check-input" type="radio" name="company[payment_terms]" id="term_net30" value="net_30" disabled>
                            <label class="form-check-label" for="term_net30">Net 30 Days</label>
                          </div>
                        </div>
                        <div class="col-md-3">
                          <div class="form-check">
                            <input class="form-check-input" type="radio" name="company[payment_terms]" id="term_net60" value="net_60" disabled>
                            <label class="form-check-label" for="term_net60">Net 60 Days</label>
                          </div>
                        </div>
                        <div class="col-md-3">
                          <div class="form-check">
                            <input class="form-check-input" type="radio" name="company[payment_terms]" id="term_deposit" value="deposit_balance" disabled>
                            <label class="form-check-label" for="term_deposit">Deposit + Balance</label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Mode Toggle Cards -->
            <hr class="my-4">
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <div class="card h-100 border-2" id="existing-mode-card" style="cursor: pointer;">
                  <div class="card-body text-center p-4">
                    <i class="bi bi-search display-4 text-primary mb-3"></i>
                    <h5 class="fw-bold">Search Existing</h5>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card h-100 border-2" id="new-mode-card" style="cursor: pointer;">
                  <div class="card-body text-center p-4">
                    <i class="bi bi-plus-circle display-4 text-success mb-3"></i>
                    <h5 class="fw-bold">Add New Vehicle</h5>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- EXISTING VEHICLE SEARCH -->
            <div id="existing-vehicle-section" class="mb-4 position-relative">
              <label for="license-plate-search" class="form-label fw-bold">Search Existing Vehicle</label>
              <input type="text" id="license-plate-search" class="form-control" placeholder="Enter license plate (e.g., ABC-1234)" autocomplete="off" disabled>
              <div id="search-results" class="list-group mt-2 shadow-lg" style="display: none; position: absolute; z-index: 1000; width: 100%; max-height: 350px; overflow-y: auto;"></div>
            </div>
            
            <!-- New Vehicle Form - With manual entry support -->
            <div id="newVehicleForm" class="mb-4" style="display: none;">
              <div class="card border-2 border-success">
                <div class="card-header bg-success bg-opacity-10">
                  <h6 class="fw-bold mb-0 text-success"><i class="bi bi-plus-circle me-2"></i>New Vehicle Registration</h6>
                </div>
                <div class="card-body bg-light">
                  
                  <!-- MAKE & MODEL - Can use catalog OR manual entry -->
                  <div class="mb-4 position-relative" id="catalog-search-container">
                    <div class="d-flex align-items-center mb-2">
                      <i class="bi bi-search text-success me-2"></i>
                      <label for="catalog-search-input" class="form-label fw-bold mb-0">Make & Model</label>
                      <span class="badge bg-success bg-opacity-10 text-success ms-2">Catalog search</span>
                    </div>
                    
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                      <input type="text" 
                             id="catalog-search-input"
                             class="form-control border-start-0 ps-0" 
                             placeholder="Start typing e.g. Toyota Hilux OR enter custom make/model" 
                             autocomplete="off"
                             disabled>
                      <span class="input-group-text bg-light" id="catalog-status">
                        <span class="spinner-border spinner-border-sm d-none" id="catalog-spinner" role="status"></span>
                      </span>
                    </div>
                    
                    <div id="catalogHelp" class="form-text text-muted mt-2">
                      <i class="bi bi-info-circle me-1"></i> Type to search catalog, or enter custom make/model manually
                    </div>
                    
                    <!-- Search Results Dropdown -->
                    <div id="catalog-results"
                         class="list-group mt-2 shadow-lg position-absolute w-100"
                         style="display: none; z-index: 2000; max-height: 350px; overflow-y: auto; background: white; border: 1px solid #ced4da;">
                    </div>
                  </div>
                  
                  <!-- Hidden fields for make/model (these will be populated by catalog OR manual entry) -->
                  <input type="hidden" id="selected-make" name="new_vehicle[make]" value="">
                  <input type="hidden" id="selected-model" name="new_vehicle[model]" value="">
                  <input type="hidden" id="selected-type" name="new_vehicle[vehicle_type]" value="">
                  
                  <div class="row g-3">
                    <!-- Manual entry fields - visible for custom input -->
                    <div class="col-md-6">
                      <label class="form-label fw-bold">Make <span class="text-danger">*</span></label>
                      <input type="text" id="manual-make" class="form-control" placeholder="e.g., Toyota" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-bold">Model <span class="text-danger">*</span></label>
                      <input type="text" id="manual-model" class="form-control" placeholder="e.g., Hilux" disabled>
                    </div>
                    
                    <div class="col-md-4">
                      <label class="form-label fw-bold">Year</label>
                      <%= number_field_tag "new_vehicle[year_of_manufacture]", nil, class: "form-control", id: "new_vehicle_year", placeholder: "2023", disabled: true %>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Color</label>
                      <%= text_field_tag "new_vehicle[color]", nil, class: "form-control", id: "new_vehicle_color", disabled: true %>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label fw-bold">Vehicle Type <span class="text-danger">*</span></label>
                      <%= select_tag "new_vehicle[vehicle_type]", options_for_select(["Car", "SUV", "Pickup", "Van", "Bus", "Truck", "Motorcycle", "Other"]), prompt: "Select type...", class: "form-select", id: "new_vehicle_type", disabled: true %>
                    </div>
                    <div class="col-12">
                      <label class="form-label fw-bold">License Plate <span class="text-danger">*</span></label>
                      <%= text_field_tag "new_vehicle[license_plate]", nil, class: "form-control", id: "new_vehicle_plate", placeholder: "ABC-1234", disabled: true %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <hr class="my-4">
            
            <!-- Driver Information -->
            <div class="mb-4">
              <h6 class="fw-bold mb-3"><i class="bi bi-person-badge me-2 text-primary"></i>Driver Information</h6>
              <div class="row g-3">
                <div class="col-md-8">
                  <label class="form-label fw-bold">Driver Full Name <span class="text-danger">*</span></label>
                  <%= text_field_tag :driver_name, nil, class: "form-control", id: "driver_name", placeholder: "Enter driver's full name", disabled: true %>
                </div>
              </div>
            </div>
            
            <div class="mb-4">
              <label class="form-label fw-bold">Additional Notes</label>
              <%= text_area_tag :notes, nil, class: "form-control", rows: 2, placeholder: "Any special instructions...", id: "notes", disabled: true %>
            </div>
            
            <div id="validation-summary" class="alert alert-danger d-none"></div>
            
            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold" id="submit-btn" disabled>
                <i class="bi bi-arrow-right-circle me-2"></i>
                Proceed to Condition Check
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Initializing manual entry form...');
    
    // Get elements
    const clientTypeCards = document.querySelectorAll('.client-type-card');
    const agencySection = document.getElementById('agency-selection');
    const walkinForm = document.getElementById('walkin-form');
    const newCompanyForm = document.getElementById('new-company-form');
    const selectedClientType = document.getElementById('selected-client-type');
    const clientTypeError = document.getElementById('client-type-error');
    const submitBtn = document.getElementById('submit-btn');
    const createNewVehicle = document.getElementById('create-new-vehicle');
    const existingModeCard = document.getElementById('existing-mode-card');
    const newModeCard = document.getElementById('new-mode-card');
    const existingSection = document.getElementById('existing-vehicle-section');
    const newVehicleSection = document.getElementById('newVehicleForm');
    const searchInput = document.getElementById('license-plate-search');
    const searchResults = document.getElementById('search-results');
    const driverName = document.getElementById('driver_name');
    const notes = document.getElementById('notes');
    
    // Manual entry fields
    const manualMake = document.getElementById('manual-make');
    const manualModel = document.getElementById('manual-model');
    const catalogSearchInput = document.getElementById('catalog-search-input');
    const catalogResults = document.getElementById('catalog-results');
    const catalogSpinner = document.getElementById('catalog-spinner');
    const selectedMake = document.getElementById('selected-make');
    const selectedModel = document.getElementById('selected-model');
    const selectedType = document.getElementById('selected-type');
    const newMakeHidden = document.getElementById('new_vehicle_make');
    const newModelHidden = document.getElementById('new_vehicle_model');
    
    // Helper to enable submit button
    function enableSubmitButton() {
      if (submitBtn) {
        submitBtn.disabled = false;
        console.log('✅ Submit button enabled');
      }
    }
    
    // Helper to update hidden fields from manual input
    function updateHiddenFromManual() {
      if (manualMake && manualMake.value.trim()) {
        selectedMake.value = manualMake.value.trim();
        if (newMakeHidden) newMakeHidden.value = manualMake.value.trim();
      }
      if (manualModel && manualModel.value.trim()) {
        selectedModel.value = manualModel.value.trim();
        if (newModelHidden) newModelHidden.value = manualModel.value.trim();
      }
    }
    
    // Helper to update manual fields from catalog selection
    function updateManualFromCatalog(make, model) {
      if (manualMake) manualMake.value = make;
      if (manualModel) manualModel.value = model;
      if (selectedMake) selectedMake.value = make;
      if (selectedModel) selectedModel.value = model;
      if (newMakeHidden) newMakeHidden.value = make;
      if (newModelHidden) newModelHidden.value = model;
    }
    
    // Listen for manual input changes
    if (manualMake) {
      manualMake.addEventListener('input', updateHiddenFromManual);
    }
    if (manualModel) {
      manualModel.addEventListener('input', updateHiddenFromManual);
    }
    
    // Helper to enable/disable fields based on client type
    function setClientType(type) {
      console.log('Setting client type:', type);
      
      // Update UI
      clientTypeCards.forEach(card => {
        const cardType = card.dataset.clientType;
        if (cardType === type) {
          card.classList.add('border-primary', 'bg-light', 'selected-card');
          const icon = card.querySelector('.selected-icon');
          if (icon) icon.style.display = 'inline-block';
        } else {
          card.classList.remove('border-primary', 'bg-light', 'selected-card');
          const icon = card.querySelector('.selected-icon');
          if (icon) icon.style.display = 'none';
        }
      });
      
      // Hide all client sections
      agencySection.style.display = 'none';
      walkinForm.style.display = 'none';
      newCompanyForm.style.display = 'none';
      
      // Disable all fields first
      document.querySelectorAll('#agency-selection select, #walkin-form input, #walkin-form textarea, #new-company-form input, #new-company-form select, #new-company-form .form-check-input')
        .forEach(el => el.disabled = true);
      
      // Show and enable appropriate section
      if (type === 'agency') {
        agencySection.style.display = 'block';
        document.querySelectorAll('#agency-selection select').forEach(el => el.disabled = false);
        if (existingModeCard) existingModeCard.style.pointerEvents = 'auto';
        if (newModeCard) newModeCard.style.pointerEvents = 'auto';
      } else if (type === 'walkin') {
        walkinForm.style.display = 'block';
        document.querySelectorAll('#walkin-form input').forEach(el => el.disabled = false);
        if (existingModeCard) existingModeCard.style.pointerEvents = 'none';
        if (newModeCard) newModeCard.style.pointerEvents = 'auto';
        setMode(true);
      } else if (type === 'new_company') {
        newCompanyForm.style.display = 'block';
        document.querySelectorAll('#new-company-form input, #new-company-form select, #new-company-form .form-check-input')
          .forEach(el => el.disabled = false);
        if (existingModeCard) existingModeCard.style.pointerEvents = 'none';
        if (newModeCard) newModeCard.style.pointerEvents = 'auto';
        setMode(true);
      }
      
      // Enable driver fields
      if (driverName) driverName.disabled = false;
      if (notes) notes.disabled = false;
      
      // Store selected type
      if (selectedClientType) selectedClientType.value = type;
      if (clientTypeError) clientTypeError.classList.add('d-none');
      
      // Enable submit button
      enableSubmitButton();
    }
    
    // Mode toggle
    function setMode(isNew) {
      console.log('Setting mode:', isNew ? 'new' : 'existing');
      if (createNewVehicle) createNewVehicle.value = isNew ? 'true' : 'false';
      
      if (isNew) {
        existingSection.style.display = 'none';
        newVehicleSection.style.display = 'block';
        if (existingModeCard) existingModeCard.classList.remove('border-primary', 'bg-light');
        if (newModeCard) newModeCard.classList.add('border-primary', 'bg-light');
        if (searchInput) searchInput.disabled = true;
        // Enable new vehicle fields
        document.querySelectorAll('#newVehicleForm input, #newVehicleForm select').forEach(el => el.disabled = false);
      } else {
        existingSection.style.display = 'block';
        newVehicleSection.style.display = 'none';
        if (newModeCard) newModeCard.classList.remove('border-primary', 'bg-light');
        if (existingModeCard) existingModeCard.classList.add('border-primary', 'bg-light');
        if (searchInput) searchInput.disabled = false;
        // Disable new vehicle fields
        document.querySelectorAll('#newVehicleForm input, #newVehicleForm select').forEach(el => el.disabled = true);
      }
      enableSubmitButton();
    }
    
    // Client type click handlers
    clientTypeCards.forEach(card => {
      card.addEventListener('click', function() {
        const type = this.dataset.clientType;
        setClientType(type);
      });
    });
    
    // Mode card click handlers
    if (existingModeCard) {
      existingModeCard.addEventListener('click', function() {
        const clientType = selectedClientType ? selectedClientType.value : null;
        if (clientType === 'agency') {
          setMode(false);
        } else if (clientType) {
          alert('Existing vehicle search is only available for Agency clients');
        } else {
          alert('Please select a client type first');
        }
      });
    }
    
    if (newModeCard) {
      newModeCard.addEventListener('click', function() {
        if (selectedClientType && selectedClientType.value) {
          setMode(true);
        } else {
          alert('Please select a client type first');
        }
      });
    }
    
    // CATALOG SEARCH (for new vehicles) - with manual entry fallback
    let catalogTimeout;
    if (catalogSearchInput) {
      catalogSearchInput.addEventListener('input', function(e) {
        const query = this.value.trim();
        clearTimeout(catalogTimeout);
        
        // If query is not empty, allow manual entry by updating hidden fields
        if (query.length > 0 && manualMake && manualModel) {
          // Parse query - try to split into make and model
          const parts = query.split(' ');
          if (parts.length >= 2) {
            manualMake.value = parts[0];
            manualModel.value = parts.slice(1).join(' ');
          } else {
            manualMake.value = query;
            manualModel.value = '';
          }
          updateHiddenFromManual();
        }
        
        if (query.length < 2) {
          if (catalogResults) catalogResults.style.display = 'none';
          return;
        }
        
        if (catalogSpinner) catalogSpinner.classList.remove('d-none');
        
        catalogTimeout = setTimeout(() => {
          fetch(`/vehicles/catalog_search?q=${encodeURIComponent(query)}`, {
            headers: {
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('[name="csrf-token"]')?.content
            },
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            if (catalogSpinner) catalogSpinner.classList.add('d-none');
            
            if (data && data.length > 0 && catalogResults) {
              catalogResults.innerHTML = '';
              data.forEach(item => {
                const resultItem = document.createElement('button');
                resultItem.type = 'button';
                resultItem.className = 'list-group-item list-group-item-action';
                resultItem.setAttribute('data-make', item.make);
                resultItem.setAttribute('data-model', item.model);
                resultItem.setAttribute('data-type', item.vehicle_type || '');
                resultItem.innerHTML = `
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong>${item.label}</strong>
                      ${item.vehicle_type ? `<br><small class="text-muted">${item.vehicle_type}</small>` : ''}
                    </div>
                    <span class="badge bg-success">Select</span>
                  </div>
                `;
                
                resultItem.addEventListener('click', function() {
                  const make = this.getAttribute('data-make');
                  const model = this.getAttribute('data-model');
                  const type = this.getAttribute('data-type');
                  
                  // Update all fields
                  updateManualFromCatalog(make, model);
                  if (catalogSearchInput) catalogSearchInput.value = `${make} ${model}`;
                  if (selectedType) selectedType.value = type;
                  if (type && document.getElementById('new_vehicle_type')) {
                    const option = Array.from(document.getElementById('new_vehicle_type').options).find(opt => opt.value === type);
                    if (option) document.getElementById('new_vehicle_type').value = type;
                  }
                  
                  if (catalogResults) catalogResults.style.display = 'none';
                });
                
                catalogResults.appendChild(resultItem);
              });
              catalogResults.style.display = 'block';
            } else if (catalogResults) {
              catalogResults.innerHTML = '<div class="list-group-item text-center text-muted">No matches found - you can type custom make/model</div>';
              catalogResults.style.display = 'block';
            }
          })
          .catch(error => {
            console.error('Catalog search error:', error);
            if (catalogSpinner) catalogSpinner.classList.add('d-none');
            if (catalogResults) {
              catalogResults.innerHTML = '<div class="list-group-item text-center text-danger">Error searching catalog - you can type custom make/model</div>';
              catalogResults.style.display = 'block';
            }
          });
        }, 300);
      });
    }
    
    // Vehicle search for existing vehicles
    let searchTimeout;
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        clearTimeout(searchTimeout);
        
        if (query.length < 3) {
          searchResults.style.display = 'none';
          return;
        }
        
        searchResults.innerHTML = '<div class="list-group-item text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Searching...</div>';
        searchResults.style.display = 'block';
        
        searchTimeout = setTimeout(() => {
          fetch(`/vehicles/search?q=${encodeURIComponent(query)}`, {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            if (data && data.length > 0) {
              searchResults.innerHTML = '';
              data.forEach(vehicle => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'list-group-item list-group-item-action';
                item.innerHTML = `
                  <strong>${vehicle.license_plate}</strong><br>
                  <small>${vehicle.make} ${vehicle.model}</small>
                `;
                item.addEventListener('click', () => {
                  document.getElementById('selected-vehicle-id').value = vehicle.id;
                  searchInput.value = `${vehicle.license_plate} - ${vehicle.make} ${vehicle.model}`;
                  searchResults.style.display = 'none';
                });
                searchResults.appendChild(item);
              });
              searchResults.style.display = 'block';
            } else {
              searchResults.innerHTML = '<div class="list-group-item text-muted">No vehicles found</div>';
              searchResults.style.display = 'block';
            }
          })
          .catch(error => {
            console.error('Search error:', error);
            searchResults.innerHTML = '<div class="list-group-item text-danger">Error searching</div>';
            searchResults.style.display = 'block';
          });
        }, 300);
      });
    }
    
    // Click outside to close results
    document.addEventListener('click', function(e) {
      if (searchInput && !searchInput.contains(e.target) && searchResults && !searchResults.contains(e.target)) {
        searchResults.style.display = 'none';
      }
      if (catalogSearchInput && !catalogSearchInput.contains(e.target) && catalogResults && !catalogResults.contains(e.target)) {
        catalogResults.style.display = 'none';
      }
    });
    
    // Enable submit button after load
    setTimeout(() => {
      enableSubmitButton();
      console.log('Submit button enabled on load');
    }, 500);
    
    console.log('Manual entry form initialized');
  });
</script>

