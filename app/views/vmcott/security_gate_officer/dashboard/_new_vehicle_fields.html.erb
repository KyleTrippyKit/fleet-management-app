<%# app/views/vmcott/security_gate_officer/dashboard/_new_vehicle_fields.html.erb %>
<%# This partial is used for both agency and client new vehicle forms %>
<%# The 'prefix' parameter determines whether fields are for agency or client %>

<% prefix = local_assigns[:prefix] || 'agency' %>

<div class="new-vehicle-fields" data-prefix="<%= prefix %>">
  <div class="row g-3">
    <div class="col-md-6">
      <%= label_tag "#{prefix}_vehicle_make".to_sym, "Make *", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_make]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_make", 
          placeholder: "e.g., Toyota",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-make-error">Please enter vehicle make</div>
    </div>
    
    <div class="col-md-6">
      <%= label_tag "#{prefix}_vehicle_model".to_sym, "Model *", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_model]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_model", 
          placeholder: "e.g., Hilux",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-model-error">Please enter vehicle model</div>
    </div>
    
    <div class="col-md-4">
      <%= label_tag "#{prefix}_vehicle_year".to_sym, "Year *", class: "form-label fw-bold" %>
      <%= number_field_tag "new_vehicle[#{prefix}_year]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_year", 
          min: 1900, 
          max: Time.current.year + 1,
          placeholder: "2023",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-year-error">Please enter year of manufacture</div>
    </div>
    
    <div class="col-md-4">
      <%= label_tag "#{prefix}_vehicle_color".to_sym, "Color", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_color]", nil, 
          class: "form-control", 
          id: "#{prefix}_vehicle_color", 
          placeholder: "e.g., White" %>
    </div>
    
    <div class="col-md-4">
      <%= label_tag "#{prefix}_vehicle_type".to_sym, "Type *", class: "form-label fw-bold" %>
      <%= select_tag "new_vehicle[#{prefix}_type]", 
          options_for_select(["Car", "SUV", "Pickup", "Van", "Bus", "Truck", "Motorcycle", "Other"]), 
          prompt: "Select type...",
          class: "form-select new-vehicle-field", 
          id: "#{prefix}_vehicle_type",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-type-error">Please select vehicle type</div>
    </div>
    
    <div class="col-md-6">
      <%= label_tag "#{prefix}_vehicle_chassis".to_sym, "Chassis/VIN *", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_chassis]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_chassis", 
          placeholder: "e.g., 1HGCM82633A123456",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-chassis-error">Please enter chassis number</div>
    </div>
    
    <div class="col-md-6">
      <%= label_tag "#{prefix}_vehicle_serial".to_sym, "Serial Number *", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_serial]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_serial", 
          placeholder: "e.g., SN12345678",
          data: { required: true } %>
      <div class="invalid-feedback" id="<%= prefix %>-serial-error">Please enter serial number</div>
    </div>
    
    <div class="col-12">
      <%= label_tag "#{prefix}_vehicle_plate".to_sym, "License Plate *", class: "form-label fw-bold" %>
      <%= text_field_tag "new_vehicle[#{prefix}_plate]", nil, 
          class: "form-control new-vehicle-field", 
          id: "#{prefix}_vehicle_plate", 
          placeholder: "e.g., ABC-1234",
          data: { required: true, pattern: "[A-Za-z]{2,3}-?\\d{3,4}" } %>
      <div class="invalid-feedback" id="<%= prefix %>-plate-error">Please enter a valid license plate (e.g., ABC-1234)</div>
    </div>
  </div>
  
  <div class="alert alert-warning mt-3 mb-0 small">
    <i class="bi bi-exclamation-triangle me-2"></i>
    All fields marked with * are required for new vehicles.
  </div>
</div>