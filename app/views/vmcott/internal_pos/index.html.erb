<%# app/views/vmcott/internal_pos/index.html.erb %>

<div class="page-shell">

  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title">
          <i class="bi bi-receipt-cutoff"></i>
          Internal POS Work Orders
        </h2>
        <div class="hero-subtitle">
          Track internal jobs, parts consumption, and completion status — all in one place.
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to vmcott_inventory_dashboard_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-boxes me-1"></i> Inventory Dashboard
          <% end %>

          <%= link_to new_vmcott_internal_po_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i> New Work Order
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-tile">
      <div class="kpi-label">Active</div>
      <p class="kpi-value"><%= @active_count || 0 %></p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">In Progress</div>
      <p class="kpi-value"><%= @in_progress_count || 0 %></p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Completed Today</div>
      <p class="kpi-value"><%= @completed_today_count || 0 %></p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Total</div>
      <p class="kpi-value"><%= @internal_pos.respond_to?(:total_count) ? @internal_pos.total_count : @internal_pos.size %></p>
    </div>
  </div>

  <div class="section-card mb-3">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-funnel"></i>
        Filter
      </h5>
      <span class="muted small">Use filters to show the story during your demo.</span>
    </div>
    <div class="section-card-body">
      <%= form_with url: vmcott_internal_pos_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
        <div class="col-12 col-md-4">
          <label class="form-label mb-1">Search</label>
          <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Work order #, description, assigned..." %>
        </div>

        <div class="col-12 col-md-3">
          <label class="form-label mb-1">Status</label>
          <%= select_tag :status, options_for_select([["All", ""], ["Pending", "pending"], ["In Progress", "in_progress"], ["Completed", "completed"]], params[:status]),
                         class: "form-select" %>
        </div>

        <div class="col-12 col-md-3">
          <label class="form-label mb-1">Priority</label>
          <%= select_tag :priority, options_for_select([["All", ""], ["Low", "low"], ["Normal", "normal"], ["High", "high"], ["Urgent", "urgent"]], params[:priority]),
                         class: "form-select" %>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
          <%= button_tag type: "submit", class: "btn btn-outline-primary w-100" do %>
            <i class="bi bi-search me-1"></i>Apply
          <% end %>

          <%= link_to vmcott_internal_pos_path, class: "btn btn-outline-secondary w-100" do %>
            <i class="bi bi-x-circle me-1"></i>Clear
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="section-card">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-list-check"></i>
        Work Orders
      </h5>
      <span class="muted small">
        Click "View" to show a clean read-only details screen.
      </span>
    </div>

    <div class="section-card-body">
      <% if @internal_pos.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle table-clean">
            <thead>
              <tr>
                <th style="width: 170px;">Work Order</th>
                <th>Description</th>
                <th style="width: 150px;">Status</th>
                <th style="width: 140px;">Priority</th>
                <th style="width: 200px;">Assigned</th>
                <th style="width: 140px;" class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @internal_pos.each do |pos| %>
                <tr>
                  <td>
                    <strong><%= pos.work_order_number %></strong>
                    <div class="small muted">Created: <%= pos.created_at&.strftime("%b %d, %Y") %></div>
                  </td>

                  <td>
                    <div class="fw-semibold"><%= pos.description.presence || "—" %></div>
                    <% if pos.notes.present? %>
                      <div class="small muted text-truncate"><%= pos.notes %></div>
                    <% end %>
                  </td>

                  <td>
                    <% badge =
                      case pos.status
                      when "completed" then "bg-success"
                      when "in_progress" then "bg-primary"
                      when "pending" then "bg-warning text-dark"
                      else "bg-secondary"
                      end %>

                    <span class="badge <%= badge %>">
                      <%= pos.status.to_s.titleize %>
                    </span>
                  </td>

                  <td>
                    <% pbadge =
                      case pos.priority
                      when "urgent" then "bg-danger"
                      when "high" then "bg-warning text-dark"
                      when "normal" then "bg-info text-dark"
                      else "bg-secondary"
                      end %>

                    <span class="badge <%= pbadge %>">
                      <%= pos.priority.to_s.titleize %>
                    </span>
                  </td>

                  <td>
                    <% if pos.assigned_to.present? %>
                      <strong><%= pos.assigned_to.try(:full_name).presence || pos.assigned_to.email %></strong>
                    <% else %>
                      <span class="muted">Unassigned</span>
                    <% end %>
                  </td>

                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to vmcott_internal_po_path(pos), class: "btn btn-outline-primary" do %>
                        <i class="bi bi-eye me-1"></i>View
                      <% end %>
                      <%= link_to edit_vmcott_internal_po_path(pos), class: "btn btn-outline-warning" do %>
                        <i class="bi bi-pencil me-1"></i>Edit
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle me-2"></i>
          No internal POS work orders found.
          <%= link_to "Create one", new_vmcott_internal_po_path %>.
        </div>
      <% end %>
    </div>
  </div>
</div>