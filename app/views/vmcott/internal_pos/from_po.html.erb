<%# app/views/vmcott/internal_pos/from_po.html.erb %>
<% 
  po = PurchaseOrder.find(params[:purchase_order_id])
  quotation = po.quotation
  vehicle = po.vehicle
%>

<div class="container mt-4">
  <h1>Create Internal POS from Purchase Order</h1>
  <p class="text-muted">
    PO: <%= po.po_number %> | Vehicle: <%= vehicle.license_plate %> 
    <%= vehicle.make %> <%= vehicle.model %>
  </p>
  
  <div class="row">
    <!-- Purchase Order Details -->
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header">
          <h5>Purchase Order Information</h5>
        </div>
        <div class="card-body">
          <table class="table table-sm">
            <tr>
              <th>PO Number:</th>
              <td><%= po.po_number %></td>
            </tr>
            <tr>
              <th>Agency:</th>
              <td><%= vehicle.agency.name %></td>
            </tr>
            <tr>
              <th>Vehicle:</th>
              <td>
                <%= vehicle.license_plate %><br>
                <small class="text-muted">
                  <%= vehicle.make %> <%= vehicle.model %> | 
                  <%= vehicle.year_of_manufacture %>
                </small>
              </td>
            </tr>
            <tr>
              <th>Vendor:</th>
              <td><%= po.vendor %></td>
            </tr>
            <tr>
              <th>Amount:</th>
              <td>$<%= number_with_precision(po.amount, precision: 2) %></td>
            </tr>
            <tr>
              <th>Status:</th>
              <td>
                <span class="badge bg-<%= po.status == 'approved' ? 'success' : 'warning' %>">
                  <%= po.status.humanize %>
                </span>
              </td>
            </tr>
          </table>
          
          <% if po.notes.present? %>
            <div class="mt-3">
              <strong>Notes:</strong>
              <p class="text-muted"><%= po.notes %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Internal POS Form -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Internal POS Details</h5>
        </div>
        <div class="card-body">
          <%= form_with(url: vmcott_internal_pos_index_path, local: true) do |f| %>
            <%= f.hidden_field :purchase_order_id, value: po.id %>
            <%= f.hidden_field :vehicle_id, value: vehicle.id %>
            <%= f.hidden_field :agency_id, value: vehicle.agency_id %>
            
            <div class="mb-3">
              <%= f.label :work_order_number, 'POS Number', class: 'form-label' %>
              <%= f.text_field :work_order_number, class: 'form-control', 
                    value: "POS-#{Time.now.strftime('%Y%m%d')}-#{SecureRandom.hex(4).upcase}",
                    required: true %>
            </div>
            
            <div class="mb-3">
              <%= f.label :assigned_to_id, 'Assigned To', class: 'form-label' %>
              <select name="internal_pos[assigned_to_id]" class="form-select" required>
                <option value="">Select technician...</option>
                <!-- This would typically be populated from Users with technician role -->
                <% User.where(agency_id: current_user.agency_id, role: 'technician').each do |tech| %>
                  <option value="<%= tech.id %>"><%= tech.name || tech.email %></option>
                <% end %>
              </select>
            </div>
            
            <div class="mb-3">
              <%= f.label :priority, 'Priority', class: 'form-label' %>
              <%= f.select :priority, 
                    [['Normal', 'normal'], ['High', 'high'], ['Urgent', 'urgent']],
                    {}, class: 'form-select' %>
            </div>
            
            <div class="mb-3">
              <%= f.label :estimated_completion_date, 'Estimated Completion', class: 'form-label' %>
              <%= f.date_field :estimated_completion_date, class: 'form-control',
                    value: Date.today + 3.days, required: true %>
            </div>
            
            <!-- Items from PO -->
            <div class="mb-4">
              <h6>Work Items</h6>
              <% if po.purchase_order_items.any? %>
                <div class="border rounded p-3 bg-light">
                  <ul class="list-group list-group-flush">
                    <% po.purchase_order_items.each do |item| %>
                      <li class="list-group-item bg-light">
                        <div class="d-flex justify-content-between">
                          <div>
                            <strong><%= item.description %></strong>
                            <br>
                            <small class="text-muted">
                              Qty: <%= item.quantity %> | 
                              Unit: $<%= number_with_precision(item.unit_price, precision: 2) %>
                            </small>
                          </div>
                          <div>
                            <span class="badge bg-secondary">
                              $<%= number_with_precision(item.total_price, precision: 2) %>
                            </span>
                          </div>
                        </div>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% else %>
                <p class="text-muted">No items in purchase order</p>
              <% end %>
            </div>
            
            <div class="mb-3">
              <%= f.label :notes, 'Internal Notes', class: 'form-label' %>
              <%= f.text_area :notes, class: 'form-control', rows: 3,
                    placeholder: 'Add any internal notes for the work...' %>
            </div>
            
            <!-- Action Buttons -->
            <div class="d-flex justify-content-between">
              <%= link_to 'Back to PO', purchase_order_path(po), class: 'btn btn-secondary' %>
              <%= f.submit 'Create Internal POS', class: 'btn btn-success',
                    data: { confirm: 'Create internal POS and assign work?' } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>