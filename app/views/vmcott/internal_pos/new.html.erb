<%# app/views/vmcott/internal_pos/new.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-wrench me-2"></i>New Internal POS
              </h4>
              <small class="opacity-75">Create a new internal work order from a Purchase Order</small>
            </div>
            <div>
              <%= link_to vmcott_internal_pos_path, class: 'btn btn-sm btn-outline-light' do %>
                <i class="fas fa-arrow-left me-1"></i> Back to POS List
              <% end %>
            </div>
          </div>
        </div>

        <div class="card-body">
          <%= form_with model: @internal_pos, url: vmcott_internal_pos_path, local: true do |f| %>
            <% if @internal_pos.errors.any? %>
              <div class="alert alert-danger">
                <h5><%= pluralize(@internal_pos.errors.count, "error") %> prohibited this POS from being saved:</h5>
                <ul>
                  <% @internal_pos.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :work_order_number, class: 'form-label' %>
                  <%= f.text_field :work_order_number, class: 'form-control', readonly: true %>
                  <small class="form-text text-muted">Auto-generated POS number</small>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :priority, class: 'form-label' %>
                  <%= f.select :priority, InternalPos.priorities.keys.map { |p| [p.titleize, p] }, {}, class: 'form-select' %>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :purchase_order_id, 'Purchase Order', class: 'form-label' %>
                  <%= f.select :purchase_order_id,
                    options_for_select(
                      PurchaseOrder.order(created_at: :desc).limit(200).map { |po|
                        vehicle_label = po.vehicle ? "#{po.vehicle.license_plate} - #{po.vehicle.make} #{po.vehicle.model}" : "No Vehicle"
                        ["PO #{po.po_number} — #{vehicle_label}", po.id]
                      },
                      @internal_pos.purchase_order_id
                    ),
                    { include_blank: 'Select Purchase Order...' },
                    class: 'form-select' %>
                  <small class="form-text text-muted">Vehicle will be pulled from the selected PO automatically.</small>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :estimated_completion_date, class: 'form-label' %>
                  <%= f.date_field :estimated_completion_date, class: 'form-control' %>
                </div>
              </div>
            </div>

            <hr>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :work_section, 'Work Section', class: 'form-label' %>
                  <%= f.select :work_section,
                        options_for_select(InternalPos::WORK_SECTIONS, @internal_pos.work_section),
                        { include_blank: 'Select Section...' },
                        class: 'form-select' %>
                  <small class="form-text text-muted">For demo: saved into notes.</small>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :work_role, 'Work Role', class: 'form-label' %>
                  <%= f.select :work_role,
                        options_for_select(InternalPos::WORK_ROLES, @internal_pos.work_role),
                        { include_blank: 'Select Role...' },
                        class: 'form-select' %>
                  <small class="form-text text-muted">For demo: saved into notes.</small>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: 'form-label' %>
              <%= f.text_area :description, class: 'form-control', rows: 3, placeholder: 'Describe the work to be done...' %>
            </div>

            <div class="mb-3">
              <%= f.label :notes, class: 'form-label' %>
              <%= f.text_area :notes, class: 'form-control', rows: 3, placeholder: 'Additional notes...' %>
              <% if @part.present? %>
                <small class="form-text text-muted">This POS was created for part: <strong><%= @part.name %> (<%= @part.part_number %>)</strong></small>
              <% end %>
            </div>

            <div class="d-flex justify-content-between mt-4">
              <%= link_to 'Cancel', vmcott_internal_pos_path, class: 'btn btn-outline-secondary' %>
              <%= f.submit 'Create Internal POS', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
