<%# app/views/vmcott/internal_pos/new.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-wrench me-2"></i>New Internal POS
              </h4>
              <small class="opacity-75">Create a new internal Purchase Order Sheet</small>
            </div>
            <div>
              <%= link_to vmcott_internal_pos_path, class: 'btn btn-sm btn-outline-light' do %>
                <i class="fas fa-arrow-left me-1"></i> Back to POS List
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="card-body">
          <%= form_with model: @internal_pos, url: vmcott_internal_pos_path, local: true do |f| %>
            <% if @internal_pos.errors.any? %>
              <div class="alert alert-danger">
                <h5><%= pluralize(@internal_pos.errors.count, "error") %> prohibited this POS from being saved:</h5>
                <ul>
                  <% @internal_pos.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :work_order_number, class: 'form-label' %>
                  <%= f.text_field :work_order_number, class: 'form-control', readonly: true %>
                  <small class="form-text text-muted">Auto-generated work order number</small>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :priority, class: 'form-label' %>
                  <%= f.select :priority, InternalPos.priorities.keys.map { |p| [p.titleize, p] }, {}, class: 'form-select' %>
                </div>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :purchase_order_id, 'Purchase Order', class: 'form-label' %>
                  <%= f.select :purchase_order_id, 
                    options_for_select(PurchaseOrder.all.map { |po| ["PO #{po.po_number} - #{po.vehicle&.chassis_number || 'No Vehicle'}", po.id] }, @internal_pos.purchase_order_id),
                    { include_blank: 'Select Purchase Order...' }, 
                    class: 'form-select' %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :vehicle_id, class: 'form-label' %>
                  <%= f.select :vehicle_id, 
                    options_for_select(Vehicle.all.map { |v| ["#{v.license_plate} - #{v.make} #{v.model}", v.id] }, @internal_pos.vehicle_id),
                    { include_blank: 'Select Vehicle...' }, 
                    class: 'form-select' %>
                </div>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :assigned_to_id, 'Assigned To', class: 'form-label' %>
                  <%= f.select :assigned_to_id, 
                    options_for_select(User.all.map { |u| [u.name || u.email, u.id] }, @internal_pos.assigned_to_id),
                    { include_blank: 'Select User...' }, 
                    class: 'form-select' %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :estimated_completion_date, class: 'form-label' %>
                  <%= f.date_field :estimated_completion_date, class: 'form-control' %>
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <%= f.label :description, class: 'form-label' %>
              <%= f.text_area :description, class: 'form-control', rows: 3, placeholder: 'Describe the work to be done...' %>
            </div>
            
            <div class="mb-3">
              <%= f.label :notes, class: 'form-label' %>
              <%= f.text_area :notes, class: 'form-control', rows: 3, placeholder: 'Additional notes...' %>
              <% if @part.present? %>
                <small class="form-text text-muted">This POS was created for part: <strong><%= @part.name %> (<%= @part.part_number %>)</strong></small>
              <% end %>
            </div>
            
            <div class="d-flex justify-content-between mt-4">
              <%= link_to 'Cancel', vmcott_internal_pos_path, class: 'btn btn-outline-secondary' %>
              <%= f.submit 'Create Internal POS', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>