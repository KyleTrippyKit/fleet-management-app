<%# app/views/vmcott/internal_pos/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">

      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-receipt me-2"></i>Internal POS
              </h4>
              <small class="opacity-75">
                Work Order <strong><%= @internal_pos.work_order_number %></strong>
              </small>
            </div>

            <div class="d-flex gap-2">
              <%= link_to vmcott_internal_pos_index_path, class: "btn btn-sm btn-outline-light" do %>
                <i class="fas fa-list me-1"></i> Back to List
              <% end %>

              <%= link_to edit_vmcott_internal_pos_path(@internal_pos), class: "btn btn-sm btn-warning" do %>
                <i class="fas fa-edit me-1"></i> Edit
              <% end %>
            </div>
          </div>
        </div>

        <div class="card-body">
          <div class="row g-3">

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Status</div>
                <div class="fs-5 fw-semibold">
                  <%= @internal_pos.status.to_s.titleize.presence || "—" %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Priority</div>
                <div class="fs-5 fw-semibold">
                  <%= @internal_pos.priority.to_s.titleize.presence || "—" %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Work Section</div>
                <div class="fs-6 fw-semibold">
                  <%= @internal_pos.respond_to?(:work_section) ? (@internal_pos.work_section.presence || "—") : "—" %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Work Role</div>
                <div class="fs-6 fw-semibold">
                  <%= @internal_pos.respond_to?(:work_role) ? (@internal_pos.work_role.presence || "—") : "—" %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Estimated Completion</div>
                <div class="fw-semibold">
                  <%= @internal_pos.estimated_completion_date&.strftime("%Y-%m-%d") || "—" %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="text-muted small">Completed At</div>
                <div class="fw-semibold">
                  <%= @internal_pos.completed_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
                </div>
              </div>
            </div>

            <%# Optional links to source objects (won't crash if columns don't exist) %>
            <div class="col-12">
              <div class="border rounded p-3">
                <div class="text-muted small">Source</div>
                <div class="fw-semibold">
                  <% if @internal_pos.respond_to?(:purchase_order_id) && @internal_pos.purchase_order_id.present? %>
                    Purchase Order ID: <%= @internal_pos.purchase_order_id %>
                  <% elsif @internal_pos.respond_to?(:part_id) && @internal_pos.part_id.present? %>
                    Part ID: <%= @internal_pos.part_id %>
                  <% else %>
                    —
                  <% end %>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="border rounded p-3">
                <div class="text-muted small">Description</div>
                <div class="fw-semibold" style="white-space: pre-wrap;">
                  <%= @internal_pos.description.presence || "—" %>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="border rounded p-3">
                <div class="text-muted small">Notes</div>
                <div class="fw-semibold" style="white-space: pre-wrap;">
                  <%= @internal_pos.notes.presence || "—" %>
                </div>
              </div>
            </div>

          </div>
        </div>

        <div class="card-footer bg-light">
          <div class="d-flex justify-content-between">
            <small class="text-muted">
              Created: <%= @internal_pos.created_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
            </small>
            <small class="text-muted">
              Updated: <%= @internal_pos.updated_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
            </small>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
