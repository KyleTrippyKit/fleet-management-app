<%# app/views/vmcott/internal_pos/show.html.erb %>

<div class="page-shell">

  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title">
          <i class="bi bi-clipboard-check"></i>
          Work Order: <%= @internal_pos.work_order_number %>
        </h2>
        <div class="hero-subtitle">
          Read-only overview for demo: status, assignment, dates, and notes in one clean screen.
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to vmcott_internal_pos_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i> Back
          <% end %>

          <%= link_to edit_vmcott_internal_po_path(@internal_pos), class: "btn btn-primary" do %>
            <i class="bi bi-pencil me-1"></i> Edit
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-tile">
      <div class="kpi-label">Status</div>
      <p class="kpi-value" style="font-size: 1.35rem;">
        <%= @internal_pos.status.to_s.titleize %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Priority</div>
      <p class="kpi-value" style="font-size: 1.35rem;">
        <%= @internal_pos.priority.to_s.titleize %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Work Section</div>
      <p class="kpi-value" style="font-size: 1.15rem;">
        <%= @internal_pos.extracted_work_section || "—" %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Work Role</div>
      <p class="kpi-value" style="font-size: 1.15rem;">
        <%= @internal_pos.extracted_work_role || "—" %>
      </p>
    </div>
  </div>

  <div class="section-card">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-card-text"></i>
        Details
      </h5>
      <span class="muted small">This is the “company-ready” read-only view.</span>
    </div>

    <div class="section-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <div class="card border-0 bg-light">
            <div class="card-body">
              <div class="fw-bold mb-1">Work Details</div>
              <div class="mb-3">
                <% if @internal_pos.extracted_work_section.present? || @internal_pos.extracted_work_role.present? %>
                  <div class="mb-2">
                    <span class="badge bg-primary me-2"><%= @internal_pos.extracted_work_section %></span>
                    <span class="badge bg-info"><%= @internal_pos.extracted_work_role %></span>
                  </div>
                <% end %>
              </div>

              <div class="fw-bold mb-1 mt-3">Notes</div>
              <div class="text-muted" style="white-space: pre-line;">
                <%= @internal_pos.notes.presence || "—" %>
              </div>

              <% if @internal_pos.po_number.present? %>
                <hr>
                <div class="fw-bold mb-1">Related Purchase Order</div>
                <div>
                  <%= link_to @internal_pos.po_number, purchase_order_path(@internal_pos.purchase_order), class: "text-decoration-none" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="card border-0 bg-light">
            <div class="card-body">
              <div class="fw-bold mb-1">Assignment</div>
              <div class="small">
                <div class="d-flex justify-content-between mb-2">
                  <span class="muted">Created By</span>
                  <span><%= @internal_pos.created_by&.name || @internal_pos.created_by&.email || "System" %></span>
                </div>
              </div>

              <hr>

              <div class="fw-bold mb-1">Vehicle</div>
              <% if @internal_pos.vehicle.present? %>
                <div>
                  <strong><%= @internal_pos.vehicle.license_plate %></strong>
                  <div class="text-muted">
                    <%= @internal_pos.vehicle.make %> <%= @internal_pos.vehicle.model %>
                    <% if @internal_pos.vehicle.respond_to?(:year_of_manufacture) && @internal_pos.vehicle.year_of_manufacture.present? %>
                      (<%= @internal_pos.vehicle.year_of_manufacture %>)
                    <% end %>
                  </div>
                </div>
              <% else %>
                <div class="text-muted">No vehicle assigned</div>
              <% end %>

              <hr>

              <div class="fw-bold mb-1">Dates</div>
              <div class="small">
                <div class="d-flex justify-content-between">
                  <span class="muted">Created</span>
                  <span><%= @internal_pos.created_at&.strftime("%b %d, %Y %I:%M %p") %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="muted">Estimated completion</span>
                  <span><%= @internal_pos.estimated_completion_date&.strftime("%b %d, %Y") || "—" %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="muted">Completed</span>
                  <span><%= @internal_pos.completed_at&.strftime("%b %d, %Y %I:%M %p") || "—" %></span>
                </div>
              </div>

              <hr>

              <div class="fw-bold mb-2">Quick actions</div>
              <div class="d-flex flex-wrap gap-2">
                <% if @internal_pos.status == 'pending' %>
                  <%= button_to mark_in_progress_vmcott_internal_po_path(@internal_pos), method: :post, class: "btn btn-success" do %>
                    <i class="bi bi-play-fill me-1"></i> Start Work
                  <% end %>
                <% end %>

                <% if @internal_pos.status == 'in_progress' %>
                  <%= button_to mark_completed_vmcott_internal_po_path(@internal_pos), method: :post, class: "btn btn-success" do %>
                    <i class="bi bi-check-circle me-1"></i> Mark Complete
                  <% end %>
                <% end %>

                <%= link_to edit_vmcott_internal_po_path(@internal_pos), class: "btn btn-outline-primary" do %>
                  <i class="bi bi-pencil me-1"></i> Edit
                <% end %>

                <%= link_to vmcott_inventory_dashboard_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-boxes me-1"></i> Inventory Dashboard
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>