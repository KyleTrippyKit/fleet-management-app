<%# app/views/vmcott/internal_pos/show.html.erb %>

<div class="page-shell">

  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title">
          <i class="bi bi-clipboard-check"></i>
          Work Order: <%= @internal_pos.work_order_number %>
        </h2>
        <div class="hero-subtitle">
          Read-only overview for demo: status, assignment, dates, and notes in one clean screen.
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to vmcott_internal_pos_index_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i> Back
          <% end %>

          <%= link_to edit_vmcott_internal_pos_path(@internal_pos), class: "btn btn-primary" do %>
            <i class="bi bi-pencil me-1"></i> Edit
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-tile">
      <div class="kpi-label">Status</div>
      <p class="kpi-value" style="font-size: 1.35rem;">
        <%= @internal_pos.status.to_s.titleize %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Priority</div>
      <p class="kpi-value" style="font-size: 1.35rem;">
        <%= @internal_pos.priority.to_s.titleize %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Assigned</div>
      <p class="kpi-value" style="font-size: 1.15rem;">
        <%= @internal_pos.assigned_to&.try(:full_name).presence || @internal_pos.assigned_to&.email || "Unassigned" %>
      </p>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Completed</div>
      <p class="kpi-value" style="font-size: 1.15rem;">
        <%= @internal_pos.completed_at.present? ? @internal_pos.completed_at.strftime("%b %d, %Y") : "—" %>
      </p>
    </div>
  </div>

  <div class="section-card">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-card-text"></i>
        Details
      </h5>
      <span class="muted small">This is the “company-ready” read-only view.</span>
    </div>

    <div class="section-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <div class="card border-0 bg-light">
            <div class="card-body">
              <div class="fw-bold mb-1">Description</div>
              <div class="text-muted">
                <%= @internal_pos.description.presence || "—" %>
              </div>
              <hr>
              <div class="fw-bold mb-1">Notes</div>
              <div class="text-muted">
                <%= @internal_pos.notes.presence || "—" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="card border-0 bg-light">
            <div class="card-body">
              <div class="fw-bold mb-1">Dates</div>
              <div class="small">
                <div class="d-flex justify-content-between">
                  <span class="muted">Created</span>
                  <span><%= @internal_pos.created_at&.strftime("%b %d, %Y %I:%M %p") %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="muted">Estimated completion</span>
                  <span><%= @internal_pos.estimated_completion_date&.strftime("%b %d, %Y") || "—" %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="muted">Completed</span>
                  <span><%= @internal_pos.completed_at&.strftime("%b %d, %Y %I:%M %p") || "—" %></span>
                </div>
              </div>

              <hr>

              <div class="fw-bold mb-2">Quick actions</div>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to edit_vmcott_internal_pos_path(@internal_pos), class: "btn btn-outline-primary" do %>
                  <i class="bi bi-pencil me-1"></i> Edit Work Order
                <% end %>

                <%= link_to vmcott_inventory_dashboard_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-boxes me-1"></i> Inventory Dashboard
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Optional: If you have parts usage/lines, we can add a table here later %>
    </div>
  </div>
</div>
