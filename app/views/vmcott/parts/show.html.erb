<%# app/views/vmcott/parts/show.html.erb - FIXED WITH CORRECT PURCHASE REQUEST ROUTES %>

<div class="page-shell parts-show-page">

  <!-- Top header -->
  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title mb-1">
          <i class="fas fa-box-open me-2"></i>
          <%= @part&.name || "Unknown Part" %>
        </h2>
        <div class="hero-subtitle">
          <span class="me-2">
            <strong>Part #:</strong>
            <%= @part&.part_number.presence || "—" %>
          </span>
          <span class="text-muted">•</span>
          <span class="mx-2">
            <strong>Status:</strong>
            <span class="badge bg-<%= @part&.is_active ? 'success' : 'danger' %>">
              <%= @part&.is_active ? 'Active' : 'Inactive' %>
            </span>
          </span>
          <span class="text-muted">•</span>
          <span class="ms-2">
            <strong>Stock:</strong>
            <span class="badge bg-<%= @part&.stock_status_color || 'secondary' %>">
              <%= @part&.stock_status&.to_s&.titleize || "Unknown" %>
            </span>
          </span>
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to vmcott_parts_path, class: "btn btn-outline-secondary" do %>
            <i class="fas fa-arrow-left me-1"></i> Back to Parts
          <% end %>

          <% if @part %>
            <%= link_to edit_vmcott_part_path(@part), class: "btn btn-outline-primary" do %>
              <i class="fas fa-edit me-1"></i> Edit Part
            <% end %>

            <%# FIXED: Use the correct route from your routes list %>
            <%= link_to vmcott_new_internal_pos_from_part_path(part_id: @part.id), class: "btn btn-primary" do %>
              <i class="fas fa-wrench me-1"></i> Create Work Order
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI strip -->
  <div class="kpi-grid">
    <div class="kpi-tile">
      <div class="kpi-label">Current Stock</div>
      <div class="kpi-value"><%= @part&.current_stock || 0 %></div>
      <small class="text-muted d-block mt-1">Cached (fast dashboard number)</small>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Minimum Stock</div>
      <div class="kpi-value"><%= @part&.minimum_stock || 0 %></div>
      <small class="text-muted d-block mt-1">Below this triggers reorder pressure</small>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Reorder Point</div>
      <div class="kpi-value"><%= @part&.reorder_point || (@part&.minimum_stock || 0) %></div>
      <small class="text-muted d-block mt-1">Low-stock threshold</small>
    </div>

    <div class="kpi-tile">
      <div class="kpi-label">Suggested Reorder</div>
      <div class="kpi-value"><%= @part&.suggested_reorder_quantity || 0 %></div>
      <small class="text-muted d-block mt-1">Smart target using your model logic</small>
    </div>
  </div>

  <div class="row g-3">
    <!-- Left: details + actions -->
    <div class="col-12 col-lg-7">
      <div class="section-card">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-info-circle me-2"></i>Part Details
          </h5>
          <span class="muted small">Clean, operational view</span>
        </div>

        <div class="section-card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="muted small">Category</div>
              <div class="fw-semibold"><%= @part&.category.presence || "—" %></div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Type</div>
              <div class="fw-semibold">
                <span class="badge <%= @part&.is_consumable ? 'bg-info' : 'bg-secondary' %>">
                  <%= @part&.is_consumable ? 'Consumable' : 'Reusable' %>
                </span>
              </div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Unit</div>
              <div class="fw-semibold"><%= @part&.unit_of_measure.presence || "each" %></div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Lead Time</div>
              <div class="fw-semibold"><%= @part&.lead_time_days.presence || "—" %> days</div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Supplier</div>
              <div class="fw-semibold">
                <%= @part&.supplier&.name || "—" %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Warehouse Location</div>
              <div class="fw-semibold"><%= @part&.location_in_warehouse.presence || "—" %></div>
            </div>

            <div class="col-12">
              <div class="muted small">Description</div>
              <div class="text-muted"><%= @part&.description.presence || "—" %></div>
            </div>

            <div class="col-12">
              <hr class="my-2">

              <div class="d-flex flex-wrap gap-2">
                <%# Adjust stock link %>
                <% if @part %>
                  <%= link_to vmcott_inventory_adjust_stock_path(@part.id), class: "btn btn-outline-secondary" do %>
                    <i class="fas fa-sliders-h me-1"></i> Adjust Stock
                  <% end %>

                  <% if @part.needs_reorder? %>
                    <%# FIXED: Use the correct purchase request route - this is a GET route %>
                    <%= link_to new_vmcott_purchase_request_path(part_id: @part.id), class: "btn btn-warning" do %>
                      <i class="fas fa-exclamation-triangle me-1"></i> Create Purchase Request
                    <% end %>
                  <% else %>
                    <span class="badge bg-success d-inline-flex align-items-center px-3 py-2">
                      <i class="fas fa-check-circle me-2"></i> Stock OK
                    </span>
                  <% end %>

                  <%# FIXED: Use the inventory controller route instead %>
                  <%= link_to vmcott_inventory_stock_history_path(@part.id), class: "btn btn-outline-primary" do %>
                    <i class="fas fa-history me-1"></i> Stock History
                  <% end %>
                <% end %>
              </div>

              <% if @part&.needs_reorder? %>
                <div class="alert alert-warning mt-3 mb-0">
                  <i class="fas fa-bell me-1"></i>
                  Low stock detected. Suggested reorder: <strong><%= @part.suggested_reorder_quantity %></strong>
                  <%# Alternative: Add a button that does a POST request %>
                  <div class="mt-2">
                    <%= button_to "Quick Create Purchase Request", 
                          create_purchase_request_vmcott_part_path(@part), 
                          method: :post,
                          class: "btn btn-sm btn-danger",
                          form: { "data-turbo" => "false" } %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="section-card mt-3">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-dollar-sign me-2"></i>Pricing
          </h5>
          <span class="muted small">Cost → markup → selling price</span>
        </div>

        <div class="section-card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="muted small">Cost Price</div>
              <div class="fw-semibold"><%= @part&.cost_price.present? ? number_to_currency(@part.cost_price) : "—" %></div>
            </div>
            <div class="col-md-4">
              <div class="muted small">Markup %</div>
              <div class="fw-semibold"><%= (@part&.standard_markup_percentage || 30.0) %>%</div>
            </div>
            <div class="col-md-4">
              <div class="muted small">Selling Price</div>
              <div class="fw-semibold"><%= @part&.selling_price.present? ? number_to_currency(@part.selling_price) : "—" %></div>
            </div>

            <div class="col-md-6">
              <div class="muted small">Profit Margin</div>
              <div class="fw-semibold">
                <% if @part && @part.cost_price && @part.cost_price > 0 && @part.selling_price %>
                  <% profit_margin = ((@part.selling_price - @part.cost_price) / @part.cost_price * 100).round(1) %>
                  <span class="<%= profit_margin >= 30 ? 'text-success' : profit_margin >= 20 ? 'text-warning' : 'text-danger' %>">
                    <%= number_to_percentage(profit_margin, precision: 1) %>
                  </span>
                <% else %>
                  —
                <% end %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="muted small">Stock Value</div>
              <div class="fw-semibold">
                <% if @part %>
                  <% stock_value = (@part.cost_price || 0) * (@part.current_stock || 0) %>
                  <%= number_to_currency(stock_value) %>
                <% else %>
                  —
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: audit / transactions -->
    <div class="col-12 col-lg-5">
      <div class="section-card">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-clipboard-list me-2"></i>Recent Stock Movements
          </h5>
          <span class="muted small">Audit trail</span>
        </div>

        <div class="section-card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Type</th>
                  <th class="text-end">Qty</th>
                  <th class="text-end">Date</th>
                </tr>
              </thead>
              <tbody>
                <% (@recent_transactions || []).each do |tx| %>
                  <tr>
                    <td class="fw-semibold">
                      <span class="badge bg-light text-dark border">
                        <%= tx&.transaction_type&.to_s&.titleize || "Unknown" %>
                      </span>
                      <% if tx&.notes.present? %>
                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                          <%= tx.notes %>
                        </div>
                      <% end %>
                    </td>
                    <td class="text-end">
                      <span class="<%= (tx&.transaction_type&.to_s || '').include?('out') || (tx&.transaction_type&.to_s || '').include?('consum') ? 'text-danger' : 'text-success' %> fw-semibold">
                        <%= tx&.quantity || 0 %>
                      </span>
                    </td>
                    <td class="text-end text-muted small">
                      <%= tx&.created_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
                    </td>
                  </tr>
                <% end %>

                <% if (@recent_transactions || []).empty? %>
                  <tr>
                    <td colspan="3" class="text-center p-4 text-muted">
                      No transactions yet.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="p-3 border-top">
          <div class="d-flex gap-2">
            <% if @part %>
              <%# FIXED: Use the inventory controller route %>
              <%= link_to vmcott_inventory_stock_history_path(@part.id), class: "btn btn-sm btn-outline-primary w-100" do %>
                <i class="fas fa-chart-line me-1"></i> Full History
              <% end %>
              <%= link_to vmcott_inventory_adjust_stock_path(@part.id), class: "btn btn-sm btn-outline-secondary w-100" do %>
                <i class="fas fa-plus-minus me-1"></i> Adjust Stock
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="alert alert-info mt-3">
        <i class="fas fa-lightbulb me-1"></i>
        This screen proves: stock thresholds, reorder logic, pricing, and audit trail — all in one place.
      </div>
    </div>
  </div>

</div>