<%# app/views/vmcott/parts/index.html.erb %>
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-box-seam me-2"></i>Parts Catalog
    </h1>

    <div class="d-flex gap-2">
      <%= link_to 'Inventory Dashboard', vmcott_inventory_dashboard_path, class: 'btn btn-outline-secondary' %>
      <%= link_to 'New Part', new_vmcott_part_path, class: 'btn btn-primary' %>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <%= form_with url: vmcott_parts_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label mb-1">Search</label>
          <%= text_field_tag :q, @q, class: "form-control", placeholder: "Name, Part #, Category..." %>
        </div>

        <div class="col-12 col-md-auto">
          <%= button_tag type: "submit", class: "btn btn-outline-primary" do %>
            <i class="bi bi-search me-1"></i>Search
          <% end %>
        </div>

        <% if @q.present? %>
          <div class="col-12 col-md-auto">
            <%= link_to vmcott_parts_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-x-circle me-1"></i>Clear
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        All Parts (<%= @parts.respond_to?(:total_count) ? @parts.total_count : @parts.size %>)
      </h5>

      <small class="text-muted">
        Catalog only — stock levels are managed in Inventory Dashboard
      </small>
    </div>

    <div class="card-body">
      <% if @parts.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th style="width: 80px;">ID</th>
                <th>Name</th>
                <th>Part #</th>
                <th>Category</th>
                <th>Supplier</th>
                <th>Flags</th>
                <th class="text-end">Reorder / Min</th>
                <th style="width: 170px;">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @parts.each do |part| %>
                <tr>
                  <td class="text-muted"><%= part.id %></td>

                  <td>
                    <strong><%= part.name.presence || "Unnamed Part" %></strong>
                    <% if part.unit_of_measure.present? %>
                      <div class="small text-muted">UoM: <%= part.unit_of_measure %></div>
                    <% end %>
                  </td>

                  <td>
                    <%= part.part_number.presence || content_tag(:span, "N/A", class: "text-muted") %>
                  </td>

                  <td>
                    <span class="badge bg-secondary">
                      <%= part.category.presence || "Uncategorized" %>
                    </span>
                  </td>

                  <td>
                    <% if part.supplier.present? %>
                      <%= part.supplier.name %>
                    <% else %>
                      <span class="text-muted">None</span>
                    <% end %>
                  </td>

                  <td>
                    <%# Active flag %>
                    <% if part.is_active %>
                      <span class="badge bg-success">Active</span>
                    <% else %>
                      <span class="badge bg-danger">Inactive</span>
                    <% end %>

                    <%# Consumable flag %>
                    <% if part.is_consumable %>
                      <span class="badge bg-info text-dark">Consumable</span>
                    <% end %>
                  </td>

                  <td class="text-end">
                    <div>
                      <span class="text-muted">Reorder:</span>
                      <strong><%= part.reorder_point || 0 %></strong>
                    </div>
                    <div class="small text-muted">
                      Min: <%= part.minimum_stock || 0 %>
                    </div>
                  </td>

                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to 'View', vmcott_part_path(part), class: 'btn btn-outline-primary' %>
                      <%= link_to 'Edit', edit_vmcott_part_path(part), class: 'btn btn-outline-warning' %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-3">
          <%= paginate @parts if respond_to?(:paginate) %>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle me-2"></i>
          No parts found.
          <%= link_to 'Create your first part', new_vmcott_part_path %>.
        </div>
      <% end %>
    </div>
  </div>
</div>
