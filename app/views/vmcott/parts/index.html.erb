<%# app/views/vmcott/parts/index.html.erb %>

<div class="page-shell">

  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title">
          <i class="bi bi-box-seam"></i>
          Parts Catalog
        </h2>
        <div class="hero-subtitle">
          Standardized parts library for inventory, purchasing, and internal POS consumption.
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to vmcott_inventory_dashboard_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-boxes me-1"></i> Inventory Dashboard
          <% end %>
          <%= link_to new_vmcott_part_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i> New Part
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="section-card mb-3">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-search"></i>
        Search
      </h5>
      <span class="muted small">Search by name, part #, or category.</span>
    </div>

    <div class="section-card-body">
      <%= form_with url: vmcott_parts_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
        <div class="col-12 col-md-6 col-lg-4">
          <label class="form-label mb-1">Search</label>
          <%= text_field_tag :q, @q, class: "form-control", placeholder: "Name, Part #, Category..." %>
        </div>

        <div class="col-12 col-md-auto">
          <%= button_tag type: "submit", class: "btn btn-outline-primary" do %>
            <i class="bi bi-search me-1"></i>Search
          <% end %>
        </div>

        <% if @q.present? %>
          <div class="col-12 col-md-auto">
            <%= link_to vmcott_parts_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-x-circle me-1"></i>Clear
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="section-card">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="bi bi-list-ul"></i>
        All Parts (<%= @parts.respond_to?(:total_count) ? @parts.total_count : @parts.size %>)
      </h5>
      <span class="muted small">Stock is managed from Inventory Dashboard.</span>
    </div>

    <div class="section-card-body">
      <% if @parts.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle table-clean">
            <thead>
              <tr>
                <th style="width: 80px;">ID</th>
                <th>Name</th>
                <th>Part #</th>
                <th>Category</th>
                <th>Supplier</th>
                <th>Flags</th>
                <th class="text-end">Reorder / Min</th>
                <th style="width: 170px;" class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @parts.each do |part| %>
                <tr>
                  <td class="text-muted"><%= part.id %></td>

                  <td>
                    <strong><%= part.name.presence || "Unnamed Part" %></strong>
                    <% if part.unit_of_measure.present? %>
                      <div class="small muted">UoM: <%= part.unit_of_measure %></div>
                    <% end %>
                  </td>

                  <td><%= part.part_number.presence || content_tag(:span, "N/A", class: "muted") %></td>

                  <td>
                    <span class="badge bg-secondary">
                      <%= part.category.presence || "Uncategorized" %>
                    </span>
                  </td>

                  <td>
                    <% if part.supplier.present? %>
                      <%= part.supplier.name %>
                    <% else %>
                      <span class="muted">None</span>
                    <% end %>
                  </td>

                  <td>
                    <span class="badge <%= part.is_active ? "bg-success" : "bg-danger" %>">
                      <%= part.is_active ? "Active" : "Inactive" %>
                    </span>
                    <% if part.is_consumable %>
                      <span class="badge bg-info text-dark">Consumable</span>
                    <% end %>
                  </td>

                  <td class="text-end">
                    <div>
                      <span class="muted">Reorder:</span>
                      <strong><%= part.reorder_point || 0 %></strong>
                    </div>
                    <div class="small muted">
                      Min: <%= part.minimum_stock || 0 %>
                    </div>
                  </td>

                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to 'View', vmcott_part_path(part), class: 'btn btn-outline-primary' %>
                      <%= link_to 'Edit', edit_vmcott_part_path(part), class: 'btn btn-outline-warning' %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-3">
          <%= paginate @parts if respond_to?(:paginate) %>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle me-2"></i>
          No parts found.
          <%= link_to 'Create your first part', new_vmcott_part_path %>.
        </div>
      <% end %>
    </div>
  </div>
</div>
