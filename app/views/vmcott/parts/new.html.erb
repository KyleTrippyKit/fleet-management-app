<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">

      <div class="card">
        <div class="card-header bg-success text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i>New Part
              </h2>
              <small class="opacity-75">Create a new inventory part</small>
            </div>

            <div>
              <%= link_to "← Back", vmcott_parts_path, class: "btn btn-light btn-sm" %>
            </div>
          </div>
        </div>

        <div class="card-body">
          <%= render "form", part: @part %>
        </div>
      </div>

    </div>
  </div>
</div>
