<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">

      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="mb-0">
                <i class="bi bi-pencil-square me-2"></i>Edit Part
              </h2>
              <small class="opacity-75"><%= @part.part_number.presence || "No Part Number" %></small>
            </div>

            <div>
              <%= link_to '← Back', vmcott_parts_path, class: 'btn btn-light btn-sm' %>
              <%= link_to 'View', vmcott_part_path(@part), class: 'btn btn-info btn-sm ms-2' %>
            </div>
          </div>
        </div>

        <div class="card-body">
          <%= render "form", part: @part %>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Quick Stock Actions</h5>
        </div>

        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="card border-success">
                <div class="card-body">
                  <h6 class="card-title text-success mb-3">
                    <i class="bi bi-plus-circle me-2"></i>Add Stock
                  </h6>

                  <%= form_with url: adjust_stock_vmcott_part_path(@part), method: :post, local: true, class: "row g-2" do %>
                    <div class="col-8">
                      <div class="input-group">
                        <%= number_field_tag :quantity, nil, class: "form-control", min: 1, step: 1, required: true, placeholder: "Quantity" %>
                        <span class="input-group-text"><%= @part.unit_of_measure || "units" %></span>
                      </div>
                      <%= hidden_field_tag :direction, "add" %>
                    </div>

                    <div class="col-4">
                      <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-plus-lg me-1"></i>Add
                      </button>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card border-warning">
                <div class="card-body">
                  <h6 class="card-title text-warning mb-3">
                    <i class="bi bi-dash-circle me-2"></i>Remove Stock
                  </h6>

                  <%= form_with url: adjust_stock_vmcott_part_path(@part), method: :post, local: true, class: "row g-2" do %>
                    <div class="col-8">
                      <div class="input-group">
                        <%= number_field_tag :quantity, nil, class: "form-control", min: 1, step: 1, required: true, placeholder: "Quantity" %>
                        <span class="input-group-text"><%= @part.unit_of_measure || "units" %></span>
                      </div>
                      <%= hidden_field_tag :direction, "subtract" %>
                    </div>

                    <div class="col-4">
                      <button type="submit" class="btn btn-warning w-100" <%= "disabled" if @part.current_stock.to_i <= 0 %>>
                        <i class="bi bi-dash-lg me-1"></i>Remove
                      </button>
                    </div>
                  <% end %>

                  <% if @part.current_stock.to_i <= 0 %>
                    <small class="text-danger">Cannot remove stock — current stock is zero</small>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="row mt-3 g-2">
            <div class="col-md-4">
              <%= link_to vmcott_part_path(@part), class: "btn btn-outline-primary w-100" do %>
                <i class="bi bi-eye me-2"></i>View Part Details
              <% end %>
            </div>
            <div class="col-md-4">
              <%= link_to vmcott_parts_path, class: "btn btn-outline-secondary w-100" do %>
                <i class="bi bi-list me-2"></i>All Parts
              <% end %>
            </div>
            <div class="col-md-4">
              <%= link_to vmcott_inventory_dashboard_path, class: "btn btn-outline-info w-100" do %>
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
              <% end %>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
