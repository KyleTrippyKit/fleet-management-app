<script>
// Debug function to log to the debug panel
function logToDebug(message, type = 'info') {
  const debugOutput = document.getElementById('debug-output');
  if (debugOutput) {
    const colors = {
      info: '#0f0',
      error: '#f00',
      warn: '#ff0',
      success: '#0f0'
    };
    const time = new Date().toLocaleTimeString();
    const color = colors[type] || '#0f0';
    debugOutput.innerHTML += `<div style="color: ${color}; margin-bottom: 4px;">[${time}] ${message}</div>`;
    debugOutput.scrollTop = debugOutput.scrollHeight;
  }
  console.log(`[Debug] ${message}`);
}

// Toggle debug panel with Ctrl+Shift+D
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.shiftKey && e.key === 'D') {
    e.preventDefault();
    const panel = document.getElementById('debug-panel');
    if (panel) {
      panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    }
  }
});

// Log initial page load data
document.addEventListener('DOMContentLoaded', function() {
  logToDebug('=== Page Loaded ===');
  logToDebug(`Job ID: <%= @job.id %>`);
  logToDebug(`Job Status: <%= @job.status %>`);
  logToDebug(`Parts Requests Count: <%= @parts_requests&.count || 0 %>`);
  logToDebug(`Pending Parts: <%= @parts_requests&.count { |r| r.status == 'requested' } || 0 %>`);
  
  // Log all routes for debugging
  logToDebug('=== Routes ===');
  logToDebug(`Approve URL: <%= approve_vmcott_workshop_supervisor_job_path(@job) rescue 'Not found' %>`);
  logToDebug(`Reject URL: <%= reject_vmcott_workshop_supervisor_job_path(@job) rescue 'Not found' %>`);
  logToDebug(`Assign URL: <%= assign_vmcott_workshop_supervisor_job_path(@job) rescue 'Not found' %>`);
  logToDebug(`Send to QC URL: <%= send_to_qc_vmcott_workshop_supervisor_job_path(@job) rescue 'Not found' %>`);
  logToDebug(`Update Job URL: <%= update_job_vmcott_workshop_supervisor_job_path(@job) rescue 'Not found' %>`);
  
  // Log all buttons found
  logToDebug('=== Buttons ===');
  const buttons = document.querySelectorAll('button, input[type="submit"]');
  buttons.forEach(btn => {
    if (btn.textContent || btn.value) {
      logToDebug(`Found: ${btn.textContent || btn.value} (${btn.tagName})`);
    }
  });
  
  // Initialize all modals
  const editModalEl = document.getElementById('editModal');
  const rejectModalEl = document.getElementById('rejectModal');
  const reassignModalEl = document.getElementById('reassignModal');
  const requestUpdateModalEl = document.getElementById('requestUpdateModal');
  const qcFailModalEl = document.getElementById('qcFailModal');
  const noteModalEl = document.getElementById('noteModal');
  
  if (editModalEl) window.editModal = new bootstrap.Modal(editModalEl);
  if (rejectModalEl) window.rejectModal = new bootstrap.Modal(rejectModalEl);
  if (reassignModalEl) window.reassignModal = new bootstrap.Modal(reassignModalEl);
  if (requestUpdateModalEl) window.requestUpdateModal = new bootstrap.Modal(requestUpdateModalEl);
  if (qcFailModalEl) window.qcFailModal = new bootstrap.Modal(qcFailModalEl);
  if (noteModalEl) window.noteModal = new bootstrap.Modal(noteModalEl);
  
  // Expose functions globally
  window.openEditModal = () => { logToDebug('Opening Edit Modal'); window.editModal?.show(); };
  window.openRejectModal = () => { logToDebug('Opening Reject Modal'); window.rejectModal?.show(); };
  window.openReassignModal = () => { logToDebug('Opening Reassign Modal'); window.reassignModal?.show(); };
  window.openRequestUpdateModal = () => { logToDebug('Opening Request Update Modal'); window.requestUpdateModal?.show(); };
  window.openQCFailModal = () => { logToDebug('Opening QC Fail Modal'); window.qcFailModal?.show(); };
  window.openNoteModal = () => { logToDebug('Opening Note Modal'); window.noteModal?.show(); };
  
  window.closeEditModal = () => window.editModal?.hide();
  window.closeRejectModal = () => window.rejectModal?.hide();
  window.closeReassignModal = () => window.reassignModal?.hide();
  window.closeRequestUpdateModal = () => window.requestUpdateModal?.hide();
  window.closeQCFailModal = () => window.qcFailModal?.hide();
  window.closeNoteModal = () => window.noteModal?.hide();
  
  // Log form submissions
  document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', function(e) {
      logToDebug(`Form submitted: ${this.action}`, 'info');
    });
  });
  
  // Auto-hide alerts after 5 seconds
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(alert => {
    setTimeout(() => {
      alert.style.transition = 'opacity 0.5s ease';
      alert.style.opacity = '0';
      setTimeout(() => {
        if (alert && alert.remove) alert.remove();
      }, 500);
    }, 5000);
  });
  
  logToDebug('=== Debug Ready ===');
  logToDebug('Press Ctrl+Shift+D to toggle this panel');
});
</script>