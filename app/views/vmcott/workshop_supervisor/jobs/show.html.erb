<div class="min-h-screen bg-gray-100 pb-24">
  <div class="bg-white shadow p-4">
    <div class="flex justify-between items-center">
      <div>
        <%= link_to "← Back to Jobs", vmcott_workshop_supervisor_jobs_path, class: "text-blue-600 hover:underline text-sm" %>
        <h1 class="text-xl font-bold mt-2">Job #<%= @job.id %>: <%= @job.description %></h1>
      </div>
      <span class="text-xs px-3 py-1 rounded-full 
        <%= case @job.status
            when 'pending' then 'bg-yellow-100 text-yellow-800'
            when 'approved' then 'bg-green-100 text-green-800'
            when 'in_progress' then 'bg-blue-100 text-blue-800'
            when 'blocked' then 'bg-red-100 text-red-800'
            when 'completed' then 'bg-gray-100 text-gray-800'
            else 'bg-gray-100 text-gray-800'
            end %>">
        <%= @job.status.upcase %>
      </span>
    </div>
  </div>

  <div class="p-4">
    <!-- Job Details -->
    <div class="bg-white rounded-xl shadow p-4 mb-4">
      <h2 class="font-semibold text-lg mb-3">Job Details</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-gray-500">Description</p>
          <p class="mt-1"><%= @job.description || "No description provided" %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Vehicle</p>
          <p class="mt-1">
            <% if @vehicle %>
              <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %>
            <% else %>
              <span class="text-gray-400">No vehicle assigned</span>
            <% end %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Assigned Mechanic</p>
          <p class="mt-1">
            <% if @mechanic %>
              <%= @mechanic.name %>
            <% else %>
              <span class="text-gray-400">Not assigned</span>
            <% end %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Estimated Hours</p>
          <p class="mt-1"><%= @job.estimated_hours ? "#{@job.estimated_hours} hrs" : "Not set" %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Created</p>
          <p class="mt-1"><%= @job.created_at.strftime("%b %d, %Y %H:%M") %></p>
        </div>
        <% if @job.completed_at %>
          <div>
            <p class="text-sm text-gray-500">Completed</p>
            <p class="mt-1"><%= @job.completed_at.strftime("%b %d, %Y %H:%M") %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tasks -->
    <% if @tasks.present? && @tasks.any? %>
      <div class="bg-white rounded-xl shadow p-4 mb-4">
        <h2 class="font-semibold text-lg mb-3">Tasks (<%= @tasks.count %>)</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Task Name</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Est. Hours</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @tasks.each do |task| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2">
                    <%= link_to task.name, vmcott_workshop_supervisor_task_path(task), class: "text-blue-600 hover:underline" %>
                  </td>
                  <td class="px-4 py-2">
                    <span class="text-xs px-2 py-1 rounded-full 
                      <%= case task.status
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'approved' then 'bg-green-100 text-green-800'
                          when 'in_progress' then 'bg-blue-100 text-blue-800'
                          when 'blocked' then 'bg-red-100 text-red-800'
                          when 'completed' then 'bg-gray-100 text-gray-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= task.status.upcase %>
                    </span>
                  </td>
                  <td class="px-4 py-2"><%= task.estimated_hours ? "#{task.estimated_hours} hrs" : '-' %></td>
                  <td class="px-4 py-2">
                    <%= link_to "View", vmcott_workshop_supervisor_task_path(task), class: "text-blue-600 text-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <!-- Work Sessions -->
    <% if @work_sessions.present? && @work_sessions.any? %>
      <div class="bg-white rounded-xl shadow p-4 mb-4">
        <h2 class="font-semibold text-lg mb-3">Work Sessions</h2>
        <div class="space-y-2">
          <% @work_sessions.each do |session| %>
            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
              <div>
                <span class="font-medium"><%= session.mechanic&.name || 'Unknown' %></span>
                <span class="text-xs text-gray-500 ml-2">
                  <%= session.started_at&.strftime("%m/%d %H:%M") || 'Unknown' %> - 
                  <%= session.ended_at ? session.ended_at.strftime("%H:%M") : "In Progress" %>
                </span>
              </div>
              <span class="text-xs"><%= session.duration_hours ? "#{session.duration_hours} hrs" : '-' %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Parts Requests -->
    <% if @parts_requests.present? && @parts_requests.any? %>
      <div class="bg-white rounded-xl shadow p-4 mb-4">
        <h2 class="font-semibold text-lg mb-3">Parts Requests</h2>
        <div class="space-y-2">
          <% @parts_requests.each do |request| %>
            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
              <div>
                <span class="font-medium"><%= request.part&.name || request.custom_part_name %></span>
                <span class="text-xs text-gray-500 ml-2">x<%= request.quantity %></span>
              </div>
              <span class="text-xs px-2 py-1 rounded-full 
                <%= case request.status
                    when 'pending_approval' then 'bg-yellow-100 text-yellow-800'
                    when 'approved' then 'bg-green-100 text-green-800'
                    when 'rejected' then 'bg-red-100 text-red-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>">
                <%= request.status.humanize %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="bg-white rounded-xl shadow p-4">
      <h2 class="font-semibold text-lg mb-3">Actions</h2>
      <div class="flex flex-wrap gap-3">
        <% if @job.status == 'pending_approval' %>
          <%= button_to "Approve Job", approve_workshop_supervisor_job_path(@job), method: :post, class: "bg-green-500 text-white px-4 py-2 rounded-lg" %>
          <%= button_to "Reject Job", reject_workshop_supervisor_job_path(@job), method: :post, class: "bg-red-500 text-white px-4 py-2 rounded-lg", data: { confirm: "Reject this job?" } %>
        <% end %>
        
        <% if @job.assigned_mechanic.nil? && @job.status == 'approved' %>
          <div class="flex gap-2">
            <select id="mechanic-select" class="border rounded-lg px-3 py-2">
              <option value="">Select Mechanic</option>
              <% User.where(role: 'mechanic').each do |mechanic| %>
                <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
              <% end %>
            </select>
            <button onclick="assignJob()" class="bg-purple-500 text-white px-4 py-2 rounded-lg">Assign Mechanic</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function assignJob() {
  const mechanicId = document.getElementById('mechanic-select').value;
  if (!mechanicId) {
    alert('Please select a mechanic');
    return;
  }
  
  const form = document.createElement('form');
  form.method = 'POST';
  // Use direct URL instead of helper
  form.action = '/vmcott/workshop_supervisor/jobs/<%= @job.id %>/assign';
  
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
  const csrfInput = document.createElement('input');
  csrfInput.type = 'hidden';
  csrfInput.name = 'authenticity_token';
  csrfInput.value = csrfToken;
  form.appendChild(csrfInput);
  
  const mechanicInput = document.createElement('input');
  mechanicInput.type = 'hidden';
  mechanicInput.name = 'mechanic_id';
  mechanicInput.value = mechanicId;
  form.appendChild(mechanicInput);
  
  document.body.appendChild(form);
  form.submit();
}
</script>