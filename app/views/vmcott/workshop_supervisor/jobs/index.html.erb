<%# app/views/vmcott/workshop_supervisor/jobs/index.html.erb %>
<!-- Debug Info - Remove in production -->
<% if Rails.env.development? %>
  <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4" role="alert">
    <strong>Debug Info:</strong>
    <pre style="background: #f8f9fa; padding: 10px; margin-top: 10px; border-radius: 5px;">
      Jobs Count: <%= @jobs.try(:count) || 0 %>
      Status Filter: <%= params[:status].inspect %>
      Pagination: <%= @jobs.try(:current_page) %> / <%= @jobs.try(:total_pages) %>
    </pre>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>

<div class="container-fluid px-4 py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 fw-bold" style="color: #1e293b;">Jobs Management</h1>
    <div class="text-muted small bg-white px-3 py-2 rounded shadow-sm">
      <i class="bi bi-calendar3 me-1"></i>
      <%= Time.current.strftime("%B %d, %Y") %>
    </div>
  </div>

  <!-- Status Filter -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "All Jobs", vmcott_workshop_supervisor_jobs_path, class: "btn #{params[:status].blank? ? 'btn-primary' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "Pending Approval", vmcott_workshop_supervisor_jobs_path(status: 'pending_approval'), class: "btn #{params[:status] == 'pending_approval' ? 'btn-warning' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "Approved", vmcott_workshop_supervisor_jobs_path(status: 'approved'), class: "btn #{params[:status] == 'approved' ? 'btn-info' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "Assigned", vmcott_workshop_supervisor_jobs_path(status: 'assigned'), class: "btn #{params[:status] == 'assigned' ? 'btn-primary' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "In Progress", vmcott_workshop_supervisor_jobs_path(status: 'in_progress'), class: "btn #{params[:status] == 'in_progress' ? 'btn-success' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "Blocked", vmcott_workshop_supervisor_jobs_path(status: 'blocked'), class: "btn #{params[:status] == 'blocked' ? 'btn-danger' : 'btn-outline-secondary'} rounded-pill px-4" %>
        <%= link_to "Completed", vmcott_workshop_supervisor_jobs_path(status: 'completed'), class: "btn #{params[:status] == 'completed' ? 'btn-secondary' : 'btn-outline-secondary'} rounded-pill px-4" %>
      </div>
    </div>
  </div>

  <!-- Jobs Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0 py-3 ps-3">Job #</th>
              <th class="border-0 py-3">Description</th>
              <th class="border-0 py-3">Vehicle</th>
              <th class="border-0 py-3">Assigned To</th>
              <th class="border-0 py-3">Status</th>
              <th class="border-0 py-3">Created</th>
              <th class="border-0 py-3 text-end pe-3">Actions</th>
             </thead>
          <tbody>
            <% if @jobs.present? && @jobs.any? %>
              <% @jobs.each do |job| %>
                <tr>
                  <td class="ps-3 fw-semibold">#<%= job.id %></td>
                  <td><%= job.description.truncate(50) %></td>
                  <td>
                    <strong><%= job.inspection&.vehicle&.license_plate || 'N/A' %></strong><br>
                    <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.assigned_mechanic&.name || '<span class="text-muted">Not assigned</span>'.html_safe %></td>
                  <td>
                    <span class="badge <%= case job.status
                      when 'pending_approval' then 'bg-warning'
                      when 'approved' then 'bg-info'
                      when 'assigned' then 'bg-primary'
                      when 'in_progress' then 'bg-success'
                      when 'blocked' then 'bg-danger'
                      when 'completed' then 'bg-secondary'
                      else 'bg-secondary'
                    end %> px-3 py-2">
                      <%= job.status.humanize %>
                    </span>
                  </td>
                  <td><%= time_ago_in_words(job.created_at) %> ago</td>
                  <td class="text-end pe-3">
                    <%= link_to "View", vmcott_workshop_supervisor_job_path(job), class: "btn btn-sm btn-outline-primary rounded-pill", data: { turbo: false } %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center py-5">
                  <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                  <h6 class="text-muted">No jobs found</h6>
                  <p class="small text-muted">Try changing the status filter</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <% if @jobs.respond_to?(:total_pages) && @jobs.total_pages > 1 %>
        <div class="d-flex justify-content-center p-3 border-top">
          <%= paginate @jobs %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .table > :not(caption) > * > * {
    padding: 1rem 0.75rem;
  }
  .bg-light th {
    background-color: #f8fafc !important;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
  }
  .table tbody tr:hover {
    background-color: #f8fafc;
  }
</style>