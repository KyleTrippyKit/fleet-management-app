<%# app/views/vmcott/workshop_supervisor/inspections/show.html.erb %>

<% if @inspection.present? %>
  <div class="container-fluid py-4">
    <div class="row mb-4">
      <div class="col">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h1 class="h2">🔍 Inspection Details</h1>
            <p class="text-muted">Inspection #<%= @inspection.id %> - <%= @inspection.vehicle.license_plate %></p>
          </div>
          <div>
            <%= link_to "← Back to Dashboard", vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary me-2 rounded-pill" %>
            <% if @inspection.status == 'ready_for_pickup' %>
              <% email_sent = session["email_sent_for_inspection_#{@inspection.id}"] %>
              <% if email_sent %>
                <div class="d-inline-flex align-items-center gap-2">
                  <span class="badge bg-success px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i> Email Sent
                  </span>
                  <%= form_with url: vmcott_workshop_supervisor_send_ready_email_path(@inspection), 
                        method: :post, 
                        local: true,
                        data: { turbo: false },
                        class: "d-inline" do |f| %>
                    <%= f.submit "🔄 Resend Email", 
                          class: "btn btn-outline-warning rounded-pill",
                          data: { confirm: "Resend the ready for pickup notification to the customer?" } %>
                  <% end %>
                </div>
              <% else %>
                <%= form_with url: vmcott_workshop_supervisor_send_ready_email_path(@inspection), 
                      method: :post, 
                      local: true,
                      data: { turbo: false },
                      class: "d-inline" do |f| %>
                  <%= f.submit "📧 Send Ready for Pickup Email", 
                        class: "btn btn-info rounded-pill",
                        data: { confirm: "Send email notification to customer?" } %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Banner -->
    <div class="alert alert-<%= @inspection.status == 'ready_for_pickup' ? 'success' : 'info' %> mb-4">
      <div class="d-flex align-items-center">
        <i class="bi <%= @inspection.status == 'ready_for_pickup' ? 'bi-check-circle-fill' : 'bi-info-circle-fill' %> fs-3 me-3"></i>
        <div>
          <strong>Status:</strong> <%= @inspection.status.titleize %>
          <%= workflow_status_badge(@inspection.status) %>
          <%= rework_badge(@inspection) if @inspection.rework_required %>
          <%= qc_status_badge(@inspection) if @inspection.qc_passed_at.present? || @inspection.qc_failed_at.present? %>
          <% if @inspection.ready_for_pickup_at %>
            <br><small>Ready for pickup: <%= @inspection.ready_for_pickup_at.strftime("%B %d, %Y at %I:%M %p") %></small>
          <% end %>
          <% if @inspection.pickup_code %>
            <br><small>Pickup Code: <strong><%= @inspection.pickup_code %></strong></small>
          <% end %>
          <% if session["email_sent_for_inspection_#{@inspection.id}"] %>
            <br><small class="text-success">
              <i class="bi bi-envelope-check-fill me-1"></i> 
              Email sent
            </small>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Customer Contact Info Card -->
    <% reception = ReceptionLog.find_by(vehicle: @inspection.vehicle) %>
    <% if reception&.customer_email.present? %>
      <div class="alert alert-info mb-4 d-flex justify-content-between align-items-center">
        <div>
          <i class="bi bi-envelope me-2"></i>
          <strong>Customer Contact:</strong> 
          <%= reception.customer_name %> (<%= reception.customer_email %>)
        </div>
        <div>
          <span class="badge bg-<%= session["email_sent_for_inspection_#{@inspection.id}"] ? 'success' : 'secondary' %>">
            <%= session["email_sent_for_inspection_#{@inspection.id}"] ? 'Email Sent' : 'Email Not Sent' %>
          </span>
        </div>
      </div>
    <% else %>
      <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>No customer email found.</strong> Add an email to the reception log to enable notifications.
      </div>
    <% end %>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="inspectionTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">
          <i class="bi bi-info-circle me-1"></i> Details
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="jobs-tab" data-bs-toggle="tab" data-bs-target="#jobs" type="button" role="tab">
          <i class="bi bi-tools me-1"></i> Jobs (<%= @inspection.inspection_jobs.count %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="parts-tab" data-bs-toggle="tab" data-bs-target="#parts" type="button" role="tab">
          <i class="bi bi-box-seam me-1"></i> Parts Requests (<%= @inspection.parts_requests.count %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="findings-tab" data-bs-toggle="tab" data-bs-target="#findings" type="button" role="tab">
          <i class="bi bi-exclamation-triangle me-1"></i> Findings (<%= @inspection.findings.count %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="quotations-tab" data-bs-toggle="tab" data-bs-target="#quotations" type="button" role="tab">
          <i class="bi bi-file-text me-1"></i> Quotations (<%= @inspection.quotations.count %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline" type="button" role="tab">
          <i class="bi bi-clock-history me-1"></i> Timeline
        </button>
      </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
      
      <!-- DETAILS TAB -->
      <div class="tab-pane fade show active" id="details" role="tabpanel">
        <div class="row">
          <div class="col-md-8">
            <!-- Workflow Progress Bar -->
            <div class="card mb-4">
              <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Workflow Progress</h5>
              </div>
              <div class="card-body">
                <div class="progress" style="height: 25px;">
                  <div class="progress-bar <%= @inspection.status == 'on_hold' ? 'bg-danger' : 'bg-success' %>" 
                       role="progressbar" 
                       style="width: <%= workflow_progress_percentage(@inspection.status) %>%">
                    <%= workflow_progress_percentage(@inspection.status) %>% Complete
                  </div>
                </div>
                <% if @inspection.status == 'on_hold' %>
                  <p class="text-danger small mt-2">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    On Hold: <%= @inspection.hold_reason || 'No reason provided' %>
                  </p>
                <% end %>
              </div>
            </div>

            <!-- Vehicle Information Card -->
            <div class="card mb-4">
              <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Vehicle Information</h5>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <table class="table table-sm">
                      <tr><th>License Plate:</th><td><%= @inspection.vehicle.license_plate %></th>
                      <tr><th>Make/Model:</th><td><%= @inspection.vehicle.make %> <%= @inspection.vehicle.model %></th>
                      <tr><th>Year:</th><td><%= @inspection.vehicle.year_of_manufacture %></th>
                      <tr><th>Color:</th><td><%= @inspection.vehicle.color %></th>
                    </table>
                  </div>
                  <div class="col-md-6">
                    <table class="table table-sm">
                      <tr><th>Mileage at Inspection:</th><td><%= number_with_delimiter(@inspection.mileage_at_inspection) %> km</th>
                      <tr><th>Inspected By:</th><td><%= @inspection.inspector&.name || 'Unknown' %></th>
                      <tr><th>Inspection Date:</th><td><%= @inspection.created_at.strftime("%B %d, %Y") %></th>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <!-- Available Actions Card -->
            <div class="card mb-4">
              <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Available Actions</h5>
              </div>
              <div class="card-body">
                <div class="d-flex flex-column gap-2">
                  <% if @inspection.can_transition_to?('inspection_in_progress') %>
                    <%= link_to "Start Inspection", vmcott_workshop_supervisor_inspection_path(@inspection, status: 'inspection_in_progress'), method: :patch, class: "btn btn-primary btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('pending_mechanic_review') %>
                    <%= link_to "Complete Inspection", vmcott_workshop_supervisor_inspection_path(@inspection, status: 'pending_mechanic_review'), method: :patch, class: "btn btn-primary btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('pending_supervisor_review') %>
                    <%= link_to "Send to Supervisor", vmcott_workshop_supervisor_inspection_path(@inspection, status: 'pending_supervisor_review'), method: :patch, class: "btn btn-info btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('awaiting_approval') %>
                    <%= link_to "Create Jobs & Send to Approval", vmcott_workshop_supervisor_select_workflow_path(@inspection), class: "btn btn-warning btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('ready_for_work') && @inspection.ready_for_execution? %>
                    <%= link_to "Mark Ready for Work", vmcott_workshop_supervisor_inspection_path(@inspection, status: 'ready_for_work'), method: :patch, class: "btn btn-success btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('in_progress') %>
                    <%= link_to "Start Work", vmcott_workshop_supervisor_inspection_path(@inspection, status: 'in_progress'), method: :patch, class: "btn btn-success btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.can_transition_to?('ready_for_pickup') %>
                    <%= link_to "Pass QC", vmcott_workshop_supervisor_inspection_qc_path(@inspection), class: "btn btn-success btn-sm rounded-pill" %>
                  <% end %>
                  
                  <% if @inspection.rework_required %>
                    <%= link_to "Approve Rework", approve_rework_vmcott_workshop_supervisor_inspection_path(@inspection), method: :patch, class: "btn btn-warning btn-sm rounded-pill" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- JOBS TAB -->
      <div class="tab-pane fade" id="jobs" role="tabpanel">
        <div class="card">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Jobs (<%= @inspection.inspection_jobs.count %>)</h5>
          </div>
          <div class="card-body">
            <% if @inspection.inspection_jobs.any? %>
              <div class="table-responsive">
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Job ID</th>
                      <th>Description</th>
                      <th>Est. Hours</th>
                      <th>Labor Cost</th>
                      <th>Assigned Mechanic</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @inspection.inspection_jobs.each do |job| %>
                      <tr>
                        <td>#<%= job.id %></th>
                        <td><%= job.description %></th>
                        <td><%= job.estimated_hours %></th>
                        <td>$<%= number_with_delimiter(job.estimated_labor_cost || 0) %></th>
                        <td><%= job.assigned_mechanic&.name || "Unassigned" %></th>
                        <td><%= job_status_badge(job.status) %></th>
                        <td>
                          <%= link_to "View", vmcott_workshop_supervisor_job_path(job), class: "btn btn-sm btn-outline-primary rounded-pill", data: { turbo: false } %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p>No jobs created yet.</p>
                <%= link_to "Create Jobs", vmcott_workshop_supervisor_job_creation_path(@inspection), class: "btn btn-primary btn-sm rounded-pill" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- PARTS REQUESTS TAB -->
      <div class="tab-pane fade" id="parts" role="tabpanel">
        <div class="card">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Parts Requests (<%= @inspection.parts_requests.count %>)</h5>
          </div>
          <div class="card-body">
            <% if @inspection.parts_requests.any? %>
              <div class="table-responsive">
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Part</th>
                      <th>Quantity</th>
                      <th>Status</th>
                      <th>Approved By</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @inspection.parts_requests.each do |request| %>
                      <tr>
                        <td><%= request.part&.name || request.custom_part_name %></th>
                        <td><%= request.quantity %></th>
                        <td><%= parts_request_status_badge(request.status) %></th>
                        <td><%= request.approved_by&.name || "Pending" %></th>
                        <td>
                          <%= link_to "Review", vmcott_workshop_supervisor_review_parts_request_path(request), class: "btn btn-sm btn-outline-primary rounded-pill", data: { turbo: false } %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center text-muted py-5">
                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                <p>No parts requests yet.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- FINDINGS TAB -->
      <div class="tab-pane fade" id="findings" role="tabpanel">
        <div class="card">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Findings (<%= @inspection.findings.count %>)</h5>
          </div>
          <div class="card-body">
            <% if @inspection.findings.any? %>
              <div class="table-responsive">
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Description</th>
                      <th>Type</th>
                      <th>Severity</th>
                      <th>Blocking</th>
                      <th>Created By</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @inspection.findings.each do |finding| %>
                      <tr>
                        <td><%= finding.description %></th>
                        <td><span class="badge bg-secondary"><%= finding.finding_type&.humanize %></span></th>
                        <td>
                          <span class="badge <%= finding.severity == 'critical' ? 'bg-danger' : (finding.severity == 'major' ? 'bg-warning' : 'bg-info') %>">
                            <%= finding.severity&.humanize || 'Normal' %>
                          </span>
                        </th>
                        <td>
                          <% if finding.blocking %>
                            <span class="badge bg-danger">Yes</span>
                          <% else %>
                            <span class="badge bg-secondary">No</span>
                          <% end %>
                        </th>
                        <td><%= finding.created_by&.name || 'Unknown' %></th>
                        <td><%= finding.created_at.strftime('%b %d, %Y') %></th>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center text-muted py-5">
                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                <p>No findings recorded.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- QUOTATIONS TAB (NEW!) -->
      <div class="tab-pane fade" id="quotations" role="tabpanel">
        <div class="card">
          <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Quotations (<%= @inspection.quotations.count %>)</h5>
            <%= link_to "Create New Quotation", new_quotation_path(inspection_id: @inspection.id), class: "btn btn-sm btn-light rounded-pill", data: { turbo: false } %>
          </div>
          <div class="card-body">
            <% if @inspection.quotations.any? %>
              <div class="table-responsive">
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Quote #</th>
                      <th>Version</th>
                      <th>Total Amount</th>
                      <th>Status</th>
                      <th>Created</th>
                      <th>Sent Date</th>
                      <th>Valid Until</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @inspection.quotations.order(created_at: :desc).each do |quote| %>
                      <tr>
                        <td><strong><%= quote.quote_number %></strong></th>
                        <td>v<%= quote.version_number %></th>
                        <td class="fw-bold text-success">$<%= number_with_precision(quote.amount, precision: 2) %></th>
                        <td>
                          <span class="badge <%= 
                            case quote.status
                            when 'draft' then 'bg-secondary'
                            when 'sent' then 'bg-info'
                            when 'accepted' then 'bg-success'
                            when 'rejected' then 'bg-danger'
                            else 'bg-warning'
                            end
                          %>">
                            <%= quote.status&.humanize || 'Draft' %>
                          </span>
                        </td>
                        <td><%= quote.created_at.strftime('%b %d, %Y') %></th>
                        <td><%= quote.sent_at&.strftime('%b %d, %Y') || 'Not sent' %></th>
                        <td><%= quote.valid_to&.strftime('%b %d, %Y') || 'N/A' %></th>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <%= link_to "View", quotation_path(quote), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                            <% if quote.draft? %>
                              <%= link_to "Edit", edit_quotation_path(quote), class: "btn btn-outline-secondary rounded-pill ms-1", data: { turbo: false } %>
                              <%= button_to "Submit", submit_to_agency_quotation_path(quote), method: :post, class: "btn btn-outline-success rounded-pill ms-1", data: { turbo: false, confirm: "Submit this quotation to the agency?" } %>
                            <% end %>
                            <% if quote.sent? && current_user.agency_id == quote.agency_id %>
                              <%= button_to "Accept", accept_quotation_path(quote), method: :post, class: "btn btn-outline-success rounded-pill ms-1", data: { turbo: false, confirm: "Accept this quotation?" } %>
                              <%= button_to "Reject", reject_quotation_path(quote), method: :post, class: "btn btn-outline-danger rounded-pill ms-1", data: { turbo: false, confirm: "Reject this quotation?" } %>
                            <% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center text-muted py-5">
                <i class="bi bi-file-text fs-1 d-block mb-2"></i>
                <p>No quotations created yet.</p>
                <%= link_to "Create New Quotation", new_quotation_path(inspection_id: @inspection.id), class: "btn btn-primary rounded-pill", data: { turbo: false } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- TIMELINE TAB -->
      <div class="tab-pane fade" id="timeline" role="tabpanel">
        <div class="card">
          <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h5>
          </div>
          <div class="card-body">
            <ul class="list-unstyled">
              <li class="mb-3">
                <i class="bi bi-plus-circle text-primary me-2"></i>
                <strong>Inspection Created:</strong><br>
                <small class="text-muted"><%= @inspection.created_at.strftime("%B %d, %Y at %I:%M %p") %></small>
              </li>
              <% if @inspection.diagnosis_completed_at %>
                <li class="mb-3">
                  <i class="bi bi-stethoscope text-info me-2"></i>
                  <strong>Diagnosis Completed:</strong><br>
                  <small class="text-muted"><%= @inspection.diagnosis_completed_at.strftime("%B %d, %Y at %I:%M %p") %></small>
                </li>
              <% end %>
              <% if @inspection.started_at %>
                <li class="mb-3">
                  <i class="bi bi-play-circle text-success me-2"></i>
                  <strong>Work Started:</strong><br>
                  <small class="text-muted"><%= @inspection.started_at.strftime("%B %d, %Y at %I:%M %p") %></small>
                </li>
              <% end %>
              <% if @inspection.ready_for_pickup_at %>
                <li class="mb-3">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  <strong>Ready for Pickup:</strong><br>
                  <small class="text-muted"><%= @inspection.ready_for_pickup_at.strftime("%B %d, %Y at %I:%M %p") %></small>
                </li>
              <% end %>
              <% if @inspection.completed_at %>
                <li class="mb-3">
                  <i class="bi bi-flag-checkered text-secondary me-2"></i>
                  <strong>Completed:</strong><br>
                  <small class="text-muted"><%= @inspection.completed_at.strftime("%B %d, %Y at %I:%M %p") %></small>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
<% else %>
  <div class="container-fluid py-4">
    <div class="row">
      <div class="col-12">
        <div class="alert alert-danger d-flex align-items-center rounded-4">
          <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
          <div>
            <h5 class="mb-1">Inspection Not Found</h5>
            <p class="mb-0">The inspection you're looking for doesn't exist or has been removed.</p>
          </div>
        </div>
        <div class="text-center mt-4">
          <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-primary rounded-pill px-4" do %>
            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>