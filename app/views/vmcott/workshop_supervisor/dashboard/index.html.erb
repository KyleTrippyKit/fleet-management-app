<%# app/views/vmcott/workshop_supervisor/dashboard/index.html.erb %>
<%# Prevent Turbo from causing Stimulus to reload %>
<meta name="turbo-cache-control" content="no-cache">
<meta name="turbo-visit-control" content="reload">

<div class="container-fluid px-4 py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-0" style="color:#1e293b;">Supervisor Dashboard</h2>
      <small class="text-muted">Approve, assign, and monitor workshop activity</small>
    </div>
    <div class="text-muted small bg-white px-3 py-2 rounded shadow-sm">
      <i class="bi bi-calendar3 me-1"></i>
      <%= Time.current.strftime("%B %d, %Y") %>
    </div>
  </div>

  <!-- QUICK STATS -->
  <div class="row g-3 mb-4">
    <% stats = [
      ["Pending Approvals", @pending_tasks&.count || 0, "#f59e0b"],
      ["Findings", @pending_findings&.count || 0, "#f97316"],
      ["Parts Requests", @pending_parts_requests&.count || 0, "#3b82f6"],
      ["Active Jobs", @active_jobs&.count || 0, "#10b981"]
    ] %>

    <% stats.each do |label, count, color| %>
      <div class="col-md-3 col-sm-6">
        <div class="p-3 rounded-3 shadow-sm bg-white text-center border">
          <h4 class="fw-bold mb-1" style="color:<%= color %>;"><%= count %></h4>
          <small class="text-muted"><%= label %></small>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 🔥 ACTION REQUIRED -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      🔥 Action Required
    </div>
    <div class="card-body p-0">
      <div class="p-3">
        <% if @pending_tasks&.any? %>
          <div class="alert alert-warning mb-2">
            <div class="d-flex justify-content-between align-items-center">
              <span><strong><%= @pending_tasks.count %> tasks</strong> need approval</span>
              <a href="#tasks" class="btn btn-sm btn-warning" data-turbo="false">Review →</a>
            </div>
          </div>
        <% end %>

        <% if @pending_findings&.any? %>
          <div class="alert alert-danger mb-2">
            <div class="d-flex justify-content-between align-items-center">
              <span><strong><%= @pending_findings.count %> findings</strong> need review</span>
              <a href="#findings" class="btn btn-sm btn-danger" data-turbo="false">Review →</a>
            </div>
          </div>
        <% end %>

        <% if @pending_parts_requests&.any? %>
          <div class="alert alert-info mb-2">
            <div class="d-flex justify-content-between align-items-center">
              <span><strong><%= @pending_parts_requests.count %> parts requests</strong> pending</span>
              <a href="#parts" class="btn btn-sm btn-primary" data-turbo="false">Review →</a>
            </div>
          </div>
        <% end %>

        <% if @pending_tasks.empty? && @pending_findings.empty? && @pending_parts_requests.empty? %>
          <div class="text-center text-muted py-3">
            <i class="bi bi-check-circle-fill text-success me-2"></i>
            Nothing urgent right now
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- TASK APPROVAL -->
  <div id="tasks" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      📋 Task Approvals
    </div>
    <div class="card-body p-0">
      <% if @pending_tasks&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Task</th>
                <th>Vehicle</th>
                <th>Priority</th>
                <th class="pe-3 text-end">Action</th>
              </thead>
            <tbody>
              <% @pending_tasks.each do |task| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= task.name %></strong><br>
                    <small class="text-muted"><%= task.description&.truncate(50) %></small>
                   </td>
                  <td>
                    <%= task.inspection_job&.inspection&.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= task.inspection_job&.inspection&.vehicle&.make %> <%= task.inspection_job&.inspection&.vehicle&.model %></small>
                    </td>
                  <td>
                    <span class="badge <%= task.priority == 'high' ? 'bg-danger' : (task.priority == 'medium' ? 'bg-warning' : 'bg-secondary') %>">
                      <%= task.priority&.humanize || 'Normal' %>
                    </span>
                    </td>
                  <td class="pe-3 text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "View", vmcott_workshop_supervisor_task_path(task), class: "btn btn-outline-primary btn-sm rounded-pill", data: { turbo: false } %>
                      <%= button_to "Approve", vmcott_workshop_supervisor_approve_task_path(task), method: :post, class: "btn btn-success btn-sm rounded-pill ms-1", data: { turbo: false } %>
                    </div>
                    </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <%= link_to "View All Tasks", vmcott_workshop_supervisor_tasks_path(status: 'pending'), class: "btn btn-link text-decoration-none", data: { turbo: false } %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
          No tasks pending
        </div>
      <% end %>
    </div>
  </div>

  <!-- FINDINGS -->
  <div id="findings" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      ⚠️ Mechanic Findings (New Issues)
    </div>
    <div class="card-body p-0">
      <% if @pending_findings&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Description</th>
                <th>Vehicle</th>
                <th>Severity</th>
                <th class="pe-3 text-end">Action</th>
              </thead>
            <tbody>
              <% @pending_findings.each do |finding| %>
                <tr data-turbo="false">
                  <td class="ps-3"><%= finding.description&.truncate(60) %></td>
                  <td>
                    <%= finding.work_order&.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= finding.work_order&.vehicle&.make %> <%= finding.work_order&.vehicle&.model %></small>
                    </td>
                  <td>
                    <span class="badge <%= finding.severity == 'critical' ? 'bg-danger' : (finding.severity == 'high' ? 'bg-warning' : 'bg-secondary') %>">
                      <%= finding.severity&.humanize || 'Normal' %>
                    </span>
                    </td>
                  <td class="pe-3 text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "View", vmcott_workshop_supervisor_finding_path(finding), class: "btn btn-outline-primary btn-sm rounded-pill", data: { turbo: false } %>
                      <%= button_to "Approve", vmcott_workshop_supervisor_approve_finding_path(finding), method: :post, class: "btn btn-success btn-sm rounded-pill ms-1", data: { turbo: false } %>
                      <%= button_to "Reject", vmcott_workshop_supervisor_reject_finding_path(finding), method: :post, class: "btn btn-danger btn-sm rounded-pill ms-1", data: { confirm: "Reject this finding?", turbo: false } %>
                    </div>
                    </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <%= link_to "View All Findings", vmcott_workshop_supervisor_findings_path(status: 'pending'), class: "btn btn-link text-decoration-none", data: { turbo: false } %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
          No findings pending
        </div>
      <% end %>
    </div>
  </div>

  <!-- PARTS REQUESTS -->
  <div id="parts" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      📦 Parts Requests
    </div>
    <div class="card-body p-0">
      <% if @pending_parts_requests&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Part</th>
                <th>Qty</th>
                <th>Job</th>
                <th>Vehicle</th>
                <th class="pe-3 text-end">Action</th>
              </thead>
            <tbody>
              <% @pending_parts_requests.each do |request| %>
                <tr data-turbo="false">
                  <td class="ps-3"><strong><%= request.part&.name || request.custom_part_name || 'Custom Part' %></strong></td>
                  <td><%= request.quantity %></td>
                  <td><%= request.inspection_job&.description&.truncate(40) || 'N/A' %></td>
                  <td>
                    <%= request.inspection.vehicle.license_plate %><br>
                    <small class="text-muted"><%= request.inspection.vehicle.make %> <%= request.inspection.vehicle.model %></small>
                    </td>
                  <td class="pe-3 text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "Review", vmcott_workshop_supervisor_review_parts_request_path(request), class: "btn btn-outline-primary btn-sm rounded-pill", data: { turbo: false } %>
                      <%= button_to "Approve", vmcott_workshop_supervisor_approve_parts_request_path(request), method: :post, class: "btn btn-success btn-sm rounded-pill ms-1", data: { turbo: false } %>
                      <%= button_to "Reject", vmcott_workshop_supervisor_reject_parts_request_path(request), method: :post, class: "btn btn-danger btn-sm rounded-pill ms-1", data: { confirm: "Reject this parts request?", turbo: false } %>
                    </div>
                    </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
          No parts requests pending
        </div>
      <% end %>
    </div>
  </div>

  <!-- ACTIVE JOBS -->
  <div class="card shadow-sm">
    <div class="card-header bg-white fw-bold border-bottom">
      🟢 Active Jobs
    </div>
    <div class="card-body">
      <% if @active_jobs&.any? %>
        <div class="row g-3">
          <% @active_jobs.each do |job| %>
            <div class="col-md-4 col-sm-6">
              <div class="border rounded-3 p-3 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <strong class="text-primary">Job #<%= job.id %></strong>
                  <span class="badge bg-success">In Progress</span>
                </div>
                <p class="small text-muted mb-1">
                  <i class="bi bi-truck me-1"></i> <%= job.inspection.vehicle.license_plate %><br>
                  <small><%= job.inspection.vehicle.make %> <%= job.inspection.vehicle.model %></small>
                </p>
                <p class="small mb-2"><%= job.description.truncate(60) %></p>

                <div class="progress mb-2" style="height:5px;">
                  <% done = job.job_tasks.where(status: 'completed').count %>
                  <% total = job.job_tasks.count %>
                  <% percent = total > 0 ? (done.to_f / total * 100).round : 0 %>
                  <div class="progress-bar bg-primary" style="width:<%= percent %>%"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted"><%= percent %>% complete</small>
                  <%= link_to "View Details", vmcott_workshop_supervisor_job_path(job), class: "btn btn-outline-primary btn-sm rounded-pill", data: { turbo: false } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
          No active jobs
        </div>
      <% end %>
    </div>
  </div>

</div>