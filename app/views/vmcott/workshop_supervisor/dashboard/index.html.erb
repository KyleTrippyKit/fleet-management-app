<%# app/views/vmcott/workshop_supervisor/dashboard/index.html.erb %>
<%# Disable Turbo caching to prevent Stimulus from breaking on refresh %>
<meta name="turbo-cache-control" content="no-cache">
<meta name="turbo-visit-control" content="reload">

<div class="container-fluid px-4 py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-0" style="color:#1e293b;">Workshop Supervisor Dashboard</h2>
      <small class="text-muted">Complete 14-Step Workflow Management</small>
      <div class="mt-2">
        <span class="badge bg-info me-1">Phase 4: Job Creation</span>
        <span class="badge bg-warning me-1">Phase 5: Parts</span>
        <span class="badge bg-success me-1">Phase 6: Quote</span>
        <span class="badge bg-purple me-1">Phase 6.5: Approved Quotations</span>
        <span class="badge bg-secondary me-1">Phase 7: Approval</span>
        <span class="badge bg-purple me-1">Phase 7.5: Assign Jobs</span>
        <span class="badge bg-primary me-1">Phase 8: Active</span>
        <span class="badge bg-danger me-1">Phase 9: Findings</span>
        <span class="badge bg-info me-1">Phase 10: QC</span>
      </div>
    </div>
    <div class="text-muted small bg-white px-3 py-2 rounded shadow-sm">
      <i class="bi bi-calendar3 me-1"></i>
      <%= Time.current.strftime("%B %d, %Y") %>
    </div>
  </div>

  <!-- QUICK STATS - Enhanced for 14 phases -->
  <div class="row g-3 mb-4">
    <% stats = [
      ["Job Creation", @pending_job_creation&.count || 0, "#8b5cf6"],
      ["Parts Requests", @pending_parts_requests&.count || 0, "#3b82f6"],
      ["Quotations", @pending_quotation&.count || 0, "#10b981"],
      ["Awaiting Approval", @awaiting_approval&.count || 0, "#f59e0b"],
      ["Ready to Assign", @approved_jobs_count || 0, "#8b5cf6"],
      ["Active Jobs", @active_jobs&.count || 0, "#0ea5e9"],
      ["Findings", @pending_findings&.count || 0, "#ef4444"],
      ["QC Pending", @qc_pending_inspections&.count || 0, "#06b6d4"]
    ] %>

    <% stats.each do |label, count, color| %>
      <div class="col-md-3 col-sm-6 col-lg-2">
        <div class="p-3 rounded-3 shadow-sm bg-white text-center border h-100">
          <h4 class="fw-bold mb-1" style="color:<%= color %>;"><%= count %></h4>
          <small class="text-muted"><%= label %></small>
        </div>
      </div>
    <% end %>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 4: JOB CREATION FROM DIAGNOSIS -->
  <!-- ===================================================== -->
  <% if @pending_job_creation.present? && @pending_job_creation.any? %>
    <div class="card border-0 shadow-lg mb-4" style="border-left: 4px solid #8b5cf6;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h5 class="mb-1 fw-bold" style="color: #1e293b;">
              <i class="bi bi-diagram-3 me-2" style="color: #8b5cf6;"></i>
              Phase 4: Job Creation (Diagnosis Complete)
            </h5>
            <p class="text-muted small mb-0">Diagnosis completed - create jobs and assign mechanics</p>
          </div>
          <span class="badge px-3 py-2 rounded-pill" style="background: #ede9fe; color: #5b21b6;">
            <i class="bi bi-hourglass-split me-1"></i> <%= @pending_job_creation.count %> Waiting
          </span>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Vehicle</th>
                <th>Diagnosis Notes</th>
                <th>Mechanic Findings</th>
                <th>Inspector Recs</th>
                <th>Diagnosed By</th>
                <th>Completed</th>
                <th class="text-center">Actions</th>
              </thead>
            <tbody>
              <% @pending_job_creation.each do |inspection| %>
                <% 
                  mechanic_findings = inspection.findings.where(finding_type: 'mechanic')
                  inspector_recs = inspection.inspection_recommendations
                %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= inspection.vehicle.license_plate %></strong><br>
                    <small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                    <br>
                    <span class="badge <%= 
                      case inspection.status
                      when 'diagnosed' then 'bg-info text-dark'
                      when 'inspected' then 'bg-warning text-dark'
                      when 'in_progress' then 'bg-primary'
                      when 'completed' then 'bg-success'
                      when 'cancelled' then 'bg-danger'
                      else 'bg-secondary'
                      end
                    %>">
                      <%= inspection.status&.humanize %>
                    </span>
                  </td>
                  <td style="max-width: 250px;">
                    <% if inspection.diagnosis_notes.present? %>
                      <div class="small">
                        <i class="bi bi-chat-text text-primary me-1"></i>
                        <%= truncate(inspection.diagnosis_notes, length: 100) %>
                      </div>
                    <% else %>
                      <span class="text-muted fst-italic small">No diagnosis notes recorded</span>
                    <% end %>
                    <br>
                    <small class="text-muted">
                      <i class="bi bi-clock me-1"></i>
                      <%= time_ago_in_words(inspection.diagnosis_completed_at || inspection.created_at) %> ago
                    </small>
                  </td>
                  <td class="text-center">
                    <% if mechanic_findings.any? %>
                      <span class="badge bg-primary" data-bs-toggle="tooltip" title="<%= mechanic_findings.map(&:description).join(' | ') %>">
                        <i class="bi bi-tools me-1"></i><%= mechanic_findings.count %> findings
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">0 findings</span>
                    <% end %>
                  </td>
                  <td class="text-center">
                    <% if inspector_recs.any? %>
                      <span class="badge bg-info" data-bs-toggle="tooltip" title="<%= inspector_recs.map(&:description).join(' | ') %>">
                        <i class="bi bi-clipboard me-1"></i><%= inspector_recs.count %> recs
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">0 recs</span>
                    <% end %>
                  </td>
                  <td>
                    <%= inspection.assigned_mechanic&.name || 'Not assigned' %><br>
                    <small class="text-muted"><%= inspection.inspector&.name || 'Unknown inspector' %></small>
                  </td>
                  <td><%= inspection.diagnosis_completed_at&.strftime('%b %d, %Y') || 'N/A' %></td>
                  <td class="text-center">
                    <%= link_to "Create Jobs",
                      vmcott_workshop_supervisor_job_creation_path(inspection),
                      class: "btn btn-purple btn-sm rounded-pill px-3",
                      data: { turbo: false } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
  <!-- PHASE 5: PARTS REQUESTS -->
  <!-- ===================================================== -->
  <div id="parts" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      <i class="bi bi-box-seam me-2 text-primary"></i>
      Phase 5: Parts Requests
    </div>
    <div class="card-body p-0">
      <% if @pending_parts_requests&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Part</th>
                <th>Qty</th>
                <th>Job</th>
                <th>Vehicle</th>
                <th>Requested By</th>
                <th>Status</th>
                <th class="pe-3 text-end">Actions</th>
              </td>
            </thead>
            <tbody>
              <% @pending_parts_requests.each do |request| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= request.part&.name || request.custom_part_name || 'Custom Part' %></strong>
                    <% if request.part&.part_number %>
                      <br><small class="text-muted">PN: <%= request.part.part_number %></small>
                    <% end %>
                  </td>
                  <td class="fw-bold"><%= request.quantity %></td>
                  <td>
                    <%= request.inspection_job&.description&.truncate(40) || 'N/A' %><br>
                    <small class="text-muted">Job #<%= request.inspection_job&.id %></small>
                  </td>
                  <td>
                    <%= request.inspection&.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= request.inspection&.vehicle&.make %> <%= request.inspection&.vehicle&.model %></small>
                  </td>
                  <td>
                    <% requester = request.requested_by || request.inspection_job&.assigned_mechanic || request.inspection&.inspector %>
                    <%= requester&.name || 'Mechanic' %><br>
                    <small class="text-muted"><%= time_ago_in_words(request.created_at) %> ago</small>
                  </td>
                  <td>
                    <% if request.status == 'requested' %>
                      <span class="badge bg-warning">Pending Approval</span>
                    <% elsif request.status == 'approved' %>
                      <span class="badge bg-success">Approved</span>
                    <% elsif request.status == 'rejected' %>
                      <span class="badge bg-danger">Rejected</span>
                    <% elsif request.status == 'ordered' %>
                      <span class="badge bg-info">Ordered</span>
                    <% elsif request.status == 'received' %>
                      <span class="badge bg-primary">Received</span>
                    <% else %>
                      <span class="badge bg-secondary"><%= request.status&.humanize || 'Unknown' %></span>
                    <% end %>
                  </td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "Review", vmcott_workshop_supervisor_review_parts_request_path(request), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                      
                      <% if request.status == 'requested' %>
                        <%= button_to "Approve", vmcott_workshop_supervisor_approve_parts_request_path(request), method: :post, class: "btn btn-success rounded-pill ms-1", data: { turbo: false } %>
                        <%= button_to "Reject", vmcott_workshop_supervisor_reject_parts_request_path(request), method: :post, class: "btn btn-danger rounded-pill ms-1", data: { confirm: "Reject this parts request?", turbo: false } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <small class="text-muted">Showing <%= @pending_parts_requests.count %> parts requests</small>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-box-seam fs-1 d-block mb-2 text-muted"></i>
          <h6>No parts requests</h6>
          <p class="small mb-0">All parts have been processed</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 6: QUOTATION CREATION -->
  <!-- ===================================================== -->
  <% if @pending_quotation.present? && @pending_quotation.any? %>
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #10b981;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold" style="color: #1e293b;">
            <i class="bi bi-receipt me-2 text-success"></i>
            Phase 6: Quotation Creation
          </h5>
          <span class="badge bg-success"><%= @pending_quotation.count %> Ready</span>
        </div>
        <p class="text-muted small mt-1 mb-0">Parts approved - create final quotation for client</p>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Vehicle</th>
                <th>Jobs</th>
                <th>Parts Cost</th>
                <th>Labor Cost</th>
                <th>Total</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_quotation.each do |inspection| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= inspection.vehicle.license_plate %></strong><br>
                    <small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                  </td>
                  <td><%= inspection.inspection_jobs.count %> jobs</td>
                  <td>$<%= number_with_precision(calculate_parts_cost(inspection), precision: 2) %></td>
                  <td>$<%= number_with_precision(calculate_labor_cost(inspection), precision: 2) %></td>
                  <td class="fw-bold text-success">$<%= number_with_precision(calculate_labor_cost(inspection) + calculate_parts_cost(inspection), precision: 2) %></td>
                  <td class="text-center">
                    <%= link_to "Create Quotation", vmcott_workshop_supervisor_quotation_creation_path(inspection), class: "btn btn-success btn-sm rounded-pill px-3" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
  <!-- PHASE 6.5: APPROVED QUOTATIONS AWAITING INVENTORY -->
  <!-- ===================================================== -->
  <div id="approved-quotations" class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #8b5cf6;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-check-circle me-2" style="color: #8b5cf6;"></i>
          Phase 6.5: Approved Quotations - Awaiting Inventory Processing
        </h5>
        <%= link_to "View All", vmcott_workshop_supervisor_approved_quotations_path, class: "btn btn-sm btn-outline-purple rounded-pill" %>
      </div>
      <p class="text-muted small mt-1 mb-0">Customer approved - ready to send parts to inventory manager</p>
    </div>
    <div class="card-body p-0">
      <% @approved_quotations = Quotation.where(status: ['accepted', 'partially_rejected']).where.not(inspection_id: nil).order(accepted_at: :desc).limit(10) %>
      <% if @approved_quotations.present? && @approved_quotations.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Quote #</th>
                <th>Vehicle</th>
                <th>Approved Amount</th>
                <th>Jobs</th>
                <th>Parts</th>
                <th>Approved At</th>
                <th class="pe-3 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @approved_quotations.each do |quotation| %>
                <% approved_job_ids = quotation.client_approved_job_ids || [] %>
                <% approved_part_ids = quotation.client_approved_part_ids || [] %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= quotation.quote_number %></strong>
                  </td>
                  <td>
                    <%= quotation.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= quotation.vehicle&.make %> <%= quotation.vehicle&.model %></small>
                  </td>
                  <td class="text-success fw-bold">$<%= '%.2f' % quotation.amount %></td>
                  <td class="text-center"><span class="badge bg-success"><%= approved_job_ids.count %> approved</span></td>
                  <td class="text-center"><span class="badge bg-info"><%= approved_part_ids.count %> parts</span></td>
                  <td><%= quotation.accepted_at&.strftime("%b %d, %Y") || 'N/A' %><br><small class="text-muted"><%= time_ago_in_words(quotation.accepted_at) %> ago</small></td>
                  <td class="text-end pe-3">
                    <%= link_to "Review & Send to Inventory", vmcott_workshop_supervisor_approved_quotation_details_path(quotation), class: "btn btn-sm btn-purple rounded-pill px-3" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <%= link_to "View All Approved Quotations", vmcott_workshop_supervisor_approved_quotations_path, class: "btn btn-link text-decoration-none" %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2" style="color: #8b5cf6;"></i>
          <h6>No approved quotations</h6>
          <p class="small mb-0">Customer-approved quotations will appear here for inventory processing</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 7: AWAITING CUSTOMER APPROVAL -->
  <!-- ===================================================== -->
  <% if @awaiting_approval.present? && @awaiting_approval.any? %>
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #f59e0b;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold" style="color: #1e293b;">
            <i class="bi bi-hourglass-split me-2 text-warning"></i>
            Phase 7: Awaiting Customer Approval
          </h5>
          <span class="badge bg-warning"><%= @awaiting_approval.count %> Pending</span>
        </div>
        <p class="text-muted small mt-1 mb-0">Quotations sent - waiting for client approval</p>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Vehicle</th>
                <th>Quotation #</th>
                <th>Total Amount</th>
                <th>Workflow Type</th>
                <th>Sent Date</th>
                <th class="text-center">Status</th>
              </td>
            </thead>
            <tbody>
              <% @awaiting_approval.each do |inspection| %>
                <% quote = inspection.latest_quotation %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= inspection.vehicle.license_plate %></strong><br>
                    <small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                  </td>
                  <td><%= quote&.quote_number || 'N/A' %></td>
                  <td class="fw-bold">$<%= number_with_precision(quote&.amount || inspection.total_estimated_cost, precision: 2) %></td>
                  <td>
                    <span class="badge bg-<%= inspection.workflow_type == 'payment_before_work' ? 'danger' : 'success' %>">
                      <%= inspection.workflow_type&.humanize || 'Not Selected' %>
                    </span>
                  </td>
                  <td><%= inspection.workflow_selected_at&.strftime('%b %d, %Y') || 'N/A' %></td>
                  <td class="text-center">
                    <span class="badge bg-warning">Awaiting Client</span>
                  </td>
                </table>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
  <!-- 🔥 NEW: PHASE 7.5 - APPROVED JOBS READY FOR ASSIGNMENT -->
  <!-- ===================================================== -->
  <% if @approved_jobs.present? && @approved_jobs.any? %>
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #8b5cf6;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold" style="color: #1e293b;">
            <i class="bi bi-check-circle me-2 text-success"></i>
            Phase 7.5: Approved Jobs - Ready for Assignment
          </h5>
          <span class="badge bg-success"><%= @approved_jobs.count %> Ready to Assign</span>
        </div>
        <p class="text-muted small mt-1 mb-0">Customer has approved these jobs. Assign mechanics to start work.</p>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th style="width: 40px;">
                  <input type="checkbox" id="selectAllApprovedJobs" class="form-check-input">
                </th>
                <th class="ps-3">Vehicle</th>
                <th>Job Description</th>
                <th>Customer Approved</th>
                <th>Est. Hours</th>
                <th>Assign Mechanic</th>
                <th class="text-center">Action</th>
              </thead>
            <tbody>
              <% @approved_jobs.each do |job| %>
                <tr data-turbo="false" id="job-row-<%= job.id %>">
                  <td class="text-center">
                    <input type="checkbox" class="form-check-input job-select-checkbox" value="<%= job.id %>">
                  </td>
                  <td class="ps-3">
                    <strong><%= job.inspection&.vehicle&.license_plate %></strong><br>
                    <small class="text-muted"><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= job.description.truncate(50) %></td>
                  <td>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i> Approved
                    </span>
                    <br>
                    <small class="text-muted"><%= time_ago_in_words(job.updated_at) %> ago</small>
                  </td>
                  <td class="text-center"><%= job.estimated_hours %> hrs</td>
                  <td>
                    <select class="form-select form-select-sm mechanic-select" data-job-id="<%= job.id %>" style="width: 160px;">
                      <option value="">Select Mechanic</option>
                      <% @mechanics.each do |mechanic| %>
                        <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                      <% end %>
                    </select>
                  </td>
                  <td class="text-center">
                    <button class="btn btn-sm btn-primary assign-mechanic-btn rounded-pill px-3" data-job-id="<%= job.id %>">
                      <i class="bi bi-person-plus me-1"></i> Assign
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="bg-light">
              <tr>
                <td colspan="7" class="py-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong>Bulk Assign:</strong>
                      <select id="bulkMechanicSelect" class="form-select form-select-sm d-inline-block" style="width: 180px;">
                        <option value="">Select Mechanic</option>
                        <% @mechanics.each do |mechanic| %>
                          <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                        <% end %>
                      </select>
                      <button id="bulkAssignBtn" class="btn btn-sm btn-primary ms-2 rounded-pill">
                        <i class="bi bi-person-plus me-1"></i> Assign Selected
                      </button>
                    </div>
                    <small class="text-muted">Select jobs and assign to mechanic in bulk</small>
                  </div>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
  <!-- QUOTATIONS SECTION - Access to all quotes -->
  <!-- ===================================================== -->
  <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #10b981;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-file-text me-2 text-success"></i>
          Quotations & Estimates
        </h5>
        <div>
          <%= link_to "View All Quotations", quotations_path, class: "btn btn-outline-primary btn-sm rounded-pill me-2" %>
          <%= link_to "Quotation Workspace", workspace_quotations_path, class: "btn btn-outline-secondary btn-sm rounded-pill" %>
        </div>
      </div>
      <p class="text-muted small mt-1 mb-0">Manage quotes sent to customers and track approvals</p>
    </div>
    <div class="card-body p-0">
      <% recent_quotations = Quotation.where(inspection_id: @pending_job_creation.pluck(:id)).or(
                            Quotation.where(created_by_id: current_user.id)
                          ).order(created_at: :desc).limit(10) %>
      
      <% if recent_quotations.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Quote #</th>
                <th>Vehicle</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Created</th>
                <th class="pe-3 text-center">Actions</th>
              </thead>
              <tbody>
                <% recent_quotations.each do |quote| %>
                  <tr data-turbo="false">
                    <td class="ps-3">
                      <strong><%= quote.quote_number %></strong>
                    </td>
                    <td>
                      <%= quote.vehicle&.license_plate || 'N/A' %><br>
                      <small class="text-muted"><%= quote.vehicle&.make %> <%= quote.vehicle&.model %></small>
                    </td>
                    <td class="fw-bold text-success">$<%= number_with_precision(quote.amount, precision: 2) %></td>
                    <td>
                      <span class="badge <%= 
                        case quote.status
                        when 'draft' then 'bg-secondary'
                        when 'sent' then 'bg-info'
                        when 'accepted' then 'bg-success'
                        when 'rejected' then 'bg-danger'
                        else 'bg-warning'
                        end
                      %>">
                        <%= quote.status&.humanize || 'Draft' %>
                      </span>
                    </td>
                    <td><%= time_ago_in_words(quote.created_at) %> ago</td>
                    <td class="text-center pe-3">
                      <div class="btn-group btn-group-sm">
                        <%= link_to "View", quotation_path(quote), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                        <% if quote.draft? %>
                          <%= link_to "Edit", edit_quotation_path(quote), class: "btn btn-outline-secondary rounded-pill ms-1", data: { turbo: false } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="text-center p-3 border-top">
            <%= link_to "View All Quotations", quotations_path, class: "btn btn-link text-decoration-none", data: { turbo: false } %>
          </div>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-file-text fs-1 d-block mb-2"></i>
          <h6>No quotations yet</h6>
          <p class="small mb-0">Create jobs from diagnosis to generate a quotation.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 8: ACTIVE JOBS IN PROGRESS -->
  <!-- ===================================================== -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      <i class="bi bi-tools me-2 text-primary"></i>
      Phase 8: Active Jobs In Progress
    </div>
    <div class="card-body">
      <% if @active_jobs&.any? %>
        <div class="row g-3">
          <% @active_jobs.each do |job| %>
            <div class="col-md-4 col-sm-6">
              <div class="border rounded-3 p-3 h-100 bg-white hover-shadow">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <strong class="text-primary">Job #<%= job.id %></strong>
                  <span class="badge bg-success rounded-pill">
                    <i class="bi bi-play-circle me-1"></i>Active
                  </span>
                </div>
                <p class="small text-muted mb-1">
                  <i class="bi bi-truck me-1"></i> <%= job.inspection&.vehicle&.license_plate || 'N/A' %><br>
                  <small><%= job.inspection&.vehicle&.make %> <%= job.inspection&.vehicle&.model %></small>
                </p>
                <p class="small mb-2"><%= job.description.truncate(60) %></p>

                <% done = job.job_tasks.where(status: 'completed').count %>
                <% total = job.job_tasks.count %>
                <% percent = total > 0 ? (done.to_f / total * 100).round : 0 %>
                <div class="progress mb-2" style="height:6px;">
                  <div class="progress-bar bg-primary" style="width:<%= percent %>%"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted"><%= percent %>% complete (<%= done %>/<%= total %> tasks)</small>
                  <%= link_to "View Details", vmcott_workshop_supervisor_job_path(job), class: "btn btn-outline-primary btn-sm rounded-pill", data: { turbo: false } %>
                </div>

                <% if job.assigned_mechanic %>
                  <hr class="my-2">
                  <div class="d-flex align-items-center small text-muted">
                    <i class="bi bi-person-gear me-1"></i>
                    <span>Assigned to: <strong><%= job.assigned_mechanic.name %></strong></span>
                    <% if job.started_at %>
                      <span class="ms-2">
                        <i class="bi bi-clock me-1"></i><%= time_ago_in_words(job.started_at) %> ago
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
          <h6>No active jobs</h6>
          <p class="small mb-0">All jobs are either pending or completed</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 9: ADDITIONAL FINDINGS (Pending Review) -->
  <!-- ===================================================== -->
  <div id="findings" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      <i class="bi bi-exclamation-triangle me-2 text-danger"></i>
      Phase 9: Additional Findings (New Issues)
    </div>
    <div class="card-body p-0">
      <% if @pending_findings&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Finding</th>
                <th>Vehicle</th>
                <th>Severity</th>
                <th>Found By</th>
                <th>Status</th>
                <th class="pe-3 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_findings.each do |finding| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= finding.description&.truncate(50) %></strong>
                    <% if finding.blocking %>
                      <span class="badge bg-danger ms-1">BLOCKING</span>
                    <% end %>
                    <br>
                    <small class="text-muted"><%= time_ago_in_words(finding.created_at) %> ago</small>
                  </td>
                  <td>
                    <%= finding.work_order&.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= finding.work_order&.vehicle&.make %> <%= finding.work_order&.vehicle&.model %></small>
                  </td>
                  <td>
                    <span class="badge <%= finding.severity == 'critical' ? 'bg-danger' : (finding.severity == 'high' ? 'bg-warning' : 'bg-secondary') %>">
                      <i class="bi bi-flag-fill me-1"></i>
                      <%= finding.severity&.humanize || 'Normal' %>
                    </span>
                  </td>
                  <td><%= finding.created_by&.name || 'Unknown' %></td>
                  <td><span class="badge bg-warning">Pending Review</span></td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "View Details", vmcott_workshop_supervisor_finding_path(finding), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                      <%= button_to "Approve", vmcott_workshop_supervisor_approve_finding_path(finding), method: :post, class: "btn btn-success rounded-pill ms-1", data: { turbo: false } %>
                      <%= button_to "Reject", vmcott_workshop_supervisor_reject_finding_path(finding), method: :post, class: "btn btn-danger rounded-pill ms-1", data: { confirm: "Reject this finding?", turbo: false } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <%= link_to "View All Findings", vmcott_workshop_supervisor_findings_path(status: 'pending'), class: "btn btn-link text-decoration-none", data: { turbo: false } %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
          <h6>No pending findings</h6>
          <p class="small mb-0">All mechanic findings have been addressed</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PHASE 10: QUALITY CONTROL PENDING -->
  <!-- ===================================================== -->
  <% if @qc_pending_inspections.present? && @qc_pending_inspections.any? %>
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #06b6d4;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold" style="color: #1e293b;">
            <i class="bi bi-check2-square me-2 text-info"></i>
            Phase 10: Quality Control Pending
          </h5>
          <span class="badge bg-info"><%= @qc_pending_inspections.count %> Ready</span>
        </div>
        <p class="text-muted small mt-1 mb-0">Work completed - ready for QC inspection</p>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Vehicle</th>
                <th>Completed Jobs</th>
                <th>Mechanic</th>
                <th>Completed Date</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @qc_pending_inspections.each do |inspection| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= inspection.vehicle.license_plate %></strong><br>
                    <small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                  </td>
                  <td><%= inspection.inspection_jobs.where(status: 'completed').count %> / <%= inspection.inspection_jobs.count %> jobs</td>
                  <td><%= inspection.inspection_jobs.map(&:assigned_mechanic).compact.map(&:name).join(', ') || 'Various' %></td>
                  <td><%= inspection.updated_at.strftime('%b %d, %Y') %></td>
                  <td class="text-center">
                    <%= link_to "View QC", vmcott_workshop_supervisor_inspection_qc_path(inspection), class: "btn btn-info btn-sm rounded-pill px-3" %>
                    </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
<!-- 🔥 NEW SECTION: READY FOR PICKUP (QC PASSED) -->
<!-- ===================================================== -->
<% if @ready_for_pickup_inspections.present? && @ready_for_pickup_inspections.any? %>
  <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left: 4px solid #10b981;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-truck me-2 text-success"></i>
            Ready for Pickup (QC Passed)
          </h5>
          <p class="text-muted small mb-0">Vehicles that have passed QC and are ready to be returned to customers</p>
        </div>
        <span class="badge bg-success px-3 py-2 rounded-pill">
          <i class="bi bi-check-circle me-1"></i> <%= @ready_for_pickup_inspections&.count || 0 %> Ready
        </span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-3">Vehicle</th>
              <th>QC Passed By</th>
              <th>QC Passed At</th>
              <th>QC Notes</th>
              <th class="text-center">Customer Contact</th>
              <th class="pe-3 text-end">Actions</th>
             </thead>
            <tbody>
              <% @ready_for_pickup_inspections.each do |inspection| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= inspection.vehicle.license_plate %></strong><br>
                    <small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                  </td>
                  <td>
                    <%= inspection.final_inspector&.name || 'Unknown' %><br>
                    <small class="text-muted"><%= inspection.final_inspector&.role&.humanize %></small>
                  </td>
                  <td>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle-fill me-1"></i>
                      <% if inspection.qc_passed_at.present? %>
                        <%= time_ago_in_words(inspection.qc_passed_at) %> ago
                      <% else %>
                        <span class="text-muted">Not yet</span>
                      <% end %>
                    </span>
                    <br>
                    <small class="text-muted"><%= inspection.qc_passed_at&.strftime("%b %d, %Y • %I:%M %p") if inspection.qc_passed_at.present? %></small>
                  </td>
                  <td><%= inspection.final_inspection_notes&.truncate(40) || 'No notes' %></td>
                  <td class="text-center">
                    <% reception = ReceptionLog.find_by(vehicle: inspection.vehicle) %>
                    <% if reception&.customer_email.present? %>
                      <span class="badge bg-info">
                        <i class="bi bi-envelope me-1"></i> <%= reception.customer_email %>
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">No email on file</span>
                    <% end %>
                  </td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "View Details", vmcott_workshop_supervisor_inspection_path(inspection), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                      <%= button_to "📧 Notify Customer", 
                            vmcott_workshop_supervisor_send_ready_email_path(inspection), 
                            method: :post, 
                            class: "btn btn-success rounded-pill ms-1",
                            data: { confirm: "Send pickup notification email to customer?" } %>
                    </div>
                  </td>
                 </tr>
              <% end %>
            </tbody>
           </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ===================================================== -->
  <!-- PHASE 11-14: TASK APPROVALS & WORK ORDERS -->
  <!-- ===================================================== -->
  <div id="tasks" class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold border-bottom">
      <i class="bi bi-clipboard-check me-2 text-secondary"></i>
      Phase 11-14: Task Approvals & Work Orders
    </div>
    <div class="card-body p-0">
      <% if @pending_tasks&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3">Task</th>
                <th>Vehicle</th>
                <th>Assigned To</th>
                <th>Est. Hours</th>
                <th class="pe-3 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_tasks.each do |task| %>
                <tr data-turbo="false">
                  <td class="ps-3">
                    <strong><%= task.name %></strong><br>
                    <small class="text-muted"><%= task.description&.truncate(50) %></small>
                  </td>
                  <td>
                    <%= task.inspection_job&.inspection&.vehicle&.license_plate || 'N/A' %><br>
                    <small class="text-muted"><%= task.inspection_job&.inspection&.vehicle&.make %> <%= task.inspection_job&.inspection&.vehicle&.model %></small>
                  </td>
                  <td><%= task.assigned_mechanic&.name || 'Unassigned' %></td>
                  <td><%= task.estimated_hours ? "#{task.estimated_hours} hrs" : 'Not set' %></td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "View Details", vmcott_workshop_supervisor_task_path(task), class: "btn btn-outline-primary rounded-pill", data: { turbo: false } %>
                      <%= button_to "Approve Task", vmcott_workshop_supervisor_approve_task_path(task), method: :post, class: "btn btn-success rounded-pill ms-1", data: { turbo: false } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="text-center p-3 border-top">
          <%= link_to "View All Pending Tasks", vmcott_workshop_supervisor_tasks_path(status: 'pending'), class: "btn btn-link text-decoration-none", data: { turbo: false } %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
          <h6>All tasks approved</h6>
          <p class="small mb-0">No tasks waiting for your approval</p>
        </div>
      <% end %>
    </div>
  </div>

</div>

<style>
  .bg-purple {
    background-color: #8b5cf6 !important;
  }
  
  .hover-shadow {
    transition: all 0.2s ease;
  }
  
  .hover-shadow:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }
  
  .table tbody tr:hover {
    background-color: #f8fafc;
    transition: background-color 0.2s ease;
  }
  
  .alert {
    border-left: 4px solid;
  }
  
  .alert-warning {
    border-left-color: #f59e0b;
  }
  
  .alert-danger {
    border-left-color: #ef4444;
  }
  
  .alert-info {
    border-left-color: #3b82f6;
  }
  
  .badge {
    font-weight: 500;
  }
  
  .btn-group .btn {
    transition: all 0.2s ease;
  }
  
  .btn-group .btn:hover {
    transform: translateY(-1px);
  }
  
  .progress {
    background-color: #e2e8f0;
    border-radius: 8px;
  }
  
  .progress-bar {
    border-radius: 8px;
    transition: width 0.3s ease;
  }
  
  .btn-purple {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
    color: white;
  }
  
  .btn-purple:hover {
    background-color: #7c3aed;
    border-color: #7c3aed;
    color: white;
  }
  
  .diagnosis-note {
    background-color: #f8fafc;
    border-left: 3px solid #8b5cf6;
    padding: 8px 12px;
    border-radius: 6px;
  }
  
  .finding-badge {
    cursor: help;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-hide alerts after 5 seconds
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(alert => {
    setTimeout(() => {
      alert.style.transition = 'opacity 0.5s ease';
      alert.style.opacity = '0';
      setTimeout(() => {
        if (alert && alert.remove) alert.remove();
      }, 500);
    }, 5000);
  });
  
  // Smooth scroll to sections
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
  
  // Initialize tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
  
  // =====================================================
  // PHASE 7.5: ASSIGN MECHANIC FUNCTIONALITY
  // =====================================================

  // Single job assignment
  document.querySelectorAll('.assign-mechanic-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const jobId = this.dataset.jobId;
      const select = document.querySelector(`.mechanic-select[data-job-id="${jobId}"]`);
      const mechanicId = select.value;
      
      if (!mechanicId) {
        alert('Please select a mechanic');
        return;
      }
      
      if (confirm('Assign this job to the selected mechanic?')) {
        // Disable button to prevent double submission
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Assigning...';
        
        try {
          const response = await fetch(`/vmcott/workshop_supervisor/assign_approved_job/${jobId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ mechanic_id: mechanicId })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Show success message
            const row = document.getElementById(`job-row-${jobId}`);
            if (row) {
              row.style.backgroundColor = '#d1fae5';
              setTimeout(() => {
                location.reload();
              }, 500);
            } else {
              location.reload();
            }
          } else {
            alert(data.message);
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-person-plus me-1"></i> Assign';
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error assigning job: ' + error.message);
          this.disabled = false;
          this.innerHTML = '<i class="bi bi-person-plus me-1"></i> Assign';
        }
      }
    });
  });

  // Select all checkbox for approved jobs
  const selectAllCheckbox = document.getElementById('selectAllApprovedJobs');
  const jobCheckboxes = document.querySelectorAll('.job-select-checkbox');

  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', function() {
      jobCheckboxes.forEach(cb => cb.checked = this.checked);
    });
  }

  // Bulk assign
  const bulkAssignBtn = document.getElementById('bulkAssignBtn');
  if (bulkAssignBtn) {
    bulkAssignBtn.addEventListener('click', function() {
      const selectedJobs = Array.from(document.querySelectorAll('.job-select-checkbox:checked'))
        .map(cb => cb.value);
      
      const mechanicId = document.getElementById('bulkMechanicSelect').value;
      
      if (selectedJobs.length === 0) {
        alert('Please select at least one job');
        return;
      }
      
      if (!mechanicId) {
        alert('Please select a mechanic');
        return;
      }
      
      if (confirm(`Assign ${selectedJobs.length} job(s) to the selected mechanic?`)) {
        // Show loading on button
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Assigning...';
        
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/vmcott/workshop_supervisor/bulk_assign_jobs';
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = 'authenticity_token';
        tokenInput.value = document.querySelector('meta[name="csrf-token"]').content;
        form.appendChild(tokenInput);
        
        const mechanicInput = document.createElement('input');
        mechanicInput.type = 'hidden';
        mechanicInput.name = 'mechanic_id';
        mechanicInput.value = mechanicId;
        form.appendChild(mechanicInput);
        
        selectedJobs.forEach(jobId => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'job_ids[]';
          input.value = jobId;
          form.appendChild(input);
        });
        
        document.body.appendChild(form);
        form.submit();
      }
    });
  }
});
</script>