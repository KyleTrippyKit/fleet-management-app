<%# app/views/vmcott/workshop_supervisor/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">👨‍🔧 Welcome, <%= current_user.name %></h1>
      <p class="text-muted">VMCOTT Workshop Supervisor - Oversight</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Active Jobs</h5>
          <h2 class="display-4"><%= @active_jobs || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Pending Jobs</h5>
          <h2 class="display-4"><%= @pending_jobs || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Completed Today</h5>
          <h2 class="display-4"><%= @completed_today || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-danger text-white">
        <div class="card-body">
          <h5 class="card-title">Overdue Jobs</h5>
          <h2 class="display-4">0</h2>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h5>Workshop Activity</h5>
    </div>
    <div class="card-body">
      <p class="text-muted">Workshop Supervisor dashboard - full oversight features coming soon.</p>
      <div class="row mt-3">
        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body text-center">
              <h6>Technicians</h6>
              <h3>0</h3>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body text-center">
              <h6>Bay Utilization</h6>
              <h3>0%</h3>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body text-center">
              <h6>Avg. Repair Time</h6>
              <h3>0h</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>