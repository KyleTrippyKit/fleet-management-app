<%# app/views/vmcott/workshop_supervisor/job_creation.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">Create Jobs from Diagnosis</h1>
          <% if @inspection.present? %>
            <p class="text-muted mb-1">Inspection #<%= @inspection.id %> - <%= @inspection.vehicle.license_plate %></p>
            <p class="text-muted small">
              <i class="bi bi-person-badge me-1"></i>Inspector: <%= @inspection.inspector&.name || 'Unknown' %>
              <% if @inspection.diagnosis_completed_at %>
                <span class="ms-3 badge bg-success">
                  <i class="bi bi-check-circle me-1"></i>Diagnosis Completed: <%= @inspection.diagnosis_completed_at.strftime('%b %d, %Y at %I:%M %p') %>
                </span>
              <% end %>
            </p>
          <% else %>
            <p class="text-danger">Inspection not found</p>
          <% end %>
        </div>
        <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary rounded-pill" do %>
          <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        <% end %>
      </div>
    </div>
  </div>
  
  <% if @inspection.present? %>
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <%= form_with url: vmcott_workshop_supervisor_create_jobs_path(@inspection), 
                      method: :post, 
                      local: true,
                      data: { turbo: false } do |f| %>
          
          <!-- DIAGNOSIS SUMMARY SECTION -->
          <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-gradient-purple text-white border-0">
              <h5 class="mb-0">
                <i class="bi bi-stethoscope me-2"></i>
                Diagnosis Summary
              </h5>
            </div>
            <div class="card-body">
              <div class="alert alert-light border-start border-4 border-purple mb-3">
                <div class="d-flex align-items-start">
                  <i class="bi bi-chat-text fs-4 text-purple me-3"></i>
                  <div class="flex-grow-1">
                    <strong class="d-block mb-1">Mechanic's Diagnosis Notes:</strong>
                    <p class="mb-0"><%= @inspection.diagnosis_notes.presence || '<em class="text-muted">No diagnosis notes provided</em>'.html_safe %></p>
                    <% if @inspection.diagnosis_completed_at %>
                      <small class="text-muted mt-2 d-block">
                        <i class="bi bi-clock me-1"></i>Diagnosed at: <%= @inspection.diagnosis_completed_at.strftime('%b %d, %Y at %I:%M %p') %>
                        <% if @inspection.assigned_mechanic %>
                          <i class="bi bi-person ms-2 me-1"></i>Diagnosed by: <%= @inspection.assigned_mechanic.name %>
                        <% end %>
                      </small>
                    <% end %>
                  </div>
                </div>
              </div>
              
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="bg-light rounded-3 p-3 text-center">
                    <i class="bi bi-clipboard-check fs-3 text-primary"></i>
                    <h3 class="mb-0 mt-2"><%= @inspector_recommendations&.count || 0 %></h3>
                    <small class="text-muted">Inspector Recommendations</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="bg-light rounded-3 p-3 text-center">
                    <i class="bi bi-wrench fs-3 text-warning"></i>
                    <h3 class="mb-0 mt-2"><%= @mechanic_findings&.count || 0 %></h3>
                    <small class="text-muted">Mechanic Findings</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="bg-light rounded-3 p-3 text-center">
                    <i class="bi bi-briefcase fs-3 text-success"></i>
                    <h3 class="mb-0 mt-2"><%= @inspection.inspection_jobs.count %></h3>
                    <small class="text-muted">Jobs Created</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- INSPECTOR'S RECOMMENDATIONS SECTION -->
          <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">
                <i class="bi bi-clipboard2-pulse me-2"></i>
                Phase 2: Inspector's Findings & Recommendations
              </h5>
            </div>
            <div class="card-body">
              <!-- Inspector's Original Notes -->
              <div class="alert alert-info mb-3">
                <div class="d-flex align-items-start">
                  <i class="bi bi-file-text fs-5 me-3"></i>
                  <div>
                    <strong class="d-block mb-1">Inspector's Notes:</strong>
                    <p class="mb-0"><%= @inspection.notes.presence || '<em class="text-muted">No notes provided</em>'.html_safe %></p>
                  </div>
                </div>
              </div>
              
              <!-- Inspector Recommendations -->
              <% if @inspector_recommendations.present? && @inspector_recommendations.any? %>
                <h6 class="fw-bold mt-3 text-primary">
                  <i class="bi bi-list-check me-2"></i>Inspector's Recommendations
                </h6>
                <div class="list-group mb-3">
                  <% @inspector_recommendations.each do |rec| %>
                    <div class="list-group-item list-group-item-action">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                          <div class="d-flex justify-content-between">
                            <strong><%= rec.description %></strong>
                            <span class="badge bg-<%= rec.priority == 'high' ? 'warning' : (rec.priority == 'critical' ? 'danger' : 'secondary') %>">
                              <i class="bi bi-flag-fill me-1"></i><%= rec.priority&.humanize || 'Normal' %>
                            </span>
                          </div>
                          <% if rec.notes.present? %>
                            <p class="small text-muted mt-1 mb-1"><%= rec.notes %></p>
                          <% end %>
                          <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>Est. Hours: <%= rec.estimated_hours || 'TBD' %>
                            <i class="bi bi-person ms-2 me-1"></i>Suggested by: <%= rec.suggested_by&.name || 'Inspector' %>
                          </small>
                        </div>
                      </div>
                      <div class="mt-2">
                        <div class="form-check form-switch">
                          <input type="checkbox" 
                                 name="inspector_recommendations[<%= rec.id %>][include]" 
                                 value="true" 
                                 class="form-check-input"
                                 id="include_rec_<%= rec.id %>"
                                 checked>
                          <label class="form-check-label small" for="include_rec_<%= rec.id %>">
                            <i class="bi bi-check-circle me-1"></i>Include this recommendation in job creation
                          </label>
                        </div>
                        <input type="hidden" name="inspector_recommendations[<%= rec.id %>][description]" value="<%= rec.description %>">
                        <input type="hidden" name="inspector_recommendations[<%= rec.id %>][priority]" value="<%= rec.priority %>">
                        <input type="hidden" name="inspector_recommendations[<%= rec.id %>][estimated_hours]" value="<%= rec.estimated_hours || 1 %>">
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="alert alert-secondary">
                  <i class="bi bi-info-circle me-2"></i>
                  No inspector recommendations found for this inspection.
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- MECHANIC DIAGNOSIS FINDINGS SECTION -->
          <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-warning text-dark">
              <h5 class="mb-0">
                <i class="bi bi-wrench me-2"></i>
                Phase 3: Mechanic Diagnosis Findings
              </h5>
            </div>
            <div class="card-body">
              <!-- Mechanic's Diagnosis Notes -->
              <div class="alert alert-warning mb-3">
                <div class="d-flex align-items-start">
                  <i class="bi bi-chat-quote fs-5 me-3"></i>
                  <div class="flex-grow-1">
                    <strong class="d-block mb-1">Mechanic's Diagnosis Notes:</strong>
                    <p class="mb-0"><%= @inspection.diagnosis_notes.presence || '<em class="text-muted">No diagnosis notes provided</em>'.html_safe %></p>
                  </div>
                </div>
              </div>
              
              <h6 class="fw-bold mt-3 text-warning">
                <i class="bi bi-tools me-2"></i>Diagnosis Findings (<%= @mechanic_findings.count %>)
              </h6>
              
              <% if @mechanic_findings.present? && @mechanic_findings.any? %>
                <div class="list-group mb-3">
                  <% @mechanic_findings.each do |finding| %>
                    <div class="list-group-item list-group-item-action">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                          <div class="d-flex justify-content-between">
                            <strong><%= finding.description %></strong>
                            <div>
                              <span class="badge bg-<%= finding.severity == 'critical' ? 'danger' : (finding.severity == 'major' ? 'warning' : 'info') %> me-1">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i><%= finding.severity&.humanize || 'Normal' %>
                              </span>
                              <% if finding.blocking %>
                                <span class="badge bg-danger">
                                  <i class="bi bi-ban me-1"></i>Blocking
                                </span>
                              <% end %>
                            </div>
                          </div>
                          <% if finding.notes.present? %>
                            <p class="small text-muted mt-1 mb-1"><%= finding.notes %></p>
                          <% end %>
                          <div class="small text-muted mt-2">
                            <i class="bi bi-person me-1"></i>Found by: <%= finding.created_by&.name || 'Mechanic' %>
                            <% if finding.metadata&.[]('root_cause').present? %>
                              <span class="ms-2"><i class="bi bi-diagram-3 me-1"></i>Root Cause: <%= finding.metadata['root_cause'] %></span>
                            <% end %>
                          </div>
                          <div class="small text-muted">
                            <% if finding.metadata&.[]('estimated_hours').present? %>
                              <i class="bi bi-clock me-1"></i>Est. Hours: <%= finding.metadata['estimated_hours'] %>
                            <% end %>
                            <% if finding.metadata&.[]('complexity').present? %>
                              <span class="ms-2"><i class="bi bi-speedometer2 me-1"></i>Complexity: <%= finding.metadata['complexity']&.humanize %></span>
                            <% end %>
                            <% if finding.metadata&.[]('suggested_parts').present? %>
                              <div class="mt-1">
                                <i class="bi bi-box-seam me-1"></i>Suggested Parts: 
                                <span class="text-info"><%= finding.metadata['suggested_parts'] %></span>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                      <div class="mt-2 pt-2 border-top">
                        <div class="form-check form-switch">
                          <input type="checkbox" 
                                 name="mechanic_findings[<%= finding.id %>][include]" 
                                 value="true" 
                                 class="form-check-input"
                                 id="include_finding_<%= finding.id %>"
                                 checked>
                          <label class="form-check-label small" for="include_finding_<%= finding.id %>">
                            <i class="bi bi-check-circle me-1"></i>Create job from this finding
                          </label>
                        </div>
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][description]" value="<%= finding.description %>">
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][priority]" value="<%= finding.priority %>">
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][estimated_hours]" value="<%= finding.metadata&.[]('estimated_hours') || 1 %>">
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="alert alert-secondary">
                  <i class="bi bi-info-circle me-2"></i>
                  No mechanic findings found for this inspection.
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- NO FINDINGS MESSAGE -->
          <% if @inspector_recommendations.blank? && @mechanic_findings.blank? %>
            <div class="card mb-4 border-0 shadow-sm">
              <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">No Findings Available</h5>
              </div>
              <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                <p>No inspector recommendations or mechanic findings found for this inspection.</p>
                <p class="small text-muted">You can still create custom jobs below.</p>
              </div>
            </div>
          <% end %>
          
          <!-- Custom Jobs Section -->
          <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-secondary text-white">
              <h5 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i>
                Create Custom Jobs (Optional)
              </h5>
            </div>
            <div class="card-body">
              <div id="jobs-container">
                <div class="job-item mb-3 border p-3 rounded bg-light">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Job Description *</label>
                      <input type="text" 
                             name="jobs[][description]" 
                             class="form-control" 
                             placeholder="e.g., Replace brake pads, Engine diagnostic..."
                             required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small fw-bold">Est. Hours</label>
                      <input type="number" 
                             name="jobs[][estimated_hours]" 
                             class="form-control" 
                             placeholder="Hours"
                             step="0.5"
                             value="1">
                    </div>
                    <div class="col-md-2">
                      <label class="form-label small fw-bold">Priority</label>
                      <select name="jobs[][priority]" class="form-select">
                        <option value="low">Low</option>
                        <option value="normal" selected>Normal</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                      </select>
                    </div>
                    <div class="col-md-1">
                      <label class="form-label small">&nbsp;</label>
                      <button type="button" class="btn btn-danger btn-sm remove-job-btn w-100" style="display: none;">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </div>
                  <div class="row mt-2">
                    <div class="col-md-12">
                      <label class="form-label small">Assign Mechanic (Optional - overrides default)</label>
                      <select name="jobs[][mechanic_id]" class="form-select job-mechanic-select">
                        <option value="">Use Default Mechanic</option>
                        <% @mechanics.each do |mechanic| %>
                          <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                        <% end %>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-primary mt-2 rounded-pill" id="add-job-btn">
                <i class="bi bi-plus-circle me-1"></i> Add Another Custom Job
              </button>
              <small class="text-muted d-block mt-2">
                <i class="bi bi-info-circle me-1"></i>
                Custom jobs are in addition to the selected recommendations/findings above.
              </small>
            </div>
          </div>
          
          <!-- Assign Mechanic Section -->
          <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-info text-white">
              <h5 class="mb-0">
                <i class="bi bi-person-gear me-2"></i>
                Assign Mechanics
              </h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <label class="form-label fw-bold">
                    <i class="bi bi-person-check me-1"></i>Default Mechanic for All Jobs
                  </label>
                  <select name="default_mechanic_id" class="form-select" id="default-mechanic">
                    <option value="">-- Select a Mechanic --</option>
                    <% @mechanics.each do |mechanic| %>
                      <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                    <% end %>
                  </select>
                  <small class="text-muted mt-1 d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    This mechanic will be assigned to all jobs unless overridden per job above.
                  </small>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Form Actions -->
          <div class="d-flex justify-content-between mt-4">
            <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary rounded-pill px-4" do %>
              <i class="bi bi-x-circle me-1"></i> Cancel
            <% end %>
            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5">
              <i class="bi bi-check-circle me-2"></i>Create Jobs & Request Parts
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body text-center py-5">
            <i class="bi bi-exclamation-triangle fs-1 text-danger mb-3 d-block"></i>
            <h4>Inspection Not Found</h4>
            <p class="text-muted">The inspection you're looking for doesn't exist or has been removed.</p>
            <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-primary rounded-pill mt-3" do %>
              <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .bg-gradient-purple {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  }
  
  .border-purple {
    border-color: #8b5cf6 !important;
  }
  
  .text-purple {
    color: #8b5cf6 !important;
  }
  
  .btn-purple {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
  }
  
  .btn-purple:hover {
    background-color: #7c3aed;
    border-color: #7c3aed;
  }
  
  .form-switch .form-check-input:checked {
    background-color: #10b981;
    border-color: #10b981;
  }
  
  .list-group-item {
    transition: all 0.2s ease;
  }
  
  .list-group-item:hover {
    background-color: #f8fafc;
    transform: translateX(4px);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('jobs-container');
  const addBtn = document.getElementById('add-job-btn');
  const defaultMechanicSelect = document.getElementById('default-mechanic');
  
  function updateRemoveButtons() {
    const items = container.querySelectorAll('.job-item');
    items.forEach((item, index) => {
      const removeBtn = item.querySelector('.remove-job-btn');
      
      if (items.length > 1) {
        removeBtn.style.display = 'block';
        removeBtn.onclick = () => item.remove();
      } else {
        removeBtn.style.display = 'none';
      }
    });
  }
  
  if (addBtn) {
    addBtn.addEventListener('click', function() {
      const newItem = document.createElement('div');
      newItem.className = 'job-item mb-3 border p-3 rounded bg-light';
      newItem.innerHTML = `
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small fw-bold">Job Description *</label>
            <input type="text" name="jobs[][description]" class="form-control" placeholder="e.g., Replace brake pads, Engine diagnostic..." required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Est. Hours</label>
            <input type="number" name="jobs[][estimated_hours]" class="form-control" placeholder="Hours" step="0.5" value="1">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-bold">Priority</label>
            <select name="jobs[][priority]" class="form-select">
              <option value="low">Low</option>
              <option value="normal" selected>Normal</option>
              <option value="high">High</option>
              <option value="critical">Critical</option>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label small">&nbsp;</label>
            <button type="button" class="btn btn-danger btn-sm remove-job-btn w-100">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-md-12">
            <label class="form-label small">Assign Mechanic (Optional - overrides default)</label>
            <select name="jobs[][mechanic_id]" class="form-select job-mechanic-select">
              <option value="">Use Default Mechanic</option>
              <% @mechanics.each do |mechanic| %>
                <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
              <% end %>
            </select>
          </div>
        </div>
      `;
      container.appendChild(newItem);
      updateRemoveButtons();
      
      // Auto-scroll to new item
      newItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
  
  // Auto-update mechanic selects when default changes
  if (defaultMechanicSelect) {
    defaultMechanicSelect.addEventListener('change', function() {
      const mechanicSelects = document.querySelectorAll('.job-mechanic-select');
      mechanicSelects.forEach(select => {
        if (select.value === '') {
          select.style.borderColor = '#10b981';
          setTimeout(() => {
            select.style.borderColor = '';
          }, 500);
        }
      });
    });
  }
  
  updateRemoveButtons();
  
  // Add tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
});
</script>