<%# app/views/vmcott/workshop_supervisor/job_creation.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">Review Job Recommendations</h1>
          <% if @inspection.present? %>
            <p class="text-muted">Inspection #<%= @inspection.id %> - <%= @inspection.vehicle.license_plate %></p>
            <p class="text-muted">
              Inspector: <%= @inspection.inspector&.name || 'Unknown' %>
              <% if @inspection.diagnosis_completed_at %>
                <span class="ms-3 badge bg-success">Diagnosis Completed: <%= @inspection.diagnosis_completed_at.strftime('%b %d, %Y') %></span>
              <% end %>
            </p>
          <% else %>
            <p class="text-danger">Inspection not found</p>
          <% end %>
        </div>
        <%= link_to "Back to Dashboard", vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
  
  <% if @inspection.present? %>
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <%= form_with url: vmcott_workshop_supervisor_create_jobs_path(@inspection), 
                      method: :post, 
                      local: true,
                      data: { turbo: false } do |f| %>
          
          <!-- INSPECTOR'S RECOMMENDATIONS SECTION -->
          <div class="card mb-4">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">
                <i class="bi bi-clipboard-check me-2"></i>
                Inspector's Findings & Recommendations
              </h5>
            </div>
            <div class="card-body">
              <div class="alert alert-info mb-3">
                <strong>Inspector's Notes:</strong>
                <p class="mb-0 mt-2"><%= @inspection.notes || 'No notes provided' %></p>
              </div>
              
              <!-- Inspector Recommendations -->
              <% if @inspector_recommendations.present? && @inspector_recommendations.any? %>
                <h6 class="fw-bold mt-3 text-primary">Inspector's Recommendations</h6>
                <div class="list-group mb-3">
                  <% @inspector_recommendations.each do |rec| %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between">
                        <strong><%= rec.description %></strong>
                        <span class="badge bg-<%= rec.priority == 'high' ? 'warning' : (rec.priority == 'critical' ? 'danger' : 'secondary') %>">
                          <%= rec.priority&.humanize || 'Normal' %>
                        </span>
                      </div>
                      <small class="text-muted">
                        Est. Hours: <%= rec.estimated_hours || 'TBD' %>
                      </small>
                      <div class="mt-2">
                        <div class="form-check">
                          <input type="checkbox" 
                                 name="inspector_recommendations[<%= rec.id %>][include]" 
                                 value="true" 
                                 class="form-check-input"
                                 id="include_rec_<%= rec.id %>"
                                 checked>
                          <label class="form-check-label small" for="include_rec_<%= rec.id %>">
                            Include in job creation
                          </label>
                        </div>
                        <input type="hidden" name="inspector_recommendations[<%= rec.id %>][description]" value="<%= rec.description %>">
                        <input type="hidden" name="inspector_recommendations[<%= rec.id %>][estimated_hours]" value="<%= rec.estimated_hours || 1 %>">
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="alert alert-secondary">
                  <i class="bi bi-info-circle me-2"></i>
                  No inspector recommendations found.
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- MECHANIC DIAGNOSIS FINDINGS SECTION -->
          <% if @mechanic_findings.present? && @mechanic_findings.any? %>
            <div class="card mb-4 border-warning">
              <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                  <i class="bi bi-wrench me-2"></i>
                  Mechanic Diagnosis Findings
                </h5>
              </div>
              <div class="card-body">
                <div class="alert alert-warning mb-3">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <strong>Mechanic's Diagnosis Notes:</strong>
                  <p class="mb-0 mt-2"><%= @inspection.diagnosis_notes || 'No diagnosis notes provided' %></p>
                </div>
                
                <h6 class="fw-bold mt-3 text-warning">Diagnosis Findings (<%= @mechanic_findings.count %>)</h6>
                <div class="list-group mb-3">
                  <% @mechanic_findings.each do |finding| %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                          <div class="d-flex justify-content-between">
                            <strong><%= finding.description %></strong>
                            <span class="badge bg-<%= finding.priority == 'high' ? 'warning' : (finding.priority == 'critical' ? 'danger' : 'secondary') %>">
                              <%= finding.priority&.humanize || 'Normal' %>
                            </span>
                          </div>
                          <% if finding.notes.present? %>
                            <p class="small text-muted mt-1 mb-1"><%= finding.notes %></p>
                          <% end %>
                          <small class="text-muted">
                            <i class="bi bi-person me-1"></i>Found by: <%= finding.created_by&.name || 'Mechanic' %>
                            <% if finding.metadata&.[]('estimated_hours').present? %>
                              • <i class="bi bi-clock me-1"></i>Est. Hours: <%= finding.metadata['estimated_hours'] %>
                            <% end %>
                            <% if finding.metadata&.[]('root_cause').present? %>
                              • <i class="bi bi-diagram-3 me-1"></i>Root Cause: <%= finding.metadata['root_cause'] %>
                            <% end %>
                            <% if finding.metadata&.[]('complexity').present? %>
                              • <i class="bi bi-speedometer2 me-1"></i>Complexity: <%= finding.metadata['complexity'] %>
                            <% end %>
                          </small>
                        </div>
                      </div>
                      <div class="mt-2">
                        <div class="form-check">
                          <input type="checkbox" 
                                 name="mechanic_findings[<%= finding.id %>][include]" 
                                 value="true" 
                                 class="form-check-input"
                                 id="include_finding_<%= finding.id %>"
                                 checked>
                          <label class="form-check-label small" for="include_finding_<%= finding.id %>">
                            Include in job creation
                          </label>
                        </div>
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][description]" value="<%= finding.description %>">
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][priority]" value="<%= finding.priority %>">
                        <input type="hidden" name="mechanic_findings[<%= finding.id %>][estimated_hours]" value="<%= finding.metadata&.[]('estimated_hours') || 1 %>">
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          
          <!-- NO FINDINGS MESSAGE -->
          <% if @inspector_recommendations.blank? && @mechanic_findings.blank? %>
            <div class="card mb-4">
              <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">No Findings Available</h5>
              </div>
              <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                <p>No inspector recommendations or mechanic findings found for this inspection.</p>
                <p class="small text-muted">You can still create custom jobs below.</p>
              </div>
            </div>
          <% end %>
          
          <!-- Custom Jobs Section -->
          <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
              <h5 class="mb-0">Create Custom Jobs</h5>
            </div>
            <div class="card-body">
              <div id="jobs-container">
                <div class="job-item mb-3 border p-3 rounded">
                  <div class="row">
                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Job Description *</label>
                      <input type="text" 
                             name="jobs[][description]" 
                             class="form-control" 
                             placeholder="e.g., Replace brake pads, Engine diagnostic..."
                             required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small fw-bold">Est. Hours</label>
                      <input type="number" 
                             name="jobs[][estimated_hours]" 
                             class="form-control" 
                             placeholder="Hours"
                             step="0.5">
                    </div>
                    <div class="col-md-2">
                      <label class="form-label small fw-bold">Priority</label>
                      <select name="jobs[][priority]" class="form-select">
                        <option value="low">Low</option>
                        <option value="normal" selected>Normal</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                      </select>
                    </div>
                    <div class="col-md-1">
                      <label class="form-label small">&nbsp;</label>
                      <button type="button" class="btn btn-danger btn-sm remove-job-btn w-100" style="display: none;">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="add-job-btn">
                <i class="bi bi-plus-circle"></i> Add Another Job
              </button>
            </div>
          </div>
          
          <!-- Assign Mechanic Section -->
          <div class="card mb-4">
            <div class="card-header bg-info text-white">
              <h5 class="mb-0">Assign Mechanics</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Default Mechanic for All Jobs</label>
                  <select name="assigned_mechanic_id" class="form-select" id="default-mechanic">
                    <option value="">Select Mechanic</option>
                    <% @mechanics.each do |mechanic| %>
                      <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                    <% end %>
                  </select>
                  <small class="text-muted">You can assign specific mechanics per job below</small>
                </div>
              </div>
            </div>
          </div>
          
          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary px-4" %>
            <button type="submit" class="btn btn-success btn-lg px-5">
              <i class="bi bi-check-circle me-2"></i>Create Jobs & Request Parts
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body text-center py-5">
            <i class="bi bi-exclamation-triangle fs-1 text-danger mb-3 d-block"></i>
            <h4>Inspection Not Found</h4>
            <p class="text-muted">The inspection you're looking for doesn't exist or has been removed.</p>
            <%= link_to "Return to Dashboard", vmcott_workshop_supervisor_dashboard_path, class: "btn btn-primary rounded-pill mt-3" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('jobs-container');
  const addBtn = document.getElementById('add-job-btn');
  const defaultMechanicSelect = document.getElementById('default-mechanic');
  
  function updateRemoveButtons() {
    const items = container.querySelectorAll('.job-item');
    items.forEach((item, index) => {
      const removeBtn = item.querySelector('.remove-job-btn');
      const mechanicSelect = item.querySelector('.job-mechanic-select');
      
      if (items.length > 1) {
        removeBtn.style.display = 'block';
        removeBtn.onclick = () => item.remove();
      } else {
        removeBtn.style.display = 'none';
      }
      
      // Add mechanic select to each job if not present
      if (!mechanicSelect && items.length > 0) {
        const mechanicCol = item.querySelector('.col-md-2:last-child');
        if (mechanicCol) {
          const selectHtml = `
            <div class="mt-2">
              <label class="form-label small">Assign Mechanic</label>
              <select name="jobs[][mechanic_id]" class="form-select job-mechanic-select">
                <option value="">Use Default</option>
                <% @mechanics.each do |mechanic| %>
                  <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                <% end %>
              </select>
            </div>
          `;
          mechanicCol.insertAdjacentHTML('afterend', selectHtml);
        }
      }
    });
  }
  
  if (addBtn) {
    addBtn.addEventListener('click', function() {
      const newItem = document.createElement('div');
      newItem.className = 'job-item mb-3 border p-3 rounded';
      newItem.innerHTML = `
        <div class="row">
          <div class="col-md-6">
            <label class="form-label small fw-bold">Job Description *</label>
            <input type="text" name="jobs[][description]" class="form-control" placeholder="e.g., Replace brake pads, Engine diagnostic..." required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Est. Hours</label>
            <input type="number" name="jobs[][estimated_hours]" class="form-control" placeholder="Hours" step="0.5">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-bold">Priority</label>
            <select name="jobs[][priority]" class="form-select">
              <option value="low">Low</option>
              <option value="normal" selected>Normal</option>
              <option value="high">High</option>
              <option value="critical">Critical</option>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label small">&nbsp;</label>
            <button type="button" class="btn btn-danger btn-sm remove-job-btn w-100">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-md-12">
            <label class="form-label small">Assign Mechanic (Optional)</label>
            <select name="jobs[][mechanic_id]" class="form-select job-mechanic-select">
              <option value="">Use Default</option>
              <% @mechanics.each do |mechanic| %>
                <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
              <% end %>
            </select>
          </div>
        </div>
      `;
      container.appendChild(newItem);
      updateRemoveButtons();
    });
  }
  
  updateRemoveButtons();
});
</script>