<%# app/views/vmcott/workshop_supervisor/job_creation.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">Create Jobs</h1>
          <% if @inspection.present? %>
            <p class="text-muted small mb-0">
              <strong><%= @inspection.vehicle.license_plate %></strong> — 
              <%= @inspection.vehicle.make %> <%= @inspection.vehicle.model %>
            </p>
          <% end %>
        </div>
        <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary btn-sm rounded-pill" do %>
          <i class="bi bi-arrow-left me-1"></i> Back
        <% end %>
      </div>
    </div>
  </div>
  
  <% if @inspection.present? %>
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <%= form_with url: vmcott_workshop_supervisor_create_jobs_path(@inspection), 
                      method: :post, 
                      local: true,
                      data: { turbo: false },
                      id: "job-creation-form" do |f| %>
          
          <!-- REFERENCE PANEL -->
          <div class="card mb-3 border-0 shadow-sm">
            <div class="card-header bg-light py-2" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#referencePanel">
              <i class="bi bi-info-circle me-1"></i>
              <strong>Reference: Inspector & Mechanic Notes</strong>
              <small class="text-muted ms-2">(click to expand)</small>
            </div>
            <div class="collapse" id="referencePanel">
              <div class="card-body bg-light">
                <% if @inspection.diagnosis_notes.present? %>
                  <div class="mb-3">
                    <small class="text-muted">Mechanic's notes:</small>
                    <div class="small bg-white p-2 rounded mt-1"><%= @inspection.diagnosis_notes %></div>
                  </div>
                <% end %>
                
                <% if @inspector_recommendations.present? && @inspector_recommendations.any? %>
                  <div class="mb-3">
                    <small class="text-primary">Inspector suggested:</small>
                    <% @inspector_recommendations.each do |rec| %>
                      <div class="small bg-white p-2 rounded mt-1 border-start border-3 border-primary">
                        <strong><%= rec.description %></strong>
                        <span class="badge bg-secondary ms-2"><%= rec.estimated_hours %> hrs</span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
                
                <% if @mechanic_findings.present? && @mechanic_findings.any? %>
                  <div>
                    <small class="text-warning">Mechanic found:</small>
                    <% @mechanic_findings.each do |finding| %>
                      <div class="small bg-white p-2 rounded mt-1 border-start border-3 border-warning">
                        <strong><%= finding.description %></strong>
                        <span class="badge bg-secondary ms-2"><%= finding.metadata&.[]('estimated_hours') || 1 %> hrs</span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- JOBS LIST -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                  <i class="bi bi-list-check me-2 text-success"></i>
                  Jobs to Create
                </h5>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="add-job-btn">
                  <i class="bi bi-plus-lg me-1"></i> Add Job
                </button>
              </div>
            </div>
            <div class="card-body">
              <div id="jobs-list">
                <div class="text-center text-muted py-4" id="empty-jobs-message">
                  <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
                  <p class="mb-0 small">No jobs yet. Click "Add Job" to create one.</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- JOB PREVIEW & ACTIONS -->
          <div class="row mt-3">
            <div class="col-md-6">
              <div class="card border-0 shadow-sm">
                <div class="card-body py-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <span class="text-muted small">Total Jobs:</span>
                      <span class="fs-4 fw-bold text-success ms-2" id="preview-total-jobs">0</span>
                    </div>
                    <div>
                      <span class="text-muted small">Total Hours:</span>
                      <span class="fs-4 fw-bold text-primary ms-2" id="preview-total-hours">0</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm">
                <div class="card-body py-3">
                  <div class="d-flex gap-2">
                    <select name="default_mechanic_id" class="form-select form-select-sm" id="default-mechanic" style="width: auto;">
                      <option value="">-- No default mechanic --</option>
                      <% @mechanics.each do |mechanic| %>
                        <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
                      <% end %>
                    </select>
                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-4" id="create-jobs-btn" disabled>
                      <i class="bi bi-check-lg me-1"></i> Create Jobs
                    </button>
                    <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-outline-secondary btn-sm rounded-pill" do %>
                      Cancel
                    <% end %>
                  </div>
                  <small class="text-muted d-block mt-2">
                    <i class="bi bi-info-circle me-1"></i>
                    After creating jobs, you'll add parts and pricing in the Quotation Builder.
                  </small>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="alert alert-danger">Inspection not found.</div>
  <% end %>
</div>

<style>
  .job-item {
    transition: all 0.2s ease;
  }
  .job-item:hover {
    background-color: #f8f9fa;
  }
  .remove-job-btn {
    cursor: pointer;
  }
  .remove-job-btn:hover {
    background-color: #dc2626;
    color: white;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const jobsList = document.getElementById('jobs-list');
  const addBtn = document.getElementById('add-job-btn');
  const defaultMechanicSelect = document.getElementById('default-mechanic');
  const createBtn = document.getElementById('create-jobs-btn');
  const totalHoursSpan = document.getElementById('preview-total-hours');
  const totalJobsSpan = document.getElementById('preview-total-jobs');
  const emptyJobsMessage = document.getElementById('empty-jobs-message');
  
  let jobCounter = 0;
  
  function updatePreview() {
    const jobItems = document.querySelectorAll('.job-item');
    let totalHours = 0;
    const jobs = [];
    
    jobItems.forEach(item => {
      const descInput = item.querySelector('.job-desc');
      const hoursInput = item.querySelector('.job-hours');
      
      if (descInput && descInput.value.trim() !== '') {
        const hours = parseFloat(hoursInput?.value) || 1;
        totalHours += hours;
        jobs.push({ description: descInput.value.trim(), hours: hours });
      }
    });
    
    if (totalJobsSpan) totalJobsSpan.innerText = jobs.length;
    if (totalHoursSpan) totalHoursSpan.innerText = totalHours.toFixed(1);
    
    if (emptyJobsMessage) {
      emptyJobsMessage.style.display = jobs.length === 0 ? 'block' : 'none';
    }
    
    if (createBtn) {
      createBtn.disabled = jobs.length === 0;
    }
  }
  
  function addNewJob() {
    const newId = Date.now() + jobCounter++;
    const newItem = document.createElement('div');
    newItem.className = 'job-item border rounded p-3 mb-2 bg-white';
    newItem.setAttribute('data-job-id', newId);
    newItem.innerHTML = `
      <div class="row g-2">
        <div class="col-md-6">
          <input type="text" 
                 name="jobs[][description]" 
                 class="form-control form-control-sm job-desc" 
                 placeholder="Job description..."
                 required>
        </div>
        <div class="col-md-2">
          <input type="number" 
                 name="jobs[][estimated_hours]" 
                 class="form-control form-control-sm job-hours" 
                 placeholder="Hrs"
                 step="0.5"
                 value="1"
                 style="width: 80px;">
        </div>
        <div class="col-md-2">
          <select name="jobs[][priority]" class="form-select form-select-sm job-priority">
            <option value="low">Low</option>
            <option value="normal" selected>Normal</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
        </div>
        <div class="col-md-2 text-end">
          <button type="button" class="btn btn-sm btn-outline-danger remove-job-btn" style="border: none;">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </div>
      <div class="row mt-2">
        <div class="col-md-12">
          <select name="jobs[][mechanic_id]" class="form-select form-select-sm job-mechanic-select">
            <option value="">-- No mechanic --</option>
            <% @mechanics.each do |mechanic| %>
              <option value="<%= mechanic.id %>"><%= mechanic.name %></option>
            <% end %>
          </select>
        </div>
      </div>
    `;
    
    if (jobsList) {
      jobsList.appendChild(newItem);
      
      const descInput = newItem.querySelector('.job-desc');
      const hoursInput = newItem.querySelector('.job-hours');
      const removeBtn = newItem.querySelector('.remove-job-btn');
      
      if (descInput) descInput.addEventListener('input', updatePreview);
      if (hoursInput) hoursInput.addEventListener('input', updatePreview);
      
      if (removeBtn) {
        removeBtn.addEventListener('click', () => {
          newItem.remove();
          updatePreview();
        });
      }
    }
    
    updatePreview();
    newItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  
  if (addBtn) {
    addBtn.addEventListener('click', addNewJob);
  }
  
  updatePreview();
  addNewJob();
});
</script>