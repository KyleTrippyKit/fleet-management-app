<div class="min-h-screen bg-gray-100 pb-24">
  <div class="bg-white shadow p-4">
    <div class="flex justify-between items-center">
      <div>
        <%= link_to "← Back to Dashboard", vmcott_workshop_supervisor_dashboard_path, class: "text-blue-600 hover:underline text-sm" %>
        <h1 class="text-xl font-bold mt-2">Mechanics</h1>
      </div>
    </div>
  </div>

  <div class="p-4">
    <% if @mechanics.present? %>
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Active Tasks</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pre-Checks</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Completed Today</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @mechanics.each do |mechanic| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= mechanic.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= @task_counts[mechanic.id] || 0 %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= @pre_check_counts[mechanic.id] || 0 %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= @completed_today[mechanic.id] || 0 %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-white rounded-xl shadow p-8 text-center">
        <p class="text-gray-500">No mechanics found.</p>
      </div>
    <% end %>
  </div>
</div>