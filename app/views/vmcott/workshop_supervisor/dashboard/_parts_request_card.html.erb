<%# app/views/vmcott/workshop_supervisor/dashboard/_parts_request_card.html.erb %>
<div class="bg-white rounded-xl shadow p-4 mb-3">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <h3 class="font-semibold text-gray-800">
        <%= request.part&.name || request.custom_part_name %>
      </h3>
      <p class="text-sm text-gray-600 mt-1">
        Quantity: <%= request.quantity %>
      </p>
      <p class="text-sm text-gray-500 mt-1">
        For: <%= request.inspection.vehicle.license_plate %>
      </p>
      <div class="flex flex-wrap gap-2 mt-2 text-xs text-gray-500">
        <span>Requested by: <%= request.inspection_job&.assigned_mechanic&.name %></span>
        <span>In stock: <%= request.in_stock ? 'Yes' : 'No' %></span>
      </div>
    </div>
    <span class="text-xs px-2 py-1 rounded bg-purple-100 text-purple-800">
      PENDING
    </span>
  </div>
  
  <div class="mt-3 flex gap-2">
    <%= button_to "Approve", "#", class: "bg-green-500 text-white px-3 py-1 rounded-lg text-sm", disabled: true %>
    <%= button_to "Send to Procurement", "#", class: "bg-blue-500 text-white px-3 py-1 rounded-lg text-sm", disabled: true %>
  </div>
  <p class="text-xs text-gray-400 mt-2">Parts requests are handled by Inventory Manager</p>
</div>