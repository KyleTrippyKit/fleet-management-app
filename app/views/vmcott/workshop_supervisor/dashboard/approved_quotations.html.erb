<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0">✅ Phase 6.5: Customer Approved Quotations</h4>
      <small class="text-muted">Review and send approved items to inventory</small>
    </div>
    <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "btn btn-sm btn-outline-secondary" do %>
      ← Back to Dashboard
    <% end %>
  </div>

  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body py-2">
          <h6 class="mb-0">Total Approved</h6>
          <h3 class="mb-0"><%= @stats[:total] %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body py-2">
          <h6 class="mb-0">Fully Accepted</h6>
          <h3 class="mb-0"><%= @stats[:fully_accepted] %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body py-2">
          <h6 class="mb-0">Partially Rejected</h6>
          <h3 class="mb-0"><%= @stats[:partially_rejected] %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body py-2">
          <h6 class="mb-0">Pending Inventory</h6>
          <h3 class="mb-0"><%= @stats[:pending_inventory] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotations List -->
  <div class="card shadow-sm">
    <div class="card-header bg-light">
      <h6 class="mb-0">Approved Quotations</h6>
    </div>
    <div class="card-body p-0">
      <% if @approved_quotations.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Quote #</th>
                <th>Vehicle</th>
                <th>Approved Amount</th>
                <th>Status</th>
                <th>Approved At</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @approved_quotations.each do |quotation| %>
                <tr>
                  <td><strong><%= quotation.quote_number %></strong></td>
                  <td>
                    <%= quotation.vehicle&.license_plate %><br>
                    <small class="text-muted"><%= quotation.vehicle&.make %> <%= quotation.vehicle&.model %></small>
                  </td>
                  <td class="text-success fw-bold">$<%= '%.2f' % quotation.amount %></td>
                  <td>
                    <% if quotation.status == 'accepted' %>
                      <span class="badge bg-success">Fully Accepted</span>
                    <% else %>
                      <span class="badge bg-warning">Partially Rejected</span>
                    <% end %>
                  </td>
                  <td><%= quotation.accepted_at&.strftime("%b %d, %Y") || 'N/A' %></td>
                  <td class="text-center">
                    <%= link_to "Review", vmcott_workshop_supervisor_approved_quotation_details_path(quotation), 
                                class: "btn btn-sm btn-primary rounded-pill" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= paginate @approved_quotations %>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
          <h6>No approved quotations</h6>
          <p class="small mb-0">Customer approvals will appear here</p>
        </div>
      <% end %>
    </div>
  </div>
</div>