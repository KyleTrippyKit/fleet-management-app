<%# app/views/vmcott/workshop_supervisor/dashboard/_work_order_card.html.erb %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-3">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
          Work Order #<%= work_order.work_order_number %>
        </span>
        <span class="text-xs text-gray-500">
          Received <%= time_ago_in_words(work_order.received_at) %> ago
        </span>
      </div>
      <h3 class="font-medium text-gray-900">
        <%= work_order.vehicle.make %> <%= work_order.vehicle.model %>
      </h3>
      <p class="text-sm text-gray-600">
        License: <%= work_order.vehicle&.license_plate || 'N/A' %>
      </p>
      <p class="text-sm text-gray-600">
        Customer: <%= work_order.customer_type %> 
      </p>
      <% if work_order.total_amount.present? && work_order.total_amount > 0 %>
        <p class="text-sm font-medium text-gray-700 mt-1">
          Total: $<%= number_with_precision(work_order.total_amount, precision: 2) %>
        </p>
      <% end %>
    </div>
  </div>
  
  <div class="mt-3 flex gap-2">
    <%= link_to "View Details", vmcott_workshop_supervisor_work_order_path(work_order), class: "text-blue-600 text-sm hover:underline" %>
    <%= button_to "Approve", vmcott_workshop_supervisor_approve_work_order_path(work_order), method: :post, class: "bg-green-500 text-white px-3 py-1 rounded-lg text-sm hover:bg-green-600 transition" %>
    <%= button_to "Hold", vmcott_workshop_supervisor_hold_work_order_path(work_order), method: :post, class: "bg-yellow-500 text-white px-3 py-1 rounded-lg text-sm hover:bg-yellow-600 transition", data: { confirm: "Place this work order on hold?" } %>
  </div>
</div>