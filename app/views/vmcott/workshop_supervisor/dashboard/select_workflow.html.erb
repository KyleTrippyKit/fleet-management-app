<%# app/views/vmcott/workshop_supervisor/dashboard/select_workflow.html.erb %>
<%# Disable Turbo caching to prevent white screen issues %>
<meta name="turbo-cache-control" content="no-cache">
<meta name="turbo-visit-control" content="reload">

<div class="container-fluid px-4 py-4">
  
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <%= link_to vmcott_workshop_supervisor_dashboard_path, class: "text-decoration-none mb-2 d-inline-block" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          <% end %>
          <h1 class="h2 mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-diagram-3 me-2 text-primary"></i>
            Step 6: Workflow & Pricing
          </h1>
          <p class="text-muted mb-0">Finalize workflow, pricing, and assign mechanic before sending to procurement</p>
          <div class="mt-2">
            <span class="badge bg-success me-2">
              <i class="bi bi-lock-fill me-1"></i> Job Scope FROZEN
            </span>
            <span class="badge bg-info">
              <i class="bi bi-arrow-repeat me-1"></i> Phase 6 of 12
            </span>
          </div>
        </div>
        <div class="text-end">
          <div class="bg-white rounded-3 px-3 py-2 shadow-sm">
            <i class="bi bi-calendar3 me-2 text-primary"></i>
            <%= Time.current.strftime("%A, %B %d, %Y") %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Warning: Job Scope is FROZEN -->
  <div class="alert alert-warning border-0 rounded-3 mb-4">
    <div class="d-flex align-items-center">
      <i class="bi bi-lock-fill fs-3 me-3 text-warning"></i>
      <div>
        <strong>⚠️ JOB SCOPE IS NOW FROZEN</strong><br>
        <small>After this step, job scope cannot be changed. Any changes will require a new quotation.</small>
      </div>
    </div>
  </div>

  <!-- Vehicle & Inspection Info Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4">
      <h5 class="mb-0 fw-bold" style="color: #1e293b;">
        <i class="bi bi-info-circle me-2 text-primary"></i>
        Job Information (FINAL)
      </h5>
    </div>
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-4">
          <div class="d-flex align-items-start gap-3">
            <div class="rounded-circle bg-light p-2">
              <i class="bi bi-truck text-primary"></i>
            </div>
            <div>
              <div class="small text-muted mb-1">Vehicle</div>
              <div class="fw-medium">
                <%= @inspection.vehicle.license_plate %> - <%= @inspection.vehicle.make %> <%= @inspection.vehicle.model %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex align-items-start gap-3">
            <div class="rounded-circle bg-light p-2">
              <i class="bi bi-person-badge text-primary"></i>
            </div>
            <div>
              <div class="small text-muted mb-1">Client</div>
              <div class="fw-medium">
                <% if @inspection.client_type == 'agency' %>
                  <span class="badge bg-primary me-2">Agency</span>
                <% else %>
                  <span class="badge bg-secondary me-2">Walk-in</span>
                <% end %>
                <% client_name = if @inspection.vehicle&.agency.present?
                  @inspection.vehicle.agency.name
                else
                  'Customer'
                end %>
                <%= client_name %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex align-items-start gap-3">
            <div class="rounded-circle bg-light p-2">
              <i class="bi bi-person-gear text-primary"></i>
            </div>
            <div>
              <div class="small text-muted mb-1">Assigned Mechanic *</div>
              <div class="fw-medium">
                <select name="assigned_mechanic_id" id="mechanic-select" class="form-select form-select-sm" required>
                  <option value="">Select Mechanic</option>
                  <% User.where(role: 'mechanic', is_active: true).each do |mechanic| %>
                    <option value="<%= mechanic.id %>" <%= 'selected' if @inspection.inspection_jobs.first&.assigned_mechanic_id == mechanic.id %>>
                      <%= mechanic.name %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FINAL JOBS CARD (FROZEN SCOPE) -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-list-check me-2 text-primary"></i>
          Final Job Scope (FROZEN)
        </h5>
        <span class="badge bg-danger">Cannot be changed after this step</span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-3" style="width: 5%">#</th>
              <th style="width: 35%">Job Description</th>
              <th style="width: 15%">Est. Hours</th>
              <th style="width: 15%">Rate</th>
              <th style="width: 20%">Labor Cost</th>
              <th style="width: 10%" class="text-center">Status</th>
             </thead>
          <tbody>
            <% @jobs.each_with_index do |job, index| %>
              <tr>
                <td class="ps-3 fw-semibold"><%= index + 1 %>. </td>
                <td>
                  <%= job.description %>
                  <input type="hidden" name="jobs[][id]" value="<%= job.id %>">
                  <input type="hidden" name="jobs[][description]" value="<%= job.description %>">
                  <input type="hidden" name="jobs[][estimated_hours]" value="<%= job.estimated_hours %>">
                </td>
                <td><%= job.estimated_hours || 0 %> hrs</td>
                <td>$<span class="labor-rate-display"><%= @labor_rate %></span>/hr</td>
                <td class="job-labor-cost" data-hours="<%= job.estimated_hours || 0 %>">
                  $<%= number_with_precision((job.estimated_hours || 0) * @labor_rate, precision: 2) %>
                </td>
                <td class="text-center">
                  <span class="badge bg-success">Approved</span>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-light">
            <tr>
              <td colspan="4" class="ps-3 fw-bold">Total Labor:</td>
              <td class="fw-bold" id="total-labor-display">$<%= number_with_precision(@labor_cost, precision: 2) %></td>
              <td></td>
             </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- PARTS CARD -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-box-seam me-2 text-primary"></i>
          Parts Required
        </h5>
        <span class="badge bg-info">Inventory Checked</span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-3">Part Name</th>
              <th>Qty</th>
              <th>Unit Cost</th>
              <th>Markup</th>
              <th>Total</th>
              <th>Availability</th>
             </thead>
          <tbody>
            <% @parts_requests.each do |request| %>
              <tr class="<%= request.in_stock? ? '' : 'table-warning' %>">
                <td class="ps-3"><%= request.part_name %></td>
                <td><%= request.quantity %></td>
                <td class="part-base-price" data-base-price="<%= request.unit_price || 0 %>">
                  $<%= number_with_precision(request.unit_price || 0, precision: 2) %>
                </td>
                <td><span class="markup-percent-display"><%= @parts_markup %></span>%</td>
                <td class="part-total-price" data-base-price="<%= request.unit_price || 0 %>" data-quantity="<%= request.quantity %>">
                  $<%= number_with_precision((request.unit_price || 0) * request.quantity * (1 + @parts_markup / 100.0), precision: 2) %>
                </td>
                <td>
                  <% if request.in_stock? %>
                    <span class="badge bg-success">In Stock</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Needs Ordering</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-light">
            <tr>
              <td colspan="4" class="ps-3 fw-bold">Total Parts:</td>
              <td class="fw-bold" id="total-parts-display">$<%= number_with_precision(@parts_cost, precision: 2) %></td>
              <td></td>
             </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- Workflow Selection Form -->
  <%= form_with url: "/vmcott/workshop_supervisor/inspections/#{@inspection.id}/process_workflow_selection", 
                method: :post, 
                local: true,
                data: { turbo: false },
                id: "workflow-form" do |f| %>
    
    <!-- Hidden fields for jobs and parts -->
    <% @jobs.each do |job| %>
      <input type="hidden" name="approved_jobs[]" value="<%= job.id %>">
    <% end %>
    
    <% @parts_requests.each do |part| %>
      <input type="hidden" name="approved_parts[]" value="<%= part.id %>">
    <% end %>
    
    <div class="row g-4 mb-4">
      <!-- Option A: Payment Before Work -->
      <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 workflow-card" data-workflow="payment_before_work">
          <div class="card-header bg-white border-0 pt-4">
            <div class="form-check">
              <input type="radio" name="workflow_type" value="payment_before_work" 
                     class="form-check-input fs-4 workflow-radio" id="optionA" required>
              <label class="form-check-label fs-5 fw-bold" for="optionA">
                Option A: Payment Before Work
              </label>
            </div>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <div class="badge bg-warning text-dark mb-2 px-3 py-2">
                <i class="bi bi-lock-fill me-1"></i> Work starts ONLY after client approval
              </div>
              <ul class="text-muted small mt-2 ps-3">
                <li><i class="bi bi-shield-check text-success me-2"></i> Client approves BEFORE work begins</li>
                <li><i class="bi bi-check2-square text-success me-2"></i> Client can approve ALL or SELECTED jobs</li>
                <li><i class="bi bi-credit-card text-success me-2"></i> Payment/PO required before work</li>
                <li><i class="bi bi-hourglass-split text-warning me-2"></i> Work on hold until approval</li>
              </ul>
            </div>
            <div class="alert alert-warning border-0 rounded-3 mt-3">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <strong>Best for:</strong> New customers, Walk-ins, High-value jobs
            </div>
          </div>
        </div>
      </div>

      <!-- Option B: Work Before Payment -->
      <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 workflow-card" data-workflow="work_before_payment">
          <div class="card-header bg-white border-0 pt-4">
            <div class="form-check">
              <input type="radio" name="workflow_type" value="work_before_payment" 
                     class="form-check-input fs-4 workflow-radio" id="optionB" required>
              <label class="form-check-label fs-5 fw-bold" for="optionB">
                Option B: Work Before Payment
              </label>
            </div>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <div class="badge bg-success mb-2 px-3 py-2">
                <i class="bi bi-play-circle-fill me-1"></i> Work starts immediately
              </div>
              <ul class="text-muted small mt-2 ps-3">
                <li><i class="bi bi-rocket-takeoff text-success me-2"></i> Work starts right away</li>
                <li><i class="bi bi-envelope-paper text-info me-2"></i> Quotation sent for information</li>
                <li><i class="bi bi-clock-history text-info me-2"></i> Client can approve anytime</li>
                <li><i class="bi bi-speedometer2 text-success me-2"></i> Faster turnaround time</li>
              </ul>
            </div>
            <div class="alert alert-success border-0 rounded-3 mt-3">
              <i class="bi bi-check-circle me-2"></i>
              <strong>Best for:</strong> Trusted agencies, Repeat customers, Companies with payment terms
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Adjustment Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white border-0 pt-4">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-sliders2 me-2 text-primary"></i>
          Final Pricing
        </h5>
        <p class="text-muted small mb-0 mt-1">Set final pricing that will appear in the quotation</p>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-md-6">
            <label class="form-label fw-semibold">
              <i class="bi bi-stopwatch me-1"></i> Labor Rate ($/hour)
            </label>
            <input type="number" name="labor_rate" class="form-control" 
                   value="<%= @labor_rate %>" step="5" min="0" id="labor-rate-input">
            <div class="form-text mt-1">Standard: $80/hour</div>
          </div>
          
          <div class="col-md-6">
            <label class="form-label fw-semibold">
              <i class="bi bi-percent me-1"></i> Parts Markup (%)
            </label>
            <input type="number" name="parts_markup" class="form-control" 
                   value="<%= @parts_markup %>" step="5" min="0" max="100" id="markup-input">
            <div class="form-text mt-1">Standard: 30%</div>
          </div>
        </div>
        
        <hr class="my-4">
        
        <div class="row">
          <div class="col-md-4">
            <div class="bg-light rounded-3 p-3 text-center">
              <div class="small text-muted">Labor Total</div>
              <div class="h4 fw-bold text-primary" id="final-labor-total">
                $<%= number_with_precision(@labor_cost, precision: 2) %>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="bg-light rounded-3 p-3 text-center">
              <div class="small text-muted">Parts Total</div>
              <div class="h4 fw-bold text-primary" id="final-parts-total">
                $<%= number_with_precision(@parts_cost, precision: 2) %>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="bg-success bg-opacity-10 rounded-3 p-3 text-center border border-success">
              <div class="small text-muted">GRAND TOTAL</div>
              <div class="h3 fw-bold text-success" id="grand-total">
                $<%= number_with_precision(@total_cost, precision: 2) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Supervisor Notes -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white border-0 pt-4">
        <h5 class="mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-chat-left-text me-2 text-primary"></i>
          Notes for Procurement
        </h5>
      </div>
      <div class="card-body">
        <textarea name="workflow_notes" class="form-control" rows="2" 
                  placeholder="Add any special instructions for procurement..."></textarea>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between gap-3 mb-5">
      <%= link_to "Cancel", vmcott_workshop_supervisor_dashboard_path, 
            class: "btn btn-outline-secondary rounded-pill px-4 py-2" %>
      <button type="submit" class="btn btn-primary rounded-pill px-5 py-2" id="submit-btn">
        <i class="bi bi-lock-fill me-2"></i>Freeze & Send to Procurement
      </button>
    </div>
    
    <!-- Final Warning -->
    <div class="alert alert-danger rounded-3">
      <div class="d-flex">
        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
        <div>
          <strong>⚠️ IMPORTANT: After this step, job scope is FROZEN</strong><br>
          <small>No changes can be made without a new quotation. The selected mechanic will be assigned to all jobs.</small>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // =====================================================
  // Workflow Card Selection (No default)
  // =====================================================
  const workflowCards = document.querySelectorAll('.workflow-card');
  
  workflowCards.forEach(card => {
    card.addEventListener('click', function() {
      const radio = this.querySelector('.workflow-radio');
      if (radio) {
        radio.checked = true;
        workflowCards.forEach(c => c.classList.remove('border-primary', 'bg-primary', 'bg-opacity-5'));
        this.classList.add('border-primary', 'bg-primary', 'bg-opacity-5');
      }
    });
  });
  
  // =====================================================
  // Real-time Cost Calculation
  // =====================================================
  const laborRateInput = document.getElementById('labor-rate-input');
  const markupInput = document.getElementById('markup-input');
  const finalLaborTotal = document.getElementById('final-labor-total');
  const finalPartsTotal = document.getElementById('final-parts-total');
  const grandTotal = document.getElementById('grand-total');
  
  // Get job data
  const jobRows = document.querySelectorAll('.job-labor-cost');
  const jobHours = Array.from(jobRows).map(row => parseFloat(row.dataset.hours) || 0);
  
  // Get part data
  const partRows = document.querySelectorAll('.part-total-price');
  const partBasePrices = Array.from(partRows).map(row => parseFloat(row.dataset.basePrice) || 0);
  const partQuantities = Array.from(partRows).map(row => parseFloat(row.dataset.quantity) || 1);
  
  function updateCosts() {
    const laborRate = parseFloat(laborRateInput.value) || 0;
    const markup = parseFloat(markupInput.value) || 0;
    
    // Calculate labor total
    let laborTotal = 0;
    jobHours.forEach(hours => {
      laborTotal += hours * laborRate;
    });
    
    // Calculate parts total with markup
    let partsTotal = 0;
    partBasePrices.forEach((basePrice, index) => {
      const qty = partQuantities[index];
      partsTotal += basePrice * qty * (1 + markup / 100);
    });
    
    // Update displays
    finalLaborTotal.textContent = `$${laborTotal.toFixed(2)}`;
    finalPartsTotal.textContent = `$${partsTotal.toFixed(2)}`;
    grandTotal.textContent = `$${(laborTotal + partsTotal).toFixed(2)}`;
    
    // Update individual job costs in table
    const jobCostSpans = document.querySelectorAll('.job-labor-cost');
    jobCostSpans.forEach((span, index) => {
      const cost = jobHours[index] * laborRate;
      span.textContent = `$${cost.toFixed(2)}`;
    });
    
    // Update individual part costs in table
    const partCostSpans = document.querySelectorAll('.part-total-price');
    partCostSpans.forEach((span, index) => {
      const cost = partBasePrices[index] * partQuantities[index] * (1 + markup / 100);
      span.textContent = `$${cost.toFixed(2)}`;
    });
    
    // Update markup display in table
    const markupSpans = document.querySelectorAll('.markup-percent-display');
    markupSpans.forEach(span => {
      span.textContent = markup;
    });
    
    // Update labor rate display in table
    const rateSpans = document.querySelectorAll('.labor-rate-display');
    rateSpans.forEach(span => {
      span.textContent = laborRate;
    });
    
    // Update total labor display in footer
    const totalLaborSpan = document.getElementById('total-labor-display');
    if (totalLaborSpan) {
      totalLaborSpan.textContent = `$${laborTotal.toFixed(2)}`;
    }
    
    // Update total parts display in footer
    const totalPartsSpan = document.getElementById('total-parts-display');
    if (totalPartsSpan) {
      totalPartsSpan.textContent = `$${partsTotal.toFixed(2)}`;
    }
  }
  
  laborRateInput?.addEventListener('input', updateCosts);
  markupInput?.addEventListener('input', updateCosts);
  
  // =====================================================
  // Form Validation
  // =====================================================
  const form = document.getElementById('workflow-form');
  const submitBtn = document.getElementById('submit-btn');
  
  form?.addEventListener('submit', function(e) {
    // Check workflow selection
    const selectedWorkflow = document.querySelector('input[name="workflow_type"]:checked');
    if (!selectedWorkflow) {
      e.preventDefault();
      alert('❌ Please select a workflow type (Option A or Option B)');
      return false;
    }
    
    // Check mechanic assignment
    const mechanicSelect = document.getElementById('mechanic-select');
    if (!mechanicSelect.value) {
      e.preventDefault();
      alert('❌ Please assign a mechanic before finalizing');
      mechanicSelect.focus();
      return false;
    }
    
    // Confirm with user
    const workflowType = selectedWorkflow.value === 'payment_before_work' ? 'Payment Before Work' : 'Work Before Payment';
    const mechanicName = mechanicSelect.options[mechanicSelect.selectedIndex]?.text;
    const total = grandTotal.textContent;
    
    if (!confirm(`⚠️ CONFIRM WORKFLOW SELECTION\n\nWorkflow: ${workflowType}\nAssigned Mechanic: ${mechanicName}\nTotal Cost: ${total}\n\n⚠️ After confirmation, the job scope will be FROZEN and sent to procurement.\n\nProceed?`)) {
      e.preventDefault();
      return false;
    }
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Freezing & Sending...';
    return true;
  });
  
  // =====================================================
  // Auto-hide alerts
  // =====================================================
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(alert => {
    setTimeout(() => {
      alert.style.transition = 'opacity 0.5s ease';
      alert.style.opacity = '0';
      setTimeout(() => {
        if (alert && alert.remove) alert.remove();
      }, 500);
    }, 5000);
  });
});
</script>

<style>
  .workflow-card {
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .workflow-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
  }
  
  .workflow-card.border-primary {
    border: 2px solid #0d6efd !important;
  }
  
  .workflow-card.bg-primary.bg-opacity-5 {
    background-color: rgba(13, 110, 253, 0.05) !important;
  }
  
  .form-check-input:checked {
    background-color: #0d6efd;
    border-color: #0d6efd;
  }
  
  .table > :not(caption) > * > * {
    padding: 0.75rem 0.75rem;
  }
  
  .bg-light th {
    background-color: #f8fafc !important;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
  }
</style>