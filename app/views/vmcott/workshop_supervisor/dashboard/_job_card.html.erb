<%# app/views/vmcott/workshop_supervisor/dashboard/_job_card.html.erb %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-3">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
          In Progress
        </span>
        <span class="text-xs text-gray-500">
          Started <%= time_ago_in_words(job.started_at) %> ago
        </span>
      </div>
      <h3 class="font-medium text-gray-900">
        Job #<%= job.id %> - <%= job.description %>
      </h3>
      <div class="mt-2 flex flex-wrap gap-3 text-xs text-gray-500">
        <span><i class="fas fa-car mr-1"></i> <%= job.inspection.vehicle.make %> <%= job.inspection.vehicle.model %></span>
        <span><i class="fas fa-id-card mr-1"></i> License: <%= job.inspection.vehicle.license_plate %></span>
        <span><i class="fas fa-user mr-1"></i> Mechanic: <%= job.assigned_mechanic&.name || 'Unassigned' %></span>
        <span><i class="fas fa-tasks mr-1"></i> Tasks: <%= job.job_tasks.count %></span>
        <% if job.estimated_hours.present? %>
          <span><i class="fas fa-hourglass-half mr-1"></i> Est: <%= job.estimated_hours %> hrs</span>
        <% end %>
      </div>
    </div>
  </div>
  
  <div class="mt-3">
    <%= link_to "View Job Details", vmcott_workshop_supervisor_job_path(job), class: "text-blue-600 text-sm hover:underline" %>
  </div>
</div>