<div class="min-h-screen bg-gray-100 pb-24">
  <div class="bg-white shadow p-4">
    <div class="flex justify-between items-center">
      <div>
        <%= link_to "← Back to Dashboard", vmcott_workshop_supervisor_dashboard_path, class: "text-blue-600 hover:underline text-sm" %>
        <h1 class="text-xl font-bold mt-2">Work Orders</h1>
      </div>
      <div class="flex gap-2">
        <%= link_to "All", vmcott_workshop_supervisor_work_orders_path, class: "px-3 py-1 rounded #{params[:status].blank? ? 'bg-blue-500 text-white' : 'bg-gray-200'}" %>
        <%= link_to "Pending", vmcott_workshop_supervisor_work_orders_path(status: 'pending'), class: "px-3 py-1 rounded #{params[:status] == 'pending' ? 'bg-yellow-500 text-white' : 'bg-gray-200'}" %>
        <%= link_to "In Progress", vmcott_workshop_supervisor_work_orders_path(status: 'in_progress'), class: "px-3 py-1 rounded #{params[:status] == 'in_progress' ? 'bg-blue-500 text-white' : 'bg-gray-200'}" %>
        <%= link_to "Completed", vmcott_workshop_supervisor_work_orders_path(status: 'completed'), class: "px-3 py-1 rounded #{params[:status] == 'completed' ? 'bg-green-500 text-white' : 'bg-gray-200'}" %>
      </div>
    </div>
  </div>

  <div class="p-4">
    <% if @work_orders.present? %>
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Work Order #</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @work_orders.each do |work_order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= work_order.work_order_number || "WO-#{work_order.id}" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= work_order.vehicle&.license_plate || 'N/A' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                    <%= case work_order.status
                        when 'pending' then 'bg-yellow-100 text-yellow-800'
                        when 'in_progress' then 'bg-blue-100 text-blue-800'
                        when 'completed' then 'bg-green-100 text-green-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= work_order.status.upcase %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= work_order.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to "View", vmcott_workshop_supervisor_work_order_path(work_order), class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <% if @work_orders.respond_to?(:total_pages) && @work_orders.total_pages > 1 %>
        <div class="mt-4 flex justify-center gap-2">
          <%= paginate @work_orders, theme: 'twitter-bootstrap-4', param_name: :page %>
        </div>
      <% end %>
      
    <% else %>
      <div class="bg-white rounded-xl shadow p-8 text-center">
        <p class="text-gray-500">No work orders found.</p>
      </div>
    <% end %>
  </div>
</div>