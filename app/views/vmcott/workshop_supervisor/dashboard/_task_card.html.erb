<%# app/views/vmcott/workshop_supervisor/dashboard/_task_card.html.erb %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-3">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <% if type == 'pending' %>
          <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
            Pending Approval
          </span>
        <% else %>
          <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
            Blocked
          </span>
        <% end %>
        <span class="text-xs text-gray-500">
          Created <%= time_ago_in_words(task.created_at) %> ago
        </span>
      </div>
      <h3 class="font-medium text-gray-900">
        <%= task.name %>
      </h3>
      <p class="text-sm text-gray-600 mt-1">
        <%= task.description %>
      </p>
      <div class="mt-2 flex flex-wrap gap-3 text-xs text-gray-500">
        <span><i class="fas fa-car mr-1"></i> <%= task.inspection_job&.inspection&.vehicle&.license_plate || 'N/A' %></span>
        <span><i class="fas fa-clock mr-1"></i> Est: <%= task.estimated_hours %> hrs</span>
        <%# Remove priority reference - it doesn't exist in the table %>
      </div>
    </div>
  </div>
  
  <div class="mt-3 flex gap-2">
    <%= link_to "View Details", vmcott_workshop_supervisor_task_path(task), class: "text-blue-600 text-sm hover:underline" %>
    <% if type == 'pending' %>
      <%= button_to "Approve", vmcott_workshop_supervisor_approve_task_path(task), method: :post, class: "bg-green-500 text-white px-3 py-1 rounded-lg text-sm hover:bg-green-600 transition" %>
      <%= button_to "Reject", vmcott_workshop_supervisor_reject_task_path(task), method: :post, class: "bg-red-500 text-white px-3 py-1 rounded-lg text-sm hover:bg-red-600 transition", data: { confirm: "Reject this task?" } %>
    <% elsif type == 'blocked' %>
      <%= button_to "Unblock", vmcott_workshop_supervisor_unblock_task_path(task), method: :post, class: "bg-blue-500 text-white px-3 py-1 rounded-lg text-sm hover:bg-blue-600 transition" %>
    <% end %>
  </div>
</div>