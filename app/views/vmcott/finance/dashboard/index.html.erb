<%# app/views/vmcott/finance/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">💰 Finance Dashboard</h1>
      <p class="text-muted">VMCOTT Finance - Create agency quotations, review vendor quotes, approve POs, and manage invoices</p>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Ready to Quote</h5>
          <h2 class="display-4"><%= @ready_for_quotation_count || 0 %></h2>
          <p class="card-text"><small>In-stock parts for agency</small></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-white">
        <div class="card-body">
          <h5 class="card-title">Quotes to Review</h5>
          <h2 class="display-4"><%= @quotations_to_review_count || 0 %></h2>
          <p class="card-text"><small>From Billing Team</small></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Pending PO Approval</h5>
          <h2 class="display-4"><%= @pending_po_approval_count || 0 %></h2>
          <p class="card-text"><small>Awaiting finance approval</small></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Ready for Pickup</h5>
          <h2 class="display-4"><%= @ready_for_pickup_count || 0 %></h2>
          <p class="card-text"><small>Vehicles to invoice</small></p>
        </div>
      </div>
    </div>
  </div>

  <!-- TRACK 1: IN-STOCK PARTS READY FOR AGENCY QUOTATION -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>In-Stock Parts - Ready for Agency Quotation</h5>
          <span class="badge bg-light text-dark"><%= @ready_for_quotation&.count || 0 %> ready</span>
        </div>
        <div class="card-body">
          <% if @ready_for_quotation&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Inspection #</th>
                    <th>Vehicle</th>
                    <th>Jobs</th>
                    <th>Parts</th>
                    <th>Est. Labor</th>
                    <th>Est. Parts</th>
                    <th>Total</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @ready_for_quotation.each do |inspection| %>
                    <% labor_cost = inspection.inspection_jobs.sum(&:estimated_labor_cost) %>
                    <% parts_cost = inspection.parts_requests.where(in_stock: true).sum { |pr| pr.part&.sale_price.to_f * pr.quantity } %>
                    <% total = labor_cost + parts_cost %>
                    <tr>
                      <td><strong>#<%= inspection.id %></strong></td>
                      <td>
                        <%= inspection.vehicle.license_plate %>
                        <br><small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                      </td>
                      <td><%= inspection.inspection_jobs.count %></td>
                      <td><%= inspection.parts_requests.where(in_stock: true).count %></td>
                      <td><%= number_to_currency(labor_cost) %></td>
                      <td><%= number_to_currency(parts_cost) %></td>
                      <td><strong><%= number_to_currency(total) %></strong></td>
                      <td>
                        <%= link_to "Create Quotation", 
                              vmcott_finance_new_quotation_for_inspection_path(inspection_id: inspection.id),
                              class: "btn btn-sm btn-primary" %>
                        <%= link_to "View Details", vmcott_inspector_inspection_path(inspection), 
                              class: "btn btn-sm btn-outline-secondary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No in-stock parts awaiting quotation</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- TRACK 2: VENDOR QUOTATIONS READY FOR COMPARISON (FROM BILLING) -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Vendor Quotations - Ready for Comparison</h5>
          <span class="badge bg-light text-dark"><%= @quotations_to_review&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @quotations_to_review&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>RFQ #</th>
                    <th>Parts</th>
                    <th>Quotes Received</th>
                    <th>Price Range</th>
                    <th>Vendors</th>
                    <th>Received</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @quotations_to_review.each do |rfq| %>
                    <% 
                      quotes = rfq.vendor_quotations || []
                      prices = quotes.map { |q| q.total_amount }.compact
                      min_price = prices.min if prices.any?
                      max_price = prices.max if prices.any?
                    %>
                    <tr>
                      <td><strong><%= link_to rfq.rfq_number, vmcott_vendor_rfq_path(rfq) %></strong></td>
                      <td>
                        <% rfq.vendor_rfq_items.each do |item| %>
                          <div><%= item.part&.name || item.custom_part_name || 'Unknown' %> (x<%= item.quantity %>)</div>
                        <% end %>
                      </td>
                      <td><span class="badge bg-primary"><%= quotes.count %> quotes</span></td>
                      <td>
                        <% if min_price && max_price %>
                          <%= number_to_currency(min_price) %> - <%= number_to_currency(max_price) %>
                          <% if prices.size > 1 %>
                            <br><small class="text-success">Save <%= number_to_currency(max_price - min_price) %></small>
                          <% end %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td>
                        <% if quotes.any? %>
                          <% quotes.first(2).each do |quote| %>
                            <div><%= quote.supplier&.name || 'Unknown' %></div>
                          <% end %>
                          <% if quotes.count > 2 %>
                            <span class="badge bg-secondary">+<%= quotes.count - 2 %> more</span>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No vendors</span>
                        <% end %>
                      </td>
                      <td><%= rfq.updated_at&.strftime("%b %d, %Y") %></td>
                      <td>
                        <%= link_to "Compare & Select", 
                              vmcott_finance_compare_quotations_path(rfq_id: rfq.id), 
                              class: "btn btn-sm btn-warning" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No vendor quotations pending review</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- PURCHASE ORDERS PENDING APPROVAL -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Purchase Orders Pending Approval</h5>
          <span class="badge bg-light text-dark"><%= @pending_pos&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @pending_pos&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>PO #</th>
                    <th>Vendor</th>
                    <th>Amount</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th>Payment Terms</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_pos.each do |po| %>
                    <tr>
                      <td><strong><%= link_to po.po_number, purchase_order_path(po) %></strong></td>
                      <td><%= po.vendor %></td>
                      <td><%= number_to_currency(po.amount) %></td>
                      <td><%= po.purchase_order_items.count %></td>
                      <td><%= po.created_at.strftime("%b %d, %Y") %></td>
                      <td><%= po.payment_terms || 'Net 30' %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to "Review", purchase_order_path(po), class: "btn btn-outline-primary" %>
                          <%= button_to "Approve", approve_purchase_order_path(po), 
                                method: :post, 
                                class: "btn btn-outline-success btn-sm", 
                                data: { confirm: "Approve this purchase order?" } %>
                          <%= button_to "Reject", reject_purchase_order_path(po), 
                                method: :post, 
                                class: "btn btn-outline-danger btn-sm", 
                                data: { confirm: "Reject this purchase order?" } %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No purchase orders pending approval</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- VEHICLES READY FOR PICKUP -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Vehicles Ready for Pickup</h5>
          <span class="badge bg-light text-dark"><%= @ready_for_pickup&.count || 0 %> ready</span>
        </div>
        <div class="card-body">
          <% if @ready_for_pickup&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Inspection #</th>
                    <th>Vehicle</th>
                    <th>Jobs Completed</th>
                    <th>Parts Used</th>
                    <th>Completed</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @ready_for_pickup.each do |inspection| %>
                    <tr>
                      <td><strong>#<%= inspection.id %></strong></td>
                      <td>
                        <%= inspection.vehicle.license_plate %>
                        <br><small class="text-muted"><%= inspection.vehicle.make %> <%= inspection.vehicle.model %></small>
                      </td>
                      <td><%= inspection.inspection_jobs.count %></td>
                      <td><%= inspection.parts_requests.count %></td>
                      <td><%= inspection.completed_at&.strftime("%b %d, %Y") %></td>
                      <td>
                        <%= button_to "Create Invoice", 
                              vmcott_finance_create_invoice_path(inspection_id: inspection.id), 
                              method: :post,
                              class: "btn btn-sm btn-success",
                              data: { confirm: "Create invoice for this vehicle?" } %>
                        <%= link_to "View Details", vmcott_inspector_inspection_path(inspection), 
                              class: "btn btn-sm btn-outline-secondary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-3">No vehicles ready for pickup</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>