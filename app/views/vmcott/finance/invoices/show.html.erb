<%# app/views/vmcott/finance/invoices/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">Invoice <%= @invoice.invoice_number %></h1>
    </div>
    <div class="col-auto">
      <%= link_to "Back to Invoices", vmcott_finance_invoices_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <!-- Invoice Details -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">Invoice Details</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Invoice #:</th>
                  <td><%= @invoice.invoice_number %></td>
                </tr>
                <tr>
                  <th>Date:</th>
                  <td><%= @invoice.invoice_date&.strftime("%B %d, %Y") %></td>
                </tr>
                <tr>
                  <th>Due Date:</th>
                  <td>
                    <%= @invoice.due_date&.strftime("%B %d, %Y") %>
                    <% if @invoice.due_date.present? && @invoice.due_date < Date.today && @invoice.status != 'paid' %>
                      <span class="badge bg-danger ms-2">Overdue</span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Status:</th>
                  <td>
                    <span class="badge bg-<%= @invoice.status == 'paid' ? 'success' : (@invoice.status == 'pending' ? 'warning' : 'secondary') %>">
                      <%= @invoice.status&.titleize || 'Pending' %>
                    </span>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Vehicle:</th>
                  <td>
                    <% if @invoice.vehicle.present? %>
                      <%= @invoice.vehicle.license_plate %> - <%= @invoice.vehicle.make %> <%= @invoice.vehicle.model %>
                    <% else %>
                      <span class="text-muted">No vehicle assigned</span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Vendor:</th>
                  <td><%= @invoice.vendor %></td>
                </tr>
                <tr>
                  <th>Payment Terms:</th>
                  <td><%= @invoice.payment_terms&.humanize || 'Net 30' %></td>
                </tr>
              </table>
            </div>
          </div>
          
          <% if @invoice.notes.present? %>
            <div class="mt-3 p-3 bg-light rounded">
              <strong>Notes:</strong>
              <p class="mb-0"><%= @invoice.notes %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Line Items - Temporarily showing summary until line items are implemented -->
      <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Line Items</h5>
          <span class="badge bg-info">Coming Soon</span>
        </div>
        <div class="card-body">
          <div class="text-center py-4">
            <i class="bi bi-list-check fs-1 text-muted mb-3"></i>
            <p class="text-muted">Line items will be available soon</p>
            <p class="text-muted small">Total Amount: <strong><%= number_to_currency(@invoice.amount) %></strong></p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <!-- Payment Status Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">Payment Status</h5>
        </div>
        <div class="card-body">
          <div class="text-center mb-3">
            <h1 class="display-4"><%= number_to_currency(@invoice.amount) %></h1>
            <span class="badge bg-<%= @invoice.status == 'paid' ? 'success' : (@invoice.status == 'pending' ? 'warning' : 'secondary') %> p-2">
              <%= @invoice.status&.titleize || 'Pending' %>
            </span>
          </div>
          
          <% if @invoice.paid_at.present? %>
            <p class="mb-1"><strong>Paid On:</strong> <%= @invoice.paid_at.strftime("%B %d, %Y") %></p>
          <% end %>
          
          <% if @invoice.payment_terms.present? %>
            <p class="mb-0"><strong>Terms:</strong> <%= @invoice.payment_terms.humanize %></p>
          <% end %>
        </div>
      </div>

      <!-- Vehicle Info Card -->
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Vehicle Information</h5>
        </div>
        <div class="card-body">
          <% if @vehicle.present? %>
            <p class="mb-1"><strong>License Plate:</strong> <%= @vehicle.license_plate %></p>
            <p class="mb-1"><strong>Make/Model:</strong> <%= @vehicle.make %> <%= @vehicle.model %></p>
            <p class="mb-1"><strong>Year:</strong> <%= @vehicle.year_of_manufacture %></p>
            <p class="mb-0"><strong>VIN:</strong> <%= @vehicle.chassis_number || 'N/A' %></p>
          <% else %>
            <p class="text-muted mb-0">No vehicle information available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>