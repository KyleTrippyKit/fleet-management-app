<%# app/views/vmcott/finance/quotations/new_for_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2"><i class="bi bi-file-text me-2"></i>Create Quotation for Agency</h1>
      <p class="text-muted">Vehicle: <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %></p>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Quotation Details</h5>
        </div>
        <div class="card-body">
          <%= form_with url: vmcott_finance_create_quotation_for_inspection_path, method: :post, local: true do |f| %>
            <%= hidden_field_tag :inspection_id, @inspection.id %>
            <%= hidden_field_tag :is_additional, @is_additional %>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">Labor Costs</h6>
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Job</th>
                    <th class="text-end">Estimated Cost</th>
                  </tr>
                </thead>
                <tbody>
                  <% @jobs.each do |job| %>
                    <tr>
                      <td><%= job.description %></td>
                      <td class="text-end">$<%= number_with_precision(job.estimated_labor_cost, precision: 2) %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="fw-bold">
                    <td>Total Labor</td>
                    <td class="text-end">$<%= number_with_precision(@labor_cost, precision: 2) %></td>
                  </tr>
                </tfoot>
              </table>
              <%= f.hidden_field :labor_cost, value: @labor_cost %>
            </div>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">Parts Costs</h6>
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Part</th>
                    <th>Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts_requests.each do |pr| %>
                    <tr>
                      <td><%= pr.part.name %></td>
                      <td><%= pr.quantity %></td>
                      <td class="text-end">$<%= number_with_precision(pr.part.cost_price, precision: 2) %></td>
                      <td class="text-end">$<%= number_with_precision(pr.part.cost_price * pr.quantity, precision: 2) %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="fw-bold">
                    <td colspan="3">Total Parts</td>
                    <td class="text-end">$<%= number_with_precision(@parts_cost, precision: 2) %></td>
                  </tr>
                </tfoot>
              </table>
              <%= f.hidden_field :parts_cost, value: @parts_cost %>
            </div>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">Summary</h6>
              <table class="table">
                <tr>
                  <td><strong>Labor Total</strong></td>
                  <td class="text-end">$<%= number_with_precision(@labor_cost, precision: 2) %></td>
                </tr>
                <tr>
                  <td><strong>Parts Total</strong></td>
                  <td class="text-end">$<%= number_with_precision(@parts_cost, precision: 2) %></td>
                </tr>
                <tr class="fw-bold fs-5">
                  <td><strong>GRAND TOTAL</strong></td>
                  <td class="text-end text-primary">$<%= number_with_precision(@total_cost, precision: 2) %></td>
                </tr>
              </table>
              <%= f.hidden_field :total_cost, value: @total_cost %>
            </div>

            <div class="mb-3">
              <%= label_tag :valid_until, "Valid Until", class: "form-label fw-bold" %>
              <%= date_field_tag :valid_until, 30.days.from_now, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= label_tag :notes, "Additional Notes", class: "form-label fw-bold" %>
              <%= text_area_tag :notes, nil, rows: 4, class: "form-control", placeholder: "Any special terms or conditions..." %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "Cancel", vmcott_finance_dashboard_path, class: "btn btn-outline-secondary" %>
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send me-2"></i>Create Quotation
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>