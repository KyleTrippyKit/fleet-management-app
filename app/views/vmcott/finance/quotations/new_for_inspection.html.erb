<%# app/views/vmcott/finance/quotations/new_for_inspection.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2"><i class="bi bi-file-text me-2"></i>Create Quotation for Agency</h1>
      <p class="text-muted">
        Vehicle: <%= @vehicle&.license_plate || 'N/A' %> - 
        <%= @vehicle&.make %> <%= @vehicle&.model %>
        <% if @vehicle&.year_of_manufacture.present? %>(<%= @vehicle.year_of_manufacture %>)<% end %>
      </p>
      <p class="text-muted">
        <span class="badge bg-info">Inspection #<%= @inspection.id %></span>
        <% if @is_additional %>
          <span class="badge bg-warning text-dark">Additional Work</span>
        <% end %>
      </p>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Quotation Details</h5>
          <span class="badge bg-light text-dark">Draft</span>
        </div>
        <div class="card-body">
          <%= form_with url: vmcott_finance_create_quotation_for_inspection_path(@inspection), 
                       method: :post, 
                       local: true,
                       data: { turbo: false } do |f| %>
            
            <%= hidden_field_tag :inspection_id, @inspection.id %>
            <%= hidden_field_tag :is_additional, @is_additional %>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">
                <i class="bi bi-tools me-2"></i>Labor Costs
                <span class="badge bg-secondary float-end"><%= @jobs.count %> jobs</span>
              </h6>
              
              <% if @jobs.present? %>
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Job Description</th>
                      <th class="text-end">Estimated Cost</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @jobs.each do |job| %>
                      <tr>
                        <td>
                          <%= job.description %>
                          <% if job.priority.present? %>
                            <span class="badge bg-<%= job.priority == 'critical' ? 'danger' : 'warning' %> ms-2">
                              <%= job.priority %>
                            </span>
                          <% end %>
                        </td>
                        <td class="text-end fw-medium">
                          $<%= number_with_precision(job.estimated_labor_cost || 0, precision: 2) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                  <tfoot class="table-light">
                    <tr class="fw-bold">
                      <td>Total Labor</td>
                      <td class="text-end text-primary">
                        $<%= number_with_precision(@labor_cost || 0, precision: 2) %>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              <% else %>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle me-2"></i>No labor jobs found for this inspection.
                </div>
              <% end %>
              
              <%= hidden_field_tag :labor_cost, @labor_cost || 0 %>
            </div>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">
                <i class="bi bi-box-seam me-2"></i>Parts Costs
                <span class="badge bg-secondary float-end"><%= @parts_requests.count %> parts</span>
              </h6>
              
              <% if @parts_requests.present? %>
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Part</th>
                      <th class="text-center">Qty</th>
                      <th class="text-end">Unit Price</th>
                      <th class="text-end">Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @parts_requests.each do |pr| %>
                      <tr>
                        <td>
                          <% if pr.part.present? %>
                            <%= pr.part.name %>
                            <small class="text-muted d-block"><%= pr.part.part_number %></small>
                          <% else %>
                            <%= pr.custom_part_name || 'Unknown Part' %>
                            <span class="badge bg-warning text-dark ms-1">Custom</span>
                          <% end %>
                        </td>
                        <td class="text-center"><%= pr.quantity %></td>
                        <td class="text-end">
                          $<%= number_with_precision(pr.part&.cost_price || 0, precision: 2) %>
                        </td>
                        <td class="text-end fw-medium">
                          $<%= number_with_precision((pr.part&.cost_price || 0) * pr.quantity, precision: 2) %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                  <tfoot class="table-light">
                    <tr class="fw-bold">
                      <td colspan="3">Total Parts</td>
                      <td class="text-end text-primary">
                        $<%= number_with_precision(@parts_cost || 0, precision: 2) %>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              <% else %>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle me-2"></i>No parts requests found for this inspection.
                </div>
              <% end %>
              
              <%= hidden_field_tag :parts_cost, @parts_cost || 0 %>
            </div>

            <div class="mb-4">
              <h6 class="border-bottom pb-2">
                <i class="bi bi-calculator me-2"></i>Summary
              </h6>
              <div class="card bg-light">
                <div class="card-body">
                  <table class="table table-borderless mb-0">
                    <tr>
                      <td><strong>Labor Total</strong></td>
                      <td class="text-end">$<%= number_with_precision(@labor_cost || 0, precision: 2) %></td>
                    </tr>
                    <tr>
                      <td><strong>Parts Total</strong></td>
                      <td class="text-end">$<%= number_with_precision(@parts_cost || 0, precision: 2) %></td>
                    </tr>
                    <tr>
                      <td colspan="2"><hr class="my-2"></td>
                    </tr>
                    <tr class="fw-bold fs-5">
                      <td><strong>GRAND TOTAL</strong></td>
                      <td class="text-end text-primary">
                        $<%= number_with_precision(@total_cost || 0, precision: 2) %>
                      </td>
                    </tr>
                  </table>
                </div>
              </div>
              <%= hidden_field_tag :total_cost, @total_cost || 0 %>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= label_tag :valid_until, "Valid Until", class: "form-label fw-bold" %>
                <%= date_field_tag :valid_until, 
                                    params[:valid_until] || 30.days.from_now, 
                                    class: "form-control", 
                                    required: true,
                                    min: Date.today %>
                <div class="form-text">Quotation expires after this date</div>
              </div>
              
              <div class="col-md-6">
                <%= label_tag :reference_number, "Reference Number (Optional)", class: "form-label fw-bold" %>
                <%= text_field_tag :reference_number, 
                                    nil, 
                                    class: "form-control", 
                                    placeholder: "PO, Work Order, etc." %>
              </div>
            </div>

            <div class="mb-4">
              <%= label_tag :notes, "Additional Notes", class: "form-label fw-bold" %>
              <%= text_area_tag :notes, 
                                nil, 
                                rows: 4, 
                                class: "form-control", 
                                placeholder: "Any special terms, conditions, or notes for the agency..." %>
              <div class="form-text">These notes will appear on the quotation</div>
            </div>

            <% if @total_cost.to_f <= 0 %>
              <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Warning:</strong> Total cost is $0.00. Please verify the costs above.
              </div>
            <% end %>

            <div class="d-flex justify-content-between mt-4">
              <%= link_to vmcott_finance_dashboard_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-2"></i>Cancel
              <% end %>
              
              <button type="submit" class="btn btn-primary btn-lg px-5" 
                      <%= 'disabled' if @total_cost.to_f <= 0 %>>
                <i class="bi bi-send me-2"></i>Create Quotation
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Preview Card -->
      <div class="card">
        <div class="card-header bg-light">
          <h6 class="mb-0"><i class="bi bi-eye me-2"></i>Quotation Preview</h6>
        </div>
        <div class="card-body">
          <div class="text-center text-muted py-4">
            <i class="bi bi-file-text display-4"></i>
            <p class="mt-3">Fill out the form above and click "Create Quotation" to generate the document.</p>
            <p class="small">The quotation will be created as a draft that you can review before sending to the agency.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :javascript do %>
<script>
  // Auto-calculate total if needed
  document.addEventListener('DOMContentLoaded', function() {
    // Any client-side calculations can go here
  });
</script>
<% end %>