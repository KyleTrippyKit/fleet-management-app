<%# app/views/vmcott/inventory/export_report.pdf.erb %>
<% content_for :title do %>
  Inventory Report - <%= @agency.name %> - <%= Time.current.strftime("%B %d, %Y") %>
<% end %>

<style type="text/css">
  /* Additional styles specific to inventory report */
  @page {
    size: A4 landscape;
    margin: 0.5cm;
  }
  
  .inventory-header {
    text-align: center;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 3px solid #2c3e50;
  }
  
  .inventory-header h1 {
    font-size: 28px;
    margin: 0 0 5px 0;
    color: #2c3e50;
    font-weight: bold;
  }
  
  .inventory-header .subtitle {
    font-size: 14px;
    color: #7f8c8d;
    margin: 0;
  }
  
  .report-meta {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 4px;
  }
  
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }
  
  .meta-item {
    padding: 10px;
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 4px;
  }
  
  .meta-label {
    font-weight: bold;
    font-size: 10px;
    color: #495057;
    margin-bottom: 5px;
    display: block;
    text-transform: uppercase;
  }
  
  .meta-value {
    font-size: 12px;
    font-weight: bold;
  }
  
  .summary-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }
  
  .stat-box {
    text-align: center;
    padding: 15px;
    background-color: #e8f4fd;
    border: 1px solid #b6d4fe;
    border-radius: 4px;
  }
  
  .stat-value {
    font-size: 20px;
    font-weight: bold;
    color: #0d6efd;
    margin-bottom: 5px;
  }
  
  .stat-label {
    font-size: 10px;
    color: #6c757d;
    text-transform: uppercase;
  }
  
  .stock-status {
    display: inline-block;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    text-transform: uppercase;
  }
  
  .status-in_stock {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
  
  .status-low_stock {
    background-color: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }
  
  .status-out_of_stock {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
  
  .numeric {
    text-align: right;
  }
  
  .currency {
    text-align: right;
    font-family: 'Courier New', monospace;
  }
  
  .warning-box {
    background-color: #fff3cd;
    border: 1px solid #ffeaa7;
    color: #856404;
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 20px;
  }
  
  .warning-box strong {
    color: #856404;
  }
  
  .section-title {
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    margin: 20px 0 10px 0;
    padding-bottom: 5px;
    border-bottom: 1px solid #dee2e6;
  }
  
  .inventory-table th {
    background-color: #2c3e50;
    color: white;
    border-color: #34495e;
  }
  
  .page-break {
    page-break-before: always;
  }
</style>

<div class="inventory-header">
  <h1>INVENTORY REPORT</h1>
  <div class="subtitle">
    <%= @agency.name %> - <%= Time.current.strftime("%B %d, %Y") %>
  </div>
</div>

<div class="report-meta">
  <div class="meta-grid">
    <div class="meta-item">
      <span class="meta-label">Report Type</span>
      <span class="meta-value"><%= params[:report_type]&.titleize || "Full Inventory" %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Date Range</span>
      <span class="meta-value"><%= @start_date.strftime("%Y-%m-%d") %> to <%= @end_date.strftime("%Y-%m-%d") %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Generated By</span>
      <span class="meta-value"><%= current_user.name %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Generated At</span>
      <span class="meta-value"><%= Time.current.strftime("%Y-%m-%d %H:%M") %></span>
    </div>
  </div>
</div>

<% if @parts.present? %>
  <div class="summary-stats">
    <div class="stat-box">
      <div class="stat-value"><%= @parts.count %></div>
      <div class="stat-label">Total Parts</div>
    </div>
    <div class="stat-box">
      <div class="stat-value"><%= number_to_currency(@total_stock_value) %></div>
      <div class="stat-label">Total Value</div>
    </div>
    <div class="stat-box">
      <div class="stat-value"><%= @low_stock_count %></div>
      <div class="stat-label">Low Stock</div>
    </div>
    <div class="stat-box">
      <div class="stat-value"><%= @out_of_stock_count %></div>
      <div class="stat-label">Out of Stock</div>
    </div>
  </div>
  
  <% if @low_stock_count > 0 %>
    <div class="warning-box">
      ⚠️ <strong>Attention Needed:</strong> <%= @low_stock_count %> parts are below their reorder point and may need replenishment.
    </div>
  <% end %>
  
  <div class="section-title">Inventory Details</div>
  
  <table class="inventory-table">
    <thead>
      <tr>
        <th width="5%">#</th>
        <th width="20%">Part Name / Number</th>
        <th width="10%">Category</th>
        <th width="8%" class="numeric">Current</th>
        <th width="8%" class="numeric">Min</th>
        <th width="8%" class="numeric">Reorder</th>
        <th width="8%">Status</th>
        <th width="10%" class="currency">Unit Cost</th>
        <th width="10%" class="currency">Selling Price</th>
        <th width="10%" class="currency">Total Value</th>
      </tr>
    </thead>
    <tbody>
      <% @parts.each_with_index do |part, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td>
            <strong><%= part.name %></strong>
            <% if part.part_number.present? %>
              <br><small class="text-muted"><%= part.part_number %></small>
            <% end %>
          </td>
          <td><%= part.category || "-" %></td>
          <td class="numeric"><%= part.current_stock %></td>
          <td class="numeric"><%= part.minimum_stock %></td>
          <td class="numeric"><%= part.reorder_point %></td>
          <td>
            <span class="stock-status status-<%= part.stock_status %>">
              <%= part.stock_status.humanize %>
            </span>
          </td>
          <td class="currency"><%= number_to_currency(part.cost_price) %></td>
          <td class="currency"><%= number_to_currency(part.selling_price) %></td>
          <td class="currency"><%= number_to_currency(part.stock_value) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="9" style="text-align: right; font-weight: bold;">Total Inventory Value:</td>
        <td class="currency" style="font-weight: bold; background-color: #f8f9fa;"><%= number_to_currency(@total_stock_value) %></td>
      </tr>
    </tfoot>
  </table>
  
  <% if @low_stock_parts.present? %>
    <div class="page-break"></div>
    <div class="section-title">Low Stock Items - Requiring Attention</div>
    
    <table class="table-sm">
      <thead>
        <tr>
          <th width="5%">#</th>
          <th width="25%">Part Name / Number</th>
          <th width="15%" class="numeric">Current</th>
          <th width="15%" class="numeric">Reorder Point</th>
          <th width="15%" class="numeric">Shortfall</th>
          <th width="25%" class="numeric">Suggested Reorder Qty</th>
        </tr>
      </thead>
      <tbody>
        <% @low_stock_parts.each_with_index do |part, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td>
              <strong><%= part.name %></strong>
              <% if part.part_number.present? %>
                <br><small class="text-muted"><%= part.part_number %></small>
              <% end %>
            </td>
            <td class="numeric"><%= part.current_stock %></td>
            <td class="numeric"><%= part.reorder_point %></td>
            <td class="numeric">
              <% shortfall = part.reorder_point - part.current_stock %>
              <% if shortfall > 0 %>
                <span style="color: #dc3545;"><%= shortfall %></span>
              <% else %>
                0
              <% end %>
            </td>
            <td class="numeric"><strong><%= part.suggested_reorder_quantity %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  
  <% if @transactions.present? && params[:include_transactions] == "1" %>
    <div class="page-break"></div>
    <div class="section-title">Recent Stock Movements (Last 30 Days)</div>
    
    <table class="table-sm">
      <thead>
        <tr>
          <th width="10%">Date</th>
          <th width="25%">Part</th>
          <th width="15%">Type</th>
          <th width="10%" class="numeric">Qty</th>
          <th width="15%" class="currency">Unit Price</th>
          <th width="15%" class="currency">Total</th>
          <th width="10%">User</th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each do |transaction| %>
          <tr>
            <td><%= transaction.created_at.strftime("%Y-%m-%d") %></td>
            <td>
              <% if transaction.inventory_item.respond_to?(:name) %>
                <%= transaction.inventory_item.name %>
              <% else %>
                N/A
              <% end %>
            </td>
            <td><%= transaction.transaction_type.humanize %></td>
            <td class="numeric">
              <% if transaction.is_positive_movement? %>
                <span style="color: #28a745;">+<%= transaction.quantity %></span>
              <% else %>
                <span style="color: #dc3545;">-<%= transaction.quantity %></span>
              <% end %>
            </td>
            <td class="currency"><%= number_to_currency(transaction.unit_price) %></td>
            <td class="currency"><%= number_to_currency(transaction.total_price) %></td>
            <td><%= transaction.user&.name || "System" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% else %>
  <div class="section" style="text-align: center; padding: 40px;">
    <h3>No inventory data found</h3>
    <p class="text-muted">No parts match the selected criteria.</p>
  </div>
<% end %>

<div class="document-footer">
  <p>
    Report generated by ActivePlus Demo System • 
    Page <span class="page-number">1</span> • 
    Confidential - For internal use only
  </p>
  <p class="small text-muted">
    This is an automatically generated report. Any discrepancies should be reported to the inventory department.
  </p>
</div>