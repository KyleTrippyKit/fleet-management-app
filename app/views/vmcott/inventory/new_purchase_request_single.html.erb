<%# app/views/vmcott/inventory/new_purchase_request_single.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-cart-plus me-2"></i>Purchase Request for <%= @part.name %>
              </h4>
              <small class="opacity-75">Part Number: <%= @part.part_number || 'N/A' %></small>
            </div>
            <div>
              <%= link_to new_purchase_request_vmcott_inventory_path, class: 'btn btn-sm btn-outline-light' do %>
                <i class="fas fa-list me-1"></i> All Parts
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <div class="part-info mb-4">
                <h5>Part Information</h5>
                <table class="table table-sm">
                  <tr>
                    <th>Name:</th>
                    <td><%= @part.name %></td>
                  </tr>
                  <tr>
                    <th>Part Number:</th>
                    <td><%= @part.part_number || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th>Category:</th>
                    <td><%= @part.category || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th>Description:</th>
                    <td><%= @part.description || 'No description' %></td>
                  </tr>
                  <tr>
                    <th>Supplier:</th>
                    <td>
                      <% if @part.supplier %>
                        <span class="badge bg-info"><%= @part.supplier.name %></span>
                      <% else %>
                        <span class="badge bg-secondary">No supplier</span>
                      <% end %>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="stock-info mb-4">
                <h5>Stock Information</h5>
                <table class="table table-sm">
                  <tr>
                    <th>Current Stock:</th>
                    <td>
                      <span class="badge <%= @part.stock_status == 'out_of_stock' ? 'bg-danger' : @part.stock_status == 'low_stock' ? 'bg-warning' : 'bg-success' %>">
                        <%= @part.current_stock %> units
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <th>Minimum Stock:</th>
                    <td><%= @part.minimum_stock %> units</td>
                  </tr>
                  <tr>
                    <th>Reorder Point:</th>
                    <td><%= @part.reorder_point %> units</td>
                  </tr>
                  <tr>
                    <th>Stock Status:</th>
                    <td><%= @part.stock_status.titleize %></td>
                  </tr>
                  <tr>
                    <th>Days of Supply:</th>
                    <td><%= @part.days_of_supply.round(1) %> days</td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="pricing-info mb-4">
                <h5>Pricing Information</h5>
                <table class="table table-sm">
                  <tr>
                    <th>Cost Price:</th>
                    <td><%= number_to_currency(@part.cost_price) %></td>
                  </tr>
                  <tr>
                    <th>Selling Price:</th>
                    <td><%= number_to_currency(@part.selling_price) %></td>
                  </tr>
                  <tr>
                    <th>Markup:</th>
                    <td><%= @part.markup_percentage %>%</td>
                  </tr>
                  <tr>
                    <th>Profit per Unit:</th>
                    <td><%= number_to_currency(@part.profit_amount) %></td>
                  </tr>
                </table>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="purchase-form">
                <h5>Purchase Request Details</h5>
                <%= form_with model: @purchase_request, url: inventory_create_purchase_request_path(@part), local: true do |f| %>
                  <div class="mb-3">
                    <%= f.label :quantity, "Quantity to Request", class: 'form-label' %>
                    <div class="input-group">
                      <%= f.number_field :quantity, class: 'form-control', min: 1, required: true %>
                      <span class="input-group-text">units</span>
                    </div>
                    <div class="form-text">
                      <small>
                        <i class="fas fa-lightbulb"></i> Suggested quantity: <%= @part.suggested_reorder_quantity %> units
                        (will bring stock to <%= @part.reorder_point * 1.2 %> units)
                      </small>
                    </div>
                  </div>
                  
                  <div class="mb-3">
                    <%= f.label :urgency, "Urgency Level", class: 'form-label' %>
                    <%= f.select :urgency, 
                          options_for_select([
                            ['Normal - Process within 7 days', 'normal'],
                            ['High - Process within 3 days', 'high'],
                            ['Critical - Process within 24 hours', 'critical']
                          ], @part.current_stock <= @part.minimum_stock ? 'high' : 'normal'), 
                          {}, 
                          class: 'form-select' %>
                  </div>
                  
                  <div class="mb-3">
                    <%= f.label :notes, "Additional Notes", class: 'form-label' %>
                    <%= f.text_area :notes, class: 'form-control', rows: 3, 
                          placeholder: "Add any special instructions or requirements..." %>
                  </div>
                  
                  <div class="mb-4">
                    <div class="alert alert-info">
                      <i class="fas fa-calculator me-2"></i>
                      <strong>Estimated Cost:</strong> 
                      <span id="estimated-cost">$0.00</span>
                      <br>
                      <small class="text-muted">(Based on current cost price)</small>
                    </div>
                  </div>
                  
                  <div class="d-flex justify-content-between">
                    <%= link_to 'Cancel', new_purchase_request_vmcott_inventory_path, class: 'btn btn-secondary' %>
                    <%= f.submit 'Submit Purchase Request', class: 'btn btn-primary', 
                          data: { confirm: "Submit purchase request for #{@part.name}?" } %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const quantityInput = document.querySelector('#purchase_request_quantity');
  const estimatedCost = document.getElementById('estimated-cost');
  const costPrice = <%= @part.cost_price || 0 %>;
  
  function updateEstimatedCost() {
    const quantity = parseInt(quantityInput.value) || 0;
    const totalCost = quantity * costPrice;
    estimatedCost.textContent = '$' + totalCost.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
  }
  
  if (quantityInput) {
    quantityInput.addEventListener('input', updateEstimatedCost);
    // Initial calculation
    updateEstimatedCost();
  }
});
</script>