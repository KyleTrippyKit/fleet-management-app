<%# app/views/vmcott/inventory/new_purchase_request.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-cart-plus me-2"></i>New Purchase Request
              </h4>
              <small class="opacity-75">Create purchase requests from inventory items</small>
            </div>
            <div>
              <%= link_to vmcott_inventory_dashboard_path, class: 'btn btn-sm btn-outline-light' do %>
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if @parts.present? %>
            <div class="alert alert-info mb-4">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Instructions:</strong> Select parts from inventory that need to be reordered. 
              Purchase requests will be sent for approval before becoming purchase orders.
            </div>
            
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th width="5%">#</th>
                    <th width="25%">Part Details</th>
                    <th width="15%">Stock Status</th>
                    <th width="15%">Supplier</th>
                    <th width="20%">Pricing</th>
                    <th width="20%">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts.each_with_index do |part, index| %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td>
                        <strong><%= part.name %></strong>
                        <% if part.part_number.present? %>
                          <br><small class="text-muted"><i class="fas fa-hashtag"></i> <%= part.part_number %></small>
                        <% end %>
                        <% if part.description.present? %>
                          <br><small class="text-muted"><%= truncate(part.description, length: 50) %></small>
                        <% end %>
                      </td>
                      <td>
                        <div class="stock-status">
                          <span class="badge <%= part.stock_status == 'out_of_stock' ? 'bg-danger' : part.stock_status == 'low_stock' ? 'bg-warning' : 'bg-success' %>">
                            <%= part.current_stock %> units
                          </span>
                          <br>
                          <small class="text-muted">
                            Min: <%= part.minimum_stock %> | Reorder: <%= part.reorder_point %>
                          </small>
                        </div>
                      </td>
                      <td>
                        <% if part.supplier.present? %>
                          <span class="badge bg-info"><%= part.supplier.name %></span>
                          <% if part.supplier.email.present? %>
                            <br><small class="text-muted"><%= part.supplier.email %></small>
                          <% end %>
                        <% else %>
                          <span class="badge bg-secondary">No supplier</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="pricing-info">
                          <small class="text-muted d-block">Cost: <%= number_to_currency(part.cost_price) %></small>
                          <small class="text-muted d-block">Selling: <%= number_to_currency(part.selling_price) %></small>
                          <small class="text-muted d-block">Markup: <%= part.markup_percentage %>%</small>
                        </div>
                      </td>
                      <td>
                        <%= form_with url: "/vmcott/inventory/create_purchase_request/#{part.id}", method: :post, local: true, class: 'purchase-request-form' do |f| %>
                          <div class="input-group input-group-sm">
                            <%= f.number_field :quantity, 
                                  value: part.suggested_reorder_quantity, 
                                  min: 1, 
                                  class: 'form-control', 
                                  placeholder: 'Qty',
                                  style: 'width: 80px;' %>
                            
                            <%= f.select :urgency, 
                                  options_for_select([
                                    ['Normal', 'normal'],
                                    ['High', 'high'],
                                    ['Critical', 'critical']
                                  ], part.current_stock <= part.minimum_stock ? 'high' : 'normal'), 
                                  {}, 
                                  class: 'form-select form-select-sm', 
                                  style: 'width: 100px;' %>
                            
                            <%= f.submit 'Request', class: 'btn btn-sm btn-primary' %>
                          </div>
                          
                          <div class="mt-2">
                            <small class="text-muted">
                              <i class="fas fa-lightbulb"></i> Suggested: <%= part.suggested_reorder_quantity %> units
                            </small>
                          </div>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <% if @parts.total_pages > 1 %>
              <div class="d-flex justify-content-center mt-4">
                <%= paginate @parts, theme: 'bootstrap-5' %>
              </div>
            <% end %>
            
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
              <h4 class="text-muted">No Parts Available</h4>
              <p class="text-muted mb-4">There are no parts in inventory that need reordering.</p>
              <div class="d-flex justify-content-center gap-3">
                <%= link_to 'View All Parts', parts_path, class: 'btn btn-outline-primary' %>
                <%= link_to 'Add New Part', new_part_path, class: 'btn btn-primary' %>
                <%= link_to 'Check Low Stock', low_stock_vmcott_inventory_path, class: 'btn btn-warning' %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-footer">
          <div class="row">
            <div class="col-md-6">
              <div class="stats-summary">
                <small class="text-muted">
                  <i class="fas fa-chart-bar me-1"></i>
                  Showing <strong><%= @parts.count %></strong> parts
                  <% if @parts.respond_to?(:total_count) %>
                    out of <strong><%= @parts.total_count %></strong> total
                  <% end %>
                </small>
              </div>
            </div>
            <div class="col-md-6 text-end">
              <div class="btn-group">
                <%= link_to 'View Purchase Requests', vmcott_purchase_requests_path, class: 'btn btn-outline-secondary' %>
                <%= link_to 'Generate Low Stock Report', vmcott_inventory_low_stock_path, class: 'btn btn-outline-warning' %>
<%= link_to 'Export to Excel', vmcott_inventory_export_report_path(format: :xlsx), class: 'btn btn-outline-success' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.purchase-request-form .input-group {
  width: auto;
  display: inline-flex;
}

.stock-status .badge {
  font-size: 0.85em;
  padding: 0.35em 0.65em;
}

.pricing-info small {
  font-size: 0.8em;
  line-height: 1.2;
}

.table td {
  vertical-align: middle;
}

.card {
  border: none;
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.card-header {
  border-bottom: 1px solid rgba(0, 0, 0, 0.125);
}
</style>