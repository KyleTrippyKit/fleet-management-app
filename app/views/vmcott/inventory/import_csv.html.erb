<%# app/views/vmcott/inventory/import_csv.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="bi bi-upload text-primary me-2"></i>Import Inventory from CSV
              </h4>
              <small class="text-muted">Upload a CSV file to import parts into inventory</small>
            </div>
            <div>
              <%= link_to 'Back to Dashboard', vmcott_inventory_dashboard_path, class: 'btn btn-sm btn-outline-secondary' %>
            </div>
          </div>
        </div>
        
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <h5 class="card-title">Upload CSV File</h5>
                  <p class="card-text">Select a CSV file containing your inventory data.</p>
                  
                  <%= form_with url: vmcott_inventory_import_csv_path, method: :post, multipart: true, local: true do |f| %>
                    <div class="mb-3">
                      <%= f.file_field :csv_file, class: 'form-control', accept: '.csv' %>
                      <small class="form-text text-muted">File must be in CSV format (.csv)</small>
                    </div>
                    
                    <div class="mb-3">
                      <div class="form-check">
                        <%= check_box_tag :update_existing, '1', true, class: 'form-check-input' %>
                        <label class="form-check-label">
                          Update existing parts
                        </label>
                      </div>
                      <small class="form-text text-muted">Update parts if they already exist</small>
                    </div>
                    
                    <div class="d-grid">
                      <%= f.submit 'Import CSV', class: 'btn btn-primary' %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <h5 class="card-title">CSV Format Requirements</h5>
                  <p class="card-text">Your CSV file must include these columns:</p>
                  
                  <div class="table-responsive">
                    <table class="table table-sm">
                      <thead>
                        <tr>
                          <th>Column Name</th>
                          <th>Description</th>
                          <th>Required</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td><code>name</code></td>
                          <td>Part name</td>
                          <td><span class="badge bg-danger">Yes</span></td>
                        </tr>
                        <tr>
                          <td><code>part_number</code></td>
                          <td>Part/SKU number</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>category</code></td>
                          <td>Category</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>description</code></td>
                          <td>Description</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>cost_price</code></td>
                          <td>Cost price</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>sale_price</code></td>
                          <td>Selling price</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>current_stock</code></td>
                          <td>Current quantity</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>minimum_stock</code></td>
                          <td>Minimum stock level</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>reorder_point</code></td>
                          <td>Reorder point</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>unit_of_measure</code></td>
                          <td>Unit of measure</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>is_consumable</code></td>
                          <td>True/False</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                        <tr>
                          <td><code>supplier_name</code></td>
                          <td>Supplier name</td>
                          <td><span class="badge bg-secondary">No</span></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                  
                  <div class="mt-3">
                    <%= link_to download_csv_template_path, class: 'btn btn-outline-primary btn-sm' do %>
                      <i class="bi bi-download me-1"></i>Download Template
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="alert alert-info mt-4">
            <h5><i class="bi bi-info-circle me-2"></i>Import Tips</h5>
            <ul class="mb-0">
              <li>The first row must contain column headers</li>
              <li>Use UTF-8 encoding for special characters</li>
              <li>Empty cells will use default values</li>
              <li>Supplier names will be matched or created</li>
              <li>Large files may take a few minutes to process</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>