<%# app/views/vmcott/vehicle_condition_reports/show.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-clipboard-check me-2"></i>
      Condition Report #<%= @report.id %>
    </h1>
    <div>
      <%= link_to "← Back", vmcott_vehicle_condition_reports_path, class: "btn btn-outline-secondary me-2" %>
      <%= link_to "Print", print_vmcott_vehicle_condition_report_path(@report), class: "btn btn-outline-primary me-2" %>
      <% if @report.status == 'completed' && (current_user.admin? || current_user.security_gate_officer?) %>
        <%= button_to "Mark as Disputed", dispute_vmcott_vehicle_condition_report_path(@report), 
            method: :post,
            class: "btn btn-outline-danger",
            data: { confirm: "Are you sure you want to mark this report as disputed?" } %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Main Report Card -->
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Vehicle Information</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th width="40%">License Plate:</th>
                  <td><strong><%= @report.vehicle&.license_plate || 'N/A' %></strong></td>
                </tr>
                <tr>
                  <th>Make/Model:</th>
                  <td><%= @report.vehicle&.make %> <%= @report.vehicle&.model %></td>
                </tr>
                <tr>
                  <th>Year:</th>
                  <td><%= @report.vehicle&.year_of_manufacture %></td>
                </tr>
                <tr>
                  <th>Color:</th>
                  <td><%= @report.vehicle&.color %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th width="40%">Agency:</th>
                  <td><span class="badge bg-primary"><%= @report.vehicle&.agency&.code || 'Public' %></span></td>
                </tr>
                <tr>
                  <th>Reported By:</th>
                  <td><%= @report.security_gate_officer&.name || 'Unknown' %></td>
                </tr>
                <tr>
                  <th>Reported At:</th>
                  <td><%= @report.created_at.strftime("%b %d, %Y at %I:%M %p") %></td>
                </tr>
                <tr>
                  <th>Status:</th>
                  <td>
                    <% case @report.status %>
                    <% when 'completed' %>
                      <span class="badge bg-success">Completed</span>
                    <% when 'draft' %>
                      <span class="badge bg-secondary">Draft</span>
                    <% when 'disputed' %>
                      <span class="badge bg-danger">Disputed</span>
                    <% else %>
                      <span class="badge bg-info"><%= @report.status %></span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Condition Details Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header <%= @report.exterior_damage? ? 'bg-warning' : 'bg-success' %> text-white">
          <h5 class="mb-0"><i class="bi bi-clipboard-data me-2"></i> Condition Details</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6 class="fw-bold">Quick Stats</h6>
              <table class="table table-sm">
                <tr>
                  <th>Fuel Level:</th>
                  <td><%= @report.fuel_level %>%</td>
                </tr>
                <tr>
                  <th>Odometer:</th>
                  <td><%= @report.odometer %> km</td>
                </tr>
              </table>
              
              <h6 class="fw-bold mt-3">Exterior Condition</h6>
              <p><%= @report.exterior_damage_summary %></p>
              
              <h6 class="fw-bold mt-3">Interior Condition</h6>
              <p><%= @report.interior_summary %></p>
            </div>
            
            <div class="col-md-6">
              <h6 class="fw-bold">Tires</h6>
              <p><%= @report.tire_status_display %></p>
              <% if @report.tire_notes.present? %>
                <small class="text-muted"><%= @report.tire_notes %></small>
              <% end %>
              
              <h6 class="fw-bold mt-3">Warning Lights</h6>
              <p><%= @report.warning_lights_display %></p>
            </div>
          </div>
          
          <% if @report.additional_notes.present? %>
            <div class="mt-3 p-3 bg-light rounded">
              <strong>Additional Notes:</strong><br>
              <%= @report.additional_notes %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Photos Section -->
      <% if @report.condition_photos.attached? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-camera me-2"></i> Photos</h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <% @report.condition_photos.each do |photo| %>
                <div class="col-md-4 col-6">
                  <a href="<%= url_for(photo) %>" target="_blank">
                    <%= image_tag photo, class: "img-fluid rounded border", style: "width: 100%; height: 150px; object-fit: cover;" %>
                  </a>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
      <!-- Driver Signature Card - FIXED signed_at handling -->
      <% if @report.signature_data.present? %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-pen me-2"></i> Driver Signature</h5>
          </div>
          <div class="card-body text-center">
            <img src="<%= @report.signature_data %>" style="max-width: 100%; max-height: 150px; background: #f8f9fa; padding: 10px; border-radius: 5px;">
            <p class="mt-2 mb-0">
              <strong><%= @report.driver_name %></strong><br>
              <small class="text-muted">
                Signed at 
                <% if @report.signed_at.present? %>
                  <% if @report.signed_at.is_a?(String) %>
                    <%= @report.signed_at %>
                  <% else %>
                    <%= @report.signed_at.strftime("%I:%M %p") %>
                  <% end %>
                <% else %>
                  Unknown time
                <% end %>
              </small>
            </p>
            <% if @report.driver_id_number.present? %>
              <p class="mb-0"><small>ID: <%= @report.driver_id_number %></small></p>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Reception Log Link -->
      <% if @reception_log %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-journal me-2"></i> Related Check-in</h5>
          </div>
          <div class="card-body">
            <p>
              <strong>Check-in Time:</strong><br>
              <%= @reception_log.received_at.strftime("%b %d, %Y at %I:%M %p") %>
            </p>
            <%= link_to "View Check-in Details", vmcott_security_gate_officer_reception_log_path(@reception_log), class: "btn btn-sm btn-outline-primary w-100" %>
          </div>
        </div>
      <% end %>

      <!-- Report Metadata -->
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Report Metadata</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-0">
            <li class="mb-2">
              <strong>Report ID:</strong><br>
              <code>#<%= @report.id %></code>
            </li>
            <li class="mb-2">
              <strong>Created:</strong><br>
              <%= @report.created_at.strftime("%b %d, %Y %I:%M %p") %>
            </li>
            <li class="mb-2">
              <strong>Last Updated:</strong><br>
              <%= time_ago_in_words(@report.updated_at) %> ago
            </li>
            <% if @report.ip_address.present? %>
              <li class="mb-2">
                <strong>IP Address:</strong><br>
                <%= @report.ip_address %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>