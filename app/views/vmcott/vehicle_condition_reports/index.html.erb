<%# app/views/vmcott/vehicle_condition_reports/index.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-clipboard-check me-2"></i>
      <%= params[:action] == 'today' ? "Today's Condition Reports" : "All Condition Reports" %>
    </h1>
    <%= link_to "← Back to Dashboard", vmcott_security_gate_officer_dashboard_path, class: "btn btn-outline-primary" %>
  </div>

  <!-- Filter Tabs - UPDATED WITH CORRECT ROUTE HELPERS -->
  <ul class="nav nav-tabs mb-4">
    <li class="nav-item">
      <%= link_to "All Reports", vmcott_vehicle_condition_reports_path, class: "nav-link #{'active' if params[:action] == 'index' && !params[:damage]}" %>
    </li>
    <li class="nav-item">
      <%= link_to "Today", today_vmcott_vehicle_condition_reports_path, class: "nav-link #{'active' if params[:action] == 'today'}" %>
    </li>
    <li class="nav-item">
      <%= link_to "With Damage", with_damage_vmcott_vehicle_condition_reports_path, class: "nav-link #{'active' if params[:action] == 'with_damage'}" %>
    </li>
  </ul>

  <!-- Reports Table -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Date/Time</th>
              <th>Vehicle</th>
              <th>Officer</th>
              <th>Driver</th>
              <th>Condition</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr>
                <td>
                  <strong><%= report.created_at.strftime("%b %d, %Y") %></strong><br>
                  <small class="text-muted"><%= report.created_at.strftime("%I:%M %p") %></small>
                </td>
                <td>
                  <strong><%= report.vehicle&.license_plate || 'N/A' %></strong><br>
                  <small class="text-muted"><%= report.vehicle&.make %> <%= report.vehicle&.model %></small>
                </td>
                <td><%= report.security_gate_officer&.name || 'Unknown' %></td>
                <td><%= report.driver_name %></td>
                <td>
                  <% if report.exterior_damage? %>
                    <span class="badge bg-warning">⚠️ Damage</span>
                    <small class="d-block text-muted"><%= report.exterior_damage_summary %></small>
                  <% else %>
                    <span class="badge bg-success">✅ Clean</span>
                  <% end %>
                </td>
                <td>
                  <% case report.status %>
                  <% when 'completed' %>
                    <span class="badge bg-success">Completed</span>
                  <% when 'draft' %>
                    <span class="badge bg-secondary">Draft</span>
                  <% when 'disputed' %>
                    <span class="badge bg-danger">Disputed</span>
                  <% else %>
                    <span class="badge bg-info"><%= report.status %></span>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to vmcott_vehicle_condition_report_path(report), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-eye"></i> View
                  <% end %>
                  <%= link_to print_vmcott_vehicle_condition_report_path(report), class: "btn btn-sm btn-outline-secondary" do %>
                    <i class="bi bi-printer"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    
    <% if @reports.respond_to?(:total_pages) && @reports.total_pages > 1 %>
      <div class="card-footer">
        <div class="d-flex justify-content-center">
          <%= paginate @reports %>
        </div>
      </div>
    <% end %>
    
    <% if @reports.empty? %>
      <div class="text-center py-5">
        <i class="bi bi-clipboard-x" style="font-size: 3rem; color: #ccc;"></i>
        <p class="text-muted mt-3">No condition reports found</p>
      </div>
    <% end %>
  </div>
</div>