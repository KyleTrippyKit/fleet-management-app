<%# app/views/vmcott/procurement/dashboard/upload_quotation.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-md-10 mx-auto">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-upload me-2"></i>
            Upload Vendor Quotations for RFQ #<%= @rfq.rfq_number %>
          </h5>
          <p class="small mb-0 mt-1 text-white-50">Add quotations from suppliers who have responded</p>
        </div>
        <div class="card-body p-4">
          
          <!-- Display RFQ Info -->
          <div class="alert alert-info mb-4 border-0 bg-light">
            <div class="row">
              <div class="col-md-6">
                <h6 class="fw-bold mb-2">RFQ Details:</h6>
                <p class="mb-0">
                  <strong>RFQ Number:</strong> <%= @rfq.rfq_number %><br>
                  <strong>Due Date:</strong> <%= @rfq.due_date&.strftime("%b %d, %Y") || 'Not set' %><br>
                  <strong>Status:</strong> <%= @rfq.status.humanize %>
                </p>
              </div>
              <div class="col-md-6">
                <h6 class="fw-bold mb-2">Parts Requested:</h6>
                <ul class="mb-0">
                  <% @rfq.vendor_rfq_items.each do |item| %>
                    <li>
                      <strong><%= item.part&.name || item.custom_part_name || 'Unknown Part' %></strong>
                      (Qty: <%= item.quantity %>)
                      <% if item.description.present? %>
                        <br><small class="text-muted"><%= item.description %></small>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>

          <%= form_with url: vmcott_procurement_create_quotation_path(@rfq), 
                        method: :post, 
                        local: true,
                        multipart: true,
                        class: "needs-validation" do |f| %>
            
            <!-- Supplier Selection - AUTO-SELECTED from URL parameter -->
            <div class="mb-4">
              <label class="form-label fw-bold">Supplier <span class="text-danger">*</span></label>
              <% if @preselected_supplier.present? %>
                <div class="alert alert-success mb-2 d-flex align-items-center">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <div>
                    Uploading quotation for: <strong><%= @preselected_supplier.name %></strong>
                    <% if @preselected_supplier.contact_person.present? %>
                      <br><small class="text-muted">Contact: <%= @preselected_supplier.contact_person %></small>
                    <% end %>
                  </div>
                  <input type="hidden" name="vendor_quotation[supplier_id]" value="<%= @preselected_supplier.id %>">
                </div>
                <div class="small text-muted">
                  <i class="bi bi-info-circle"></i> 
                  This quotation will be linked to <%= @preselected_supplier.name %>.
                  <%= link_to "Upload for a different supplier?", vmcott_procurement_upload_quotation_path(rfq_id: @rfq.id), class: "ms-2" %>
                </div>
              <% else %>
                <select name="vendor_quotation[supplier_id]" class="form-select" required>
                  <option value="">Select a supplier</option>
                  <% @suppliers.each do |supplier| %>
                    <option value="<%= supplier.id %>">
                      <%= supplier.name %>
                      <% if supplier.contact_person.present? %> - <%= supplier.contact_person %><% end %>
                    </option>
                  <% end %>
                </select>
                <div class="small text-muted mt-1">Select the supplier that provided this quotation</div>
              <% end %>
            </div>
            
            <!-- Parts & Prices Section - Single supplier version with flat naming -->
            <div class="mb-4">
              <label class="form-label fw-bold">Parts & Prices</label>
              <div class="card border">
                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-sm">
                      <thead>
                        <tr>
                          <th>Part</th>
                          <th>Quantity</th>
                          <th class="text-end">Unit Price ($)</th>
                          <th class="text-end">Total ($)</th>
                         </thead>
                      <tbody>
                        <% @rfq.vendor_rfq_items.each_with_index do |item, idx| %>
                          <tr class="item-row" data-item-id="<%= item.id %>">
                            <td>
                              <strong><%= item.part&.name || item.custom_part_name || 'Unknown Part' %></strong>
                              <% if item.description.present? %>
                                <br><small class="text-muted"><%= item.description %></small>
                              <% end %>
                              <!-- Store RFQ item ID for reference -->
                              <input type="hidden" name="items[<%= item.id %>][rfq_item_id]" value="<%= item.id %>">
                              <input type="hidden" name="items[<%= item.id %>][part_id]" value="<%= item.part_id %>">
                              <input type="hidden" name="items[<%= item.id %>][quantity]" value="<%= item.quantity %>">
                             </td>
                            <td class="text-center"><%= item.quantity %></td>
                            <td class="text-end">
                              <input type="number" 
                                     name="unit_price_<%= item.id %>" 
                                     class="form-control form-control-sm unit-price text-end" 
                                     step="0.01" 
                                     min="0" 
                                     placeholder="0.00"
                                     data-quantity="<%= item.quantity %>"
                                     data-item-id="<%= item.id %>"
                                     required>
                             </td>
                            <td class="text-end">
                              <span class="total-price fw-semibold text-success" data-item-id="<%= item.id %>">$0.00</span>
                             </td>
                           </tr>
                        <% end %>
                      </tbody>
                      <tfoot>
                        <tr class="table-active">
                          <td colspan="3" class="text-end fw-bold">Grand Total:</td>
                          <td class="text-end fw-bold text-success fs-5" id="grand-total">$0.00</td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Notes -->
            <div class="mb-4">
              <label class="form-label fw-bold">Notes (Optional)</label>
              <textarea name="vendor_quotation[notes]" class="form-control" rows="3" placeholder="e.g., Delivery time, warranty information, special conditions..."></textarea>
            </div>
            
            <!-- Attachment -->
            <div class="mb-4">
              <label class="form-label fw-bold">Attachment (Optional)</label>
              <input type="file" name="vendor_quotation[attachment]" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
              <small class="text-muted">Upload PDF, JPG, or PNG files (max 5MB)</small>
            </div>
            
            <!-- Submit Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
              <%= link_to "Cancel", vmcott_vendor_rfq_path(@rfq), class: "btn btn-outline-secondary rounded-pill px-4" %>
              <%= f.submit "Upload Quotation", class: "btn btn-primary rounded-pill px-4", id: "submit-btn" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get all unit price inputs
  const unitPriceInputs = document.querySelectorAll('.unit-price');
  const grandTotalSpan = document.getElementById('grand-total');
  const submitBtn = document.getElementById('submit-btn');
  
  function calculateAllTotals() {
    let grandTotal = 0;
    
    unitPriceInputs.forEach(input => {
      const quantity = parseFloat(input.dataset.quantity) || 0;
      const unitPrice = parseFloat(input.value) || 0;
      const total = quantity * unitPrice;
      const itemId = input.dataset.itemId;
      const totalSpan = document.querySelector(`.total-price[data-item-id="${itemId}"]`);
      
      if (totalSpan) {
        totalSpan.textContent = `$${total.toFixed(2)}`;
      }
      
      grandTotal += total;
    });
    
    if (grandTotalSpan) {
      grandTotalSpan.textContent = `$${grandTotal.toFixed(2)}`;
    }
    
    // Enable/disable submit button
    if (submitBtn) {
      const hasAnyPrice = Array.from(unitPriceInputs).some(input => parseFloat(input.value) > 0);
      submitBtn.disabled = !hasAnyPrice;
    }
  }
  
  // Add event listeners to each unit price input
  unitPriceInputs.forEach(input => {
    input.addEventListener('input', calculateAllTotals);
    input.addEventListener('blur', function() {
      if (this.value && parseFloat(this.value) < 0) {
        this.value = 0;
        calculateAllTotals();
      }
    });
  });
  
  // Initial calculation
  calculateAllTotals();
});
</script>

<style>
  .unit-price:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
  }
  .total-price {
    font-weight: 600;
  }
  #grand-total {
    font-weight: bold;
  }
  .alert-info {
    background-color: #f8fafc;
    border-left: 4px solid #3b82f6;
  }
  .alert-success {
    background-color: #d1fae5;
    border: 1px solid #10b981;
  }
</style>