<%# app/views/vmcott/procurement/dashboard/index.html.erb %>
<%# Procurement Dashboard - RFQs and vendor communication %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">
        <i class="bi bi-envelope-paper me-2"></i>
        Procurement Dashboard
      </h1>
      <p class="text-muted">Manage RFQs, vendor quotations, and purchase orders for low stock items</p>
    </div>
    <div class="col-auto">
      <div class="btn-group">
        <%= link_to "🏢 Suppliers", suppliers_path, class: "btn btn-outline-primary" %>
        <%= link_to "⚠️ Low Stock Requests", vmcott_procurement_low_stock_requests_path, class: "btn btn-danger" %>
      </div>
    </div>
  </div>

  <!-- KPI Cards Row - FORCED STYLES -->
  <div class="row mb-4 g-3">
    <!-- Card 1: Low Stock Requests -->
    <div class="col-md-3">
      <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #dc3545 0%, #b91c1c 100%) !important; border: none !important;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="mb-1 text-uppercase small fw-semibold" style="color: #ffffff !important; letter-spacing: 0.5px; opacity: 0.9;">Low Stock Requests</p>
              <h2 class="mb-0 fw-bold" style="color: #ffffff !important; font-size: 2.5rem;"><%= @low_stock_requests_count || 0 %></h2>
            </div>
            <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-exclamation-triangle fs-3" style="color: #ffffff;"></i>
            </div>
          </div>
          <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.85) !important;">From Inventory Manager</p>
        </div>
      </div>
    </div>

    <!-- Card 2: Parts to Quote -->
    <div class="col-md-3">
      <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important; border: none !important;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="mb-1 text-uppercase small fw-semibold" style="color: #ffffff !important; letter-spacing: 0.5px; opacity: 0.9;">Parts to Quote</p>
              <h2 class="mb-0 fw-bold" style="color: #ffffff !important; font-size: 2.5rem;"><%= @stats[:parts_to_quote] || 0 %></h2>
            </div>
            <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-file-text fs-3" style="color: #ffffff;"></i>
            </div>
          </div>
          <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.85) !important;">Need RFQ creation</p>
        </div>
      </div>
    </div>

    <!-- Card 3: Active RFQs -->
    <div class="col-md-3">
      <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #ffc107 0%, #ffb347 100%) !important; border: none !important;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="mb-1 text-uppercase small fw-semibold" style="color: #1e293b !important; letter-spacing: 0.5px;">Active RFQs</p>
              <h2 class="mb-0 fw-bold" style="color: #1e293b !important; font-size: 2.5rem;"><%= @stats[:active_rfqs] || 0 %></h2>
            </div>
            <div class="rounded-circle p-2" style="background: rgba(0,0,0,0.1);">
              <i class="bi bi-send fs-3" style="color: #1e293b;"></i>
            </div>
          </div>
          <p class="mt-2 mb-0 small" style="color: #1e293b !important;">Awaiting vendor response</p>
        </div>
      </div>
    </div>

    <!-- Card 4: Quotes Received -->
    <div class="col-md-3">
      <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #198754 0%, #0f6e3f 100%) !important; border: none !important;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="mb-1 text-uppercase small fw-semibold" style="color: #ffffff !important; letter-spacing: 0.5px; opacity: 0.9;">Quotes Received</p>
              <h2 class="mb-0 fw-bold" style="color: #ffffff !important; font-size: 2.5rem;"><%= @stats[:quotes_received] || 0 %></h2>
            </div>
            <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
              <i class="bi bi-inboxes fs-3" style="color: #ffffff;"></i>
            </div>
          </div>
          <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.85) !important;">Ready to create PO</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Workflow Sections -->
  <div class="row">
    <!-- Left Column - Parts Requests -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i> Parts Requests Needing RFQ</h5>
          <span class="badge bg-light text-primary"><%= @stats[:parts_to_quote] || 0 %> items</span>
        </div>
        <div class="card-body">
          <% if @pending_parts_requests.present? && @pending_parts_requests.any? %>
            <div class="list-group list-group-flush">
              <% @pending_parts_requests.each do |pr| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <div class="fw-bold">
                        <%= pr.part&.name || pr.custom_part_name || 'Unknown Part' %>
                        <span class="badge bg-secondary ms-2">x<%= pr.quantity || 1 %></span>
                      </div>
                      <small class="text-muted d-block">
                        Vehicle: <%= pr.inspection&.vehicle&.license_plate || 'N/A' %> • 
                        <%= pr.inspection&.vehicle&.make || '' %> <%= pr.inspection&.vehicle&.model || '' %>
                      </small>
                      <% if pr.part&.supplier %>
                        <small class="text-muted">Preferred: <%= pr.part.supplier.name %></small>
                      <% end %>
                    </div>
                    <div>
                      <%= link_to "Create RFQ", 
                          vmcott_procurement_new_rfq_path(parts_request_id: pr.id),
                          class: "btn btn-sm btn-primary rounded-pill" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
              <h6 class="text-muted">No parts requests needing RFQ</h6>
              <p class="small text-muted">All parts have been processed</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column - Active RFQs -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header" style="background: linear-gradient(135deg, #ffc107 0%, #ffb347 100%);">
          <h5 class="mb-0 fw-bold" style="color: #1e293b;"><i class="bi bi-send me-2"></i> Active RFQs</h5>
        </div>
        <div class="card-body">
          <% if @active_rfqs.present? && @active_rfqs.any? %>
            <div class="list-group list-group-flush">
              <% @active_rfqs.each do |rfq| %>
                <div class="list-group-item rfq-item" data-rfq-id="<%= rfq.id %>" style="transition: all 0.3s ease;">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <div class="fw-bold">
                        <%= link_to rfq.rfq_number.presence || 'RFQ', vmcott_vendor_rfq_path(rfq), class: "text-decoration-none" %>
                        <span class="badge bg-<%= rfq.status == 'sent' ? 'success' : 'secondary' %> ms-2">
                          <%= rfq.status&.humanize || 'Draft' %>
                        </span>
                      </div>
                      <small class="text-muted d-block">
                        Sent: <%= rfq.sent_date&.strftime("%b %d, %Y") || 'Not sent' %> • 
                        Due: <%= rfq.due_date&.strftime("%b %d, %Y") || 'N/A' %>
                      </small>
                      <small class="text-muted">
                        Suppliers: <%= rfq.vendor_quotations&.count || 0 %> • 
                        Quotes received: <%= rfq.vendor_quotations&.where(status: 'received')&.count || 0 %>
                      </small>
                    </div>
                    <div>
                      <% if rfq.status == 'draft' %>
                        <%= button_to "Send RFQ", 
                            send_to_suppliers_vmcott_vendor_rfq_path(rfq.id),
                            method: :post,
                            class: "btn btn-sm btn-warning rounded-pill",
                            form: { "data-turbo" => "false" },
                            data: { confirm: "Send this RFQ to suppliers?" } %>
                      <% else %>
                        <%= link_to "Upload Quote", 
                            vmcott_procurement_upload_quotation_path(rfq_id: rfq.id),
                            class: "btn btn-sm btn-success rounded-pill" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-envelope-paper text-muted fs-1 mb-3 d-block"></i>
              <h6 class="text-muted">No active RFQs</h6>
              <p class="small text-muted">Create RFQs from parts requests</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotations Received & Purchase Orders Section -->
  <div class="row mt-2">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-inboxes me-2"></i> Quotations & Purchase Orders</h5>
          <span class="badge bg-light text-success"><%= @all_quotes&.count || 0 %> items</span>
        </div>
        <div class="card-body p-0">
          <% if @all_quotes.present? && @all_quotes.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="bg-light">
                  56
                    <th class="border-0 py-3">RFQ #</th>
                    <th class="border-0 py-3">Part</th>
                    <th class="border-0 py-3 text-center">Quotes Received</th>
                    <th class="border-0 py-3">Price Range</th>
                    <th class="border-0 py-3">Lowest Bid</th>
                    <th class="border-0 py-3">Status</th>
                    <th class="border-0 py-3 text-end">Actions</th>
                   </thead>
                <tbody>
                  <% @all_quotes.each do |rfq| %>
                    <% 
                      quotes = rfq.vendor_quotations&.where(status: 'received') || []
                      prices = []
                      quotes.each do |q|
                        total = q.vendor_quotation_lines.sum(:total_price)
                        prices << total if total > 0
                      end
                      min_price = prices.min
                      max_price = prices.max
                      
                      existing_po = PurchaseOrder.find_by(rfq_id: rfq.id)
                      
                      if existing_po.present? && existing_po.status == 'received'
                        status_badge = 'success'
                        status_text = 'Items Received ✓'
                        status_icon = 'bi-check-circle-fill'
                        action_button = link_to "View PO", 
                            purchase_order_path(existing_po),
                            class: "btn btn-success btn-sm rounded-pill"
                      elsif existing_po.present? && existing_po.status == 'sent'
                        status_badge = 'warning'
                        status_text = 'PO Sent - Pending Receipt'
                        status_icon = 'bi-send'
                        action_button = link_to "Mark Received", 
                            purchase_order_path(existing_po),
                            class: "btn btn-warning btn-sm rounded-pill"
                      elsif existing_po.present?
                        status_badge = 'info'
                        status_text = 'PO Created'
                        status_icon = 'bi-receipt'
                        action_button = link_to "Send to Vendor", 
                            submit_purchase_order_path(existing_po),
                            method: :post,
                            class: "btn btn-primary btn-sm rounded-pill",
                            data: { confirm: "Send this PO to vendor?" }
                      else
                        status_badge = 'secondary'
                        status_text = 'Ready for PO'
                        status_icon = 'bi-file-earmark-text'
                        action_button = link_to "Create PO", 
                            new_purchase_order_path(rfq_id: rfq.id),
                            class: "btn btn-primary btn-sm rounded-pill"
                      end
                    %>
                    <tr class="<%= 'table-success' if existing_po&.status == 'received' %>">
                      <td class="align-middle"><strong><%= rfq.rfq_number.presence || 'RFQ' %></strong></td>
                      <td class="align-middle">
                        <% if rfq.vendor_rfq_items.present? %>
                          <% rfq.vendor_rfq_items.each do |item| %>
                            <div><%= item.part&.name || item.custom_part_name || 'Unknown Part' %> x<%= item.quantity || 1 %></div>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No items</span>
                        <% end %>
                       </td>
                      <td class="align-middle text-center"><span class="badge bg-info"><%= quotes.count %> quotes</span> </td>
                      <td class="align-middle">
                        <% if min_price && max_price %>
                          <%= number_to_currency(min_price) %> - <%= number_to_currency(max_price) %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                       </td>
                      <td class="align-middle">
                        <% if min_price %>
                          <strong class="text-success"><%= number_to_currency(min_price) %></strong>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                       </td>
                      <td class="align-middle">
                        <span class="badge bg-<%= status_badge %> px-3 py-2" style="font-size: 0.85rem;">
                          <i class="bi <%= status_icon %> me-1"></i>
                          <%= status_text %>
                        </span>
                        <% if existing_po&.received_at %>
                          <div class="small text-muted mt-1">
                            <i class="bi bi-calendar-check"></i>
                            Received: <%= existing_po.received_at.strftime('%b %d, %Y %I:%M %p') %>
                          </div>
                        <% elsif existing_po&.sent_at %>
                          <div class="small text-muted mt-1">
                            Sent: <%= existing_po.sent_at.strftime('%b %d, %Y') %>
                          </div>
                        <% end %>
                       </td>
                      <td class="align-middle text-end">
                        <div class="btn-group btn-group-sm">
                          <%= action_button %>
                          <%= link_to "View RFQ", 
                              vmcott_vendor_rfq_path(rfq),
                              class: "btn btn-outline-secondary btn-sm rounded-pill" %>
                          <% if existing_po.present? && existing_po.status != 'sent' && existing_po.status != 'received' %>
                            <%= link_to "View PO", 
                                purchase_order_path(existing_po),
                                class: "btn btn-outline-info btn-sm rounded-pill" %>
                          <% end %>
                        </div>
                       </td>
                     </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-inboxes text-muted fs-1 mb-3 d-block"></i>
              <h6 class="text-muted">No quotations or purchase orders</h6>
              <p class="small text-muted">Quotes will appear here when received from suppliers</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Stats Footer -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card bg-light border-0">
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-3 col-6">
              <h6 class="mb-0 fw-bold"><%= @low_stock_requests_count || 0 %></h6>
              <small class="text-muted">Low Stock Requests</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0 fw-bold"><%= @stats[:parts_to_quote] || 0 %></h6>
              <small class="text-muted">To Quote</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0 fw-bold"><%= @stats[:active_rfqs] || 0 %></h6>
              <small class="text-muted">Active RFQs</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0 fw-bold"><%= @stats[:quotes_received] || 0 %></h6>
              <small class="text-muted">Quotes Received</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  setTimeout(function() {
    location.reload();
  }, 300000);
  
  const flashMessage = document.querySelector('.alert-success');
  if (flashMessage) {
    setTimeout(() => {
      flashMessage.style.transition = 'opacity 0.5s ease';
      flashMessage.style.opacity = '0';
      setTimeout(() => {
        if (flashMessage.parentNode) flashMessage.remove();
      }, 500);
    }, 3000);
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    <% if session[:highlight_rfq_id].present? %>
      const highlightId = <%= session[:highlight_rfq_id] %>;
      const rfqElement = document.querySelector(`.rfq-item[data-rfq-id="${highlightId}"]`);
      
      if (rfqElement) {
        rfqElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        rfqElement.style.backgroundColor = '#fff3cd';
        rfqElement.style.borderLeft = '4px solid #ffc107';
        
        setTimeout(() => {
          rfqElement.style.backgroundColor = '';
          rfqElement.style.borderLeft = '';
        }, 3000);
      }
      
      <% session[:highlight_rfq_id] = nil %>
    <% end %>
  });
</script>