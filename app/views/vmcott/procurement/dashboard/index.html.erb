<%# app/views/vmcott/procurement/dashboard/index.html.erb %>
<%# Procurement Dashboard - RFQs and vendor communication %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">
        <i class="bi bi-envelope-paper me-2"></i>
        Procurement Dashboard
      </h1>
      <p class="text-muted">Manage RFQs, vendor quotations, and purchase orders for low stock items</p>
    </div>
    <div class="col-auto">
      <div class="btn-group">
        <%# REMOVED: "📋 All RFQs" button %>
        <%= link_to "🏢 Suppliers", suppliers_path, class: "btn btn-outline-primary" %>
        <%# REMOVED: "📦 POs" button %>
        <%= link_to "⚠️ Low Stock Requests", vmcott_procurement_low_stock_requests_path, class: "btn btn-danger" %>
      </div>
    </div>
  </div>

  <!-- KPI Cards Row -->
  <div class="row mb-4 g-3">
    <div class="col-md-3">
      <div class="card bg-danger text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Low Stock Requests</h6>
              <h2 class="mb-0"><%= @low_stock_requests_count || 0 %></h2>
            </div>
            <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">From Inventory Manager</small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Parts to Quote</h6>
              <h2 class="mb-0"><%= @stats&.[](:parts_to_quote) || 0 %></h2>
            </div>
            <i class="bi bi-file-text fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">Need RFQ creation</small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-warning text-dark h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-dark-50 mb-1">Active RFQs</h6>
              <h2 class="mb-0"><%= @stats&.[](:active_rfqs) || 0 %></h2>
            </div>
            <i class="bi bi-send fs-1 opacity-50"></i>
          </div>
          <small class="text-dark-50">Awaiting vendor response</small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-success text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Quotes Received</h6>
              <h2 class="mb-0"><%= @stats&.[](:quotes_received) || 0 %></h2>
            </div>
            <i class="bi bi-inboxes fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">Ready to create PO</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Workflow Sections -->
  <div class="row">
    <!-- Left Column - Parts Requests -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i> Parts Requests Needing RFQ</h5>
          <span class="badge bg-light text-primary"><%= @stats&.[](:parts_to_quote) || 0 %> items</span>
        </div>
        <div class="card-body">
          <% if @pending_parts_requests.present? && @pending_parts_requests.any? %>
            <div class="list-group">
              <% @pending_parts_requests.each do |pr| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <div class="fw-bold">
                        <%= pr.part&.name || pr.custom_part_name || 'Unknown Part' %>
                        <span class="badge bg-secondary ms-2">x<%= pr.quantity || 1 %></span>
                      </div>
                      <small class="text-muted d-block">
                        Vehicle: <%= pr.inspection&.vehicle&.license_plate || 'N/A' %> • 
                        <%= pr.inspection&.vehicle&.make || '' %> <%= pr.inspection&.vehicle&.model || '' %>
                      </small>
                      <% if pr.part&.supplier %>
                        <small class="text-muted">Preferred: <%= pr.part.supplier.name %></small>
                      <% end %>
                    </div>
                    <div>
                      <%= link_to "Create RFQ", 
                          vmcott_procurement_new_rfq_path(parts_request_id: pr.id),
                          class: "btn btn-sm btn-primary" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No parts requests needing RFQ at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column - Active RFQs -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-send me-2"></i> Active RFQs</h5>
          <span class="badge bg-dark text-white"><%= @active_rfqs&.count || 0 %> RFQs</span>
        </div>
        <div class="card-body">
          <% if @active_rfqs.present? && @active_rfqs.any? %>
            <div class="list-group">
              <% @active_rfqs.each do |rfq| %>
                <div class="list-group-item rfq-item" data-rfq-id="<%= rfq.id %>" style="transition: all 0.3s ease;">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <div class="fw-bold">
                        <%= link_to rfq.rfq_number.presence || 'RFQ', vmcott_vendor_rfq_path(rfq) %>
                        <span class="badge bg-<%= rfq.status == 'sent' ? 'success' : 'secondary' %> ms-2">
                          <%= rfq.status&.humanize || 'Draft' %>
                        </span>
                      </div>
                      <small class="text-muted d-block">
                        Sent: <%= rfq.sent_date&.strftime("%b %d, %Y") || 'Not sent' %> • 
                        Due: <%= rfq.due_date&.strftime("%b %d, %Y") || 'N/A' %>
                      </small>
                      <small class="text-muted">
                        Suppliers: <%= rfq.vendor_quotations&.count || 0 %> • 
                        Quotes received: <%= rfq.vendor_quotations&.where(status: 'received')&.count || 0 %>
                      </small>
                    </div>
                    <div>
                      <% if rfq.status == 'draft' %>
                        <%= button_to "Send RFQ", 
                            send_to_suppliers_vmcott_vendor_rfq_path(rfq.id),
                            method: :post,
                            class: "btn btn-sm btn-warning",
                            form: { "data-turbo" => "false" },
                            data: { confirm: "Send this RFQ to suppliers?" } %>
                      <% else %>
                        <%= link_to "Upload Quote", 
                            vmcott_procurement_upload_quotation_path(rfq_id: rfq.id),
                            class: "btn btn-sm btn-success" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No active RFQs at this time.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotations Received & Purchase Orders Section -->
  <div class="row mt-2">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-inboxes me-2"></i> Quotations & Purchase Orders</h5>
          <span class="badge bg-light text-success"><%= @all_quotes&.count || 0 %> items</span>
        </div>
        <div class="card-body">
          <% if @all_quotes.present? && @all_quotes.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>RFQ #</th>
                    <th>Part</th>
                    <th>Quotes Received</th>
                    <th>Price Range</th>
                    <th>Lowest Bid</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </thead>
                <tbody>
                  <% @all_quotes.each do |rfq| %>
                    <% 
                      quotes = rfq.vendor_quotations&.where(status: 'received') || []
                      prices = []
                      quotes.each do |q|
                        total = q.vendor_quotation_lines.sum(:total_price)
                        prices << total if total > 0
                      end
                      min_price = prices.min
                      max_price = prices.max
                      
                      # Check if PO exists for this RFQ
                      existing_po = PurchaseOrder.find_by(rfq_id: rfq.id)
                      
                      # Determine the status to display based on PO status
                      if existing_po.present? && existing_po.status == 'received'
                        # ✅ ITEMS RECEIVED
                        status_badge = 'success'
                        status_text = 'Items Received ✓'
                        status_icon = 'bi-check-circle-fill'
                        action_button = link_to "View PO", 
                            purchase_order_path(existing_po),
                            class: "btn btn-success btn-sm"
                      elsif existing_po.present? && existing_po.status == 'sent'
                        # 🔥 PO Sent - Pending Receipt - Link to PO page, not direct mark_received
                        status_badge = 'warning'
                        status_text = 'PO Sent - Pending Receipt'
                        status_icon = 'bi-send'
                        action_button = link_to "Mark Received", 
                            purchase_order_path(existing_po),
                            class: "btn btn-warning btn-sm"
                      elsif existing_po.present?
                        # PO Created (draft)
                        status_badge = 'info'
                        status_text = 'PO Created'
                        status_icon = 'bi-receipt'
                        action_button = link_to "Send to Vendor", 
                            submit_purchase_order_path(existing_po),
                            method: :post,
                            class: "btn btn-primary btn-sm",
                            data: { confirm: "Send this PO to vendor?" }
                      else
                        # No PO yet
                        status_badge = 'secondary'
                        status_text = 'Ready for PO'
                        status_icon = 'bi-file-earmark-text'
                        action_button = link_to "Create PO", 
                            new_purchase_order_path(rfq_id: rfq.id),
                            class: "btn btn-primary btn-sm"
                      end
                    %>
                    <tr class="<%= 'table-success' if existing_po&.status == 'received' %>">
                      <td class="align-middle"><strong><%= rfq.rfq_number.presence || 'RFQ' %></strong>|
                      <td class="align-middle">
                        <% if rfq.vendor_rfq_items.present? %>
                          <% rfq.vendor_rfq_items.each do |item| %>
                            <div><%= item.part&.name || item.custom_part_name || 'Unknown Part' %> x<%= item.quantity || 1 %></div>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No items</span>
                        <% end %>
                       </td>
                      <td class="align-middle text-center"><span class="badge bg-info"><%= quotes.count %> quotes</span></td>
                      <td class="align-middle">
                        <% if min_price && max_price %>
                          <%= number_to_currency(min_price) %> - <%= number_to_currency(max_price) %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                       </td>
                      <td class="align-middle">
                        <% if min_price %>
                          <strong class="text-success"><%= number_to_currency(min_price) %></strong>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                       </td>
                      <td class="align-middle">
                        <span class="badge bg-<%= status_badge %>" style="font-size: 0.9rem;">
                          <i class="bi <%= status_icon %> me-1"></i>
                          <%= status_text %>
                        </span>
                        <% if existing_po&.received_at %>
                          <div class="small text-muted mt-1">
                            <i class="bi bi-calendar-check"></i>
                            Received: <%= existing_po.received_at.strftime('%b %d, %Y %I:%M %p') %>
                          </div>
                        <% elsif existing_po&.sent_at %>
                          <div class="small text-muted mt-1">
                            Sent: <%= existing_po.sent_at.strftime('%b %d, %Y') %>
                          </div>
                        <% end %>
                       </td>
                      <td class="align-middle">
                        <div class="btn-group btn-group-sm">
                          <%= action_button %>
                          <%= link_to "View RFQ", 
                              vmcott_vendor_rfq_path(rfq),
                              class: "btn btn-outline-secondary btn-sm" %>
                          <% if existing_po.present? && existing_po.status != 'sent' && existing_po.status != 'received' %>
                            <%= link_to "View PO", 
                                purchase_order_path(existing_po),
                                class: "btn btn-outline-info btn-sm" %>
                          <% end %>
                        </div>
                       </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No quotations or purchase orders at this time.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Stats Footer -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card bg-light">
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-3 col-6">
              <h6 class="mb-0"><%= @low_stock_requests_count || 0 %></h6>
              <small class="text-muted">Low Stock Requests</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0"><%= @stats&.[](:parts_to_quote) || 0 %></h6>
              <small class="text-muted">To Quote</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0"><%= @stats&.[](:active_rfqs) || 0 %></h6>
              <small class="text-muted">Active RFQs</small>
            </div>
            <div class="col-md-3 col-6">
              <h6 class="mb-0"><%= @stats&.[](:quotes_received) || 0 %></h6>
              <small class="text-muted">Quotes Received</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  setTimeout(function() {
    location.reload();
  }, 300000);
  
  const flashMessage = document.querySelector('.alert-success');
  if (flashMessage) {
    setTimeout(() => {
      flashMessage.style.transition = 'opacity 0.5s ease';
      flashMessage.style.opacity = '0';
      setTimeout(() => {
        if (flashMessage.parentNode) flashMessage.remove();
      }, 500);
    }, 3000);
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    <% if session[:highlight_rfq_id].present? %>
      const highlightId = <%= session[:highlight_rfq_id] %>;
      const rfqElement = document.querySelector(`.rfq-item[data-rfq-id="${highlightId}"]`);
      
      if (rfqElement) {
        rfqElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        rfqElement.style.backgroundColor = '#fff3cd';
        rfqElement.style.borderLeft = '4px solid #ffc107';
        
        setTimeout(() => {
          rfqElement.style.backgroundColor = '';
          rfqElement.style.borderLeft = '';
        }, 3000);
      }
      
      <% session[:highlight_rfq_id] = nil %>
    <% end %>
  });
</script>