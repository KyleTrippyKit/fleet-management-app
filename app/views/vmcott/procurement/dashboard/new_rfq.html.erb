<%# app/views/vmcott/procurement/dashboard/new_rfq.html.erb %>
<div class="container-fluid py-4" style="background: linear-gradient(135deg, #0a2b4e 0%, #1e3a6b 100%); min-height: 100vh;">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-0 fw-bold text-white">
            <i class="bi bi-file-text me-2"></i>
            Create New RFQ
          </h1>
          <p class="text-white-50 mt-2 mb-0">Generate a professional Request for Quotation for suppliers</p>
        </div>
        <div>
          <%= link_to vmcott_procurement_dashboard_path, class: "btn btn-outline-light" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <div class="row g-4">
    <div class="col-lg-8">
      <!-- Main Form Card -->
      <div class="card shadow-lg border-0" style="background: rgba(255,255,255,0.95);">
        <div class="card-header bg-transparent border-0 pt-4 pb-0">
          <h5 class="card-title fw-bold mb-0" style="color: #3b82f6;">
            <i class="bi bi-file-earmark-text me-2" style="color: #3b82f6;"></i>
            RFQ Details
          </h5>
          <hr class="mt-3 mb-0" style="background: linear-gradient(90deg, #3b82f6, transparent);">
        </div>
        
        <div class="card-body">
          <%= form_with model: @rfq, url: vmcott_procurement_create_rfq_path, method: :post, local: true, class: "needs-validation" do |f| %>
            <%= hidden_field_tag :parts_request_id, @parts_request.id %>

            <!-- Internal Request Info - Dark Blue Theme -->
            <div class="card mb-4" style="background: linear-gradient(135deg, #0a2b4e 0%, #1e3a6b 100%); border: none;">
              <div class="card-header" style="background: linear-gradient(90deg, #3b82f6, transparent);">
                <h6 class="mb-0 fw-semibold" style="color: #0a2b4e;">
                  <i class="bi bi-info-circle me-1"></i>
                  Internal Request Information
                  <span class="badge" style="background: #1f2937; color: #9ca3af; margin-left: 8px;">Reference Only</span>
                </h6>
              </div>
              <div class="card-body">
                <div class="row g-4">
                  <!-- Part Details Box -->
                  <div class="col-md-6">
                    <div class="rounded-3 p-3 shadow-sm h-100" style="background: linear-gradient(135deg, #0a2b4e 0%, #1e3a6b 100%);">
                      <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-box-seam text-white"></i>
                        <span class="fw-semibold small text-uppercase ms-2 text-white">Part Details</span>
                      </div>
                      <div class="mt-2">
                        <strong class="fs-5 text-white"><%= @parts_request.part&.name || @parts_request.custom_part_name || 'Unknown Part' %></strong>
                        <% if @parts_request.part&.part_number.present? %>
                          <div class="mt-1">
                            <span class="text-white-50 small">Part #:</span> 
                            <code class="px-2 py-1 rounded" style="background: #1e293b; color: #f1f5f9; font-size: 0.85rem; font-weight: 500;">
                              <%= @parts_request.part.part_number %>
                            </code>
                          </div>
                        <% end %>
                        <% if @parts_request.custom_part_name.present? && @parts_request.part.nil? %>
                          <div class="mt-1">
                            <span class="text-white-50 small">Custom Part:</span> 
                            <span class="badge" style="background: rgba(255,255,255,0.2); color: white;"><%= @parts_request.custom_part_name %></span>
                          </div>
                        <% end %>
                        <div class="mt-2">
                          <span class="badge" style="background: rgba(255,255,255,0.2); color: white;">
                            <i class="bi bi-cart me-1"></i> Qty: <%= @parts_request.quantity || 1 %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Request Source Box -->
                  <div class="col-md-6">
                    <div class="rounded-3 p-3 shadow-sm h-100" style="background: linear-gradient(135deg, #0a2b4e 0%, #1e3a6b 100%);">
                      <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-person-badge text-white"></i>
                        <span class="fw-semibold small text-uppercase ms-2 text-white">Request Source</span>
                      </div>
                      <div class="mt-2">
                        <div class="text-white">
                          <i class="bi bi-truck text-white-50 me-1"></i> 
                          <strong>Vehicle:</strong> 
                          <span class="fw-semibold">
                            <%= @parts_request.inspection&.vehicle&.make %> 
                            <%= @parts_request.inspection&.vehicle&.model %>
                            (<%= @parts_request.inspection&.vehicle&.year_of_manufacture %>)
                          </span>
                        </div>
                        <div class="mt-2 text-white-50 small">
                          <i class="bi bi-shield-lock me-1"></i>
                          <strong>Will be shared with suppliers:</strong> Make, Model, Year
                        </div>
                        <div class="text-white-50 small">
                          <i class="bi bi-eye-slash me-1"></i>
                          <strong>Will NOT be shared:</strong> License Plate
                        </div>
                        <div class="mt-2 text-white">
                          <i class="bi bi-person text-white-50 me-1"></i> 
                          <strong>Requested By:</strong> 
                          <% if @parts_request.inspection_job&.assigned_mechanic.present? %>
                            <%= @parts_request.inspection_job.assigned_mechanic.name %>
                            <span class="badge bg-info ms-1">Mechanic</span>
                          <% elsif @parts_request.inspection&.inspector.present? && @parts_request.custom_part_name.present? %>
                            <%= @parts_request.inspection.inspector.name %>
                            <span class="badge" style="background: #ffc107; color: #856404;">Inventory</span>
                          <% elsif @parts_request.inspection&.inspector.present? %>
                            <%= @parts_request.inspection.inspector.name %>
                            <span class="badge bg-secondary ms-1">Inspector</span>
                          <% else %>
                            <span class="text-white-50">System Generated</span>
                          <% end %>
                        </div>
                        <div class="text-white-50 small mt-1">
                          <i class="bi bi-calendar me-1"></i> 
                          <%= @parts_request.created_at.strftime("%b %d, %Y") if @parts_request.created_at.present? %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="alert mt-3 mb-0 py-2 small border-0" style="background: rgba(0,0,0,0.3); color: white;">
                  <i class="bi bi-lock-fill me-1"></i>
                  Requested by information is for internal reference only and will NOT be included in the RFQ.
                </div>
              </div>
            </div>

            <!-- RFQ Form Fields -->
            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-floating mb-3">
                  <%= f.text_field :rfq_number, 
                        class: "form-control bg-light", 
                        value: "RFQ-#{Time.current.strftime('%Y%m%d')}-#{SecureRandom.hex(4).upcase}", 
                        readonly: true,
                        id: "rfq_number" %>
                  <%= f.label :rfq_number, "RFQ Number", for: "rfq_number" %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-floating mb-3">
                  <%= f.date_field :due_date, 
                        class: "form-control", 
                        value: 7.days.from_now, 
                        min: Date.today,
                        id: "due_date" %>
                  <%= f.label :due_date, "Response Due Date", for: "due_date" %>
                </div>
              </div>
            </div>

            <div class="mb-4">
              <%= f.label :notes, "Special Instructions for Suppliers", class: "form-label fw-semibold" %>
              <div class="small text-muted mb-2">These notes will be visible to suppliers in the RFQ</div>
              <%= f.text_area :notes, 
                    rows: 4, 
                    class: "form-control", 
                    placeholder: "e.g., Delivery requirements, quality specifications, payment terms, urgent delivery needed..." %>
            </div>

            <!-- Supplier Selection -->
            <div class="mb-4">
              <label class="form-label fw-semibold text-danger">
                <i class="bi bi-star-fill me-1"></i>
                Select Suppliers *
              </label>
              <div class="small text-muted mb-2">Choose at least one supplier to receive this RFQ</div>
              
              <div class="card border-0 bg-light">
                <div class="card-body p-3">
                  <% if @suppliers.present? %>
                    <div class="mb-3 pb-2 border-bottom">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="select_all_suppliers">
                        <label class="form-check-label fw-semibold" for="select_all_suppliers">
                          <i class="bi bi-check2-square me-1"></i> Select All Suppliers
                        </label>
                      </div>
                    </div>
                    <div class="row g-2" style="max-height: 250px; overflow-y: auto;">
                      <% @suppliers.each do |supplier| %>
                        <div class="col-md-6">
                          <div class="form-check py-1">
                            <input class="form-check-input supplier-checkbox" 
                                   type="checkbox" 
                                   name="vendor_rfq[supplier_ids][]" 
                                   value="<%= supplier.id %>" 
                                   id="supplier_<%= supplier.id %>">
                            <label class="form-check-label" for="supplier_<%= supplier.id %>">
                              <strong><%= supplier.name %></strong>
                              <% if supplier.contact_person.present? %>
                                <br><small class="text-muted">Contact: <%= supplier.contact_person %></small>
                              <% end %>
                            </label>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="alert alert-warning mb-0">
                      <i class="bi bi-exclamation-triangle me-2"></i>
                      No suppliers available. 
                      <%= link_to "Add suppliers", suppliers_path, class: "alert-link" %> before creating an RFQ.
                    </div>
                  <% end %>
                  <div id="supplier-error" class="text-danger small mt-2" style="display: none;">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    Please select at least one supplier to create this RFQ.
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
              <%= link_to "Cancel", vmcott_procurement_dashboard_path, class: "btn btn-outline-secondary px-4" %>
              <%= f.submit "Create RFQ", 
                    class: "btn px-4", 
                    style: "background: linear-gradient(135deg, #0a2b4e 0%, #1e3a6b 100%); color: white; border: none;",
                    id: "create-rfq-btn",
                    data: { disable_with: '<i class="bi bi-hourglass-split me-1"></i> Creating...' } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar - Help Section -->
    <div class="col-lg-4">
      <div class="card shadow-lg border-0 mb-3" style="background: rgba(255,255,255,0.95);">
        <div class="card-header bg-transparent border-0 pt-3">
          <h6 class="fw-semibold mb-0" style="color: #3b82f6;">
            <i class="bi bi-question-circle me-1" style="color: #3b82f6;"></i>
            RFQ Process
          </h6>
        </div>
        <div class="card-body pt-0">
          <div class="timeline-steps">
            <div class="step d-flex mb-3">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">1</div>
              <div class="step-text">Review parts request details</div>
            </div>
            <div class="step d-flex mb-3">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">2</div>
              <div class="step-text">Set supplier response due date</div>
            </div>
            <div class="step d-flex mb-3">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">3</div>
              <div class="step-text">Add special instructions for suppliers</div>
            </div>
            <div class="step d-flex mb-3">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">4</div>
              <div class="step-text fw-bold text-danger">Select at least one supplier</div>
            </div>
            <div class="step d-flex mb-3">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">5</div>
              <div class="step-text">Create RFQ to generate document</div>
            </div>
            <div class="step d-flex">
              <div class="step-number me-3 rounded-circle text-white d-flex align-items-center justify-content-center" style="background: #3b82f6; width: 28px; height: 28px;">6</div>
              <div class="step-text">Send RFQ to selected suppliers</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card shadow-lg border-0" style="background: rgba(255,255,255,0.95);">
        <div class="card-body">
          <h6 class="fw-semibold mb-2" style="color: #3b82f6;">
            <i class="bi bi-eye me-1 text-success"></i>
            What Suppliers Will See
          </h6>
          <ul class="small mb-3 ps-3">
            <li>✓ Part name and quantity</li>
            <li>✓ Response due date</li>
            <li>✓ Special instructions/notes</li>
            <li>✓ Vehicle Make, Model, Year</li>
          </ul>
          <hr class="my-2">
          <h6 class="fw-semibold mt-2 mb-2" style="color: #3b82f6;">
            <i class="bi bi-lock me-1 text-muted"></i>
            Not Included
          </h6>
          <ul class="small mb-0 ps-3 text-muted">
            <li>✗ Requested by information</li>
            <li>✗ Vehicle License Plate</li>
            <li>✗ Cost/pricing information</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .timeline-steps .step-text {
    line-height: 28px;
  }
  .form-floating > .form-control:read-only {
    background-color: #f8f9fa;
  }
  .form-control:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select All functionality
    const selectAllCheckbox = document.getElementById('select_all_suppliers');
    const supplierCheckboxes = document.querySelectorAll('.supplier-checkbox');
    
    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener('change', function() {
        supplierCheckboxes.forEach(checkbox => {
          checkbox.checked = selectAllCheckbox.checked;
        });
        validateSuppliers();
      });
    }
    
    function validateSuppliers() {
      const checkedSuppliers = document.querySelectorAll('.supplier-checkbox:checked');
      const errorDiv = document.getElementById('supplier-error');
      const hasSupplier = checkedSuppliers.length > 0;
      
      if (!hasSupplier && errorDiv) {
        errorDiv.style.display = 'block';
      } else if (errorDiv) {
        errorDiv.style.display = 'none';
      }
      
      return hasSupplier;
    }
    
    supplierCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('change', validateSuppliers);
    });
    
    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', function(e) {
        const hasSupplier = validateSuppliers();
        if (!hasSupplier) {
          e.preventDefault();
          const errorDiv = document.getElementById('supplier-error');
          errorDiv.style.display = 'block';
          errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }
    
    validateSuppliers();
  });
</script>