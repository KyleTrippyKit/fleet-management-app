<%# app/views/vmcott/inventory_manager/dashboard/index.html.erb %>
<div class="container-fluid px-4 py-5">

  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2 mb-1 fw-bold" style="color: #1e293b;">Inventory Manager Dashboard</h1>
          <p class="text-muted mb-0">Parts Management & Procurement Tracking</p>
        </div>
        <div class="text-end">
          <div class="bg-white rounded-3 px-3 py-2 shadow-sm">
            <i class="bi bi-calendar3 me-2 text-primary"></i>
            <%= Time.current.strftime("%A, %B %d, %Y") %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if flash[:success] %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert" id="successAlert">
      <div class="d-flex align-items-center">
        <i class="bi bi-check-circle-fill fs-4 me-3"></i>
        <div><%= flash[:success] %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4" role="alert">
      <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
        <div><%= flash[:notice] %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
      <div class="d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div><%= flash[:alert] %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% end %>

  <!-- Quick Stats Row -->
  <div class="row mb-4 g-2">
    <div class="col-md-3 col-6">
      <div class="bg-white rounded-3 p-3 text-center border border-light shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Pending Review</span>
          <span class="badge bg-warning"><%= @pending_parts&.count || 0 %></span>
        </div>
        <h4 class="mb-0 mt-2"><%= @pending_parts&.count || 0 %></h4>
        <small class="text-muted">needs attention</small>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="bg-white rounded-3 p-3 text-center border border-light shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">In Transit</span>
          <span class="badge bg-info"><%= @ordered_requests&.count || 0 %></span>
        </div>
        <h4 class="mb-0 mt-2"><%= @ordered_requests&.count || 0 %></h4>
        <small class="text-muted">parts coming</small>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="bg-white rounded-3 p-3 text-center border border-light shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Ready for Workshop</span>
          <span class="badge bg-success"><%= @parts_received&.count || 0 %></span>
        </div>
        <h4 class="mb-0 mt-2"><%= @parts_received&.count || 0 %></h4>
        <small class="text-muted">to pass to mechanics</small>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="bg-white rounded-3 p-3 text-center border border-light shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Low Stock</span>
          <span class="badge bg-danger"><%= @low_stock_parts&.count || 0 %></span>
        </div>
        <h4 class="mb-0 mt-2"><%= @low_stock_parts&.count || 0 %></h4>
        <small class="text-muted">needs reorder</small>
      </div>
    </div>
  </div>

  <!-- SECTION 1: PENDING REVIEW -->
  <div id="pending-review-section" class="card border-0 shadow-lg mb-4" style="border-top: 4px solid #f59e0b;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-clock-history me-2" style="color: #f59e0b;"></i>
            Pending Review
          </h5>
          <p class="text-muted small mb-0">Parts requests waiting for initial review</p>
        </div>
        <div class="d-flex gap-2">
          <div class="input-group input-group-sm" style="width: 250px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control form-control-sm border-start-0" 
                   id="pendingSearch" placeholder="Search by vehicle, part, or requester...">
          </div>
          <span class="badge px-3 py-2 rounded-pill" style="background: #fef3c7; color: #b45309;">
            <i class="bi bi-hourglass-split me-1"></i> <%= @pending_parts&.count || 0 %> Pending
          </span>
        </div>
      </div>
      <!-- Filter Buttons -->
      <div class="d-flex gap-2 mt-3">
        <button type="button" class="btn btn-sm btn-outline-secondary active filter-btn" data-filter="all">All</button>
        <button type="button" class="btn btn-sm btn-outline-success filter-btn" data-filter="instock">In Stock</button>
        <button type="button" class="btn btn-sm btn-outline-danger filter-btn" data-filter="outofstock">Out of Stock</button>
      </div>
    </div>
    <div class="card-body">
      <% if @pending_parts&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle" id="pendingTable">
            <thead class="bg-light">
              56
                <th class="border-0 py-3" style="width: 30px;">
                  <input type="checkbox" id="selectAll" class="form-check-input">
                </th>
                <th class="border-0 py-3">Vehicle</th>
                <th class="border-0 py-3">Part</th>
                <th class="border-0 py-3 text-center">Quantity</th>
                <th class="border-0 py-3">Requested By</th>
                <th class="border-0 py-3">Stock Status</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
            <tbody>
              <% @pending_parts.each do |pr| %>
                <tr id="pending-request-<%= pr.id %>" data-stock-status="<%= pr.in_stock? ? 'instock' : 'outofstock' %>">
                  <td class="text-center"><input type="checkbox" class="form-check-input row-checkbox" data-id="<%= pr.id %>" data-in-stock="<%= pr.in_stock? %>"></td>
                  <td>
                    <div><strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong></div>
                    <small class="text-muted"><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                  </td>
                  <td>
                    <div><strong><%= pr.part&.name || pr.custom_part_name %></strong></div>
                    <small class="text-muted"><%= pr.part&.part_number %></small>
                  </td>
                  <td class="text-center"><span class="badge bg-secondary"><%= pr.quantity %></span></td>
                  <td>
                    <div>
                      <% if pr.inspection_job&.assigned_mechanic %>
                        <%= pr.inspection_job.assigned_mechanic.name %>
                        <span class="badge bg-info ms-1">Mechanic</span>
                      <% elsif pr.inspection&.inspector %>
                        <%= pr.inspection.inspector.name %>
                        <span class="badge bg-secondary ms-1">Inspector</span>
                      <% else %>
                        <span class="text-muted">System</span>
                      <% end %>
                    </div>
                    <small class="text-muted"><%= time_ago_in_words(pr.created_at) %> ago</small>
                  </td>
                  <td>
                    <% if pr.in_stock? %>
                      <span class="badge bg-success" data-tooltip="Available in inventory - ready to allocate"><i class="bi bi-check-circle me-1"></i> In Stock</span>
                      <small class="d-block text-muted">Available: <%= pr.part&.current_stock %></small>
                    <% else %>
                      <span class="badge bg-danger" data-tooltip="Not in inventory - needs to be ordered"><i class="bi bi-x-circle me-1"></i> Out of Stock</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <% if pr.in_stock? %>
                        <%= button_to "✓ Approve & Allocate", 
                            vmcott_inventory_manager_mark_in_stock_path(pr.id),
                            method: :post,
                            class: "btn btn-success btn-sm rounded-pill px-3",
                            form: { data: { turbo: false } },
                            data: { confirm: "Approve this part and allocate to the job?" } %>
                      <% else %>
                        <%= button_to "📦 Order from Supplier", 
                            vmcott_inventory_manager_send_to_procurement_path(pr.id),
                            method: :post,
                            class: "btn btn-warning btn-sm rounded-pill px-3",
                            form: { data: { turbo: false } },
                            data: { confirm: "Send this part to procurement for ordering?" } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
           </table>
        </div>
        
        <!-- Batch Actions Bar -->
        <div id="batchActions" class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded-3" style="display: none;">
          <div class="text-muted">
            <i class="bi bi-check2-square me-1"></i>
            <span id="selectedCount">0</span> selected
          </div>
          <div>
            <button class="btn btn-sm btn-success me-2" id="batchMarkInStock">
              <i class="bi bi-check-circle"></i> Approve & Allocate
            </button>
            <button class="btn btn-sm btn-warning" id="batchSendToProcurement">
              <i class="bi bi-cart"></i> Order from Supplier
            </button>
          </div>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="empty-state-icon mb-3">
            <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
          </div>
          <h6 class="text-muted">All caught up!</h6>
          <p class="small text-muted mb-0">No parts pending review at the moment</p>
          <p class="small text-muted">Great job keeping the inventory moving! 🎉</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 2: WORKFLOW STATUS -->
  <div class="workflow-container rounded-4 mb-4" style="background: #ffffff; border: 1px solid #e2e8f0;">
    <div class="p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h5 class="mb-0 fw-bold" style="color: #1e293b;">
            <i class="bi bi-diagram-3 me-2" style="color: #3b82f6;"></i>
            Parts Procurement Workflow
          </h5>
          <p class="text-muted small mt-1 mb-0">Click on any step to jump to that section</p>
        </div>
        <div class="bg-light rounded-pill px-3 py-1">
          <i class="bi bi-arrow-repeat me-1 text-primary"></i>
          <small class="text-muted">Live Updates</small>
        </div>
      </div>

      <%
        pending_count = @pending_parts&.count.to_i
        procurement_count = @pending_procurement&.count.to_i
        ordered_count = @ordered_requests&.count.to_i
        received_count = @parts_received&.count.to_i
        
        current_step = if pending_count > 0
          'pending'
        elsif procurement_count > 0
          'procurement'
        elsif ordered_count > 0
          'ordered'
        elsif received_count > 0
          'received'
        else
          'complete'
        end
      %>

      <div class="workflow-steps-wrapper">
        <div class="workflow-steps d-flex justify-content-between align-items-center">
          <% steps = [
            { 
              name: 'Pending', 
              count: pending_count,
              active: current_step == 'pending',
              icon: 'bi-clock-history',
              color: pending_count > 0 ? '#f59e0b' : '#94a3b8',
              bg: pending_count > 0 ? '#fef3c7' : '#f1f5f9',
              detail: pending_count > 0 ? "#{pending_count} waiting" : "None",
              tooltip: "Parts pending initial review",
              target: '#pending-review-section'
            },
            { 
              name: 'Procurement', 
              count: procurement_count,
              active: current_step == 'procurement',
              icon: 'bi-send',
              color: procurement_count > 0 ? '#3b82f6' : '#94a3b8',
              bg: procurement_count > 0 ? '#dbeafe' : '#f1f5f9',
              detail: procurement_count > 0 ? "#{procurement_count} with RFQ" : "None",
              tooltip: "RFQs sent to vendors",
              target: '#procurement-section'
            },
            { 
              name: 'Ordered', 
              count: ordered_count,
              active: current_step == 'ordered',
              icon: 'bi-truck',
              color: ordered_count > 0 ? '#10b981' : '#94a3b8',
              bg: ordered_count > 0 ? '#d1fae5' : '#f1f5f9',
              detail: ordered_count > 0 ? "#{ordered_count} ordered" : "None",
              tooltip: "Purchase orders created",
              target: '#ordered-section'
            },
            { 
              name: 'Received', 
              count: received_count,
              active: current_step == 'received',
              icon: 'bi-check-circle',
              color: received_count > 0 ? '#10b981' : '#94a3b8',
              bg: received_count > 0 ? '#d1fae5' : '#f1f5f9',
              detail: received_count > 0 ? "#{received_count} ready" : "None",
              tooltip: "Parts received, ready for workshop",
              target: '#received-section'
            }
          ] %>
          
          <% steps.each_with_index do |step, index| %>
            <div class="workflow-step-item text-center flex-grow-1 position-relative clickable-step" 
                 data-bs-toggle="tooltip" 
                 title="<%= step[:tooltip] %>"
                 data-target="<%= step[:target] %>"
                 data-step-name="<%= step[:name] %>"
                 style="cursor: pointer; transition: all 0.2s ease;">
              <div class="step-wrapper">
                <div class="step-circle <%= 'active' if step[:active] %>" 
                     style="background: <%= step[:active] ? step[:color] : '#e2e8f0' %>;
                            box-shadow: <%= step[:active] ? '0 4px 12px ' + step[:color] + '40' : 'none' %>;">
                  <i class="bi <%= step[:icon] %> text-white"></i>
                  <% if step[:count] > 0 %>
                    <span class="step-count-badge"><%= step[:count] %></span>
                  <% end %>
                </div>
                <div class="step-number small mt-2 text-muted">Step <%= index + 1 %></div>
                <div class="step-label mt-1">
                  <strong class="d-block" style="color: #1e293b;"><%= step[:name] %></strong>
                  <span class="badge mt-1" style="background: <%= step[:bg] %>; color: <%= step[:color] %>;">
                    <%= step[:detail] %>
                  </span>
                </div>
              </div>
              <% if index < 3 %>
                <div class="step-connector <%= 'active-connector' if steps[index + 1][:active] || step[:active] %>"></div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Action Hint -->
      <div class="mt-4">
        <% if pending_count > 0 %>
          <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <div class="alert-icon me-3"><i class="bi bi-clock-history fs-4"></i></div>
              <div>
                <strong class="d-block">Parts Pending Review</strong>
                <span><%= pending_count %> part<%= 's' if pending_count > 1 %> waiting for your review.</span>
              </div>
            </div>
            <a href="#pending-review-section" class="btn btn-warning btn-sm rounded-pill px-4">Review Now →</a>
          </div>
        <% elsif procurement_count > 0 %>
          <div class="alert alert-info border-0 rounded-3 d-flex align-items-center">
            <div class="alert-icon me-3"><i class="bi bi-send fs-4"></i></div>
            <div>
              <strong class="d-block">RFQs Sent to Procurement</strong>
              <span><%= procurement_count %> RFQ<%= 's' if procurement_count > 1 %> awaiting vendor responses.</span>
            </div>
          </div>
        <% elsif ordered_count > 0 %>
          <div class="alert alert-secondary border-0 rounded-3 d-flex align-items-center">
            <div class="alert-icon me-3"><i class="bi bi-truck fs-4"></i></div>
            <div>
              <strong class="d-block">Parts Ordered</strong>
              <span><%= ordered_count %> item<%= 's' if ordered_count > 1 %> awaiting delivery.</span>
            </div>
          </div>
        <% elsif received_count > 0 %>
          <div class="alert alert-success border-0 rounded-3 d-flex align-items-center">
            <div class="alert-icon me-3"><i class="bi bi-check-circle fs-4"></i></div>
            <div>
              <strong class="d-block">Parts Received</strong>
              <span><%= received_count %> part request<%= 's' if received_count > 1 %> ready to pass to workshop.</span>
            </div>
          </div>
        <% else %>
          <div class="alert alert-success border-0 rounded-3 d-flex align-items-center">
            <div class="alert-icon me-3"><i class="bi bi-check-all fs-4"></i></div>
            <div>
              <strong class="d-block">All Caught Up!</strong>
              <span>No pending parts requests. Great job!</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- SECTION 3: With Procurement Team -->
  <div id="procurement-section" class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #3b82f6;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-send me-2" style="color: #3b82f6;"></i>
            With Procurement Team
          </h5>
          <p class="text-muted small mb-0">RFQs sent, awaiting vendor responses</p>
        </div>
        <span class="badge px-3 py-2 rounded-pill" style="background: #dbeafe; color: #1e40af;">
          <i class="bi bi-send me-1"></i> <%= @pending_procurement&.count || 0 %> Active
        </span>
      </div>
    </div>
    <div class="card-body">
      <% if @pending_procurement&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="bg-light">
              56
                <th class="border-0 py-3">Vehicle</th>
                <th class="border-0 py-3">Part</th>
                <th class="border-0 py-3 text-center">Quantity</th>
                <th class="border-0 py-3">Sent to Procurement</th>
                <th class="border-0 py-3">Status</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
            <tbody>
              <% @pending_procurement.each do |pr| %>
                <tr id="procurement-request-<%= pr.id %>">
                  <td>
                    <div><strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong></div>
                    <small class="text-muted"><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                  </td>
                  <td>
                    <div><strong><%= pr.part&.name || pr.custom_part_name %></strong></div>
                    <small class="text-muted"><%= pr.part&.part_number %></small>
                  </td>
                  <td class="text-center"><span class="badge bg-secondary"><%= pr.quantity %></span></td>
                  <td>
                    <% if pr.sent_to_procurement_at.present? %>
                      <%= time_ago_in_words(pr.sent_to_procurement_at) %> ago
                    <% else %>
                      <span class="text-muted">Recently</span>
                    <% end %>
                  </td>
                  <td><span class="badge bg-info"><i class="bi bi-hourglass-split me-1"></i> RFQ Sent</span></td>
                  <td class="text-end">
                    <%= link_to "📋 Track RFQ", 
                        vmcott_vendor_rfqs_path(part_id: pr.part_id),
                        class: "btn btn-sm btn-outline-info rounded-pill px-3" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
          <h6 class="text-muted">No parts with procurement</h6>
          <p class="small text-muted">All RFQs have been processed</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 4: Ordered - Awaiting Delivery -->
  <div id="ordered-section" class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #10b981;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-truck me-2" style="color: #10b981;"></i>
            Ordered - Awaiting Delivery
          </h5>
          <p class="text-muted small mb-0">Purchase orders created, parts on order</p>
        </div>
        <span class="badge px-3 py-2 rounded-pill" style="background: #d1fae5; color: #059669;">
          <i class="bi bi-truck me-1"></i> <%= @ordered_requests&.count || 0 %> In Transit
        </span>
      </div>
    </div>
    <div class="card-body">
      <% if @ordered_requests&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="bg-light">
              56
                <th class="border-0 py-3">Vehicle</th>
                <th class="border-0 py-3">Part</th>
                <th class="border-0 py-3 text-center">Quantity</th>
                <th class="border-0 py-3">PO Number</th>
                <th class="border-0 py-3">Supplier</th>
                <th class="border-0 py-3">Ordered Date</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
            <tbody>
              <% @ordered_requests.each do |pr| %>
                <tr id="ordered-request-<%= pr.id %>">
                  <td>
                    <div><strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong></div>
                    <small class="text-muted"><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                  </td>
                  <td>
                    <div><strong><%= pr.part&.name || pr.custom_part_name %></strong></div>
                    <small class="text-muted"><%= pr.part&.part_number %></small>
                  </td>
                  <td class="text-center"><span class="badge bg-secondary"><%= pr.quantity %></span></td>
                  <td>
                    <% if pr.purchase_order %>
                      <strong class="text-primary"><%= pr.purchase_order.po_number %></strong>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>
                  <td><%= pr.purchase_order&.vendor %></td>
                  <td>
                    <% if pr.purchase_order&.ordered_at.present? %>
                      <%= pr.purchase_order.ordered_at.strftime("%b %d, %Y") %>
                    <% else %>
                      <span class="text-muted">Pending</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <% if pr.purchase_order %>
                      <%= button_to "📦 Receive Parts", 
                          receive_parts_vmcott_inventory_manager_path(
                            purchase_order_id: pr.purchase_order_id,
                            parts_request_id: pr.id
                          ),
                          method: :post,
                          class: "btn btn-sm btn-success rounded-pill px-3",
                          form: { data: { turbo: false } },
                          data: { confirm: "Mark parts as received and update inventory?" } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
          <h6 class="text-muted">No parts currently on order</h6>
          <p class="small text-muted">All orders have been received</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 5: Received - Ready for Workshop -->
  <div id="received-section" class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #10b981;">
    <div class="card-header bg-white border-0 pt-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1 fw-bold" style="color: #1e293b;">
            <i class="bi bi-check-circle me-2" style="color: #10b981;"></i>
            Received - Ready for Workshop
          </h5>
          <p class="text-muted small mb-0">Parts received, ready to pass to mechanics</p>
        </div>
        <span class="badge px-3 py-2 rounded-pill" style="background: #d1fae5; color: #059669;">
          <i class="bi bi-check-circle me-1"></i> <%= @parts_received&.count || 0 %> Ready
        </span>
      </div>
    </div>
    <div class="card-body">
      <% if @parts_received&.any? || @ready_for_workshop&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="bg-light">
              56
                <th class="border-0 py-3">Vehicle</th>
                <th class="border-0 py-3">Parts Received</th>
                <th class="border-0 py-3">Inspection</th>
                <th class="border-0 py-3">Received Date</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
            <tbody>
              <% @parts_received.each do |pr| %>
                <tr id="received-inspection-<%= pr.inspection_id %>">
                  <td>
                    <div><strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong></div>
                    <small class="text-muted"><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                  </td>
                  <td>
                    <% if pr.inspection %>
                      <% pr.inspection.parts_requests.where(status: 'parts_received').each do |part_req| %>
                        <div class="mb-1">
                          <i class="bi bi-check-circle-fill text-success me-1"></i>
                          <small><%= part_req.part&.name || part_req.custom_part_name %> x<%= part_req.quantity %></small>
                        </div>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="fw-semibold">#<%= pr.inspection_id %></td>
                  <td><%= time_ago_in_words(pr.updated_at) %> ago</td>
                  <td class="text-end">
                    <div class="workshop-action" data-inspection-id="<%= pr.inspection_id %>">
                      <%= button_to "🔧 Pass to Mechanic Workshop", 
                          vmcott_inventory_manager_pass_to_workshop_path(pr.inspection_id),
                          method: :post,
                          class: "btn btn-sm btn-success rounded-pill px-3 pass-to-workshop-btn",
                          form: { data: { turbo: false } },
                          data: { 
                            confirm: "All parts received. Pass this job to mechanic workshop?",
                            disable_with: "<i class='bi bi-hourglass-split'></i> Processing..."
                          } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Additional ready for workshop inspections -->
        <% if @ready_for_workshop&.any? %>
          <hr class="my-4">
          <h6 class="mb-3">Additional Inspections Ready for Workshop:</h6>
          <div class="row g-3">
            <% @ready_for_workshop.each do |inspection| %>
              <div class="col-md-6 col-lg-4" id="workshop-item-<%= inspection.id %>">
                <div class="card border-success bg-light h-100">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <span class="fw-semibold text-primary">Inspection #<%= inspection.id %></span>
                      <span class="badge bg-success">All Parts Ready</span>
                    </div>
                    <h6 class="fw-bold mb-2"><%= inspection.vehicle.license_plate %></h6>
                    <div class="text-muted small mb-2">
                      <%= inspection.vehicle.make %> <%= inspection.vehicle.model %><br>
                      <i class="bi bi-gear me-1"></i> <%= inspection.inspection_jobs.count %> jobs pending
                    </div>
                    <div class="workshop-action mt-2" data-inspection-id="<%= inspection.id %>">
                      <%= button_to "🔧 Pass to Mechanic Workshop", 
                          vmcott_inventory_manager_pass_to_workshop_path(inspection.id),
                          method: :post,
                          class: "btn btn-success btn-sm w-100 rounded-pill pass-to-workshop-btn",
                          form: { data: { turbo: false } },
                          data: { 
                            confirm: "Pass this inspection to mechanic workshop?",
                            disable_with: "<i class='bi bi-hourglass-split'></i> Processing..."
                          } %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
          <h6 class="text-muted">No parts ready for workshop</h6>
          <p class="small text-muted">Check back when parts are received</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 6: Low Stock Alerts -->
  <% if @low_stock_parts.any? %>
    <div class="card border-0 shadow-sm mb-4" style="border-top: 4px solid #ef4444;">
      <div class="card-header bg-white border-0 pt-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h5 class="mb-1 fw-bold" style="color: #1e293b;">
              <i class="bi bi-exclamation-triangle me-2" style="color: #ef4444;"></i>
              Low Stock Alerts
            </h5>
            <p class="text-muted small mb-0">Parts below reorder point requiring attention</p>
          </div>
          <span class="badge px-3 py-2 rounded-pill" style="background: #fee2e2; color: #dc2626;">
            <i class="bi bi-exclamation-triangle me-1"></i> <%= @low_stock_parts.count %> Alerts
          </span>
        </div>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="bg-light">
              56
                <th class="border-0 py-3">Part #</th>
                <th class="border-0 py-3">Part Name</th>
                <th class="border-0 py-3 text-center">Current Stock</th>
                <th class="border-0 py-3 text-center">Reorder Point</th>
                <th class="border-0 py-3">Status</th>
                <th class="border-0 py-3">Request Status</th>
                <th class="border-0 py-3 text-end">Action</th>
               </thead>
            <tbody>
              <% @low_stock_parts.each do |part| %>
                <%
                  pending_request = PurchaseRequest.where(
                    part_id: part.id,
                    status: ['pending', 'approved']
                  ).order(created_at: :desc).first
                  
                  ordered_request = PurchaseRequest.where(
                    part_id: part.id,
                    status: ['ordered', 'received']
                  ).order(created_at: :desc).first
                %>
                <tr>
                  <td class="text-muted"><%= part.part_number %></td>
                  <td><strong><%= part.name %></strong></td>
                  <td class="text-center">
                    <span class="badge <%= part.current_stock <= 0 ? 'bg-danger' : 'bg-warning' %>">
                      <%= part.current_stock %>
                    </span>
                  </td>
                  <td class="text-center"><%= part.reorder_point %></td>
                  <td>
                    <% if part.current_stock <= 0 %>
                      <span class="badge bg-danger" data-tooltip="Immediate action required">Out of Stock</span>
                    <% else %>
                      <span class="badge bg-warning" data-tooltip="Order soon">Low Stock</span>
                    <% end %>
                  </td>
                  <td>
                    <% if ordered_request.present? %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i> Ordered
                      </span>
                      <br>
                      <small class="text-muted">PO: <%= ordered_request.purchase_order&.po_number || 'Processing' %></small>
                    <% elsif pending_request.present? %>
                      <span class="badge bg-info">
                        <i class="bi bi-clock-history"></i> Pending
                      </span>
                      <br>
                      <small class="text-muted"><%= time_ago_in_words(pending_request.created_at) %> ago</small>
                    <% else %>
                      <span class="badge bg-secondary">
                        <i class="bi bi-exclamation-circle"></i> No Request
                      </span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to "🔍 View", vmcott_part_path(part), class: "btn btn-sm btn-outline-secondary rounded-pill" %>
                      
                      <% if pending_request.present? %>
                        <%= link_to "📋 Request", 
                            vmcott_purchase_request_path(pending_request),
                            class: "btn btn-sm btn-outline-primary rounded-pill" %>
                      <% elsif ordered_request.present? && ordered_request.purchase_order %>
                        <%= link_to "📦 PO", 
                            vmcott_purchase_order_path(ordered_request.purchase_order),
                            class: "btn btn-sm btn-outline-success rounded-pill" %>
                      <% else %>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill quick-reorder" 
                                data-part-id="<%= part.id %>"
                                data-part-name="<%= part.name %>"
                                data-quantity="<%= part.suggested_reorder_quantity %>">
                          <i class="bi bi-cart-plus"></i> Quick Reorder
                        </button>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  /* Stats Cards */
  .stats-card {
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .stats-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }
  
  /* Workflow Timeline */
  .workflow-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
  }
  .workflow-steps-wrapper {
    padding: 1rem 0;
  }
  .workflow-steps {
    position: relative;
  }
  .workflow-step-item {
    position: relative;
    z-index: 2;
  }
  .step-circle {
    width: 64px;
    height: 64px;
    margin: 0 auto;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    background: #e2e8f0;
    position: relative;
  }
  .step-circle.active {
    transform: scale(1.08);
    animation: pulse 2s infinite;
  }
  .step-count-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #ef4444;
    color: white;
    border-radius: 20px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: bold;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
    100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
  }
  .step-circle i { font-size: 1.5rem; }
  .step-connector {
    position: absolute;
    top: 32px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: #e2e8f0;
    z-index: -1;
  }
  .step-connector.active-connector {
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  }
  .step-number { font-size: 0.7rem; font-weight: 600; }
  .step-label { font-size: 0.85rem; }
  .alert-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
  
  /* Clickable Steps */
  .clickable-step {
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .clickable-step:hover {
    transform: scale(1.02);
  }
  .clickable-step:hover .step-circle {
    transform: scale(1.05);
    transition: transform 0.2s ease;
  }
  
  /* Table styling */
  .table > :not(caption) > * > * { padding: 0.75rem 0.75rem; }
  .bg-light th { 
    background-color: #f8fafc !important;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
  }
  [data-bs-toggle="tooltip"], [data-tooltip] { cursor: help; }
  [data-tooltip] {
    position: relative;
    cursor: help;
  }
  [data-tooltip]:hover:after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #1e293b;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    z-index: 10;
  }
  
  /* Card styling */
  .card {
    border-radius: 16px !important;
    overflow: hidden;
  }
  .card-header {
    background: white !important;
  }
  
  /* Hover effects */
  .table tbody tr:hover {
    background-color: #f8fafc;
    transition: background-color 0.2s ease;
  }
  
  /* Empty state */
  .empty-state-icon {
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  /* Responsive */
  @media (max-width: 992px) {
    .step-connector { display: none; }
    .workflow-steps { flex-wrap: wrap; gap: 1.5rem; }
    .workflow-step-item { flex: 0 0 calc(33.333% - 1rem); }
  }
  @media (max-width: 768px) {
    .step-circle { width: 52px; height: 52px; }
    .step-circle i { font-size: 1.25rem; }
    .workflow-step-item { flex: 0 0 calc(50% - 1rem); }
    .step-connector { display: none; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-fade success alerts after 5 seconds
  const successAlert = document.getElementById('successAlert');
  if (successAlert) {
    setTimeout(() => {
      successAlert.style.transition = 'opacity 0.5s ease';
      successAlert.style.opacity = '0';
      setTimeout(() => {
        if (successAlert && successAlert.remove) {
          successAlert.remove();
        }
      }, 500);
    }, 5000);
  }
  
  // Make workflow steps clickable
  document.querySelectorAll('.clickable-step').forEach(step => {
    step.addEventListener('click', function(e) {
      const targetId = this.getAttribute('data-target');
      if (targetId && targetId !== '#') {
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'start'
          });
          targetElement.style.transition = 'box-shadow 0.3s ease';
          targetElement.style.boxShadow = '0 0 0 3px #3b82f6, 0 0 0 6px rgba(59,130,246,0.2)';
          setTimeout(() => {
            targetElement.style.boxShadow = '';
          }, 1500);
        }
      }
    });
  });
  
  // Handle workshop button clicks
  document.querySelectorAll('.pass-to-workshop-btn').forEach(button => {
    button.addEventListener('click', function(e) {
      const form = this.closest('form');
      if (form) {
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
      }
    });
  });
  
  // Search functionality
  const searchInput = document.getElementById('pendingSearch');
  if (searchInput) {
    searchInput.addEventListener('keyup', function() {
      const searchTerm = this.value.toLowerCase();
      const rows = document.querySelectorAll('#pendingTable tbody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(searchTerm) ? '' : 'none';
      });
    });
  }
  
  // Filter buttons
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const filter = this.getAttribute('data-filter');
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const rows = document.querySelectorAll('#pendingTable tbody tr');
      rows.forEach(row => {
        const stockStatus = row.getAttribute('data-stock-status');
        if (filter === 'all') {
          row.style.display = '';
        } else if (filter === 'instock' && stockStatus === 'instock') {
          row.style.display = '';
        } else if (filter === 'outofstock' && stockStatus === 'outofstock') {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });
  
  // Batch selection
  const selectAll = document.getElementById('selectAll');
  const checkboxes = document.querySelectorAll('#pendingTable tbody .row-checkbox');
  const batchActions = document.getElementById('batchActions');
  const selectedCountSpan = document.getElementById('selectedCount');
  
  function updateBatchActions() {
    const selected = document.querySelectorAll('#pendingTable tbody .row-checkbox:checked');
    if (selectedCountSpan) selectedCountSpan.innerText = selected.length;
    if (batchActions) batchActions.style.display = selected.length > 0 ? 'flex' : 'none';
  }
  
  if (selectAll) {
    selectAll.addEventListener('change', function() {
      const visibleRows = document.querySelectorAll('#pendingTable tbody tr:not([style*="display: none"])');
      visibleRows.forEach(row => {
        const cb = row.querySelector('.row-checkbox');
        if (cb) cb.checked = this.checked;
      });
      updateBatchActions();
    });
  }
  
  checkboxes.forEach(cb => {
    cb.addEventListener('change', updateBatchActions);
  });
  
  // Batch actions
  const batchMarkInStock = document.getElementById('batchMarkInStock');
  const batchSendToProcurement = document.getElementById('batchSendToProcurement');
  
  if (batchMarkInStock) {
    batchMarkInStock.addEventListener('click', function() {
      const selected = document.querySelectorAll('#pendingTable tbody .row-checkbox:checked');
      const inStockItems = Array.from(selected).filter(cb => cb.getAttribute('data-in-stock') === 'true');
      
      if (inStockItems.length > 0) {
        if (confirm(`Approve and allocate ${inStockItems.length} item(s)?`)) {
          inStockItems.forEach(cb => {
            const form = cb.closest('tr').querySelector('.btn-success');
            if (form && form.closest('form')) {
              form.closest('form').submit();
            }
          });
        }
      } else if (selected.length > 0) {
        alert('Selected items are out of stock. Use "Order from Supplier" for those.');
      }
    });
  }
  
  if (batchSendToProcurement) {
    batchSendToProcurement.addEventListener('click', function() {
      const selected = document.querySelectorAll('#pendingTable tbody .row-checkbox:checked');
      const outOfStockItems = Array.from(selected).filter(cb => cb.getAttribute('data-in-stock') === 'false');
      
      if (outOfStockItems.length > 0) {
        if (confirm(`Order ${outOfStockItems.length} item(s) from supplier?`)) {
          outOfStockItems.forEach(cb => {
            const form = cb.closest('tr').querySelector('.btn-warning');
            if (form && form.closest('form')) {
              form.closest('form').submit();
            }
          });
        }
      } else if (selected.length > 0) {
        alert('Selected items are already in stock. Use "Approve & Allocate" for those.');
      }
    });
  }
  
  // Quick reorder functionality
  document.querySelectorAll('.quick-reorder').forEach(btn => {
    btn.addEventListener('click', function() {
      const partId = this.dataset.partId;
      const partName = this.dataset.partName;
      const quantity = this.dataset.quantity;
      
      if (confirm(`Order ${quantity} x ${partName}?`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/vmcott/inventory/create_purchase_request/${partId}`;
        form.innerHTML = `<input type="hidden" name="quantity" value="${quantity}">
                          <input type="hidden" name="authenticity_token" value="${document.querySelector('meta[name="csrf-token"]').content}">`;
        document.body.appendChild(form);
        form.submit();
      }
    });
  });
});
</script>