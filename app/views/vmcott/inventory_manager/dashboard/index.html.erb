<%# app/views/vmcott/inventory_manager/dashboard/index.html.erb %>
<%# Inventory Manager Dashboard - Parts inventory, stock management, and parts requests %>
<%# Renamed from parts_coordinator to inventory_manager %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">
        <i class="bi bi-box-seam me-2"></i>
        Inventory Manager Dashboard
      </h1>
      <p class="text-muted">Manage parts inventory, stock levels, and parts requests</p>
    </div>
    <div class="col-auto">
      <div class="btn-group">
        <%= link_to "📦 Parts Catalog", vmcott_parts_path, class: "btn btn-outline-primary" %>
        <%= link_to "⚠️ Low Stock", low_stock_vmcott_inventory_manager_parts_path, class: "btn btn-outline-warning" %>
        <%= link_to "📊 Inventory", vmcott_inventory_dashboard_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <!-- KPI Cards Row -->
  <div class="row mb-4 g-3">
    <!-- Pending Parts -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Pending Review</h6>
              <h2 class="mb-0"><%= @stats[:pending_parts] %></h2>
            </div>
            <i class="bi bi-clock-history fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50"><%= @stats[:in_stock_count] %> in stock • <%= @stats[:out_of_stock_count] %> to order</small>
        </div>
      </div>
    </div>

    <!-- With Procurement -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-warning text-dark h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-dark-50 mb-1">With Procurement</h6>
              <h2 class="mb-0"><%= @stats[:pending_procurement] %></h2>
            </div>
            <i class="bi bi-send fs-1 opacity-50"></i>
          </div>
          <small class="text-dark-50">RFQs sent to vendors</small>
        </div>
      </div>
    </div>

    <!-- With Finance -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-info text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Finance Review</h6>
              <h2 class="mb-0"><%= @stats[:pending_finance] %></h2>
            </div>
            <i class="bi bi-cash-stack fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">Quotes received</small>
        </div>
      </div>
    </div>

    <!-- Ordered -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-secondary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Ordered</h6>
              <h2 class="mb-0"><%= @stats[:ordered_count] %></h2>
            </div>
            <i class="bi bi-truck fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">POs created</small>
        </div>
      </div>
    </div>

    <!-- Received -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-success text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Received</h6>
              <h2 class="mb-0"><%= @stats[:parts_received] %></h2>
            </div>
            <i class="bi bi-check-circle fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">Ready for workshop</small>
        </div>
      </div>
    </div>

    <!-- Low Stock -->
    <div class="col-xl-2 col-md-4 col-6">
      <div class="card bg-danger text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="text-white-50 mb-1">Low Stock</h6>
              <h2 class="mb-0"><%= @stats[:low_stock_count] %></h2>
            </div>
            <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
          </div>
          <small class="text-white-50">Below reorder point</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Workflow Tabs -->
  <div class="row mb-4">
    <div class="col-12">
      <ul class="nav nav-tabs" id="inventoryTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
            <i class="bi bi-clock-history me-1"></i>
            Pending Review
            <% if @stats[:pending_parts] > 0 %>
              <span class="badge bg-primary ms-2"><%= @stats[:pending_parts] %></span>
            <% end %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="procurement-tab" data-bs-toggle="tab" data-bs-target="#procurement" type="button" role="tab">
            <i class="bi bi-send me-1"></i>
            With Procurement
            <% if @stats[:pending_procurement] > 0 %>
              <span class="badge bg-warning ms-2"><%= @stats[:pending_procurement] %></span>
            <% end %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="finance-tab" data-bs-toggle="tab" data-bs-target="#finance" type="button" role="tab">
            <i class="bi bi-cash-stack me-1"></i>
            Finance Review
            <% if @stats[:pending_finance] > 0 %>
              <span class="badge bg-info ms-2"><%= @stats[:pending_finance] %></span>
            <% end %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="ordered-tab" data-bs-toggle="tab" data-bs-target="#ordered" type="button" role="tab">
            <i class="bi bi-truck me-1"></i>
            Ordered
            <% if @stats[:ordered_count] > 0 %>
              <span class="badge bg-secondary ms-2"><%= @stats[:ordered_count] %></span>
            <% end %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="received-tab" data-bs-toggle="tab" data-bs-target="#received" type="button" role="tab">
            <i class="bi bi-check-circle me-1"></i>
            Received
            <% if @stats[:parts_received] > 0 %>
              <span class="badge bg-success ms-2"><%= @stats[:parts_received] %></span>
            <% end %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="pos-tab" data-bs-toggle="tab" data-bs-target="#pos" type="button" role="tab">
            <i class="bi bi-file-text me-1"></i>
            Purchase Orders
            <% if @stats[:approved_po_count] + @stats[:ordered_po_count] > 0 %>
              <span class="badge bg-dark ms-2"><%= @stats[:approved_po_count] + @stats[:ordered_po_count] %></span>
            <% end %>
          </button>
        </li>
      </ul>
    </div>
  </div>

  <!-- Tab Content -->
  <div class="tab-content" id="inventoryTabsContent">
    
    <!-- TAB 1: Pending Review -->
    <div class="tab-pane fade show active" id="pending" role="tabpanel">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i> Parts Pending Review</h5>
          <span class="badge bg-light text-primary"><%= @stats[:pending_parts] %> pending</span>
        </div>
        <div class="card-body">
          <% if @pending_parts.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Stock Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_parts.each do |pr| %>
                    <tr>
                      <td>
                        <strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong><br>
                        <small><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                      </td>
                      <td>
                        <strong><%= pr.part&.name || pr.custom_part_name %></strong><br>
                        <small><%= pr.part&.part_number %></small>
                      </td>
                      <td><%= pr.quantity %></td>
                      <td>
                        <span class="badge bg-<%= pr.status == 'pending' ? 'warning' : 'info' %>">
                          <%= pr.status.humanize %>
                        </span>
                      </td>
                      <td>
                        <% if pr.in_stock? %>
                          <span class="badge bg-success">In Stock</span>
                          <small class="d-block text-muted">Qty: <%= pr.part&.current_stock %></small>
                        <% else %>
                          <span class="badge bg-danger">Out of Stock</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <% if pr.in_stock? %>
                            <%= link_to "✓ Mark In Stock", 
                                vmcott_inventory_manager_mark_in_stock_path(pr.id),
                                method: :post,
                                class: "btn btn-success",
                                data: { confirm: "Mark this part as in-stock and approved?" } %>
                          <% else %>
                            <%= link_to "📤 Send to Procurement", 
                                vmcott_inventory_manager_send_to_procurement_path(pr.id),
                                method: :post,
                                class: "btn btn-warning",
                                data: { confirm: "Send this part to procurement team for RFQ creation?" } %>
                          <% end %>
                          <%= link_to "🔍 View", 
                              parts_request_path(pr),
                              class: "btn btn-outline-secondary" %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No parts pending review at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- TAB 2: With Procurement -->
    <div class="tab-pane fade" id="procurement" role="tabpanel">
      <div class="card">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-send me-2"></i> Parts with Procurement Team</h5>
          <span class="badge bg-dark text-white"><%= @stats[:pending_procurement] %> items</span>
        </div>
        <div class="card-body">
          <% if @pending_procurement.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Sent to Procurement</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_procurement.each do |pr| %>
                    <tr>
                      <td>
                        <strong><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></strong>
                      </td>
                      <td><%= pr.part&.name || pr.custom_part_name %></td>
                      <td><%= pr.quantity %></td>
                      <td>
                        <span class="badge bg-warning"><%= pr.status.humanize %></span>
                      </td>
                      <td><%= time_ago_in_words(pr.sent_to_procurement_at) %> ago</td>
                      <td>
                        <%= link_to "Track RFQ", 
                            vmcott_vendor_rfqs_path(part_id: pr.part_id),
                            class: "btn btn-sm btn-outline-warning" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No parts with procurement team at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- TAB 3: Finance Review -->
    <div class="tab-pane fade" id="finance" role="tabpanel">
      <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i> Parts with Finance for Review</h5>
          <span class="badge bg-light text-info"><%= @stats[:pending_finance] %> items</span>
        </div>
        <div class="card-body">
          <% if @pending_finance.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quotes Received</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_finance.each do |pr| %>
                    <% rfq = VendorRfq.joins(:vendor_rfq_items).where(vendor_rfq_items: { part_id: pr.part_id }).first %>
                    <tr>
                      <td><%= pr.inspection&.vehicle&.license_plate %></td>
                      <td><%= pr.part&.name %></td>
                      <td>
                        <% if rfq %>
                          <%= rfq.vendor_quotations.where(status: 'received').count %> quotes
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-info"><%= pr.status.humanize %></span>
                      </td>
                      <td>
                        <% if rfq %>
                          <%= link_to "Compare Quotes", 
                              vmcott_inventory_manager_compare_quotations_path(rfq.id),
                              class: "btn btn-sm btn-info" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No parts with finance team at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- TAB 4: Ordered -->
    <div class="tab-pane fade" id="ordered" role="tabpanel">
      <div class="card">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Ordered Parts (POs Created)</h5>
          <span class="badge bg-light text-secondary"><%= @stats[:ordered_count] %> items</span>
        </div>
        <div class="card-body">
          <% if @ordered_requests.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>PO #</th>
                    <th>Supplier</th>
                    <th>Ordered Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @ordered_requests.each do |pr| %>
                    <tr>
                      <td><%= pr.inspection&.vehicle&.license_plate %></td>
                      <td><%= pr.part&.name %></td>
                      <td>
                        <% if pr.purchase_order %>
                          <strong><%= pr.purchase_order.po_number %></strong>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td><%= pr.purchase_order&.vendor %></td>
                      <td><%= pr.purchase_order&.ordered_at&.strftime("%b %d, %Y") %></td>
                      <td>
                        <span class="badge bg-secondary"><%= pr.status.humanize %></span>
                      </td>
                      <td>
                        <% if pr.purchase_order %>
                          <%= link_to "Receive Parts", 
                              receive_parts_vmcott_inventory_manager_path(
                                purchase_order_id: pr.purchase_order_id,
                                parts_request_id: pr.id
                              ),
                              method: :post,
                              class: "btn btn-sm btn-success",
                              data: { confirm: "Mark parts as received?" } %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No ordered parts at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- TAB 5: Received -->
    <div class="tab-pane fade" id="received" role="tabpanel">
      <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i> Parts Received - Ready for Workshop</h5>
          <span class="badge bg-light text-success"><%= @stats[:parts_received] %> items</span>
        </div>
        <div class="card-body">
          <% if @parts_received.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Parts Received</th>
                    <th>Inspection</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts_received.each do |pr| %>
                    <tr>
                      <td>
                        <strong><%= pr.inspection&.vehicle&.license_plate %></strong><br>
                        <small><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                      </td>
                      <td>
                        <% pr.inspection.parts_requests.where(status: 'parts_received').each do |part_req| %>
                          <div><small>✓ <%= part_req.part&.name %> x<%= part_req.quantity %></small></div>
                        <% end %>
                      </td>
                      <td>#<%= pr.inspection_id %></td>
                      <td>
                        <span class="badge bg-success">All Parts Received</span>
                      </td>
                      <td>
                        <%= link_to "Pass to Workshop", 
                            vmcott_inventory_manager_pass_to_workshop_path(pr.inspection_id),
                            method: :post,
                            class: "btn btn-sm btn-success",
                            data: { confirm: "All parts received. Pass this job to workshop?" } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <% if @ready_for_workshop.any? %>
              <hr>
              <h6 class="mt-3">Inspections Ready for Workshop:</h6>
              <div class="list-group mt-2">
                <% @ready_for_workshop.each do |inspection| %>
                  <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= inspection.vehicle.license_plate %></strong> - 
                      <%= inspection.vehicle.make %> <%= inspection.vehicle.model %>
                    </div>
                    <%= link_to "Pass to Workshop", 
                        vmcott_inventory_manager_pass_to_workshop_path(inspection.id),
                        method: :post,
                        class: "btn btn-sm btn-success" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted text-center py-4">No parts received at this time.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- TAB 6: Purchase Orders -->
    <div class="tab-pane fade" id="pos" role="tabpanel">
      <div class="row">
        <!-- Approved POs -->
        <div class="col-md-6 mb-4">
          <div class="card h-100">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i> Approved POs (Ready to Order)</h5>
              <span class="badge bg-light text-primary"><%= @stats[:approved_po_count] %> POs</span>
            </div>
            <div class="card-body">
              <% if @approved_pos.any? %>
                <div class="list-group">
                  <% @approved_pos.each do |po| %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <strong><%= po.po_number %></strong> - <%= po.vendor %><br>
                          <small class="text-muted">
                            <%= po.purchase_order_items.count %> items • 
                            <%= number_to_currency(po.amount) %>
                          </small>
                        </div>
                        <div>
                          <%= link_to "Mark Ordered", 
                              vmcott_inventory_manager_mark_po_ordered_path(po.id),
                              method: :post,
                              class: "btn btn-sm btn-success",
                              data: { confirm: "Mark PO as ordered?" } %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted text-center py-3">No approved POs</p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Ordered POs -->
        <div class="col-md-6 mb-4">
          <div class="card h-100">
            <div class="card-header bg-warning text-dark">
              <h5 class="mb-0"><i class="bi bi-truck me-2"></i> Ordered POs (Awaiting Delivery)</h5>
              <span class="badge bg-dark text-white"><%= @stats[:ordered_po_count] %> POs</span>
            </div>
            <div class="card-body">
              <% if @ordered_pos.any? %>
                <div class="list-group">
                  <% @ordered_pos.each do |po| %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <strong><%= po.po_number %></strong> - <%= po.vendor %><br>
                          <small class="text-muted">
                            Ordered: <%= po.ordered_at&.strftime("%b %d") %> • 
                            <%= number_to_currency(po.amount) %>
                          </small>
                        </div>
                        <div>
                          <%= link_to "Receive", 
                              vmcott_inventory_manager_mark_po_received_path(po.id),
                              method: :post,
                              class: "btn btn-sm btn-success",
                              data: { confirm: "Mark PO as received?" } %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted text-center py-3">No ordered POs</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Low Stock Alerts Section -->
  <% if @low_stock_parts.any? %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card border-danger">
          <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i> Low Stock Alerts</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Part #</th>
                    <th>Part Name</th>
                    <th>Current Stock</th>
                    <th>Reorder Point</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @low_stock_parts.each do |part| %>
                    <tr>
                      <td><%= part.part_number %></td>
                      <td><strong><%= part.name %></strong></td>
                      <td class="<%= part.current_stock <= 0 ? 'text-danger fw-bold' : 'text-warning' %>">
                        <%= part.current_stock %>
                      </td>
                      <td><%= part.reorder_point %></td>
                      <td>
                        <% if part.current_stock <= 0 %>
                          <span class="badge bg-danger">Out of Stock</span>
                        <% else %>
                          <span class="badge bg-warning">Low Stock</span>
                        <% end %>
                      </td>
                      <td>
                        <% if @parts_request && @parts_request.part_id == part.id %>
                          <%= link_to "Create PO", vmcott_inventory_manager_create_rfq_path(parts_request_id: @parts_request.id), class: "btn btn-sm btn-warning" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Quick Stats Footer -->
