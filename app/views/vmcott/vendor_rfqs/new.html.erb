<%# app/views/vmcott/vendor_rfqs/new.html.erb - ENHANCED VERSION %>
<div class="container py-3">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="mb-0">Create New Vendor RFQ</h3>
    <%= link_to "Back", vmcott_billing_dashboard_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_with model: @vendor_rfq, url: vmcott_billing_create_rfq_path(parts_request_id: params[:parts_request_id]), local: true do |f| %>

        <% if @vendor_rfq.errors.any? %>
          <div class="alert alert-danger">
            <strong><%= pluralize(@vendor_rfq.errors.count, "error") %> prevented saving:</strong>
            <ul class="mb-0">
              <% @vendor_rfq.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Parts Request Info (read-only) -->
        <% if @parts_request %>
          <div class="alert alert-info">
            <h6>Parts Request Details:</h6>
            <p class="mb-0">
              <strong>Part:</strong> <%= @parts_request.part&.name || @parts_request.custom_part_name %><br>
              <strong>Quantity:</strong> <%= @parts_request.quantity %><br>
              <strong>Vehicle:</strong> <%= @parts_request.inspection&.vehicle&.license_plate %>
            </p>
          </div>
        <% end %>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :due_date, "Response Due Date", class: "form-label fw-semibold" %>
            <%= f.date_field :due_date, class: "form-control", min: Date.today + 3.days %>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Select Suppliers</label>
            <%= select_tag :supplier_ids, 
                options_from_collection_for_select(@suppliers || Supplier.active, :id, :name),
                multiple: true, 
                class: "form-select", 
                size: 5 %>
            <small class="text-muted">Hold Ctrl/Cmd to select multiple suppliers</small>
          </div>

          <div class="col-12">
            <%= f.label :notes, "Special Instructions", class: "form-label fw-semibold" %>
            <%= f.text_area :notes, class: "form-control", rows: 3 %>
          </div>
        </div>

        <hr class="my-4">

        <h5 class="mb-2">Items (auto-filled from parts request)</h5>

        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th>Part</th>
                <th>Description</th>
                <th>Quantity</th>
              </tr>
            </thead>

            <tbody>
              <% if @parts_request %>
                <tr>
                  <td>
                    <%= @parts_request.part&.name || @parts_request.custom_part_name %>
                    <%= hidden_field_tag "vendor_rfq[vendor_rfq_items_attributes][0][part_id]", @parts_request.part_id %>
                  </td>
                  <td>
                    <%= text_field_tag "vendor_rfq[vendor_rfq_items_attributes][0][description]", 
                        @parts_request.part&.name || @parts_request.custom_part_name, 
                        class: "form-control form-control-sm" %>
                  </td>
                  <td>
                    <%= number_field_tag "vendor_rfq[vendor_rfq_items_attributes][0][quantity]", 
                        @parts_request.quantity, 
                        class: "form-control form-control-sm", 
                        min: 1, 
                        readonly: true %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "Create RFQ", class: "btn btn-primary ms-auto" %>
        </div>

      <% end %>
    </div>
  </div>
</div>