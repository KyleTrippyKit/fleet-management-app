<%# app/views/vmcott/vendor_rfqs/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">RFQ #<%= @vendor_rfq.rfq_number %></h5>
          <span class="badge bg-light text-dark">Status: <%= @vendor_rfq.status.titleize %></span>
        </div>
        <div class="card-body">
          
          <!-- Next Step Guidance -->
          <% if @vendor_rfq.draft? %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Next step:</strong> Review the RFQ details and send to suppliers.
            </div>
          <% elsif @vendor_rfq.sent? %>
            <div class="alert alert-warning">
              <i class="bi bi-clock-history me-2"></i>
              <strong>Waiting for vendor responses.</strong> Upload quotations when they arrive.
            </div>
          <% end %>
          
          <!-- RFQ Details -->
          <div class="row mb-4">
            <div class="col-md-6">
              <h6>RFQ Information</h6>
              <table class="table table-sm">
                <tr>
                  <th style="width: 30%;">Created:</th>
                  <td><%= @vendor_rfq.created_at.strftime("%b %d, %Y") %></td>
                </tr>
                <tr>
                  <th>Due Date:</th>
                  <td><%= @vendor_rfq.due_date&.strftime("%b %d, %Y") || 'Not set' %></td>
                </tr>
                <tr>
                  <th>Sent Date:</th>
                  <td><%= @vendor_rfq.sent_date&.strftime("%b %d, %Y") || 'Not sent' %></td>
                </tr>
                <tr>
                  <th>Notes:</th>
                  <td><%= @vendor_rfq.notes.presence || 'None' %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <h6>Parts Requested</h6>
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                  </tr>
                </thead>
                <tbody>
                  <% @vendor_rfq.vendor_rfq_items.each do |item| %>
                    <tr>
                      <td>
                        <%= item.part_name %>
                        <% if item.custom? %>
                          <span class="badge bg-warning ms-1">Custom</span>
                        <% end %>
                      </td>
                      <td><%= item.quantity %></td>
                      <td><%= item.unit_of_measure %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
          
          <!-- Selected Suppliers with Status Indicators -->
          <h6>Selected Suppliers (<%= @vendor_rfq.vendor_quotations.count %>)</h6>
          <div class="mb-4">
            <div class="row">
              <% @vendor_rfq.vendor_quotations.each do |quote| %>
                <div class="col-md-4 mb-3">
                  <div class="card <%= quote.status == 'received' ? 'border-success' : 'border-warning' %>">
                    <div class="card-body">
                      <h6 class="card-title"><%= quote.supplier&.name || 'Unknown' %></h6>
                      <p class="small mb-2">
                        Status: 
                        <% if quote.status == 'received' %>
                          <span class="badge bg-success">✅ Quotation Received</span>
                          <br>
                          <small class="text-success">
                            <%= number_to_currency(quote.total_amount) if quote.total_amount.present? %>
                          </small>
                        <% else %>
                          <span class="badge bg-warning">⏳ Awaiting Response</span>
                        <% end %>
                      </p>
                      
                      <!-- Attachment link if available -->
                      <% if quote.status == 'received' && quote.respond_to?(:attachment) && quote.attachment.attached? %>
                        <div class="mt-2">
                          <i class="bi bi-paperclip"></i>
                          <%= link_to "View Attachment", url_for(quote.attachment), target: "_blank", class: "small" %>
                        </div>
                      <% end %>
                      
                      <!-- Upload button for billing users -->
                      <% if current_user.billing? && quote.status != 'received' && @vendor_rfq.sent? %>
                        <div class="mt-2">
                          <%= link_to "Upload Quotation", 
                                vmcott_billing_upload_quotation_path(rfq_id: @vendor_rfq.id),
                                class: "btn btn-sm btn-outline-primary" %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          
          <!-- All Quotations Received Alert -->
          <% if @vendor_rfq.vendor_quotations.where(status: 'received').count == @vendor_rfq.vendor_quotations.count && @vendor_rfq.vendor_quotations.count > 0 %>
            <div class="alert alert-success mt-3">
              <i class="bi bi-check-circle-fill me-2"></i>
              <strong>All quotations received!</strong> 
              <%= link_to "Forward to Finance", vmcott_billing_forward_to_finance_path(rfq_id: @vendor_rfq.id), 
                    method: :post,
                    class: "btn btn-sm btn-success ms-3",
                    data: { confirm: "Forward these quotations to Finance team for review?" } %>
            </div>
          <% end %>
          
          <!-- Quotations Summary (for received quotes) -->
          <% if @vendor_rfq.vendor_quotations.where(status: 'received').any? %>
            <div class="mt-4">
              <h6>Quotations Summary</h6>
              <div class="table-responsive">
                <table class="table table-sm table-bordered">
                  <thead class="table-light">
                    <tr>
                      <th>Supplier</th>
                      <th>Total Amount</th>
                      <th>Notes</th>
                      <th>Received</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @vendor_rfq.vendor_quotations.where(status: 'received').each do |quote| %>
                      <tr>
                        <td><strong><%= quote.supplier&.name %></strong></td>
                        <td><%= number_to_currency(quote.total_amount) %></td>
                        <td><%= quote.notes.truncate(30) if quote.notes.present? %></td>
                        <td><%= quote.created_at.strftime("%b %d, %Y") %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>
          
          <!-- Action Buttons -->
          <div class="d-flex justify-content-end gap-2 mt-4">
            <%= link_to "Back to Dashboard", vmcott_billing_dashboard_path, class: "btn btn-outline-secondary" %>
            
            <% if @vendor_rfq.draft? %>
              <%= button_to "Send to Suppliers", 
                    vmcott_billing_send_rfq_path(@vendor_rfq),
                    method: :post,
                    class: "btn btn-success",
                    data: { confirm: "Send this RFQ to #{@vendor_rfq.vendor_quotations.count} suppliers?" } %>
            <% end %>
            
            <% if @vendor_rfq.sent? && @vendor_rfq.vendor_quotations.where(status: 'received').count < @vendor_rfq.vendor_quotations.count %>
              <%= link_to "Upload Quotation", 
                    vmcott_billing_upload_quotation_path(rfq_id: @vendor_rfq.id),
                    class: "btn btn-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>