<%# app/views/vmcott/billing/dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">💰 Welcome, <%= current_user.name %></h1>
      <p class="text-muted">VMCOTT Billing - Invoices & Payments</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Pending Invoices</h5>
          <h2 class="display-4"><%= @pending_invoices || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Paid This Month</h5>
          <h2 class="display-4"><%= @paid_this_month || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-danger text-white">
        <div class="card-body">
          <h5 class="card-title">Overdue</h5>
          <h2 class="display-4">0</h2>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h5>Recent Invoices</h5>
    </div>
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Vehicle</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @recent_invoices&.any? %>
            <% @recent_invoices.each do |invoice| %>
              <tr>
                <td><strong><%= invoice.invoice_number %></strong></td>
                <td>
                  <%= invoice.vehicle&.license_plate %><br>
                  <small class="text-muted"><%= invoice.vehicle&.make %> <%= invoice.vehicle&.model %></small>
                </td>
                <td><%= number_to_currency(invoice.amount) %></td>
                <td>
                  <span class="badge bg-<%= invoice.status == 'paid' ? 'success' : 'warning' %>">
                    <%= invoice.status.humanize %>
                  </span>
                </td>
                <td><%= invoice.due_date.strftime("%b %d, %Y") %></td>
                <td>
                  <%= link_to "View", vmcott_billing_invoice_path(invoice), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center text-muted">No recent invoices</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h5>Quick Actions</h5>
    </div>
    <div class="card-body">
      <%= link_to "View All Pending Invoices", vmcott_billing_invoices_path(status: 'pending'), class: "btn btn-outline-warning me-2" %>
      <%= link_to "View All Paid Invoices", vmcott_billing_invoices_path(status: 'paid'), class: "btn btn-outline-success me-2" %>
      <%= link_to "Generate Invoice", new_vmcott_billing_invoice_path, class: "btn btn-outline-primary" %>
    </div>
  </div>
</div>