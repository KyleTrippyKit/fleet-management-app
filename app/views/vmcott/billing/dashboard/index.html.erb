<%# app/views/vmcott/billing/dashboard/index.html.erb - REVISED WITH CLEAR ROLE SEPARATION %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">💰 Billing Dashboard</h1>
      <p class="text-muted">VMCOTT Billing - Create RFQs and upload vendor quotations</p>
    </div>
  </div>

  <!-- KPI Cards - Billing Team Only -->
  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Parts to Quote</h5>
          <h2 class="display-4"><%= @parts_to_quote_count || 0 %></h2>
          <p class="card-text"><small>Need RFQ creation</small></p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Active RFQs</h5>
          <h2 class="display-4"><%= @active_rfqs_count || 0 %></h2>
          <p class="card-text"><small>Waiting for vendor responses</small></p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Quotes to Review</h5>
          <h2 class="display-4"><%= @quotes_received_count || 0 %></h2>
          <p class="card-text"><small>Ready to send to Finance</small></p>
        </div>
      </div>
    </div>
  </div>

  <!-- PARTS REQUESTS NEEDING RFQ CREATION -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-envelope-paper me-2"></i>Parts Requests Needing RFQ Creation</h5>
          <span class="badge bg-light text-dark"><%= @pending_parts_requests&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @pending_parts_requests&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Request #</th>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>Urgency</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_parts_requests.each do |pr| %>
                    <tr>
                      <td><strong>#<%= pr.id %></strong></td>
                      <td>
                        <%= pr.inspection&.vehicle&.license_plate || 'N/A' %>
                        <br><small class="text-muted"><%= pr.inspection&.vehicle&.make %> <%= pr.inspection&.vehicle&.model %></small>
                      </td>
                      <td>
                        <%= pr.part&.name || pr.custom_part_name || 'Unknown Part' %>
                        <% if pr.part&.part_number %>
                          <br><small class="text-muted"><%= pr.part.part_number %></small>
                        <% end %>
                      </td>
                      <td><span class="badge bg-secondary"><%= pr.quantity %></span></td>
                      <td>
                        <% if pr.part&.current_stock.to_i <= 0 %>
                          <span class="badge bg-danger">Critical - Out of Stock</span>
                        <% elsif pr.part&.current_stock.to_i <= pr.part&.minimum_stock.to_i %>
                          <span class="badge bg-warning">High - Low Stock</span>
                        <% else %>
                          <span class="badge bg-info">Normal</span>
                        <% end %>
                      </td>
                      <td>
                        <%= link_to "Create RFQ", vmcott_billing_new_rfq_path(parts_request_id: pr.id), 
                              class: "btn btn-sm btn-primary",
                              title: "Create a new Request for Quotation" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-check-circle text-success fs-1 mb-3"></i>
              <p class="text-muted mb-0">No parts requests pending</p>
              <small class="text-muted">All caught up!</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- ACTIVE RFQS WAITING FOR VENDOR RESPONSES -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-send me-2"></i>Active RFQs - Waiting for Vendor Responses</h5>
          <span class="badge bg-light text-dark"><%= @active_rfqs&.count || 0 %> active</span>
        </div>
        <div class="card-body">
          <% if @active_rfqs&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>RFQ #</th>
                    <th>Parts</th>
                    <th>Suppliers</th>
                    <th>Sent</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @active_rfqs.each do |rfq| %>
                    <% 
                      quotes_count = rfq.vendor_quotations.count
                      has_quotations = quotes_count > 0
                    %>
                    <tr>
                      <td><strong><%= link_to rfq.rfq_number, vmcott_vendor_rfq_path(rfq), title: "View RFQ details" %></strong></td>
                      <td>
                        <% if rfq.vendor_rfq_items.present? %>
                          <% rfq.vendor_rfq_items.limit(2).each do |item| %>
                            <div><%= item.part&.name || item.description || 'Unknown Part' %></div>
                          <% end %>
                          <% if rfq.vendor_rfq_items.count > 2 %>
                            <span class="badge bg-secondary">+<%= rfq.vendor_rfq_items.count - 2 %> more</span>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No parts</span>
                        <% end %>
                      </td>
                      <td>
                        <% if rfq.vendor_quotations.present? %>
                          <% rfq.vendor_quotations.limit(2).each do |quote| %>
                            <div><%= quote.supplier&.name || 'Unknown' %></div>
                          <% end %>
                          <% if rfq.vendor_quotations.count > 2 %>
                            <span class="badge bg-secondary">+<%= rfq.vendor_quotations.count - 2 %> more</span>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No suppliers yet</span>
                        <% end %>
                      </td>
                      <td><%= rfq.sent_date&.strftime("%b %d, %Y") || 'Not sent' %></td>
                      <td>
                        <% if rfq.due_date.present? %>
                          <%= rfq.due_date.strftime("%b %d, %Y") %>
                          <% days_left = (rfq.due_date - Date.today).to_i %>
                          <% if days_left < 0 %>
                            <span class="badge bg-danger ms-1" title="Overdue by <%= days_left.abs %> days">Overdue</span>
                          <% elsif days_left <= 3 %>
                            <span class="badge bg-warning ms-1"><%= days_left %> days left</span>
                          <% else %>
                            <span class="badge bg-success ms-1"><%= days_left %> days left</span>
                          <% end %>
                        <% else %>
                          <span class="text-muted">Not set</span>
                        <% end %>
                      </td>
                      <td>
                        <% if has_quotations %>
                          <span class="badge bg-success">Quotes Received</span>
                        <% else %>
                          <span class="badge bg-warning">Awaiting Quotes</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to "Manage", vmcott_vendor_rfq_path(rfq), class: "btn btn-outline-primary", title: "View and manage RFQ" %>
                          
                          <% if has_quotations %>
                            <%= link_to "View Quotes", vmcott_vendor_rfq_path(rfq, anchor: 'quotations'), 
                                  class: "btn btn-outline-success",
                                  title: "View received quotations" %>
                          <% else %>
                            <%= link_to "Upload Quotes", vmcott_billing_upload_quotation_path(rfq_id: rfq.id), 
                                  class: "btn btn-success",
                                  title: "Upload quotations from suppliers" %>
                          <% end %>
                          
                          <% if rfq.status == 'draft' %>
                            <%= link_to "Send RFQ", vmcott_billing_send_rfq_path(rfq), 
                                  method: :post,
                                  class: "btn btn-info",
                                  data: { confirm: "Send this RFQ to selected suppliers?" },
                                  title: "Send to suppliers" %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
              <p class="text-muted mb-0">No active RFQs</p>
              <small class="text-muted">Create RFQs from parts requests above</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- QUOTATIONS READY FOR FINANCE REVIEW -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Quotations Ready for Finance Review</h5>
          <span class="badge bg-light text-dark"><%= @quotations_received&.count || 0 %> ready</span>
        </div>
        <div class="card-body">
          <% if @quotations_received.present? && @quotations_received.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>RFQ #</th>
                    <th>Parts</th>
                    <th>Quotes Received</th>
                    <th>Price Range</th>
                    <th>Suppliers</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @quotations_received.compact.each do |rfq| %>
                    <% 
                      quotes = rfq.vendor_quotations || []
                      prices = quotes.map { |q| q.total_amount }.compact
                      min_price = prices.min if prices.any?
                      max_price = prices.max if prices.any?
                      forwarded = rfq.finance_review_ready
                    %>
                    <tr>
                      <td><strong><%= link_to rfq.rfq_number, vmcott_vendor_rfq_path(rfq), title: "View RFQ details" %></strong></td>
                      <td>
                        <% if rfq.vendor_rfq_items.present? %>
                          <% rfq.vendor_rfq_items.each do |item| %>
                            <div><%= item.part&.name || item.description || 'Unknown' %> (x<%= item.quantity %>)</div>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No parts</span>
                        <% end %>
                      </td>
                      <td><span class="badge bg-primary"><%= quotes.count %> quotes</span></td>
                      <td>
                        <% if min_price && max_price %>
                          <%= number_to_currency(min_price) %> - <%= number_to_currency(max_price) %>
                        <% elsif min_price %>
                          <%= number_to_currency(min_price) %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td>
                        <% if quotes.any? %>
                          <% quotes.limit(2).each do |quote| %>
                            <div><%= quote.supplier&.name || 'Unknown' %></div>
                          <% end %>
                          <% if quotes.count > 2 %>
                            <span class="badge bg-secondary">+<%= quotes.count - 2 %> more</span>
                          <% end %>
                        <% else %>
                          <span class="text-muted">No suppliers</span>
                        <% end %>
                      </td>
                      <td>
                        <% if forwarded %>
                          <span class="badge bg-info">Forwarded to Finance</span>
                        <% else %>
                          <span class="badge bg-warning">Pending Forward</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to "View Quotes", vmcott_vendor_rfq_path(rfq, anchor: 'quotations'), 
                                class: "btn btn-outline-secondary",
                                title: "View all received quotations" %>
                          
                          <% unless forwarded %>
                            <%= link_to "Forward to Finance", vmcott_billing_forward_to_finance_path(rfq_id: rfq.id), 
                                  method: :post,
                                  class: "btn btn-success",
                                  data: { confirm: "Forward these quotations to Finance team for review and selection?" },
                                  title: "Send to Finance for quotation comparison" %>
                          <% else %>
                            <span class="text-muted">✓ Forwarded</span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <div class="alert alert-info mt-3 mb-0">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Note:</strong> The Finance team will review these quotations, compare prices, and select the best option to create a Purchase Order.
            </div>
            
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-file-earmark-text fs-1 text-muted mb-3"></i>
              <p class="text-muted mb-0">No quotations ready for finance review</p>
              <small class="text-muted">Upload quotations from the Active RFQs section above</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- PARTS RECEIVED - READY FOR STOCK UPDATE -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Parts Received - Ready for Stock Update</h5>
          <span class="badge bg-light text-dark"><%= @parts_received&.count || 0 %> pending</span>
        </div>
        <div class="card-body">
          <% if @parts_received&.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Inspection #</th>
                    <th>Vehicle</th>
                    <th>Part</th>
                    <th>Quantity</th>
                    <th>PO #</th>
                    <th>Vendor</th>
                    <th>Received At</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @parts_received.each do |pr| %>
                    <tr>
                      <td><%= link_to "##{pr.inspection.id}", vmcott_inspector_inspection_path(pr.inspection), title: "View inspection" if pr.inspection %></td>
                      <td><%= pr.inspection&.vehicle&.license_plate || 'N/A' %></td>
                      <td><%= pr.part&.name || pr.custom_part_name || 'Unknown Part' %></td>
                      <td><%= pr.quantity %></td>
                      <td>
                        <% if pr.purchase_order.present? %>
                          <%= link_to pr.purchase_order.po_number, purchase_order_path(pr.purchase_order), title: "View purchase order" %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td>
                        <% if pr.purchase_order.present? %>
                          <%= pr.purchase_order.vendor %>
                        <% else %>
                          <span class="text-muted">N/A</span>
                        <% end %>
                      </td>
                      <td><%= pr.parts_received_at&.strftime("%b %d, %Y") %></td>
                      <td>
                        <% if pr.status == 'parts_received' && !pr.in_stock %>
                          <%= button_to "Update Stock", update_stock_vmcott_parts_request_path(pr), 
                                method: :post, 
                                class: "btn btn-sm btn-success", 
                                data: { confirm: "Add #{pr.quantity} #{pr.part&.name || pr.custom_part_name} to inventory?" },
                                title: "Add to inventory" %>
                        <% else %>
                          <span class="badge bg-success">Stock Updated</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-box-seam fs-1 text-muted mb-3"></i>
              <p class="text-muted mb-0">No parts received awaiting stock update</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>