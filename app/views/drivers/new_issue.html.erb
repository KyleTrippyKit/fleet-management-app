<%# app/views/drivers/new_issue.html.erb %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Report an Issue</h1>
    <%= link_to "Back to Dashboard", driver_dashboard_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body">
          <%= form_with url: create_issue_drivers_path, local: true do |f| %>
            
            <div class="mb-3">
              <%= f.label :vehicle_id, "Vehicle", class: "form-label fw-bold" %>
              <%= f.select :vehicle_id, 
                  options_from_collection_for_select(@vehicles, :id, :display_name),
                  { include_blank: "Select a vehicle" },
                  class: "form-select", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :title, "Issue Title", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control", placeholder: "Brief description of the issue", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :description, "Description", class: "form-label fw-bold" %>
              <%= f.text_area :description, rows: 4, class: "form-control", 
                  placeholder: "Please provide details about the issue...", required: true %>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :severity, "Severity", class: "form-label fw-bold" %>
                <%= f.select :severity, 
                    options_for_select([["Minor", "minor"], ["Moderate", "moderate"], ["Major", "major"], ["Critical", "critical"]]),
                    { selected: "moderate" },
                    class: "form-select" %>
              </div>
              <div class="col-md-6">
                <%= f.label :priority, "Priority", class: "form-label fw-bold" %>
                <%= f.select :priority, 
                    options_for_select([["Low", "low"], ["Medium", "medium"], ["High", "high"], ["Urgent", "urgent"]]),
                    { selected: "medium" },
                    class: "form-select" %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Submit Issue Report", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>