<%# app/views/drivers/index.html.erb %>
<div class="container py-4">
  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Drivers</h1>
    <%= link_to "Add New Driver", new_driver_path, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
  </div>

  <!-- Search & Stats -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <div class="row">
        <div class="col-md-8">
          <%= form_with url: drivers_path, method: :get, data: { turbo_frame: "drivers_table" }, class: "row g-2" do |f| %>
            <div class="col-md-8">
              <div class="input-group">
                <%= f.text_field :query, 
                      value: params[:query],
                      placeholder: "Search drivers by name, license, or employee ID...",
                      class: "form-control" %>
                <%= f.button type: "submit", class: "btn btn-outline-primary" do %>
                  <i class="bi bi-search"></i> Search
                <% end %>
              </div>
            </div>
            <div class="col-md-4">
              <%= link_to "Clear Search", drivers_path, class: "btn btn-outline-secondary w-100", data: { turbo_frame: "drivers_table" } %>
            </div>
          <% end %>
        </div>
        <div class="col-md-4 text-end">
          <small class="text-muted">
            <%= @drivers.total_count %> drivers total • 
            <%= Driver.active.count %> active • 
            <%= Driver.inactive.count %> inactive
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Drivers Table -->
  <%= turbo_frame_tag "drivers_table" do %>
    <% if @drivers.any? %>
      <div class="card shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th><%= sortable("name", "Driver") %></th>
                <th><%= sortable("license_number", "License #") %></th>
                <th><%= sortable("status", "Status") %></th>
                <th>Assigned Vehicles</th>
                <th>Contact</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @drivers.each do |driver| %>
                <tr class="<%= driver.active? ? '' : 'table-secondary' %>">
                  <!-- Driver Name -->
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-2">
                        <i class="bi bi-person-circle text-muted"></i>
                      </div>
                      <div>
                        <%= link_to driver.name, driver_path(driver), class: "text-decoration-none fw-medium", data: { turbo_frame: "_top" } %>
                        <% if driver.employee_id.present? %>
                          <br><small class="text-muted"><%= driver.employee_id %></small>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <!-- License Number -->
                  <td>
                    <%= driver.license_number.presence || content_tag(:span, "—", class: "text-muted") %>
                  </td>

                  <!-- Status -->
                  <td>
                    <span class="badge <%= driver.active? ? 'bg-success' : 'bg-secondary' %>">
                      <%= driver.status.titleize %>
                    </span>
                  </td>

                  <!-- Assigned Vehicles -->
                  <td>
                    <% if driver.vehicles.any? %>
                      <div class="d-flex flex-wrap gap-1">
                        <% driver.vehicles.limit(2).each do |vehicle| %>
                          <span class="badge bg-info text-dark">
                            <%= link_to vehicle.registration_number.presence || vehicle.license_plate, 
                                  vehicle_path(vehicle), 
                                  class: "text-decoration-none text-dark",
                                  data: { turbo_frame: "_top" } %>
                          </span>
                        <% end %>
                        <% if driver.vehicles.count > 2 %>
                          <span class="badge bg-light text-muted">
                            +<%= driver.vehicles.count - 2 %> more
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-muted">None</span>
                    <% end %>
                  </td>

                  <!-- Contact -->
                  <td>
                    <% if driver.contact_number.present? %>
                      <small><%= driver.contact_number %></small>
                    <% elsif driver.phone.present? %>
                      <small><%= driver.phone %></small>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>

                  <!-- Actions -->
                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to "View", driver_path(driver), class: "btn btn-outline-primary", data: { turbo_frame: "_top" } %>
                      <%= link_to "Edit", edit_driver_path(driver), class: "btn btn-outline-secondary", data: { turbo_frame: "_top" } %>
                      
                      <% if driver.trips.none? && driver.vehicles.none? %>
                        <%= button_to "Delete", 
                              driver_path(driver), 
                              method: :delete,
                              data: { 
                                turbo_confirm: "Delete #{driver.name}?",
                                turbo_frame: "_top"
                              },
                              class: "btn btn-outline-danger btn-sm" %>
                      <% else %>
                        <button class="btn btn-outline-danger btn-sm" disabled title="Cannot delete driver with trips or assigned vehicles">
                          Delete
                        </button>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if @drivers.total_pages > 1 %>
          <div class="card-footer">
            <div class="d-flex justify-content-center">
              <%= paginate @drivers, data: { turbo_frame: "drivers_table" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card shadow-sm">
        <div class="card-body text-center py-5">
          <i class="bi bi-person-x display-1 text-muted mb-3"></i>
          <h4 class="text-muted">No drivers found</h4>
          <% if params[:query].present? %>
            <p class="text-muted">No drivers match your search for "<%= params[:query] %>"</p>
            <%= link_to "Clear search", drivers_path, class: "btn btn-outline-primary mt-2", data: { turbo_frame: "drivers_table" } %>
          <% else %>
            <p class="text-muted">Get started by adding your first driver</p>
            <%= link_to "Add New Driver", new_driver_path, class: "btn btn-primary mt-2", data: { turbo_frame: "_top" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>