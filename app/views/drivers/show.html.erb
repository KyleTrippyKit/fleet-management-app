<%# app/views/drivers/show.html.erb %>
<div class="container py-4">
  <!-- ============================================================
       Header Section
       ============================================================ -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Driver: <%= @driver.name %></h1>
    <div>
      <%= link_to "Edit Driver", edit_driver_path(@driver), class: "btn btn-warning", data: { turbo_frame: "_top" } %>
      <%= link_to "Back to Drivers", drivers_path, class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
    </div>
  </div>

  <!-- ============================================================
       Driver Status & Contact Card
       ============================================================ -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Driver Information</h5>
          <table class="table table-sm">
            <tr>
              <th width="40%">Status:</th>
              <td>
                <span class="badge <%= @driver.active? ? 'bg-success' : 'bg-secondary' %>">
                  <%= @driver.status.titleize %>
                </span>
              </td>
            </tr>
            <tr>
              <th>License #:</th>
              <td><%= @driver.license_number || "—" %></td>
            </tr>
            <tr>
              <th>Employee ID:</th>
              <td><%= @driver.employee_id || "—" %></td>
            </tr>
            <tr>
              <th>Contact:</th>
              <td><%= @driver.contact_number.presence || @driver.phone.presence || "Not provided" %></td>
            </tr>
            <tr>
              <th>Emergency Contact:</th>
              <td>
                <% if @driver.emergency_contact_name.present? %>
                  <%= @driver.emergency_contact_name %> 
                  <br><small><%= @driver.emergency_contact_phone %></small>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
            <tr>
              <th>Notes:</th>
              <td><%= @driver.notes.presence || "—" %></td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Current Assignment</h5>
          <% if @assigned_vehicles.present? && @assigned_vehicles.any? %>
            <div class="mb-3">
              <strong>Currently Driving:</strong>
              <ul class="list-group mt-2">
                <% @assigned_vehicles.each do |vehicle| %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <%= link_to vehicle.display_name, vehicle_path(vehicle), class: "text-decoration-none", data: { turbo_frame: "_top" } %>
                    <span class="badge <%= vehicle.status == 'active' ? 'bg-success' : 'bg-warning' %>">
                      <%= vehicle.status&.titleize || 'Unknown' %>
                    </span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% else %>
            <p class="text-muted mb-3">No vehicles currently assigned.</p>
          <% end %>
          
          <div class="alert alert-info">
            <small>
              <i class="bi bi-info-circle"></i>
              To report maintenance issues, drivers should use the "Report Issue" button on the vehicle page.
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       Recent Trips
       ============================================================ -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Recent Trips</h5>
      <% if @trips.present? && @trips.any? %>
        <p class="text-muted mb-3">
          <small>Recent driving activity recorded for this driver.</small>
        </p>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Date</th>
                <th>Vehicle</th>
                <th>Duration</th>
                <th>Distance</th>
              </tr>
            </thead>
            <tbody>
              <% @trips.each do |trip| %>
                <tr>
                  <td><%= trip.start_time.strftime("%b %d, %Y") %></td>
                  <td><%= trip.vehicle&.display_name || "Unknown" %></td>
                  <td><%= "%.1f" % (trip.duration_hours || 0) %> hrs</td>
                  <td><%= number_with_delimiter(trip.distance_km || 0) %> km</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= paginate @trips, param_name: :trip_page if @trips.respond_to?(:total_pages) && @trips.total_pages > 1 %>
      <% else %>
        <p class="text-muted">No trips recorded for this driver.</p>
      <% end %>
    </div>
  </div>

  <!-- ============================================================
       Delete Button (Conditional)
       ============================================================ -->
  <% if @driver.trips.none? && @driver.vehicles.none? %>
    <div class="card border-danger shadow-sm">
      <div class="card-body text-center">
        <h6 class="card-title text-danger">Delete Driver</h6>
        <p class="text-muted small mb-3">
          This will permanently remove the driver record. Only available if driver has no trips or vehicles.
        </p>
        <%= button_to "Delete Driver", 
              driver_path(@driver), 
              method: :delete,
              data: { 
                turbo_confirm: "Are you sure you want to delete #{@driver.name}? This action cannot be undone.",
                turbo_frame: "_top"
              },
              class: "btn btn-outline-danger btn-sm" %>
      </div>
    </div>
  <% end %>
</div>