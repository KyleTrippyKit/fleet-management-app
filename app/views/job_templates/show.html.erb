<%# app/views/job_templates/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-tools me-2"></i><%= @job_template.name %>
              </h4>
              <small class="opacity-75"><%= @job_template.category || 'Uncategorized' %></small>
            </div>
            <div>
              <%= link_to 'Usage Stats', usage_stats_job_template_path(@job_template), class: 'btn btn-sm btn-info me-2' %>
              <%= link_to 'Edit', edit_job_template_path(@job_template), class: 'btn btn-sm btn-warning me-2' %>
              <%= link_to 'Back', job_templates_path, class: 'btn btn-sm btn-secondary' %>
            </div>
          </div>
        </div>
        
        <div class="card-body">
          <div class="row">
            <div class="col-md-8">
              <div class="card mb-4">
                <div class="card-header">
                  <h5 class="mb-0">Template Details</h5>
                </div>
                <div class="card-body">
                  <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9"><%= @job_template.name %></dd>
                    
                    <dt class="col-sm-3">Description:</dt>
                    <dd class="col-sm-9"><%= @job_template.description.presence || 'No description provided' %></dd>
                    
                    <dt class="col-sm-3">Category:</dt>
                    <dd class="col-sm-9">
                      <span class="badge bg-info"><%= @job_template.category || 'Uncategorized' %></span>
                    </dd>
                    
                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                      <% if @job_template.is_active %>
                        <span class="badge bg-success">Active</span>
                      <% else %>
                        <span class="badge bg-secondary">Inactive</span>
                      <% end %>
                    </dd>
                    
                    <dt class="col-sm-3">Standard Hours:</dt>
                    <dd class="col-sm-9"><%= @job_template.standard_hours %> hours</dd>
                    
                    <dt class="col-sm-3">Labor Rate:</dt>
                    <dd class="col-sm-9">$<%= number_with_precision(@job_template.labor_rate_per_hour, precision: 2) %>/hour</dd>
                    
                    <dt class="col-sm-3">Total Labor:</dt>
                    <dd class="col-sm-9">$<%= number_with_precision(@job_template.standard_hours * @job_template.labor_rate_per_hour, precision: 2) %></dd>
                  </dl>
                </div>
              </div>
              
              <% if @job_template.procedures.present? && @job_template.procedures.any? %>
                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="mb-0">Procedures</h5>
                  </div>
                  <div class="card-body">
                    <ol class="mb-0">
                      <% @job_template.procedures.each do |procedure| %>
                        <li><%= procedure %></li>
                      <% end %>
                    </ol>
                  </div>
                </div>
              <% end %>
            </div>
            
            <div class="col-md-4">
              <!-- Parts Card -->
              <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h5 class="mb-0">Required Parts</h5>
                  <span class="badge bg-primary"><%= @parts.count %></span>
                </div>
                <div class="card-body">
                  <% if @parts.any? %>
                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>Part</th>
                            <th>Qty</th>
                            <th>Required</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% @job_template.job_template_parts.includes(:part).each do |jtp| %>
                            <tr>
                              <td>
                                <% if jtp.part %>
                                  <%= link_to jtp.part.name, vmcott_part_path(jtp.part), class: 'text-decoration-none' %>
                                <% else %>
                                  <span class="text-muted">Part not found</span>
                                <% end %>
                              </td>
                              <td><%= jtp.quantity %></td>
                              <td>
                                <% if jtp.required %>
                                  <span class="badge bg-success">Yes</span>
                                <% else %>
                                  <span class="badge bg-secondary">No</span>
                                <% end %>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-muted text-center mb-0">No parts assigned to this template</p>
                  <% end %>
                </div>
              </div>
              
              <!-- Quick Actions Card -->
              <div class="card mb-4">
                <div class="card-header">
                  <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                  <div class="d-grid gap-2">
                    <%= link_to 'Add to Quotation', select_quotation_job_template_path(@job_template), 
                        class: 'btn btn-primary btn-sm', 
                        data: { turbo_method: :get, turbo_frame: 'modal' } %>
                    <%= link_to 'Duplicate Template', duplicate_job_template_path(@job_template), 
                        class: 'btn btn-outline-secondary btn-sm', 
                        data: { turbo_method: :post, confirm: 'Duplicate this template?' } %>
                    <%= link_to 'Usage Statistics', usage_stats_job_template_path(@job_template), 
                        class: 'btn btn-info btn-sm' %>
                  </div>
                </div>
              </div>
              
              <!-- Recent Usage Card -->
              <% if @recent_usage.any? %>
                <div class="card">
                  <div class="card-header">
                    <h5 class="mb-0">Recent Usage</h5>
                  </div>
                  <div class="card-body">
                    <div class="list-group list-group-flush">
                      <% @recent_usage.each do |usage| %>
                        <div class="list-group-item px-0">
                          <div class="d-flex justify-content-between">
                            <small>
                              <% if usage.quotation %>
                                <%= link_to "Quotation ##{usage.quotation.quote_number}", usage.quotation, class: 'text-decoration-none' %>
                              <% else %>
                                Quotation
                              <% end %>
                            </small>
                            <small class="text-muted">
                              <%= time_ago_in_words(usage.created_at) %> ago
                            </small>
                          </div>
                          <% if usage.quotation&.vehicle %>
                            <small class="text-muted">
                              <i class="fas fa-car me-1"></i>
                              <%= usage.quotation.vehicle.license_plate %>
                            </small>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="d-flex justify-content-between">
            <small class="text-muted">
              Created: <%= @job_template.created_at.strftime('%B %d, %Y') %>
              <% if @job_template.created_at != @job_template.updated_at %>
                | Updated: <%= @job_template.updated_at.strftime('%B %d, %Y') %>
              <% end %>
            </small>
            <div>
              <%= link_to 'Delete', @job_template, 
                  method: :delete, 
                  data: { confirm: 'Are you sure you want to delete this template?' },
                  class: 'btn btn-sm btn-danger' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>