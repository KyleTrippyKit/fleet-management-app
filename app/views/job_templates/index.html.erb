<%# app/views/job_templates/index.html.erb %>
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-5">
    <div>
      <h1 class="h3 fw-semibold text-dark mb-1">Job Templates</h1>
      <p class="text-muted mb-0">Select templates to add to quotations in your RFQ inbox</p>
    </div>
    <div class="btn-group">
      <%= link_to new_job_template_path, class: 'btn btn-primary d-flex align-items-center' do %>
        <i class="bi bi-plus-circle me-2"></i> New Template
      <% end %>
      <%= link_to import_defaults_job_templates_path, 
            method: :post, 
            class: 'btn btn-outline-secondary d-flex align-items-center',
            data: { confirm: 'Import default job templates?' } do %>
        <i class="bi bi-download me-2"></i> Import Defaults
      <% end %>
    </div>
  </div>

  <!-- Quotation Selection Modal -->
  <div class="modal fade" id="quotationSelectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Select Quotation</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="modalBody">
          <!-- Content will be loaded via AJAX -->
          <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading quotations...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @job_templates.blank? %>
    <div class="card border-light shadow-sm">
      <div class="card-body text-center py-5">
        <div class="mb-4">
          <i class="bi bi-tools text-muted" style="font-size: 3rem;"></i>
        </div>
        <h4 class="text-dark mb-3">No job templates yet</h4>
        <p class="text-muted mb-4">Create your first job template or import default ones</p>
        <%= link_to import_defaults_job_templates_path, 
              method: :post, 
              class: 'btn btn-primary px-4' do %>
          <i class="bi bi-download me-2"></i> Import Templates
        <% end %>
      </div>
    </div>
  <% else %>
    <!-- Search and Filter -->
    <div class="card border-light shadow-sm mb-4">
      <div class="card-body p-3">
        <div class="row g-3">
          <div class="col-md-6">
            <%= form_with url: job_templates_path, method: :get, local: true, class: 'd-flex' do %>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="bi bi-search text-muted"></i>
                </span>
                <%= text_field_tag :search, params[:search], 
                      class: 'form-control border-start-0', 
                      placeholder: 'Search templates...' %>
                <%= submit_tag 'Search', class: 'btn btn-outline-primary' %>
              </div>
            <% end %>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <span class="text-muted me-3">Filter:</span>
              <div class="btn-group flex-wrap">
                <%= link_to 'All', job_templates_path, 
                      class: "btn btn-sm btn-outline-secondary #{'active' unless params[:category]}" %>
                <% JobTemplate.distinct.pluck(:category).compact.sort.each do |category| %>
                  <%= link_to category, job_templates_path(category: category), 
                        class: "btn btn-sm btn-outline-secondary #{'active' if params[:category] == category}" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Summary -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card border-light shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <div class="bg-primary bg-opacity-10 rounded p-3">
                  <i class="bi bi-layers text-primary" style="font-size: 1.5rem;"></i>
                </div>
              </div>
              <div class="flex-grow-1 ms-3">
                <h5 class="mb-0"><%= @job_templates.size %></h5>
                <p class="text-muted mb-0 small">Total Templates</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-light shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <div class="bg-success bg-opacity-10 rounded p-3">
                  <i class="bi bi-check-circle text-success" style="font-size: 1.5rem;"></i>
                </div>
              </div>
              <div class="flex-grow-1 ms-3">
                <h5 class="mb-0"><%= @job_templates.where(is_active: true).size %></h5>
                <p class="text-muted mb-0 small">Active</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-light shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <div class="bg-info bg-opacity-10 rounded p-3">
                  <i class="bi bi-tags text-info" style="font-size: 1.5rem;"></i>
                </div>
              </div>
              <div class="flex-grow-1 ms-3">
                <h5 class="mb-0"><%= @job_templates.pluck(:category).compact.uniq.size %></h5>
                <p class="text-muted mb-0 small">Categories</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-light shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="flex-shrink-0">
                <div class="bg-warning bg-opacity-10 rounded p-3">
                  <i class="bi bi-file-text text-warning" style="font-size: 1.5rem;"></i>
                </div>
              </div>
              <div class="flex-grow-1 ms-3">
                <h5 class="mb-0">
                  <%= link_to quotations_path, class: 'text-decoration-none text-dark' do %>
                    <%= current_user.quotations.where(status: 0).count %>
                  <% end %>
                </h5>
                <p class="text-muted mb-0 small">
                  <%= link_to 'Pending Quotes', quotations_path, class: 'text-decoration-none text-muted' %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Job Templates Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      <% @job_templates.each do |template| %>
        <div class="col">
          <%= render 'job_card', job_template: template %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @job_templates.respond_to?(:total_pages) %>
      <div class="d-flex justify-content-center mt-5">
        <%= paginate @job_templates, theme: 'bootstrap-5' %>
      </div>
    <% end %>
  <% end %>
</div>

<script>
// Global function for quotation selection
window.initializeQuotationSelection = function() {
  console.log('initializeQuotationSelection function called');
  
  // Handle quotation selection
  const selectButtons = document.querySelectorAll('.select-quotation-btn');
  console.log(`Found ${selectButtons.length} select-quotation buttons`);
  
  selectButtons.forEach(button => {
    // Remove existing listeners to prevent duplicates
    button.replaceWith(button.cloneNode(true));
  });
  
  // Re-get the buttons after cloning
  document.querySelectorAll('.select-quotation-btn').forEach(button => {
    button.addEventListener('click', function() {
      console.log('Select button clicked');
      const templateId = this.dataset.templateId;
      const quotationId = this.dataset.quotationId;
      const quotationNumber = this.dataset.quotationNumber;
      const button = this;
      
      console.log('Template ID:', templateId);
      console.log('Quotation ID:', quotationId);
      console.log('Quotation Number:', quotationNumber);
      
      // Show loading state
      const originalHTML = button.innerHTML;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Adding...';
      button.disabled = true;
      
      // Also disable other buttons
      document.querySelectorAll('.select-quotation-btn, .quick-add-btn').forEach(btn => {
        if (btn !== button) btn.disabled = true;
      });
      
      // Send AJAX request to add template to quotation
      fetch(`/job_templates/${templateId}/add_to_quotation`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ quotation_id: quotationId })
      })
      .then(response => {
        console.log('Response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('Response data:', data);
        if (data.success) {
          // Show success message WITH WORKING LINK
          const modalBody = document.getElementById('modalBody');
          if (modalBody) {
            modalBody.innerHTML = `
              <div class="text-center py-4">
                <div class="mb-3">
                  <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                </div>
                <h5>Template Added Successfully!</h5>
                <p class="text-muted">
                  <strong>${data.message}</strong>
                </p>
                ${data.added_parts_count > 0 ? 
                  `<p class="text-muted small">
                    <i class="bi bi-box-seam"></i> ${data.added_parts_count} parts added<br>
                    <i class="bi bi-clock"></i> Labor cost: $${parseFloat(data.total_labor_cost || 0).toFixed(2)}
                  </p>` : ''}
                <div class="mt-4">
                  <a href="${data.quotation_path}" class="btn btn-primary" id="viewQuotationBtn">
                    <i class="bi bi-eye me-1"></i> View Quotation ${data.quotation_number}
                  </a>
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Close
                  </button>
                </div>
                <p class="text-muted small mt-3">
                  You will be redirected in 3 seconds...
                </p>
              </div>
            `;
            
            // Add click handler for the view button
            document.getElementById('viewQuotationBtn')?.addEventListener('click', function(e) {
              console.log('View button clicked, navigating to:', data.quotation_path);
              // Let the link handle the navigation naturally
            });
            
            // Auto-redirect after 3 seconds
            setTimeout(() => {
              console.log('Auto-redirecting to:', data.quotation_path);
              if (data.quotation_path) {
                window.location.href = data.quotation_path;
              }
            }, 3000);
          }
        } else {
          // Show error
          console.error('Error from server:', data.error);
          const modalBody = document.getElementById('modalBody');
          if (modalBody) {
            modalBody.innerHTML = `
              <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                ${data.error || 'Failed to add template to quotation.'}
              </div>
              <div class="text-center mt-3">
                <button type="button" class="btn btn-outline-primary" onclick="window.location.reload()">
                  <i class="bi bi-arrow-clockwise me-1"></i> Try Again
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                  <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
              </div>
            `;
          }
        }
      })
      .catch(error => {
        console.error('Error:', error);
        // Show error in modal instead of alert
        const modalBody = document.getElementById('modalBody');
        if (modalBody) {
          modalBody.innerHTML = `
            <div class="alert alert-danger">
              <i class="bi bi-exclamation-triangle"></i>
              Network error occurred. Please check your connection and try again.<br>
              <small>Error: ${error.message}</small>
            </div>
            <div class="text-center mt-3">
              <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()">
                Reload Page
              </button>
            </div>
          `;
        }
        
        // Reset button
        button.innerHTML = originalHTML;
        button.disabled = false;
      });
    });
  });
  
  // Handle quick add button
  const quickAddButtons = document.querySelectorAll('.quick-add-btn');
  console.log(`Found ${quickAddButtons.length} quick-add buttons`);
  
  quickAddButtons.forEach(button => {
    // Remove existing listeners to prevent duplicates
    button.replaceWith(button.cloneNode(true));
  });
  
  // Re-get the buttons after cloning
  document.querySelectorAll('.quick-add-btn').forEach(button => {
    button.addEventListener('click', function() {
      console.log('Quick add button clicked');
      const templateId = this.dataset.templateId;
      const quotationId = this.dataset.quotationId;
      const button = this;
      
      // Show loading state
      const originalHTML = button.innerHTML;
      button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
      button.disabled = true;
      
      // Send AJAX request
      fetch(`/job_templates/${templateId}/quick_add`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ quotation_id: quotationId })
      })
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('Quick add response:', data);
        if (data.success) {
          // Show success toast
          showToast('success', `Template added to quotation ${data.quotation_number}!`);
          // Close modal after a delay
          setTimeout(() => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('quotationSelectionModal'));
            modal?.hide();
            // Optional: Refresh the page to show updated template counts
            setTimeout(() => {
              window.location.reload();
            }, 500);
          }, 1500);
        } else {
          showToast('error', data.error || 'Failed to add template');
          button.innerHTML = originalHTML;
          button.disabled = false;
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showToast('error', 'Network error occurred');
        button.innerHTML = originalHTML;
        button.disabled = false;
      });
    });
  });
};

// Toast notification function
function showToast(type, message) {
  console.log('Showing toast:', type, message);
  
  // Create toast container if it doesn't exist
  let toastContainer = document.getElementById('toast-container');
  if (!toastContainer) {
    toastContainer = document.createElement('div');
    toastContainer.id = 'toast-container';
    toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
    toastContainer.style.zIndex = '1060';
    document.body.appendChild(toastContainer);
  }
  
  // Create toast
  const toastId = 'toast-' + Date.now();
  const toast = document.createElement('div');
  toast.id = toastId;
  toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
  toast.setAttribute('role', 'alert');
  toast.setAttribute('aria-live', 'assertive');
  toast.setAttribute('aria-atomic', 'true');
  
  toast.innerHTML = `
    <div class="d-flex">
      <div class="toast-body">
        <i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle'} me-2"></i>
        ${message}
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  `;
  
  toastContainer.appendChild(toast);
  
  // Initialize and show toast
  const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
  bsToast.show();
  
  // Remove toast from DOM after it's hidden
  toast.addEventListener('hidden.bs.toast', function () {
    toast.remove();
  });
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  console.log('Job Templates page loaded');
  
  // Initialize modal
  const quotationModalElement = document.getElementById('quotationSelectionModal');
  if (quotationModalElement) {
    console.log('Modal element found');
  } else {
    console.error('Modal element NOT found');
  }
  
  // Handle "Add to Quotation" button clicks
  const addButtons = document.querySelectorAll('.add-to-quotation-btn');
  console.log(`Found ${addButtons.length} add-to-quotation buttons`);
  
  addButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      
      const templateId = this.dataset.templateId;
      const templateName = this.dataset.templateName;
      
      console.log('Add to quote clicked for template:', templateId, templateName);
      
      // Set modal title
      document.getElementById('modalTitle').innerHTML = 
        `Add "${templateName}" to Quotation`;
      
      // Show loading indicator
      document.getElementById('modalBody').innerHTML = `
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2">Loading quotations...</p>
        </div>
      `;
      
      // Show modal first
      const modal = new bootstrap.Modal(document.getElementById('quotationSelectionModal'));
      modal.show();
      
      // Load quotations via AJAX
      fetch(`/job_templates/${templateId}/select_quotation.js`, {
        headers: {
          'Accept': 'text/javascript',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        console.log('AJAX response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.text();
      })
      .then(script => {
        console.log('Received JavaScript response');
        // Execute the JavaScript
        eval(script);
      })
      .catch(error => {
        console.error('Error loading quotations:', error);
        document.getElementById('modalBody').innerHTML = `
          <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>
            Error loading quotations. Please try again.<br>
            <small>Error: ${error.message}</small>
          </div>
          <div class="text-center mt-3">
            <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()">
              Reload Page
            </button>
          </div>
        `;
      });
    });
  });
});

// Make function available globally
window.showToast = showToast;
</script>