<%# app/views/job_templates/_job_card.html.erb %>
<div class="card h-100 border-light shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <h5 class="card-title mb-1">
          <%= link_to job_template.name, job_template, class: 'text-decoration-none text-dark' %>
        </h5>
        <% if job_template.category.present? %>
          <span class="badge bg-light text-dark border"><%= job_template.category %></span>
        <% end %>
      </div>
      <span class="badge bg-<%= job_template.is_active ? 'success' : 'secondary' %>">
        <%= job_template.is_active ? 'Active' : 'Inactive' %>
      </span>
    </div>
    
    <p class="card-text text-muted small mb-3">
      <%= truncate(job_template.description, length: 100) %>
    </p>
    
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <small class="text-muted">
          <i class="bi bi-clock"></i> <%= number_with_precision(job_template.standard_hours, precision: 1) %> hrs
        </small>
        <small class="text-muted ms-3">
          <i class="bi bi-currency-dollar"></i> <%= number_to_currency(job_template.labor_rate_per_hour) %>/hr
        </small>
      </div>
      <div>
        <small class="text-muted">
          <i class="bi bi-box-seam"></i> <%= job_template.parts.count %> parts
        </small>
      </div>
    </div>
    
    <div class="d-flex justify-content-between">
      <div class="btn-group">
        <%= link_to edit_job_template_path(job_template), 
              class: 'btn btn-sm btn-outline-secondary',
              title: 'Edit' do %>
          <i class="bi bi-pencil"></i>
        <% end %>
        
        <!-- UPDATED LINK: Added format: :js and data-turbo="false" -->
        <%= link_to 'Add to Quote', 
              select_quotation_job_template_path(job_template, format: :js), 
              remote: true, 
              class: 'btn btn-sm btn-primary add-to-quotation-btn',
              data: { 
                template_id: job_template.id,
                template_name: job_template.name,
                turbo: false 
              } %>
      </div>
      
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-light text-dark border" type="button" data-bs-toggle="dropdown">
          <i class="bi bi-three-dots"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li>
            <%= link_to 'Usage Stats', usage_stats_job_template_path(job_template), 
                  class: 'dropdown-item' %>
          </li>
          <li>
            <%= link_to 'Duplicate', duplicate_job_template_path(job_template), 
                  method: :post, 
                  class: 'dropdown-item' %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= link_to 'Delete', job_template, 
                  method: :delete, 
                  class: 'dropdown-item text-danger',
                  data: { confirm: 'Are you sure?' } %>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>