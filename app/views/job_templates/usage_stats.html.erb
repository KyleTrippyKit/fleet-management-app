<%# app/views/job_templates/usage_stats.html.erb - ENHANCED VERSION %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-info text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">
                <i class="fas fa-chart-bar me-2"></i>Usage Statistics: <%= @job_template.name %>
              </h4>
              <p class="mb-0 opacity-75"><%= @job_template.description %></p>
            </div>
            <div>
              <%= link_to @job_template, class: 'btn btn-sm btn-outline-light' do %>
                <i class="fas fa-arrow-left me-1"></i> Back to Template
              <% end %>
              <%= link_to 'Print', '#', class: 'btn btn-sm btn-outline-light ms-2', onclick: 'window.print(); return false;' %>
            </div>
          </div>
        </div>
        
        <div class="card-body">
          <!-- ========== QUICK STATS ROW ========== -->
          <div class="row mb-4">
            <div class="col-md-3">
              <div class="card text-center h-100 border-primary">
                <div class="card-body">
                  <h6 class="card-title text-muted">TOTAL USES</h6>
                  <h2 class="display-5 fw-bold text-primary"><%= @usage_stats[:total_uses] %></h2>
                  <p class="card-text small">
                    <i class="fas fa-calendar-alt me-1"></i>
                    Since <%= @usage_stats[:first_used] ? @usage_stats[:first_used].strftime('%b %Y') : 'Never used' %>
                  </p>
                </div>
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="card text-center h-100 border-success">
                <div class="card-body">
                  <h6 class="card-title text-muted">AVG/MONTH</h6>
                  <h2 class="display-5 fw-bold text-success"><%= number_with_precision(@usage_stats[:average_per_month], precision: 1) %></h2>
                  <p class="card-text small">
                    <i class="fas fa-chart-line me-1"></i>
                    Last 12 months
                  </p>
                </div>
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="card text-center h-100 border-warning">
                <div class="card-body">
                  <h6 class="card-title text-muted">LAST USED</h6>
                  <h4 class="fw-bold text-warning">
                    <%= @usage_stats[:last_used] ? time_ago_in_words(@usage_stats[:last_used]) + ' ago' : 'Never' %>
                  </h4>
                  <% if @usage_stats[:last_used] %>
                    <p class="card-text small">
                      <i class="fas fa-clock me-1"></i>
                      <%= @usage_stats[:last_used].strftime('%b %d, %Y') %>
                    </p>
                  <% end %>
                </div>
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="card text-center h-100 border-info">
                <div class="card-body">
                  <h6 class="card-title text-muted">UNIQUE VEHICLES</h6>
                  <h2 class="display-5 fw-bold text-info"><%= @usage_stats[:unique_vehicles] %></h2>
                  <p class="card-text small">
                    <i class="fas fa-car me-1"></i>
                    Across all quotations
                  </p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- ========== MAIN CONTENT ROW ========== -->
          <div class="row">
            <!-- LEFT COLUMN: Charts & Details -->
            <div class="col-lg-8">
              <!-- Monthly Usage Chart -->
              <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                  <h5 class="mb-0">
                    <i class="fas fa-chart-line me-2"></i>Monthly Usage Trend
                  </h5>
                  <span class="badge bg-primary">Last 6 months</span>
                </div>
                <div class="card-body">
                  <% if @monthly_usage.any? %>
                    <%= column_chart @monthly_usage, 
                        height: '300px',
                        colors: ["#0d6efd"],
                        library: {
                          chart: {
                            backgroundColor: 'transparent'
                          },
                          plotOptions: {
                            column: {
                              borderRadius: 4,
                              dataLabels: {
                                enabled: true,
                                style: {
                                  fontSize: '12px',
                                  fontWeight: 'bold'
                                }
                              }
                            }
                          },
                          xAxis: {
                            labels: {
                              style: {
                                fontSize: '12px'
                              }
                            }
                          },
                          yAxis: {
                            title: {
                              text: 'Usage Count'
                            },
                            gridLineWidth: 0.5,
                            gridLineColor: '#e9ecef'
                          }
                        } %>
                  <% else %>
                    <div class="text-center py-5">
                      <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                      <p class="text-muted">No usage data available for chart</p>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <!-- Agency Usage Breakdown -->
              <% if @usage_stats[:agencies_usage] && @usage_stats[:agencies_usage].any? %>
                <div class="card mb-4">
                  <div class="card-header bg-light">
                    <h5 class="mb-0">
                      <i class="fas fa-building me-2"></i>Usage by Agency
                    </h5>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table class="table table-hover">
                        <thead>
                          <tr>
                            <th>Agency</th>
                            <th class="text-end">Usage Count</th>
                            <th class="text-end">Percentage</th>
                            <th class="text-end">Trend</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% total = @usage_stats[:agencies_usage].values.sum %>
                          <% @usage_stats[:agencies_usage].sort_by { |_, v| -v }.each do |agency, count| %>
                            <tr>
                              <td>
                                <i class="fas fa-building text-muted me-2"></i>
                                <%= agency %>
                              </td>
                              <td class="text-end">
                                <span class="fw-bold"><%= count %></span>
                              </td>
                              <td class="text-end">
                                <% percentage = (count.to_f / total * 100).round(1) %>
                                <span class="badge bg-light text-dark">
                                  <%= percentage %>%
                                </span>
                              </td>
                              <td class="text-end">
                                <div class="progress" style="height: 8px; width: 100px; float: right;">
                                  <div class="progress-bar bg-success" 
                                       role="progressbar" 
                                       style="width: <%= percentage %>%"
                                       aria-valuenow="<%= percentage %>" 
                                       aria-valuemin="0" 
                                       aria-valuemax="100"></div>
                                </div>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            
            <!-- RIGHT COLUMN: Recent Usage & Details -->
            <div class="col-lg-4">
              <!-- Recent Usage -->
              <div class="card mb-4">
                <div class="card-header bg-light">
                  <h5 class="mb-0 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-history me-2"></i>Recent Usage</span>
                    <span class="badge bg-secondary">Last 5</span>
                  </h5>
                </div>
                <div class="card-body p-0">
                  <% if @recent_uses.any? %>
                    <div class="list-group list-group-flush">
                      <% @recent_uses.each do |use| %>
                        <div class="list-group-item">
                          <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                              <h6 class="mb-0">
                                <% if use.quotation %>
                                  <%= link_to quotation_path(use.quotation), class: 'text-decoration-none' do %>
                                    <i class="fas fa-file-invoice me-1"></i>
                                    Quotation #<%= use.quotation.quote_number || use.quotation.id %>
                                  <% end %>
                                <% else %>
                                  <i class="fas fa-tools me-1"></i>
                                  Usage #<%= use.id %>
                                <% end %>
                              </h6>
                              <% if use.quotation&.vehicle %>
                                <small class="text-muted">
                                  <i class="fas fa-car me-1"></i>
                                  <%= use.quotation.vehicle.license_plate %>
                                  <% if use.quotation.vehicle.make.present? || use.quotation.vehicle.model.present? %>
                                    (<%= [use.quotation.vehicle.make, use.quotation.vehicle.model].compact.join(' ') %>)
                                  <% end %>
                                </small>
                              <% end %>
                            </div>
                            <small class="text-muted">
                              <%= use.created_at.strftime('%b %d') %>
                            </small>
                          </div>
                          <div class="d-flex justify-content-between align-items-end">
                            <small class="text-muted">
                              <i class="far fa-clock me-1"></i>
                              <%= time_ago_in_words(use.created_at) %> ago
                            </small>
                            <% if use.quotation&.agency %>
                              <span class="badge bg-light text-dark">
                                <%= use.quotation.agency.code %>
                              </span>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-center py-5">
                      <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                      <p class="text-muted">No recent usage found</p>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <!-- Additional Statistics -->
              <div class="card">
                <div class="card-header bg-light">
                  <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>Detailed Statistics
                  </h5>
                </div>
                <div class="card-body">
                  <dl class="row mb-0">
                    <dt class="col-sm-7">First Used:</dt>
                    <dd class="col-sm-5 text-end">
                      <%= @usage_stats[:first_used] ? @usage_stats[:first_used].strftime('%b %d, %Y') : 'N/A' %>
                    </dd>
                    
                    <dt class="col-sm-7">Usage Period:</dt>
                    <dd class="col-sm-5 text-end">
                      <% if @usage_stats[:first_used] && @usage_stats[:last_used] %>
                        <%= distance_of_time_in_words(@usage_stats[:first_used], @usage_stats[:last_used]) %>
                      <% else %>
                        N/A
                      <% end %>
                    </dd>
                    
                    <dt class="col-sm-7">Usage Frequency:</dt>
                    <dd class="col-sm-5 text-end">
                      <% if @usage_stats[:total_uses] > 0 && @usage_stats[:first_used] %>
                        <% days_since_first = (Date.today - @usage_stats[:first_used].to_date).to_i %>
                        <% avg_days_between = days_since_first.to_f / @usage_stats[:total_uses] %>
                        Every <%= avg_days_between.round(1) %> days
                      <% else %>
                        N/A
                      <% end %>
                    </dd>
                    
                    <dt class="col-sm-7">Most Used Agency:</dt>
                    <dd class="col-sm-5 text-end">
                      <% if @usage_stats[:agencies_usage] && @usage_stats[:agencies_usage].any? %>
                        <% top_agency = @usage_stats[:agencies_usage].max_by { |_, v| v } %>
                        <span class="badge bg-primary"><%= top_agency[0] %></span>
                      <% else %>
                        N/A
                      <% end %>
                    </dd>
                    
                    <dt class="col-sm-7">Template Status:</dt>
                    <dd class="col-sm-5 text-end">
                      <% if @job_template.is_active %>
                        <span class="badge bg-success">Active</span>
                      <% else %>
                        <span class="badge bg-secondary">Inactive</span>
                      <% end %>
                    </dd>
                    
                    <dt class="col-sm-7">Category:</dt>
                    <dd class="col-sm-5 text-end">
                      <span class="badge bg-info"><%= @job_template.category || 'Uncategorized' %></span>
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>
          
          <!-- ========== USAGE INSIGHTS ========== -->
          <% if @usage_stats[:total_uses] > 0 %>
            <div class="card mt-4">
              <div class="card-header bg-light">
                <h5 class="mb-0">
                  <i class="fas fa-lightbulb me-2"></i>Usage Insights
                </h5>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-4">
                    <div class="text-center p-3">
                      <div class="mb-3">
                        <i class="fas fa-fire fa-2x text-warning"></i>
                      </div>
                      <h6>Popularity</h6>
                      <% if @usage_stats[:average_per_month] >= 2 %>
                        <p class="text-success mb-0">High usage template</p>
                      <% elsif @usage_stats[:average_per_month] >= 0.5 %>
                        <p class="text-warning mb-0">Moderate usage</p>
                      <% else %>
                        <p class="text-muted mb-0">Low usage template</p>
                      <% end %>
                    </div>
                  </div>
                  
                  <div class="col-md-4">
                    <div class="text-center p-3">
                      <div class="mb-3">
                        <i class="fas fa-calendar-check fa-2x text-primary"></i>
                      </div>
                      <h6>Recency</h6>
                      <% if @usage_stats[:last_used] && @usage_stats[:last_used] > 1.month.ago %>
                        <p class="text-success mb-0">Recently active</p>
                      <% elsif @usage_stats[:last_used] && @usage_stats[:last_used] > 3.months.ago %>
                        <p class="text-warning mb-0">Somewhat recent</p>
                      <% else %>
                        <p class="text-muted mb-0">Not recently used</p>
                      <% end %>
                    </div>
                  </div>
                  
                  <div class="col-md-4">
                    <div class="text-center p-3">
                      <div class="mb-3">
                        <i class="fas fa-users fa-2x text-info"></i>
                      </div>
                      <h6>Adoption</h6>
                      <% if @usage_stats[:agencies_usage] && @usage_stats[:agencies_usage].keys.size > 1 %>
                        <p class="text-success mb-0">Used by multiple agencies</p>
                      <% elsif @usage_stats[:agencies_usage] && @usage_stats[:agencies_usage].keys.size == 1 %>
                        <p class="text-warning mb-0">Single agency usage</p>
                      <% else %>
                        <p class="text-muted mb-0">Limited adoption</p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <div class="card-footer">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted">
                <i class="fas fa-sync-alt me-1"></i>
                Updated: <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %>
              </small>
            </div>
            <div>
              <%= link_to 'Export CSV', export_csv_job_templates_path(format: :csv, template_id: @job_template.id), 
                  class: 'btn btn-sm btn-outline-secondary' %>
              <%= link_to 'Download PDF', download_pdf_job_template_path(@job_template, format: :pdf), 
                  class: 'btn btn-sm btn-outline-primary ms-2' %>
              <button class="btn btn-sm btn-success ms-2" onclick="window.print();">
                <i class="fas fa-print me-1"></i> Print Report
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@media print {
  .card-header, .card-footer, .btn, .badge {
    display: none !important;
  }
  
  .card {
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  
  .container-fluid {
    padding: 0 !important;
    margin: 0 !important;
  }
  
  h4, h5, h6 {
    color: #000 !important;
  }
  
  .text-primary, .text-success, .text-warning, .text-info {
    color: #000 !important;
  }
  
  .border-primary, .border-success, .border-warning, .border-info {
    border-color: #000 !important;
  }
  
  a.text-decoration-none {
    color: #000 !important;
    text-decoration: none !important;
  }
}

/* Custom styling for charts */
.highcharts-background {
  fill: transparent !important;
}

/* Card hover effects */
.card {
  transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
}

/* List group item hover */
.list-group-item {
  transition: background-color 0.2s ease;
}

.list-group-item:hover {
  background-color: #f8f9fa;
}

/* Progress bar styling */
.progress-bar {
  transition: width 0.6s ease;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .display-5 {
    font-size: 2rem;
  }
  
  .card-body {
    padding: 1rem;
  }
}
</style>

<script>
// Add some interactivity
document.addEventListener('DOMContentLoaded', function() {
  // Add tooltips to badges
  const badges = document.querySelectorAll('.badge');
  badges.forEach(badge => {
    badge.setAttribute('title', badge.textContent);
    badge.setAttribute('data-bs-toggle', 'tooltip');
  });
  
  // Initialize Bootstrap tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
  
  // Make table rows clickable
  document.querySelectorAll('tbody tr[data-href]').forEach(row => {
    row.style.cursor = 'pointer';
    row.addEventListener('click', function() {
      window.location = this.dataset.href;
    });
  });
});
</script>