<%# app/views/agencies/index.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Agencies</h1>
    <%= link_to "Back to Dashboard", ptsc_dashboard_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <% @agencies.each do |agency| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                <i class="bi bi-building fs-2 text-primary"></i>
              </div>
              <div>
                <h5 class="card-title mb-1"><%= agency.name %></h5>
                <span class="badge bg-primary"><%= agency.code %></span>
              </div>
            </div>
            
            <div class="row text-center mb-3">
              <div class="col-6">
                <div class="border rounded p-2">
                  <h6 class="fw-bold mb-0"><%= agency.users.count %></h6>
                  <small class="text-muted">Users</small>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-2">
                  <h6 class="fw-bold mb-0"><%= agency.vehicles.count %></h6>
                  <small class="text-muted">Vehicles</small>
                </div>
              </div>
            </div>
            
            <div class="d-grid gap-2">
              <%= link_to "View Details", agency_path(agency), class: "btn btn-outline-primary" %>
              <%= link_to "View Vehicles", agency_vehicles_path(agency), class: "btn btn-outline-secondary" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>