<%# File: app/views/alerts/show.html.erb %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 mb-0">Alert Details</h1>
      <p class="text-muted mb-0">Alert ID: <%= @alert.id %></p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to alerts_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Back to Alerts
      <% end %>

      <%= link_to edit_alert_path(@alert), class: "btn btn-warning" do %>
        <i class="bi bi-pencil me-2"></i>Edit
      <% end %>
    </div>
  </div>

  <%# Role helpers (keeps logic consistent across page) %>
  <%
    maintenance_roles = current_user.admin? ||
                       current_user.fleet_manager? ||
                       current_user.supervisor? ||
                       current_user.maintenance_supervisor?

    finance_roles = current_user.admin? ||
                   current_user.finance?
  %>

  <div class="row g-4">
    <div class="col-md-8">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <span class="me-2"><%= @alert.short_display %></span>
            <%= @alert.title %>
          </h5>
        </div>

        <div class="card-body">
          <% if @alert.description.present? %>
            <div class="mb-4">
              <h6 class="text-muted mb-2">Description</h6>
              <p class="mb-0"><%= simple_format(@alert.description) %></p>
            </div>
          <% end %>

          <% if @alert.notes.present? %>
            <div class="mb-4">
              <h6 class="text-muted mb-2">Notes & History</h6>
              <div class="bg-light p-3 rounded">
                <%= simple_format(@alert.notes) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <% if defined?(@related_alerts) && @related_alerts.present? %>
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Related Alerts</h5>
          </div>
          <div class="card-body">
            <ul class="list-group list-group-flush">
              <% @related_alerts.each do |a| %>
                <li class="list-group-item">
                  <%= link_to a.title, alert_path(a), class: "text-decoration-none" %>
                  <span class="badge bg-<%= a.status_color %> float-end">
                    <%= a.humanized_status %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Alert Information</h5>
        </div>

        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label text-muted mb-1">Status</label>
              <div>
                <span class="badge bg-<%= @alert.status_color %> fs-6">
                  <%= @alert.humanized_status %>
                </span>
              </div>
            </div>

            <div class="col-6">
              <label class="form-label text-muted mb-1">Type</label>
              <p class="mb-0"><%= @alert.humanized_alert_type %></p>
            </div>

            <div class="col-6">
              <label class="form-label text-muted mb-1">Severity</label>
              <p class="mb-0">
                <span class="badge bg-<%= @alert.severity_color %>"><%= @alert.humanized_severity %></span>
              </p>
            </div>

            <div class="col-6">
              <label class="form-label text-muted mb-1">Priority</label>
              <p class="mb-0">
                <span class="badge bg-<%= @alert.priority_color %>"><%= @alert.humanized_priority %></span>
              </p>
            </div>

            <div class="col-6">
              <label class="form-label text-muted mb-1">Created</label>
              <p class="mb-0"><%= @alert.created_at.strftime("%b %d, %Y %I:%M %p") %></p>
            </div>

            <% if @alert.incident_time.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Incident Time</label>
                <p class="mb-0"><%= @alert.incident_time.strftime("%b %d, %Y %I:%M %p") %></p>
              </div>
            <% end %>

            <% if @alert.vehicle.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Vehicle</label>
                <p class="mb-0">
                  <%= link_to @alert.vehicle.license_plate, vehicle_path(@alert.vehicle), class: "text-decoration-none" %>
                  <span class="text-muted">• <%= @alert.vehicle.make %> <%= @alert.vehicle.model %></span>
                </p>
              </div>
            <% end %>

            <% if @alert.driver.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Driver</label>
                <p class="mb-0">
                  <%= link_to @alert.driver.name, driver_path(@alert.driver), class: "text-decoration-none" %>
                </p>
              </div>
            <% end %>

            <% if @alert.agency.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Agency</label>
                <p class="mb-0"><%= @alert.agency.name %></p>
              </div>
            <% end %>

            <% if @alert.location.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Location</label>
                <p class="mb-0"><%= @alert.location %></p>
              </div>
            <% end %>

            <% if @alert.created_by.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Created By</label>
                <p class="mb-0"><%= @alert.created_by %></p>
              </div>
            <% end %>

            <%# Show when alert was sent to finance (new columns from migration) %>
            <% if @alert.sent_to_finance_by.present? %>
              <div class="col-12">
                <label class="form-label text-muted mb-1">Sent to Finance</label>
                <p class="mb-0">
                  <%= @alert.sent_to_finance_by %>
                  <% if @alert.sent_to_finance_at.present? %>
                    <span class="text-muted">• <%= @alert.sent_to_finance_at.strftime("%b %d, %Y %I:%M %p") %></span>
                  <% end %>
                </p>
              </div>
            <% end %>

            <%# Extract acknowledgment info from notes - we'll show this in the notes section instead %>
            <%# Extract resolution info from notes - we'll show this in the notes section instead %>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Quick Actions</h5>
        </div>

        <div class="card-body">
          <div class="d-grid gap-2">

            <% if @alert.can_acknowledge? && (current_user.fleet_manager? || current_user.admin?) %>
              <%= button_to acknowledge_alert_path(@alert),
                    method: :post,
                    class: "btn btn-warning",
                    data: { confirm: "Acknowledge this alert?" } do %>
                <i class="bi bi-check-circle me-2"></i>Acknowledge Alert
              <% end %>
            <% end %>

            <% if @alert.can_send_to_finance? && maintenance_roles %>
              <%= button_to escalate_alert_path(@alert),
                    method: :post,
                    class: "btn btn-outline-primary",
                    data: { confirm: "Send this alert to Finance for procurement review?" } do %>
                <i class="bi bi-cash-coin me-2"></i>Send to Finance
              <% end %>
            <% end %>

            <% if @alert.procurement_needed? %>
              <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>
                This alert is awaiting procurement review.
                <% if finance_roles %>
                  <hr class="my-2">
                  <p class="mb-2 small">Review this alert and create an RFQ if needed:</p>
                  <%= button_to create_rfq_alert_path(@alert),
                        method: :post,
                        class: "btn btn-warning btn-sm w-100",
                        data: { confirm: "Start creating an RFQ from this alert?" } do %>
                    <i class="bi bi-file-earmark-text me-2"></i>Create RFQ from Alert
                  <% end %>
                <% end %>
              </div>
            <% end %>

            <% if @alert.can_resolve? && maintenance_roles %>
              <%= link_to resolve_form_alert_path(@alert),
                    class: "btn btn-success",
                    data: { turbo_frame: "_top" } do %>
                <i class="bi bi-check2-all me-2"></i>Resolve Alert
              <% end %>
            <% end %>

            <% if current_user.admin? %>
              <%= button_to @alert,
                    method: :delete,
                    class: "btn btn-outline-danger",
                    data: { confirm: "Are you sure you want to delete this alert?" } do %>
                <i class="bi bi-trash me-2"></i>Delete Alert
              <% end %>
            <% end %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>