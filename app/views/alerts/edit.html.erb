<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Edit Alert</h4>
            <%= link_to alert_path(@alert), class: "btn btn-outline-secondary btn-sm" do %>
              <i class="bi bi-arrow-left me-1"></i>Back
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <%= form_with(model: @alert, local: true) do |form| %>
            <% if @alert.errors.any? %>
              <div class="alert alert-danger">
                <h5><%= pluralize(@alert.errors.count, "error") %> prohibited this alert from being saved:</h5>
                <ul>
                  <% @alert.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row g-3">
              <!-- Basic Information -->
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :title, class: "form-label" %>
                  <%= form.text_field :title, class: "form-control", required: true %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :alert_type, "Type", class: "form-label" %>
                  <%= form.select :alert_type, @alert_types, { include_blank: "Select Type" }, class: "form-control", required: true %>
                </div>
              </div>

              <div class="col-md-12">
                <div class="mb-3">
                  <%= form.label :description, class: "form-label" %>
                  <%= form.text_area :description, class: "form-control", rows: 3 %>
                </div>
              </div>

              <!-- Severity & Priority -->
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :severity, class: "form-label" %>
                  <%= form.select :severity, @severities, { include_blank: "Select Severity" }, class: "form-control", required: true %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :priority, class: "form-label" %>
                  <%= form.select :priority, @priorities, { include_blank: "Select Priority" }, class: "form-control", required: true %>
                </div>
              </div>

              <!-- Status -->
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :status, class: "form-label" %>
                  <%= form.select :status, @statuses, { include_blank: "Select Status" }, class: "form-control", required: true %>
                </div>
              </div>

              <!-- Associations -->
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :vehicle_id, "Vehicle", class: "form-label" %>
                  <%= form.select :vehicle_id, @vehicles.map { |v| [v.license_plate, v.id] }, { include_blank: "Select Vehicle" }, class: "form-control" %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :agency_id, "Agency", class: "form-label" %>
                  <%= form.select :agency_id, @agencies.map { |a| [a.name, a.id] }, { include_blank: "Select Agency" }, class: "form-control" %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :driver_id, "Driver", class: "form-label" %>
                  <%= form.select :driver_id, @drivers.map { |d| [d.name, d.id] }, { include_blank: "Select Driver" }, class: "form-control" %>
                </div>
              </div>

              <!-- Location & Time -->
              <div class="col-md-12">
                <div class="mb-3">
                  <%= form.label :location, class: "form-label" %>
                  <%= form.text_field :location, class: "form-control" %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :incident_time, "Incident Time", class: "form-label" %>
                  <%= form.datetime_local_field :incident_time, class: "form-control" %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :estimated_resolution_time, "Estimated Resolution Time", class: "form-label" %>
                  <%= form.datetime_local_field :estimated_resolution_time, class: "form-control" %>
                </div>
              </div>

              <!-- Additional Information -->
              <div class="col-md-12">
                <div class="mb-3">
                  <%= form.label :assigned_to, "Assigned To", class: "form-label" %>
                  <%= form.text_field :assigned_to, class: "form-control" %>
                </div>
              </div>

              <div class="col-md-12">
                <div class="mb-3">
                  <%= form.label :notes, class: "form-label" %>
                  <%= form.text_area :notes, class: "form-control", rows: 4 %>
                </div>
              </div>

              <!-- Hidden fields -->
              <%= form.hidden_field :created_by, value: @alert.created_by || current_user&.name || 'System' %>

              <!-- Submit Buttons -->
              <div class="col-12">
                <div class="d-flex justify-content-end gap-2">
                  <%= link_to "Cancel", alert_path(@alert), class: "btn btn-outline-secondary" %>
                  <%= form.submit "Update Alert", class: "btn btn-primary" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>