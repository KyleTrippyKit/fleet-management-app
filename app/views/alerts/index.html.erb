<%# app/views/alerts/index.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 mb-0">Alerts Management</h1>
      <p class="text-muted mb-0">Agency-side alerts (Driver/Fleet → Maintenance/Admin → Finance → RFQ)</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to new_alert_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-circle me-2"></i>New Alert
      <% end %>
    </div>
  </div>

  <% stats = (@summary_stats || {}).with_indifferent_access %>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
      <div class="card border-start border-primary border-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total</h6>
              <h4 class="mb-0"><%= stats[:total].to_i %></h4>
            </div>
            <div class="avatar-sm">
              <span class="avatar-title bg-primary rounded-circle">
                <i class="bi bi-bell fs-4"></i>
              </span>
            </div>
          </div>
          <div class="mt-2 small text-muted">
            <span class="me-2">Open: <strong><%= stats[:open].to_i %></strong></span>
            <span class="me-2">Ack: <strong><%= stats[:acknowledged].to_i %></strong></span>
            <span>Resolved: <strong><%= stats[:resolved].to_i %></strong></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
      <div class="card border-start border-danger border-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Open</h6>
              <h4 class="mb-0"><%= stats[:open].to_i %></h4>
            </div>
            <div class="avatar-sm">
              <span class="avatar-title bg-danger rounded-circle">
                <i class="bi bi-exclamation-triangle fs-4"></i>
              </span>
            </div>
          </div>
          <div class="mt-2 small text-muted">
            Awaiting Finance/RFQ: <strong><%= stats[:awaiting_procurement].to_i %></strong>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
      <div class="card border-start border-warning border-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Critical</h6>
              <h4 class="mb-0"><%= stats[:critical].to_i %></h4>
            </div>
            <div class="avatar-sm">
              <span class="avatar-title bg-warning rounded-circle">
                <i class="bi bi-exclamation-octagon fs-4"></i>
              </span>
            </div>
          </div>
          <div class="mt-2 small text-muted">
            Severity: <strong>critical</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 col-sm-6">
      <div class="card border-start border-info border-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Needs Attention</h6>
              <h4 class="mb-0"><%= stats[:needs_attention].to_i %></h4>
            </div>
            <div class="avatar-sm">
              <span class="avatar-title bg-info rounded-circle">
                <i class="bi bi-eye fs-4"></i>
              </span>
            </div>
          </div>
          <div class="mt-2 small text-muted">
            Critical or urgent items
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <% if respond_to?(:needs_attention_alerts_path) %>
      <%= link_to needs_attention_alerts_path, class: "btn btn-warning" do %>
        <i class="bi bi-exclamation-triangle me-2"></i>Needs Attention (<%= stats[:needs_attention].to_i %>)
      <% end %>
    <% end %>

    <% if respond_to?(:recent_alerts_path) %>
      <%= link_to recent_alerts_path, class: "btn btn-info" do %>
        <i class="bi bi-clock-history me-2"></i>Recent Alerts
      <% end %>
    <% end %>

    <% if respond_to?(:summary_alerts_path) %>
      <%= link_to summary_alerts_path, class: "btn btn-secondary" do %>
        <i class="bi bi-bar-chart me-2"></i>Summary
      <% end %>
    <% end %>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: alerts_path, method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
        <div class="col-lg-3 col-md-6">
          <%= label_tag :q, "Search", class: "form-label text-muted" %>
          <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Title / description / location..." %>
        </div>

        <div class="col-lg-2 col-md-6">
          <%= label_tag :status, "Status", class: "form-label text-muted" %>
          <%= select_tag :status,
                options_for_select(Alert.statuses.keys.map { |s| [s.to_s.humanize, s] }, params[:status]),
                include_blank: "All",
                class: "form-select" %>
        </div>

        <div class="col-lg-2 col-md-6">
          <%= label_tag :severity, "Severity", class: "form-label text-muted" %>
          <%= select_tag :severity,
                options_for_select(Alert.severities.keys.map { |s| [s.to_s.gsub('_', ' ').humanize, s] }, params[:severity]),
                include_blank: "All",
                class: "form-select" %>
        </div>

        <div class="col-lg-2 col-md-6">
          <%= label_tag :priority, "Priority", class: "form-label text-muted" %>
          <%= select_tag :priority,
                options_for_select(Alert.priorities.keys.map { |p| [p.to_s.gsub('_', ' ').humanize, p] }, params[:priority]),
                include_blank: "All",
                class: "form-select" %>
        </div>

        <div class="col-lg-2 col-md-6">
          <%= label_tag :alert_type, "Type", class: "form-label text-muted" %>
          <%= select_tag :alert_type,
                options_for_select(Alert.alert_types.keys.map { |t| [t.to_s.humanize, t] }, params[:alert_type]),
                include_blank: "All",
                class: "form-select" %>
        </div>

        <div class="col-lg-1 col-md-6 d-flex gap-2">
          <%= f.submit "Filter", class: "btn btn-primary w-100" %>
        </div>

        <div class="col-12">
          <div class="d-flex flex-wrap gap-2">
            <%= link_to "Clear", alerts_path, class: "btn btn-outline-secondary" %>
            <% if respond_to?(:export_alerts_path) %>
              <%= link_to "Export CSV", export_alerts_path(request.query_parameters), class: "btn btn-outline-info" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Alerts Table -->
  <div class="card">
    <div class="card-body">
      <% if @alerts.present? && @alerts.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th width="40">
                  <input type="checkbox" id="select-all" class="form-check-input">
                </th>
                <th>Alert</th>
                <th>Type</th>
                <th>Vehicle</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @alerts.each do |alert| %>
                <% is_critical_active = (alert.respond_to?(:critical?) && alert.critical?) && (alert.respond_to?(:active?) && alert.active?) %>
                <tr class="<%= 'table-danger' if is_critical_active %>">
                  <td>
                    <%= check_box_tag "alert_ids[]", alert.id, false, class: "alert-checkbox form-check-input" %>
                  </td>

                  <td>
                    <div class="d-flex align-items-start">
                      <span class="me-2 fs-5"><%= alert.short_display %></span>
                      <div class="flex-grow-1">
                        <div class="fw-semibold">
                          <%= link_to alert.title, alert_path(alert), class: "text-decoration-none" %>
                        </div>
                        <div class="text-muted small">
                          <% if alert.description.present? %>
                            <%= truncate(alert.description, length: 110) %>
                          <% else %>
                            <span>No description</span>
                          <% end %>
                          <% if alert.location.present? %>
                            <span class="ms-2">• <i class="bi bi-geo-alt"></i> <%= alert.location %></span>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="badge bg-secondary"><%= alert.humanized_alert_type %></span>
                  </td>

                  <td>
                    <% if alert.vehicle.present? %>
                      <%= link_to(alert.vehicle.license_plate, vehicle_path(alert.vehicle), class: "text-decoration-none") %>
                      <div class="text-muted small">
                        <%= [alert.vehicle.make, alert.vehicle.model].compact.join(" ") %>
                      </div>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>

                  <td>
                    <% badge =
                      case alert.status.to_s
                      when "active", "open" then "danger"
                      when "resolved", "closed" then "success"
                      when "awaiting_procurement" then "info"
                      else "warning"
                      end
                    %>
                    <span class="badge bg-<%= badge %>"><%= alert.humanized_status %></span>

                    <div class="mt-1">
                      <span class="badge bg-<%= alert.severity_color %> me-1"><%= alert.humanized_severity %></span>
                      <span class="badge bg-<%= alert.priority_color %>"><%= alert.humanized_priority %></span>
                    </div>
                  </td>

                  <td>
                    <div class="small text-muted"><%= time_ago_in_words(alert.created_at) %> ago</div>
                    <div class="small text-muted"><%= alert.created_at.strftime("%b %d, %Y %I:%M %p") %></div>
                  </td>

                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <%= link_to alert_path(alert), class: "btn btn-outline-primary", title: "View" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>

                      <%= link_to edit_alert_path(alert), class: "btn btn-outline-secondary", title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>

                      <% if alert.can_acknowledge? && (respond_to?(:acknowledge_alert_path)) %>
                        <%= button_to acknowledge_alert_path(alert),
                              method: :post,
                              class: "btn btn-outline-warning",
                              title: "Acknowledge",
                              form: { class: "d-inline" } do %>
                          <i class="bi bi-check-circle"></i>
                        <% end %>
                      <% end %>

                      <% if alert.can_resolve? && (respond_to?(:resolve_form_alert_path)) %>
                        <%= link_to resolve_form_alert_path(alert),
                              class: "btn btn-outline-success",
                              title: "Resolve" do %>
                          <i class="bi bi-check2-all"></i>
                        <% end %>
                      <% end %>

                      <% if alert.respond_to?(:status) && alert.status.to_s != "awaiting_procurement" && respond_to?(:escalate_alert_path) %>
                        <% if current_user&.fleet_manager? || current_user&.supervisor? || current_user&.maintenance_supervisor? || current_user&.admin? %>
                          <%= button_to escalate_alert_path(alert),
                                method: :post,
                                class: "btn btn-outline-danger",
                                title: "Send to Finance",
                                form: { class: "d-inline" },
                                data: { turbo_confirm: "Send this alert to Finance for RFQ?" } do %>
                            <i class="bi bi-arrow-up-right"></i>
                          <% end %>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Bulk Actions -->
        <% if respond_to?(:bulk_action_alerts_path) %>
          <%= form_with url: bulk_action_alerts_path, method: :post, id: "bulk-action-form" do %>
            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <select id="bulk-action-select" name="bulk_action" class="form-select form-select-sm" style="width: auto;">
                  <option value="">Bulk Actions</option>
                  <option value="acknowledge">Acknowledge Selected</option>
                  <option value="resolve">Resolve Selected</option>
                  <% if current_user&.admin? %>
                    <option value="delete">Delete Selected</option>
                  <% end %>
                </select>
                <button type="button" id="apply-bulk-action" class="btn btn-sm btn-outline-primary">Apply</button>
              </div>

              <div>
                <%= paginate @alerts if respond_to?(:paginate) %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="mt-3">
            <%= paginate @alerts if respond_to?(:paginate) %>
          </div>
        <% end %>

      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle-fill text-success fs-1"></i>
          <h4 class="mt-3">No Alerts Found</h4>
          <p class="text-muted">All alerts are cleared or no alerts match your filters.</p>
          <%= link_to "Create New Alert", new_alert_path, class: "btn btn-primary mt-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
(function () {
  const ready = (fn) => {
    document.addEventListener("DOMContentLoaded", fn);
    document.addEventListener("turbo:load", fn);
  };

  ready(function () {
    // Select all checkbox
    const selectAll = document.getElementById("select-all");
    const checkboxes = document.querySelectorAll(".alert-checkbox");

    if (selectAll) {
      selectAll.addEventListener("change", function () {
        checkboxes.forEach((cb) => (cb.checked = selectAll.checked));
      });
    }

    // Bulk actions
    const applyBtn = document.getElementById("apply-bulk-action");
    const bulkSelect = document.getElementById("bulk-action-select");
    const bulkForm = document.getElementById("bulk-action-form");

    if (applyBtn && bulkSelect && bulkForm) {
      applyBtn.addEventListener("click", function () {
        const action = bulkSelect.value;
        const selectedIds = Array.from(checkboxes)
          .filter((cb) => cb.checked)
          .map((cb) => cb.value);

        if (!action) {
          alert("Please select an action");
          return;
        }

        if (selectedIds.length === 0) {
          alert("Please select at least one alert");
          return;
        }

        if (!confirm(`Are you sure you want to ${action} ${selectedIds.length} alert(s)?`)) return;

        // Clear any existing alert_ids inputs (if user clicked twice)
        const existingInputs = bulkForm.querySelectorAll('input[name="alert_ids[]"]');
        existingInputs.forEach((input) => input.remove());

        // Add selected alert IDs to form
        selectedIds.forEach((id) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "alert_ids[]";
          input.value = id;
          bulkForm.appendChild(input);
        });

        bulkForm.submit();
      });
    }
  });
})();
</script>
