ID,Title,Type,Severity,Priority,Status,Vehicle,Description,Created At,Updated At
<% @alerts.each do |alert| %>
<%= alert.id %>,"<%= alert.title %>",<%= alert.alert_type %>,<%= alert.severity %>,<%= alert.priority %>,<%= alert.status %>,<%= alert.vehicle&.license_plate || 'N/A' %>,"<%= alert.description&.gsub('"', '""') %>",<%= alert.created_at %>,<%= alert.updated_at %>
<% end %>