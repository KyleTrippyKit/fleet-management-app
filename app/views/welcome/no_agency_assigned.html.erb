<%# app/views/welcome/no_agency_assigned.html.erb %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card border-danger">
        <div class="card-header bg-danger text-white">
          <h4 class="mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Account Configuration Required
          </h4>
        </div>
        <div class="card-body text-center py-5">
          <i class="bi bi-building-exclamation text-danger display-1 mb-4"></i>
          <h3 class="text-danger mb-3">No Agency Assigned</h3>
          <p class="lead mb-4">
            Your user account is not associated with any agency.
            This prevents you from accessing fleet management features.
          </p>
          
          <div class="alert alert-info text-start mb-4">
            <h5 class="alert-heading">What's happening?</h5>
            <ul class="mb-0">
              <li>Your account exists but isn't linked to an agency</li>
              <li>You need agency assignment to access dashboards and features</li>
              <li>This is typically set up by your system administrator</li>
            </ul>
          </div>
          
          <div class="row mb-4">
            <div class="col-md-6 mb-3">
              <div class="card h-100">
                <div class="card-body">
                  <i class="bi bi-person-check text-primary fs-1 mb-3"></i>
                  <h5>Already Have an Agency?</h5>
                  <p class="text-muted">Contact your administrator to get assigned.</p>
                  <%= link_to "Contact Administrator", "mailto:admin@vmcott.gov.tt", 
                        class: "btn btn-outline-primary w-100" %>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card h-100">
                <div class="card-body">
                  <i class="bi bi-box-arrow-right text-danger fs-1 mb-3"></i>
                  <h5>Need to Sign Out?</h5>
                  <p class="text-muted">Sign out and try a different account.</p>
                  <%= button_to "Sign Out", destroy_user_session_path, 
                        method: :delete, 
                        class: "btn btn-outline-danger w-100",
                        data: { turbo: false } %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="text-start">
            <h5 class="text-muted mb-3">Common Agencies in the System:</h5>
            <ul class="list-group mb-4">
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-check text-primary me-2"></i>VMCOTT</span>
                <small class="text-muted">admin@vmcott.gov.tt</small>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield text-danger me-2"></i>TTPS</span>
                <small class="text-muted">admin@ttps.gov.tt</small>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-fill text-success me-2"></i>TTDF</span>
                <small class="text-muted">admin@ttdf.gov.tt</small>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bus-front text-warning me-2"></i>PTSC</span>
                <small class="text-muted">admin@ptsc.gov.tt</small>
              </li>
            </ul>
          </div>
        </div>
        <div class="card-footer text-muted small">
          <i class="bi bi-info-circle me-1"></i>
          Please contact your VMCOTT system administrator at <strong>admin@vmcott.gov.tt</strong> to have your account properly configured.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .list-group-item {
    border-left: 4px solid transparent;
    transition: all 0.2s;
  }
  .list-group-item:nth-child(1) { border-left-color: #0d6efd; }
  .list-group-item:nth-child(2) { border-left-color: #dc3545; }
  .list-group-item:nth-child(3) { border-left-color: #198754; }
  .list-group-item:nth-child(4) { border-left-color: #ffc107; }
  .list-group-item:hover {
    transform: translateX(5px);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
</style>