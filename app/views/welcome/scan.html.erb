<%# app/views/welcome/scan.html.erb %>
<%= stylesheet_link_tag "agencies", media: "all", "data-turbo-track": "reload" %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card scanner-card shadow-lg">
        <div class="card-header header-gradient-<%= @agency.code.downcase %> text-white d-flex justify-content-between align-items-center">
          <h4 class="mb-0">
            <i class="bi bi-upc-scan me-2"></i>
            Vehicle Scanner - <%= @agency.name %>
          </h4>
          <span class="badge badge-<%= @agency.code.downcase %>">
            <i class="bi bi-building me-1"></i>
            <%= @agency.code %>
          </span>
        </div>
        
        <div class="card-body text-center py-5">
          <div class="mb-5">
            <div class="scanner-placeholder mb-4">
              <div class="p-4">
                <i class="bi bi-upc-scan fa-5x text-muted mb-3"></i>
                <h3 class="mb-3">Vehicle Scanner Interface</h3>
                <p class="text-muted">Ready for QR Code or RFID Integration</p>
                
                <div class="mt-4">
                  <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Scanner Initializing...</span>
                  </div>
                  <p class="mt-2 small text-muted">Scanner initializing...</p>
                </div>
              </div>
            </div>
            
            <h2 class="mb-4">Scan Vehicle Identification</h2>
            <p class="lead text-muted mb-4">
              Place QR code sticker or bring RFID tag close to the scanner to access vehicle details instantly.
            </p>
          </div>
          
          <div class="row g-4 mb-4">
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <div class="mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-block mb-3">
                      <i class="bi bi-qr-code-scan fa-2x text-primary"></i>
                    </div>
                    <h4>QR Code Scan</h4>
                    <p class="text-muted">Scan the QR code sticker located on the vehicle windshield or dashboard.</p>
                  </div>
                  <button class="btn btn-outline-primary w-100" disabled>
                    <i class="bi bi-camera me-2"></i>Activate QR Scanner
                  </button>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <div class="mb-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-block mb-3">
                      <i class="bi bi-wifi fa-2x text-success"></i>
                    </div>
                    <h4>RFID Scan</h4>
                    <p class="text-muted">Tap RFID card or bring RFID tag within range of the scanner.</p>
                  </div>
                  <button class="btn btn-outline-success w-100" disabled>
                    <i class="bi bi-rfid me-2"></i>Activate RFID Scanner
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <div class="row g-3">
            <div class="col-md-4">
              <div class="card">
                <div class="card-body">
                  <i class="bi bi-camera-video text-primary mb-2"></i>
                  <h6>Camera Required</h6>
                  <p class="small text-muted mb-0">For QR scanning</p>
                </div>
              </div>
            </div>
            
            <div class="col-md-4">
              <div class="card">
                <div class="card-body">
                  <i class="bi bi-bluetooth text-success mb-2"></i>
                  <h6>Bluetooth</h6>
                  <p class="small text-muted mb-0">For RFID scanning</p>
                </div>
              </div>
            </div>
            
            <div class="col-md-4">
              <div class="card">
                <div class="card-body">
                  <i class="bi bi-lightning-charge text-warning mb-2"></i>
                  <h6>Quick Access</h6>
                  <p class="small text-muted mb-0">Instant vehicle lookup</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="mt-5">
            <div class="alert alert-warning">
              <div class="d-flex">
                <div class="me-3">
                  <i class="bi bi-tools fa-2x"></i>
                </div>
                <div>
                  <h5 class="alert-heading">Development Mode</h5>
                  <p class="mb-0">
                    Scanner functionality is currently in development. The hardware integration for QR code and RFID scanning will be implemented in the next phase.
                    Please use the dashboard for all vehicle management operations.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="d-flex justify-content-between align-items-center">
            <%= link_to welcome_index_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left-circle me-2"></i>Back to Portal
            <% end %>
            
            <div class="text-muted small">
              <i class="bi bi-info-circle me-1"></i>
              Scanner v1.0 | <%= @agency.code %> System
            </div>
            
            <%= link_to dashboard_path, class: "btn btn-primary" do %>
              <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>