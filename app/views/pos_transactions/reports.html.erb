<%# app/views/pos_transactions/reports.html.erb %>
<%
  # Add emergency fixes for POS Reports page
  content_for :head do %>
    <meta name="turbo-visit-control" content="reload">
    <meta name="turbo-cache-control" content="no-cache">
    <style>
      /* EMERGENCY FIX FOR POS REPORTS PAGE */
      body.pos-transactions-page,
      body.reports-page {
        background-color: #f8f9fa !important;
        animation: none !important;
        transition: none !important;
      }
      
      .pos-transactions-page .container-fluid,
      .reports-page .container-fluid,
      .pos-transactions-page .card:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .reports-page .card:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .pos-transactions-page .card-body:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .reports-page .card-body:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .pos-transactions-page .table,
      .reports-page .table,
      .pos-transactions-page .table th,
      .reports-page .table th,
      .pos-transactions-page .table td,
      .reports-page .table td,
      .pos-transactions-page .table tbody tr,
      .reports-page .table tbody tr {
        background-color: white !important;
        color: #212529 !important;
        opacity: 1 !important;
        visibility: visible !important;
        animation: none !important;
        transition: none !important;
      }
      
      /* Force all text to be visible immediately */
      .pos-transactions-page *:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark):not(.btn-primary):not(.btn-success):not(.btn-info):not(.btn-warning):not(.btn-danger),
      .reports-page *:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark):not(.btn-primary):not(.btn-success):not(.btn-info):not(.btn-warning):not(.btn-danger) {
        color: #212529 !important;
      }
      
      /* Keep colored elements readable */
      .pos-transactions-page .card.bg-primary *,
      .reports-page .card.bg-primary *,
      .pos-transactions-page .card.bg-success *,
      .reports-page .card.bg-success *,
      .pos-transactions-page .card.bg-info *,
      .reports-page .card.bg-info *,
      .pos-transactions-page .card.bg-danger *,
      .reports-page .card.bg-danger *,
      .pos-transactions-page .card.bg-dark *,
      .reports-page .card.bg-dark * {
        color: white !important;
      }
      
      .pos-transactions-page .card.bg-warning *,
      .reports-page .card.bg-warning * {
        color: #212529 !important;
      }
      
      /* Prevent Turbo from interfering */
      [data-turbo-preview] * {
        opacity: 1 !important;
        visibility: visible !important;
      }
      
      /* Disable ALL animations and transitions */
      .pos-transactions-page *,
      .reports-page * {
        animation: none !important;
        transition: none !important;
      }
    </style>
    <script>
      // IMMEDIATE FIX FOR POS REPORTS PAGE
      document.addEventListener('DOMContentLoaded', function() {
        console.log('POS Reports Page - Applying emergency fix for blinking');
        
        // Add classes immediately
        document.body.classList.add('pos-transactions-page');
        document.body.classList.add('reports-page');
        
        // Force immediate visibility
        document.body.style.opacity = '1';
        document.body.style.visibility = 'visible';
        
        // Force text colors
        setTimeout(function() {
          const allElements = document.querySelectorAll('*');
          allElements.forEach(el => {
            const bgColor = window.getComputedStyle(el).backgroundColor;
            const textColor = window.getComputedStyle(el).color;
            
            // If background is light and text is white/transparent, make text dark
            if ((bgColor === 'rgba(0, 0, 0, 0)' || 
                 bgColor === 'rgb(255, 255, 255)' || 
                 bgColor === 'rgb(248, 249, 250)' ||
                 bgColor === '#ffffff' ||
                 bgColor === '#f8f9fa') &&
                (textColor === 'rgba(0, 0, 0, 0)' || 
                 textColor === 'rgb(255, 255, 255)' ||
                 textColor === '#ffffff')) {
              el.style.color = '#212529';
            }
          });
        }, 10);
        
        // Disable Turbo completely for POS reports
        if (typeof Turbo !== 'undefined' && window.location.pathname.includes('/pos_transactions/reports')) {
          console.log('POS Reports page detected, disabling Turbo');
          
          // Disable all Turbo links and forms
          document.querySelectorAll('a:not([data-turbo="false"])').forEach(link => {
            link.setAttribute('data-turbo', 'false');
          });
          
          document.querySelectorAll('form:not([data-turbo="false"])').forEach(form => {
            form.setAttribute('data-turbo', 'false');
          });
          
          // Disable Turbo caching
          Turbo.cache.exemptPageFromPreview();
          Turbo.cache.exemptPageFromCache();
        }
      });
      
      // Also handle Turbo page loads
      document.addEventListener('turbo:load', function() {
        if (window.location.pathname.includes('/pos_transactions/reports')) {
          document.body.classList.add('pos-transactions-page');
          document.body.classList.add('reports-page');
          
          // Final check after everything loads
          setTimeout(() => {
            console.log('Final check for POS Reports - ensuring all text is visible');
            const allTextElements = document.querySelectorAll('p, span, td, th, div, h1, h2, h3, h4, h5, h6');
            allTextElements.forEach(el => {
              if (window.getComputedStyle(el).color === 'rgb(255, 255, 255)' || 
                  window.getComputedStyle(el).color === '#ffffff') {
                el.style.color = '#212529';
              }
            });
          }, 500);
        }
      });
    </script>
<% end %>

<%= pos_agency_header %>

<div class="container-fluid pos-transactions-container">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0">
            <i class="fas fa-chart-bar text-primary me-2"></i>
            POS Sales Reports
          </h1>
          <p class="text-muted mb-0">
            <%= current_agency.name %> • 
            <span class="badge bg-dark"><%= current_agency.code %></span>
          </p>
        </div>
        <div>
          <%= link_to 'Back to POS', pos_transactions_path, class: 'btn btn-secondary me-2', data: { turbo: false } %>
          <%= link_to 'Export CSV', '#', class: 'btn btn-outline-primary', data: { turbo: false } %>
        </div>
      </div>

      <%# Date Range Filter %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">Report Period</h5>
        </div>
        <div class="card-body">
          <%= form_with url: reports_pos_transactions_path, method: :get, local: true, class: "row g-3", data: { turbo: false } do |f| %>
            <div class="col-md-3">
              <%= label_tag :start_date, "Start Date", class: "form-label" %>
              <%= date_field_tag :start_date, @start_date, class: "form-control" %>
            </div>
            <div class="col-md-3">
              <%= label_tag :end_date, "End Date", class: "form-label" %>
              <%= date_field_tag :end_date, @end_date, class: "form-control" %>
            </div>
            <div class="col-md-2">
              <label class="form-label">&nbsp;</label>
              <%= submit_tag "Generate Report", class: "btn btn-primary w-100" %>
            </div>
            <div class="col-md-2">
              <label class="form-label">&nbsp;</label>
              <%= link_to "This Month", reports_pos_transactions_path, class: "btn btn-outline-secondary w-100", data: { turbo: false } %>
            </div>
            <div class="col-md-2">
              <label class="form-label">&nbsp;</label>
              <%= link_to "Last Month", reports_pos_transactions_path(start_date: 1.month.ago.beginning_of_month, end_date: 1.month.ago.end_of_month), class: "btn btn-outline-secondary w-100", data: { turbo: false } %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Summary Cards - CHANGED: Fixed text colors %>
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card bg-primary text-white">
            <div class="card-body">
              <h6 class="card-title">Total Sales</h6>
              <h3 class="mb-0"><%= number_to_currency(@total_sales, unit: "$") %></h3>
              <small><%= @total_transactions %> transactions</small>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-success text-white">
            <div class="card-body">
              <h6 class="card-title">Average Sale</h6>
              <h3 class="mb-0">
                <% if @total_transactions > 0 %>
                  <%= number_to_currency(@total_sales / @total_transactions, unit: "$") %>
                <% else %>
                  $0.00
                <% end %>
              </h3>
              <small>Per transaction</small>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-warning text-dark">
            <div class="card-body">
              <h6 class="card-title">Voided</h6>
              <h3 class="mb-0"><%= @voided_total %></h3>
              <small>Transactions voided</small>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-info text-white">
            <div class="card-body">
              <h6 class="card-title">Refunded</h6>
              <h3 class="mb-0"><%= @refunded_total %></h3>
              <small>Transactions refunded</small>
            </div>
          </div>
        </div>
      </div>

      <%# Daily Sales Chart %>
      <div class="row mb-4">
        <div class="col-md-8">
          <div class="card">
            <div class="card-header bg-light">
              <h5 class="mb-0">Daily Sales Breakdown</h5>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead class="table-light">
                    <tr>
                      <th>Date</th>
                      <th>Transactions</th>
                      <th>Total Sales</th>
                      <th>Average Sale</th>
                      <th>Trend</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @daily_sales.each do |date_str, data| %>
                      <tr>
                        <td><strong><%= date_str %></strong></td>
                        <td><%= data[:count] %></td>
                        <td><%= number_to_currency(data[:amount], unit: "$") %></td>
                        <td>
                          <% if data[:count] > 0 %>
                            <%= number_to_currency(data[:amount] / data[:count], unit: "$") %>
                          <% else %>
                            $0.00
                          <% end %>
                        </td>
                        <td>
                          <% if data[:count] > 0 %>
                            <div class="progress" style="height: 10px;">
                              <div class="progress-bar <%= pos_agency_theme[:bg].gsub('bg-', 'bg-') %>" 
                                   style="width: <%= [(data[:amount].to_f / [@daily_sales.values.map { |d| d[:amount] }.max, 1].max * 100), 5].max %>%">
                              </div>
                            </div>
                          <% else %>
                            <span class="text-muted">-</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-4">
          <div class="card">
            <div class="card-header bg-light">
              <h5 class="mb-0">Payment Methods</h5>
            </div>
            <div class="card-body">
              <% if @payment_method_breakdown.any? %>
                <% @payment_method_breakdown.each do |method, data| %>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                      <span><%= method %></span>
                      <span><%= number_to_currency(data[:amount], unit: "$") %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <small class="text-muted"><%= data[:count] %> transactions</small>
                      <small class="text-muted"><%= data[:percentage] %>%</small>
                    </div>
                    <div class="progress" style="height: 8px;">
                      <div class="progress-bar <%= payment_method_color(method.downcase.to_sym) rescue 'bg-secondary' %>" 
                           style="width: <%= data[:percentage] %>%">
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center py-4">
                  <i class="fas fa-credit-card fa-2x text-muted mb-2"></i>
                  <p class="text-muted">No payment data available</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Transactions Table %>
      <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Transaction Details</h5>
          <span class="badge bg-dark">
            <%= @transactions.count %> transactions in period
          </span>
        </div>
        <div class="card-body">
          <% if @transactions.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>Date</th>
                    <th>Transaction ID</th>
                    <th>Amount</th>
                    <th>Payment Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @transactions.each do |transaction| %>
                    <tr>
                      <td><%= format_date(transaction.created_at, format: :short) %></td>
                      <td>
                        <strong><%= transaction.transaction_id %></strong>
                        <% if transaction.vehicle_id %>
                          <br>
                          <small class="text-muted">
                            <i class="fas fa-car me-1"></i>
                            <%= transaction.vehicle.license_plate %>
                          </small>
                        <% end %>
                      </td>
                      <td><strong><%= number_to_currency(transaction.amount, unit: "$") %></strong></td>
                      <td><%= pos_payment_type_badge(transaction.payment_type) %></td>
                      <td><%= pos_status_badge(transaction.status) %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to 'View', pos_transaction_path(transaction), class: 'btn btn-outline-info btn-sm', data: { turbo: false } %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-chart-bar fa-4x text-muted mb-3"></i>
              <h4>No Transactions in Selected Period</h4>
              <p class="text-muted">Adjust the date range to see transaction data.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Additional JavaScript for POS Reports page %>
<script>
  // Force POS Reports page styling
  document.addEventListener('DOMContentLoaded', function() {
    // Add the class if not already added
    if (!document.body.classList.contains('pos-transactions-page')) {
      document.body.classList.add('pos-transactions-page');
    }
    if (!document.body.classList.contains('reports-page')) {
      document.body.classList.add('reports-page');
    }
    
    // Force card backgrounds immediately
    setTimeout(function() {
      // Force colored cards to keep their colors
      document.querySelectorAll('.card.bg-primary, .card.bg-success, .card.bg-info, .card.bg-warning, .card.bg-danger, .card.bg-dark').forEach(card => {
        if (card.classList.contains('bg-warning')) {
          card.style.backgroundColor = '#ffc107';
          card.style.color = '#212529';
        } else if (card.classList.contains('bg-primary')) {
          card.style.backgroundColor = '#0d6efd';
          card.style.color = 'white';
        } else if (card.classList.contains('bg-success')) {
          card.style.backgroundColor = '#198754';
          card.style.color = 'white';
        } else if (card.classList.contains('bg-info')) {
          card.style.backgroundColor = '#0dcaf0';
          card.style.color = 'white';
        } else if (card.classList.contains('bg-danger')) {
          card.style.backgroundColor = '#dc3545';
          card.style.color = 'white';
        } else if (card.classList.contains('bg-dark')) {
          card.style.backgroundColor = '#212529';
          card.style.color = 'white';
        }
      });
      
      // Force regular cards to be white
      document.querySelectorAll('.card:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark)').forEach(card => {
        card.style.backgroundColor = 'white';
        card.style.color = '#212529';
      });
      
      // Force table backgrounds
      document.querySelectorAll('.table').forEach(table => {
        table.style.backgroundColor = 'white';
      });
      
      // Force all text in table to be visible
      document.querySelectorAll('table *').forEach(el => {
        const computedColor = window.getComputedStyle(el).color;
        if (computedColor === 'rgb(255, 255, 255)' || computedColor === '#ffffff') {
          el.style.color = '#212529';
        }
      });
    }, 50);
    
    // Add data-turbo="false" to all links
    setTimeout(function() {
      document.querySelectorAll('a:not([data-turbo])').forEach(link => {
        if (!link.hasAttribute('data-turbo') && !link.hasAttribute('target')) {
          link.setAttribute('data-turbo', 'false');
        }
      });
      
      document.querySelectorAll('form:not([data-turbo])').forEach(form => {
        form.setAttribute('data-turbo', 'false');
      });
    }, 100);
  });
</script>