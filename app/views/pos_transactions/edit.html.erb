<%# app/views/pos_transactions/edit.html.erb %>
<%= pos_agency_header %>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <div class="card">
        <div class="card-header bg-warning">
          <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>
            Update Transaction Notes
          </h5>
        </div>
        <div class="card-body">
          <%# Audit Warning %>
          <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Important:</strong> Transaction details (amount, payment type) cannot be changed 
            for audit compliance. Only notes can be updated. To correct errors, use the "Void" or "Refund" actions.
          </div>

          <%# Transaction Info (Read-only) %>
          <div class="card mb-4">
            <div class="card-body bg-light">
              <h6>Transaction Information (Read-only)</h6>
              <div class="row">
                <div class="col-md-6">
                  <p class="mb-1"><strong>ID:</strong> <%= @pos_transaction.transaction_id %></p>
                  <p class="mb-1"><strong>Amount:</strong> <%= number_to_currency(@pos_transaction.amount, unit: "$") %></p>
                  <p class="mb-1"><strong>Status:</strong> <%= pos_status_badge(@pos_transaction.status) %></p>
                </div>
                <div class="col-md-6">
                  <p class="mb-1"><strong>Payment Type:</strong> <%= @pos_transaction.display_payment_type %></p>
                  <p class="mb-1"><strong>Created:</strong> <%= format_date(@pos_transaction.created_at, format: :datetime) %></p>
                  <p class="mb-0"><strong>By:</strong> <%= @pos_transaction.user&.name || 'Unknown' %></p>
                </div>
              </div>
            </div>
          </div>

          <%= form_with model: @pos_transaction, local: true do |f| %>
            <%# Only allow notes to be edited %>
            <div class="mb-4">
              <%= f.label :notes, "Transaction Notes", class: "form-label" %>
              <%= f.text_area :notes, class: "form-control", rows: 5, 
                    placeholder: "Add or update notes about this transaction..." %>
              <small class="text-muted">
                Use notes to document any relevant information. Previous notes will be preserved.
              </small>
            </div>

            <%# Hidden fields to prevent editing of critical data %>
            <%= f.hidden_field :amount %>
            <%= f.hidden_field :payment_type %>
            <%= f.hidden_field :vehicle_id %>
            <%= f.hidden_field :status %>

            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
              <%= link_to 'Cancel', pos_transaction_path(@pos_transaction), class: 'btn btn-secondary' %>
              <%= link_to 'Void Transaction', void_pos_transaction_path(@pos_transaction), 
                    method: :post,
                    data: { confirm: 'Are you sure you want to void this transaction? This cannot be undone.' },
                    class: 'btn btn-danger' %>
              <%= f.submit 'Update Notes Only', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Audit Trail Info %>
      <div class="card mt-4">
        <div class="card-body">
          <h6>Audit Trail Information</h6>
          <ul class="list-unstyled">
            <li class="mb-2">
              <i class="fas fa-info-circle text-info me-2"></i>
              <strong>Transaction ID:</strong> <%= @pos_transaction.transaction_id %>
            </li>
            <li class="mb-2">
              <i class="fas fa-calendar text-info me-2"></i>
              <strong>Created:</strong> <%= format_date(@pos_transaction.created_at, format: :datetime) %>
            </li>
            <li class="mb-2">
              <i class="fas fa-building text-info me-2"></i>
              <strong>Agency:</strong> <%= @pos_transaction.agency_name %>
            </li>
            <li class="mb-0">
              <i class="fas fa-user text-info me-2"></i>
              <strong>Original User:</strong> <%= @pos_transaction.user&.name || 'Unknown' %>
            </li>
          </ul>
          
          <% if @pos_transaction.voided? && @pos_transaction.voided_at %>
            <div class="alert alert-danger mt-3">
              <i class="fas fa-ban me-2"></i>
              <strong>VOIDED:</strong> This transaction was voided on 
              <%= format_date(@pos_transaction.voided_at, format: :datetime) %>
            </div>
          <% elsif @pos_transaction.refunded? && @pos_transaction.refunded_at %>
            <div class="alert alert-info mt-3">
              <i class="fas fa-undo me-2"></i>
              <strong>REFUNDED:</strong> This transaction was refunded on 
              <%= format_date(@pos_transaction.refunded_at, format: :datetime) %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>