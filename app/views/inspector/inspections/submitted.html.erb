<div class="container py-5" style="max-width: 640px;">
  <div class="card shadow-sm">
    <div class="card-body text-center py-5">
      <h2 class="mb-3 text-success">Inspection Submitted</h2>
      <p class="mb-1"><strong>License Plate:</strong> <%= @vehicle.license_plate %></p>
      <p class="mb-4"><strong>Vehicle:</strong> <%= @vehicle.make %> <%= @vehicle.model %></p>
      <%= link_to "Return to Scan / Enter License", inspector_home_path, class: "btn btn-outline-primary" %>
    </div>
  </div>
</div>
