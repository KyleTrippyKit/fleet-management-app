                  </div>
                  <div class="text-truncate small">procurement@test.com</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Finance</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">finance@test.com</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Mechanic</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">mechanic@test.com</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Workshop Supervisor</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">workshop_supervisor@test.com</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Stores Clerk</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">stores.clerk@vmcott.gov.tt</div>
                </div>
                <div class="credential-item">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">VMCOTT Admin</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">admin@vmcott.gov.tt</div>
                </div>
              </div>
            </div>

            <!-- PTSC Column -->
            <div class="col-md-4">
              <div class="small fw-semibold text-primary mb-1">🚌 PTSC Accounts</div>
              <div class="credentials-grid">
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Fleet Manager</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">fleet.manager@ptsc.gov.tt</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Maintenance Supervisor</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">maintenance.supervisor@ptsc.gov.tt</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Finance</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">finance@ptsc.gov.tt</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Driver</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">driver.john@ptsc.gov.tt</div>
                </div>
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Fleet</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
