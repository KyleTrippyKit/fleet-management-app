      <% end %>

      <!-- Footer -->
      <div class="d-flex justify-content-between small text-muted pt-3 mt-3 border-top">
        <span>
          Build <%= ENV.fetch("APP_BUILD", "1.0.0") %>
        </span>

        <span>
          © 2026 Active Plus™
        </span>
      </div>

    </div>
