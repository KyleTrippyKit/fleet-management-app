                </div>
                <div class="credential-item">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">Admin</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
                  <div class="text-truncate small">admin@ptsc.gov.tt</div>
                </div>
              </div>
            </div>
            
            <!-- Other Agencies Column -->
            <div class="col-md-4">
              <div class="small fw-semibold text-primary mb-1">👮 Agency Admins</div>
              <div class="credentials-grid">
                <div class="credential-item border-bottom pb-1 mb-1">
                  <div class="d-flex justify-content-between">
                    <span class="text-muted small">TTPS Admin</span>
                    <code class="bg-light px-1 rounded small">password123</code>
                  </div>
