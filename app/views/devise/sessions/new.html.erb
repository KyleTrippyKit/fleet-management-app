</div>

<script>
  // Auto-fill on dropdown select
  document.addEventListener('DOMContentLoaded', function() {
    const testSelect = document.getElementById('test-user-select');
    if (testSelect) {
      testSelect.addEventListener('change', function() {
        if (this.value) {
          const [email, password] = this.value.split('|');
          document.getElementById('user_email').value = email;
          document.getElementById('user_password').value = password;
          
          // Optional: Show a quick confirmation
          const emailField = document.getElementById('user_email');
          emailField.classList.add('bg-success-subtle');
          setTimeout(() => emailField.classList.remove('bg-success-subtle'), 1000);
        }
      });
    }
  });
</script>
</body>
</html>