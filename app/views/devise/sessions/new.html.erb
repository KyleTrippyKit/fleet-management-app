<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Active Plus - Login</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    body {
      background: linear-gradient(135deg, #e9f0f5 0%, #d9e4ec 100%);
      min-height: 100vh;
      margin: 0;
      padding: 20px;
    }
    
    .auth-accent {
      height: 4px;
      background: linear-gradient(90deg, #ce1126 33%, #fff 33%, #fff 66%, #000 66%);
      border-radius: 2px 2px 0 0;
    }
    
    .auth-container {
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    .test-credentials-card .credential-item {
      font-size: 0.8rem;
      line-height: 1.3;
    }
    
    .test-credentials-card code {
      font-size: 0.75rem;
      font-family: 'Courier New', monospace;
    }
    
    .bg-success-subtle {
      background-color: rgba(25, 135, 84, 0.15) !important;
    }
    
    @media (max-width: 768px) {
      .test-credentials-card {
        max-height: 300px;
        overflow-y: auto;
      }
    }
  </style>
</head>
<body>
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center auth-page">
  <div class="card shadow border-0 auth-container" style="max-width: 520px; width: 100%;">
    
    <!-- Trinidad accent bar -->
    <div class="auth-accent"></div>

    <div class="card-body p-4 position-relative">

      <!-- Logo / Header -->
      <div class="text-center mb-3">
        <div class="mb-2">
          <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center
                      fw-bold"
               style="width: 64px; height: 64px; font-size: 28px;">
            AP
          </div>
        </div>

        <h2 class="fw-bold mb-1">Active Plus</h2>

        <p class="text-muted small mb-0">
          Incorporated for the Republic of Trinidad and Tobago
        </p>
      </div>

      <!-- Flash Messages -->
      <% if flash[:alert].present? %>
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2" role="alert">
          <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <div class="small">
              <%= flash[:alert] %>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2" role="alert">
          <div class="d-flex align-items-center">
            <i class="fas fa-check-circle me-2"></i>
            <div class="small">
              <%= flash[:notice] %>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <hr>

      <!-- Quick Login Selector (Development/Test only) -->
      <% if Rails.env.development? || Rails.env.test? %>
        <div class="mb-4">
          <label class="form-label fw-semibold small text-muted">
            <i class="fas fa-bolt me-1"></i> Quick Test Login
          </label>
          <select class="form-select form-select-sm" 
                  id="test-user-select"
                  onchange="if(this.value) { 
                    const [email, password] = this.value.split('|'); 
                    document.getElementById('user_email').value = email;
                    document.getElementById('user_password').value = password;
                    document.getElementById('user_email').focus();
                  }">
            <option value="">-- Select a test account --</option>
            
            <!-- ======================== -->
            <!-- VMCOTT WORKFLOW ROLES (RENAMED)  -->
            <!-- ======================== -->
            <optgroup label="🚗 VMCOTT WORKFLOW ROLES">
              <option value="security_gate@test.com|password123">🚪 Security Gate Officer - Check-in vehicles</option>
              <option value="inspector@test.com|password123">🔍 Inspector - Diagnostics & QC</option>
              <option value="inventory@test.com|password123">📦 Inventory Manager - Parts & Stock</option>
              <option value="procurement@test.com|password123">📨 Procurement - RFQs & Vendors</option>
              <option value="mechanic@test.com|password123">🔧 Mechanic - Repairs & Work Orders</option>
              <option value="finance@test.com|password123">💰 Finance - Quotations, PO Approval, Invoicing</option>
            </optgroup>

            <optgroup label="🏢 VMCOTT Management">
              <option value="workshop_supervisor@test.com|password123">👨‍🔧 Workshop Supervisor</option>
              <option value="stores.clerk@vmcott.gov.tt|password123">📋 Stores Clerk</option>
              <option value="admin@vmcott.gov.tt|password123">👑 VMCOTT Administrator</option>
            </optgroup>

            <optgroup label="🚌 PTSC Accounts">
              <option value="fleet.manager@ptsc.gov.tt|password123">🚗 PTSC Fleet Manager</option>
              <option value="maintenance.supervisor@ptsc.gov.tt|password123">🔧 PTSC Maintenance Supervisor</option>
              <option value="finance@ptsc.gov.tt|password123">💰 PTSC Finance Officer</option>
              <option value="driver.john@ptsc.gov.tt|password123">👨‍✈️ PTSC Driver</option>
              <option value="admin@ptsc.gov.tt|password123">👑 PTSC Administrator</option>
              <option value="fleet@ptsc.gov.tt|password123">🚌 PTSC Fleet</option>
            </optgroup>

            <optgroup label="👮 Agency Administrators">
              <option value="admin@ttps.gov.tt|password123">👮 TTPS Administrator</option>
              <option value="admin@ttdf.gov.tt|password123">🎖️ TTDF Administrator</option>
              <option value="admin@fire.gov.tt|password123">🔥 Fire Service Admin</option>
              <option value="admin@health.gov.tt|password123">🏥 Health Ministry Admin</option>
              <option value="admin@education.gov.tt|password123">📚 Education Ministry Admin</option>
            </optgroup>

            <optgroup label="🧪 Test Users">
              <option value="test@ptsc.gov.tt|test123">🧪 PTSC Test User</option>
              <option value="test@vmcott.gov.tt|test123">🧪 VMCOTT Test User</option>
              <option value="test@ttps.gov.tt|test123">🧪 TTPS Test User</option>
              <option value="test@ttdf.gov.tt|test123">🧪 TTDF Test User</option>
            </optgroup>
          </select>
          <div class="form-text">
            <small>Select an account to auto-fill credentials</small>
          </div>
        </div>
      <% end %>

      <!-- Login Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
        
        <div class="mb-3">
          <%= f.label :email, "Email Address", class: "form-label fw-semibold" %>
          <%= f.email_field :email,
                autofocus: true,
                class: "form-control",
                autocomplete: "email",
                required: true,
                id: "user_email" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Password", class: "form-label fw-semibold" %>
          <%= f.password_field :password,
                class: "form-control",
                autocomplete: "current-password",
                required: true,
                id: "user_password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-3">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "Remember this device", class: "form-check-label" %>
          </div>
        <% end %>

        <div class="d-grid mb-3">
          <%= f.submit "Sign In", class: "btn btn-primary btn-lg" %>
        </div>

      <% end %>

      <div class="text-center small mb-4">
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-decoration-none" %>
      </div>

      <!-- TEST CREDENTIALS CARD (Development/Test only) -->
      <% if Rails.env.development? || Rails.env.test? %>
        <div class="test-credentials-card mt-4 p-3 border rounded" style="background-color: #f8fafc; border-color: #cbd5e1 !important;">
          <h6 class="fw-semibold mb-2 text-dark">
            <i class="fas fa-key me-1"></i> Quick Login - Most Used
          </h6>
          
