                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-2 bg-light rounded border">
                <div class="d-flex align-items-center">
                  <span class="badge bg-success me-2">🔧</span>
                  <div>
                    <div class="fw-semibold small">Mechanic</div>
                    <code class="small">mechanic@test.com / password123</code>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-2 bg-light rounded border">
                <div class="d-flex align-items-center">
                  <span class="badge bg-dark me-2">💰</span>
                  <div>
                    <div class="fw-semibold small">Finance</div>
                    <code class="small">finance@test.com / password123</code>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12">
              <div class="p-2 bg-primary bg-opacity-10 rounded border border-primary">
                <div class="d-flex align-items-center">
                  <span class="badge bg-danger me-2">👑</span>
                  <div>
                    <div class="fw-semibold small">Workshop Supervisor</div>
                    <code class="small">workshop_supervisor@test.com / password123</code>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <h6 class="fw-semibold mb-2 text-dark">
            <i class="fas fa-list me-1"></i> All Test Credentials
          </h6>
          
          <div class="row g-2">
            <!-- VMCOTT Workflow Column - UPDATED WITH NEW ROLES -->
            <div class="col-md-4">
              <div class="small fw-semibold text-primary mb-1">🛠️ VMCOTT Workflow</div>
              <div class="credentials-grid">
                <div class="credential-item border-bottom pb-1 mb-1">
