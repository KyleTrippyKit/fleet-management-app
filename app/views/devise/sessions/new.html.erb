          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <div class="p-2 bg-light rounded border">
                <div class="d-flex align-items-center">
                  <span class="badge bg-primary me-2">🚪</span>
                  <div>
                    <div class="fw-semibold small">Security Gate Officer</div>
                    <code class="small">security_gate@test.com / password123</code>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-2 bg-light rounded border">
                <div class="d-flex align-items-center">
                  <span class="badge bg-info me-2">🔍</span>
                  <div>
                    <div class="fw-semibold small">Inspector</div>
                    <code class="small">inspector@test.com / password123</code>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-2 bg-light rounded border">
                <div class="d-flex align-items-center">
                  <span class="badge bg-warning me-2">📦</span>
                  <div>
