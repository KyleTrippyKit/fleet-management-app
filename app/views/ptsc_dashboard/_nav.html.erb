<%# app/views/shared/_navigation.html.erb or wherever your navigation is %>
<div class="mb-4">
  <div class="card border-0 shadow-sm nav-card">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
          <% nav_items = [] %>
          <% nav_items << ["📊 Dashboard", ptsc_dashboard_path] %>
          <% nav_items << ["🚗 Fleet", agency_vehicles_path(current_user.agency, service_owner: 'PTSC')] unless current_user.finance? %>
          <% if current_user.fleet_manager? || current_user.admin? %>
            <% nav_items << ["📈 Usage Analytics", agency_analytics_path(current_user.agency, service_owner: 'PTSC')] %>
          <% end %>
          <% if current_user.finance? || current_user.fleet_manager? || current_user.admin? %>
            <% nav_items << ["💰 Invoices", invoices_path(service_owner: 'PTSC')] %>
          <% end %>
          
          <%# NEW: Add integrated financial modules %>
          <% if current_user.finance? || current_user.admin? %>
            <% nav_items << ["💳 Transactions", transactions_path(service_owner: 'PTSC')] %>
            <% nav_items << ["📋 Purchase Orders", purchase_orders_path(service_owner: 'PTSC')] %>
            <% nav_items << ["📄 Quotations", quotations_path(service_owner: 'PTSC')] %>
            <% nav_items << ["🧾 POS", pos_transactions_path(service_owner: 'PTSC')] %>
            <%# FIXED: Use correct namespaced route helper %>
            <% nav_items << ["📊 QuickBooks", quickbooks_dashboard_path(service_owner: 'PTSC')] %>
          <% end %>
          
          <% if current_user.fleet_manager? || current_user.admin? %>
            <% nav_items << ["👥 Drivers", drivers_path(service_owner: 'PTSC')] %>
          <% end %>
          <% nav_items << ["⚙️ Settings", "#"] %>

          <% nav_items.each do |label, path| %>
            <%= link_to label, path,
              class: "nav-option btn btn-sm #{'btn-primary' if current_page?(path)} #{'btn-outline-primary' unless current_page?(path)} rounded-pill px-3 py-2 fw-medium" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>