<div class="card border-0 shadow-sm h-100">
  <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
    <div>
      <h6 class="mb-0"><i class="bi bi-tools text-success me-2"></i>Maintenance Costs</h6>
      <p class="text-muted small mb-0">Daily maintenance expenditure</p>
    </div>
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        This Week
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="#">This Week</a></li>
        <li><a class="dropdown-item" href="#">This Month</a></li>
        <li><a class="dropdown-item" href="#">Last 3 Months</a></li>
      </ul>
    </div>
  </div>
  <div class="card-body p-3">
    <div class="chart-container position-relative" style="height: 200px;">
      <canvas id="maintenanceCostChart"></canvas>
      <div id="costChartFallback" class="chart-placeholder">
        <div class="text-center">
          <i class="bi bi-bar-chart fs-1 text-muted mb-2"></i>
          <p class="text-muted small">Maintenance cost chart</p>
        </div>
      </div>
    </div>
    <div class="mt-3 d-flex justify-content-between small">
      <span class="text-muted">
        Monthly Total: <strong>$<%= number_with_precision(@maintenance_stats&.dig(:monthly_cost) || 0, precision: 0) %></strong>
      </span>
      <span class="text-muted">
        Avg Daily: <strong>$<%= number_with_precision((@maintenance_stats&.dig(:monthly_cost) || 0)/30, precision: 0) %></strong>
      </span>
    </div>
  </div>
</div>
