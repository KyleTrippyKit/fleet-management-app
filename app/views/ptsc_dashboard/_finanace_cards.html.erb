# app/views/ptsc_dashboard/_finance_cards.html.erb
<!-- Finance Dashboard Cards -->
<div class="row g-3 mb-5">
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-cash-stack text-primary fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">MONTHLY SPEND</p>
            <h3 class="fw-bold mb-1">$<%= number_with_precision(@invoice_stats[:monthly_total] || 0, precision: 0) %></h3>
            <p class="text-muted small mb-0">Current month</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-clock-history text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">PENDING INVOICES</p>
            <h3 class="fw-bold mb-1"><%= @invoice_stats[:pending_count] || 0 %></h3>
            <p class="text-muted small mb-0">Awaiting payment</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-danger bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-danger mb-1 tracking-wider">OVERDUE</p>
            <h3 class="fw-bold mb-1 text-danger"><%= @invoice_stats[:overdue_count] || 0 %></h3>
            <p class="text-danger small fw-medium mb-0">Payment delayed</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-success bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-check-circle text-success fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">PAID</p>
            <h3 class="fw-bold mb-1"><%= @invoice_stats[:paid_count] || 0 %></h3>
            <p class="text-muted small mb-0">This month</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>