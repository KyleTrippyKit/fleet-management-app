<script>
// Initialize charts when page loads
function initCharts() {
  console.log('Initializing charts...');
  
  // Check if Chart.js is loaded
  if (typeof Chart === 'undefined') {
    console.error('Chart.js not loaded. Showing fallback content.');
    return;
  }
  
  // Create Fuel Efficiency Chart
  const fuelCanvas = document.getElementById('fuelEfficiencyChart');
  if (fuelCanvas) {
    try {
      // Hide fallback
      document.getElementById('fuelChartFallback').style.display = 'none';
      
      // Create gradient
      const ctx = fuelCanvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, 'rgba(26, 115, 232, 0.3)');
      gradient.addColorStop(1, 'rgba(26, 115, 232, 0.05)');
      
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
          datasets: [{
            label: 'Fuel Consumption (L)',
            data: [4200, 3800, 4500, 4100],
            backgroundColor: gradient,
            borderColor: '#1a73e8',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#1a73e8',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              titleColor: '#333',
              bodyColor: '#666',
              borderColor: '#ddd',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              displayColors: false
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.05)'
              },
              ticks: {
                callback: function(value) {
                  return (value / 1000).toFixed(0) + 'k L';
                },
                font: {
                  size: 11
                }
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                font: {
                  size: 11
                }
              }
            }
          }
        }
      });
      console.log('Fuel chart created successfully');
    } catch (error) {
      console.error('Error creating fuel chart:', error);
    }
  }
  
  // Create Maintenance Cost Chart
  const costCanvas = document.getElementById('maintenanceCostChart');
  if (costCanvas) {
    try {
      // Hide fallback
      document.getElementById('costChartFallback').style.display = 'none';
      
      const ctx = costCanvas.getContext('2d');
      
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Maintenance Cost ($)',
            data: [420, 380, 510, 340, 460, 210, 180],
            backgroundColor: 'rgba(25, 135, 84, 0.1)',
            borderColor: '#198754',
            borderWidth: 3,
            fill: true,
            tension: 0,
            stepped: true,
            pointBackgroundColor: '#198754',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              titleColor: '#333',
              bodyColor: '#666',
              borderColor: '#ddd',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              displayColors: false
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.05)'
              },
              ticks: {
                callback: function(value) {
                  return '$' + value;
                },
                font: {
                  size: 11
                }
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                font: {
                  size: 11
                }
              }
            }
          }
        }
      });
      console.log('Cost chart created successfully');
    } catch (error) {
      console.error('Error creating cost chart:', error);
    }
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  console.log('DOM loaded, checking Chart.js...');
  // Wait a bit for Chart.js to load
  setTimeout(initCharts, 100);
});

// Initialize with Turbo
document.addEventListener('turbo:load', function() {
  console.log('Turbo loaded, initializing charts...');
  setTimeout(initCharts, 100);
});

// Rest of JavaScript functionality
document.addEventListener("turbo:load", function() {
  const form = document.getElementById("ptsc_vehicles_filter_form");
  const turboFrame = document.getElementById("vehicles_list");
  
  // View toggle functionality
  const gridViewBtn = document.querySelector('[data-view="grid"]');
  const listViewBtn = document.querySelector('[data-view="list"]');
  const gridView = document.getElementById('grid-view');
  const listView = document.getElementById('list-view');
  
  if (gridViewBtn && listViewBtn) {
    // Grid view button
    gridViewBtn.addEventListener('click', function() {
      gridView.classList.remove('d-none');
      listView.classList.add('d-none');
      gridViewBtn.classList.remove('btn-light', 'text-muted');
      gridViewBtn.classList.add('btn-white', 'shadow-sm', 'active');
      listViewBtn.classList.remove('btn-white', 'shadow-sm', 'active');
      listViewBtn.classList.add('btn-light', 'text-muted');
    });
    
    // List view button
    listViewBtn.addEventListener('click', function() {
      listView.classList.remove('d-none');
      gridView.classList.add('d-none');
      listViewBtn.classList.remove('btn-light', 'text-muted');
      listViewBtn.classList.add('btn-white', 'shadow-sm', 'active');
      gridViewBtn.classList.remove('btn-white', 'shadow-sm', 'active');
      gridViewBtn.classList.add('btn-light', 'text-muted');
    });
  }
  
  if (!form) return;
  
  function showSpinner() {
    if (!turboFrame) return;
    
    let overlay = turboFrame.querySelector('.loading-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.className = 'loading-overlay d-flex justify-content-center align-items-center bg-white bg-opacity-75';
      overlay.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>';
      turboFrame.appendChild(overlay);
    }
  }
  
  function hideSpinner() {
    if (!turboFrame) return;
    
    const overlay = turboFrame.querySelector('.loading-overlay');
    if (overlay) overlay.remove();
  }
  
  // Search with debounce
  const searchInput = form.querySelector('input[type="text"]');
  if (searchInput) {
    let debounceTimer;
    searchInput.addEventListener("input", (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (e.target.value.length === 0 || e.target.value.length >= 2) {
          showSpinner();
          if (typeof Turbo !== 'undefined') {
            Turbo.submitForm(form);
          } else {
            form.submit();
          }
        }
      }, 500);
    });
  }
  
  // Status filter change
  const statusFilter = form.querySelector('select[name="status"]');
  if (statusFilter) {
    statusFilter.addEventListener("change", function() {
      showSpinner();
      if (typeof Turbo !== 'undefined') {
        Turbo.submitForm(form);
      } else {
        form.submit();
      }
    });
  }
  
  // Turbo events
  if (turboFrame) {
    turboFrame.addEventListener("turbo:frame-load", hideSpinner);
    turboFrame.addEventListener("turbo:frame-render", hideSpinner);
  }
  
  // Add hover effect for vehicle location dots
  document.querySelectorAll('.pulse-animation').forEach(dot => {
    const tooltip = dot.querySelector('.position-absolute');
    dot.addEventListener('mouseenter', () => {
      tooltip.classList.add('show');
    });
    dot.addEventListener('mouseleave', () => {
      tooltip.classList.remove('show');
    });
  });
});
</script>

<style>
