  .stats-card .card-body {
    padding: 1rem !important;
  }
  
  .stats-card h3 {
    font-size: 1.25rem;
  }
  
  .card-body .row > div {
    margin-bottom: 0.5rem;
  }
  
  .card-body .row > div:last-child {
