<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 py-4">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h5 class="fw-bold mb-0">
          <i class="bi bi-bus-front text-primary me-2"></i>
          PTSC Fleet Overview
        </h5>
        <p class="text-muted mb-0 small">
          <% if vehicles.any? %>
            Showing <%= vehicles.offset_value + 1 %> to <%= vehicles.offset_value + vehicles.length %> of <%= vehicle_stats[:total_vehicles] %> vehicles
          <% else %>
            No vehicles found
          <% end %>
        </p>
      </div>
      <%= link_to "View All PTSC", agency_vehicles_path(current_user.agency, service_owner: 'PTSC'), class: "btn btn-outline-primary btn-sm fw-bold" %>
    </div>
  </div>
  <div class="card-body">
    <%= turbo_frame_tag "vehicles_list" do %>
      <!-- Grid View -->
      <div id="grid-view" class="view-container">
        <% if vehicles.any? %>
          <div class="row g-4">
            <% vehicles.each do |vehicle| %>
              <div class="col-xxl-4 col-xl-6 col-lg-6 col-md-6">
                <div class="card border-0 shadow-sm h-100 vehicle-card overflow-hidden hover-lift">
                  <div class="position-relative">
                    <%= link_to vehicle_path(vehicle) do %>
                      <% if vehicle.primary_photo.attached? %>
                        <%= image_tag vehicle.primary_photo.variant(resize_to_fill: [400, 250]), 
                              class: "card-img-top object-fit-cover", 
                              style: "height: 200px;",
                              alt: "#{vehicle.make} #{vehicle.model}" %>
                      <% else %>
                        <div class="bg-gradient-to-br from-primary-50 to-blue-50 d-flex flex-column align-items-center justify-content-center" style="height: 200px;">
                          <% if vehicle.vehicle_type == 'bus' %>
                            <i class="bi bi-bus-front text-primary opacity-25 display-3 mb-2"></i>
                          <% elsif vehicle.vehicle_type == 'truck' %>
                            <i class="bi bi-truck text-primary opacity-25 display-3 mb-2"></i>
                          <% elsif vehicle.vehicle_type == 'van' %>
                            <i class="bi bi-van text-primary opacity-25 display-3 mb-2"></i>
                          <% else %>
                            <i class="bi bi-car-front text-primary opacity-25 display-3 mb-2"></i>
                          <% end %>
                          <p class="text-muted small mb-0">No photo available</p>
                          <p class="text-muted small"><%= vehicle.make %> <%= vehicle.model %></p>
                        </div>
                      <% end %>
                    <% end %>
                    
                    <div class="position-absolute top-0 end-0 m-3">
                      <span class="badge rounded-pill <%= vehicle.status == 'active' ? 'bg-success' : 'bg-warning text-dark' %> px-3 py-2 shadow-sm text-uppercase" style="font-size: 0.7rem;">
                        <i class="bi <%= vehicle.status == 'active' ? 'bi-check-circle' : 'bi-tools' %> me-1"></i>
                        <%= vehicle.status_display %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="card-body p-4">
                    <h6 class="fw-bold mb-2"><%= vehicle.make %> <%= vehicle.model %></h6>
                    <div class="d-flex align-items-center gap-1 text-muted small mb-3">
                      <i class="bi bi-tag"></i>
                      <span><%= vehicle.license_plate %></span>
                    </div>
                    
                    <div class="row text-center py-3 border-top border-bottom mb-3 bg-light bg-opacity-50 rounded mx-0">
                      <div class="col-6 border-end">
                        <p class="text-uppercase text-muted mb-0" style="font-size: 0.65rem; font-weight: 800; letter-spacing: -0.02em;">Mileage</p>
                        <p class="fw-bold mb-0 small"><%= number_with_delimiter(vehicle.mileage) %> km</p>
                      </div>
                      <div class="col-6">
                        <p class="text-uppercase text-muted mb-0" style="font-size: 0.65rem; font-weight: 800; letter-spacing: -0.02em;">Utilization</p>
                        <p class="fw-bold mb-0 small text-primary"><%= vehicle.calculate_utilization %>%</p>
                      </div>
                    </div>

                    <%= link_to vehicle_path(vehicle), class: "btn btn-outline-primary w-100 fw-bold d-flex align-items-center justify-content-center py-2 hover-lift" do %>
                      <i class="bi bi-eye me-2"></i>View Details
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          
          <div class="mt-5">
            <%= paginate vehicles, param_name: :vehicles_page,
                  class: "pagination justify-content-center" %>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="bi bi-search text-muted opacity-25 display-1 mb-4"></i>
            <h4 class="text-muted mb-3">No matching vehicles found</h4>
            <p class="text-muted small mb-4">Try adjusting your search or filters</p>
            <%= link_to "Add First PTSC Vehicle", new_vehicle_path(service_owner: 'PTSC'), class: "btn btn-primary px-4" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>