<%# app/views/ptsc_dashboard/index.html.erb - ENTERPRISE (CLEAN + EXECUTIVE) %>

<%
  total_fleet       = (@total_vehicles_count || 0).to_i
  active_fleet      = (@active_vehicles_count || 0).to_i
  maintenance_fleet = (@maintenance_vehicles_count || 0).to_i
  out_fleet         = (@out_vehicles_count || 0).to_i

  active_alerts = (@active_alerts_count || 0).to_i
  upcoming_cnt  = (@upcoming_maintenance_count || 0).to_i

  availability_pct =
    total_fleet.positive? ? ((active_fleet.to_f / total_fleet) * 100).round(1) : 0.0

  health =
    if active_alerts >= 10 || out_fleet >= 10
      { label: "Critical", badge: "danger", icon: "fa-triangle-exclamation" }
    elsif active_alerts >= 3 || out_fleet >= 3
      { label: "Degraded", badge: "warning", icon: "fa-circle-exclamation" }
    else
      { label: "Normal", badge: "success", icon: "fa-circle-check" }
    end
%>

<div class="ptsc-enterprise container-fluid py-4 px-4">

  <!-- HEADER / COMMAND BAR -->
  <div class="card border-0 shadow-sm ptsc-header mb-3">
    <div class="card-body">
      <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="ptsc-badge">
              <i class="fas fa-tachometer-alt"></i>
            </div>
            <h1 class="m-0 ptsc-title">PTSC Operations</h1>
            <span class="badge text-bg-light ptsc-pill">Fleet</span>
            <span class="badge text-bg-light ptsc-pill">Executive view</span>
          </div>

          <div class="text-muted mt-1">
            Public Transport Service Corporation • Operational control summary
          </div>

          <div class="d-flex flex-wrap gap-2 mt-2">
            <span class="badge bg-<%= health[:badge] %> ptsc-pill">
              <i class="fas <%= health[:icon] %> me-1"></i> <%= health[:label] %>
            </span>
            <span class="badge text-bg-light ptsc-pill">
              Availability: <strong class="ms-1"><%= availability_pct %>%</strong>
            </span>
            <span class="badge text-bg-light ptsc-pill">
              Updated: <strong class="ms-1"><%= Time.current.strftime("%b %d, %I:%M %p") %></strong>
            </span>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%= link_to main_dashboard_path, class: "btn btn-outline-secondary ptsc-btn" do %>
            <i class="fas fa-home me-1"></i> Main
          <% end %>

          <%= link_to ptsc_pos_transactions_path, class: "btn btn-primary ptsc-btn" do %>
            <i class="fas fa-cash-register me-1"></i> POS
          <% end %>

          <%= link_to (respond_to?(:ptsc_alerts_path) ? ptsc_alerts_path : "#"), class: "btn btn-outline-secondary ptsc-btn" do %>
            <i class="fas fa-bell me-1"></i> Alerts
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI ROW -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm ptsc-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="ptsc-kpi-label">Total Fleet</div>
              <div class="ptsc-kpi-value"><%= total_fleet %></div>
              <div class="text-muted small">Registered vehicles</div>
            </div>
            <div class="ptsc-kpi-ico text-info bg-info bg-opacity-10">
              <i class="fas fa-layer-group"></i>
            </div>
          </div>
          <div class="ptsc-kpi-foot mt-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Availability</span>
              <strong><%= availability_pct %>%</strong>
            </div>
            <div class="progress mt-2" style="height: 8px;">
              <div class="progress-bar" role="progressbar" style="width:<%= [[availability_pct,0].max,100].min %>%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm ptsc-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="ptsc-kpi-label">In Service</div>
              <div class="ptsc-kpi-value"><%= active_fleet %></div>
              <div class="text-muted small">Operating units</div>
            </div>
            <div class="ptsc-kpi-ico text-success bg-success bg-opacity-10">
              <i class="fas fa-bus"></i>
            </div>
          </div>
          <div class="ptsc-kpi-foot mt-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Target</span>
              <strong>95%</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm ptsc-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="ptsc-kpi-label">Maintenance</div>
              <div class="ptsc-kpi-value"><%= maintenance_fleet %></div>
              <div class="text-muted small">Workload</div>
            </div>
            <div class="ptsc-kpi-ico text-warning bg-warning bg-opacity-10">
              <i class="fas fa-wrench"></i>
            </div>
          </div>
          <div class="ptsc-kpi-foot mt-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Upcoming</span>
              <strong><%= upcoming_cnt %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm ptsc-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="ptsc-kpi-label">Risk / Alerts</div>
              <div class="ptsc-kpi-value"><%= active_alerts %></div>
              <div class="text-muted small">Open alerts</div>
            </div>
            <div class="ptsc-kpi-ico text-danger bg-danger bg-opacity-10">
              <i class="fas fa-bell"></i>
            </div>
          </div>
          <div class="ptsc-kpi-foot mt-3">
            <div class="d-flex justify-content-between">
              <span class="text-muted">Out of Service</span>
              <strong><%= out_fleet %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- EXEC GRID -->
  <div class="row g-3">

    <!-- LEFT: SUMMARY -->
    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="ptsc-card-head">
          <div>
            <div class="ptsc-card-title">Executive Summary</div>
            <div class="ptsc-card-sub text-muted">Availability and risk overview</div>
          </div>
          <%= link_to vehicles_path, class: "btn btn-sm btn-outline-primary" do %>
            Fleet
          <% end %>
        </div>

        <div class="card-body">
          <div class="ptsc-metric">
            <div class="d-flex justify-content-between">
              <span class="text-muted small">Fleet Availability</span>
              <strong><%= availability_pct %>%</strong>
            </div>
            <div class="progress mt-2" style="height:10px;">
              <div class="progress-bar" role="progressbar" style="width:<%= [[availability_pct,0].max,100].min %>%"></div>
            </div>
            <div class="text-muted small mt-2">
              Current: <%= active_fleet %>/<%= total_fleet %> active • Target 95%
            </div>
          </div>

          <div class="row g-2 mt-3">
            <div class="col-6"><div class="ptsc-mini"><div class="text-muted small">Maintenance</div><div class="fw-bold fs-5"><%= maintenance_fleet %></div></div></div>
            <div class="col-6"><div class="ptsc-mini"><div class="text-muted small">Out of Service</div><div class="fw-bold fs-5"><%= out_fleet %></div></div></div>
            <div class="col-6"><div class="ptsc-mini"><div class="text-muted small">Upcoming</div><div class="fw-bold fs-5"><%= upcoming_cnt %></div></div></div>
            <div class="col-6"><div class="ptsc-mini"><div class="text-muted small">Open Alerts</div><div class="fw-bold fs-5"><%= active_alerts %></div></div></div>
          </div>

          <hr class="my-3">

          <div class="d-flex flex-column gap-2">
            <div class="alert alert-<%= health[:badge] %> mb-0">
              <strong>Status:</strong> <%= health[:label] %>.
              <% if health[:badge] == "danger" %>Immediate review recommended.<% elsif health[:badge] == "warning" %>Monitor maintenance load and alerts.<% else %>Operations within threshold.<% end %>
            </div>

            <div class="d-flex gap-2">
              <%= link_to maintenance_dashboard_vehicles_path, class: "btn btn-outline-secondary w-100" do %>
                <i class="fas fa-screwdriver-wrench me-1"></i> Maintenance
              <% end %>
              <%= link_to analytics_vehicles_path, class: "btn btn-outline-secondary w-100" do %>
                <i class="fas fa-chart-line me-1"></i> Analytics
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MIDDLE: ALERTS -->
    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="ptsc-card-head">
          <div>
            <div class="ptsc-card-title">Active Alerts</div>
            <div class="ptsc-card-sub text-muted">Prioritized list</div>
          </div>
          <span class="badge bg-danger"><%= active_alerts %></span>
        </div>

        <div class="card-body">
          <% if @active_alerts.present? %>
            <div class="list-group list-group-flush">
              <% @active_alerts.first(8).each do |alert| %>
                <% sev = alert.severity.to_s.downcase %>
                <% badge = (sev == "high" ? "danger" : sev == "medium" ? "warning" : "info") %>

                <div class="list-group-item px-0 border-0">
                  <div class="d-flex justify-content-between gap-3">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-<%= badge %>"><%= sev.presence&.titleize || "Info" %></span>
                        <strong><%= alert.title %></strong>
                      </div>
                      <div class="text-muted small mt-1"><%= alert.description.to_s.truncate(90) %></div>
                      <div class="text-muted small mt-1">
                        <i class="fas fa-clock me-1"></i><%= time_ago_in_words(alert.created_at) %> ago
                      </div>
                    </div>
                    <div class="text-end">
                      <%= link_to "Open", alert_path(alert), class: "btn btn-sm btn-outline-secondary" %>
                    </div>
                  </div>
                  <hr class="my-3">
                </div>
              <% end %>
            </div>

            <% if respond_to?(:ptsc_alerts_path) %>
              <%= link_to ptsc_alerts_path, class: "btn btn-outline-primary w-100 mt-2" do %>
                View all alerts
              <% end %>
            <% end %>
          <% else %>
            <div class="ptsc-empty text-center py-5">
              <i class="fas fa-circle-check text-success fs-1 opacity-50 mb-2"></i>
              <div class="text-muted">No active alerts</div>
              <div class="text-muted small">System stable.</div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- RIGHT: MAINT + POS -->
    <div class="col-12 col-xl-4">

      <div class="card border-0 shadow-sm mb-3">
        <div class="ptsc-card-head">
          <div>
            <div class="ptsc-card-title">Upcoming Maintenance</div>
            <div class="ptsc-card-sub text-muted">Next scheduled services</div>
          </div>
          <span class="badge bg-warning text-dark"><%= upcoming_cnt %></span>
        </div>

        <div class="card-body">
          <% if @upcoming_maintenance.present? %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Vehicle</th>
                    <th>Service</th>
                    <th class="text-end">Due</th>
                  </tr>
                </thead>
                <tbody>
                  <% @upcoming_maintenance.first(6).each do |m| %>
                    <% due = m.respond_to?(:due_date) ? m.due_date : nil %>
                    <% due ||= m.end_date if m.respond_to?(:end_date) %>
                    <% due ||= m.start_date if m.respond_to?(:start_date) %>

                    <tr>
                      <td>
                        <div class="fw-semibold"><%= m.vehicle&.registration_number || m.vehicle&.license_plate || "N/A" %></div>
                        <div class="text-muted small"><%= m.vehicle&.respond_to?(:make_model) ? m.vehicle&.make_model : m.vehicle&.display_name %></div>
                      </td>
                      <td>
                        <div class="fw-semibold"><%= m.service_type.presence || "General Service" %></div>
                        <div class="text-muted small"><%= m.notes.to_s.truncate(45) %></div>
                      </td>
                      <td class="text-end">
                        <% if due.present? %>
                          <% days = (due.to_date - Date.today).to_i %>
                          <% badge = days <= 2 ? "danger" : (days <= 7 ? "warning" : "secondary") %>
                          <span class="badge bg-<%= badge %>"><%= due.to_date.strftime("%b %d") %></span>
                          <div class="text-muted small"><%= days %>d</div>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <%= link_to maintenance_dashboard_vehicles_path, class: "btn btn-outline-primary w-100 mt-2" do %>
              Open Maintenance Center
            <% end %>
          <% else %>
            <div class="ptsc-empty text-center py-4">
              <i class="fas fa-circle-check text-success fs-1 opacity-50 mb-2"></i>
              <div class="text-muted">No upcoming maintenance</div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="ptsc-card-head">
          <div>
            <div class="ptsc-card-title">Recent POS Transactions</div>
            <div class="ptsc-card-sub text-muted">Latest sales activity</div>
          </div>
          <%= link_to ptsc_pos_transactions_path, class: "btn btn-sm btn-outline-primary" do %>
            View all
          <% end %>
        </div>

        <div class="card-body">
          <% if @recent_pos_transactions.present? %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>ID</th>
                    <th>Amount</th>
                    <th class="text-end">Time</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_pos_transactions.first(6).each do |t| %>
                    <tr>
                      <td>
                        <div class="fw-semibold">#<%= t.id %></div>
                        <div class="text-muted small"><%= t.transaction_type.to_s.titleize.presence || "Sale" %></div>
                      </td>
                      <td>
                        <div class="fw-semibold">TTD <%= number_with_precision(t.total_amount || 0, precision: 2) %></div>
                        <div class="text-muted small"><%= t.payment_method.to_s.titleize.presence || "Cash" %></div>
                      </td>
                      <td class="text-end">
                        <div class="fw-semibold"><%= t.created_at ? t.created_at.strftime("%I:%M %p") : "—" %></div>
                        <div class="text-muted small"><%= t.created_at ? t.created_at.strftime("%b %d") : "—" %></div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="ptsc-empty text-center py-4">
              <i class="fas fa-receipt text-muted fs-1 opacity-50 mb-2"></i>
              <div class="text-muted">No recent POS activity</div>
              <%= link_to ptsc_pos_transactions_path, class: "btn btn-primary btn-sm mt-2" do %>
                Go to POS Dashboard
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>

  <!-- QUICK ACTIONS -->
  <div class="card border-0 shadow-sm mt-3">
    <div class="ptsc-card-head">
      <div>
        <div class="ptsc-card-title">Quick Actions</div>
        <div class="ptsc-card-sub text-muted">Common tasks</div>
      </div>
    </div>

    <div class="card-body">
      <div class="row g-2">
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to new_pos_transaction_path, class: "btn btn-success w-100 ptsc-action" do %>
            <i class="fas fa-plus-circle me-1"></i> New Sale
          <% end %>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to new_vehicle_path, class: "btn btn-outline-primary w-100 ptsc-action" do %>
            <i class="fas fa-bus me-1"></i> Add Vehicle
          <% end %>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to new_maintenance_path, class: "btn btn-outline-warning w-100 ptsc-action" do %>
            <i class="fas fa-wrench me-1"></i> Log Service
          <% end %>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to new_alert_path, class: "btn btn-outline-danger w-100 ptsc-action" do %>
            <i class="fas fa-exclamation-circle me-1"></i> Create Alert
          <% end %>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to (respond_to?(:fare_rules_path) ? fare_rules_path : "#"), class: "btn btn-outline-info w-100 ptsc-action" do %>
            <i class="fas fa-ticket-alt me-1"></i> Fare Rules
          <% end %>
        </div>
        <div class="col-12 col-md-6 col-xl-2">
          <%= link_to "#", class: "btn btn-outline-secondary w-100 ptsc-action" do %>
            <i class="fas fa-print me-1"></i> Daily Report
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  .ptsc-enterprise { background: transparent; }

  .ptsc-header { border-radius: 16px; }
  .ptsc-title { font-weight: 900; letter-spacing: -0.02em; }

  .ptsc-badge {
    width: 42px; height: 42px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(13,110,253,.10);
    color: #0d6efd;
    flex: 0 0 auto;
  }

  .ptsc-pill {
    border-radius: 999px;
    padding: .42rem .65rem;
    font-weight: 700;
  }

  .ptsc-btn { border-radius: 12px; }

  .ptsc-kpi { border-radius: 16px; }
  .ptsc-kpi-label {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .10em;
    color: #6c757d;
    font-weight: 800;
  }
  .ptsc-kpi-value { font-size: 2.15rem; font-weight: 900; line-height: 1.05; }
  .ptsc-kpi-ico {
    width: 44px; height: 44px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
  }
  .ptsc-kpi-foot { border-top: 1px solid rgba(0,0,0,.06); padding-top: 12px; }

  .ptsc-card-head {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: rgba(248,249,250,.75);
  }
  .ptsc-card-title { font-weight: 900; line-height: 1.05; }
  .ptsc-card-sub { font-size: .86rem; }

  .ptsc-mini {
    border: 1px solid rgba(0,0,0,.06);
    background: rgba(248,249,250,.55);
    border-radius: 14px;
    padding: 10px 12px;
  }

  .ptsc-empty {
    border: 1px dashed rgba(0,0,0,.12);
    border-radius: 14px;
    background: rgba(248,249,250,.45);
    padding: 18px;
  }

  .ptsc-action { border-radius: 12px; }

  .ptsc-enterprise .table thead th {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #6c757d;
  }
</style>
