<%# app/views/ptsc_dashboard/index.html.erb - FIXED VERSION %>

<div class="page-shell ptsc-dashboard">

  <!-- Top header -->
  <div class="page-hero">
    <div class="row align-items-center g-3">
      <div class="col-12 col-lg-7">
        <h2 class="hero-title mb-1">
          <i class="fas fa-tachometer-alt me-2"></i>
          PTSC Dashboard
        </h2>
        <div class="hero-subtitle">
          Public Transport Service Corporation - Operational overview
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="hero-actions">
          <%= link_to main_dashboard_path, class: "btn btn-outline-secondary" do %>
            <i class="fas fa-home me-1"></i> Main Dashboard
          <% end %>

          <%# FIXED: Use the correct route from your routes list %>
          <%= link_to ptsc_pos_transactions_path, class: "btn btn-primary" do %>
            <i class="fas fa-cash-register me-1"></i> POS Dashboard
          <% end %>

          <%= link_to alerts_path, class: "btn btn-outline-secondary" do %>
            <i class="fas fa-bell me-1"></i> Alerts
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Stats Row -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-title">Active Buses</div>
        <div class="stat-value"><%= @active_vehicles_count || 0 %></div>
        <div class="stat-chip">
          <i class="fas fa-bus text-success"></i>
          <span>In Service</span>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-title">In Maintenance</div>
        <div class="stat-value"><%= @maintenance_vehicles_count || 0 %></div>
        <div class="stat-chip">
          <i class="fas fa-wrench text-warning"></i>
          <span>Under Repair</span>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-title">Out of Service</div>
        <div class="stat-value"><%= @out_vehicles_count || 0 %></div>
        <div class="stat-chip">
          <i class="fas fa-times-circle text-danger"></i>
          <span>Unavailable</span>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-title">Total Fleet</div>
        <div class="stat-value"><%= @total_vehicles_count || 0 %></div>
        <div class="stat-chip">
          <i class="fas fa-list text-info"></i>
          <span>All Vehicles</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="row g-3">
    <!-- Left Column - Alerts & Notifications -->
    <div class="col-lg-6">
      <div class="section-card">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Active Alerts
          </h5>
          <span class="badge bg-danger"><%= @active_alerts_count || 0 %></span>
        </div>
        <div class="section-card-body">
          <% if @active_alerts.present? %>
            <div class="list-group list-group-flush">
              <% @active_alerts.each do |alert| %>
                <div class="list-group-item px-0 border-0">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <h6 class="mb-0">
                        <span class="badge bg-<%= alert.severity == 'high' ? 'danger' : alert.severity == 'medium' ? 'warning' : 'info' %> me-2">
                          <%= alert.severity.titleize %>
                        </span>
                        <%= alert.title %>
                      </h6>
                      <small class="text-muted">
                        <%= alert.description&.truncate(80) %>
                      </small>
                    </div>
                    <div class="text-end">
                      <small class="text-muted d-block">
                        <%= time_ago_in_words(alert.created_at) %> ago
                      </small>
                      <%= link_to 'View', alert_path(alert), class: 'btn btn-sm btn-outline-primary mt-1' %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-check-circle text-success fs-1 mb-3 opacity-50"></i>
              <p class="text-muted">No active alerts</p>
            </div>
          <% end %>
          
          <div class="mt-3">
            <%= link_to alerts_path, class: 'btn btn-sm btn-outline-primary w-100' do %>
              <i class="fas fa-external-link-alt me-1"></i> View All Alerts
            <% end %>
          </div>
        </div>
      </div>

      <div class="section-card mt-3">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-calendar-alt me-2"></i>
            Upcoming Maintenance
          </h5>
          <span class="badge bg-warning"><%= @upcoming_maintenance_count || 0 %></span>
        </div>
        <div class="section-card-body">
          <% if @upcoming_maintenance.present? %>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Service</th>
                    <th class="text-end">Due Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @upcoming_maintenance.each do |maintenance| %>
                    <tr>
                      <td>
                        <strong><%= maintenance.vehicle&.registration_number || 'N/A' %></strong>
                        <br>
                        <small class="text-muted"><%= maintenance.vehicle&.make_model || '' %></small>
                      </td>
                      <td>
                        <%= maintenance.service_type || 'General Service' %>
                        <% if maintenance.mileage.present? %>
                          <br>
                          <small class="text-muted">at <%= number_with_delimiter(maintenance.mileage) %> km</small>
                        <% end %>
                      </td>
                      <td class="text-end">
                        <span class="badge bg-<%= maintenance.due_date < Date.today + 3.days ? 'danger' : 'warning' %>">
                          <%= maintenance.due_date.strftime('%b %d') %>
                        </span>
                        <br>
                        <small class="text-muted">
                          <%= (maintenance.due_date - Date.today).to_i %> days
                        </small>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-check-circle text-success fs-1 mb-3 opacity-50"></i>
              <p class="text-muted">No upcoming maintenance</p>
            </div>
          <% end %>
          
          <div class="mt-3">
            <%= link_to vehicles_path, class: 'btn btn-sm btn-outline-primary w-100' do %>
              <i class="fas fa-list me-1"></i> View Vehicle Schedule
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column - Recent POS Activity -->
    <div class="col-lg-6">
      <div class="section-card">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-cash-register me-2"></i>
            Recent POS Transactions
          </h5>
          <%= link_to ptsc_pos_transactions_path, class: 'btn btn-sm btn-outline-primary' do %>
            <i class="fas fa-external-link-alt me-1"></i> View All
          <% end %>
        </div>
        <div class="section-card-body">
          <% if @recent_pos_transactions.present? %>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th>Transaction ID</th>
                    <th>Amount</th>
                    <th class="text-end">Time</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_pos_transactions.each do |transaction| %>
                    <tr>
                      <td>
                        <strong>#<%= transaction.id %></strong>
                        <br>
                        <small class="text-muted">
                          <%= transaction.transaction_type&.titleize || 'Sale' %>
                        </small>
                      </td>
                      <td>
                        <span class="fw-bold">TTD <%= number_with_precision(transaction.total_amount || 0, precision: 2) %></span>
                        <br>
                        <small class="text-muted">
                          <%= transaction.payment_method&.titleize || 'Cash' %>
                        </small>
                      </td>
                      <td class="text-end">
                        <%= transaction.created_at&.strftime('%I:%M %p') || '—' %>
                        <br>
                        <small class="text-muted">
                          <%= transaction.created_at&.strftime('%b %d') || '—' %>
                        </small>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
              <div>
                <small class="text-muted">
                  <i class="fas fa-sync-alt me-1"></i>
                  Last updated: <%= Time.current.strftime('%I:%M %p') %>
                </small>
              </div>
              <div>
                <%= link_to ptsc_pos_transactions_path, class: 'btn btn-sm btn-primary' do %>
                  <i class="fas fa-chart-line me-1"></i> Detailed Reports
                <% end %>
              </div>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-cash-register text-muted fs-1 mb-3 opacity-50"></i>
              <p class="text-muted">No recent transactions</p>
              <%= link_to ptsc_pos_transactions_path, class: 'btn btn-sm btn-primary' do %>
                <i class="fas fa-external-link-alt me-1"></i> Go to POS Dashboard
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="section-card mt-3">
        <div class="section-card-header">
          <h5 class="section-card-title">
            <i class="fas fa-road me-2"></i>
            Route Status
          </h5>
          <span class="badge bg-info">Active Routes</span>
        </div>
        <div class="section-card-body">
          <% if @active_routes.present? %>
            <div class="row g-2">
              <% @active_routes.each do |route| %>
                <div class="col-6">
                  <div class="card border-0 bg-light">
                    <div class="card-body p-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <h6 class="mb-0"><%= route.name %></h6>
                          <small class="text-muted">
                            <%= route.vehicles_count || 0 %> buses active
                          </small>
                        </div>
                        <div class="text-end">
                          <span class="badge bg-success">
                            <i class="fas fa-check-circle"></i>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-3">
              <i class="fas fa-route text-muted fs-1 mb-3 opacity-50"></i>
              <p class="text-muted">No active route data</p>
            </div>
          <% end %>
          
          <div class="mt-3">
            <%= link_to '#', class: 'btn btn-sm btn-outline-info w-100' do %>
              <i class="fas fa-map-marked-alt me-1"></i> View Route Map
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Section - Quick Actions -->
  <div class="section-card mt-3">
    <div class="section-card-header">
      <h5 class="section-card-title">
        <i class="fas fa-bolt me-2"></i>
        Quick Actions
      </h5>
      <span class="muted small">Common operational tasks</span>
    </div>
    <div class="section-card-body">
      <div class="row g-2">
        <div class="col-md-2">
          <%= link_to new_pos_transaction_path, class: 'btn btn-success w-100' do %>
            <i class="fas fa-plus-circle me-1"></i> New Sale
          <% end %>
        </div>
        <div class="col-md-2">
          <%= link_to new_vehicle_path, class: 'btn btn-outline-primary w-100' do %>
            <i class="fas fa-bus me-1"></i> Add Vehicle
          <% end %>
        </div>
        <div class="col-md-2">
          <%= link_to new_maintenance_path, class: 'btn btn-outline-warning w-100' do %>
            <i class="fas fa-wrench me-1"></i> Log Service
          <% end %>
        </div>
        <div class="col-md-2">
          <%= link_to new_alert_path, class: 'btn btn-outline-danger w-100' do %>
            <i class="fas fa-exclamation-circle me-1"></i> Create Alert
          <% end %>
        </div>
        <div class="col-md-2">
          <%= link_to 'ptsc/fare_rules', class: 'btn btn-outline-info w-100' do %>
            <i class="fas fa-ticket-alt me-1"></i> Fare Rules
          <% end %>
        </div>
        <div class="col-md-2">
          <%= link_to '#', class: 'btn btn-outline-secondary w-100' do %>
            <i class="fas fa-print me-1"></i> Daily Report
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>