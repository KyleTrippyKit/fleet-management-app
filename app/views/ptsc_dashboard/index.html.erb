<%# app/views/ptsc_dashboard/index.html.erb %>

<!-- External Libraries -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<!-- ADD THIS: Disable Turbo for time range buttons -->
<%= turbo_frame_tag :dashboard_content, data: { turbo: false } do %>
  <div class="min-h-screen bg-light">
    <!-- Header (all roles) -->
    <%= render 'ptsc_dashboard/header', 
          vehicle_stats: @vehicle_stats, 
          usage_stats: @usage_stats %>

    <div class="container-fluid px-4 py-4">
      <!-- Navigation -->
      <div class="mb-4">
        <%= render 'ptsc_dashboard/nav', current_user: current_user %>
      </div>

      <!-- ===== Key Metrics ===== -->
      <% if @show_metrics %>
        <%= render 'ptsc_dashboard/stats_cards', 
              vehicle_stats: @vehicle_stats, 
              usage_stats: @usage_stats, 
              maintenance_stats: @maintenance_stats,
              insurance_stats: @insurance_stats %>
      <% end %>

      <!-- ===== Charts with Time Filter ===== -->
      <% if @show_charts %>
        <div class="row g-4 mb-5">
          <!-- Chart Filter Controls -->
          <div class="col-12">
            <div class="card mb-4">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="card-title mb-0">
                    <i class="bi bi-funnel me-2"></i>Chart Time Range
                  </h6>
                  <div class="btn-group" role="group">
                    <!-- FIX: Add data-turbo="false" to all time range buttons -->
                    <%= link_to "Week", ptsc_dashboard_path(time_range: 'week'), 
                        class: "btn btn-outline-primary #{'active' if params[:time_range] == 'week' || params[:time_range].blank?}",
                        data: { turbo: false } %>
                    <%= link_to "Month", ptsc_dashboard_path(time_range: 'month'), 
                        class: "btn btn-outline-primary #{'active' if params[:time_range] == 'month'}",
                        data: { turbo: false } %>
                    <%= link_to "3 Months", ptsc_dashboard_path(time_range: 'three_months'), 
                        class: "btn btn-outline-primary #{'active' if params[:time_range] == 'three_months'}",
                        data: { turbo: false } %>
                    <%= link_to "Year", ptsc_dashboard_path(time_range: 'year'), 
                        class: "btn btn-outline-primary #{'active' if params[:time_range] == 'year'}",
                        data: { turbo: false } %>
                  </div>
                </div>
                <div class="mt-2 text-muted small">
                  <% time_range_label = case @time_range
                       when 'week' then 'Week (Daily View)'
                       when 'month' then 'Month (Weekly View)'
                       when 'three_months' then 'Last 3 Months (Monthly View)'
                       when 'year' then 'Year (Quarterly View)'
                       else 'Week (Daily View)'
                     end %>
                  <i class="bi bi-info-circle me-1"></i>
                  Showing data for: <strong><%= time_range_label %></strong>
                </div>
              </div>
            </div>
          </div>

          <% if @current_role.in?([:fleet_manager, :admin]) %>
            <!-- Render the fuel efficiency chart partial -->
            <%= render 'ptsc_dashboard/fuel_efficiency_chart', 
                  usage_stats: @usage_stats,
                  time_range: @time_range %>
          <% end %>

          <!-- Render the maintenance cost chart partial -->
          <%= render 'ptsc_dashboard/maintenance_cost_chart', 
                  usage_stats: @usage_stats, 
                  maintenance_stats: @maintenance_stats,
                  time_range: @time_range %>
        </div>
      <% end %>

      <!-- ===== Invoices (Role-Based) ===== -->
      <% if @show_invoices && @recent_invoices.any? && (current_user.admin? || current_user.finance? || current_user.fleet_manager?) %>
        <div class="row mb-5">
          <div class="col-12">
            <%= render 'ptsc_dashboard/recent_invoices', invoices: @recent_invoices %>
          </div>
        </div>
      <% end %>

      <!-- ===== Fleet Map ===== -->
      <% if @show_map %>
        <div class="card border-0 shadow-sm mb-5 bg-primary bg-opacity-5">
          <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
              <h6 class="fw-bold mb-0 d-flex align-items-center">
                <i class="bi bi-geo-alt text-primary me-2"></i>
                Live Vehicle Locations
              </h6>
              <p class="text-muted small mb-0">
                <span class="badge bg-primary-subtle text-primary me-2">
                  <%= @map_vehicles&.count { |v| v.status == 'active' } || 0 %> Active
                </span>
                <span class="badge bg-warning-subtle text-warning me-2">
                  <%= @map_vehicles&.count { |v| v.status == 'maintenance' } || 0 %> In Maintenance
                </span>
              </p>
            </div>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-layers me-1"></i>Map Layers
              </button>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="changeMapLayer('standard')">Standard Map</a></li>
                <li><a class="dropdown-item" href="#" onclick="changeMapLayer('satellite')">Satellite View</a></li>
                <li><a class="dropdown-item" href="#" onclick="changeMapLayer('dark')">Dark Mode</a></li>
              </ul>
            </div>
          </div>
          <div class="card-body p-0">
            <!-- FIX: Add scroll wheel control attribute -->
            <div id="fleet-map" 
                 class="w-100" 
                 style="height: 350px;"
                 data-vehicles="<%= @map_vehicles.to_json(methods: [:id, :license_plate, :vehicle_type, :status, :make, :model, :latitude, :longitude]) %>"
                 data-map-config='{"scrollWheelZoom": false}'>
              <!-- Loading indicator -->
              <div class="h-100 w-100 d-flex align-items-center justify-content-center bg-light">
                <div class="text-center">
                  <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading map...</span>
                  </div>
                  <p class="text-muted small">Loading interactive map...</p>
                </div>
              </div>
            </div>
            <div class="p-3 border-top">
              <div class="d-flex justify-content-between align-items-center small">
                <div class="d-flex align-items-center gap-2">
                  <span class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Click on any vehicle marker for details
                  </span>
                </div>
                <div class="d-flex gap-2">
                  <button onclick="fitMapToVehicles()" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-fullscreen me-1"></i>View All
                  </button>
                  <button onclick="refreshMap()" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                  </button>
                  <!-- ADD THIS: Toggle zoom button -->
                  <button onclick="toggleMapZoom()" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-mouse me-1"></i>Toggle Scroll Zoom
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- ===== Fleet Overview / Vehicle Grid ===== -->
      <% if @show_vehicle_grid && !current_user.finance? %>
        <%= render 'ptsc_dashboard/vehicles_overview', vehicles: @vehicles, vehicle_stats: @vehicle_stats %>
      <% end %>

      <div class="row">
        <!-- Main Content -->
        <div class="<%= current_user.finance? ? 'col-12' : 'col-xxl-9 col-xl-8' %>">
          <% if @show_service_forecast %>
            <%= render 'ptsc_dashboard/service_forecast', upcoming_maintenances: @upcoming_maintenances %>
          <% end %>
        </div>

        <!-- Sidebar -->
        <% unless current_user.finance? %>
          <div class="col-xxl-3 col-xl-4">
            <% if @vehicles_needing_attention.any? %>
              <%= render 'ptsc_dashboard/attention_needed', vehicles: @vehicles_needing_attention %>
            <% end %>

            <%# if current_user.driver? && @driver_stats.present? %>
                  <%#= render 'ptsc_dashboard/driver_stats', driver_stats: @driver_stats %>
            <%# end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- ===== Dashboard JavaScript ===== -->
<script>
// Global map variables
let fleetMap = null;
let mapMarkers = [];
let currentTileLayer = null;
let scrollWheelZoomEnabled = false; // Start with scroll zoom disabled

// Initialize tooltips
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Bootstrap tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
  
  console.log('DOM loaded, initializing dashboard...');
  initCharts();
  initMap();
});

// Also listen for Turbo events
document.addEventListener('turbo:load', function() {
  console.log('Turbo loaded, initializing dashboard...');
  initCharts();
  initMap();
});

// FIX: Force page reload when time range changes
document.addEventListener('click', function(e) {
  // Check if clicked element is a time range button
  const timeRangeBtn = e.target.closest('.btn-group .btn-outline-primary');
  if (timeRangeBtn && timeRangeBtn.hasAttribute('href')) {
    // Allow normal navigation (disable Turbo for these buttons)
    e.preventDefault();
    window.location.href = timeRangeBtn.getAttribute('href');
  }
});

// Initialize all charts
function initCharts() {
  console.log('Initializing charts...');
  
  // Check if Chart.js is loaded
  if (typeof Chart === 'undefined') {
    console.error('Chart.js not loaded');
    return;
  }
  
  // Initialize fuel chart if it exists
  initFuelChart();
  
  // Initialize maintenance cost chart if it exists
  initMaintenanceChart();
}

// Initialize fuel efficiency chart
function initFuelChart() {
  const fuelCanvas = document.getElementById('fuelEfficiencyChart');
  if (!fuelCanvas) {
    console.log('Fuel chart canvas not found');
    return;
  }
  
  // Hide fallback if it exists
  const fallback = document.getElementById('fuelChartFallback');
  if (fallback) fallback.style.display = 'none';
  
  // Get data from data attributes
  const labels = JSON.parse(fuelCanvas.dataset.labels || '[]');
  const efficiencyData = JSON.parse(fuelCanvas.dataset.efficiency || '[]');
  
  // If no data, show fallback message
  if (labels.length === 0 || efficiencyData.length === 0) {
    if (fallback) {
      fallback.style.display = 'block';
      fallback.innerHTML = '<div class="text-center"><i class="bi bi-bar-chart text-muted fs-1 mb-2"></i><p class="text-muted small">No data available for selected time range</p></div>';
    }
    return;
  }
  
  const ctx = fuelCanvas.getContext('2d');
  
  // Create gradient
  const gradient = ctx.createLinearGradient(0, 0, 0, 200);
  gradient.addColorStop(0, 'rgba(26, 115, 232, 0.3)');
  gradient.addColorStop(1, 'rgba(26, 115, 232, 0.05)');
  
  try {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Fuel Efficiency (km/L)',
          data: efficiencyData,
          backgroundColor: gradient,
          borderColor: '#1a73e8',
          borderWidth: 3,
          fill: true,
          tension: 0.3,
          pointBackgroundColor: '#1a73e8',
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(255,255,255,0.95)',
            titleColor: '#333',
            bodyColor: '#666',
            borderColor: '#ddd',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 6,
            displayColors: false,
            callbacks: {
              title: function(context) {
                return context[0].label;
              },
              label: function(context) {
                return `Efficiency: ${context.parsed.y} km/L`;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: false,
            grid: { color: 'rgba(0,0,0,0.05)' },
            ticks: {
              font: { size: 11 }
            }
          },
          x: {
            grid: { display: false },
            ticks: { font: { size: 11 } }
          }
        }
      }
    });
    console.log('Fuel chart created successfully with data:', efficiencyData);
  } catch (error) {
    console.error('Error creating fuel chart:', error);
    // Show fallback if chart fails
    if (fallback) {
      fallback.style.display = 'block';
      fallback.innerHTML = '<div class="text-center"><i class="bi bi-exclamation-triangle text-warning fs-1 mb-2"></i><p class="text-muted small">Chart failed to load</p></div>';
    }
  }
}

// Initialize maintenance cost chart
function initMaintenanceChart() {
  const costCanvas = document.getElementById('maintenanceCostChart');
  if (!costCanvas) {
    console.log('Maintenance cost chart canvas not found');
    return;
  }
  
  // Hide fallback if it exists
  const fallback = document.getElementById('costChartFallback');
  if (fallback) fallback.style.display = 'none';
  
  // Get data from data attributes
  const labels = JSON.parse(costCanvas.dataset.labels || '[]');
  const costData = JSON.parse(costCanvas.dataset.costs || '[]');
  
  // If no data, show fallback message
  if (labels.length === 0 || costData.length === 0) {
    if (fallback) {
      fallback.style.display = 'block';
      fallback.innerHTML = '<div class="text-center"><i class="bi bi-bar-chart text-muted fs-1 mb-2"></i><p class="text-muted small">No data available for selected time range</p></div>';
    }
    return;
  }
  
  const ctx = costCanvas.getContext('2d');
  
  try {
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Maintenance Cost ($)',
          data: costData,
          backgroundColor: 'rgba(25, 135, 84, 0.6)',
          borderColor: 'rgba(25, 135, 84, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(255,255,255,0.95)',
            titleColor: '#333',
            bodyColor: '#666',
            borderColor: '#ddd',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 6,
            displayColors: false,
            callbacks: {
              title: function(context) {
                return context[0].label;
              },
              label: function(context) {
                return `Cost: $${context.parsed.y.toLocaleString()}`;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(0,0,0,0.05)' },
            ticks: {
              callback: function(value) {
                return '$' + value.toLocaleString();
              },
              font: { size: 11 }
            }
          },
          x: {
            grid: { display: false },
            ticks: { font: { size: 11 } }
          }
        }
      }
    });
    console.log('Maintenance cost chart created successfully with data:', costData);
  } catch (error) {
    console.error('Error creating maintenance cost chart:', error);
    // Show fallback if chart fails
    if (fallback) {
      fallback.style.display = 'block';
      fallback.innerHTML = '<div class="text-center"><i class="bi bi-exclamation-triangle text-warning fs-1 mb-2"></i><p class="text-muted small">Chart failed to load</p></div>';
    }
  }
}

// Initialize map with scroll wheel fix
function initMap() {
  const mapElement = document.getElementById('fleet-map');
  if (!mapElement || typeof L === 'undefined') return;
  
  console.log('Initializing interactive map...');
  
  try {
    // Clear existing map if any
    if (fleetMap) {
      fleetMap.remove();
      mapMarkers = [];
    }
    
    // Get vehicle data from data attribute
    const vehiclesData = JSON.parse(mapElement.dataset.vehicles || '[]');
    console.log(`Loading ${vehiclesData.length} vehicles on map`);
    
    // Get map config
    const mapConfig = JSON.parse(mapElement.dataset.mapConfig || '{}');
    scrollWheelZoomEnabled = mapConfig.scrollWheelZoom || false;
    
    // Create map with scroll wheel zoom disabled by default
    fleetMap = L.map('fleet-map', {
      scrollWheelZoom: scrollWheelZoomEnabled, // FIX: Control this
      wheelDebounceTime: 100,
      wheelPxPerZoomLevel: 60
    }).setView([10.654, -61.501], 12);
    
    // FIX: Add event listeners to prevent scroll zoom when mouse leaves map
    fleetMap.on('mouseout', function() {
      fleetMap.scrollWheelZoom.disable();
    });
    
    fleetMap.on('mouseover', function() {
      if (scrollWheelZoomEnabled) {
        fleetMap.scrollWheelZoom.enable();
      }
    });
    
    // Set up default tile layer
    changeMapLayer('standard');
    
    // Create custom vehicle icons
    const vehicleIcons = {
      active: L.divIcon({
        html: '<div class="vehicle-marker active"><i class="bi bi-truck"></i></div>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      }),
      maintenance: L.divIcon({
        html: '<div class="vehicle-marker maintenance"><i class="bi bi-wrench"></i></div>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      }),
      available: L.divIcon({
        html: '<div class="vehicle-marker available"><i class="bi bi-check-circle"></i></div>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      }),
      default: L.divIcon({
        html: '<div class="vehicle-marker default"><i class="bi bi-car-front"></i></div>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      })
    };
    
    // Add vehicle markers
    const bounds = [];
    mapMarkers = [];
    
    vehiclesData.forEach(vehicle => {
      if (vehicle.latitude && vehicle.longitude) {
        const latLng = [vehicle.latitude, vehicle.longitude];
        bounds.push(latLng);
        
        // Determine which icon to use based on status
        let icon;
        if (vehicle.status === 'active') {
          icon = vehicleIcons.active;
        } else if (vehicle.status === 'maintenance') {
          icon = vehicleIcons.maintenance;
        } else if (vehicle.status === 'available') {
          icon = vehicleIcons.available;
        } else {
          icon = vehicleIcons.default;
        }
        
        // Create marker with custom icon
        const marker = L.marker(latLng, { icon: icon })
          .addTo(fleetMap)
          .bindPopup(createVehiclePopup(vehicle));
        
        // Add click event to go to vehicle page
        marker.on('click', function(e) {
          // Store reference for potential double-click handling
          if (window.lastClickedMarker === marker) {
            // Double click - go to vehicle page
            window.location.href = `/vehicles/${vehicle.id}`;
          } else {
            window.lastClickedMarker = marker;
            setTimeout(() => { window.lastClickedMarker = null; }, 300);
            e.target.openPopup();
          }
        });
        
        // Add hover effect
        marker.on('mouseover', function() {
          this.openPopup();
        });
        
        marker.on('mouseout', function() {
          setTimeout(() => {
            if (!this._popup || !this._popup.isOpen) return;
            this.closePopup();
          }, 100);
        });
        
        mapMarkers.push(marker);
      }
    });
    
    // Fit map bounds to show all vehicles
    if (bounds.length > 0) {
      fleetMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });
    } else {
      // Default view if no vehicles
      fleetMap.setView([10.654, -61.501], 12);
    }
    
    // Add legend
    addMapLegend();
    
    // Add scale control
    L.control.scale({ position: 'bottomleft', metric: true, imperial: false }).addTo(fleetMap);
    
    console.log(`Map initialized with ${mapMarkers.length} vehicles, scroll zoom: ${scrollWheelZoomEnabled}`);
    
  } catch (error) {
    console.error('Error initializing map:', error);
    
    // Show error message in map container
    mapElement.innerHTML = `
      <div class="h-100 d-flex flex-column align-items-center justify-content-center bg-light">
        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-3"></i>
        <p class="text-muted mb-2">Unable to load map</p>
        <button onclick="initMap()" class="btn btn-sm btn-outline-primary mt-2">
          <i class="bi bi-arrow-clockwise me-1"></i>Retry
        </button>
      </div>
    `;
  }
}

// NEW FUNCTION: Toggle scroll zoom
function toggleMapZoom() {
  if (!fleetMap) return;
  
  scrollWheelZoomEnabled = !scrollWheelZoomEnabled;
  
  if (scrollWheelZoomEnabled) {
    fleetMap.scrollWheelZoom.enable();
    showToast('Scroll zoom enabled', 'success');
  } else {
    fleetMap.scrollWheelZoom.disable();
    showToast('Scroll zoom disabled', 'warning');
  }
  
  // Update button text
  const zoomBtn = document.querySelector('button[onclick="toggleMapZoom()"]');
  if (zoomBtn) {
    zoomBtn.innerHTML = scrollWheelZoomEnabled 
      ? '<i class="bi bi-mouse-fill me-1"></i>Scroll Zoom ON'
      : '<i class="bi bi-mouse me-1"></i>Scroll Zoom OFF';
    zoomBtn.className = scrollWheelZoomEnabled
      ? 'btn btn-sm btn-success'
      : 'btn btn-sm btn-outline-warning';
  }
}

// Helper function to show toast
function showToast(message, type = 'info') {
  const toastId = 'map-toast-' + Date.now();
  const toastHtml = `
    <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          ${message}
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  `;
  
  // Create or get toast container
  let toastContainer = document.getElementById('map-toast-container');
  if (!toastContainer) {
    toastContainer = document.createElement('div');
    toastContainer.id = 'map-toast-container';
    toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
    document.body.appendChild(toastContainer);
  }
  
  toastContainer.insertAdjacentHTML('beforeend', toastHtml);
  const toastEl = document.getElementById(toastId);
  const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
  toast.show();
  
  // Remove after hiding
  toastEl.addEventListener('hidden.bs.toast', function () {
    toastEl.remove();
  });
}

// Helper function to create vehicle popup HTML
function createVehiclePopup(vehicle) {
  const statusBadge = vehicle.status === 'active' 
    ? '<span class="badge bg-success">Active</span>'
    : vehicle.status === 'maintenance'
    ? '<span class="badge bg-warning text-dark">Maintenance</span>'
    : vehicle.status === 'available'
    ? '<span class="badge bg-info text-white">Available</span>'
    : '<span class="badge bg-secondary">Inactive</span>';
  
  const vehicleTypeIcon = getVehicleTypeIcon(vehicle.vehicle_type);
  
  return `
    <div class="vehicle-popup" style="min-width: 220px;">
      <div class="d-flex align-items-center mb-2">
        <div class="me-2">
          ${vehicleTypeIcon}
        </div>
        <div>
          <h6 class="mb-0 fw-bold">${vehicle.license_plate || 'No Plate'}</h6>
          <small class="text-muted">${vehicle.make || ''} ${vehicle.model || ''}</small>
        </div>
      </div>
      <div class="mb-2">${statusBadge}</div>
      <div class="d-grid gap-1">
        <a href="/vehicles/${vehicle.id}" 
           class="btn btn-sm btn-primary" 
           onclick="event.stopPropagation();">
          <i class="bi bi-eye me-1"></i>View Details
        </a>
        <button onclick="window.location.href='/vehicles/${vehicle.id}'" 
                class="btn btn-sm btn-outline-primary">
          <i class="bi bi-arrow-right me-1"></i>Go to Vehicle
        </button>
      </div>
    </div>
  `;
}

// Helper function to get vehicle type icon
function getVehicleTypeIcon(vehicleType) {
  const icons = {
    'bus': 'bi-bus-front',
    'truck': 'bi-truck',
    'van': 'bi-van',
    'car': 'bi-car-front',
    'minibus': 'bi-bus',
    'motorcycle': 'bi-bicycle',
    'trailer': 'bi-truck-flatbed'
  };
  
  const iconClass = icons[vehicleType?.toLowerCase()] || 'bi-car-front';
  return `<i class="bi ${iconClass} fs-4 text-primary"></i>`;
}

// Add legend to map
function addMapLegend() {
  if (!fleetMap) return;
  
  const legend = L.control({ position: 'bottomright' });
  
  legend.onAdd = function(map) {
    const div = L.DomUtil.create('div', 'info legend bg-white p-3 rounded shadow-sm border');
    div.style.width = '180px';
    div.innerHTML = `
      <h6 class="mb-2 border-bottom pb-2"><i class="bi bi-legend me-1"></i>Vehicle Status</h6>
      <div class="d-flex flex-column gap-2">
        <div class="d-flex align-items-center">
          <div class="vehicle-marker-legend active me-2"></div>
          <span class="small">Active (${getVehicleCountByStatus('active')})</span>
        </div>
        <div class="d-flex align-items-center">
          <div class="vehicle-marker-legend maintenance me-2"></div>
          <span class="small">Maintenance (${getVehicleCountByStatus('maintenance')})</span>
        </div>
        <div class="d-flex align-items-center">
          <div class="vehicle-marker-legend available me-2"></div>
          <span class="small">Available (${getVehicleCountByStatus('available')})</span>
        </div>
      </div>
      <div class="mt-2 pt-2 border-top small text-muted">
        <i class="bi bi-mouse me-1"></i>
        Click marker for details
      </div>
    `;
    return div;
  };
  
  legend.addTo(fleetMap);
}

// Get vehicle count by status
function getVehicleCountByStatus(status) {
  const mapElement = document.getElementById('fleet-map');
  if (!mapElement) return 0;
  
  const vehiclesData = JSON.parse(mapElement.dataset.vehicles || '[]');
  return vehiclesData.filter(v => v.status === status).length;
}

// Change map tile layer
function changeMapLayer(layerType) {
  if (!fleetMap) return;
  
  // Remove existing tile layer
  if (currentTileLayer) {
    fleetMap.removeLayer(currentTileLayer);
  }
  
  let tileUrl, attribution;
  
  switch(layerType) {
    case 'satellite':
      tileUrl = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}';
      attribution = 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community';
      break;
    case 'dark':
      tileUrl = 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png';
      attribution = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>';
      break;
    default: // standard
      tileUrl = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
      attribution = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';
  }
  
  currentTileLayer = L.tileLayer(tileUrl, {
    attribution: attribution,
    maxZoom: 19
  }).addTo(fleetMap);
  
  // Update active dropdown item
  document.querySelectorAll('.dropdown-item').forEach(item => {
    item.classList.remove('active');
    if (item.textContent.includes(layerType.charAt(0).toUpperCase() + layerType.slice(1))) {
      item.classList.add('active');
    }
  });
}

// Fit map to show all vehicles
function fitMapToVehicles() {
  if (!fleetMap || mapMarkers.length === 0) return;
  
  const bounds = L.latLngBounds(mapMarkers.map(marker => marker.getLatLng()));
  fleetMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });
}

// Refresh map data
function refreshMap() {
  console.log('Refreshing map data...');
  // In a real app, you would fetch fresh data from the server
  // For now, just reinitialize
  initMap();
}

// Debug helper
console.log('Dashboard JavaScript loaded successfully');
</script>

