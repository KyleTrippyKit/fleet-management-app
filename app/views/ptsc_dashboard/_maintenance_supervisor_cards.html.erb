# app/views/ptsc_dashboard/_maintenance_supervisor_cards.html.erb
<!-- Maintenance Supervisor Dashboard Cards -->
<div class="row g-3 mb-5">
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-warning bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-tools text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">PENDING MAINTENANCE</p>
            <h3 class="fw-bold mb-1"><%= @maintenance_stats[:pending] %></h3>
            <p class="text-muted small mb-0">Require attention</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-danger bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-danger bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-danger mb-1 tracking-wider">OVERDUE</p>
            <h3 class="fw-bold mb-1 text-danger"><%= @maintenance_stats[:overdue] %></h3>
            <p class="text-danger small fw-medium mb-0">Immediate action</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-info bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-info bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-hourglass-split text-info fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">IN PROGRESS</p>
            <h3 class="fw-bold mb-1"><%= @maintenance_stats[:in_progress] %></h3>
            <p class="text-muted small mb-0">Current work</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-success bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-calendar-check text-success fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">UPCOMING</p>
            <h3 class="fw-bold mb-1"><%= @maintenance_stats[:upcoming] %></h3>
            <p class="text-muted small mb-0">Next 30 days</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>