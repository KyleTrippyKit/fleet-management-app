<%# app/views/ptsc_dashboard/_fuel_efficiency_chart.html.erb %>
<div class="col-xxl-6">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header bg-white border-0 py-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h6 class="mb-0"><i class="bi bi-fuel-pump text-primary me-2"></i>Fuel Efficiency</h6>
          <p class="text-muted small mb-0">
            <% time_range_label = case @time_range
                 when 'week' then 'Daily'
                 when 'month' then 'Weekly'
                 when 'three_months' then 'Monthly'
                 when 'year' then 'Quarterly'
                 else 'Weekly'
               end %>
            <%= time_range_label %> consumption trend
          </p>
        </div>
      </div>
    </div>

    <div class="card-body p-3">
      <%# Use time-range specific data if available, otherwise fall back %>
      <% if @fuel_efficiency_data.present? && @fuel_efficiency_data[:labels].present? && @fuel_efficiency_data[:data].present? %>
        <% chart_labels = @fuel_efficiency_data[:labels] %>
        <% chart_data = @fuel_efficiency_data[:data] %>
      <% else %>
        <%# Fallback to default data %>
        <% chart_labels = @usage_stats[:weekly_labels] || ['Week 1','Week 2','Week 3','Week 4'] %>
        <% chart_data = @usage_stats[:weekly_efficiency] || Array.new(chart_labels.size, 8.2) %>
      <% end %>
      
      <% total_distance = @usage_stats[:total_distance].to_f %>
      <% total_fuel = @usage_stats[:total_fuel_liters].to_f %>
      <% avg_efficiency = total_fuel.nonzero? ? (total_distance / total_fuel) : (chart_data.sum / chart_data.size) %>
      
      <%# Store chart data in data attributes for JavaScript to access %>
      <div class="chart-container position-relative" style="height: 200px;">
        <canvas id="fuelEfficiencyChart" 
                data-labels="<%= chart_labels.to_json %>"
                data-efficiency="<%= chart_data.to_json %>"
                data-avg-efficiency="<%= avg_efficiency %>"
                data-total-fuel="<%= total_fuel %>">
        </canvas>
        <div id="fuelChartFallback" class="chart-placeholder">
          <div class="text-center">
            <i class="bi bi-bar-chart fs-1 text-muted mb-2"></i>
            <p class="text-muted small">Loading fuel efficiency chart...</p>
          </div>
        </div>
      </div>

      <div class="mt-3 d-flex justify-content-between small">
        <span class="text-muted">
          Avg Efficiency: <strong>
            <%= number_with_precision(avg_efficiency, precision: 1) %> km/L
          </strong>
        </span>
        <span class="text-muted">
          Total Consumption: <strong><%= number_with_precision(total_fuel, precision: 0) %> L</strong>
        </span>
      </div>
    </div>
  </div>
</div>