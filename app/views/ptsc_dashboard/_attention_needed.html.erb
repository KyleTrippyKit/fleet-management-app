<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 py-3">
    <h6 class="mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Attention Needed</h6>
  </div>
  <div class="card-body p-0">
    <div class="list-group list-group-flush">
      <% vehicles.each do |vehicle| %>
        <a href="<%= vehicle_path(vehicle) %>" class="list-group-item list-group-item-action border-0 py-3">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            </div>
            <div class="flex-grow-1 ms-3">
              <h6 class="mb-1"><%= vehicle.display_name %></h6>
              <p class="text-muted small mb-0">
                <%= vehicle.service_owner %> • <%= vehicle.registration_number.presence || 'No Plate' %>
              </p>
            </div>
            <div class="flex-shrink-0">
              <i class="bi bi-chevron-right text-muted"></i>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</div>
