# app/views/ptsc_dashboard/_fleet_manager_cards.html.erb
<!-- Fleet Manager Dashboard Cards -->
<div class="row g-3 mb-5">
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-blue-100 p-3 rounded me-3">
            <i class="bi bi-signpost text-primary fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">TOTAL DISTANCE</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@usage_stats[:total_distance]) %> km</h3>
            <p class="text-muted small mb-0 d-flex align-items-center">
              <i class="bi bi-arrow-up text-success me-1"></i>
              Avg: <%= number_with_delimiter(@vehicle_stats[:total_vehicles] > 0 ? (@usage_stats[:total_distance].to_f / @vehicle_stats[:total_vehicles]) : 0) %> km/vehicle
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-green-100 p-3 rounded me-3">
            <i class="bi bi-clock text-success fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">TOTAL HOURS</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@usage_stats[:total_hours]) %> hrs</h3>
            <p class="text-muted small mb-0">Last 30 days</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-amber-100 p-3 rounded me-3">
            <i class="bi bi-graph-up-arrow text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">AVG UTILIZATION</p>
            <h3 class="fw-bold mb-1"><%= @usage_stats[:average_utilization] %>%</h3>
            <div class="d-flex gap-1 mt-1">
              <span class="badge bg-success text-white" style="font-size: 0.65rem; padding: 0.15rem 0.35rem;">High</span>
              <span class="badge bg-warning text-dark" style="font-size: 0.65rem; padding: 0.15rem 0.35rem;">Med</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-danger bg-opacity-10 border-start border-danger border-4">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-danger bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-danger mb-1 tracking-wider">CRITICAL ALERTS</p>
            <h3 class="fw-bold mb-1 text-danger"><%= @maintenance_stats[:overdue] %></h3>
            <p class="text-danger small fw-medium mb-0">Action Required</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Active vs Inactive Vehicles Card (Fleet Manager only) -->
<div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
  <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
    <div class="card-body p-3">
      <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 p-3 rounded me-3">
          <i class="bi bi-truck text-info fs-4"></i>
        </div>
        <div class="flex-grow-1">
          <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">FLEET STATUS</p>
          <h3 class="fw-bold mb-1"><%= @vehicle_stats[:active_vehicles] %>/<%= @vehicle_stats[:total_vehicles] %></h3>
          <p class="text-muted small mb-0"><%= (@vehicle_stats[:total_vehicles] > 0 ? (@vehicle_stats[:active_vehicles].to_f / @vehicle_stats[:total_vehicles] * 100).round(1) : 0) %>% Active</p>
        </div>
      </div>
    </div>
  </div>
</div>