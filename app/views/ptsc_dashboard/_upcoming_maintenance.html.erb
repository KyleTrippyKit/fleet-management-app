<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 py-3">
    <h6 class="mb-0"><i class="bi bi-calendar-check text-warning me-2"></i>Upcoming Maintenance</h6>
  </div>
  <div class="card-body p-0">
    <% upcoming_maintenances ||= [] %>
    <% if upcoming_maintenances.any? %>
      <div class="list-group list-group-flush">
        <% upcoming_maintenances.first(5).each do |m| %>
          <a href="<%= vehicle_path(m.vehicle) %>" class="list-group-item list-group-item-action border-0 py-3">
            <div class="d-flex align-items-center">
              <i class="bi bi-calendar-date text-warning fs-5 me-3"></i>
              <div class="flex-grow-1">
                <h6 class="mb-1"><%= m.vehicle.display_name %></h6>
                <p class="text-muted small mb-0"><%= m.service_type %> • Due: <%= m.next_due_date&.strftime("%b %d, %Y") || "N/A" %></p>
              </div>
              <span class="badge <%= m.status == 'pending' ? 'bg-warning' : 'bg-info' %>"><%= m.status.titleize %></span>
            </div>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-check-circle fs-1 mb-2"></i>
        <p>No upcoming maintenance</p>
      </div>
    <% end %>
  </div>

  <% if upcoming_maintenances.size > 5 %>
    <div class="card-footer bg-white border-0 pt-0">
      <%= link_to agency_maintenance_path(current_user.agency, service_owner: 'PTSC'), class: "btn btn-sm btn-outline-primary w-100" do %>
        View All
      <% end %>
    </div>
  <% end %>
</div>
