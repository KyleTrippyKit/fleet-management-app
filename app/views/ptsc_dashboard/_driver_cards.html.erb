<div class="row g-3 mb-5">
  <% @driver_stats ||= {} %>

  <!-- Distance Driven -->
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-signpost text-primary fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">DISTANCE DRIVEN</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@driver_stats[:total_distance] || 0) %> km</h3>
            <p class="text-muted small mb-0">Last 30 days</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hours Driven -->
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-clock text-success fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">HOURS DRIVEN</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@driver_stats[:total_hours] || 0) %> hrs</h3>
            <p class="text-muted small mb-0">Last 30 days</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Trips -->
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-info bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-car-front text-info fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">TRIPS</p>
            <h3 class="fw-bold mb-1"><%= @driver_stats[:total_trips] || 0 %></h3>
            <p class="text-muted small mb-0">Completed trips</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Alerts -->
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-warning bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">ALERTS</p>
            <h3 class="fw-bold mb-1"><%= @driver_stats[:alerts] || 0 %></h3>
            <p class="text-muted small mb-0">Vehicle notices</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
