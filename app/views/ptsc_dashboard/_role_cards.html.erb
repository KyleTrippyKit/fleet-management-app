<%# app/views/ptsc_dashboard/_role_cards.html.erb %>
<div class="row g-3 mb-4">
  <% if current_user.fleet_manager? || current_user.admin? %>
    <!-- Fleet Manager Cards -->
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-truck text-primary fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Total Vehicles</p>
              <h3 class="fw-bold mb-0"><%= @vehicle_stats[:total_vehicles] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-signpost text-success fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Distance (30 days)</p>
              <h3 class="fw-bold mb-0"><%= @usage_stats[:total_distance] %> km</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Overdue Maintenance</p>
              <h3 class="fw-bold mb-0"><%= @maintenance_stats[:overdue] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-info bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-graph-up text-info fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Utilization</p>
              <h3 class="fw-bold mb-0"><%= @usage_stats[:average_utilization] %>%</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  <% elsif current_user.maintenance_supervisor? %>
    <!-- Maintenance Supervisor Cards -->
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-tools text-warning fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Pending</p>
              <h3 class="fw-bold mb-0"><%= @maintenance_stats[:pending] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-danger bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Overdue</p>
              <h3 class="fw-bold mb-0"><%= @maintenance_stats[:overdue] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-info bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-hourglass-split text-info fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">In Progress</p>
              <h3 class="fw-bold mb-0"><%= @maintenance_stats[:in_progress] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-calendar-check text-success fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Upcoming</p>
              <h3 class="fw-bold mb-0"><%= @maintenance_stats[:upcoming] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  <% elsif current_user.finance? %>
    <!-- Finance Cards -->
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-cash-stack text-primary fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Monthly Spend</p>
              <h3 class="fw-bold mb-0">$<%= @invoice_stats[:monthly_total] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-clock-history text-warning fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Pending</p>
              <h3 class="fw-bold mb-0"><%= @invoice_stats[:pending_count] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-danger bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Overdue</p>
              <h3 class="fw-bold mb-0"><%= @invoice_stats[:overdue_count] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-check-circle text-success fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Paid</p>
              <h3 class="fw-bold mb-0"><%= @invoice_stats[:paid_count] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  <% elsif current_user.driver? %>
    <!-- Driver Cards -->
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-signpost text-primary fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Distance Driven</p>
              <h3 class="fw-bold mb-0"><%= @driver_stats[:total_distance] %> km</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-clock text-success fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Hours Driven</p>
              <h3 class="fw-bold mb-0"><%= @driver_stats[:total_hours] %> hrs</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-info bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-car-front text-info fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Trips</p>
              <h3 class="fw-bold mb-0"><%= @driver_stats[:total_trips] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Alerts</p>
              <h3 class="fw-bold mb-0"><%= @driver_stats[:alerts] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  <% else %>
    <!-- Default Cards -->
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-truck text-primary fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Total Vehicles</p>
              <h3 class="fw-bold mb-0"><%= @vehicle_stats[:total_vehicles] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-check-circle text-success fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Available</p>
              <h3 class="fw-bold mb-0"><%= @vehicle_stats[:available_vehicles] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-tools text-warning fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">In Maintenance</p>
              <h3 class="fw-bold mb-0"><%= @vehicle_stats[:in_maintenance] %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="bg-info bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-person-badge text-info fs-4"></i>
            </div>
            <div>
              <p class="text-muted mb-1">Your Role</p>
              <h3 class="fw-bold mb-0"><%= current_user.role_name %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>