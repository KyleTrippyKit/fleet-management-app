<div class="card border-0 shadow-sm mb-5">
  <div class="card-body p-3">
    <%= form_with url: ptsc_dashboard_path, method: :get, local: true,
          html: { id: "ptsc_vehicles_filter_form", 
                  class: "row g-3 align-items-center", 
                  data: { turbo_action: "replace", turbo_frame: "vehicles_list" } } do |f| %>
      
      <div class="col-xl-5 col-lg-6 col-md-7">
        <div class="input-group">
          <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
          <%= f.text_field :query,
                value: query,
                class: "form-control border-0 bg-light",
                placeholder: "Search fleet by make, model, or license plate..." %>
        </div>
      </div>
      
      <div class="col-xl-3 col-lg-4 col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-light border-0"><i class="bi bi-filter text-muted"></i></span>
          <%= f.select :status, 
                options_for_select([['All Statuses', ''], ['Active', 'active'], ['Maintenance', 'maintenance'], ['Available', 'available']], params[:status]),
                {},
                class: "form-select border-0 bg-light" %>
        </div>
      </div>
      
      <div class="col-xl-4 col-lg-12">
        <div class="d-flex gap-2 align-items-center justify-content-end">
          <%= f.submit "Filter Fleet", class: "btn btn-primary px-4 fw-bold" %>
          
          <div class="btn-group p-1 bg-light rounded" role="group">
            <button type="button" class="btn btn-sm btn-white shadow-sm active" data-view="grid">
              <i class="bi bi-grid-fill"></i>
            </button>
            <button type="button" class="btn btn-sm btn-light text-muted" data-view="list">
              <i class="bi bi-list-task"></i>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>