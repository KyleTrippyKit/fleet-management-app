<%# ======================================= %>
<%# Fleet Overview / Vehicle Grid           %>
<%# ======================================= %>

<% vehicles ||= [] %>
<% vehicle_stats ||= {} %>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-semibold">
          <i class="bi bi-truck-front-fill me-2 text-primary"></i>
          Fleet Overview
        </h5>
        <small class="text-muted">
          Current operational vehicles
        </small>
      </div>

      <span class="badge bg-primary-subtle text-primary">
        <%= vehicles.count %> Vehicles
      </span>
    </div>
  </div>

  <div class="card-body">
    <% if vehicles.any? %>
      <div class="row g-3">
        <% vehicles.each do |vehicle| %>
          <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm vehicle-card">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="mb-0 fw-semibold">
                    <%= vehicle.display_name %>
                  </h6>

                  <span class="badge bg-secondary-subtle text-secondary">
                    <%= vehicle.service_owner %>
                  </span>
                </div>

                <p class="text-muted small mb-2">
                  <i class="bi bi-credit-card-2-front me-1"></i>
                  <%= vehicle.registration_number.presence || 'No Plate Assigned' %>
                </p>

                <p class="text-muted small mb-3">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= vehicle.try(:location) || 'Location Unknown' %>
                </p>

                <div class="d-flex justify-content-between align-items-center">
                  <span class="badge bg-success-subtle text-success">
                    Active
                  </span>

                  <%= link_to vehicle_path(vehicle),
                              class: "btn btn-sm btn-outline-primary" do %>
                    View
                    <i class="bi bi-chevron-right ms-1"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-truck fs-1 d-block mb-3"></i>
        <p class="mb-0 fw-semibold">No vehicles found</p>
        <small>Add vehicles to see them here</small>
      </div>
    <% end %>
  </div>
</div>
