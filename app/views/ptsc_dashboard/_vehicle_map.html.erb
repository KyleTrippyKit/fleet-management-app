<%# ================================ %>
<%# Fleet Live Map Section           %>
<%# ================================ %>

<% @vehicles ||= [] %>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <div>
      <h5 class="mb-0 fw-semibold">
        <i class="bi bi-geo-alt-fill me-2 text-primary"></i>
        Fleet Live Map
      </h5>
      <small class="text-muted">
        Real-time vehicle locations (demo)
      </small>
    </div>

    <span class="badge bg-primary-subtle text-primary">
      <%= @vehicles.count %> Vehicles
    </span>
  </div>

  <div class="card-body p-0">
    <!-- Map Placeholder -->
    <div
      id="fleet-map"
      class="w-100 d-flex align-items-center justify-content-center bg-light"
      style="height: 420px;"
    >
      <div class="text-center text-muted">
        <i class="bi bi-map fs-1 mb-3 d-block"></i>
        <p class="mb-1 fw-semibold">Live Map Coming Soon</p>
        <small>
          Vehicle GPS data will appear here
        </small>
      </div>
    </div>
  </div>
</div>
