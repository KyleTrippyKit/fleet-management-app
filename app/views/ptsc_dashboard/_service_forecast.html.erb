<%# ======================================= %>
<%# Service & Maintenance Forecast          %>
<%# ======================================= %>

<% maintenance_stats ||= {} %>

<% upcoming  = maintenance_stats[:upcoming]  || 0 %>
<% overdue   = maintenance_stats[:overdue]   || 0 %>
<% completed = maintenance_stats[:completed] || 0 %>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-semibold">
        <i class="bi bi-tools me-2 text-warning"></i>
        Service Forecast
      </h5>

      <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
        <%= upcoming %> Upcoming
      </span>
    </div>
  </div>

  <div class="card-body">
    <div class="row text-center">
      <div class="col">
        <div class="p-3 rounded bg-warning bg-opacity-10">
          <i class="bi bi-clock-history fs-4 text-warning"></i>
          <h6 class="mt-2 mb-0"><%= upcoming %></h6>
          <small class="text-muted">Upcoming</small>
        </div>
      </div>

      <div class="col">
        <div class="p-3 rounded bg-danger bg-opacity-10">
          <i class="bi bi-exclamation-circle fs-4 text-danger"></i>
          <h6 class="mt-2 mb-0"><%= overdue %></h6>
          <small class="text-muted">Overdue</small>
        </div>
      </div>

      <div class="col">
        <div class="p-3 rounded bg-success bg-opacity-10">
          <i class="bi bi-check-circle fs-4 text-success"></i>
          <h6 class="mt-2 mb-0"><%= completed %></h6>
          <small class="text-muted">Completed</small>
        </div>
      </div>
    </div>
  </div>
</div>
