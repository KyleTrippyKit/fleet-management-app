# app/views/ptsc_dashboard/_role_based_layout.html.erb
<%# This partial renders the appropriate dashboard based on user role %>

<!-- Header -->
<div class="min-h-screen bg-light">
  <!-- Enhanced Header with gradient and pattern -->
  <div class="ptsc-header py-5 text-white shadow-lg position-relative overflow-hidden">
    <div class="position-absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
    <div class="container px-4 relative z-10">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">
        <div class="d-flex align-items-center gap-4">
          <div class="bg-white p-3 rounded-circle shadow-lg">
            <i class="bi bi-bus-front text-primary fs-2"></i>
          </div>
          <div>
            <h1 class="h2 fw-bold mb-2">PTSC Fleet Operations</h1>
            <div class="d-flex align-items-center gap-3 opacity-75 small">
              <span><i class="bi bi-geo-alt me-1"></i>PTSC Headquarters</span>
              <span><i class="bi bi-truck me-1"></i><%= @vehicle_stats[:total_vehicles] %> Vehicles</span>
              <span><i class="bi bi-person-badge me-1"></i><%= current_user.role_name %></span>
            </div>
          </div>
        </div>
        <div class="d-flex gap-2">
          <%= link_to ptsc_dashboard_path, class: "btn btn-outline-light px-4" do %>
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
          <% end %>
          <% if current_user.fleet_manager? || current_user.admin? %>
            <%= link_to new_vehicle_path(service_owner: "PTSC"), class: "btn btn-light text-primary px-4 fw-bold" do %>
              <i class="bi bi-plus-circle me-2"></i>Add Vehicle
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid px-4 py-4">
    <!-- Enhanced Navigation (Role-Based) -->
    <div class="mb-4">
      <div class="card border-0 shadow-sm nav-card">
        <div class="card-body p-3">
          <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex flex-wrap gap-2">
              <%# Role-based navigation %>
              <%= render 'dashboard/navigation', user: current_user %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ROLE-BASED DASHBOARD CONTENT -->
    <% if current_user.fleet_manager? || current_user.admin? %>
      <%= render 'dashboard/fleet_manager_dashboard' %>
    <% elsif current_user.maintenance_supervisor? %>
      <%= render 'dashboard/maintenance_supervisor_dashboard' %>
    <% elsif current_user.finance? %>
      <%= render 'dashboard/finance_dashboard' %>
    <% elsif current_user.driver? %>
      <%= render 'dashboard/driver_dashboard' %>
    <% end %>
  </div>
</div>