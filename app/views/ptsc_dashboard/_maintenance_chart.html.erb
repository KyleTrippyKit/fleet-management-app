<%# app/views/ptsc_dashboard/_maintenance_chart.html.erb %>
<div class="card border-0 shadow-sm overflow-hidden">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 d-flex align-items-center">
        <i class="bi bi-cash-coin text-success me-2"></i>
        Maintenance Cost Analysis
      </h6>
    </div>
  </div>
  <div class="card-body">
    <!-- Chart container -->
    <div class="chart-container" style="height: 200px; position: relative;">
      <canvas id="maintenanceCostChart"></canvas>
      <div id="costChartFallback" class="chart-placeholder">
        <div class="text-center py-5">
          <i class="bi bi-graph-up text-muted opacity-25 display-6"></i>
          <p class="text-muted small mt-2">Cost Analysis Chart</p>
          <div class="mt-2">
            <small class="text-muted">Weekly average: $385</small> • 
            <small class="text-muted">Monthly total: $2,450</small>
          </div>
        </div>
      </div>
    </div>
    <div class="row mt-3 g-3">
      <div class="col-6">
        <div class="bg-success bg-opacity-10 p-3 rounded border border-success border-opacity-25">
          <p class="text-uppercase small fw-bold text-success mb-1">Monthly Spend</p>
          <p class="h5 fw-bold text-success mb-0">
            $<%= number_with_precision(maintenance_stats[:monthly_cost] || 2450, precision: 0) %>
          </p>
        </div>
      </div>
      <div class="col-6">
        <div class="bg-success bg-opacity-10 p-3 rounded border border-success border-opacity-25">
          <p class="text-uppercase small fw-bold text-success mb-1">Cost / km</p>
          <p class="h5 fw-bold text-success mb-0">
            $<%= number_with_precision(usage_stats[:total_distance] > 0 ? 
                ((maintenance_stats[:monthly_cost] || 2450).to_f / usage_stats[:total_distance]) : 0.18, 
                precision: 2) %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>