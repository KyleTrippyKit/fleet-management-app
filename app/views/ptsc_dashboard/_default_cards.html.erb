<%# app/views/ptsc_dashboard/_default_cards.html.erb %>
<!-- Default Dashboard Cards for users without specific role -->
<div class="row g-3 mb-5">
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-blue-100 p-3 rounded me-3">
            <i class="bi bi-truck text-primary fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">TOTAL VEHICLES</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@vehicle_stats[:total_vehicles]) %></h3>
            <p class="text-muted small mb-0">
              <%= @vehicle_stats[:active_vehicles] %> Active
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-green-100 p-3 rounded me-3">
            <i class="bi bi-check-circle text-success fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">AVAILABLE</p>
            <h3 class="fw-bold mb-1"><%= number_with_delimiter(@vehicle_stats[:available_vehicles]) %></h3>
            <p class="text-muted small mb-0">Ready for use</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift bg-warning bg-opacity-10">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-opacity-25 p-3 rounded me-3">
            <i class="bi bi-tools text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">IN MAINTENANCE</p>
            <h3 class="fw-bold mb-1"><%= @vehicle_stats[:in_maintenance] %></h3>
            <p class="text-muted small mb-0">Being serviced</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
    <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="bg-info bg-opacity-10 p-3 rounded me-3">
            <i class="bi bi-person-badge text-info fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <p class="text-uppercase small fw-bold text-dark mb-1 tracking-wider">YOUR ROLE</p>
            <h3 class="fw-bold mb-1"><%= current_user.role_name %></h3>
            <p class="text-muted small mb-0">PTSC Dashboard</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>