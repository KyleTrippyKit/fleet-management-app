<%# app/views/ptsc_dashboard/_vehicle_popup.html.erb %>
<div class="vehicle-popup">
  <div class="popup-header">
    <h6 class="mb-1"><strong><%= vehicle.make %> <%= vehicle.model %></strong></h6>
    <small class="text-muted"><%= vehicle.license_plate %></small>
  </div>
  
  <div class="popup-body">
    <p class="mb-1">
      <strong>Type:</strong> <%= vehicle.vehicle_type || 'N/A' %>
    </p>
    <p class="mb-1">
      <strong>Status:</strong> 
      <span class="badge bg-<%= vehicle.status == 'active' ? 'success' : 'warning' %>">
        <%= vehicle.status || 'Unknown' %>
      </span>
    </p>
    <p class="mb-1">
      <strong>Location:</strong> <%= vehicle.current_location || 'Unknown' %>
    </p>
    
    <% if vehicle.try(:location_name) %>
      <p class="mb-1">
        <strong>Depot:</strong> <%= vehicle.location_name %>
      </p>
    <% end %>
    
    <p class="mb-0">
      <strong>Last Updated:</strong> <%= Time.current.strftime('%I:%M %p') %>
    </p>
  </div>
  
  <div class="popup-footer mt-2">
    <%= link_to 'View Details', vehicle_path(vehicle), 
                class: 'btn btn-sm btn-outline-primary w-100' %>
  </div>
</div>

<style>
.vehicle-popup {
  min-width: 200px;
  max-width: 250px;
}

.popup-header {
  border-bottom: 1px solid #dee2e6;
  padding-bottom: 8px;
  margin-bottom: 8px;
}

.popup-body p {
  margin-bottom: 4px;
  font-size: 0.9em;
}

.popup-footer {
  border-top: 1px solid #dee2e6;
  padding-top: 8px;
}
</style>