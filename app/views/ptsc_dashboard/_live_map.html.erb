<div class="card border-0 shadow-sm mb-5 bg-primary bg-opacity-5">
  <div class="card-header bg-white border-0 py-3">
    <h6 class="fw-bold mb-0 d-flex align-items-center">
      <i class="bi bi-geo-alt text-primary me-2"></i>
      Live Vehicle Locations
    </h6>
  </div>
  <div class="card-body p-0">
    <div class="position-relative overflow-hidden" style="height: 300px;">
      <div class="position-absolute top-0 start-0 w-100 h-100 bg-light">
        <div class="position-absolute top-50 start-50 translate-middle text-center">
          <i class="bi bi-map text-muted opacity-25 display-4"></i>
          <p class="text-muted small mt-2">Live Vehicle Tracking Map</p>
        </div>
        
        <% vehicles&.first(5)&.each_with_index do |vehicle, i| %>
          <div class="position-absolute bg-primary rounded-circle border border-2 border-white shadow-sm pulse-animation"
               style="height: 12px; width: 12px; 
                      top: <%= 20 + (i * 15) %>%; 
                      left: <%= 30 + (i * 10) %>%;
                      animation-delay: <%= i * 0.5 %>s;">
            <div class="position-absolute bottom-full left-50 translate-middle-x bg-white px-2 py-1 rounded shadow-sm small fw-medium opacity-0 hover-opacity-100 transition-opacity"
                 style="white-space: nowrap; font-size: 0.7rem;">
              <%= vehicle.license_plate %>
            </div>
          </div>
        <% end %>
      </div>
      
      <div class="position-absolute bottom-3 start-3 end-3 bg-white bg-opacity-90 p-3 rounded shadow-sm backdrop-blur">
        <div class="d-flex justify-content-between align-items-center">
          <span class="small fw-medium"><%= vehicles&.count { |v| v.status == 'active' } || 0 %> Vehicles Active in Port of Spain</span>
          <span class="badge bg-primary text-white fw-bold">LIVE</span>
        </div>
      </div>
    </div>
  </div>
</div>
