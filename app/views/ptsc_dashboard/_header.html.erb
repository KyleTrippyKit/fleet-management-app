<% @vehicles ||= [] %>
<div class="ptsc-header py-5 text-white shadow-lg position-relative overflow-hidden">
  <div class="position-absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
  <div class="container px-4 relative z-10">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">
      <div class="d-flex align-items-center gap-4">
        <div class="bg-white p-3 rounded-circle shadow-lg">
          <i class="bi bi-bus-front text-primary fs-2"></i>
        </div>
        <div>
          <h1 class="h2 fw-bold mb-2">PTSC Fleet Operations</h1>
          <div class="d-flex align-items-center gap-3 opacity-75 small">
            <span><i class="bi bi-geo-alt me-1"></i>PTSC Headquarters</span>
            <span><i class="bi bi-truck me-1"></i><%= @vehicles&.count || 0 %> Vehicles</span>
            <span><i class="bi bi-speedometer2 me-1"></i>Live Map Available</span>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2">
        <%= link_to ptsc_dashboard_path, class: "btn btn-outline-light px-4" do %>
          <i class="bi bi-speedometer2 me-2"></i>Dashboard
        <% end %>
        <%= link_to new_vehicle_path(service_owner: "PTSC"), class: "btn btn-light text-primary px-4 fw-bold" do %>
          <i class="bi bi-plus-circle me-2"></i>Add Vehicle
        <% end %>
      </div>
    </div>
  </div>
</div>
