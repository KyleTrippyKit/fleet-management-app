<%# app/views/home/index.html.erb %>

<!-- Animated Background Bubbles -->
<ul class="bg-bubbles">
  <li></li>
  <li></li>
  <li></li>
  <li></li>
  <li></li>
  <li></li>
  <li></li>
</ul>

<div class="container">
  <!-- Logo and Title -->
  <div class="logo-container">
    <div class="logo-wrapper">
      <div class="logo-icon">
        <!-- Your "Active Plus" Icon -->
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="100" height="100" rx="20" fill="url(#gradient)" />
          <path d="M30 50H70M50 30V70" stroke="white" stroke-width="8" stroke-linecap="round"/>
          <circle cx="50" cy="50" r="15" stroke="white" stroke-width="3" fill="none"/>
          <defs>
            <linearGradient id="gradient" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
              <stop stop-color="#4F46E5"/>
              <stop offset="1" stop-color="#7C3AED"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="logo-text">
        <h1>ACTIVE PLUS</h1>
        <p>FLEET MANAGEMENT SYSTEM</p>
      </div>
    </div>
  </div>

  <% if current_user.present? %>
    <!-- LOGGED IN USER VIEW - Role-specific greeting -->
    <div class="user-greeting">
      Welcome back, <%= current_user.name&.split&.first || 'User' %>!
    </div>
    <div class="role-badge">
      <%= current_user.role_name %>
    </div>

    <!-- Role-specific tagline -->
    <div class="tagline">
      <% if current_user.security_gate_officer? %>
        <span>Gate Operations</span> Dashboard
      <% elsif current_user.inspector? %>
        <span>Inspection & QC</span> Dashboard
      <% elsif current_user.inventory_manager? %>
        <span>Inventory</span> Management
      <% elsif current_user.procurement? %>
        <span>Procurement</span> Dashboard
      <% elsif current_user.finance? %>
        <span>Finance & Accounting</span>
      <% elsif current_user.mechanic? %>
        <span>Workshop</span> Dashboard
      <% elsif current_user.admin? %>
        <span>System Admin</span> Dashboard
      <% else %>
        Your <span>Dashboard</span>
      <% end %>
    </div>

    <!-- CTA Buttons - Dashboard access -->
    <div class="cta-buttons">
      <%= link_to "Go to Dashboard", current_user.role_dashboard_path, class: "btn btn-primary" %>
      <%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-danger", data: { turbo: false } %>
    </div>

  <% else %>
    <!-- PUBLIC / NOT LOGGED IN VIEW - Generic marketing content -->

    <!-- Tagline -->
    <div class="tagline">
      Streamline Your<br>
      <span>Fleet Operations</span>
    </div>

    <!-- Description -->
    <div class="description">
      Complete fleet management solution for government agencies. 
      Track vehicles, manage maintenance, handle RFQs, and process 
      invoices all in one powerful platform.
    </div>

    <!-- Feature Badges -->
    <div class="feature-badges">
      <span class="badge">🚗 Real-time Tracking</span>
      <span class="badge">🔧 Maintenance</span>
      <span class="badge">📋 RFQ Management</span>
      <span class="badge">💰 Invoicing</span>
      <span class="badge">📊 Analytics</span>
    </div>

    <!-- CTA Buttons -->
    <div class="cta-buttons">
      <%= link_to "Sign In", new_user_session_path, class: "btn btn-primary" %>
      <%= link_to "Learn More", "#", class: "btn btn-outline" %>
    </div>
  <% end %>

  <!-- Trust Badges -->
  <div class="trust-badges">
    <p>Trusted by leading government agencies</p>
    <div class="badge-group">
      <span class="trust-icon">
        <svg viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Government
      </span>
      <span class="trust-icon">
        <svg viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Public Sector
      </span>
      <span class="trust-icon">
        <svg viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        Municipal
      </span>
    </div>
  </div>
</div>

<!-- Keep all the styles - they need to stay -->
<style>
  /* Reset and Base Styles */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow-x: hidden;
  }

  /* Animated Background */
  .bg-bubbles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .bg-bubbles li {
    position: absolute;
    list-style: none;
    display: block;
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.15);
    bottom: -160px;
    animation: square 25s infinite;
    transition-timing-function: linear;
    border-radius: 50%;
  }

  .bg-bubbles li:nth-child(1) {
    left: 10%;
    width: 80px;
    height: 80px;
    animation-delay: 0s;
    animation-duration: 20s;
  }

  .bg-bubbles li:nth-child(2) {
    left: 20%;
    width: 40px;
    height: 40px;
    animation-delay: 2s;
    animation-duration: 25s;
  }

  .bg-bubbles li:nth-child(3) {
    left: 35%;
    width: 120px;
    height: 120px;
    animation-delay: 4s;
    animation-duration: 30s;
  }

  .bg-bubbles li:nth-child(4) {
    left: 50%;
    width: 60px;
    height: 60px;
    animation-delay: 0s;
    animation-duration: 22s;
  }

  .bg-bubbles li:nth-child(5) {
    left: 65%;
    width: 100px;
    height: 100px;
    animation-delay: 6s;
    animation-duration: 28s;
  }

  .bg-bubbles li:nth-child(6) {
    left: 80%;
    width: 70px;
    height: 70px;
    animation-delay: 3s;
    animation-duration: 24s;
  }

  .bg-bubbles li:nth-child(7) {
    left: 90%;
    width: 50px;
    height: 50px;
    animation-delay: 5s;
    animation-duration: 26s;
  }

  @keyframes square {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
      border-radius: 50%;
    }
    100% {
      transform: translateY(-1000px) rotate(720deg);
      opacity: 0;
      border-radius: 50%;
    }
  }

  /* Main Container - Properly centered */
  .container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
    text-align: center;
  }

  /* Logo and Title */
  .logo-container {
    margin-bottom: 30px;
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 20px;
  }

  .logo-icon {
    width: 80px;
    height: 80px;
    background: white;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  .logo-icon svg {
    width: 50px;
    height: 50px;
  }

  .logo-text h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 5px;
  }

  .logo-text p {
    font-size: 1.2rem;
    opacity: 0.9;
    letter-spacing: 1px;
    color: white;
  }

  /* User Greeting for Logged In Users */
  .user-greeting {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: white;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .role-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: 8px 20px;
    margin-bottom: 20px;
    font-size: 1rem;
    letter-spacing: 1px;
    color: white;
  }

  /* Tagline */
  .tagline {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    color: white;
  }

  .tagline span {
    background: linear-gradient(135deg, #ffd700 0%, #ffa500 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .description {
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: 30px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    color: white;
  }

  /* Feature Badges */
  .feature-badges {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 500;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
  }

  .badge:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  /* CTA Buttons */
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 14px 32px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: white;
    color: #764ba2;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    background: #f0f0f0;
  }

  .btn-outline {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-outline:hover {
    background: white;
    color: #764ba2;
    transform: translateY(-2px);
  }

  .btn-danger {
    background: #ef4444;
    color: white;
    box-shadow: 0 10px 20px rgba(239, 68, 68, 0.3);
  }

  .btn-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(239, 68, 68, 0.4);
  }

  /* Trust Badges */
  .trust-badges {
    margin-top: 60px;
    text-align: center;
  }

  .trust-badges p {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 20px;
    font-size: 0.9rem;
  }

  .badge-group {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .trust-icon {
    display: flex;
    align-items: center;
    gap: 8px;
    color: white;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .trust-icon:hover {
    opacity: 1;
  }

  .trust-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .logo-text h1 {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 2rem;
    }

    .user-greeting {
      font-size: 1.5rem;
    }
    
    .badge-group {
      gap: 15px;
    }
  }
</style>