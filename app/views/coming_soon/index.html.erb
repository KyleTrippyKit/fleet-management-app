<%# app/views/coming_soon/index.html.erb %>
<div class="container min-vh-100 d-flex align-items-center justify-content-center">
  <div class="text-center">
    <div class="mb-4">
      <i class="fas fa-tools fa-4x text-primary"></i>
    </div>
    <h1 class="display-4 fw-bold mb-3">Coming Soon</h1>
    <p class="lead text-muted mb-4">The <strong><%= @feature_name %></strong> feature is currently under development.</p>
    <p class="text-muted mb-4">We're working hard to bring you this functionality. Please check back later.</p>
    <%= link_to "Return to Dashboard", root_path, class: "btn btn-primary btn-lg px-5" %>
  </div>
</div>

<style>
  .min-vh-100 {
    min-height: 100vh;
  }
</style>