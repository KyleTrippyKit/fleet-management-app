<%# app/views/purchase_orders/index.html.erb %>

<%# ======================================================== %>
<%# HELPER METHODS - DEFINED FIRST FOR PROPER SCOPE          %>
<%# ======================================================== %>
<% 
  def po_status_icon(status)
    case status.to_s
    when 'draft' then 'file'
    when 'pending_approval' then 'clock'
    when 'approved' then 'check-circle'
    when 'rejected' then 'times-circle'
    when 'ordered' then 'shopping-cart'
    when 'received' then 'box'
    when 'cancelled' then 'ban'
    when 'paid' then 'receipt'
    else 'circle'
    end
  end

  def payment_status_icon(status)
    case status.to_s
    when 'unpaid' then 'exclamation-circle'
    when 'pending' then 'clock'
    when 'processing' then 'sync'
    when 'authorized' then 'shield-alt'
    when 'completed' then 'check-circle'
    when 'failed' then 'times-circle'
    when 'refunded' then 'undo'
    else 'circle'
    end
  end

  def agency_badge_color(agency_code)
    case agency_code.to_s.downcase
    when 'vmcott' then 'primary'
    when 'ptsc' then 'success'
    when 'ttps' then 'info'
    when 'ttdf' then 'warning'
    when 'fire' then 'danger'
    when 'health' then 'secondary'
    when 'education' then 'dark'
    else 'secondary'
    end
  end

  def format_currency(amount)
    number_to_currency(amount, unit: 'TTD ', precision: 2)
  end
%>

<%
  # Disable Turbo for this entire page to prevent blinking/flash
  content_for :head do %>
    <meta name="turbo-visit-control" content="reload">
    <meta name="turbo-cache-control" content="no-cache">
    <style>
      /* EMERGENCY BLINKING FIX - INLINE FOR IMMEDIATE EFFECT */
      body.purchase-orders-page {
        background-color: #f8f9fa !important;
        animation: none !important;
        transition: none !important;
      }
      
      .purchase-orders-page .container-fluid.py-4,
      .purchase-orders-page .card:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .purchase-orders-page .card-body:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark),
      .purchase-orders-page .table,
      .purchase-orders-page .table th,
      .purchase-orders-page .table td,
      .purchase-orders-page .table tbody tr {
        background-color: white !important;
        color: #212529 !important;
        opacity: 1 !important;
        visibility: visible !important;
        animation: none !important;
        transition: none !important;
      }
      
      .purchase-orders-page *:not(.bg-primary):not(.bg-success):not(.bg-info):not(.bg-warning):not(.bg-danger):not(.bg-dark):not(.btn-primary):not(.btn-success):not(.btn-info):not(.btn-warning):not(.btn-danger) {
        color: #212529 !important;
      }
      
      .purchase-orders-page .card.bg-primary *,
      .purchase-orders-page .card.bg-success *,
      .purchase-orders-page .card.bg-info *,
      .purchase-orders-page .card.bg-danger *,
      .purchase-orders-page .card.bg-dark * {
        color: white !important;
      }
      
      .purchase-orders-page .card.bg-warning * {
        color: #212529 !important;
      }
      
      [data-turbo-preview] * {
        opacity: 1 !important;
        visibility: visible !important;
      }
      
      .purchase-orders-page * {
        animation: none !important;
        transition: none !important;
      }
      
      /* COMPACT ACTION BUTTON STYLES - FIT IN ONE LINE */
      .action-group {
        display: flex !important;
        flex-wrap: nowrap !important;
        gap: 2px !important;
        justify-content: flex-end !important;
        align-items: center !important;
      }
      
      .action-group .btn-sm,
      .action-group .btn-group-sm .btn {
        padding: 4px 8px !important;
        font-size: 0.75rem !important;
        line-height: 1 !important;
        min-width: 32px !important;
        white-space: nowrap !important;
        border-radius: 4px !important;
      }
      
      .action-group .btn-sm i,
      .action-group .btn-group-sm .btn i {
        margin-right: 0 !important;
        font-size: 0.85rem !important;
      }
      
      /* Hide text labels on all action buttons by default */
      .action-group .btn-label {
        display: none !important;
      }
      
      /* Tooltip on hover for better UX */
      .action-group .btn-sm,
      .action-group .btn-group-sm .btn {
        position: relative !important;
      }
      
      .action-group .btn-sm:hover:after,
      .action-group .btn-group-sm .btn:hover:after {
        content: attr(title);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.85);
        color: white;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 500;
        white-space: nowrap;
        z-index: 10000;
        pointer-events: none;
        margin-bottom: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        letter-spacing: 0.3px;
        border: 1px solid rgba(255,255,255,0.1);
      }
      
      /* Special handling for button groups */
      .action-group .btn-group {
        display: flex !important;
        flex-wrap: nowrap !important;
        gap: 2px !important;
      }
      
      .action-group .btn-group .btn {
        border-radius: 4px !important;
        margin-left: 0 !important;
      }
      
      .action-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 12px;
        background-color: #f8f9fa;
        color: #495057;
        margin-left: 4px;
        border: 1px solid #dee2e6;
      }
      
      .badge-with-icon i {
        margin-right: 4px;
      }
      
      .agency-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.85rem;
      }
      
      /* Tablet view - slightly smaller buttons */
      @media (max-width: 1400px) {
        .action-group {
          gap: 1px !important;
        }
        
        .action-group .btn-sm,
        .action-group .btn-group-sm .btn {
          padding: 4px 6px !important;
          min-width: 30px !important;
        }
      }
      
      /* Mobile view - stack vertically if absolutely needed */
      @media (max-width: 992px) {
        .action-group {
          flex-wrap: wrap !important;
          justify-content: flex-start !important;
        }
      }
      
      [title] {
        cursor: help;
      }
    </style>
    <script>
      // IMMEDIATE FIX FOR BLINKING ISSUE
      document.addEventListener('DOMContentLoaded', function() {
        console.log('Purchase Orders Page - Applying emergency fix for blinking');
        
        document.body.classList.add('purchase-orders-page');
        
        document.body.style.opacity = '1';
        document.body.style.visibility = 'visible';
        
        setTimeout(function() {
          const containers = document.querySelectorAll('.container-fluid, .card, .table, .row');
          containers.forEach(container => {
            container.style.display = 'none';
            void container.offsetHeight;
            container.style.display = '';
          });
          
          const allElements = document.querySelectorAll('.purchase-orders-page *');
          allElements.forEach(el => {
            const bgColor = window.getComputedStyle(el).backgroundColor;
            const textColor = window.getComputedStyle(el).color;
            
            if ((bgColor === 'rgba(0, 0, 0, 0)' || 
                 bgColor === 'rgb(255, 255, 255)' || 
                 bgColor === 'rgb(248, 249, 250)' ||
                 bgColor === '#ffffff' ||
                 bgColor === '#f8f9fa') &&
                (textColor === 'rgba(0, 0, 0, 0)' || 
                 textColor === 'rgb(255, 255, 255)' ||
                 textColor === '#ffffff')) {
              el.style.color = '#212529';
            }
          });
        }, 10);
      });
      
      document.addEventListener('turbo:load', function() {
        if (window.location.pathname.includes('/purchase_orders')) {
          console.log('Purchase Orders page detected, disabling Turbo');
          
          document.querySelectorAll('a:not([data-turbo="false"])').forEach(link => {
            link.setAttribute('data-turbo', 'false');
          });
          
          document.querySelectorAll('form:not([data-turbo="false"])').forEach(form => {
            form.setAttribute('data-turbo', 'false');
          });
          
          if (typeof Turbo !== 'undefined') {
            Turbo.cache.exemptPageFromPreview();
            Turbo.cache.exemptPageFromCache();
          }
        }
      });
    </script>
<% end %>

<div class="container-fluid py-4 purchase-orders-container" data-controller="purchase-orders">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h3 mb-0">
        <i class="fas fa-file-invoice-dollar me-2"></i>
        Purchase Orders
      </h1>
      <p class="text-muted">Manage purchase orders across all agencies</p>
    </div>
    <div class="col-auto">
      <%= link_to new_purchase_order_path, class: 'btn btn-primary', data: { turbo: false } do %>
        <i class="fas fa-plus-circle me-2"></i> 
        <span class="btn-label">Create New PO</span>
      <% end %>
      <%= link_to reports_purchase_orders_path, class: 'btn btn-outline-secondary ms-2', data: { turbo: false } do %>
        <i class="fas fa-chart-pie me-2"></i> 
        <span class="btn-label">Reports & Analytics</span>
      <% end %>
      <%= link_to needs_payment_purchase_orders_path, class: 'btn btn-warning ms-2', data: { turbo: false } do %>
        <i class="fas fa-exclamation-triangle me-2"></i> 
        <span class="btn-label">Awaiting Payment</span>
        <% if @purchase_orders.needs_payment.count > 0 %>
          <span class="badge bg-dark ms-1"><%= @purchase_orders.needs_payment.count %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">Total POs</h6>
              <h3 class="mb-0"><%= @purchase_orders.total_count %></h3>
            </div>
            <i class="fas fa-file-invoice fa-2x opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-warning text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">Needs Payment</h6>
              <h3 class="mb-0"><%= @purchase_orders.needs_payment.count %></h3>
            </div>
            <i class="fas fa-credit-card fa-2x opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">Total Value</h6>
              <h3 class="mb-0">TTD <%= number_to_currency(@purchase_orders.sum(:amount), unit: '') %></h3>
            </div>
            <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-info text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase mb-0">🇹🇹 Card Payments</h6>
              <h3 class="mb-0"><%= @purchase_orders.trinidad_card_payments.count %></h3>
            </div>
            <i class="fas fa-flag fa-2x opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
      <%= form_with url: purchase_orders_path, method: :get, local: true, class: 'row g-3', data: { turbo: false } do |f| %>
        <% if current_user.admin? %>
          <div class="col-md-3">
            <%= label_tag :agency_id, 'Agency', class: 'form-label' %>
            <%= select_tag :agency_id, 
                  options_from_collection_for_select(@agencies, :id, :name, params[:agency_id]),
                  include_blank: 'All Agencies',
                  class: 'form-select' %>
          </div>
        <% end %>
        
        <div class="col-md-2">
          <%= label_tag :status, 'Status', class: 'form-label' %>
          <%= select_tag :status, 
                options_for_select(PurchaseOrder.statuses.keys.map { |s| [s.humanize.titleize, s] }, params[:status]),
                include_blank: 'All Statuses',
                class: 'form-select' %>
        </div>
        
        <div class="col-md-2">
          <%= label_tag :payment_status, 'Payment Status', class: 'form-label' %>
          <%= select_tag :payment_status, 
                options_for_select(PurchaseOrder.payment_statuses.keys.map { |s| [s.humanize.titleize, s] }, params[:payment_status]),
                include_blank: 'All Payment Statuses',
                class: 'form-select' %>
        </div>
        
        <div class="col-md-2">
          <%= label_tag :payment_method, 'Payment Method', class: 'form-label' %>
          <%= select_tag :payment_method, 
                options_for_select(PurchaseOrder.payment_methods.keys.map { |s| [s.humanize.titleize, s] }, params[:payment_method]),
                include_blank: 'All Methods',
                class: 'form-select' %>
        </div>
        
        <div class="col-md-2">
          <%= label_tag :date_from, 'From Date', class: 'form-label' %>
          <%= date_field_tag :date_from, params[:date_from], class: 'form-control' %>
        </div>
        
        <div class="col-md-2">
          <%= label_tag :date_to, 'To Date', class: 'form-label' %>
          <%= date_field_tag :date_to, params[:date_to], class: 'form-control' %>
        </div>
        
        <div class="col-md-1 d-flex align-items-end">
          <div class="btn-group w-100">
            <%= submit_tag 'Filter', class: 'btn btn-primary' %>
            <%= link_to 'Clear', purchase_orders_path, class: 'btn btn-outline-secondary', data: { turbo: false } %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Purchase Orders Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">PO Number</th>
              <th class="border-0">Vendor</th>
              <th class="border-0">Agency/Vehicle</th>
              <th class="border-0">Amount</th>
              <th class="border-0">Status</th>
              <th class="border-0">Payment</th>
              <th class="border-0">Created</th>
              <th class="border-0 text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @purchase_orders.each do |po| %>
              <tr>
                <td>
                  <strong><%= link_to po.po_number, po, class: 'text-decoration-none', data: { turbo: false } %></strong>
                  <div class="small text-muted">
                    <i class="fas fa-user-circle fa-fw"></i> <%= po.created_by&.name || 'System' %>
                  </div>
                </td>
                <td>
                  <span class="fw-bold"><%= po.vendor %></span>
                  <% if po.supplier_id.present? %>
                    <span class="action-badge">ID: <%= po.supplier_id %></span>
                  <% end %>
                </td>
                <td>
                  <% if po.agency %>
                    <span class="badge bg-<%= agency_badge_color(po.agency.code) %>-subtle text-<%= agency_badge_color(po.agency.code) %> border border-<%= agency_badge_color(po.agency.code) %> mb-1">
                      <i class="fas fa-building me-1"></i> <%= po.agency.code %>
                    </span>
                  <% end %>
                  <% if po.vehicle %>
                    <div class="small">
                      <i class="fas fa-car text-muted me-1"></i>
                      <%= link_to po.vehicle.license_plate, po.vehicle, class: 'text-decoration-none', data: { turbo: false } %>
                      <span class="text-muted">(<%= po.vehicle.make %>)</span>
                    </div>
                  <% else %>
                    <span class="text-muted fst-italic">No vehicle</span>
                  <% end %>
                </td>
                <td>
                  <strong class="text-nowrap text-success"><%= format_currency(po.amount) %></strong>
                </td>
                <td>
                  <span class="badge bg-<%= po.status_badge_color %> px-3 py-2">
                    <i class="fas fa-<%= po_status_icon(po.status) %> me-1"></i>
                    <%= po.display_status %>
                  </span>
                </td>
                <td>
                  <div class="mb-1">
                    <span class="badge bg-<%= po.payment_status_badge_color %> px-3 py-2">
                      <i class="fas fa-<%= payment_status_icon(po.payment_status) %> me-1"></i>
                      <%= po.display_payment_status %>
                    </span>
                  </div>
                  <% if po.payment_method %>
                    <div class="small mt-1">
                      <span class="badge bg-<%= po.payment_method_badge_color %>">
                        <i class="fas <%= po.payment_method_icon %> me-1"></i>
                        <%= po.display_payment_method %>
                      </span>
                      <% if po.respond_to?(:last_four_digits) && po.last_four_digits.present? %>
                        <span class="text-muted ms-1">•••• <%= po.last_four_digits %></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td>
                  <span class="fw-normal"><%= po.created_at.strftime('%b %d, %Y') %></span>
                  <div class="small text-muted"><%= time_ago_in_words(po.created_at) %> ago</div>
                </td>
                
                <!-- ACTION BUTTONS - COMPACT ICON-ONLY VERSION - ALL IN ONE LINE -->
                <td class="text-end" style="min-width: 200px;">
                  <div class="action-group">
                    
                    <!-- === VIEW ACTION (Always visible) === -->
                    <%= link_to po, 
                          class: 'btn btn-sm btn-outline-primary', 
                          title: 'View Purchase Order', 
                          data: { turbo: false } do %>
                      <i class="fas fa-file-invoice"></i>
                      <span class="btn-label">View</span>
                    <% end %>
                    
                    <!-- === PDF ACTION (Always visible) === -->
                    <%= link_to print_purchase_order_path(po, format: :pdf), 
                          class: 'btn btn-sm btn-outline-dark',
                          target: '_blank',
                          title: 'Download PDF',
                          data: { turbo: false } do %>
                      <i class="fas fa-file-pdf"></i>
                      <span class="btn-label">PDF</span>
                    <% end %>
                    
                    <!-- === EDIT ACTION (Draft/Editable only) === -->
                    <% if po.editable? %>
                      <%= link_to edit_purchase_order_path(po), 
                            class: 'btn btn-sm btn-outline-warning', 
                            title: 'Edit Draft', 
                            data: { turbo: false } do %>
                        <i class="fas fa-pencil-alt"></i>
                        <span class="btn-label">Edit</span>
                      <% end %>
                    <% end %>
                    
                    <!-- === SUBMIT FOR APPROVAL (Draft only) === -->
                    <% if po.draft? %>
                      <%= button_to submit_purchase_order_path(po), 
                            method: :post,
                            class: 'btn btn-sm btn-warning',
                            title: 'Submit for Approval',
                            form: { class: 'd-inline', data: { turbo: false } } do %>
                        <i class="fas fa-paper-plane"></i>
                        <span class="btn-label">Submit</span>
                      <% end %>
                    <% end %>
                    
                    <!-- === APPROVE ACTION (Pending Approval only) === -->
                    <% if po.pending_approval? && (current_user.supervisor? || current_user.admin?) %>
                      <%= button_to approve_purchase_order_path(po),
                            method: :post,
                            class: 'btn btn-sm btn-success',
                            title: 'Approve Purchase Order',
                            form: { class: 'd-inline', data: { turbo: false } } do %>
                        <i class="fas fa-check-circle"></i>
                        <span class="btn-label">Approve</span>
                      <% end %>
                    <% end %>
                    
                    <!-- === REJECT ACTION (Pending Approval only) === -->
                    <% if po.pending_approval? && (current_user.supervisor? || current_user.admin?) %>
                      <button type="button" class="btn btn-sm btn-outline-danger" 
                              data-bs-toggle="modal" 
                              data-bs-target="#rejectModal"
                              data-po-id="<%= po.id %>"
                              title="Reject Purchase Order">
                        <i class="fas fa-times-circle"></i>
                        <span class="btn-label">Reject</span>
                      </button>
                    <% end %>
                    
                    <!-- === TRINIDAD CARD PAYMENT === -->
                    <% if po.can_initiate_payment? && (current_user.finance? || current_user.admin?) %>
                      <%= link_to payment_page_purchase_order_path(po), 
                            class: 'btn btn-sm btn-primary',
                            title: 'Process Trinidad Card Payment',
                            data: { turbo: false } do %>
                        <i class="fas fa-credit-card"></i>
                        <span class="btn-label">🇹🇹 Pay</span>
                      <% end %>
                    <% end %>
                    
                    <!-- === AUTHORIZE PAYMENT (Admin only) === -->
                    <% if po.can_authorize_payment? && current_user.admin? %>
                      <button type="button" class="btn btn-sm btn-info"
                              data-bs-toggle="modal"
                              data-bs-target="#authorizePaymentModal"
                              data-po-id="<%= po.id %>"
                              data-po-number="<%= po.po_number %>"
                              data-amount="<%= format_currency(po.amount) %>"
                              title="Authorize Payment (Admin Only)">
                        <i class="fas fa-shield-alt"></i>
                        <span class="btn-label">Authorize</span>
                      </button>
                    <% end %>
                    
                    <!-- === COMPLETE PAYMENT (Finance only) === -->
                    <% if po.can_complete_payment? && current_user.finance? %>
                      <%= button_to complete_payment_purchase_order_path(po),
                            method: :post,
                            class: 'btn btn-sm btn-success',
                            title: 'Complete Payment & Create Invoice',
                            data: { confirm: 'Complete this payment? This will mark the PO as paid and create an invoice.' },
                            form: { class: 'd-inline', data: { turbo: false } } do %>
                        <i class="fas fa-check-double"></i>
                        <span class="btn-label">Complete</span>
                      <% end %>
                    <% end %>
                    
                    <!-- === MARK AS PAID (Manual payment) === -->
                    <% if po.approved? && po.payment_unpaid? && !po.is_trinidad_payment? && (current_user.finance? || current_user.admin?) %>
                      <button type="button" class="btn btn-sm btn-success" 
                              data-bs-toggle="modal" 
                              data-bs-target="#markPaidModal" 
                              data-po-id="<%= po.id %>"
                              data-po-number="<%= po.po_number %>"
                              title="Mark as Paid (Cash/Cheque/Bank Transfer)">
                        <i class="fas fa-money-bill-wave"></i>
                        <span class="btn-label">Mark Paid</span>
                      </button>
                    <% end %>
                    
                    <!-- === VMCOTT WORK ORDER === -->
                    <% if po.vendor == 'VMCOTT' && po.fully_accepted? && current_user.vmcott_staff? %>
                      <% if po.pending_internal_work? %>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#createInternalPosModal"
                                data-po-id="<%= po.id %>"
                                title="Create Internal Work Order">
                          <i class="fas fa-tools"></i>
                          <span class="btn-label">Work Order</span>
                        </button>
                      <% end %>
                      
                      <% if po.work_in_progress? %>
                        <%= button_to mark_internal_work_completed_purchase_order_path(po),
                              method: :post,
                              class: 'btn btn-sm btn-info',
                              title: 'Mark Work Completed',
                              form: { class: 'd-inline', data: { turbo: false } } do %>
                          <i class="fas fa-check"></i>
                          <span class="btn-label">Complete</span>
                        <% end %>
                      <% end %>
                    <% end %>
                    
                    <!-- === INVOICED STATUS (if paid) === -->
                    <% if po.paid? %>
                      <span class="btn btn-sm btn-outline-success disabled" 
                            title="Invoice Generated">
                        <i class="fas fa-file-invoice"></i>
                        <span class="btn-label">Invoiced</span>
                      </span>
                    <% end %>
                    
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <% if @purchase_orders.empty? %>
        <div class="text-center py-5">
          <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
          <h4 class="text-muted">No purchase orders found</h4>
          <p class="text-muted">Create your first purchase order to get started</p>
          <%= link_to 'Create Purchase Order', new_purchase_order_path, class: 'btn btn-primary', data: { turbo: false } %>
        </div>
      <% end %>
    </div>
    
    <% if @purchase_orders.total_pages > 1 %>
      <div class="card-footer border-0 bg-light">
        <div class="d-flex justify-content-center">
          <%= paginate @purchase_orders %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-times-circle text-danger me-2"></i>
          Reject Purchase Order
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: reject_purchase_order_path('ID_PLACEHOLDER'), method: :post, data: { turbo: false } do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>You are rejecting purchase order <span id="rejectPoNumber" class="fw-bold"></span></strong>
          </div>
          
          <div class="mb-3">
            <%= label_tag :reason, 'Reason for Rejection', class: 'form-label fw-bold' %>
            <p class="text-muted small mb-2">Please provide a clear reason why this purchase order is being rejected:</p>
            <%= text_area_tag :reason, nil, 
                  class: 'form-control',
                  rows: 4,
                  placeholder: 'e.g., Incorrect pricing, missing approvals, vendor not approved, budget constraints...',
                  required: true %>
          </div>
          
          <div class="alert alert-secondary small">
            <i class="fas fa-info-circle me-1"></i>
            The vendor will be notified of this rejection. You can edit and resubmit the PO later.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Cancel
          </button>
          <%= submit_tag 'Reject Purchase Order', class: 'btn btn-danger' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Mark Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-check-circle text-success me-2"></i>
          Mark Purchase Order as Paid
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: mark_paid_purchase_order_path('ID_PLACEHOLDER'), method: :post, data: { turbo: false } do |f| %>
        <div class="modal-body">
          <div class="alert alert-success">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Recording payment for PO: <span id="paidPoNumber"></span></strong>
          </div>
          
          <div class="mb-3">
            <%= label_tag :payment_method, 'Payment Method', class: 'form-label fw-bold' %>
            <%= select_tag :payment_method, 
                  options_for_select([
                    ['🇹🇹 Trinidad Credit Card', 'trinidad_credit_card'],
                    ['🇹🇹 Trinidad Debit Card', 'trinidad_debit_card'],
                    ['🏦 Bank Transfer / Wire', 'bank_transfer'],
                    ['💵 Cash', 'cash'],
                    ['📝 Cheque', 'cheque'],
                    ['💳 International Credit Card', 'credit_card'],
                    ['💳 International Debit Card', 'debit_card'],
                    ['🔄 Other', 'other']
                  ]),
                  class: 'form-select', 
                  required: true,
                  id: 'paymentMethodSelect' %>
          </div>
          
          <!-- Card Details Section -->
          <div id="cardDetailsSection" class="d-none">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= label_tag :card_type, 'Card Brand', class: 'form-label fw-bold' %>
                  <%= select_tag :card_type, 
                        options_for_select([
                          ['Visa', 'visa'],
                          ['MasterCard', 'mastercard'],
                          ['American Express', 'amex'],
                          ['Discover', 'discover'],
                          ['First Citizens', 'first_citizens'],
                          ['Republic Bank', 'republic_bank'],
                          ['Scotiabank', 'scotiabank'],
                          ['Other Local Card', 'local']
                        ], 'visa'),
                        class: 'form-select',
                        id: 'cardTypeSelect' %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= label_tag :last_four_digits, 'Last 4 Digits', class: 'form-label fw-bold' %>
                  <%= text_field_tag :last_four_digits, nil, 
                        class: 'form-control',
                        placeholder: '1234',
                        maxlength: 4,
                        pattern: '[0-9]{4}',
                        id: 'lastFourDigitsInput' %>
                  <div class="form-text">Required for card payments</div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="mb-3">
            <%= label_tag :payment_reference, 'Reference / Transaction ID', class: 'form-label fw-bold' %>
            <%= text_field_tag :payment_reference, nil, 
                  class: 'form-control',
                  placeholder: 'Cheque #, Transfer Ref, Transaction ID',
                  required: true,
                  id: 'paymentReferenceInput' %>
            <div class="form-text">Enter the reference number from your bank, cheque, or payment portal</div>
          </div>
          
          <div class="mb-3">
            <%= label_tag :payment_date, 'Payment Date', class: 'form-label fw-bold' %>
            <%= date_field_tag :payment_date, Date.current, 
                  class: 'form-control',
                  required: true,
                  id: 'paymentDateInput' %>
            <div class="form-text">When was this payment made?</div>
          </div>
          
          <div class="mb-3">
            <%= label_tag :payment_notes, 'Notes (Optional)', class: 'form-label' %>
            <%= text_area_tag :payment_notes, nil, 
                  class: 'form-control',
                  rows: 2,
                  placeholder: 'Additional details about this payment...',
                  id: 'paymentNotesInput' %>
          </div>
          
          <div class="alert alert-info small">
            <i class="fas fa-file-invoice me-1"></i>
            <strong>Invoice will be auto-generated</strong> - A paid invoice will be created automatically.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Cancel
          </button>
          <%= submit_tag '✓ Confirm Payment', class: 'btn btn-success' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Authorize Payment Modal -->
<div class="modal fade" id="authorizePaymentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-shield-alt text-primary me-2"></i>
          Authorize Trinidad Card Payment
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: authorize_payment_purchase_order_path('ID_PLACEHOLDER'), method: :post, data: { turbo: false } do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Administrator Authorization Required</strong>
          </div>
          
          <div class="card mb-3 border-primary">
            <div class="card-header bg-primary bg-opacity-10 text-primary fw-bold">
              <i class="fas fa-file-invoice me-1"></i> Purchase Order Details
            </div>
            <div class="card-body">
              <h5 id="authPoNumber" class="mb-2"></h5>
              <h3 id="authAmount" class="text-success mb-0"></h3>
              <div class="mt-2 text-muted small">
                <i class="fas fa-flag me-1"></i> Trinidad & Tobago Card Payment
              </div>
            </div>
          </div>
          
          <div class="alert alert-info">
            <p class="mb-2 fw-bold">By authorizing this payment, you confirm:</p>
            <ul class="mb-0 small">
              <li>✓ Vendor has delivered goods/services as specified</li>
              <li>✓ Amount matches approved invoice/agreement</li>
              <li>✓ All required departmental approvals obtained</li>
              <li>✓ Payment complies with agency financial policies</li>
              <li>✓ Funds are available in designated account</li>
            </ul>
          </div>
          
          <div class="mb-3">
            <%= label_tag :authorization_notes, 'Authorization Notes', class: 'form-label fw-bold' %>
            <%= text_area_tag :authorization_notes, nil, 
                  class: 'form-control',
                  rows: 3,
                  placeholder: 'Optional: Add any notes about this authorization (e.g., budget code, special conditions)...' %>
          </div>
          
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="confirmAuthCheck" required>
            <label class="form-check-label fw-bold" for="confirmAuthCheck">
              I confirm that all requirements have been met and I am authorized to approve this payment.
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Cancel
          </button>
          <%= submit_tag '✓ Authorize Payment', class: 'btn btn-primary', disabled: true, id: 'authorizeSubmitBtn' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// FIX FOR BLINKING/WHITE TEXT ISSUE
document.addEventListener('DOMContentLoaded', function() {
  console.log('Purchase Orders Index - DOM Loaded, applying fixes');
  
  // Add class to body for CSS targeting
  document.body.classList.add('purchase-orders-page');
  
  // Force immediate visibility with NO transitions
  document.body.style.transition = 'none';
  document.body.style.animation = 'none';
  
  // Force all transitions to be disabled immediately
  const disableAllTransitions = () => {
    const allElements = document.querySelectorAll('*');
    allElements.forEach(el => {
      el.style.transition = 'none';
      el.style.animation = 'none';
      el.style.opacity = '1';
      el.style.visibility = 'visible';
    });
  };
  
  disableAllTransitions();
  
  // Force proper text colors immediately
  setTimeout(() => {
    const forceTextColor = () => {
      const container = document.querySelector('.purchase-orders-container');
      if (container) {
        const allElements = container.querySelectorAll('*');
        allElements.forEach(el => {
          const computedStyle = window.getComputedStyle(el);
          const bgColor = computedStyle.backgroundColor;
          const textColor = computedStyle.color;
          
          if ((textColor === 'rgba(0, 0, 0, 0)' || 
               textColor === 'transparent' || 
               textColor === 'rgb(255, 255, 255)' || 
               textColor === '#ffffff') &&
              (bgColor === 'rgba(0, 0, 0, 0)' ||
               bgColor === 'transparent' ||
               bgColor === 'rgb(255, 255, 255)' ||
               bgColor === '#ffffff' ||
               bgColor === 'rgb(248, 249, 250)' ||
               bgColor === '#f8f9fa')) {
            el.style.color = '#212529';
            el.style.setProperty('color', '#212529', 'important');
          }
          
          if (el.classList.contains('card') && 
              !el.classList.contains('bg-primary') &&
              !el.classList.contains('bg-success') &&
              !el.classList.contains('bg-info') &&
              !el.classList.contains('bg-warning') &&
              !el.classList.contains('bg-danger') &&
              !el.classList.contains('bg-dark')) {
            el.style.backgroundColor = 'white';
            el.style.setProperty('background-color', 'white', 'important');
          }
          
          if (el.tagName === 'TABLE' || el.classList.contains('table')) {
            el.style.backgroundColor = 'white';
            el.style.setProperty('background-color', 'white', 'important');
          }
        });
      }
    };
    
    forceTextColor();
    setTimeout(forceTextColor, 50);
    setTimeout(forceTextColor, 100);
    setTimeout(forceTextColor, 200);
  }, 20);
  
  // Completely disable Turbo for this page
  if (typeof Turbo !== 'undefined') {
    console.log('Disabling Turbo for purchase orders page');
    Turbo.cache.exemptPageFromCache();
    Turbo.cache.exemptPageFromPreview();
    
    document.addEventListener('turbo:before-cache', function(event) {
      if (window.location.pathname.includes('/purchase_orders')) {
        console.log('Preventing Turbo cache for purchase orders');
        event.preventDefault();
        Turbo.cache.clear();
      }
    });
    
    const originalVisit = Turbo.visit;
    Turbo.visit = function(url, options = {}) {
      if (url.toString().includes('/purchase_orders')) {
        console.log('Preventing Turbo visit to purchase order page');
        window.location.href = url;
        return;
      }
      return originalVisit.call(this, url, options);
    };
  }
  
  // Force disable Turbo for all links and forms
  setTimeout(() => {
    document.querySelectorAll('a').forEach(link => {
      if (!link.hasAttribute('data-turbo') && !link.hasAttribute('target')) {
        link.setAttribute('data-turbo', 'false');
      }
    });
    
    document.querySelectorAll('form').forEach(form => {
      if (!form.hasAttribute('data-turbo')) {
        form.setAttribute('data-turbo', 'false');
      }
    });
  }, 100);
  
  // Reject Modal
  const rejectModal = document.getElementById('rejectModal');
  if (rejectModal) {
    rejectModal.addEventListener('show.bs.modal', function(event) {
      const button = event.relatedTarget;
      const poId = button.getAttribute('data-po-id');
      
      const form = rejectModal.querySelector('form');
      const poNumberDisplay = rejectModal.querySelector('#rejectPoNumber');
      
      const row = button.closest('tr');
      const poNumber = row.querySelector('td:first-child strong').textContent.trim();
      
      poNumberDisplay.textContent = poNumber;
      form.action = form.action.replace('ID_PLACEHOLDER', poId);
    });
  }
  
  // Mark Paid Modal
  const markPaidModal = document.getElementById('markPaidModal');
  if (markPaidModal) {
    markPaidModal.addEventListener('show.bs.modal', function(event) {
      const button = event.relatedTarget;
      const poId = button.getAttribute('data-po-id');
      const poNumber = button.getAttribute('data-po-number');
      
      const form = markPaidModal.querySelector('form');
      const poNumberDisplay = markPaidModal.querySelector('#paidPoNumber');
      
      poNumberDisplay.textContent = poNumber;
      form.action = form.action.replace('ID_PLACEHOLDER', poId);
    });
    
    const paymentMethodSelect = markPaidModal.querySelector('#paymentMethodSelect');
    const cardDetailsSection = markPaidModal.querySelector('#cardDetailsSection');
    const lastFourDigitsInput = markPaidModal.querySelector('#lastFourDigitsInput');
    const cardTypeSelect = markPaidModal.querySelector('#cardTypeSelect');
    
    if (paymentMethodSelect && cardDetailsSection) {
      paymentMethodSelect.addEventListener('change', function(e) {
        const isCardPayment = e.target.value.includes('card');
        if (isCardPayment) {
          cardDetailsSection.classList.remove('d-none');
          lastFourDigitsInput.required = true;
          cardTypeSelect.required = true;
        } else {
          cardDetailsSection.classList.add('d-none');
          lastFourDigitsInput.required = false;
          cardTypeSelect.required = false;
        }
      });
    }
  }
  
  // Authorize Payment Modal
  const authorizePaymentModal = document.getElementById('authorizePaymentModal');
  if (authorizePaymentModal) {
    authorizePaymentModal.addEventListener('show.bs.modal', function(event) {
      const button = event.relatedTarget;
      const poId = button.getAttribute('data-po-id');
      const poNumber = button.getAttribute('data-po-number');
      const amount = button.getAttribute('data-amount');
      
      const form = authorizePaymentModal.querySelector('form');
      const poNumberDisplay = authorizePaymentModal.querySelector('#authPoNumber');
      const amountDisplay = authorizePaymentModal.querySelector('#authAmount');
      const checkbox = authorizePaymentModal.querySelector('#confirmAuthCheck');
      const submitBtn = authorizePaymentModal.querySelector('#authorizeSubmitBtn');
      
      poNumberDisplay.textContent = `Purchase Order: ${poNumber}`;
      amountDisplay.textContent = amount;
      form.action = form.action.replace('ID_PLACEHOLDER', poId);
      
      checkbox.checked = false;
      submitBtn.disabled = true;
      
      checkbox.addEventListener('change', function() {
        submitBtn.disabled = !this.checked;
      });
    });
  }
  
  // Fix for pagination links
  const paginationLinks = document.querySelectorAll('.pagination a');
  paginationLinks.forEach(link => {
    link.setAttribute('data-turbo', 'false');
  });
  
  // Final check after everything loads
  setTimeout(() => {
    console.log('Final check - ensuring all text is visible');
    const allTextElements = document.querySelectorAll('.purchase-orders-page p, .purchase-orders-page span, .purchase-orders-page td, .purchase-orders-page th, .purchase-orders-page div, .purchase-orders-page h1, .purchase-orders-page h2, .purchase-orders-page h3, .purchase-orders-page h4, .purchase-orders-page h5, .purchase-orders-page h6');
    allTextElements.forEach(el => {
      if (window.getComputedStyle(el).color === 'rgb(255, 255, 255)' || 
          window.getComputedStyle(el).color === '#ffffff') {
        el.style.color = '#212529';
      }
    });
  }, 500);
});
</script>