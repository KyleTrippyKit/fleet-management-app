<%# app/views/purchase_orders/reports.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h3 mb-0">Purchase Orders Report</h1>
      <p class="text-muted">View purchase orders analytics and reports</p>
    </div>
  </div>

  <!-- Report Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: reports_purchase_orders_path, method: :get, local: true, class: 'row g-3' do |f| %>
        <div class="col-md-3">
          <%= label_tag :start_date, 'Start Date', class: 'form-label' %>
          <%= date_field_tag :start_date, @start_date, class: 'form-control' %>
        </div>
        
        <div class="col-md-3">
          <%= label_tag :end_date, 'End Date', class: 'form-label' %>
          <%= date_field_tag :end_date, @end_date, class: 'form-control' %>
        </div>
        
        <% if current_user.admin? %>
          <div class="col-md-3">
            <%= label_tag :agency_id, 'Agency', class: 'form-label' %>
            <%= select_tag :agency_id, 
                  options_from_collection_for_select(Agency.all, :id, :name, @agency_id),
                  include_blank: 'All Agencies',
                  class: 'form-select' %>
          </div>
        <% end %>
        
        <div class="col-md-3 d-flex align-items-end">
          <%= submit_tag 'Generate Report', class: 'btn btn-primary w-100' %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 bg-primary bg-opacity-10">
        <div class="card-body">
          <h6 class="text-muted">Total Orders</h6>
          <h3 class="mb-0"><%= @summary[:total_orders] %></h3>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 bg-success bg-opacity-10">
        <div class="card-body">
          <h6 class="text-muted">Total Amount</h6>
          <h3 class="mb-0"><%= number_to_currency(@summary[:total_amount], unit: 'TTD $') %></h3>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 bg-warning bg-opacity-10">
        <div class="card-body">
          <h6 class="text-muted">Unpaid Amount</h6>
          <h3 class="mb-0"><%= number_to_currency(@summary[:unpaid_amount], unit: 'TTD $') %></h3>
        </div>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card border-0 bg-info bg-opacity-10">
        <div class="card-body">
          <h6 class="text-muted">Paid Amount</h6>
          <h3 class="mb-0"><%= number_to_currency(@summary[:total_amount] - @summary[:unpaid_amount], unit: 'TTD $') %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts/Stats -->
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h6 class="mb-0">Orders by Status</h6>
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush">
            <% @summary[:by_status].each do |status, count| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><%= status.humanize.titleize %></span>
                <span class="badge bg-primary rounded-pill"><%= count %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h6 class="mb-0">Orders by Payment Status</h6>
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush">
            <% @summary[:by_payment_status].each do |status, count| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><%= status.humanize.titleize %></span>
                <span class="badge bg-<%= status == 'completed' ? 'success' : (status == 'unpaid' ? 'danger' : 'warning') %> rounded-pill">
                  <%= count %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>