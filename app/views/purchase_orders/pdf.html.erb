<% content_for :title, "Purchase Order #{@purchase_order.po_number}" %>

<div class="header">
  <h1>PURCHASE ORDER</h1>
  <div class="subtitle">ActivePlus Fleet Management System</div>
</div>

<div class="info-grid">
  <div>
    <div class="info-item">
      <span class="info-label">PO Number:</span>
      <span class="info-value"><strong><%= @purchase_order.po_number %></strong></span>
    </div>
    <div class="info-item">
      <span class="info-label">Date:</span>
      <span class="info-value"><%= @purchase_order.created_at.strftime('%B %d, %Y') %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Status:</span>
      <span class="info-value"><%= @purchase_order.display_status %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Payment Status:</span>
      <span class="info-value"><%= @purchase_order.display_payment_status %></span>
    </div>
  </div>
  <div>
    <div class="info-item">
      <span class="info-label">Created By:</span>
      <span class="info-value"><%= @purchase_order.created_by&.name || 'System' %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Approved By:</span>
      <span class="info-value"><%= @purchase_order.approved_by&.name || 'Pending' %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Vehicle:</span>
      <span class="info-value"><%= @purchase_order.display_vehicle %></span>
    </div>
  </div>
</div>

<div class="section">
  <div class="section-title">Vendor Information</div>
  <div class="info-item">
    <span class="info-label">Vendor:</span>
    <span class="info-value"><strong><%= @purchase_order.vendor %></strong></span>
  </div>
</div>

<div class="section">
  <div class="section-title">Line Items</div>
  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th>Quantity</th>
        <th class="text-right">Unit Price</th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @purchase_order.purchase_order_items.each do |item| %>
        <tr>
          <td><%= item.description %></td>
          <td><%= item.quantity %></td>
          <td class="text-right">$<%= sprintf('%.2f', item.unit_price) %></td>
          <td class="text-right">$<%= sprintf('%.2f', item.quantity * item.unit_price) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td colspan="3" class="text-right"><strong>Total:</strong></td>
        <td class="text-right"><strong>$<%= sprintf('%.2f', @purchase_order.line_items_total) %></strong></td>
      </tr>
    </tfoot>
  </table>
</div>

<% if @purchase_order.notes.present? %>
  <div class="section">
    <div class="section-title">Notes</div>
    <div class="notes">
      <%= simple_format(@purchase_order.notes) %>
    </div>
  </div>
<% end %>

<div class="signature-section">
  <div class="info-grid">
    <div>
      <div class="signature-line">
        Prepared By
      </div>
    </div>
    <div>
      <div class="signature-line">
        Approved By
      </div>
    </div>
  </div>
</div>

<div class="footer">
  <p>Generated by ActivePlus Fleet Management System on <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %></p>
  <p>PO Number: <%= @purchase_order.po_number %> | Document ID: <%= SecureRandom.hex(8).upcase %></p>
</div>