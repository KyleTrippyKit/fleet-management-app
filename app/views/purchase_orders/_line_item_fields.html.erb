<%# app/views/purchase_orders/_line_item_fields.html.erb %>
<div class="line-item card border mb-2">  <!-- Make sure it has "line-item" class -->
  <div class="card-body py-2">
    <div class="row">
      <div class="col-md-5">
        <div class="mb-2">
          <%= f.label :description, class: 'form-label small' %>
          <%= f.text_field :description, class: 'form-control form-control-sm', placeholder: 'Item description', required: true %>
        </div>
      </div>
      
      <div class="col-md-2">
        <div class="mb-2">
          <%= f.label :quantity, class: 'form-label small' %>
          <%= f.number_field :quantity, class: 'form-control form-control-sm', min: 1, step: 1, value: f.object.quantity || 1, required: true %>
        </div>
      </div>
      
      <div class="col-md-3">
        <div class="mb-2">
          <%= f.label :unit_price, class: 'form-label small' %>
          <div class="input-group input-group-sm">
            <span class="input-group-text">$</span>
            <%= f.number_field :unit_price, class: 'form-control', min: 0, step: 0.01, 
                  value: f.object.unit_price || 0, required: true %>
          </div>
        </div>
      </div>
      
      <div class="col-md-2 d-flex align-items-end">
        <%= f.hidden_field :_destroy %>
        <button type="button" class="btn btn-sm btn-outline-danger remove-line-item" style="margin-bottom: 8px;">
          <i class="fas fa-times"></i> Remove
        </button>
      </div>
    </div>
  </div>
</div>