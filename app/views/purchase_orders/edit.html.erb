<%# app/views/purchase_orders/edit.html.erb %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card">
        <div class="card-header">
          <h3 class="mb-0">
            <i class="fas fa-edit me-2"></i>
            Edit Purchase Order: <%= @purchase_order.po_number %>
          </h3>
        </div>
        <div class="card-body">
          <%= render 'form', purchase_order: @purchase_order %>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-between">
            <%= link_to 'Show Details', @purchase_order, class: 'btn btn-outline-info' %>
            <%= link_to 'Back to List', purchase_orders_path, class: 'btn btn-outline-secondary' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>