<%# app/views/purchase_orders/new.html.erb %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card">
        <div class="card-header">
          <h3 class="mb-0">
            <i class="fas fa-file-purchase-order me-2"></i>
            New Purchase Order
          </h3>
        </div>
        <div class="card-body">
          <%= render 'form', purchase_order: @purchase_order %>
        </div>
        <div class="card-footer text-muted">
          <small>
            <i class="fas fa-info-circle me-1"></i>
            Purchase Orders require approval before they can be processed.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>