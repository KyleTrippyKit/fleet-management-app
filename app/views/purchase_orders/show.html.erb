<%# app/views/purchase_orders/show.html.erb %>

<%
  # Helper methods for this view
  def is_vmcott?
    current_user.agency&.code.to_s.upcase == 'VMCOTT'
  end
%>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><%= link_to 'Purchase Orders', purchase_orders_path %></li>
          <li class="breadcrumb-item active"><%= @purchase_order.po_number %></li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mt-2">
        <div>
          <h1 class="h3 mb-0">Purchase Order: <%= @purchase_order.po_number %></h1>
          <p class="text-muted mb-0">Vendor: <%= @purchase_order.vendor %></p>
        </div>

        <div class="btn-group">
          <%= link_to print_purchase_order_path(@purchase_order, format: :pdf),
                class: 'btn btn-outline-dark', target: '_blank' do %>
            <i class="fas fa-print me-2"></i> Print
          <% end %>

          <% if @purchase_order.respond_to?(:editable?) && @purchase_order.editable? %>
            <%= link_to edit_purchase_order_path(@purchase_order), class: 'btn btn-outline-primary' do %>
              <i class="fas fa-edit me-2"></i> Edit
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% purchase_order_items = (@purchase_order_items || @purchase_order.purchase_order_items).to_a rescue [] %>
  <% invoices = (@invoices || []).to_a %>
  <% payment_histories = (@payment_histories || []).to_a %>

  <div class="row">
    <div class="col-lg-8">
      <!-- Details Card -->
      <div class="card mb-4">
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6 class="text-muted mb-3">Details</h6>
              <p><strong>Vendor:</strong> <%= @purchase_order.vendor %></p>
              <p><strong>Amount:</strong> <span class="text-primary fw-bold"><%= number_to_currency(@purchase_order.amount, unit: 'TTD $') %></span></p>
              <p><strong>Agency:</strong> <%= @purchase_order.agency&.name || 'N/A' %></p>
              <p><strong>Vehicle:</strong> <%= @purchase_order.respond_to?(:display_vehicle) ? @purchase_order.display_vehicle : 'N/A' %></p>

              <p>
                <strong>Created By:</strong>
                <%= @purchase_order.created_by&.name || @purchase_order.created_by&.email || "Unknown" %>
                on <%= @purchase_order.created_at.strftime('%b %d, %Y') %>
              </p>

              <% if @purchase_order.respond_to?(:approved_by) && @purchase_order.approved_by %>
                <p><strong>Approved By:</strong> <%= @purchase_order.approved_by.name %> on <%= @purchase_order.approved_at&.strftime('%b %d, %Y') %></p>
              <% end %>

              <% if @purchase_order.respond_to?(:rejected_by) && @purchase_order.rejected_by %>
                <p><strong>Rejected By:</strong> <%= @purchase_order.rejected_by.name %> on <%= @purchase_order.rejected_at&.strftime('%b %d, %Y') %></p>
                <% if @purchase_order.respond_to?(:rejection_reason) && @purchase_order.rejection_reason.present? %>
                  <p><strong>Reason:</strong> <%= @purchase_order.rejection_reason %></p>
                <% end %>
              <% end %>
            </div>

            <div class="col-md-6">
              <h6 class="text-muted mb-3">Payment Information</h6>

              <div class="mb-3">
                <p class="mb-1"><strong>Payment Status:</strong></p>
                <span class="badge bg-<%= @purchase_order.respond_to?(:payment_status_badge_color) ? @purchase_order.payment_status_badge_color : "secondary" %>">
                  <%= @purchase_order.respond_to?(:display_payment_status) ? @purchase_order.display_payment_status : @purchase_order.payment_status.to_s.humanize %>
                </span>
              </div>

              <% if @purchase_order.respond_to?(:payment_method) && @purchase_order.payment_method.present? %>
                <div class="mb-3">
                  <p class="mb-1"><strong>Payment Method:</strong></p>
                  <p class="mb-1">
                    <i class="fas <%= @purchase_order.respond_to?(:payment_method_icon) ? @purchase_order.payment_method_icon : "fa-money-bill" %> me-2"></i>
                    <%= @purchase_order.respond_to?(:display_payment_method) ? @purchase_order.display_payment_method : @purchase_order.payment_method.to_s.humanize %>
                  </p>

                  <% if @purchase_order.respond_to?(:payment_reference) && @purchase_order.payment_reference.present? %>
                    <p class="mb-1"><strong>Reference:</strong> <code><%= @purchase_order.payment_reference %></code></p>
                  <% end %>

                  <% if @purchase_order.respond_to?(:paid_at) && @purchase_order.paid_at.present? %>
                    <p class="mb-0"><strong>Paid On:</strong> <%= @purchase_order.paid_at.strftime('%b %d, %Y %I:%M %p') %></p>
                  <% end %>
                </div>
              <% end %>

              <% if @purchase_order.respond_to?(:payment_notes) && @purchase_order.payment_notes.present? %>
                <div class="mb-3">
                  <p class="mb-1"><strong>Payment Notes:</strong></p>
                  <p class="mb-0 text-muted"><%= @purchase_order.payment_notes %></p>
                </div>
              <% end %>

              <!-- Action Buttons -->
              <div class="mt-4">
                <!-- AGENCY ACTIONS -->
                <% if !is_vmcott? %>
                  <% if @purchase_order.respond_to?(:draft?) && @purchase_order.draft? %>
                    <%= button_to 'Submit for Approval',
                          submit_purchase_order_path(@purchase_order),
                          method: :post,
                          class: 'btn btn-warning w-100 mb-2',
                          data: { confirm: 'Submit this purchase order for approval?' } %>
                  <% end %>

                  <% if @purchase_order.respond_to?(:pending_approval?) && @purchase_order.pending_approval? && (current_user.supervisor? || current_user.admin?) %>
                    <div class="btn-group w-100" role="group">
                      <%= button_to 'Approve',
                            approve_purchase_order_path(@purchase_order),
                            method: :post,
                            class: 'btn btn-success',
                            data: { confirm: 'Approve this purchase order?' } %>

                      <button type="button" class="btn btn-outline-danger"
                              data-bs-toggle="modal"
                              data-bs-target="#rejectModal">
                        Reject
                      </button>
                    </div>
                  <% end %>

                  <% if @purchase_order.respond_to?(:approved?) && @purchase_order.approved? %>
                    <%= button_to 'Send to VMCOTT',
                          mark_ordered_purchase_order_path(@purchase_order),
                          method: :post,
                          class: 'btn btn-info w-100 mt-2' %>
                  <% end %>

                  <% if @purchase_order.respond_to?(:ordered?) && @purchase_order.ordered? && !@purchase_order.received? %>
                    <%= button_to 'Mark as Received',
                          mark_received_purchase_order_path(@purchase_order),
                          method: :post,
                          class: 'btn btn-primary w-100 mt-2' %>
                  <% end %>

                  <% if @purchase_order.respond_to?(:can_initiate_payment?) && @purchase_order.can_initiate_payment? && (current_user.finance? || current_user.admin?) %>
                    <%= link_to payment_page_purchase_order_path(@purchase_order),
                          class: 'btn btn-primary w-100 mt-2' do %>
                      <i class="fas fa-credit-card me-2"></i>
                      <% if @purchase_order.respond_to?(:is_trinidad_card_payment?) && @purchase_order.is_trinidad_card_payment? %>
                        Complete Trinidad Card Payment
                      <% else %>
                        Pay with Trinidad Card
                      <% end %>
                    <% end %>
                  <% end %>

                  <% if @purchase_order.respond_to?(:approved?) && @purchase_order.approved? && @purchase_order.payment_status == 'unpaid' && (current_user.finance? || current_user.admin?) %>
                    <button type="button" class="btn btn-success w-100 mt-2"
                            data-bs-toggle="modal"
                            data-bs-target="#markPaidModal">
                      <i class="fas fa-check-circle me-2"></i> Mark as Paid (Other Methods)
                    </button>
                  <% end %>
                
                <!-- VMCOTT ACTIONS -->
                <% else %>
                  <% if @purchase_order.vendor == 'VMCOTT' %>
                    
                    <!-- Review & Accept/Reject Items - For ordered POs -->
                    <% if @purchase_order.status == 'ordered' %>
                      <%= link_to acceptance_details_purchase_order_path(@purchase_order), 
                            class: 'btn w-100 mb-2', 
                            style: 'background: #5B21B6; color: white; border: none;' do %>
                        <i class="fas fa-clipboard-check me-2"></i> Review & Accept/Reject Items
                      <% end %>
                    <% end %>
                    
                    <!-- Create Work Order - For fully accepted POs -->
                    <% if @purchase_order.acceptance_status == 'fully_accepted' && @purchase_order.vmcott_status == 'pending_internal_work' %>
                      <%= link_to vmcott_internal_pos_from_po_path(purchase_order_id: @purchase_order.id), 
                            class: 'btn btn-warning w-100 mb-2' do %>
                        <i class="fas fa-tools me-2"></i> Create Work Order
                      <% end %>
                    <% end %>
                    
                    <!-- Mark Work In Progress - START BUTTON -->
                    <% if @purchase_order.vmcott_status == 'pending_internal_work' %>
                      <%= button_to mark_work_in_progress_purchase_order_path(@purchase_order), 
                            method: :post, 
                            class: 'btn btn-primary w-100 mb-2', 
                            data: { confirm: 'Start work on this purchase order?' } do %>
                        <i class="fas fa-play me-2"></i> Start Work
                      <% end %>
                    <% end %>
                    
                    <!-- FINISHED BUTTON - When work is in progress -->
                    <% if @purchase_order.vmcott_status == 'work_in_progress' %>
                      <%= button_to mark_internal_work_completed_purchase_order_path(@purchase_order), 
                            method: :post, 
                            class: 'btn btn-success w-100 mb-2', 
                            data: { confirm: 'Mark this work as completed?' } do %>
                        <i class="fas fa-check me-2"></i> Finished
                      <% end %>
                    <% end %>
                    
                    <!-- Mark Ready for Delivery -->
                    <% if @purchase_order.vmcott_status == 'internal_work_completed' %>
                      <%= button_to mark_ready_for_delivery_purchase_order_path(@purchase_order), 
                            method: :post, 
                            class: 'btn btn-warning w-100 mb-2', 
                            data: { confirm: 'Mark this order as ready for delivery?' } do %>
                        <i class="fas fa-truck me-2"></i> Ready for Delivery
                      <% end %>
                    <% end %>
                    
                    <!-- Mark Delivered -->
                    <% if @purchase_order.vmcott_status == 'ready_for_delivery' %>
                      <%= button_to mark_delivered_purchase_order_path(@purchase_order), 
                            method: :post, 
                            class: 'btn btn-success w-100 mb-2', 
                            data: { confirm: 'Mark this order as delivered?' } do %>
                        <i class="fas fa-check-circle me-2"></i> Mark Delivered
                      <% end %>
                    <% end %>
                    
                    <!-- Quick Reject All -->
                    <% if @purchase_order.status == 'ordered' && @purchase_order.acceptance_status != 'fully_accepted' %>
                      <button type="button" class="btn btn-danger w-100 mb-2" 
                              data-bs-toggle="modal" 
                              data-bs-target="#rejectModal">
                        <i class="fas fa-times-circle me-2"></i> Reject All Items
                      </button>
                    <% end %>
                  <% end %>
                <% end %>

                <!-- Cancel button (if applicable) - Available to both -->
                <% if @purchase_order.status != 'cancelled' && @purchase_order.status != 'paid' && @purchase_order.status != 'received' %>
                  <button type="button" class="btn btn-outline-danger w-100 mt-2" 
                          data-bs-toggle="modal" 
                          data-bs-target="#cancelModal">
                    <i class="fas fa-ban me-2"></i> Cancel Order
                  </button>
                <% end %>
              </div>
            </div>
          </div>

          <% if @purchase_order.notes.present? %>
            <hr>
            <div class="mt-3">
              <h6 class="text-muted mb-2">Notes</h6>
              <%= simple_format(@purchase_order.notes) %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Payment Timeline Card -->
      <% if @purchase_order.respond_to?(:is_trinidad_card_payment?) && @purchase_order.is_trinidad_card_payment? && @payment_audits.present? %>
        <div class="card mb-4 border-0 shadow-sm">
          <div class="card-header bg-white border-0">
            <div class="d-flex justify-content-between align-items-center">
              <h5 class="mb-0">
                <i class="fas fa-history text-primary me-2"></i>
                Payment Timeline
              </h5>
              <span class="badge bg-light text-dark">
                <%= @purchase_order.payment_audits.count %> events
              </span>
            </div>
          </div>

          <div class="card-body">
            <div class="timeline">
              <% @payment_audits.reverse_each.with_index do |audit, index| %>
                <div class="timeline-item <%= 'timeline-item-last' if index == @purchase_order.payment_audits.count - 1 %>">
                  <div class="timeline-marker">
                    <span class="badge rounded-circle bg-<%= audit.action_badge_color %> p-2">
                      <i class="fas <%= audit_action_icon(audit.action) %>"></i>
                    </span>
                  </div>

                  <div class="timeline-content">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                      <h6 class="mb-0">
                        <%= audit.action_humanized %>
                        <% if audit.duration_from_previous && audit.duration_from_previous > 0 %>
                          <small class="text-muted ms-2">
                            <i class="fas fa-clock me-1"></i>
                            <%= distance_of_time_in_words(audit.duration_from_previous) %>
                          </small>
                        <% end %>
                      </h6>

                      <small class="text-muted">
                        <%= audit.created_at.strftime('%b %d, %Y %I:%M %p') %>
                      </small>
                    </div>

                    <% if audit.user %>
                      <p class="text-muted small mb-2">
                        <i class="fas fa-user me-1"></i>
                        By <%= audit.user.name %>
                        <% if audit.ip_address %>
                          <span class="ms-2">
                            <i class="fas fa-globe me-1"></i>
                            <%= audit.ip_address %>
                          </span>
                        <% end %>
                      </p>
                    <% end %>

                    <% if audit.metadata.present? %>
                      <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#auditDetails<%= audit.id %>"
                                aria-expanded="false">
                          <i class="fas fa-info-circle me-1"></i>
                          View Details
                        </button>

                        <div class="collapse mt-2" id="auditDetails<%= audit.id %>">
                          <div class="card card-body bg-light">
                            <% raw_json = audit.metadata.is_a?(String) ? audit.metadata : audit.metadata.to_json %>
                            <pre class="mb-0 small"><%= raw_json.to_s.truncate(2000) %></pre>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Line Items -->
      <div class="card mb-4">
        <div class="card-header">
          <h6 class="mb-0">Line Items</h6>
        </div>

        <div class="card-body">
          <% if purchase_order_items.any? %>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Description</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                    <% if is_vmcott? && @purchase_order.status == 'ordered' %>
                      <th class="text-center">Status</th>
                    <% end %>
                  </tr>
                </thead>

                <tbody>
                  <% purchase_order_items.each_with_index do |item, index| %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= item.description %></td>
                      <td class="text-end"><%= item.quantity %></td>
                      <td class="text-end"><%= number_to_currency(item.unit_price, unit: 'TTD $') %></td>
                      <td class="text-end"><strong><%= number_to_currency(item.total_price, unit: 'TTD $') %></strong></td>
                      <% if is_vmcott? && @purchase_order.status == 'ordered' %>
                        <td class="text-center">
                          <% if item.is_accepted == true %>
                            <span class="badge bg-success">Accepted</span>
                          <% elsif item.is_accepted == false %>
                            <span class="badge bg-danger">Rejected</span>
                          <% else %>
                            <span class="badge bg-warning">Pending</span>
                          <% end %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>

                  <tr class="table-light">
                    <td colspan="4" class="text-end"><strong>Total:</strong></td>
                    <td class="text-end"><strong class="text-primary"><%= number_to_currency(@purchase_order.amount, unit: 'TTD $') %></strong></td>
                    <% if is_vmcott? && @purchase_order.status == 'ordered' %>
                      <td></td>
                    <% end %>
                  </tr>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center mb-0">No line items added</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Status Timeline - CORRECTED FOR YOUR WORKFLOW -->
      <div class="card mb-4">
        <div class="card-header">
          <h6 class="mb-0">Status Timeline</h6>
        </div>

        <div class="card-body">
          <div class="timeline">
            
            <!-- 1. PO Created (from Quotation) -->
            <div class="timeline-item completed">
              <div class="timeline-marker bg-secondary"></div>
              <div class="timeline-content">
                <h6 class="mb-0">PO Created</h6>
                <small class="text-muted"><%= @purchase_order.created_at.strftime('%b %d, %Y') %></small>
                <div class="small text-muted">From quotation acceptance</div>
              </div>
            </div>

            <!-- 2. Sent to VMCOTT (Ordered) -->
            <% if @purchase_order.ordered? || @purchase_order.received? || @purchase_order.paid? %>
              <div class="timeline-item <%= 'completed' if @purchase_order.received? || @purchase_order.paid? %> <%= 'current' if @purchase_order.ordered? && !@purchase_order.received? %>">
                <div class="timeline-marker <%= 'bg-success' if @purchase_order.received? || @purchase_order.paid? %> <%= 'bg-primary' if @purchase_order.ordered? && !@purchase_order.received? %>"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Sent to VMCOTT</h6>
                  <% if @purchase_order.ordered_at %>
                    <small class="text-muted"><%= @purchase_order.ordered_at.strftime('%b %d, %Y') %></small>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- 3. Waiting on Service (Work in Progress - VMCOTT side) -->
            <% if @purchase_order.ordered? && !@purchase_order.received? %>
              <div class="timeline-item current">
                <div class="timeline-marker bg-warning"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Waiting on Service</h6>
                  <small class="text-muted">VMCOTT is working on the vehicle</small>
                  <% if @purchase_order.respond_to?(:vmcott_status) && @purchase_order.vmcott_status.present? %>
                    <div class="small mt-1">
                      <span class="badge bg-info">VMCOTT: <%= @purchase_order.display_vmcott_status %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- 4. Work Completed (VMCOTT finishes) - Agency doesn't see this until they receive vehicle -->
            <% if @purchase_order.respond_to?(:vmcott_status) && @purchase_order.vmcott_status == 'internal_work_completed' && !@purchase_order.received? %>
              <div class="timeline-item">
                <div class="timeline-marker bg-success"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Work Completed by VMCOTT</h6>
                  <small class="text-muted">Ready for pickup</small>
                </div>
              </div>
            <% end %>

            <!-- 5. Ready for Delivery (VMCOTT marks ready) -->
            <% if @purchase_order.respond_to?(:vmcott_status) && @purchase_order.vmcott_status == 'ready_for_delivery' && !@purchase_order.received? %>
              <div class="timeline-item">
                <div class="timeline-marker bg-success"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Ready for Delivery</h6>
                  <small class="text-muted">Vehicle ready to be picked up</small>
                </div>
              </div>
            <% end %>

            <!-- 6. Vehicle Received (Agency marks received) -->
            <% if @purchase_order.received? %>
              <div class="timeline-item completed">
                <div class="timeline-marker bg-success"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Vehicle Received</h6>
                  <% if @purchase_order.received_at %>
                    <small class="text-muted"><%= @purchase_order.received_at.strftime('%b %d, %Y') %></small>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- 7. Completed (Paid) -->
            <% if @purchase_order.paid? %>
              <div class="timeline-item completed">
                <div class="timeline-marker bg-success"></div>
                <div class="timeline-content">
                  <h6 class="mb-0">Completed</h6>
                  <% if @purchase_order.paid_at %>
                    <small class="text-muted"><%= @purchase_order.paid_at.strftime('%b %d, %Y') %></small>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Rejected (if applicable) -->
            <% if @purchase_order.rejected? %>
              <div class="timeline-item">
                <div class="timeline-marker bg-danger"></div>
                <div class="timeline-content">
                  <h6 class="mb-0 text-danger">Rejected</h6>
                  <% if @purchase_order.rejected_at %>
                    <small class="text-danger"><%= @purchase_order.rejected_at.strftime('%b %d, %Y') %></small>
                  <% end %>
                  <% if @purchase_order.rejection_reason %>
                    <p class="small text-muted mt-1"><%= @purchase_order.rejection_reason %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- VMCOTT Status Card (for reference) -->
      <% if @purchase_order.respond_to?(:vmcott_status) && @purchase_order.vmcott_status.present? && @purchase_order.ordered? && !@purchase_order.received? %>
        <div class="card mb-4 border-info">
          <div class="card-header bg-info text-white">
            <h6 class="mb-0">VMCOTT Work Status</h6>
          </div>
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <div class="me-3">
                <span class="badge bg-<%= @purchase_order.vmcott_status_badge_color %> p-3">
                  <i class="fas fa-<%= 
                    case @purchase_order.vmcott_status
                    when 'pending_internal_work' then 'hourglass-half'
                    when 'work_in_progress' then 'tools'
                    when 'internal_work_completed' then 'check-double'
                    when 'ready_for_delivery' then 'truck'
                    when 'delivered' then 'check-circle'
                    else 'circle'
                    end %> fa-2x"></i>
                </span>
              </div>
              <div>
                <h5 class="mb-1"><%= @purchase_order.display_vmcott_status %></h5>
                <p class="text-muted mb-0 small">Current VMCOTT status</p>
              </div>
            </div>
            
            <% if @purchase_order.internal_pos.any? %>
              <hr>
              <h6 class="mb-2">Work Orders</h6>
              <% @purchase_order.internal_pos.each do |work_order| %>
                <div class="border rounded p-2 mb-2 bg-light">
                  <div class="d-flex justify-content-between">
                    <span class="fw-semibold"><%= work_order.work_order_number %></span>
                    <span class="badge bg-<%= work_order.status == 'completed' ? 'success' : 'warning' %>">
                      <%= work_order.status.humanize %>
                    </span>
                  </div>
                  <% if work_order.estimated_completion_date %>
                    <small class="text-muted">Est. completion: <%= work_order.estimated_completion_date.strftime('%b %d, %Y') %></small>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Generated Invoices -->
      <% if invoices.any? %>
        <div class="card mb-4">
          <div class="card-header">
            <h6 class="mb-0">Generated Invoices</h6>
          </div>
          <div class="card-body">
            <div class="list-group">
              <% invoices.each do |invoice| %>
                <%= link_to invoice, class: 'list-group-item list-group-item-action' do %>
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1"><%= invoice.invoice_number %></h6>
                    <small><%= invoice.status&.humanize || 'Unknown' %></small>
                  </div>
                  <p class="mb-1">Amount: <%= number_to_currency(invoice.amount, unit: 'TTD $') %></p>
                  <small>Created: <%= invoice.created_at.strftime('%b %d, %Y') %></small>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Payment History -->
      <% if payment_histories.any? %>
        <div class="card mb-4">
          <div class="card-header">
            <h6 class="mb-0">Payment History</h6>
          </div>
          <div class="card-body">
            <div class="list-group">
              <% payment_histories.each do |payment| %>
                <div class="list-group-item">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1"><%= number_to_currency(payment.amount, unit: 'TTD $') %></h6>
                    <small><%= payment.status&.humanize || 'Unknown' %></small>
                  </div>
                  <p class="mb-1"><%= payment.payment_method&.humanize %></p>
                  <small class="text-muted">
                    <%= payment.payment_date&.strftime('%b %d, %Y %I:%M %p') || 'Date not available' %>
                    <% if payment.reference_number %>
                      | Ref: <%= payment.reference_number %>
                    <% end %>
                  </small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Reject Purchase Order</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: reject_purchase_order_path(@purchase_order), method: :post do |f| %>
        <div class="modal-body">
          <p>You are rejecting purchase order <strong><%= @purchase_order.po_number %></strong>.</p>

          <div class="mb-3">
            <%= label_tag :reason, 'Reason for Rejection (Optional)', class: 'form-label' %>
            <%= text_area_tag :reason, nil,
                  class: 'form-control',
                  rows: 3,
                  placeholder: 'Please provide a reason for rejecting this purchase order...' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= submit_tag 'Reject Purchase Order', class: 'btn btn-danger' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">Cancel Purchase Order</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: cancel_purchase_order_path(@purchase_order), method: :post do |f| %>
        <div class="modal-body">
          <p>You are cancelling purchase order <strong><%= @purchase_order.po_number %></strong>.</p>
          <p class="text-muted">This action cannot be undone.</p>

          <div class="mb-3">
            <%= label_tag :cancellation_reason, 'Reason for Cancellation (Optional)', class: 'form-label' %>
            <%= text_area_tag :cancellation_reason, nil,
                  class: 'form-control',
                  rows: 2,
                  placeholder: 'Please provide a reason for cancelling this purchase order...' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep it</button>
          <%= submit_tag 'Yes, Cancel Order', class: 'btn btn-warning' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Mark Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Mark Purchase Order as Paid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: mark_paid_purchase_order_path(@purchase_order), method: :post do |f| %>
        <div class="modal-body">
          <p>You are marking <strong><%= @purchase_order.po_number %></strong> as paid.</p>

          <div class="mb-3">
            <%= label_tag :payment_method, 'Payment Method', class: 'form-label' %>
            <%= select_tag :payment_method,
                  options_for_select(PurchaseOrder.payment_methods.keys.map { |m| [m.humanize.titleize, m] }),
                  class: 'form-select', required: true %>
          </div>

          <div class="mb-3">
            <%= label_tag :payment_reference, 'Reference Number', class: 'form-label' %>
            <%= text_field_tag :payment_reference, nil,
                  class: 'form-control',
                  placeholder: 'Bank transfer ref, cheque #, transaction ID',
                  required: true %>
            <div class="form-text">Enter the payment reference from your bank or payment portal</div>
          </div>

          <div class="mb-3">
            <%= label_tag :payment_notes, 'Notes (Optional)', class: 'form-label' %>
            <%= text_area_tag :payment_notes, nil,
                  class: 'form-control',
                  rows: 2,
                  placeholder: 'Any additional notes about this payment...' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= submit_tag 'Mark as Paid', class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Authorize Payment Modal -->
<div class="modal fade" id="authorizePaymentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Authorize Trinidad Card Payment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: authorize_payment_purchase_order_path(@purchase_order), method: :post do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Authorization Required</strong>
            <p class="mb-0 mt-2">You are authorizing payment for:</p>
          </div>

          <div class="card mb-3">
            <div class="card-body">
              <h6 class="mb-2">Purchase Order: <%= @purchase_order.po_number %></h6>
              <h4 class="text-success mb-0"><%= number_to_currency(@purchase_order.amount, unit: 'TTD $') %></h4>
            </div>
          </div>

          <p class="mb-3">By authorizing this payment, you confirm that:</p>

          <ul class="small">
            <li>The vendor has delivered the goods/services</li>
            <li>The amount matches the invoice/agreement</li>
            <li>All required approvals have been obtained</li>
            <li>This payment complies with agency financial policies</li>
            <li>Funds are available in the appropriate account</li>
          </ul>

          <div class="mb-3">
            <%= label_tag :authorization_notes, 'Authorization Notes (Optional)', class: 'form-label' %>
            <%= text_area_tag :authorization_notes, nil,
                  class: 'form-control',
                  rows: 2,
                  placeholder: 'Any notes about this authorization...' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= submit_tag 'Authorize Payment', class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .timeline {
    position: relative;
    padding-left: 30px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: #e9ecef;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 20px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -30px;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #6c757d;
    border: 3px solid white;
    z-index: 1;
  }

  .timeline-item.completed .timeline-marker {
    background-color: #198754;
  }

  .timeline-item.current .timeline-marker {
    background-color: #0d6efd;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.25);
  }

  .timeline-content {
    padding-left: 15px;
  }

  .timeline-item-last {
    margin-bottom: 0;
  }
  
  .btn-vmcott {
    background: #5B21B6;
    color: white;
    border: none;
  }
  
  .btn-vmcott:hover {
    background: #7C3AED;
    color: white;
  }
</style>