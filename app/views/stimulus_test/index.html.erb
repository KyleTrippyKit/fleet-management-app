<!DOCTYPE html>
<html>
<head>
  <title>Stimulus Test - Simple</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <%= csrf_meta_tags %>
  <%= javascript_importmap_tags %>

  <style>
    .test-box {
      padding: 40px;
      border: 2px solid #ddd;
      border-radius: 8px;
      margin: 40px auto;
      max-width: 600px;
      text-align: center;
      transition: all 0.3s;
      font-family: Arial, sans-serif;
    }

    .test-box.green {
      background-color: #e8f5e9;
      border-color: #4caf50;
    }
  </style>
</head>

<body>
  <!-- Stimulus Controller Attached -->
  <div data-controller="hello" class="test-box">
    <h1>🔍 Stimulus Test</h1>
    <p>If this box turns <strong>GREEN</strong>, Stimulus is working!</p>
    <p>Check the console for confirmation.</p>
  </div>
</body>
</html>