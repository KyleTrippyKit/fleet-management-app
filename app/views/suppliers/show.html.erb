<%# app/views/suppliers/show.html.erb %>
<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to 'Vendors', suppliers_path %></li>
          <li class="breadcrumb-item active"><%= @supplier.name %></li>
        </ol>
      </nav>
      
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1"><%= @supplier.name %></h1>
          <p class="text-muted mb-0">
            <i class="bi bi-person me-1"></i>
            <%= @supplier.contact_person || 'No contact person' %>
            •
            <i class="bi bi-telephone ms-2 me-1"></i>
            <%= @supplier.phone || 'No phone' %>
          </p>
        </div>
        <div>
          <%= link_to 'Edit', edit_supplier_path(@supplier), class: 'btn btn-warning' %>
          <%= link_to 'Manage Stock', update_stock_supplier_path(@supplier), class: 'btn btn-info' %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
      <div class="card border-0 shadow-sm h-100 stats-card">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-cash-stack text-primary fs-4"></i>
            </div>
            <div class="flex-grow-1">
              <p class="text-uppercase small fw-bold text-dark mb-1">TOTAL SPENT</p>
              <h3 class="fw-bold mb-1"><%= number_to_currency(@total_spent) %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
      <div class="card border-0 shadow-sm h-100 stats-card">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-clock text-warning fs-4"></i>
            </div>
            <div class="flex-grow-1">
              <p class="text-uppercase small fw-bold text-dark mb-1">OUTSTANDING</p>
              <h3 class="fw-bold mb-1"><%= number_to_currency(@outstanding) %></h3>
              <small class="text-muted"><%= @overdue_invoices.count %> overdue invoices</small>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
      <div class="card border-0 shadow-sm h-100 stats-card">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="bg-info bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-box text-info fs-4"></i>
            </div>
            <div class="flex-grow-1">
              <p class="text-uppercase small fw-bold text-dark mb-1">INVENTORY ITEMS</p>
              <h3 class="fw-bold mb-1"><%= @parts.count %></h3>
              <%= link_to 'Add Item', new_inventory_item_path(supplier_id: @supplier.id), class: 'btn btn-sm btn-outline-info mt-2' %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
      <div class="card border-0 shadow-sm h-100 stats-card">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
              <i class="bi bi-file-text text-success fs-4"></i>
            </div>
            <div class="flex-grow-1">
              <p class="text-uppercase small fw-bold text-dark mb-1">PURCHASE ORDERS</p>
              <h3 class="fw-bold mb-1"><%= @purchase_orders.count %></h3>
              <small class="text-muted"><%= @purchase_orders.where(status: 'draft').count %> pending</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <!-- Left Column: Vendor Info & Actions -->
    <div class="col-lg-4">
      <!-- Vendor Details -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Vendor Details</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">
              <% if @supplier.email.present? %>
                <%= mail_to @supplier.email %>
              <% else %>
                <span class="text-muted">No email</span>
              <% end %>
            </dd>
            
            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">
              <%= @supplier.address.presence || content_tag(:span, 'No address', class: 'text-muted') %>
            </dd>
            
            <dt class="col-sm-4">Payment Terms</dt>
            <dd class="col-sm-8">
              <%= @supplier.payment_terms.presence || content_tag(:span, 'Net 30', class: 'text-muted') %>
            </dd>
            
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
              <span class="badge bg-<%= @supplier.is_active? ? 'success' : 'danger' %>">
                <%= @supplier.is_active? ? 'Active' : 'Inactive' %>
              </span>
            </dd>
            
            <dt class="col-sm-4">Notes</dt>
            <dd class="col-sm-8">
              <%= @supplier.notes.presence || content_tag(:span, 'No notes', class: 'text-muted') %>
            </dd>
          </dl>
        </div>
      </div>
      
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <%= link_to 'Upload Invoice', '#upload-invoice-form', 
                class: 'btn btn-primary',
                data: { bs_toggle: 'collapse' } %>
            <%= link_to 'Manage Stock', update_stock_supplier_path(@supplier), 
                class: 'btn btn-info' %>
            <%= link_to 'View All Invoices', invoices_supplier_path(@supplier), 
                class: 'btn btn-outline-primary' %>
            <%= link_to 'View Vendor Invoices', vendor_invoices_path(supplier_id: @supplier.id), 
                class: 'btn btn-outline-info' %>
            <%= link_to 'Create Purchase Order', new_purchase_order_path(vendor: @supplier.name), 
                class: 'btn btn-outline-success' %>
          </div>
        </div>
      </div>
      
      <!-- Upload Invoice Form (Collapsed) -->
      <div class="collapse" id="upload-invoice-form">
        <div class="card">
          <div class="card-header">
            <h5 class="card-title mb-0">Upload New Invoice</h5>
          </div>
          <div class="card-body">
            <%= form_with(model: [@supplier, VendorInvoice.new], 
                  url: upload_invoice_supplier_path(@supplier), 
                  local: true, multipart: true) do |f| %>
              <div class="mb-3">
                <%= f.label :invoice_number, 'Invoice Number *', class: 'form-label' %>
                <%= f.text_field :invoice_number, class: 'form-control', required: true %>
              </div>
              
              <div class="row mb-3">
                <div class="col-md-6">
                  <%= f.label :invoice_date, 'Invoice Date *', class: 'form-label' %>
                  <%= f.date_field :invoice_date, class: 'form-control', required: true, 
                        value: Date.today.to_s %>
                </div>
                <div class="col-md-6">
                  <%= f.label :due_date, 'Due Date', class: 'form-label' %>
                  <%= f.date_field :due_date, class: 'form-control', 
                        value: (Date.today + 30.days).to_s %>
                </div>
              </div>
              
              <div class="mb-3">
                <%= f.label :amount, 'Amount (TTD) *', class: 'form-label' %>
                <%= f.number_field :amount, step: '0.01', class: 'form-control', required: true %>
              </div>
              
              <div class="mb-3">
                <%= f.label :purchase_order_id, 'Link to Purchase Order', class: 'form-label' %>
                <%= f.collection_select :purchase_order_id, 
                    @purchase_orders, :id, :po_number, 
                    { include_blank: 'Select PO (optional)' }, 
                    class: 'form-select' %>
              </div>
              
              <div class="mb-3">
                <%= f.label :invoice_scan, 'Upload Scanned Invoice', class: 'form-label' %>
                <%= f.file_field :invoice_scan, class: 'form-control', 
                      accept: 'image/*,.pdf,.doc,.docx' %>
                <div class="form-text">Upload PDF or image of the physical invoice (max 10MB)</div>
              </div>
              
              <div class="mb-3">
                <%= f.label :description, 'Description', class: 'form-label' %>
                <%= f.text_area :description, class: 'form-control', rows: 2, 
                      placeholder: 'Optional description or notes...' %>
              </div>
              
              <div class="d-grid">
                <%= f.submit 'Upload Invoice', class: 'btn btn-primary' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Column: Invoices and Inventory -->
    <div class="col-lg-8">
      <!-- Recent Invoices -->
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">Recent Invoices</h5>
          <div class="d-flex gap-2">
            <input type="text" 
                   class="form-control form-control-sm" 
                   placeholder="Search invoices..."
                   id="invoice-search"
                   data-controller="search"
                   data-action="input->search#perform"
                   data-search-url="<%= invoices_supplier_path(@supplier, format: :json) %>">
            <%= link_to 'View All', invoices_supplier_path(@supplier), class: 'btn btn-sm btn-outline-primary' %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0" id="invoices-table">
              <thead>
                <tr>
                  <th>Invoice #</th>
                  <th>Date</th>
                  <th>Amount</th>
                  <th>PO Number</th>
                  <th>Status</th>
                  <th>Due Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="invoices-body">
                <% @vendor_invoices.limit(10).each do |invoice| %>
                  <tr>
                    <td>
                      <strong><%= invoice.invoice_number %></strong>
                      <% if invoice.invoice_scan.attached? %>
                        <i class="bi bi-paperclip text-info ms-1" title="Has attached scan"></i>
                      <% end %>
                    </td>
                    <td><%= invoice.invoice_date.strftime('%d/%m/%Y') %></td>
                    <td><%= number_to_currency(invoice.amount) %></td>
                    <td>
                      <% if invoice.purchase_order %>
                        <%= link_to invoice.purchase_order.po_number, 
                            purchase_order_path(invoice.purchase_order), 
                            class: 'badge bg-info text-decoration-none' %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge bg-<%= invoice_status_badge_color(invoice.status) %>">
                        <%= invoice.status.titleize %>
                      </span>
                    </td>
                    <td>
                      <% if invoice.due_date %>
                        <span class="<%= invoice.due_date < Date.today && !invoice.paid? ? 'text-danger' : '' %>">
                          <%= invoice.due_date.strftime('%d/%m/%Y') %>
                          <% if invoice.due_date < Date.today && !invoice.paid? %>
                            <br><small class="text-danger">(<%= invoice.days_overdue %> days overdue)</small>
                          <% end %>
                        </span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <%= link_to 'View', vendor_invoice_path(invoice), 
                              class: 'btn btn-outline-primary' %>
                        <% if invoice.invoice_scan.attached? %>
                          <%= link_to 'Scan', rails_blob_path(invoice.invoice_scan, disposition: 'inline'),
                                target: '_blank', class: 'btn btn-outline-info' %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @vendor_invoices.count > 10 %>
            <div class="card-footer text-center">
              <%= link_to 'View All Invoices', invoices_supplier_path(@supplier), 
                  class: 'btn btn-sm btn-link' %>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Inventory Items -->
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">Inventory Items from this Vendor</h5>
          <div>
            <%= link_to 'Add New Item', new_inventory_item_path(supplier_id: @supplier.id), 
                  class: 'btn btn-sm btn-primary' %>
            <%= link_to 'Manage Stock', update_stock_supplier_path(@supplier), 
                  class: 'btn btn-sm btn-info' %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Part Name</th>
                  <th>Part #</th>
                  <th>Stock</th>
                  <th>Cost Price</th>
                  <th>Sale Price</th>
                  <th>Margin</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% @parts.each do |part| %>
                  <tr>
                    <td>
                      <% if part.persisted? && defined?(part_path) %>
                        <%= link_to part.name, part_path(part) %>
                      <% else %>
                        <strong><%= part.name %></strong>
                      <% end %>
                      <br><small class="text-muted"><%= part.category %></small>
                    </td>
                    <td><code><%= part.part_number %></code></td>
                    <td>
                      <span class="badge bg-<%= part.current_stock <= part.minimum_stock ? 'warning' : 'success' %>">
                        <%= part.current_stock %>
                      </span>
                      / <%= part.reorder_point %>
                      <% if part.current_stock <= part.minimum_stock %>
                        <br><small class="text-danger">Needs reorder!</small>
                      <% end %>
                    </td>
                    <td><%= number_to_currency(part.cost_price) if part.cost_price %></td>
                    <td><%= number_to_currency(part.sale_price) if part.sale_price %></td>
                    <td>
                      <% if part.cost_price && part.sale_price && part.cost_price > 0 %>
                        <% profit_margin = ((part.sale_price - part.cost_price) / part.cost_price * 100).round(1) %>
                        <span class="badge bg-<%= profit_margin >= 20 ? 'success' : 'warning' %>">
                          <%= number_to_percentage(profit_margin, precision: 1) %>
                        </span>
                      <% else %>
                        <span class="badge bg-secondary">N/A</span>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge bg-<%= part.is_active? ? 'success' : 'secondary' %>">
                        <%= part.is_active? ? 'Active' : 'Inactive' %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @parts.empty? %>
            <div class="text-center py-4">
              <i class="bi bi-box text-muted fs-1 mb-3"></i>
              <h5>No inventory items</h5>
              <p class="text-muted">Add inventory items from this vendor</p>
              <%= link_to 'Add First Item', new_inventory_item_path(supplier_id: @supplier.id), 
                    class: 'btn btn-primary btn-sm' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# JavaScript for live invoice search - FIXED VERSION %>
<%= javascript_tag do %>
  document.addEventListener('turbo:load', function() {
    const invoiceSearch = document.getElementById('invoice-search');
    const supplierId = <%= @supplier.id %>;
    
    if (invoiceSearch) {
      let searchTimeout;
      
      invoiceSearch.addEventListener('input', function(e) {
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();
        
        searchTimeout = setTimeout(() => {
          if (query.length > 0) {
            // Show loading
            const tbody = document.getElementById('invoices-body');
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-3"><div class="spinner-border spinner-border-sm me-2"></div>Searching...</td></tr>';
            
            fetch(`/suppliers/${supplierId}/invoices.json?q=${encodeURIComponent(query)}`)
              .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
              })
              .then(data => {
                updateInvoiceTable(data);
              })
              .catch(error => {
                console.error('Search error:', error);
                const tbody = document.getElementById('invoices-body');
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-3">Error loading invoices. Please try again.</td></tr>';
              });
          } else {
            // Reload original invoices
            window.location.reload();
          }
        }, 500);
      });
    }
  });
  
  function updateInvoiceTable(invoices) {
    const tbody = document.getElementById('invoices-body');
    if (!tbody) return;
    
    tbody.innerHTML = '';
    
    if (invoices.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">No invoices found</td></tr>';
      return;
    }
    
    invoices.forEach(invoice => {
      const dueDate = invoice.due_date ? new Date(invoice.due_date) : null;
      const today = new Date();
      const isOverdue = dueDate && dueDate < today && invoice.status !== 'paid';
      const daysOverdue = isOverdue ? Math.floor((today - dueDate) / (1000 * 60 * 60 * 24)) : 0;
      
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>
          <strong>${invoice.invoice_number}</strong>
        </td>
        <td>${new Date(invoice.invoice_date).toLocaleDateString('en-GB')}</td>
        <td>$${parseFloat(invoice.amount).toFixed(2)}</td>
        <td>
          ${invoice.purchase_order_id ? 
            '<span class="badge bg-info">Linked</span>' : 
            '<span class="text-muted">—</span>'}
        </td>
        <td>
          <span class="badge bg-${getStatusColor(invoice.status)}">
            ${invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1)}
          </span>
        </td>
        <td>
          ${dueDate ? new Date(invoice.due_date).toLocaleDateString('en-GB') : '—'}
          ${isOverdue ? `<br><small class="text-danger">(${daysOverdue} days overdue)</small>` : ''}
        </td>
        <td>
          <div class="btn-group btn-group-sm">
            <a href="/vendor_invoices/${invoice.id}" class="btn btn-outline-primary">View</a>
          </div>
        </td>
      `;
      tbody.appendChild(row);
    });
  }
  
  function getStatusColor(status) {
    switch(status) {
      case 'paid': return 'success';
      case 'reviewed': return 'info';
      case 'pending': return 'warning';
      case 'disputed': return 'danger';
      default: return 'secondary';
    }
  }
<% end %>