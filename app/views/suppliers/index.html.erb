<%# app/views/suppliers/index.html.erb %>
<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="h3 mb-0">Vendors</h1>
      <p class="text-muted">Manage your suppliers and vendor relationships</p>
    </div>
  </div>
  
  <!-- Action Bar -->
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body p-2">
          <div class="input-group">
            <span class="input-group-text">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" 
                   id="vendor-search" 
                   class="form-control" 
                   placeholder="Search vendors by name, email, phone, or contact..."
                   data-controller="search"
                   data-action="input->search#perform"
                   data-search-target="input">
            <%= link_to 'New Vendor', new_supplier_path, class: 'btn btn-primary ms-2' %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between">
            <span class="text-muted">Active Vendors:</span>
            <strong><%= @suppliers.count %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Vendor Cards -->
  <div class="row g-3 mb-5" id="vendors-container">
    <% if @suppliers.empty? %>
      <div class="col-12">
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="bi bi-building text-muted fs-1 mb-3"></i>
            <h4>No vendors found</h4>
            <p class="text-muted">Add your first vendor to get started.</p>
            <%= link_to 'Add First Vendor', new_supplier_path, class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    <% else %>
      <% @suppliers.each do |supplier| %>
        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6" data-search-target="item">
          <div class="card border-0 shadow-sm h-100 stats-card hover-lift">
            <div class="card-body p-3">
              <div class="d-flex align-items-start mb-3">
                <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                  <i class="bi bi-building text-primary fs-4"></i>
                </div>
                <div class="flex-grow-1">
                  <h5 class="fw-bold mb-1"><%= supplier.name %></h5>
                  <p class="text-muted small mb-1">
                    <i class="bi bi-person me-1"></i>
                    <%= supplier.contact_person || 'No contact' %>
                  </p>
                  <p class="text-muted small mb-2">
                    <i class="bi bi-telephone me-1"></i>
                    <%= supplier.phone || 'No phone' %>
                  </p>
                </div>
              </div>
              
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-<%= supplier.is_active? ? 'success' : 'danger' %>">
                  <%= supplier.is_active? ? 'Active' : 'Inactive' %>
                </span>
                <small class="text-muted">
                  <%= supplier.vendor_invoices.count %> invoices
                </small>
              </div>
              
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <small class="text-muted d-block">Outstanding</small>
                  <strong class="<%= supplier.total_outstanding > 0 ? 'text-warning' : 'text-success' %>">
                    <%= number_to_currency(supplier.total_outstanding) %>
                  </strong>
                </div>
                <div class="d-flex gap-2">
                  <%= link_to 'View', supplier_path(supplier), class: 'btn btn-sm btn-outline-primary' %>
                  <%= link_to 'Invoices', invoices_supplier_path(supplier), class: 'btn btn-sm btn-outline-info' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# JavaScript for live search %>
<%= javascript_tag do %>
  document.addEventListener('turbo:load', function() {
    const searchInput = document.getElementById('vendor-search');
    const vendorCards = document.querySelectorAll('[data-search-target="item"]');
    
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase().trim();
        
        vendorCards.forEach(card => {
          const text = card.textContent.toLowerCase();
          if (searchTerm === '') {
            card.style.display = 'block';
          } else {
            card.style.display = text.includes(searchTerm) ? 'block' : 'none';
          }
        });
      });
    }
  });
<% end %>