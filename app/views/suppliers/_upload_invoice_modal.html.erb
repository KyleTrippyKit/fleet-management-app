<div id="uploadInvoiceModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Upload Invoice</h3>
      
      <%= form_with model: VendorInvoice.new, url: upload_invoice_supplier_path(supplier), 
            html: { multipart: true, class: "space-y-4" }, local: true do |f| %>
        <%= f.hidden_field :supplier_id, value: supplier.id %>
        
        <div>
          <%= f.label :invoice_number, "Invoice Number *", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :invoice_number, required: true, 
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
        </div>
        
        <div>
          <%= f.label :invoice_date, "Invoice Date *", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :invoice_date, required: true, 
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
        </div>
        
        <div>
          <%= f.label :amount, "Amount *", class: "block text-sm font-medium text-gray-700" %>
          <%= f.number_field :amount, step: "0.01", required: true,
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
        </div>
        
        <div>
          <%= f.label :due_date, "Due Date", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :due_date,
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
        </div>
        
        <div>
          <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :description, rows: 3,
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm" %>
        </div>
        
        <!-- UPDATED: Changed from invoice_file to invoice_scan -->
        <div>
          <%= f.label :invoice_scan, "Upload Invoice (PDF/Image) *", class: "block text-sm font-medium text-gray-700" %>
          <%= f.file_field :invoice_scan, accept: '.pdf,.jpg,.jpeg,.png,.gif', required: true,
                class: "mt-1 block w-full" %>
        </div>
        
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeUploadModal()" 
                  class="px-4 py-2 text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200">
            Cancel
          </button>
          <%= f.submit "Upload Invoice", 
                class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
function showUploadForm(supplierId) {
  fetch(`/suppliers/${supplierId}/invoices/new`)
    .then(response => response.text())
    .then(html => {
      document.body.insertAdjacentHTML('beforeend', html);
      document.getElementById('uploadInvoiceModal').classList.remove('hidden');
    });
}

function closeUploadModal() {
  const modal = document.getElementById('uploadInvoiceModal');
  if (modal) {
    modal.remove();
  }
}
</script>