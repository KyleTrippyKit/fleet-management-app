<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="h3 mb-0">New Vendor</h1>
      <p class="text-muted">Add a new supplier to your system</p>
    </div>
  </div>
  
  <div class="row">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <%= form_with(model: @supplier, local: true) do |form| %>
            <% if @supplier.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(@supplier.errors.count, "error") %> prohibited this vendor from being saved:</h4>
                <ul>
                  <% @supplier.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :name, "Vendor Name *", class: 'form-label' %>
                <%= form.text_field :name, class: 'form-control', required: true %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= form.label :contact_person, "Contact Person", class: 'form-label' %>
                <%= form.text_field :contact_person, class: 'form-control' %>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :email, "Email", class: 'form-label' %>
                <%= form.email_field :email, class: 'form-control' %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= form.label :phone, "Phone", class: 'form-label' %>
                <%= form.text_field :phone, class: 'form-control' %>
              </div>
            </div>
            
            <div class="mb-3">
              <%= form.label :address, "Address", class: 'form-label' %>
              <%= form.text_area :address, class: 'form-control', rows: 2 %>
            </div>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :payment_terms, "Payment Terms", class: 'form-label' %>
                <%= form.select :payment_terms, 
                    ['Net 30', 'Net 60', 'Net 90', 'Upon Receipt', '50% Advance'], 
                    { include_blank: 'Select terms' }, 
                    class: 'form-select' %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= form.label :is_active, "Status", class: 'form-label' %>
                <div class="form-check form-switch mt-2">
                  <%= form.check_box :is_active, class: 'form-check-input', checked: true %>
                  <%= form.label :is_active, "Active Vendor", class: 'form-check-label' %>
                </div>
              </div>
            </div>
            
            <div class="mb-4">
              <%= form.label :notes, "Notes", class: 'form-label' %>
              <%= form.text_area :notes, class: 'form-control', rows: 3 %>
            </div>
            
            <div class="d-flex justify-content-between">
              <%= link_to 'Cancel', suppliers_path, class: 'btn btn-outline-secondary' %>
              <%= form.submit 'Create Vendor', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Quick Tips</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-2">
              <i class="bi bi-info-circle text-primary me-2"></i>
              <small>Required fields are marked with *</small>
            </li>
            <li class="mb-2">
              <i class="bi bi-building text-primary me-2"></i>
              <small>Add vendors you purchase parts from</small>
            </li>
            <li class="mb-2">
              <i class="bi bi-file-earmark-text text-primary me-2"></i>
              <small>After adding, you can upload their invoices</small>
            </li>
            <li>
              <i class="bi bi-box text-primary me-2"></i>
              <small>Link parts to this vendor for inventory tracking</small>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>