<!-- app/views/suppliers/invoices.html.erb -->
<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pt-3">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item">
            <%= link_to "Suppliers", suppliers_path, class: "text-decoration-none" %>
          </li>
          <li class="breadcrumb-item">
            <%= link_to truncate(@supplier.name, length: 20), supplier_path(@supplier), class: "text-decoration-none" %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">Invoices</li>
        </ol>
      </nav>
      <h1 class="h2 mb-0">Invoices</h1>
      <p class="text-muted mb-0"><%= @supplier.name %></p>
    </div>
    
    <div>
      <%= link_to new_invoice_supplier_path(@supplier), 
            class: 'btn btn-primary',
            data: { 
              bs_toggle: 'modal',
              bs_target: '#uploadInvoiceModal'
            } do %>
        <i class="bi bi-plus-lg me-1"></i> New Invoice
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
              <i class="bi bi-receipt text-primary"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1">Total Invoices</h6>
              <h4 class="mb-0"><%= @vendor_invoices.total_count %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-2 rounded me-3">
              <i class="bi bi-currency-dollar text-success"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1">Total Value</h6>
              <h4 class="mb-0"><%= number_to_currency(@total) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 p-2 rounded me-3">
              <i class="bi bi-check-circle text-success"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1">Paid</h6>
              <h4 class="mb-0"><%= number_to_currency(@paid) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
              <i class="bi bi-clock text-warning"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1">Outstanding</h6>
              <h4 class="mb-0"><%= number_to_currency(@outstanding) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: invoices_supplier_path(@supplier), method: :get, local: true, class: "row g-3" do |f| %>
        <div class="col-md-3">
          <%= f.label :search, "Search", class: "form-label" %>
          <%= f.text_field :search, 
                placeholder: "Invoice #, description...", 
                value: params[:search],
                class: "form-control" %>
        </div>
        
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, 
                options_for_select([
                  ['All', ''],
                  ['Pending', 'pending'],
                  ['Reviewed', 'reviewed'],
                  ['Paid', 'paid'],
                  ['Disputed', 'disputed']
                ], params[:status]),
                {},
                class: "form-select" %>
        </div>
        
        <div class="col-md-3">
          <%= f.label :start_date, "From Date", class: "form-label" %>
          <%= f.date_field :start_date, 
                value: params[:start_date],
                class: "form-control" %>
        </div>
        
        <div class="col-md-3">
          <%= f.label :end_date, "To Date", class: "form-label" %>
          <%= f.date_field :end_date, 
                value: params[:end_date],
                class: "form-control" %>
        </div>
        
        <div class="col-12">
          <div class="d-flex justify-content-between">
            <div>
              <% if params[:search].present? || params[:status].present? || params[:start_date].present? %>
                <%= link_to 'Clear Filters', invoices_supplier_path(@supplier), class: 'btn btn-link text-decoration-none' %>
              <% end %>
            </div>
            <div>
              <%= f.submit "Apply Filters", class: "btn btn-primary" %>
              <%= link_to 'Export CSV', invoices_supplier_path(@supplier, format: :csv), class: 'btn btn-outline-secondary ms-2' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Invoices Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if @vendor_invoices.empty? %>
        <div class="text-center py-5">
          <i class="bi bi-receipt text-muted fs-1 mb-3"></i>
          <h5 class="text-muted mb-3">No invoices found</h5>
          <% unless params[:search] || params[:status] || params[:start_date] %>
            <%= link_to new_invoice_supplier_path(@supplier), 
                  class: 'btn btn-primary',
                  data: { 
                    bs_toggle: 'modal',
                    bs_target: '#uploadInvoiceModal'
                  } do %>
              <i class="bi bi-plus-lg me-1"></i> Add First Invoice
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="border-0">Invoice #</th>
                <th class="border-0">Date</th>
                <th class="border-0">Amount</th>
                <th class="border-0">Due Date</th>
                <th class="border-0">Status</th>
                <th class="border-0 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @vendor_invoices.each do |invoice| %>
                <% is_overdue = invoice.due_date && invoice.due_date < Date.today && invoice.status.in?(%w[pending reviewed]) %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-2">
                        <i class="bi bi-receipt text-primary"></i>
                      </div>
                      <div>
                        <div class="fw-medium"><%= invoice.invoice_number %></div>
                        <% if invoice.description.present? %>
                          <small class="text-muted"><%= truncate(invoice.description, length: 40) %></small>
                        <% end %>
                        <% if invoice.purchase_order %>
                          <small class="text-muted d-block">PO: <%= invoice.purchase_order.po_number %></small>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td><%= invoice.invoice_date.strftime('%b %d, %Y') %></td>
                  <td class="fw-semibold"><%= number_to_currency(invoice.amount) %></td>
                  <td>
                    <% if invoice.due_date %>
                      <div class="<%= is_overdue ? 'text-danger' : '' %>">
                        <%= invoice.due_date.strftime('%b %d, %Y') %>
                        <% if is_overdue %>
                          <div class="small text-danger">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <%= (Date.today - invoice.due_date).to_i %> days overdue
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge <%= invoice_status_color(invoice.status) %>">
                      <%= invoice.status.titleize %>
                    </span>
                    <% if is_overdue %>
                      <span class="badge bg-danger ms-1">Overdue</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group" role="group">
                      <% if invoice.invoice_scan.attached? %>
                        <%= link_to rails_blob_path(invoice.invoice_scan, disposition: 'attachment'), 
                              class: 'btn btn-sm btn-outline-secondary', 
                              title: 'Download' do %>
                          <i class="bi bi-download"></i>
                        <% end %>
                      <% end %>
                      
                      <%= link_to vendor_invoice_path(invoice), 
                            class: 'btn btn-sm btn-outline-secondary',
                            title: 'View' do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      
                      <% if invoice.status == 'pending' || invoice.status == 'reviewed' %>
                        <div class="dropdown position-static"> <!-- Changed to position-static -->
                          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                  type="button" 
                                  data-bs-toggle="dropdown" 
                                  aria-expanded="false">
                            <i class="bi bi-gear"></i>
                          </button>
                          <ul class="dropdown-menu dropdown-menu-end position-absolute"> <!-- Added position-absolute -->
                            <li>
                              <%= form_with url: process_invoice_supplier_path(@supplier, invoice_id: invoice.id, action_type: 'mark_paid'), 
                                    method: :post, 
                                    class: 'd-inline' do %>
                                <button type="submit" class="dropdown-item">
                                  <i class="bi bi-check-circle text-success me-2"></i>Mark as Paid
                                </button>
                              <% end %>
                            </li>
                            <li>
                              <%= form_with url: process_invoice_supplier_path(@supplier, invoice_id: invoice.id, action_type: 'mark_reviewed'), 
                                    method: :post,
                                    class: 'd-inline' do %>
                                <button type="submit" class="dropdown-item">
                                  <i class="bi bi-check-square text-primary me-2"></i>Mark as Reviewed
                                </button>
                              <% end %>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                              <%= form_with url: process_invoice_supplier_path(@supplier, invoice_id: invoice.id, action_type: 'dispute'), 
                                    method: :post,
                                    class: 'd-inline' do %>
                                <button type="submit" class="dropdown-item text-danger">
                                  <i class="bi bi-exclamation-triangle me-2"></i>Mark as Disputed
                                </button>
                              <% end %>
                            </li>
                          </ul>
                        </div>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if @vendor_invoices.total_pages > 1 %>
          <div class="card-footer border-top-0">
            <div class="d-flex justify-content-between align-items-center">
              <div class="text-muted">
                Showing <%= @vendor_invoices.offset_value + 1 %> to 
                <%= @vendor_invoices.offset_value + @vendor_invoices.length %> of 
                <%= @vendor_invoices.total_count %> invoices
              </div>
              <div>
                <%= paginate @vendor_invoices %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Add this helper if not already defined -->
<% unless defined?(invoice_status_color) %>
  <% def invoice_status_color(status) %>
    <% case status %>
    <% when 'paid' then 'bg-success' %>
    <% when 'pending' then 'bg-warning' %>
    <% when 'reviewed' then 'bg-info' %>
    <% when 'disputed' then 'bg-danger' %>
    <% else 'bg-secondary' %>
    <% end %>
  <% end %>
<% end %>