<%# app/views/payables/new.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">💰 Create New Payable</h1>
          <p class="text-muted">Record a new accounts payable entry</p>
        </div>
        <%= link_to "← Back to Payables", payables_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Payable Details</h5>
        </div>
        <div class="card-body">
          <%= form_with model: @payable, url: payables_path, local: true do |f| %>
            <% if @payable.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@payable.errors.count, "error") %> prohibited this payable:</h6>
                <ul class="mb-0">
                  <% @payable.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :vendor_name, "Vendor Name", class: "form-label fw-bold" %>
                <%= f.text_field :vendor_name, class: "form-control", required: true %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= f.label :vendor_id, "Select Vendor (Optional)", class: "form-label fw-bold" %>
                <%= f.collection_select :vendor_id, Vendor.all, :id, :name, 
                      { include_blank: "Select vendor..." }, 
                      { class: "form-select" } %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :amount, "Amount ($)", class: "form-label fw-bold" %>
                <%= f.number_field :amount, class: "form-control", required: true, 
                      step: "0.01", min: 0 %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= f.label :due_date, "Due Date", class: "form-label fw-bold" %>
                <%= f.date_field :due_date, class: "form-control", required: true, 
                      value: Date.current + 30.days %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :category, "Category", class: "form-label fw-bold" %>
                <%= f.select :category, 
                      options_for_select(['purchase_order', 'invoice', 'service', 'parts', 'other']),
                      { include_blank: "Select category" }, class: "form-select" %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= f.label :account_id, "Account", class: "form-label fw-bold" %>
                <%= f.collection_select :account_id, @accounts, :id, :name, 
                      { include_blank: "Select account" }, 
                      { class: "form-select", required: true } %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :purchase_order_id, "Purchase Order ID", class: "form-label fw-bold" %>
                <%= f.number_field :purchase_order_id, class: "form-control", 
                      placeholder: "Optional - link to PO" %>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= f.label :invoice_id, "Invoice ID", class: "form-label fw-bold" %>
                <%= f.number_field :invoice_id, class: "form-control", 
                      placeholder: "Optional - link to Invoice" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, "Description", class: "form-label fw-bold" %>
              <%= f.text_area :description, class: "form-control", rows: 3, 
                    placeholder: "Enter description of goods/services..." %>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancel", payables_path, class: "btn btn-outline-secondary" %>
              <%= f.submit "Create Payable", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>