<%# app/views/admin/users/new.html.erb %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Create New PTSC User</h1>
    <%= link_to "Back to Users", admin_users_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body">
          <%= form_with model: @user, url: admin_users_path, local: true do |f| %>
            
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              Users will be automatically assigned to PTSC agency.
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :email, "Email Address", class: "form-label required fw-bold" %>
                <%= f.email_field :email, class: "form-control", required: true, placeholder: "user@ptsc.gov.tt" %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.label :name, "Full Name", class: "form-label fw-bold" %>
                <%= f.text_field :name, class: "form-control", placeholder: "John Doe" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :role, "Role", class: "form-label required fw-bold" %>
                <%= f.select :role, 
                    options_for_select([
                      ["Admin", "admin"],
                      ["Fleet Manager", "fleet_manager"],
                      ["Maintenance Supervisor", "maintenance_supervisor"],
                      ["Finance Officer", "finance_officer"],
                      ["Driver", "driver"]
                    ]),
                    { include_blank: "Select Role" },
                    class: "form-select", required: true %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.label :employee_id, "Employee ID", class: "form-label fw-bold" %>
                <%= f.text_field :employee_id, class: "form-control", placeholder: "PTSC-12345" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :time_zone, "Time Zone", class: "form-label fw-bold" %>
                <%= f.time_zone_select :time_zone, nil, 
                    { default: "UTC" },
                    class: "form-select" %>
              </div>

              <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                  <%= f.check_box :is_active, class: "form-check-input", checked: true %>
                  <%= f.label :is_active, "Active", class: "form-check-label fw-bold" %>
                </div>
              </div>
            </div>

            <div class="alert alert-warning">
              <i class="bi bi-key me-2"></i>
              A random password will be generated automatically. You'll see it after creation.
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Create User", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>