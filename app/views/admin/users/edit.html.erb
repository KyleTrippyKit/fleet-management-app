<%# app/views/admin/users/edit.html.erb %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Edit User: <%= @user.email %> (<%= @user.agency.code %>)</h1>
    <%= link_to "Back to Users", admin_users_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body">
          <%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |f| %>
            
            <div class="alert alert-info">
              <i class="bi bi-building me-2"></i>
              Agency: <strong><%= @user.agency.code %> - <%= @user.agency.name %></strong> (cannot be changed)
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :email, "Email Address", class: "form-label required fw-bold" %>
                <%= f.email_field :email, class: "form-control", required: true %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.label :name, "Full Name", class: "form-label fw-bold" %>
                <%= f.text_field :name, class: "form-control" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :role, "Role", class: "form-label required fw-bold" %>
                <%= f.select :role, 
                    options_for_select(role_options_for_agency(@user.agency.code), @user.role),
                    { include_blank: "Select Role" },
                    class: "form-select", required: true %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.label :employee_id, "Employee ID", class: "form-label fw-bold" %>
                <%= f.text_field :employee_id, class: "form-control" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :time_zone, "Time Zone", class: "form-label fw-bold" %>
                <%= f.time_zone_select :time_zone, nil, 
                    { default: @user.time_zone },
                    class: "form-select" %>
              </div>

              <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                  <%= f.check_box :is_active, class: "form-check-input" %>
                  <%= f.label :is_active, "Active", class: "form-check-label fw-bold" %>
                  <small class="text-muted d-block">Inactive users cannot log in</small>
                </div>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Update User", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>

          <hr class="my-4">

          <div class="text-center">
            <p class="text-muted small mb-2">Need to reset this user's password?</p>
            <%= link_to "Reset Password", reset_password_admin_user_path(@user), 
                method: :post,
                data: { turbo_confirm: "Reset password for #{@user.email}?" },
                class: "btn btn-outline-warning" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>