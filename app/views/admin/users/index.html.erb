<%# app/views/admin/users/index.html.erb %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><%= current_user.agency.code %> User Management</h1>
    <%= link_to "Create New #{current_user.agency.code} User", new_admin_user_path(agency_id: current_user.agency.id), class: "btn btn-primary" %>
  </div>

  <!-- Filters -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: admin_users_path, method: :get, class: "row g-3" do |f| %>
        <div class="col-md-4">
          <%= f.label :search, "Search", class: "form-label" %>
          <%= f.text_field :search, value: params[:search], class: "form-control", placeholder: "Email or name..." %>
        </div>
        <div class="col-md-3">
          <%= f.label :role, "Role", class: "form-label" %>
          <%= f.select :role, 
              options_for_select([["All Roles", ""]] + role_options_for_agency(current_user.agency.code), params[:role]),
              {},
              class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, 
              options_for_select([["All", ""], ["Active", "active"], ["Inactive", "inactive"]], params[:status]),
              {},
              class: "form-select" %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <%= f.submit "Filter", class: "btn btn-primary me-2" %>
          <%= link_to "Clear", admin_users_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Agency Info Banner -->
  <div class="alert alert-info mb-3">
    <i class="bi bi-building me-2"></i>
    Managing users for: <strong><%= current_user.agency.code %> - <%= current_user.agency.name %></strong>
  </div>

  <!-- Users Table -->
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Last Sign In</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="<%= 'table-secondary' unless user.is_active %>">
              <td>
                <div class="d-flex align-items-center">
                  <div class="me-2">
                    <i class="bi bi-person-circle text-muted"></i>
                  </div>
                  <div>
                    <%= user.name.presence || "—" %>
                    <% if user.employee_id.present? %>
                      <br><small class="text-muted">ID: <%= user.employee_id %></small>
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= user.email %></td>
              <td>
                <span class="badge <%= role_badge_color(user.role) %>"><%= user.role.titleize %></span>
              </td>
              <td>
                <% if user.is_active %>
                  <span class="badge bg-success">Active</span>
                <% else %>
                  <span class="badge bg-secondary">Inactive</span>
                <% end %>
              </td>
              <td>
                <% if user.current_sign_in_at %>
                  <small><%= time_ago_in_words(user.current_sign_in_at) %> ago</small>
                <% else %>
                  <small class="text-muted">Never</small>
                <% end %>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-outline-primary" %>
                  <%= button_to "Reset Password", reset_password_admin_user_path(user), 
                      method: :post,
                      data: { turbo_confirm: "Reset password for #{user.email}?" },
                      class: "btn btn-outline-warning btn-sm" %>
                  <%= button_to "Impersonate", impersonate_admin_user_path(user), 
                      method: :post,
                      class: "btn btn-outline-info btn-sm" %>
                  <% if user != current_user %>
                    <%= button_to "Delete", admin_user_path(user), 
                        method: :delete,
                        data: { turbo_confirm: "Delete user #{user.email}?" },
                        class: "btn btn-outline-danger btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
      <div class="card-footer">
        <div class="d-flex justify-content-center">
          <%= paginate @users %>
        </div>
      </div>
    <% end %>
  </div>
</div>