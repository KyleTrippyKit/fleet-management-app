<%# app/views/admin/users/_form.html.erb %>
<div class="mb-3">
  <%= form.label :role, class: "form-label" %>
  <%= form.select :role, 
      options_for_select(role_options_for_agency(@user.agency&.code || current_user.agency.code), @user.role),
      { prompt: "Select role" },
      class: "form-select", required: true %>
  <div class="form-text">Select the user's role in the system</div>
</div>