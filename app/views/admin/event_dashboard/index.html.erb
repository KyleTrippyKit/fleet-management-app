<%# app/views/admin/event_dashboard/index.html.erb %>
<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-4">Event Processing Dashboard</h1>
  
  <!-- Stats -->
  <div class="grid grid-cols-4 gap-4 mb-6">
    <div class="bg-yellow-100 p-4 rounded">
      <p class="text-sm text-yellow-800">Pending</p>
      <p class="text-2xl font-bold"><%= @pending_events %></p>
    </div>
    <div class="bg-blue-100 p-4 rounded">
      <p class="text-sm text-blue-800">Processing</p>
      <p class="text-2xl font-bold"><%= @processing_events %></p>
    </div>
    <div class="bg-red-100 p-4 rounded">
      <p class="text-sm text-red-800">Failed</p>
      <p class="text-2xl font-bold"><%= @failed_events %></p>
    </div>
    <div class="bg-green-100 p-4 rounded">
      <p class="text-sm text-green-800">Processed</p>
      <p class="text-2xl font-bold"><%= @processed_events %></p>
    </div>
  </div>
  
  <!-- Recent Events -->
  <div class="bg-white shadow rounded-lg p-4 mb-6">
    <h2 class="text-lg font-bold mb-3">Recent Events</h2>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b">
          <th class="text-left py-2">ID</th>
          <th class="text-left py-2">Type</th>
          <th class="text-left py-2">Aggregate</th>
          <th class="text-left py-2">Status</th>
          <th class="text-left py-2">Created</th>
          <th class="text-left py-2">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_events.each do |event| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2"><%= event.id %></td>
            <td class="py-2"><%= event.event_type %></td>
            <td class="py-2"><%= event.aggregate_type %> #<%= event.aggregate_id %></td>
            <td class="py-2">
              <span class="px-2 py-1 rounded text-xs 
                <%= case event.status
                    when 'pending' then 'bg-yellow-100 text-yellow-800'
                    when 'processing' then 'bg-blue-100 text-blue-800'
                    when 'completed' then 'bg-green-100 text-green-800'
                    when 'failed' then 'bg-red-100 text-red-800'
                    end %>">
                <%= event.status %>
              </span>
            </td>
            <td class="py-2"><%= time_ago_in_words(event.created_at) %> ago</td>
            <td class="py-2">
              <% if event.status == 'failed' %>
                <%= link_to "Retry", retry_failed_admin_event_dashboard_path(event), method: :post, class: "text-blue-600 hover:underline text-xs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <!-- Dead Letter Queue -->
  <% if @dead_letters.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h2 class="text-lg font-bold text-red-800 mb-3">Dead Letter Queue</h2>
      <% @dead_letters.each do |dl| %>
        <div class="bg-white rounded p-3 mb-2">
          <p class="font-medium"><%= dl.event_type %></p>
          <p class="text-sm text-gray-600"><%= dl.error %></p>
          <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(dl.created_at) %> ago</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>