<%# app/views/ptsc/admin/quotations/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2"><i class="bi bi-file-text me-2"></i>Quotations from VMCOTT</h1>
      <p class="text-muted">Review and respond to quotations for your vehicles</p>
    </div>
  </div>

  <!-- Status Tabs -->
  <ul class="nav nav-tabs mb-4" id="quotationTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
        Pending Review <span class="badge bg-warning ms-2"><%= @pending_quotations.count %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
        Approved <span class="badge bg-success ms-2"><%= @approved_quotations.count %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
        Rejected <span class="badge bg-danger ms-2"><%= @rejected_quotations.count %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content" id="quotationTabContent">
    <!-- PENDING TAB -->
    <div class="tab-pane fade show active" id="pending" role="tabpanel">
      <div class="card">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Pending Your Review</h5>
        </div>
        <div class="card-body">
          <% if @pending_quotations.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Quote #</th>
                    <th>Vehicle</th>
                    <th>Labor Cost</th>
                    <th>Parts Cost</th>
                    <th>Total</th>
                    <th>Valid Until</th>
                    <th>Received</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_quotations.each do |quotation| %>
                    <tr>
                      <td><strong><%= quotation.quote_number %></strong></td>
                      <td>
                        <%= quotation.vehicle.license_plate %>
                        <br><small class="text-muted"><%= quotation.vehicle.make %> <%= quotation.vehicle.model %></small>
                      </td>
                      <td><%= number_to_currency(quotation.labor_cost) %></td>
                      <td><%= number_to_currency(quotation.parts_cost) %></td>
                      <td><strong class="text-primary"><%= number_to_currency(quotation.total_cost) %></strong></td>
                      <td>
                        <%= quotation.valid_until.strftime("%b %d, %Y") %>
                        <% if quotation.valid_until < Date.today %>
                          <span class="badge bg-danger ms-1">Expired</span>
                        <% end %>
                      </td>
                      <td><%= time_ago_in_words(quotation.created_at) %> ago</td>
                      <td>
                        <%= link_to "Review", ptsc_admin_quotation_path(quotation), 
                              class: "btn btn-sm btn-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-check-circle text-success fs-1 mb-3"></i>
              <p class="text-muted mb-0">No pending quotations</p>
              <small>All caught up!</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- APPROVED TAB -->
    <div class="tab-pane fade" id="approved" role="tabpanel">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Approved Quotations</h5>
        </div>
        <div class="card-body">
          <% if @approved_quotations.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Quote #</th>
                    <th>Vehicle</th>
                    <th>Total</th>
                    <th>Approved At</th>
                    <th>PO Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @approved_quotations.each do |quotation| %>
                    <tr>
                      <td><strong><%= quotation.quote_number %></strong></td>
                      <td><%= quotation.vehicle.license_plate %></td>
                      <td><%= number_to_currency(quotation.total_cost) %></td>
                      <td><%= quotation.accepted_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <% if quotation.purchase_order.present? %>
                          <span class="badge bg-success">PO Created</span>
                        <% else %>
                          <span class="badge bg-warning">Processing</span>
                        <% end %>
                      </td>
                      <td>
                        <%= link_to "View", ptsc_admin_quotation_path(quotation), 
                              class: "btn btn-sm btn-outline-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No approved quotations</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- REJECTED TAB -->
    <div class="tab-pane fade" id="rejected" role="tabpanel">
      <div class="card">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0"><i class="bi bi-x-circle me-2"></i>Rejected Quotations</h5>
        </div>
        <div class="card-body">
          <% if @rejected_quotations.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Quote #</th>
                    <th>Vehicle</th>
                    <th>Total</th>
                    <th>Rejected At</th>
                    <th>Reason</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @rejected_quotations.each do |quotation| %>
                    <tr>
                      <td><strong><%= quotation.quote_number %></strong></td>
                      <td><%= quotation.vehicle.license_plate %></td>
                      <td><%= number_to_currency(quotation.total_cost) %></td>
                      <td><%= quotation.rejected_at.strftime("%b %d, %Y") %></td>
                      <td><%= truncate(quotation.metadata&.dig('rejection_reason') || 'No reason provided', length: 30) %></td>
                      <td>
                        <%= link_to "View", ptsc_admin_quotation_path(quotation), 
                              class: "btn btn-sm btn-outline-secondary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No rejected quotations</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>