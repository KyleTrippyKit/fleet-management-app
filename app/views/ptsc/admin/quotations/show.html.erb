<%# app/views/ptsc/admin/quotations/show.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2">Quotation <%= @quotation.quote_number %></h1>
          <p class="text-muted">
            Vehicle: <%= @vehicle.license_plate %> - <%= @vehicle.make %> <%= @vehicle.model %>
          </p>
        </div>
        <div>
          <%= link_to "← Back to List", ptsc_admin_quotations_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="alert <%= 
    case @quotation.status
    when 'sent' then 'alert-warning'
    when 'accepted' then 'alert-success'
    when 'rejected' then 'alert-danger'
    else 'alert-info'
    end %> mb-4">
    <div class="d-flex align-items-center">
      <i class="bi <%= 
        case @quotation.status
        when 'sent' then 'bi-clock-history'
        when 'accepted' then 'bi-check-circle-fill'
        when 'rejected' then 'bi-x-circle-fill'
        else 'bi-info-circle-fill'
        end %> fs-3 me-3"></i>
      <div>
        <strong>Status:</strong> <%= @quotation.status.humanize %>
        <% if @quotation.metadata&.dig('is_additional') %>
          <span class="badge bg-info ms-2">Additional Work</span>
        <% end %>
        <% if @quotation.valid_until < Date.today && @quotation.sent? %>
          <span class="badge bg-danger ms-2">Expired</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <!-- Quotation Details Card -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Quotation Details</h5>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Quote Number:</th>
                  <td><strong><%= @quotation.quote_number %></strong></td>
                </tr>
                <tr>
                  <th>Date Issued:</th>
                  <td><%= @quotation.created_at.strftime("%B %d, %Y") %></td>
                </tr>
                <tr>
                  <th>Valid Until:</th>
                  <td>
                    <%= @quotation.valid_until.strftime("%B %d, %Y") %>
                    <% if @quotation.valid_until < Date.today %>
                      <span class="badge bg-danger ms-2">Expired</span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-sm">
                <tr>
                  <th>Vehicle:</th>
                  <td><%= @vehicle.license_plate %></td>
                </tr>
                <tr>
                  <th>Make/Model:</th>
                  <td><%= @vehicle.make %> <%= @vehicle.model %></td>
                </tr>
                <tr>
                  <th>Year:</th>
                  <td><%= @vehicle.year_of_manufacture %></td>
                </tr>
              </table>
            </div>
          </div>

          <!-- Cost Breakdown -->
          <h6 class="border-bottom pb-2 mb-3">Cost Breakdown</h6>
          
          <div class="row mb-3">
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <h6 class="text-primary">Labor</h6>
                  <p class="h4"><%= number_to_currency(@quotation.labor_cost) %></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <h6 class="text-success">Parts</h6>
                  <p class="h4"><%= number_to_currency(@quotation.parts_cost) %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="card bg-primary text-white">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Total Quoted Amount</h5>
                <h3 class="mb-0"><%= number_to_currency(@quotation.total_cost) %></h3>
              </div>
            </div>
          </div>

          <% if @quotation.notes.present? %>
            <div class="mt-4">
              <h6 class="fw-bold">Additional Notes:</h6>
              <div class="bg-light p-3 rounded">
                <%= simple_format(@quotation.notes) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Actions Card -->
      <div class="card mb-4">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions</h5>
        </div>
        <div class="card-body">
          <% if @quotation.sent? && @quotation.valid_until >= Date.today %>
            <div class="d-grid gap-2">
              <%= button_to "✓ Approve Quotation", 
                    approve_ptsc_admin_quotation_path(@quotation),
                    method: :post,
                    class: "btn btn-success btn-lg",
                    data: { confirm: "Approve this quotation? A purchase order will be created for VMCOTT." } %>
              
              <button type="button" class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#rejectModal">
                ✗ Reject Quotation
              </button>
            </div>
            
            <hr>
            
            <div class="alert alert-info mt-3">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Note:</strong> Approving will create a Purchase Order for VMCOTT to begin work.
            </div>
          <% elsif @quotation.accepted? %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle-fill me-2"></i>
              This quotation has been approved.
              <% if @quotation.purchase_order.present? %>
                <hr>
                <%= link_to "View Purchase Order", purchase_order_path(@quotation.purchase_order), 
                      class: "btn btn-outline-primary btn-sm w-100" %>
              <% end %>
            </div>
          <% elsif @quotation.rejected? %>
            <div class="alert alert-danger">
              <i class="bi bi-x-circle-fill me-2"></i>
              This quotation was rejected.
              <% if @quotation.metadata&.dig('rejection_reason') %>
                <hr>
                <strong>Reason:</strong> <%= @quotation.metadata['rejection_reason'] %>
              <% end %>
            </div>
          <% elsif @quotation.valid_until < Date.today %>
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle me-2"></i>
              This quotation has expired. Please contact VMCOTT for a new quotation.
            </div>
          <% end %>

          <div class="mt-3">
            <%= link_to "Download PDF", quotation_path(@quotation, format: :pdf), 
                  class: "btn btn-outline-secondary w-100", target: "_blank" %>
          </div>
        </div>
      </div>

      <!-- Timeline Card -->
      <div class="card">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-3">
              <i class="bi bi-plus-circle text-primary me-2"></i>
              <strong>Created:</strong><br>
              <small class="text-muted"><%= @quotation.created_at.strftime("%b %d, %Y at %I:%M %p") %></small>
            </li>
            <% if @quotation.sent_at %>
              <li class="mb-3">
                <i class="bi bi-send text-info me-2"></i>
                <strong>Sent to Agency:</strong><br>
                <small class="text-muted"><%= @quotation.sent_at.strftime("%b %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
            <% if @quotation.accepted_at %>
              <li class="mb-3">
                <i class="bi bi-check-circle text-success me-2"></i>
                <strong>Approved:</strong><br>
                <small class="text-muted"><%= @quotation.accepted_at.strftime("%b %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
            <% if @quotation.rejected_at %>
              <li class="mb-3">
                <i class="bi bi-x-circle text-danger me-2"></i>
                <strong>Rejected:</strong><br>
                <small class="text-muted"><%= @quotation.rejected_at.strftime("%b %d, %Y at %I:%M %p") %></small>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">Reject Quotation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: reject_ptsc_admin_quotation_path(@quotation), method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="reason" class="form-label fw-bold">Reason for Rejection</label>
            <%= text_area_tag :reason, nil, class: "form-control", rows: 4, 
                  placeholder: "Please provide a reason for rejecting this quotation...", required: true %>
          </div>
          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            This action cannot be undone. The inspection will be marked as cancelled by agency.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Reject Quotation", class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>