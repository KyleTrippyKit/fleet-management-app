<%# app/views/ptsc/finance_dashboard/index.html.erb %>
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h3 mb-0">
        <i class="fas fa-coins me-2"></i>
        PTSC Finance Dashboard
      </h1>
      <p class="text-muted">Manage invoices, payments, and financial operations</p>
    </div>
    <div class="col-auto">
      <%= link_to invoices_path, class: "btn btn-primary" do %>
        <i class="fas fa-file-invoice me-2"></i> View All Invoices
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-info text-white">
        <div class="card-body">
          <h6 class="text-uppercase mb-2">Pending Invoices</h6>
          <h2 class="mb-0"><%= @stats[:pending_invoices] %></h2>
          <small>Awaiting review</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-warning text-dark">
        <div class="card-body">
          <h6 class="text-uppercase mb-2">Pending Amount</h6>
          <h2 class="mb-0"><%= number_to_currency(@stats[:pending_amount]) %></h2>
          <small>TTD</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body">
          <h6 class="text-uppercase mb-2">Paid This Month</h6>
          <h2 class="mb-0"><%= number_to_currency(@stats[:paid_this_month]) %></h2>
          <small>TTD</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body">
          <h6 class="text-uppercase mb-2">Overdue Invoices</h6>
          <h2 class="mb-0"><%= @stats[:overdue_invoices] %></h2>
          <small>Need attention</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Quick Actions</h5>
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to invoices_path(status: 'pending'), class: "btn btn-outline-primary" do %>
              <i class="fas fa-clock me-2"></i> Review Pending Invoices
              <% if @stats[:pending_invoices] > 0 %>
                <span class="badge bg-danger ms-2"><%= @stats[:pending_invoices] %></span>
              <% end %>
            <% end %>
            <%= link_to invoices_path, class: "btn btn-outline-success" do %>
              <i class="fas fa-file-invoice me-2"></i> All Invoices
            <% end %>
            <%= link_to aging_report_invoices_path, class: "btn btn-outline-warning" do %>
              <i class="fas fa-chart-line me-2"></i> Aging Report
            <% end %>
            <%= link_to reports_invoices_path, class: "btn btn-outline-secondary" do %>
              <i class="fas fa-chart-pie me-2"></i> Financial Reports
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Aging Summary -->
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
          <h5 class="mb-0">Aging Summary</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-3">
              <div class="p-3 bg-success bg-opacity-10 rounded">
                <h3 class="text-success"><%= @aging_summary[:current] %></h3>
                <span>Current</span>
                <small class="text-muted d-block">0-30 days</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 bg-warning bg-opacity-10 rounded">
                <h3 class="text-warning"><%= @aging_summary[:thirty_days] %></h3>
                <span>30-60 Days</span>
                <small class="text-muted d-block">Overdue</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 bg-orange bg-opacity-10 rounded">
                <h3 class="text-orange"><%= @aging_summary[:sixty_days] %></h3>
                <span>60-90 Days</span>
                <small class="text-muted d-block">Seriously overdue</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3 bg-danger bg-opacity-10 rounded">
                <h3 class="text-danger"><%= @aging_summary[:ninety_plus] %></h3>
                <span>90+ Days</span>
                <small class="text-muted d-block">Critical</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pending Invoices -->
  <% if @pending_invoices.any? %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent">
        <h5 class="mb-0">Pending Invoices</h5>
      </div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Vendor</th>
              <th>Amount</th>
              <th>Due Date</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @pending_invoices.each do |invoice| %>
              <tr>
                <td><%= link_to invoice.invoice_number, invoice %></td>
                <td><%= invoice.vendor %></td>
                <td><%= number_to_currency(invoice.amount) %></td>
                <td>
                  <%= invoice.due_date.strftime("%b %d, %Y") %>
                  <% if invoice.due_date < Date.today %>
                    <span class="badge bg-danger ms-2">Overdue</span>
                  <% end %>
                </td>
                <td><span class="badge bg-<%= invoice.status_badge_class %>"><%= invoice.status.titleize %></span></td>
                <td class="text-end">
                  <%= link_to "Review", invoice, class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Recent Payments -->
  <% if @recent_payments.any? %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent">
        <h5 class="mb-0">Recent Payments</h5>
      </div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Invoice</th>
              <th>Amount</th>
              <th>Method</th>
              <th>Reference</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_payments.each do |payment| %>
              <tr>
                <td><%= payment.payment_date.strftime("%b %d, %Y") %></td>
                <td><%= link_to payment.invoice.invoice_number, payment.invoice if payment.invoice %></td>
                <td><%= number_to_currency(payment.amount) %></td>
                <td><span class="badge bg-info"><%= payment.payment_method.titleize %></span></td>
                <td><%= payment.reference_number %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>