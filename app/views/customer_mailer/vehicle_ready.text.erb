<%# app/views/customer_mailer/vehicle_ready.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; text-align: center; }
    .content { padding: 20px; background: #f9fafb; }
    .footer { text-align: center; padding: 20px; font-size: 12px; color: #666; }
    .button { display: inline-block; padding: 10px 20px; background: #10b981; color: white; text-decoration: none; border-radius: 5px; }
    .pickup-code { font-size: 24px; font-weight: bold; background: #e5e7eb; padding: 10px; text-align: center; letter-spacing: 4px; }
    .info-box { background: white; border-radius: 8px; padding: 15px; margin: 15px 0; border-left: 4px solid #10b981; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🚗 VMCOTT Vehicle Service</h1>
      <p>Your vehicle is ready for pickup!</p>
    </div>
    <div class="content">
      <h2>Hello <%= @customer_name %>,</h2>
      <p>Great news! Your vehicle has passed quality control and is ready for pickup.</p>
      
      <div class="info-box">
        <h3>Vehicle Information</h3>
        <p><strong>License Plate:</strong> <%= @vehicle.license_plate %><br>
        <strong>Make/Model:</strong> <%= @vehicle.make %> <%= @vehicle.model %><br>
        <strong>Service Completed:</strong> <%= @inspection.completed_at&.strftime("%B %d, %Y at %I:%M %p") || 'Today' %></p>
      </div>

      <div class="info-box">
        <h3>Pickup Information</h3>
        <p><strong>Location:</strong> <%= @vmcott_address %><br>
        <strong>Hours:</strong> Monday - Friday: 8:00 AM - 5:00 PM<br>
        <strong>Phone:</strong> <%= @vmcott_phone %></p>
        
        <% if @pickup_code %>
          <p><strong>Your Pickup Code:</strong></p>
          <div class="pickup-code"><%= @pickup_code %></div>
          <p class="small">Please bring this code when picking up your vehicle.</p>
        <% end %>
      </div>

      <div style="text-align: center; margin: 30px 0;">
        <%= link_to "Track Your Vehicle", @portal_url, class: "button", style: "color: white; text-decoration: none;" %>
      </div>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.current.year %> VMCOTT - Vehicle Maintenance & Repair Services</p>
      <p><%= @vmcott_address %> | Phone: <%= @vmcott_phone %></p>
    </div>
  </div>
</body>
</html>