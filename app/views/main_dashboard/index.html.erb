<%# app/views/main_dashboard/index.html.erb - ENTERPRISE COMMAND CENTER %>

<div class="main-enterprise container-fluid py-4 px-4">

  <!-- HEADER -->
  <div class="card border-0 shadow-sm main-head mb-3">
    <div class="card-body d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
      <div>
        <h1 class="m-0 main-title">Main Dashboard</h1>
        <div class="text-muted">Fleet overview and alert monitoring</div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if respond_to?(:ptsc_alerts_path) %>
          <%= link_to "View Alerts", ptsc_alerts_path, class: "btn btn-outline-primary main-btn" %>
        <% end %>
        <%= link_to "Create Alert", new_alert_path, class: "btn btn-primary main-btn" %>
      </div>
    </div>
  </div>

  <!-- KPI ROW -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Active Alerts</div>
              <div class="main-kpi-value text-primary"><%= (@active_alerts_count || 0) %></div>
              <div class="text-muted small">Across fleet</div>
            </div>
            <div class="main-kpi-ico text-primary bg-primary bg-opacity-10">
              <i class="bi bi-bell"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Critical</div>
              <div class="main-kpi-value text-danger"><%= (@critical_alerts_count || 0) %></div>
              <div class="text-muted small">High severity</div>
            </div>
            <div class="main-kpi-ico text-danger bg-danger bg-opacity-10">
              <i class="bi bi-exclamation-triangle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Urgent</div>
              <div class="main-kpi-value text-warning"><%= (@urgent_alerts_count || 0) %></div>
              <div class="text-muted small">Priority queue</div>
            </div>
            <div class="main-kpi-ico text-warning bg-warning bg-opacity-10">
              <i class="bi bi-clock"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Need Attention</div>
              <div class="main-kpi-value text-danger"><%= (@needs_attention_count || 0) %></div>
              <div class="text-muted small">Immediate action</div>
            </div>
            <div class="main-kpi-ico text-danger bg-danger bg-opacity-10">
              <i class="bi bi-exclamation-octagon"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECOND ROW (Fleet KPIs) -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Total Vehicles</div>
              <div class="main-kpi-value"><%= (@total_vehicles || 0) %></div>
              <div class="mt-2 d-flex flex-wrap gap-1">
                <span class="badge bg-success"><%= (@active_vehicles || 0) %> Active</span>
                <span class="badge bg-warning text-dark"><%= (@maintenance_vehicles || 0) %> Maint</span>
                <span class="badge bg-danger"><%= (@overdue_vehicles || 0) %> Overdue</span>
              </div>
            </div>
            <div class="main-kpi-ico text-secondary bg-secondary bg-opacity-10">
              <i class="bi bi-truck"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Maintenance</div>
              <div class="main-kpi-value"><%= (@total_maintenances || 0) %></div>
              <div class="mt-2 d-flex flex-wrap gap-1">
                <span class="badge bg-warning text-dark"><%= (@pending_maintenances || 0) %> Pending</span>
                <span class="badge bg-danger"><%= (@overdue_maintenances || 0) %> Overdue</span>
                <span class="badge bg-info"><%= (@active_maintenances || 0) %> Active</span>
              </div>
            </div>
            <div class="main-kpi-ico text-secondary bg-secondary bg-opacity-10">
              <i class="bi bi-wrench"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Avg Utilization</div>
              <div class="main-kpi-value"><%= (@avg_utilization || 0) %>%</div>
              <div class="progress mt-3" style="height:10px;">
                <div class="progress-bar" role="progressbar" style="width:<%= (@avg_utilization || 0) %>%"></div>
              </div>
            </div>
            <div class="main-kpi-ico text-secondary bg-secondary bg-opacity-10">
              <i class="bi bi-speedometer2"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm main-kpi h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <div class="main-kpi-label">Health Score</div>
              <div class="main-kpi-value">
                <%= (((@health_distribution || {})[:excellent].to_i + (@health_distribution || {})[:good].to_i) * 100 / [(@total_vehicles || 0).to_i, 1].max) %>%
              </div>
              <div class="mt-2 d-flex flex-wrap gap-1">
                <span class="badge bg-success"><%= (@health_distribution || {})[:excellent].to_i %> Excellent</span>
                <span class="badge bg-info"><%= (@health_distribution || {})[:good].to_i %> Good</span>
                <span class="badge bg-warning text-dark"><%= (@health_distribution || {})[:fair].to_i %> Fair</span>
                <span class="badge bg-danger"><%= (@health_distribution || {})[:poor].to_i + (@health_distribution || {})[:critical].to_i %> Poor/Critical</span>
              </div>
            </div>
            <div class="main-kpi-ico text-secondary bg-secondary bg-opacity-10">
              <i class="bi bi-heart-pulse"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN GRID -->
  <div class="row g-3">
    <div class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm">
        <div class="main-card-head">
          <div>
            <div class="main-card-title">Alerts Needing Immediate Attention</div>
            <div class="main-card-sub text-muted">Triage queue</div>
          </div>
          <span class="badge bg-danger"><%= (@alerts_needing_attention || []).count %></span>
        </div>

        <div class="card-body p-0">
          <% if (@alerts_needing_attention || []).any? %>
            <div class="list-group list-group-flush">
              <% @alerts_needing_attention.each do |alert| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger"><%= alert.respond_to?(:short_display) ? alert.short_display : "!" %></span>
                        <strong><%= alert.title %></strong>
                      </div>
                      <div class="text-muted small mt-1"><%= truncate(alert.description.to_s, length: 110) %></div>
                      <div class="d-flex flex-wrap gap-3 mt-2 text-muted small">
                        <span><i class="bi bi-truck me-1"></i><%= alert.respond_to?(:vehicle_display_name) ? alert.vehicle_display_name : "Vehicle" %></span>
                        <span><i class="bi bi-geo-alt me-1"></i><%= truncate(alert.respond_to?(:display_location) ? alert.display_location.to_s : "", length: 30) %></span>
                        <span><i class="bi bi-clock me-1"></i><%= time_ago_in_words(alert.created_at) %> ago</span>
                      </div>
                    </div>

                    <div class="d-flex gap-2">
                      <%= form_with(url: acknowledge_alert_main_dashboard_path(alert), method: :post, class: "d-inline") do %>
                        <button type="submit" class="btn btn-sm btn-outline-success">
                          <i class="bi bi-check-circle"></i> Ack
                        </button>
                      <% end %>

                      <%= form_with(url: resolve_alert_main_dashboard_path(alert), method: :post, class: "d-inline") do %>
                        <%= hidden_field_tag :resolution_notes, "Resolved from dashboard" %>
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-check2-square"></i> Resolve
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
              <h5 class="mt-2">No alerts require immediate attention</h5>
              <div class="text-muted">All systems operating normally.</div>
            </div>
          <% end %>
        </div>

        <div class="card-footer d-flex justify-content-between">
          <% if respond_to?(:ptsc_alerts_path) %>
            <%= link_to "View All Alerts", ptsc_alerts_path, class: "btn btn-sm btn-outline-primary" %>
          <% end %>
          <%= link_to "Create Alert", new_alert_path, class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="main-card-head">
          <div>
            <div class="main-card-title">Vehicle Alert Status</div>
            <div class="main-card-sub text-muted">Distribution</div>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Vehicle</th>
                  <th class="text-center">Alerts</th>
                  <th class="text-center">Health</th>
                </tr>
              </thead>
              <tbody>
                <% (@vehicles_with_stats || []).each do |vehicle_data| %>
                  <% vehicle  = vehicle_data[:vehicle] %>
                  <% summary  = vehicle_data[:alert_summary] || {} %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= link_to vehicle.display_name, vehicle, class: "text-decoration-none" %></div>
                      <div class="text-muted small"><%= vehicle.license_plate %></div>
                    </td>
                    <td class="text-center">
                      <% needs = summary[:needs_attention].to_i %>
                      <% act   = summary[:active_alerts].to_i %>

                      <% if needs > 0 %>
                        <span class="badge bg-danger"><%= needs %></span>
                      <% elsif act > 0 %>
                        <span class="badge bg-warning text-dark"><%= act %></span>
                      <% else %>
                        <span class="badge bg-success">0</span>
                      <% end %>
                    </td>
                    <td class="text-center">
                      <span class="badge <%= vehicle.respond_to?(:health_status_badge_class) ? vehicle.health_status_badge_class : 'bg-secondary' %>">
                        <%= vehicle_data[:health_score] || "—" %>
                      </span>
                    </td>
                  </tr>
                <% end %>

                <% if (@vehicles_with_stats || []).empty? %>
                  <tr><td colspan="3" class="text-center text-muted py-4">No data</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card-footer">
          <%= link_to "View All Vehicles", vehicles_path, class: "btn btn-sm btn-outline-secondary w-100" %>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  .main-head { border-radius: 16px; }
  .main-title { font-weight: 900; letter-spacing: -0.02em; }
  .main-btn { border-radius: 12px; }

  .main-kpi { border-radius: 16px; }
  .main-kpi-label {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .10em;
    color: #6c757d;
    font-weight: 800;
  }
  .main-kpi-value { font-size: 2.1rem; font-weight: 900; line-height: 1.05; }
  .main-kpi-ico {
    width: 44px; height: 44px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .main-card-head {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: rgba(248,249,250,.75);
  }
  .main-card-title { font-weight: 900; line-height: 1.05; }
  .main-card-sub { font-size: .86rem; }

  .table thead th {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #6c757d;
  }
</style>
