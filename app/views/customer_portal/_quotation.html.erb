<%# app/views/customer_portal/_quotation.html.erb %>
<div class="table-responsive">
  <table class="table table-bordered">
    <thead class="table-light">
      <tr>
        <th style="width: 40px">
          <input type="checkbox" id="selectAllJobs" class="form-check-input">
        </th>
        <th>Job Description</th>
        <th class="text-end">Labor Cost</th>
        <th class="text-end">Parts Cost</th>
        <th class="text-end">Total</th>
       </thead>
    <tbody>
      <% jobs.each do |job| %>
        <tr>
          <td class="text-center">
            <input type="checkbox" name="approved_jobs[]" value="<%= job.id %>" class="form-check-input job-checkbox" <%= 'checked' if job.client_approved %>>
           </td>
          <td>
            <strong><%= job.name || job.description %></strong>
            <% if job.description.present? && job.description != job.name %>
              <br><small class="text-muted"><%= job.description %></small>
            <% end %>
          </td>
          <td class="text-end">$<%= number_with_delimiter(job.total_labor_cost || 0) %></td>
          <td class="text-end">$<%= number_with_delimiter(job.total_parts_cost || 0) %></td>
          <td class="text-end"><strong>$<%= number_with_delimiter((job.total_labor_cost || 0) + (job.total_parts_cost || 0)) %></strong></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="table-dark">
      <tr>
        <td colspan="4" class="text-end"><strong>Total:</strong></td>
        <td class="text-end"><strong>$<%= number_with_delimiter(jobs.sum { |j| (j.total_labor_cost || 0) + (j.total_parts_cost || 0) }) %></strong></td>
      </tr>
    </tfoot>
  </table>
</div>

<div class="alert alert-info mt-3">
  <i class="bi bi-info-circle"></i> <strong>Note:</strong> You can approve all jobs or select specific jobs to approve. Only approved work will be performed.
</div>