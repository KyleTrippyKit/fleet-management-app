<%# app/views/customer_portal/recover.html.erb %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Recover Portal Access</h4>
        </div>
        <div class="card-body">
          <p class="text-muted">Enter your email or phone number to receive your portal login information.</p>
          
          <%= form_with url: customer_send_recovery_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <%= label_tag :email, "Email Address", class: "form-label" %>
              <%= email_field_tag :email, nil, class: "form-control", placeholder: "customer@example.com" %>
              <div class="text-center my-2">OR</div>
            </div>
            
            <div class="mb-3">
              <%= label_tag :phone, "Phone Number", class: "form-label" %>
              <%= text_field_tag :phone, nil, class: "form-control", placeholder: "868-XXX-XXXX" %>
            </div>
            
            <%= submit_tag "Send Recovery Email", class: "btn btn-primary w-100" %>
          <% end %>
          
          <hr class="my-4">
          
          <div class="text-center">
            <p class="mb-2">Need additional help?</p>
            <%= link_to "Contact VMCOTT Support", customer_contact_support_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>