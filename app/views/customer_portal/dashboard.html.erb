<%# app/views/customer_portal/dashboard.html.erb %>
<div class="container py-4">
  <!-- Header with Logo and Logout -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
      <%= image_tag "/images/comp_logo.png", alt: "Active Plus", class: "rounded-3", style: "height: 50px; width: auto;" %>
      <div>
        <h1 class="h2 mb-0 fw-bold" style="color: #1e293b;">
          <i class="bi bi-speedometer2 me-2" style="color: #3b82f6;"></i>
          Repair Portal
        </h1>
        <p class="text-muted small mt-1 mb-0">Track your vehicle repair status in real-time</p>
      </div>
    </div>
    <div>
      <%= link_to customer_logout_path, data: { turbo_method: :delete }, class: "btn btn-outline-secondary rounded-pill px-4" do %>
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      <% end %>
    </div>
  </div>

  <!-- Vehicle Information Card -->
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <div class="col-md-7">
          <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
              <i class="bi bi-truck fs-1 text-primary"></i>
            </div>
            <div>
              <h3 class="fw-bold mb-1" style="color: #1e293b;"><%= @reception&.vehicle&.license_plate || 'N/A' %></h3>
              <p class="text-muted mb-0">
                <%= @reception&.vehicle&.make %> <%= @reception&.vehicle&.model %>
                <span class="mx-2">•</span>
                <%= @reception&.vehicle&.year_of_manufacture %>
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-5">
          <div class="row g-3">
            <div class="col-6">
              <div class="bg-light rounded-3 p-3 text-center">
                <small class="text-muted d-block mb-1">Drop-off Date</small>
                <strong><%= @reception&.created_at&.strftime("%b %d, %Y") || 'N/A' %></strong>
              </div>
            </div>
            <div class="col-6">
              <div class="bg-light rounded-3 p-3 text-center">
                <small class="text-muted d-block mb-1">Status</small>
                <span class="badge bg-<%= status_badge_color(@inspection&.status) %> px-3 py-2">
                  <%= @inspection&.status&.humanize || 'Pending' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Progress Card -->
  <div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <div class="col-md-8">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold">Repair Progress</span>
            <span class="fw-bold text-primary"><%= work_progress_percentage(@inspection) %>%</span>
          </div>
          <div class="progress" style="height: 8px; border-radius: 10px;">
            <div class="progress-bar bg-primary" style="width: <%= work_progress_percentage(@inspection) %>%; border-radius: 10px;"></div>
          </div>
          <div class="row mt-3 g-2">
            <div class="col-4">
              <div class="text-center">
                <div class="small text-muted">Jobs Completed</div>
                <div class="fw-bold"><%= @inspection&.inspection_jobs&.select { |j| j.completed_at.present? }&.count || 0 %> / <%= @inspection&.inspection_jobs&.count || 0 %></div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <div class="small text-muted">Parts Ordered</div>
                <div class="fw-bold"><%= @inspection&.parts_requests&.count || 0 %></div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-center">
                <div class="small text-muted">Est. Completion</div>
                <div class="fw-bold">TBD</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4 text-center mt-3 mt-md-0">
          <div class="bg-light rounded-3 p-3">
            <small class="text-muted d-block mb-1">Need Assistance?</small>
            <a href="tel:<%= @vmcott_phone %>" class="text-decoration-none">
              <i class="bi bi-telephone-fill text-primary me-1"></i>
              <strong><%= @vmcott_phone %></strong>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Quotation Approval Section %>
  <% if @quotation.present? && @quotation.status != 'accepted' && @quotation.status != 'partially_rejected' && @quotation.quotation_jobs.present? %>
    <div class="card shadow-sm border-0 rounded-4 mb-4">
      <div class="card-header bg-gradient bg-warning text-dark border-0 rounded-top-4 p-4">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h5 class="mb-0 fw-bold">
              <i class="bi bi-file-text-fill me-2"></i>
              Quotation Ready for Approval
            </h5>
            <p class="small mb-0 mt-1 opacity-75">Please review and approve the work to be performed</p>
          </div>
          <div class="bg-white bg-opacity-25 rounded-3 px-3 py-2">
            <small class="fw-bold">Total: $<%= number_with_delimiter(@quotation.amount || 0) %></small>
          </div>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th style="width: 50px" class="border-0 py-3"></th>
                <th class="border-0 py-3">Service Description</th>
                <th class="border-0 py-3 text-end">Labor</th>
                <th class="border-0 py-3 text-end">Parts</th>
                <th class="border-0 py-3 text-end">Total</th>
               </thead>
            <tbody>
              <% @quotation.quotation_jobs.each do |job| %>
                <tr class="align-middle">
                  <td class="text-center">
                    <div class="form-check">
                      <input type="checkbox" class="form-check-input job-checkbox" 
                             name="approved_jobs[]" value="<%= job.id %>" 
                             id="job_<%= job.id %>"
                             style="transform: scale(1.2);">
                    </div>
                    </td>
                    <td>
                    <div class="fw-semibold"><%= job.name || job.description %></div>
                    <small class="text-muted">Estimated: <%= job.estimated_hours %> hours</small>
                    </td>
                  <td class="text-end fw-semibold">$<%= number_with_delimiter(job.total_labor_cost || 0) %></td>
                  <td class="text-end">$<%= number_with_delimiter(job.total_parts_cost || 0) %></td>
                  <td class="text-end fw-bold text-primary">$<%= number_with_delimiter((job.total_labor_cost || 0) + (job.total_parts_cost || 0)) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="bg-light">
              <tr class="fw-bold">
                <td colspan="4" class="text-end border-0 py-3">Grand Total:</td>
                <td class="text-end text-primary border-0 py-3">$<%= number_with_delimiter(@quotation.quotation_jobs.sum { |j| (j.total_labor_cost || 0) + (j.total_parts_cost || 0) }) %></td>
              </tr>
            </tfoot>
           </table>
        </div>
        
        <div class="p-4 bg-light border-top">
          <div class="d-flex gap-3">
            <%= button_to "Approve All Jobs", 
                customer_approve_quotation_path(@quotation), 
                method: :post,
                params: { approve_all: 'true' },
                class: "btn btn-success px-4 py-2 rounded-pill",
                data: { confirm: "Approve all jobs? This will authorize work to begin.", turbo: false } %>
            
            <button type="button" class="btn btn-outline-primary px-4 py-2 rounded-pill" data-bs-toggle="modal" data-bs-target="#selectJobsModal">
              <i class="bi bi-check2-square me-2"></i> Approve Selected
            </button>
          </div>
          <div class="alert alert-info mt-3 mb-0 py-2">
            <i class="bi bi-info-circle me-1"></i>
            <small>Only approved work will be performed. You can approve individual jobs or all at once.</small>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Already Approved Section %>
  <% if @quotation.present? && (@quotation.status == 'accepted' || @quotation.status == 'partially_rejected') && @quotation.quotation_jobs.where(client_approved: true).any? %>
    <div class="card shadow-sm border-0 rounded-4 mb-4">
      <div class="card-header bg-gradient bg-success text-white border-0 rounded-top-4 p-4">
        <div class="d-flex align-items-center">
          <i class="bi bi-check2-circle fs-3 me-3"></i>
          <div>
            <h5 class="mb-0 fw-bold">Work Approved</h5>
            <p class="small mb-0 mt-1 opacity-75">Thank you for approving the following work</p>
          </div>
        </div>
      </div>
      <div class="card-body p-4">
        <div class="row g-3">
          <% @quotation.quotation_jobs.where(client_approved: true).each do |job| %>
            <div class="col-md-6">
              <div class="d-flex align-items-center p-3 bg-light rounded-3">
                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                <div>
                  <div class="fw-semibold"><%= job.name || job.description %></div>
                  <small class="text-muted">Approved on <%= job.client_approved_at&.strftime("%b %d, %Y") || 'today' %></small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Timeline Section %>
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-gradient bg-info text-white border-0 rounded-top-4 p-4">
      <div class="d-flex align-items-center">
        <i class="bi bi-clock-history fs-3 me-3"></i>
        <div>
          <h5 class="mb-0 fw-bold">Repair Timeline</h5>
          <p class="small mb-0 mt-1 opacity-75">Track the progress of your vehicle repair</p>
        </div>
      </div>
    </div>
    <div class="card-body p-4">
      <% if @vehicle && @vehicle.vehicle_statuses.any? %>
        <div class="timeline">
          <% @vehicle.vehicle_statuses.order(created_at: :asc).each do |status| %>
            <div class="timeline-item">
              <div class="timeline-icon">
                <i class="bi <%= status_icon(status.status) %>"></i>
              </div>
              <div class="timeline-content">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="mb-1 fw-bold"><%= status.status.humanize %></h6>
                    <p class="text-muted small mb-0"><%= status.notes %></p>
                  </div>
                  <small class="text-muted"><%= status.created_at.strftime("%b %d, %Y • %I:%M %p") %></small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-hourglass-split fs-1 text-muted mb-3 d-block"></i>
          <h6 class="text-muted">No timeline events yet</h6>
          <p class="small text-muted">Your vehicle will be inspected soon. Check back for updates.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal for selecting jobs -->
<div class="modal fade" id="selectJobsModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header bg-gradient bg-warning border-0 rounded-top-4 p-4">
        <div>
          <h5 class="modal-title fw-bold">Select Jobs to Approve</h5>
          <p class="small mb-0 mt-1 opacity-75">Choose which jobs you want to authorize</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <% if @quotation.present? %>
        <%= form_with url: customer_approve_quotation_path(@quotation), method: :post, local: true do |f| %>
          <div class="modal-body p-4">
            <% if @quotation.quotation_jobs.present? %>
              <div class="mb-4">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="selectAllJobsModal" style="transform: scale(1.2);">
                  <label class="form-check-label fw-bold ms-2" for="selectAllJobsModal">Select All Jobs</label>
                </div>
              </div>
              <div class="list-group list-group-flush">
                <% @quotation.quotation_jobs.each do |job| %>
                  <div class="list-group-item border-0 px-0 py-3">
                    <div class="form-check">
                      <input type="checkbox" class="form-check-input job-checkbox-modal" 
                             name="approved_jobs[]" value="<%= job.id %>" 
                             id="job_modal_<%= job.id %>"
                             style="transform: scale(1.2);">
                      <label class="form-check-label ms-3" for="job_modal_<%= job.id %>">
                        <div class="fw-semibold"><%= job.name || job.description %></div>
                        <div class="small text-muted mt-1">
                          Labor: $<%= number_with_delimiter(job.total_labor_cost || 0) %> • 
                          Parts: $<%= number_with_delimiter(job.total_parts_cost || 0) %> • 
                          Total: $<%= number_with_delimiter((job.total_labor_cost || 0) + (job.total_parts_cost || 0)) %>
                        </div>
                      </label>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted text-center py-4">No jobs available for approval.</p>
            <% end %>
          </div>
          <div class="modal-footer border-0 p-4 pt-0">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <%= submit_tag "Approve Selected Jobs", name: "approved_jobs_submit", class: "btn btn-success rounded-pill px-4", disabled: !@quotation.quotation_jobs.present? %>
          </div>
        <% end %>
      <% else %>
        <div class="modal-body p-4 text-center">
          <p class="text-muted">Quotation not available.</p>
        </div>
        <div class="modal-footer border-0 p-4 pt-0">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
/* Timeline styling */
.timeline {
  position: relative;
  padding-left: 30px;
}

.timeline-item {
  position: relative;
  padding-bottom: 24px;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -30px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom, #3b82f6, #10b981);
}

.timeline-icon {
  position: absolute;
  left: -42px;
  top: 0;
  width: 28px;
  height: 28px;
  background: white;
  border: 2px solid #3b82f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  z-index: 1;
}

.timeline-icon i {
  font-size: 12px;
  color: #3b82f6;
}

.timeline-content {
  background: #f8fafc;
  padding: 12px 16px;
  border-radius: 12px;
  transition: all 0.2s ease;
}

.timeline-content:hover {
  background: #f1f5f9;
  transform: translateX(4px);
}

/* Card header gradients */
.bg-gradient {
  background: linear-gradient(135deg, var(--bs-primary) 0%, #1e3a5f 100%);
}

.bg-warning.bg-gradient {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.bg-success.bg-gradient {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.bg-info.bg-gradient {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
}

/* Hover effects */
.card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
}

/* Table styling */
.table th {
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #475569;
}

.table td {
  vertical-align: middle;
}

/* Checkbox styling */
.form-check-input:checked {
  background-color: #3b82f6;
  border-color: #3b82f6;
}

/* Responsive */
@media (max-width: 768px) {
  .timeline {
    padding-left: 20px;
  }
  
  .timeline-icon {
    left: -32px;
    width: 20px;
    height: 20px;
  }
  
  .timeline-icon i {
    font-size: 10px;
  }
  
  .timeline-content {
    padding: 8px 12px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Select all checkbox functionality for modal
  const selectAllModal = document.getElementById('selectAllJobsModal');
  const modalCheckboxes = document.querySelectorAll('.job-checkbox-modal');
  const submitBtn = document.querySelector('input[name="approved_jobs_submit"]');
  
  if (selectAllModal) {
    selectAllModal.addEventListener('change', function() {
      modalCheckboxes.forEach(cb => cb.checked = this.checked);
      if (submitBtn) {
        submitBtn.disabled = !Array.from(modalCheckboxes).some(cb => cb.checked);
      }
    });
  }
  
  modalCheckboxes.forEach(cb => {
    cb.addEventListener('change', function() {
      if (selectAllModal) {
        selectAllModal.checked = Array.from(modalCheckboxes).every(c => c.checked);
      }
      if (submitBtn) {
        submitBtn.disabled = !Array.from(modalCheckboxes).some(c => c.checked);
      }
    });
  });
  
  // Initial state for submit button
  if (submitBtn && modalCheckboxes.length > 0) {
    submitBtn.disabled = !Array.from(modalCheckboxes).some(cb => cb.checked);
  }
});

// Helper function for status icons
function status_icon(status) {
  const icons = {
    'vehicle_received': 'bi-box-arrow-in-right',
    'inspection_started': 'bi-search',
    'inspection_complete': 'bi-clipboard-check',
    'parts_ordered': 'bi-box-seam',
    'work_in_progress': 'bi-tools',
    'qc_complete': 'bi-check-circle',
    'ready_for_pickup': 'bi-truck',
    'completed': 'bi-check2-circle'
  };
  return icons[status] || 'bi-clock-history';
}
</script>