<%# app/views/customer_portal/login.html.erb %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Track Your Vehicle Repair</h4>
        </div>
        <div class="card-body">
          <p class="text-muted">Enter your vehicle license plate and receipt number from your drop-off slip.</p>
          
          <%= form_with url: customer_authenticate_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <%= label_tag :license_plate, "Vehicle License Plate", class: "form-label" %>
              <%= text_field_tag :license_plate, nil, class: "form-control", placeholder: "PBC-7065", required: true %>
            </div>
            
            <div class="mb-3">
              <%= label_tag :receipt_number, "Receipt Number", class: "form-label" %>
              <%= text_field_tag :receipt_number, nil, class: "form-control", placeholder: "RCP-20250323-ABCD", required: true %>
            </div>
            
            <div class="mb-3">
              <%= label_tag :email, "Email (to receive updates)", class: "form-label" %>
              <%= email_field_tag :email, nil, class: "form-control", placeholder: "customer@example.com" %>
            </div>
            
            <%= submit_tag "Track My Vehicle", class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>