<%# app/views/customer_portal/pickup_signature.html.erb %>
<div class="container py-4">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-gradient bg-success text-white border-0 rounded-top-4 p-4">
      <h5 class="mb-0 fw-bold">
        <i class="bi bi-pen me-2"></i>
        Vehicle Pickup Confirmation
      </h5>
    </div>
    <div class="card-body p-4">
      <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>Your vehicle is ready for pickup!</strong> Please sign below to confirm receipt.
      </div>
      
      <div class="row">
        <div class="col-md-6">
          <div class="bg-light rounded-3 p-3 mb-3">
            <h6>Vehicle Information</h6>
            <p class="mb-0">
              <strong>License Plate:</strong> <%= @vehicle.license_plate %><br>
              <strong>Make/Model:</strong> <%= @vehicle.make %> <%= @vehicle.model %><br>
              <strong>Pickup Date:</strong> <%= Time.current.strftime("%B %d, %Y at %I:%M %p") %>
            </p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="bg-light rounded-3 p-3 mb-3">
            <h6>Pickup Code</h6>
            <p class="mb-0">
              <strong class="fs-3"><%= @inspection.pickup_code %></strong>
            </p>
          </div>
        </div>
      </div>
      
      <%= form_with url: customer_confirm_pickup_path(@inspection), method: :post, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label fw-bold">Your Name</label>
          <input type="text" name="signer_name" class="form-control" required>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Email Address</label>
          <input type="email" name="signer_email" class="form-control" required>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Electronic Signature</label>
          <div class="signature-container" style="border: 2px solid #ccc; border-radius: 8px; background: white;">
            <canvas id="signature-pad" width="500" height="150" style="width: 100%; height: 150px; border-radius: 8px;"></canvas>
          </div>
          <input type="hidden" name="signature_data" id="signature-data">
          <div class="mt-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature()">
              <i class="bi bi-eraser me-1"></i> Clear Signature
            </button>
          </div>
        </div>
        
        <div class="form-check mb-4">
          <input type="checkbox" class="form-check-input" id="confirm_pickup" required>
          <label class="form-check-label" for="confirm_pickup">
            I confirm that I have received my vehicle and all work has been completed to my satisfaction.
          </label>
        </div>
        
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-success btn-lg py-2">
            <i class="bi bi-check2-circle me-2"></i> Confirm Pickup & Sign
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script>
  let signaturePad;
  
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('signature-pad');
    if (canvas) {
      signaturePad = new SignaturePad(canvas, {
        backgroundColor: 'white',
        penColor: 'black',
        minWidth: 1,
        maxWidth: 2
      });
    }
  });
  
  function clearSignature() {
    if (signaturePad) {
      signaturePad.clear();
    }
  }
  
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      if (signaturePad && !signaturePad.isEmpty()) {
        const signatureData = signaturePad.toDataURL();
        document.getElementById('signature-data').value = signatureData;
      } else if (signaturePad && signaturePad.isEmpty()) {
        e.preventDefault();
        alert('Please provide your signature to confirm pickup.');
      }
    });
  }
</script>