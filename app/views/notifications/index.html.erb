<%# app/views/notifications/index.html.erb %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="bi bi-bell me-2"></i>
      Notifications
      <% if @unread_count > 0 %>
        <span class="badge bg-danger ms-2"><%= @unread_count %> unread</span>
      <% end %>
    </h1>
    <% if @unread_count > 0 %>
      <%= link_to "Mark all as read", mark_all_as_read_notifications_path, method: :post, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="list-group">
      <% @notifications.each do |notification| %>
        <%= link_to notification.link.presence || '#', class: "list-group-item list-group-item-action #{'bg-light' unless notification.read?}" do %>
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <div class="fw-bold"><%= notification.title %></div>
              <div class="text-muted"><%= notification.message %></div>
              <small class="text-muted"><%= time_ago_in_words(notification.created_at) %> ago</small>
            </div>
            <% unless notification.read? %>
              <span class="badge bg-primary rounded-pill ms-3">New</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= paginate @notifications %>
  <% else %>
    <div class="text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted"></i>
      <h4 class="text-muted mt-3">No notifications</h4>
      <p class="text-muted">You're all caught up!</p>
    </div>
  <% end %>
</div>