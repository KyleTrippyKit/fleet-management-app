<%# app/views/notifications/_notification.html.erb %>
<%= link_to notification.link.presence || '#', class: "list-group-item list-group-item-action #{'bg-light' unless notification.read?}" do %>
  <div class="d-flex justify-content-between align-items-start">
    <div class="flex-grow-1">
      <div class="fw-bold"><%= notification.title %></div>
      <div class="text-muted"><%= notification.message %></div>
      <small class="text-muted"><%= time_ago_in_words(notification.created_at) %> ago</small>
    </div>
    <% unless notification.read? %>
      <span class="badge bg-primary rounded-pill ms-3">New</span>
    <% end %>
  </div>
<% end %>